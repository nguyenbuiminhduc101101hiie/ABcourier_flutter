@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Models
@using ABFreight.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_code"
                              Label="@Localizer["ChargeType_Code"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["ChargeType_CodeRequired"]"
                              MaxLength="64"
                              Disabled="IsEdit" />
                <MudTextField @bind-Value="_name"
                              Label="@Localizer["name"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["ChargeType_NameRequired"]"
                              MaxLength="256" />
                <MudTextField @bind-Value="_description"
                              Label="@Localizer["ChargeType_Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              MaxLength="2000" />
                <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@Localizer["ChargeType_Active"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_ChargeType? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    public sealed class ChargeTypeDialogResult
    {
        public Guid Id { get; init; }
        public string Code { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public string? Description { get; init; }
        public bool IsActive { get; init; }
        public bool IsEdit { get; init; }
    }

    private MudForm? _form;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private string? _description;
    private bool _isActive = true;

    protected override void OnParametersSet()
    {
        if (Model is null)
        {
            _code = string.Empty;
            _name = string.Empty;
            _description = null;
            _isActive = true;
            return;
        }

        _code = Model.Code ?? string.Empty;
        _name = Model.Name ?? string.Empty;
        _description = Model.Description;
        _isActive = Model.IsActive;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;

        var code = _code.Trim();
        var name = _name.Trim();
        if (string.IsNullOrEmpty(code) || string.IsNullOrEmpty(name))
            return;

        MudDialog.Close(DialogResult.Ok(new ChargeTypeDialogResult
        {
            Id = Model?.Id ?? Guid.Empty,
            Code = code,
            Name = name,
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            IsActive = _isActive,
            IsEdit = IsEdit
        }));
    }
}
