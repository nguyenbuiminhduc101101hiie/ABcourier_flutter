@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_tariffCode" Label="@Localizer["TariffHeader_Lbl_TariffCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="64" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_tariffName" Label="@Localizer["TariffHeader_Lbl_TariffName"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="256" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_chargeTypeItem"
                                     Label="@Localizer["TariffHeader_Lbl_ChargeType"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     SearchFunc="SearchChargeTypesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_customerItem"
                                     Label="@Localizer["TariffHeader_Lbl_Customer"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     SearchFunc="SearchCustomersAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_shippingLineItem"
                                     Label="@Localizer["TariffHeader_Lbl_ShippingLine"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     SearchFunc="SearchShippingLinesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_depotItem"
                                     Label="@Localizer["TariffHeader_Lbl_Depot"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     SearchFunc="SearchPortsAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_terminalItem"
                                     Label="@Localizer["TariffHeader_Lbl_Terminal"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     SearchFunc="SearchTerminalsAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     @bind-Value="_containerType"
                                     Label="@Localizer["TariffHeader_Lbl_ContainerType"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     SearchFunc="SearchContainerTypesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     CoerceValue="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     Dense="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     @bind-Value="_cargoType"
                                     Label="@Localizer["TariffHeader_Lbl_CargoType"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     SearchFunc="SearchCargoTypesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     CoerceValue="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     Dense="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_direction" Label="@Localizer["TariffHeader_Lbl_Direction"]" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="32" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_currencyCode" Label="@Localizer["TariffHeader_Lbl_Currency"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="8" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_effectiveFrom" Label="@Localizer["TariffHeader_Lbl_EffectiveFrom"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_effectiveTo" Label="@Localizer["TariffHeader_Lbl_EffectiveTo"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_status" Label="@Localizer["TariffHeader_Lbl_Status"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Dense="true">
                        <MudSelectItem Value="@("Active")">@Localizer["TariffHeader_Status_Active"]</MudSelectItem>
                        <MudSelectItem Value="@("Inactive")">@Localizer["TariffHeader_Status_Inactive"]</MudSelectItem>
                        <MudSelectItem Value="@("Draft")">@Localizer["TariffHeader_Status_Draft"]</MudSelectItem>
                        <MudSelectItem Value="@("Closed")">@Localizer["TariffHeader_Status_Closed"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="@Localizer["TariffHeader_Lbl_Notes"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="2000" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int ComboResultLimit = 50;

    private sealed class LookupItem
    {
        public Guid Id { get; init; }
        public string Display { get; init; } = string.Empty;
    }

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_TariffHeader? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public int DialogKey { get; set; }

    public sealed class TariffHeaderDialogResult
    {
        public bool IsEdit { get; init; }
        public M_TariffHeader Entity { get; init; } = new();
        public List<M_TariffTier>? Tiers { get; init; }
    }

    private static readonly string[] ContainerTypes =
    {
        "20DC", "40DC", "40HC", "40RH", "45HC", "20RF", "40RF", "20OT", "40OT", "20FR", "40FR",
        "20GP", "40GP", "45GP", "20NOR", "40NOR", "45RT", "53HC", "20TK", "40TK", "20ST", "40ST",
        "20HCRF", "40HCRF", "20PL", "40PL", "20HT", "40HT", "20GOH", "40GOH", "20RE", "40RE",
        "20ISOTANK", "40ISOTANK", "20SOC", "40SOC", "48HC", "40PW", "20PW", "45HW", "48PW",
        "20NB", "40NB", "20AC", "40AC", "20VV", "40VV", "20MX", "40MX", "L5G1", "20VH", "40VH"
    };

    private static readonly string[] CargoTypes =
    {
        "FCL", "LCL", "CFS", "BULK", "BREAK BULK", "RO-RO", "NOR", "EMPTY", "SPECIAL",
        "DG", "IMO", "REEFER", "PERISHABLE", "HAZMAT", "ODC", "PROJECT", "LIVESTOCK",
        "VEHICLES", "STEEL", "TIMBER", "CHEMICAL", "FOOD GRADE", "PHARMA", "TEXTILE", "ELECTRONICS",
        "MACHINERY", "MINERALS", "AGRICULTURE", "CONSUMER", "MIXED", "COIL", "BAGGED", "DRUM"
    };

    private MudForm? _form;
    private int _lastDialogKey = int.MinValue;

    private string _tariffCode = string.Empty;
    private string _tariffName = string.Empty;
    private LookupItem? _chargeTypeItem;
    private LookupItem? _customerItem;
    private LookupItem? _shippingLineItem;
    private LookupItem? _depotItem;
    private LookupItem? _terminalItem;
    private string _containerType = "20DC";
    private string _cargoType = "FCL";
    private string? _direction;
    private string _currencyCode = "USD";
    private DateTime? _effectiveFrom;
    private DateTime? _effectiveTo;
    private string _status = "Active";
    private string? _notes;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (DialogKey == _lastDialogKey)
            return;
        _lastDialogKey = DialogKey;
        await LoadFromModelAsync();
    }

    private async Task LoadFromModelAsync()
    {
        if (Model is null)
            return;

        _tariffCode = Model.TariffCode ?? string.Empty;
        _tariffName = Model.TariffName ?? string.Empty;
        _direction = Model.Direction;
        _currencyCode = string.IsNullOrWhiteSpace(Model.CurrencyCode) ? "USD" : Model.CurrencyCode;
        _effectiveFrom = Model.EffectiveFrom == default ? DateTime.Today : Model.EffectiveFrom;
        _effectiveTo = Model.EffectiveTo;
        _status = string.IsNullOrWhiteSpace(Model.Status) ? "Active" : Model.Status;
        _notes = Model.Notes;
        _containerType = string.IsNullOrWhiteSpace(Model.ContainerTypeId) ? "20DC" : Model.ContainerTypeId;
        _cargoType = string.IsNullOrWhiteSpace(Model.CargoTypeId) ? "FCL" : Model.CargoTypeId;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (Model.ChargeTypeId != Guid.Empty)
        {
            var ct = await db.ChargeType.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Model.ChargeTypeId);
            _chargeTypeItem = ct is null ? null : new LookupItem { Id = ct.Id, Display = $"{ct.Code ?? ""} - {ct.Name ?? ""}" };
        }
        else
            _chargeTypeItem = null;

        if (Model.CustomerId != Guid.Empty)
        {
            var c = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == Model.CustomerId);
            _customerItem = c is null ? null : new LookupItem { Id = c.Customer_ID, Display = CustomerDisplay(c) };
        }
        else
            _customerItem = null;

        if (Model.ShippingLineId != Guid.Empty)
        {
            var s = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == Model.ShippingLineId);
            _shippingLineItem = s is null ? null : new LookupItem { Id = s.Customer_ID, Display = CustomerDisplay(s) };
        }
        else
            _shippingLineItem = null;

        if (Model.DepotId != Guid.Empty)
        {
            var p = await db.Port.AsNoTracking().FirstOrDefaultAsync(x => x.PORT_ID == Model.DepotId);
            _depotItem = p is null ? null : new LookupItem { Id = p.PORT_ID, Display = PortDisplay(p) };
        }
        else
            _depotItem = null;

        if (Model.PortId != Guid.Empty)
        {
            var t = await db.Terminal.AsNoTracking().FirstOrDefaultAsync(x => x.TerminalID == Model.PortId);
            _terminalItem = t is null ? null : new LookupItem { Id = t.TerminalID, Display = TerminalDisplay(t) };
        }
        else
            _terminalItem = null;
    }

    private static string CustomerDisplay(M_Customer x)
    {
        var code = !string.IsNullOrWhiteSpace(x.Customer_Code)
            ? x.Customer_Code.Trim()
            : (!string.IsNullOrWhiteSpace(x.MainCode) ? x.MainCode.Trim() : "");
        var en = !string.IsNullOrWhiteSpace(x.EnglishName) ? x.EnglishName.Trim() : "";
        if (!string.IsNullOrEmpty(code) && !string.IsNullOrEmpty(en))
            return $"{code}_{en}";
        if (!string.IsNullOrEmpty(en))
            return en;
        if (!string.IsNullOrEmpty(code))
            return code;
        if (!string.IsNullOrWhiteSpace(x.COMPANY))
            return x.COMPANY.Trim();
        return x.Customer_ID.ToString();
    }

    private static string PortDisplay(PortModel x)
    {
        if (!string.IsNullOrWhiteSpace(x.PORT) && !string.IsNullOrWhiteSpace(x.PORT_CODE))
            return $"{x.PORT} ({x.PORT_CODE})";
        return x.PORT ?? x.PORT_CODE ?? x.PORT_ID.ToString();
    }

    private static string TerminalDisplay(Terminal_ x)
    {
        if (!string.IsNullOrWhiteSpace(x.TermiNalName))
            return x.TermiNalName!;
        if (!string.IsNullOrWhiteSpace(x.Code))
            return x.Code!;
        return x.TerminalID.ToString();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_chargeTypeItem is null || _chargeTypeItem.Id == Guid.Empty
            || _customerItem is null || _customerItem.Id == Guid.Empty
            || _shippingLineItem is null || _shippingLineItem.Id == Guid.Empty
            || _depotItem is null || _depotItem.Id == Guid.Empty
            || _terminalItem is null || _terminalItem.Id == Guid.Empty)
        {
            Snackbar.Add(Localizer["TariffHeader_Msg_SelectLinks"], MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_containerType) || string.IsNullOrWhiteSpace(_cargoType))
        {
            Snackbar.Add(Localizer["TariffHeader_Msg_ContCargoRequired"], MudBlazor.Severity.Warning);
            return;
        }

        if (!_effectiveFrom.HasValue)
        {
            Snackbar.Add(Localizer["TariffHeader_Msg_EffectiveFromRequired"], MudBlazor.Severity.Warning);
            return;
        }

        var entity = Model ?? new M_TariffHeader { Id = Guid.Empty };
        entity.TariffCode = _tariffCode.Trim();
        entity.TariffName = _tariffName.Trim();
        entity.ChargeTypeId = _chargeTypeItem.Id;
        entity.CustomerId = _customerItem.Id;
        entity.ShippingLineId = _shippingLineItem.Id;
        entity.DepotId = _depotItem.Id;
        entity.PortId = _terminalItem.Id;
        entity.ContainerTypeId = _containerType.Trim();
        entity.CargoTypeId = _cargoType.Trim();
        entity.Direction = string.IsNullOrWhiteSpace(_direction) ? null : _direction.Trim();
        entity.CurrencyCode = _currencyCode.Trim();
        entity.EffectiveFrom = _effectiveFrom.Value;
        entity.EffectiveTo = _effectiveTo;
        entity.Status = _status.Trim();
        entity.Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();

        MudDialog.Close(DialogResult.Ok(new TariffHeaderDialogResult { IsEdit = IsEdit, Entity = entity }));
    }

    private async Task<IEnumerable<LookupItem>> SearchChargeTypesAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.ChargeType.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.Code != null && x.Code.Contains(v)) ||
                (x.Name != null && x.Name.Contains(v)));
        }

        var ctList = await q.OrderBy(x => x.Code).Take(ComboResultLimit).ToListAsync();
        return ctList.Select(x => new LookupItem { Id = x.Id, Display = $"{x.Code ?? ""} - {x.Name ?? ""}" });
    }

    private async Task<IEnumerable<LookupItem>> SearchCustomersAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Customer.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.EnglishName != null && x.EnglishName.Contains(v)) ||
                (x.Customer_Code != null && x.Customer_Code.Contains(v)) ||
                (x.COMPANY != null && x.COMPANY.Contains(v)) ||
                (x.MainCode != null && x.MainCode.Contains(v)) ||
                (x.Customer_Code != null && x.EnglishName != null &&
                 (x.Customer_Code + "_" + x.EnglishName).Contains(v)));
        }

        var list = await q.OrderBy(x => x.Customer_Code).ThenBy(x => x.EnglishName).Take(ComboResultLimit).ToListAsync();
        return list.Select(x => new LookupItem { Id = x.Customer_ID, Display = CustomerDisplay(x) });
    }

    private async Task<IEnumerable<LookupItem>> SearchShippingLinesAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Customer.AsNoTracking()
            .Where(x => x.MainCode != null && EF.Functions.Like(x.MainCode, "%Shipping%"));

        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.EnglishName != null && x.EnglishName.Contains(v)) ||
                (x.Customer_Code != null && x.Customer_Code.Contains(v)) ||
                (x.COMPANY != null && x.COMPANY.Contains(v)) ||
                (x.MainCode != null && x.MainCode.Contains(v)) ||
                (x.Customer_Code != null && x.EnglishName != null &&
                 (x.Customer_Code + "_" + x.EnglishName).Contains(v)));
        }

        var list = await q.OrderBy(x => x.Customer_Code).ThenBy(x => x.EnglishName).Take(ComboResultLimit).ToListAsync();
        return list.Select(x => new LookupItem { Id = x.Customer_ID, Display = CustomerDisplay(x) });
    }

    private async Task<IEnumerable<LookupItem>> SearchPortsAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Port.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.PORT != null && x.PORT.Contains(v)) ||
                (x.PORT_CODE != null && x.PORT_CODE.Contains(v)));
        }

        var list = await q.OrderBy(x => x.PORT).Take(ComboResultLimit).ToListAsync();
        return list.Select(x => new LookupItem { Id = x.PORT_ID, Display = PortDisplay(x) });
    }

    private async Task<IEnumerable<LookupItem>> SearchTerminalsAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Terminal.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.TermiNalName != null && x.TermiNalName.Contains(v)) ||
                (x.Code != null && x.Code.Contains(v)));
        }

        var list = await q.OrderBy(x => x.TermiNalName).Take(ComboResultLimit).ToListAsync();
        return list.Select(x => new LookupItem { Id = x.TerminalID, Display = TerminalDisplay(x) });
    }

    private Task<IEnumerable<string>> SearchContainerTypesAsync(string value)
    {
        IEnumerable<string> q = ContainerTypes;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x => x.Contains(v, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(q.Take(ComboResultLimit));
    }

    private Task<IEnumerable<string>> SearchCargoTypesAsync(string value)
    {
        IEnumerable<string> q = CargoTypes;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x => x.Contains(v, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(q.Take(ComboResultLimit));
    }
}
