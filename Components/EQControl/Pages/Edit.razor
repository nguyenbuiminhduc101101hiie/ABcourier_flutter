    protected override async Task OnInitializedAsync()
    {
        try
        {
            userdetail = asv.GetUserDetail();
            if (userdetail == null)
            {
                CallSnackBar(@Localizer["ErrorLoadingData"] + " User not found.", MudBlazor.Severity.Error);
                return;
            }
            usr = userdetail.Usr ?? string.Empty;

            // Load terminals, ports, shippers, distinct owner names
            Terminals = await gsv.GetList_Terminal();
            Ports = csv.queryListPorts();
            Shippers = csv.queryListShippers();
            OwnerNames = shipsv.GetDistinctOwnerNames();
            _ownerNameInput = container?.OwnerName;

            if (container != null && container.CTN_ID != Guid.Empty)
            {
                await LoadRelatedData();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(@Localizer["ErrorLoadingData"] + " " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    private double? GetNullableDouble(OfficeOpenXml.ExcelRangeBase cell)
    {
        if (cell == null)
            return null;

        var text = cell.Text;
        if (string.IsNullOrWhiteSpace(text))
            return null;

        if (double.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var result))
            return result;

        if (double.TryParse(text, NumberStyles.Any, CultureInfo.CurrentCulture, out result))
            return result;

        return null;
    }

    private async Task ImportGateInFromExcel(InputFileChangeEventArgs e)
    {
        if (container == null)
        {
            CallSnackBar("Container is not selected.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            using var stream = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage(stream);
            var worksheet = package.Workbook.Worksheets["GATEIN"];
            if (worksheet == null)
            {
                CallSnackBar("Sheet 'GateIn' not found in Excel file.", MudBlazor.Severity.Error);
                return;
            }

            var importedItems = new List<M_GateIn>();
            var row = 16;
            while (true)
            {
                var seqValue = worksheet.Cells[row, 1].GetValue<int?>();
                if (!seqValue.HasValue)
                    break;

                var item = new M_GateIn
                {
                    Containerid = container.CTN_ID,
                    Seq = seqValue,
                    EIR = worksheet.Cells[row, 2].GetValue<string>(),
                    DateIn = worksheet.Cells[row, 3].GetValue<DateTime?>(),
                    TimeIn = worksheet.Cells[row, 4].GetValue<DateTime?>()?.TimeOfDay,
                    Container = worksheet.Cells[row, 5].GetValue<string>(),
                    Type = worksheet.Cells[row, 6].GetValue<string>(),
                    ISO_SZTP = worksheet.Cells[row, 7].GetValue<string>(),
                    Opt = worksheet.Cells[row, 8].GetValue<string>(),
                    FE = worksheet.Cells[row, 9].GetValue<string>(),
                    Move = worksheet.Cells[row, 10].GetValue<string>(),
                    Location = worksheet.Cells[row, 11].GetValue<string>(),
                    BillOfLading = worksheet.Cells[row, 12].GetValue<string>(),
                    Consignee = worksheet.Cells[row, 13].GetValue<string>(),
                    Truck = worksheet.Cells[row, 14].GetValue<string>(),
                    YOM = worksheet.Cells[row, 15].GetValue<string>(),
                    SealNo = worksheet.Cells[row, 16].GetValue<string>(),
                    SealNo1 = worksheet.Cells[row, 17].GetValue<string>(),
                    SealNo2 = worksheet.Cells[row, 18].GetValue<string>(),
                    VGM = GetNullableDouble(worksheet.Cells[row, 19]),
                    Clean = worksheet.Cells[row, 20].GetValue<string>(),
                    MaxGross = GetNullableDouble(worksheet.Cells[row, 21]),
                    TareWeight = GetNullableDouble(worksheet.Cells[row, 22]),
                    Remark = worksheet.Cells[row, 23].GetValue<string>(),
                    Status = worksheet.Cells[row, 24].GetValue<string>(),
                    Grade = worksheet.Cells[row, 25].GetValue<string>(),
                    Note = worksheet.Cells[row, 26].GetValue<string>()
                };

                importedItems.Add(item);
                row++;
            }

            foreach (var gateIn in importedItems)
            {
                GateIns.Add(gateIn);
                var rs = await shipsv.SaveOrUpdateGateIn(gateIn);
                if (!rs.Flag)
                {
                    CallSnackBar($"Error saving Gate In Seq {gateIn.Seq}: {rs.Message}", MudBlazor.Severity.Error);
                }
            }

            await LoadRelatedData();
            await InvokeAsync(StateHasChanged);
            CallSnackBar($"Imported {importedItems.Count} Gate In records from Excel.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar("Error importing Gate In from Excel: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

