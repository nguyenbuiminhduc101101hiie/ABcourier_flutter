    private void OnOwnerNameBlur(FocusEventArgs _)
    {
        if (container != null)
            container.OwnerName = string.IsNullOrWhiteSpace(_ownerNameInput) ? null : _ownerNameInput.Trim();
    }

    private void OnOwnerNameTextChanged(string text)
    {
        _ownerNameInput = text;
    }

    private void OnOwnerNameValueChanged(string? value)
    {
        _ownerNameInput = value;
    }

    private Task<IEnumerable<string>> SearchOwnerNames(string value)
    {
        IEnumerable<string> result = OwnerNames;
        if (!string.IsNullOrWhiteSpace(value))
        {
            result = OwnerNames
                .Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> SearchPorts(string value)
    {
        IEnumerable<string> result = Ports;
        if (!string.IsNullOrWhiteSpace(value))
        {
            result = Ports
                .Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> SearchShippers(string value)
    {
        IEnumerable<string> result = Shippers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            result = Shippers
                .Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
        return Task.FromResult(result);
    }

    string GetTerminalName(Guid? depotId)
    {
        if (depotId == null || depotId == Guid.Empty)
            return string.Empty;

        var terminal = Terminals.FirstOrDefault(t => t.TerminalID == depotId);
        return terminal?.TermiNalName ?? string.Empty;
    }

    async Task LoadRelatedData()
    {
        if (container == null) return;

        _loadingMovement = true;
        _loadingSeal = true;
        _loadingDamage = true;
        _loadingGateIn = true;
        _loadingGateOut = true;

        try
        {
            Movements = shipsv.GetContainerMovementByContainerId(container.CTN_ID);
            Seals = shipsv.GetContainerSealByContainerId(container.CTN_ID);
            Damages = shipsv.GetContainerDamageByContainerId(container.CTN_ID);
            GateIns = shipsv.GetGateInByContainerId(container.CTN_ID);
            GateOuts = shipsv.GetGateOutByContainerId(container.CTN_ID);
        }
        finally
        {
            _loadingMovement = false;
            _loadingSeal = false;
            _loadingDamage = false;
            _loadingGateIn = false;
            _loadingGateOut = false;
            StateHasChanged();
        }
    }

    async Task AddMovement()
    {
        if (container == null) return;
        try
        {
            var item = new M_ContainerMovement { CTN_ID = container.CTN_ID };
            Movements.Add(item);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50); // Small delay to ensure render cycle completes
            if (movementTable != null && Movements.Any())
            {
                var lastItem = Movements.LastOrDefault();
                if (lastItem != null)
                {
                    await movementTable.SetEditingItemAsync(lastItem);
                }
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(@Localizer["ErrorAddingMovement"] + " " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task DeleteMovement(M_ContainerMovement item)
    {
        if (item == null) return;

        var resultMess = await DialogService.ShowMessageBox(
        @Localizer["Warning"],
        @Localizer["DeletingCannotBeUndone"],
        yesText: @Localizer["Delete"], cancelText: @Localizer["Cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteContainerMovement(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
            {
                Movements.Remove(item);
                await LoadRelatedData();
            }
        }
    }

