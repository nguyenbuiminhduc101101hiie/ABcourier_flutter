            yesText: @Localizer["Delete"], cancelText: @Localizer["Cancel"]);
        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteGateOut(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
            {
                GateOuts.Remove(item);
                await LoadRelatedData();
            }
        }
    }

    async Task CommittedGateOut(M_GateOut item)
    {
        if (container == null) return;
        item.Containerid = container.CTN_ID;
        var rs = await shipsv.SaveOrUpdateGateOut(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (rs.Flag)
            await LoadRelatedData();
    }

    async Task TryStartEditingGateOut(M_GateOut item)
    {
        detail_gateOut = JsonSerializer.Deserialize<M_GateOut>(JsonSerializer.Serialize(item));
        if (gateOutTable != null)
            await gateOutTable.SetEditingItemAsync(item);
    }
}
