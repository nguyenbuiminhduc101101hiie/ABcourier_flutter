@inject IStringLocalizer<SharedResource> Localizer
@inject ShipmentService shipsv
@inject SharedServices ssv
@inject AccountService asv
    @inject CustomerService csv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HistoryLogService HistoryLogService
@inject GlobalServices gsv
@using System.Text.Json;
@using System.Globalization;
@using Microsoft.AspNetCore.Components.Forms;
@using OfficeOpenXml;

<MudDialog>
    <DialogContent>
        <MudContainer>
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"
                MinimumTabWidth="20px">
                <MudTabPanel Text="@Localizer["Container"]">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12" md="3">
                                <MudSelect T="string" @bind-Value="container.IsoCode" Label="@Localizer["ISOCode"]"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@(string.Empty)">-</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("20DC")">20DC</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("40DC")">40DC</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("40HC")">40HC</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("20RF")">20RF</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("40RF")">40RF</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("20OT")">20OT</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("40OT")">40OT</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("20FR")">20FR</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("40FR")">40FR</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect T="string" @bind-Value="container.OwnerType" Label="@Localizer["OwnerType"]"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@(string.Empty)">-</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("COC")">COC - Carrier Owned Container</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("SOC")">SOC - Shipper Owned Container</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("LEASE")">LEASE - Leasing company</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("DEPOT")">DEPOT - Depot owned</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("ABFreight")">ABFreight - Logistics company owned</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="@_ownerNameInput"
                                                 ValueChanged="OnOwnerNameValueChanged"
                                                 Text="@_ownerNameInput"
                                                 TextChanged="OnOwnerNameTextChanged"
                                                 Label="@Localizer["OwnerName"]"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Immediate="true"
                                                 SearchFunc="SearchOwnerNames"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceValue="false"
                                                 OnBlur="OnOwnerNameBlur" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect T="string" @bind-Value="container.Status" Label="@Localizer["Status"]"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@(string.Empty)">-</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Available")">Available</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("In Use")">In Use</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Repair")">Repair</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("On Vessel")">On Vessel</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Empty")">Empty</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect T="string" @bind-Value="container.Condition" Label="@Localizer["Condition"]"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@(string.Empty)">-</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Good")">Good</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Damaged")">Damaged</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Under Repair")">Under Repair</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Survey Required")">Survey Required</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCheckBox @bind-Checked="container.IsActive" Label="@Localizer["IsActive"]" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.TareWeight" Label="@Localizer["TareWeight"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.Payload" Label="@Localizer["Payload"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.MaxGrossWeight" Label="@Localizer["MaxGrossWeight"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.LoadedWeight" Label="@Localizer["LoadedWeight"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.CBMCapacity" Label="@Localizer["CBMCapacity"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCheckBox @bind-Checked="container.IsReefer" Label="@Localizer["IsReefer"]" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudNumericField @bind-Value="container.Temperature" Label="@Localizer["Temperature"]"
                                    Variant="Variant.Outlined" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="container.VentSetting" Label="@Localizer["VentSetting"]"
                                    Variant="Variant.Outlined" MaxLength="20" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudDatePicker @bind-Date="container.PTIDate" Label="@Localizer["PTIDate"]"
                                    Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudTabPanel>
                <MudTabPanel Text="@Localizer["ContainerMovement"]">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.FlexStart" Class="mb-4">
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="AddMovement"
                                StartIcon="@Icons.Material.Filled.Add">@Localizer["AddMovement"]</MudButton>
                        </MudStack>
                        <MudDataGrid T="M_ContainerMovement" Items="@Movements" Filterable="true" @ref="movementTable"
                            Bordered="true" FilterMode="@DataGridFilterMode.Simple" Dense="true"
                            FixedHeader="true" HeaderClass="no-wrap" ReadOnly="false"
                            CommittedItemChanges="@CommittedMovement" Loading="_loadingMovement">
                            <Columns>
                                <TemplateColumn CellClass="d-flex justify-end" Filterable="false"
                                    ShowColumnOptions="false" Sortable="false">
                                    <CellTemplate>
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                                            OnClick="@(() => TryStartEditingMovement(context.Item))" />
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                                            OnClick="@(() => DeleteMovement(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.CurrentLocation" Title="@Localizer["CurrentLocation"]"
                                    Required="@false" />
                                <PropertyColumn Property="x => x.LastLocation" Title="@Localizer["LastLocation"]" Required="@false" />
                                <PropertyColumn Property="x => x.GateInDate" Title="@Localizer["GateInDate"]" Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.GateInDate" Label="@Localizer["GateInDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.GateOutDate" Title="@Localizer["GateOutDate"]" Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.GateOutDate" Label="@Localizer["GateOutDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.MovementStatus" Title="@Localizer["MovementStatus"]"
                                    Required="@false" />
                                <PropertyColumn Property="x => x.MovementType" Title="@Localizer["MovementType"]" Required="@false" />
                                <PropertyColumn Property="x => x.DepotId" Title="@Localizer["DepotID"]">
                                    <EditTemplate>
                                        <MudSelect T="Guid?" @bind-Value="context.Item.DepotId" Label="@Localizer["Terminal"]"
                                            Variant="Variant.Outlined">
                                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@Localizer["SelectTerminal"]
                                            </MudSelectItem>
                                            @foreach (var terminal in Terminals)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)terminal.TerminalID)">
                                                    @terminal.TermiNalName
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </EditTemplate>
                                    <CellTemplate>
                                        @GetTerminalName(context.Item.DepotId)
                                    </CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.PortCode" Title="@Localizer["PortCode"]" Required="@false" />
                                <PropertyColumn Property="x => x.VesselName" Title="@Localizer["VesselName"]" Required="@false" />
                                <PropertyColumn Property="x => x.VoyageNo" Title="@Localizer["VoyageNo"]" Required="@false" />
                                <PropertyColumn Property="x => x.MovementDate" Title="@Localizer["MovementDate"]"
                                    Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.MovementDate" Label="@Localizer["MovementDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Status" Title="@Localizer["Status"]" Required="@false" />
                                <PropertyColumn Property="x => x.Remark" Title="@Localizer["Remark"]" Required="@false" />
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudTabPanel>
                <MudTabPanel Text="@Localizer["ContainerSeal"]">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.FlexStart" Class="mb-4">
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="AddSeal"
                                StartIcon="@Icons.Material.Filled.Add">@Localizer["AddSeal"]</MudButton>
                        </MudStack>
                        <MudDataGrid T="M_ContainerSeal" Items="@Seals" Filterable="true" @ref="sealTable"
                            Bordered="true" FilterMode="@DataGridFilterMode.Simple" Dense="true"
                            FixedHeader="true" HeaderClass="no-wrap" ReadOnly="false"
                            CommittedItemChanges="@CommittedSeal" Loading="_loadingSeal">
                            <Columns>
                                <TemplateColumn CellClass="d-flex justify-end" Filterable="false"
                                    ShowColumnOptions="false" Sortable="false">
                                    <CellTemplate>
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                                            OnClick="@(() => TryStartEditingSeal(context.Item))" />
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                                            OnClick="@(() => DeleteSeal(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.SealNo" Title="@Localizer["SealNo"]" Required="@true" />
                                <PropertyColumn Property="x => x.SealType" Title="@Localizer["SealType"]" Required="@false">
                                    <EditTemplate>
                                        <MudTextField @bind-Value="context.Item.SealType" Label="@Localizer["SealType"]" 
                                            Variant="Variant.Outlined" 
                                            OnBlur="@(() => { if (string.IsNullOrWhiteSpace(context.Item.SealType)) context.Item.SealType = null; })" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.SealMaterial" Title="@Localizer["SealMaterial"]" Required="@false" />
                                <PropertyColumn Property="x => x.AppliedAt" Title="@Localizer["AppliedAt"]" Required="@false" />
                                <PropertyColumn Property="x => x.AppliedDate" Title="@Localizer["AppliedDate"]" Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.AppliedDate" Label="@Localizer["AppliedDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.RemovedDate" Title="@Localizer["RemovedDate"]" Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.RemovedDate" Label="@Localizer["RemovedDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Status" Title="@Localizer["Status"]" Required="@false" />
                                <PropertyColumn Property="x => x.Remark" Title="@Localizer["Remark"]" Required="@false" />
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudTabPanel>
                <MudTabPanel Text="@Localizer["ContainerDamage"]">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.FlexStart" Class="mb-4">
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="AddDamage"
                                StartIcon="@Icons.Material.Filled.Add">@Localizer["AddDamage"]</MudButton>
                        </MudStack>
                        <MudDataGrid T="M_ContainerDamage" Items="@Damages" Filterable="true" @ref="damageTable"
                            Bordered="true" FilterMode="@DataGridFilterMode.Simple" Dense="true"
                            FixedHeader="true" HeaderClass="no-wrap" ReadOnly="false"
                            CommittedItemChanges="@CommittedDamage" Loading="_loadingDamage">
                            <Columns>
                                <TemplateColumn CellClass="d-flex justify-end" Filterable="false"
                                    ShowColumnOptions="false" Sortable="false">
                                    <CellTemplate>
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                                            OnClick="@(() => TryStartEditingDamage(context.Item))" />
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                                            OnClick="@(() => DeleteDamage(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.DamageType" Title="@Localizer["DamageType"]" Required="@false" />
                                <PropertyColumn Property="x => x.DamageArea" Title="@Localizer["DamageArea"]" Required="@false" />
                                <PropertyColumn Property="x => x.Severity" Title="@Localizer["Severity"]" Required="@false" />
                                <PropertyColumn Property="x => x.DamageDescription" Title="@Localizer["DamageDescription"]" Lines="3"
                                    Required="@false">
                                    <EditTemplate>
                                        <MudTextField @bind-Value="context.Item.DamageDescription"
                                            Label="@Localizer["DamageDescription"]" Lines="3" Variant="Variant.Outlined" AutoGrow />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.DetectedAt" Title="@Localizer["DetectedAt"]" Required="@false" />
                                <PropertyColumn Property="x => x.DetectedDate" Title="@Localizer["DetectedDate"]"
                                    Format="dd/MM/yyyy">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.DetectedDate" Label="@Localizer["DetectedDate"]"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.ResponsibleParty" Title="@Localizer["ResponsibleParty"]"
                                    Required="@false" />
                                <PropertyColumn Property="x => x.ClaimStatus" Title="@Localizer["ClaimStatus"]" Required="@false" />
                                <PropertyColumn Property="x => x.RepairCost" Title="@Localizer["RepairCost"]" Required="@false">
                                    <EditTemplate>
                                        <MudNumericField @bind-Value="context.Item.RepairCost" Label="@Localizer["RepairCost"]"
                                            Variant="Variant.Outlined" HideSpinButtons="true" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Currency" Title="@Localizer["Currency"]" Required="@false" />
                                <PropertyColumn Property="x => x.PhotoUrl" Title="@Localizer["PhotoURL"]" Required="@false" />
                                <PropertyColumn Property="x => x.Remark" Title="@Localizer["Remark"]" Required="@false" />
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudTabPanel>
                <MudTabPanel Text="Gate In">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.FlexStart" Class="mb-4">
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="AddGateIn"
                                StartIcon="@Icons.Material.Filled.Add">Add Gate In</MudButton>

                            @* <MudButton HtmlTag="label" Color="Color.Secondary" Size="Size.Small"
                                       Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FileUpload">
                                Import Gate In
                                <InputFile OnChange="ImportGateInFromExcel" style="display:none" />
                            </MudButton> *@
                        </MudStack>
                        <MudDataGrid T="M_GateIn" Items="@GateIns" Filterable="true" @ref="gateInTable"
                            Bordered="true" FilterMode="@DataGridFilterMode.Simple" Dense="true"
                            FixedHeader="true" HeaderClass="no-wrap" ReadOnly="false"
                            CommittedItemChanges="@CommittedGateIn" Loading="_loadingGateIn">
                            <Columns>
                                <TemplateColumn CellClass="d-flex justify-end" Filterable="false"
                                    ShowColumnOptions="false" Sortable="false">
                                    <CellTemplate>
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                                            OnClick="@(() => TryStartEditingGateIn(context.Item))" />
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                                            OnClick="@(() => DeleteGateIn(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Seq">
                                    <EditTemplate>
                                        <MudNumericField T="int?" @bind-Value="context.Item.Seq"
                                                         Label="Seq"
                                                         Variant="Variant.Outlined"
                                                         HideSpinButtons="true" />
                                    </EditTemplate>
                                    <CellTemplate>
                                        @context.Item.Seq
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.EIR" Title="EIR" Required="false" />
                                <PropertyColumn Property="x => x.DateIn" Title="Date In" Format="dd/MM/yyyy" Required="false">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.DateIn" Label="Date In"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.TimeIn" Title="Time In" Required="false">
                                    <EditTemplate>
                                        <MudTimePicker @bind-Time="context.Item.TimeIn" Label="Time In"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                    <CellTemplate>@(context.Item.TimeIn?.ToString(@"hh\:mm") ?? "")</CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Container" Title="Container" Required="false" />
                                <PropertyColumn Property="x => x.Type" Title="Type" Required="false" />
                                <PropertyColumn Property="x => x.ISO_SZTP" Title="ISO SZTP" Required="false" />
                                <PropertyColumn Property="x => x.Opt" Title="Opt" Required="false" />
                                <PropertyColumn Property="x => x.FE" Title="FE" Required="false" />
                                <PropertyColumn Property="x => x.Move" Title="Move" Required="false" />
                                <PropertyColumn Property="x => x.Location" Title="Location" Required="false" />
                                <PropertyColumn Property="x => x.BillOfLading" Title="Bill Of Lading" Required="false" />
                                <PropertyColumn Property="x => x.Consignee" Title="Consignee" Required="false">
                                    <EditTemplate>
                                        <MudAutocomplete T="string"
                                                         @bind-Value="context.Item.Consignee"
                                                         Label="Consignee"
                                                         Variant="Variant.Outlined"
                                                         Dense="true"
                                                         SearchFunc="SearchShippers"
                                                         ResetValueOnEmptyText="true" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Truck" Title="Truck" Required="false" />
                                <PropertyColumn Property="x => x.YOM" Title="YOM" Required="false" />
                                <PropertyColumn Property="x => x.SealNo" Title="Seal No" Required="false" />
                                <PropertyColumn Property="x => x.SealNo1" Title="Seal No 1" Required="false" />
                                <PropertyColumn Property="x => x.SealNo2" Title="Seal No 2" Required="false" />
                                <PropertyColumn Property="x => x.VGM" Title="VGM" Required="false" />
                                <PropertyColumn Property="x => x.Clean" Title="Clean" Required="false" />
                                <PropertyColumn Property="x => x.MaxGross" Title="Max Gross" Required="false">
                                    <EditTemplate>
                                        <MudNumericField T="double?" @bind-Value="context.Item.MaxGross" Label="Max Gross"
                                            Variant="Variant.Outlined" HideSpinButtons="true" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.TareWeight" Title="Tare Weight" Required="false">
                                    <EditTemplate>
                                        <MudNumericField T="double?" @bind-Value="context.Item.TareWeight" Label="Tare Weight"
                                            Variant="Variant.Outlined" HideSpinButtons="true" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Remark" Title="Remark" Required="false" />
                                <PropertyColumn Property="x => x.Status" Title="Status" Required="false" />
                                <PropertyColumn Property="x => x.Grade" Title="Grade" Required="false" />
                                <PropertyColumn Property="x => x.Note" Title="Note" Required="false" />
                            </Columns>
                        </MudDataGrid>
                    </MudCardContent>
                </MudTabPanel>
                <MudTabPanel Text="Gate Out">
                    <MudCardContent>
                        <MudStack Row Justify="Justify.FlexStart" Class="mb-4">
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="AddGateOut"
                                StartIcon="@Icons.Material.Filled.Add">Add Gate Out</MudButton>

                            @*<MudButton HtmlTag="label" Color="Color.Secondary" Size="Size.Small"
                                       Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FileUpload">
                                Import Gate Out
                                <InputFile OnChange="ImportGateOutFromExcel" style="display:none" />
                            </MudButton> *@
                        </MudStack>
                        <MudDataGrid T="M_GateOut" Items="@GateOuts" Filterable="true" @ref="gateOutTable"
                            Bordered="true" FilterMode="@DataGridFilterMode.Simple" Dense="true"
                            FixedHeader="true" HeaderClass="no-wrap" ReadOnly="false"
                            CommittedItemChanges="@CommittedGateOut" Loading="_loadingGateOut">
                            <Columns>
                                <TemplateColumn CellClass="d-flex justify-end" Filterable="false"
                                    ShowColumnOptions="false" Sortable="false">
                                    <CellTemplate>
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                                            OnClick="@(() => TryStartEditingGateOut(context.Item))" />
                                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                                            OnClick="@(() => DeleteGateOut(context.Item))" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Seq">
                                    <EditTemplate>
                                        <MudNumericField T="int?" @bind-Value="context.Item.Seq"
                                                         Label="Seq"
                                                         Variant="Variant.Outlined"
                                                         HideSpinButtons="true" />
                                    </EditTemplate>
                                    <CellTemplate>
                                        @context.Item.Seq
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.EIR" Title="EIR" Required="false" />
                                <PropertyColumn Property="x => x.DateIn" Title="Date In" Format="dd/MM/yyyy" Required="false">
                                    <EditTemplate>
                                        <MudDatePicker @bind-Date="context.Item.DateIn" Label="Date In"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.TimeIn" Title="Time In" Required="false">
                                    <EditTemplate>
                                        <MudTimePicker @bind-Time="context.Item.TimeIn" Label="Time In"
                                            Variant="Variant.Outlined" />
                                    </EditTemplate>
                                    <CellTemplate>@(context.Item.TimeIn?.ToString(@"hh\:mm") ?? "")</CellTemplate>
                                </PropertyColumn>
                                <PropertyColumn Property="x => x.Container" Title="Container" Required="false" />
                                <PropertyColumn Property="x => x.Type" Title="Type" Required="false" />
                                <PropertyColumn Property="x => x.ISO_SZTP" Title="ISO SZTP" Required="false" />
                                <PropertyColumn Property="x => x.Opt" Title="Opt" Required="false" />
                                <PropertyColumn Property="x => x.FE" Title="FE" Required="false" />
                                <PropertyColumn Property="x => x.Move" Title="Move" Required="false" />
                                <PropertyColumn Property="x => x.Location" Title="Location" Required="false" />
                                <PropertyColumn Property="x => x.Booking" Title="Booking" Required="false" />
                                <PropertyColumn Property="x => x.Vessel" Title="Vessel" Required="false" />
                                <PropertyColumn Property="x => x.Voyage" Title="Voyage" Required="false" />
                                <PropertyColumn Property="x => x.POL" Title="POL" Required="false">
                                    <EditTemplate>
                                        <MudAutocomplete T="string"
