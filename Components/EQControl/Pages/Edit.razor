@code {
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task Submit()
    {
        if (container == null) return;

        try
        {
            container.OwnerName = string.IsNullOrWhiteSpace(_ownerNameInput) ? null : _ownerNameInput.Trim();
            container.UPDATETIME = DateTime.Now;
            container.USERID = usr;
            var containerOld = JsonSerializer.Deserialize<M_Container>(JsonSerializer.Serialize(container));
            var rs = await shipsv.UpdateContainerMBL(container, containerOld!);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
            {
                MudDialog!.Close(container);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(@Localizer["ErrorSavingContainer"] + " " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    void Cancel() => MudDialog!.Cancel();

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public M_Container? container { get; set; }

    List<M_ContainerMovement> Movements = new List<M_ContainerMovement>();
    List<M_ContainerSeal> Seals = new List<M_ContainerSeal>();
    List<M_ContainerDamage> Damages = new List<M_ContainerDamage>();
    List<M_GateIn> GateIns = new List<M_GateIn>();
    List<M_GateOut> GateOuts = new List<M_GateOut>();
    List<Terminal_> Terminals = new List<Terminal_>();
    List<string> Ports = new List<string>();
    List<string> Shippers = new List<string>();
    List<string> OwnerNames = new List<string>();
    string? _ownerNameInput;

    MudDataGrid<M_ContainerMovement>? movementTable;
    MudDataGrid<M_ContainerSeal>? sealTable;
    MudDataGrid<M_ContainerDamage>? damageTable;
    MudDataGrid<M_GateIn>? gateInTable;
    MudDataGrid<M_GateOut>? gateOutTable;

    bool _loadingMovement = false;
    bool _loadingSeal = false;
    bool _loadingDamage = false;
    bool _loadingGateIn = false;
    bool _loadingGateOut = false;

