</style>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "single-login")]
    private SimpleLoginModel? SimpleLoginInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-login")]
    private TenantLoginModel? LoginInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-login-otp")]
    private TenantLoginOtpModel? LoginOtpInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-login-resend")]
    private TenantLoginResendModel? LoginResendInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-register")]
    private TenantEmailRegisterModel? RegisterInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-register-otp")]
    private TenantEmailOtpRequestModel? RegisterOtpInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-register-resend")]
    private TenantEmailOtpRequestModel? RegisterResendInput { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "db")]
    private string? PrefillDatabaseName { get; set; }

    [SupplyParameterFromQuery(Name = "sqlUser")]
    private string? PrefillSqlUser { get; set; }

    [SupplyParameterFromQuery(Name = "sqlPass")]
    private string? PrefillSqlPassword { get; set; }

    [SupplyParameterFromQuery(Name = "appUser")]
    private string? PrefillAppUser { get; set; }

    [SupplyParameterFromQuery(Name = "appPass")]
    private string? PrefillAppPassword { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private string? RegisteredFlag { get; set; }

    [SupplyParameterFromQuery(Name = "otpStep")]
    private string? OtpStepQuery { get; set; }

    [SupplyParameterFromQuery(Name = "registerEmail")]
    private string? RegisterEmailQuery { get; set; }

    [SupplyParameterFromQuery(Name = "otpSent")]
    private string? OtpSentFlag { get; set; }

    [SupplyParameterFromQuery(Name = "loginOtpStep")]
    private string? LoginOtpStepQuery { get; set; }

    [SupplyParameterFromQuery(Name = "loginSession")]
    private string? LoginSessionQuery { get; set; }

    [SupplyParameterFromQuery(Name = "loginOtpSent")]
    private string? LoginOtpSentFlag { get; set; }

    private enum Tab { Login, Register }
    private Tab activeTab = Tab.Login;

    private bool MultiTenantEnabled => Configuration.GetValue("MultiTenant:Enabled", true);

    private string LoginTabUrl => BuildTabUrl("login");
    private string RegisterTabUrl => BuildTabUrl("register");

    private string? errorMessage;
    private string? successMessage;
    private string? mailFailureCredentials;
    private bool isBusy;
    private int registerStep = 1;
    private int loginStep = 1;
    private string? loginOtpEmail;

    private const string RegisterOtpCachePrefix = "tenant-register-otp:";
    private const string LoginSessionCachePrefix = "tenant-login-session:";
    private static readonly TimeSpan RegisterOtpLifetime = TimeSpan.FromMinutes(1);
    private static readonly TimeSpan LoginOtpLifetime = TimeSpan.FromMinutes(1);

    private void ApplyLoginPrefillFromQuery(TenantLoginModel input)
    {
        if (!string.IsNullOrWhiteSpace(PrefillDatabaseName))
            input.DatabaseName = PrefillDatabaseName.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillSqlUser))
            input.SqlUserId = PrefillSqlUser.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillSqlPassword))
            input.SqlPassword = PrefillSqlPassword.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillAppUser))
            input.AppUserName = PrefillAppUser.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillAppPassword))
            input.AppPassword = PrefillAppPassword.Trim();
    }

    private string BuildLoginPrefillPath(TenantGeneratedCredentials c, bool includeRegistered = false)
    {
        var q = new List<string> { "tab=login" };
        q.Add($"db={Uri.EscapeDataString(c.DatabaseName.Trim())}");
        q.Add($"sqlUser={Uri.EscapeDataString(c.SqlUser.Trim())}");
        q.Add($"sqlPass={Uri.EscapeDataString(c.SqlPassword.Trim())}");
        q.Add($"appUser={Uri.EscapeDataString(c.AppUser.Trim())}");
        q.Add($"appPass={Uri.EscapeDataString(c.AppPassword.Trim())}");
        if (includeRegistered)
            q.Add("registered=1");
        if (!string.IsNullOrEmpty(ReturnUrl))
            q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");

        return $"/Account/Login?{string.Join("&", q)}";
    }

    private string BuildTenantLoginUrl(TenantGeneratedCredentials c, bool includeRegistered = false)
        => navSvc.ToAbsoluteUri(BuildLoginPrefillPath(c, includeRegistered)).ToString();

    private string BuildTabUrl(string tab)
    {
        var q = new List<string> { $"tab={tab}" };
        if (!string.IsNullOrEmpty(ReturnUrl))
            q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        return $"/Account/Login?{string.Join("&", q)}";
    }

    private string RegisterOtpVerifyUrl(string? email)
    {
        var normalizedEmail = NormalizeEmail(email);
        var q = new List<string> { "tab=register", "otpStep=2" };
        if (!string.IsNullOrWhiteSpace(normalizedEmail))
            q.Add($"registerEmail={Uri.EscapeDataString(normalizedEmail)}");
        if (!string.IsNullOrEmpty(ReturnUrl))
            q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        return $"/Account/Login?{string.Join("&", q)}";
    }

    private string LoginOtpVerifyUrl
    {
        get
        {
            var sessionId = LoginOtpInput?.SessionId ?? LoginResendInput?.SessionId ?? LoginSessionQuery;
            var q = new List<string> { "tab=login", "loginOtpStep=2" };
            if (!string.IsNullOrWhiteSpace(sessionId))
                q.Add($"loginSession={Uri.EscapeDataString(sessionId.Trim())}");
            if (!string.IsNullOrEmpty(ReturnUrl))
                q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
            return $"/Account/Login?{string.Join("&", q)}";
        }
    }

    private void ApplyLoginSession(string sessionId)
    {
        LoginOtpInput ??= new TenantLoginOtpModel();
        LoginOtpInput.SessionId = sessionId;
        LoginResendInput ??= new TenantLoginResendModel();
        LoginResendInput.SessionId = sessionId;
    }

    private async Task SyncLoginStepAsync()
    {
        if (activeTab != Tab.Login)
            return;

        var sessionId = LoginSessionQuery?.Trim();
        if (LoginOtpStepQuery == "2" && !string.IsNullOrWhiteSpace(sessionId))
        {
            loginStep = 2;
            ApplyLoginSession(sessionId);
            var session = await GetLoginSessionAsync(sessionId);
            loginOtpEmail = session?.Email;
            return;
        }

        if (!HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var sessionFromOtp = LoginOtpInput?.SessionId?.Trim();
            if (!string.IsNullOrWhiteSpace(sessionFromOtp))
            {
                loginStep = 2;
                ApplyLoginSession(sessionFromOtp);
                var session = await GetLoginSessionAsync(sessionFromOtp);
                loginOtpEmail = session?.Email;
                return;
            }

            var sessionFromResend = LoginResendInput?.SessionId?.Trim();
            if (!string.IsNullOrWhiteSpace(sessionFromResend))
            {
                loginStep = 2;
                ApplyLoginSession(sessionFromResend);
                var session = await GetLoginSessionAsync(sessionFromResend);
                loginOtpEmail = session?.Email;
            }
        }
    }

    private void ApplyRegisterEmail(string email)
    {
        RegisterInput ??= new TenantEmailRegisterModel();
        RegisterInput.Email = email;
        RegisterOtpInput ??= new TenantEmailOtpRequestModel();
        RegisterOtpInput.Email = email;
        RegisterResendInput ??= new TenantEmailOtpRequestModel();
        RegisterResendInput.Email = email;
    }

    private void SyncRegisterStep()
    {
        if (activeTab != Tab.Register)
            return;

        var emailFromQuery = NormalizeEmail(RegisterEmailQuery);
        if (OtpStepQuery == "2" && !string.IsNullOrWhiteSpace(emailFromQuery))
        {
            registerStep = 2;
            ApplyRegisterEmail(emailFromQuery);
            return;
        }

        if (!HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var emailFromRegister = NormalizeEmail(RegisterInput?.Email);
            if (!string.IsNullOrWhiteSpace(emailFromRegister))
            {
                registerStep = 2;
                ApplyRegisterEmail(emailFromRegister);
                return;
            }

            var emailFromResend = NormalizeEmail(RegisterResendInput?.Email);
            if (!string.IsNullOrWhiteSpace(emailFromResend))
            {
                registerStep = 2;
                ApplyRegisterEmail(emailFromResend);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        activeTab = !MultiTenantEnabled
            ? Tab.Login
            : TabQuery?.Equals("register", StringComparison.OrdinalIgnoreCase) == true
                ? Tab.Register
                : Tab.Login;

        SimpleLoginInput ??= new SimpleLoginModel();
        if (!string.IsNullOrWhiteSpace(PrefillAppUser))
            SimpleLoginInput.AppUserName = PrefillAppUser.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillAppPassword))
            SimpleLoginInput.AppPassword = PrefillAppPassword.Trim();

        LoginInput ??= new TenantLoginModel();
        ApplyLoginPrefillFromQuery(LoginInput);
        TrimLoginInput(LoginInput);

        LoginOtpInput ??= new TenantLoginOtpModel();
        LoginResendInput ??= new TenantLoginResendModel();
        RegisterInput ??= new TenantEmailRegisterModel();
        RegisterOtpInput ??= new TenantEmailOtpRequestModel();
        RegisterResendInput ??= new TenantEmailOtpRequestModel();
        await SyncLoginStepAsync();
        if (MultiTenantEnabled)
            SyncRegisterStep();

        if (MultiTenantEnabled && RegisteredFlag == "1")
            successMessage = "Đăng ký database thành công. Vui lòng kiểm tra email để lấy thông tin đăng nhập.";

        if (MultiTenantEnabled && OtpSentFlag == "1" && registerStep == 2 && !string.IsNullOrWhiteSpace(RegisterInput.Email))
            successMessage = $"Mã OTP đã được gửi tới {RegisterInput.Email}. Mã có hiệu lực trong {RegisterOtpLifetime.TotalMinutes:0} phút.";

        if (LoginOtpSentFlag == "1" && loginStep == 2 && !string.IsNullOrWhiteSpace(loginOtpEmail))
            successMessage = $"Mã OTP đã được gửi tới {loginOtpEmail}. Mã có hiệu lực trong {LoginOtpLifetime.TotalMinutes:0} phút.";

        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
    }

    [ValidateAntiForgeryToken]
    public async Task LoginUserSingleDb()
    {
        if (SimpleLoginInput == null) return;

        SimpleLoginInput.AppUserName = SimpleLoginInput.AppUserName.Trim();
        SimpleLoginInput.AppPassword = SimpleLoginInput.AppPassword.Trim();
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var userName = SimpleLoginInput.AppUserName;
            var appUser = await appDb.UserList.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Usr != null && x.Usr.ToLower() == userName.ToLower());

            if (appUser == null)
            {
                errorMessage = "User không tồn tại.";
                return;
            }

            if (SimpleLoginInput.AppPassword != appUser.Pass_viettel)
            {
                errorMessage = "User/Password không đúng.";
                return;
            }

            var authUser = new AuthUser
            {
                Usr = appUser.Usr,
                Name = appUser.Name,
                UsrId = appUser.UsrId,
                Email = appUser.Email,
                Manager2 = appUser.Manager2,
                Department = appUser.Department,
                Send_OTP_login = appUser.Send_OTP_login
            };

            if (!authUser.Send_OTP_login)
            {
                LoginInput ??= new TenantLoginModel();
                LoginInput.RememberMe = SimpleLoginInput.RememberMe;
                await SignInWithClaimsAsync(authUser);
                Logger.LogInformation("User {User} logged in to default database without OTP.", authUser.Usr);
                navSvc.NavigateTo(ReturnUrl ?? "/", true);
                return;
            }

            var email = NormalizeEmail(authUser.Email);
            if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
            {
                errorMessage = "Tài khoản bật xác thực OTP nhưng chưa có email hợp lệ. Vui lòng liên hệ quản trị viên để cập nhật email.";
                return;
            }

            var sessionId = Guid.NewGuid().ToString("N");
            var otp = GenerateOtpCode();
            var session = new LoginPendingSession
            {
                Otp = otp,
                Email = email,
                AuthUser = authUser,
                TenantId = null,
                DatabaseName = null,
                RememberMe = SimpleLoginInput.RememberMe
            };

            await StoreLoginSessionAsync(sessionId, session);

            try
            {
                await SendLoginOtpEmailAsync(email, otp);
            }
            catch (Exception mailEx)
            {
                Logger.LogError(mailEx, "Failed to send login OTP to {Email}.", email);
                await ClearLoginSessionAsync(sessionId);
                errorMessage = "Gửi mã OTP thất bại: " + BuildMailErrorMessage(mailEx);
                return;
            }

            navSvc.NavigateTo(LoginOtpVerifyUrlForSession(sessionId) + "&loginOtpSent=1", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    [ValidateAntiForgeryToken]
    public async Task LoginUser()
    {
        if (!MultiTenantEnabled)
        {
            errorMessage = "Chế độ Multi DB đang tắt. Vui lòng đăng nhập bằng User/Password.";
            return;
        }

        if (LoginInput == null) return;
        TrimLoginInput(LoginInput);
        isBusy = true;
        errorMessage = null;
        successMessage = null;
        mailFailureCredentials = null;

        try
        {
            var result = await tenantAuth.LoginAsync(
                LoginInput.DatabaseName,
                LoginInput.SqlUserId,
                LoginInput.SqlPassword,
                LoginInput.AppUserName,
                LoginInput.AppPassword);

            errorMessage = result.Flag ? null : result.Message;
            if (!result.Flag || result.AuthUser == null || result.TenantId == null)
                return;

            if (!result.AuthUser.Send_OTP_login)
            {
                await SignInWithClaimsAsync(
                    result.AuthUser,
                    result.TenantId.Value,
                    result.TenantDatabaseName ?? LoginInput.DatabaseName.Trim());
                Logger.LogInformation("User {User} logged in to tenant {Db} without OTP.", result.AuthUser.Usr, result.TenantDatabaseName ?? LoginInput.DatabaseName.Trim());
                navSvc.NavigateTo(ReturnUrl ?? "/", true);
                return;
            }

            var email = NormalizeEmail(result.AuthUser.Email);
            if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
            {
                errorMessage = "Tài khoản bật xác thực OTP nhưng chưa có email hợp lệ. Vui lòng liên hệ quản trị viên để cập nhật email.";
                return;
            }

            var sessionId = Guid.NewGuid().ToString("N");
            var otp = GenerateOtpCode();
            var session = new LoginPendingSession
            {
                Otp = otp,
                Email = email,
                AuthUser = result.AuthUser,
                TenantId = result.TenantId.Value,
                DatabaseName = result.TenantDatabaseName ?? LoginInput.DatabaseName.Trim(),
                RememberMe = LoginInput.RememberMe
            };

            await StoreLoginSessionAsync(sessionId, session);

            try
            {
                await SendLoginOtpEmailAsync(email, otp);
            }
            catch (Exception mailEx)
            {
                Logger.LogError(mailEx, "Failed to send login OTP to {Email}.", email);
                await ClearLoginSessionAsync(sessionId);
                errorMessage = "Gửi mã OTP thất bại: " + BuildMailErrorMessage(mailEx);
                return;
            }

            navSvc.NavigateTo(LoginOtpVerifyUrlForSession(sessionId) + "&loginOtpSent=1", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    [ValidateAntiForgeryToken]
    public async Task VerifyLoginOtp()
    {
        if (LoginOtpInput == null) return;

        var sessionId = LoginOtpInput.SessionId?.Trim();
        var otp = (LoginOtpInput.Otp ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(sessionId))
        {
            errorMessage = "Phiên đăng nhập không hợp lệ. Vui lòng đăng nhập lại.";
            loginStep = 1;
            return;
        }

        if (string.IsNullOrWhiteSpace(otp))
        {
            errorMessage = "Nhập mã OTP đã gửi tới email.";
            loginStep = 2;
            ApplyLoginSession(sessionId);
            var pending = await GetLoginSessionAsync(sessionId);
            loginOtpEmail = pending?.Email;
            return;
        }

        var session = await GetLoginSessionAsync(sessionId);
        if (session == null)
        {
            errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
            loginStep = 1;
            return;
        }

        if (!string.Equals(session.Otp, otp, StringComparison.Ordinal))
        {
            errorMessage = "Mã OTP không đúng hoặc đã hết hạn. Vui lòng gửi lại mã.";
            loginStep = 2;
            ApplyLoginSession(sessionId);
            loginOtpEmail = session.Email;
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            LoginInput ??= new TenantLoginModel();
            LoginInput.RememberMe = session.RememberMe;
            SimpleLoginInput ??= new SimpleLoginModel();
            SimpleLoginInput.RememberMe = session.RememberMe;

            await SignInWithClaimsAsync(session.AuthUser, session.TenantId, session.DatabaseName);
            await ClearLoginSessionAsync(sessionId);
            Logger.LogInformation(
                "User {User} logged in{TenantInfo} after OTP verification.",
                session.AuthUser.Usr,
                string.IsNullOrWhiteSpace(session.DatabaseName) ? " to default database" : $" to tenant {session.DatabaseName}");
            navSvc.NavigateTo(ReturnUrl ?? "/", true);
        }
        finally
        {
            isBusy = false;
        }
    }

    [ValidateAntiForgeryToken]
    public async Task ResendLoginOtp()
    {
        var sessionId = LoginResendInput?.SessionId?.Trim();
        if (string.IsNullOrWhiteSpace(sessionId))
        {
            errorMessage = "Phiên đăng nhập không hợp lệ. Vui lòng đăng nhập lại.";
            loginStep = 1;
            return;
        }

        var session = await GetLoginSessionAsync(sessionId);
        if (session == null)
        {
            errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
            loginStep = 1;
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var otp = GenerateOtpCode();
            session.Otp = otp;
            await StoreLoginSessionAsync(sessionId, session);

            try
            {
                await SendLoginOtpEmailAsync(session.Email, otp);
            }
            catch (Exception mailEx)
