    private async Task SendRegistrationOtpEmailAsync(string email, string otp)
    {
        var settings = ReadTenantSmtpSettings();
        var message = BuildRegistrationOtpMessage(email, otp, settings);
        var attempts = await BuildSmtpConnectionAttemptsAsync(settings);
        var failures = new List<string>();

        foreach (var attempt in attempts)
        {
            using var client = new MailKit.Net.Smtp.SmtpClient();
            try
            {
                await client.ConnectAsync(attempt.Host, settings.Port, attempt.SocketOptions);
                await client.AuthenticateAsync(settings.Username, settings.Password);
                await client.SendAsync(message);
                await client.DisconnectAsync(true);
                return;
            }
            catch (Exception ex)
            {
                failures.Add($"{attempt.Host}:{settings.Port} [{attempt.SocketOptions}] - {FlattenExceptionMessage(ex)}");
                try
                {
                    if (client.IsConnected)
                        await client.DisconnectAsync(true);
                }
                catch
                {
                }
            }
        }

        var attemptedHosts = string.Join(", ", attempts.Select(static a => a.Host).Distinct(StringComparer.OrdinalIgnoreCase));
        var detail = string.Join(" || ", failures);
        throw new InvalidOperationException(
            $"Không thể gửi mã OTP. Ứng dụng đã thử các host SMTP: {attemptedHosts}. Chi tiết: {detail}");
    }

    private static MimeMessage BuildRegistrationOtpMessage(string email, string otp, TenantSmtpSettings settings)
    {
        var sender = new MailboxAddress(settings.FromName, settings.FromEmail);
        var message = new MimeMessage();
        message.From.Add(sender);
        message.Sender = sender;
        message.To.Add(MailboxAddress.Parse(email));
        message.ReplyTo.Add(sender);
        message.Subject = "Mã OTP xác nhận đăng ký LMS";
        message.Body = new BodyBuilder
        {
            HtmlBody = BuildRegistrationOtpEmailHtml(email, otp)
        }.ToMessageBody();
        return message;
    }

