@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authentication
@using System.Security.Claims
@using System.Security.Cryptography
@using System.Text.Json
@using System.Text
@using System.Text.RegularExpressions
@using System.Net
@using MailKit.Security
@using MimeKit
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Distributed
@using ABFreight.Data
@using ABFreight.Services
@using ABFreight.Services.MultiTenant
@using ABFreight.Models
@using ABFreight.Helpers

@page "/Account/Login"
@inject NavigationManager navSvc
@inject ILogger<Login> Logger
@inject TenantAuthService tenantAuth
@inject RegistryDbContext registryDb
@inject AppDbContext appDb
@inject IDistributedCache distributedCache
@inject IConfiguration Configuration

<PageTitle>Log in</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
</HeadContent>

<div class="login-shell d-flex flex-column justify-content-center align-items-center py-4">
    <div class="login-brand text-center mb-3">
        <div class="brand-badge">LMS</div>
        <h1>LMS</h1>
        <p>@(MultiTenantEnabled ? "Đăng nhập database riêng hoặc đăng ký database mới bằng email" : "Đăng nhập hệ thống")</p>
    </div>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger w-100" style="max-width:560px;" role="alert">
            @errorMessage
        </div>
    }
    @if (successMessage != null)
    {
        <div class="alert alert-success w-100" style="max-width:560px;" role="alert">
            @successMessage
        </div>
    }
    @if (MultiTenantEnabled && !string.IsNullOrWhiteSpace(mailFailureCredentials))
    {
        <div class="alert alert-warning w-100" style="max-width:560px;" role="alert">
            <div class="fw-bold mb-2">Database đã tạo thành công. Email chưa gửi được, copy tạm thông tin bên dưới:</div>
            <pre class="mb-0 small" style="white-space:pre-wrap;word-break:break-word;">@mailFailureCredentials</pre>
        </div>
    }

    @if (!MultiTenantEnabled)
    {
        @if (loginStep < 2)
        {
            <EditForm id="singleLoginForm" Model="SimpleLoginInput" method="post" OnValidSubmit="LoginUserSingleDb" FormName="single-login"
                      action="@LoginTabUrl" class="w-100" style="max-width:560px;">
                <DataAnnotationsValidator />
                <AntiForgeryToken />
                <div class="card login-card">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold">Đăng nhập</h5>
                        <p class="small text-muted">Nhập tài khoản ứng dụng trên database gốc. Nếu tài khoản bật OTP, hệ thống sẽ gửi mã tới email đã đăng ký.</p>
                        <ValidationSummary class="text-danger" role="alert" />

                        <div class="form-floating mb-3 mt-2">
                            <InputText id="singleAppUserName" @bind-Value="SimpleLoginInput.AppUserName" class="form-control" autocomplete="username" />
                            <label>User Name / Email</label>
                            <ValidationMessage For="() => SimpleLoginInput.AppUserName" class="text-danger" />
                        </div>
                        <div class="form-floating mb-3">
                            <InputText id="singleAppPassword" type="password" @bind-Value="SimpleLoginInput.AppPassword" class="form-control" autocomplete="current-password" />
                            <label>Password</label>
                            <ValidationMessage For="() => SimpleLoginInput.AppPassword" class="text-danger" />
                        </div>

                        <div class="checkbox mb-3">
                            <label class="form-label mb-1">
                                <InputCheckbox id="singleRememberMe" @bind-Value="SimpleLoginInput.RememberMe" class="form-check-input" />
                                Nhớ thông tin đăng nhập
                            </label>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary" disabled="@isBusy">@(isBusy ? "Đang xử lý..." : "Đăng nhập")</button>
                        <div class="mt-2 text-center">
                            <NavLink class="btn btn-link" href="/AccountPass">Quên mật khẩu?</NavLink>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
        else
        {
            <EditForm Model="LoginOtpInput" method="post" OnValidSubmit="VerifyLoginOtp" FormName="tenant-login-otp"
                      action="@LoginOtpVerifyUrl" class="w-100" style="max-width:560px;">
                <DataAnnotationsValidator />
                <AntiForgeryToken />
                <div class="d-none">
                    <InputText @bind-Value="LoginOtpInput.SessionId" />
                </div>
                <div class="card login-card">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold">Xác thực OTP đăng nhập</h5>
                        <p class="small text-muted mb-3">
                            Mã OTP đã gửi tới <b>@loginOtpEmail</b>. Nhập mã 6 số để hoàn tất đăng nhập.
                        </p>
                        <ValidationSummary class="text-danger" role="alert" />

                        <div class="form-floating mb-3">
                            <InputText @bind-Value="LoginOtpInput.Otp" class="form-control" autocomplete="one-time-code" placeholder="123456" maxlength="6" />
                            <label>Mã OTP</label>
                            <ValidationMessage For="() => LoginOtpInput.Otp" class="text-danger" />
                        </div>

                        <button type="submit" class="w-100 btn btn-lg btn-primary mb-2" disabled="@isBusy">
                            @(isBusy ? "Đang xác thực..." : "Xác nhận OTP & đăng nhập")
                        </button>
                        <NavLink class="btn btn-link w-100" href="@LoginTabUrl">Quay lại đăng nhập</NavLink>
                    </div>
                </div>
            </EditForm>

            <EditForm Model="LoginResendInput" method="post" OnValidSubmit="ResendLoginOtp" FormName="tenant-login-resend"
                      action="@LoginOtpVerifyUrl" class="w-100" style="max-width:560px;">
                <AntiForgeryToken />
                <div class="d-none">
                    <InputText @bind-Value="LoginResendInput.SessionId" />
                </div>
                <button type="submit" class="w-100 btn btn-outline-secondary btn-sm" disabled="@isBusy">
                    Gửi lại mã OTP
                </button>
            </EditForm>
        }
    }
    else
    {
    <ul class="nav nav-tabs mb-0 tenant-tabs" style="max-width:560px; width:100%;">
        <li class="nav-item">
            <a class="nav-link @(activeTab == Tab.Login ? "active" : "")" href="@LoginTabUrl">Đăng nhập</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == Tab.Register ? "active" : "")" href="@RegisterTabUrl">Đăng ký bằng email</a>
        </li>
    </ul>

    @if (activeTab == Tab.Login)
    {
        @if (loginStep < 2)
        {
        <EditForm id="tenantLoginForm" Model="LoginInput" method="post" OnValidSubmit="LoginUser" FormName="tenant-login"
                  action="@LoginTabUrl" class="w-100" style="max-width:560px;">
            <DataAnnotationsValidator />
            <AntiForgeryToken />
            <div class="card border-top-0 rounded-top-0 login-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold">Đăng nhập database đã có</h5>
                    <p class="small text-muted">Nhập thông tin SQL Server của tenant và tài khoản ứng dụng. Nếu tài khoản bật xác thực OTP, hệ thống sẽ gửi mã tới email đã đăng ký.</p>
                    <ValidationSummary class="text-danger" role="alert" />

                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="float-none w-auto px-2 fs-6 mb-0">SQL Server tenant</legend>
                        <div class="form-floating mb-2 mt-2">
                            <InputText id="tenantDatabaseName" @bind-Value="LoginInput.DatabaseName" class="form-control" autocomplete="off" placeholder="TenDatabase" />
                            <label>Tên database</label>
                            <ValidationMessage For="() => LoginInput.DatabaseName" class="text-danger" />
                        </div>
                        <div class="form-floating mb-2">
                            <InputText id="tenantSqlUserId" @bind-Value="LoginInput.SqlUserId" class="form-control" autocomplete="off" placeholder="sql-user" />
                            <label>SQL User</label>
                            <ValidationMessage For="() => LoginInput.SqlUserId" class="text-danger" />
                        </div>
                        <div class="form-floating mb-2">
                            <InputText id="tenantSqlPassword" type="password" @bind-Value="LoginInput.SqlPassword" class="form-control" autocomplete="off" />
                            <label>SQL Password</label>
                            <ValidationMessage For="() => LoginInput.SqlPassword" class="text-danger" />
                        </div>
                    </fieldset>

                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="float-none w-auto px-2 fs-6 mb-0">Ứng dụng</legend>
                        <div class="form-floating mb-2 mt-2">
                            <InputText id="tenantAppUserName" @bind-Value="LoginInput.AppUserName" class="form-control" autocomplete="username" />
                            <label>User Name / Email</label>
                            <ValidationMessage For="() => LoginInput.AppUserName" class="text-danger" />
                        </div>
                        <div class="form-floating mb-2">
                            <InputText id="tenantAppPassword" type="password" @bind-Value="LoginInput.AppPassword" class="form-control" autocomplete="current-password" />
                            <label>Password</label>
                            <ValidationMessage For="() => LoginInput.AppPassword" class="text-danger" />
                        </div>
                    </fieldset>

                    <div class="checkbox mb-3">
                        <label class="form-label mb-1">
                            <InputCheckbox id="tenantRememberMe" @bind-Value="LoginInput.RememberMe" class="form-check-input" />
                            Nhớ toàn bộ thông tin đăng nhập
                        </label>
                        <div class="form-text text-muted small">Lần đăng nhập sau hệ thống sẽ tự điền Database, SQL User, SQL Password, App User và App Password trên trình duyệt này.</div>
                    </div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary" disabled="@isBusy">@(isBusy ? "Đang xử lý..." : "Đăng nhập")</button>
                    <div class="mt-2 text-center">
                        <NavLink class="btn btn-link" href="/AccountPass">Quên mật khẩu?</NavLink>
                    </div>
                </div>
            </div>
        </EditForm>
        }
        else
        {
        <EditForm Model="LoginOtpInput" method="post" OnValidSubmit="VerifyLoginOtp" FormName="tenant-login-otp"
                  action="@LoginOtpVerifyUrl" class="w-100" style="max-width:560px;">
            <DataAnnotationsValidator />
            <AntiForgeryToken />
            <div class="d-none">
                <InputText @bind-Value="LoginOtpInput.SessionId" />
            </div>
            <div class="card border-top-0 rounded-top-0 login-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold">Xác thực OTP đăng nhập</h5>
                    <p class="small text-muted mb-3">
                        Mã OTP đã gửi tới <b>@loginOtpEmail</b>. Nhập mã 6 số để hoàn tất đăng nhập.
                    </p>
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="form-floating mb-3">
                        <InputText @bind-Value="LoginOtpInput.Otp" class="form-control" autocomplete="one-time-code" placeholder="123456" maxlength="6" />
                        <label>Mã OTP</label>
                        <ValidationMessage For="() => LoginOtpInput.Otp" class="text-danger" />
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary mb-2" disabled="@isBusy">
                        @(isBusy ? "Đang xác thực..." : "Xác nhận OTP & đăng nhập")
                    </button>
                    <NavLink class="btn btn-link w-100" href="@LoginTabUrl">Quay lại đăng nhập</NavLink>
                </div>
            </div>
        </EditForm>

        <EditForm Model="LoginResendInput" method="post" OnValidSubmit="ResendLoginOtp" FormName="tenant-login-resend"
                  action="@LoginOtpVerifyUrl" class="w-100" style="max-width:560px;">
            <AntiForgeryToken />
            <div class="d-none">
                <InputText @bind-Value="LoginResendInput.SessionId" />
            </div>
            <button type="submit" class="w-100 btn btn-outline-secondary btn-sm" disabled="@isBusy">
                Gửi lại mã OTP
            </button>
        </EditForm>
        }
    }
    else if (registerStep < 2)
    {
        <EditForm Model="RegisterOtpInput" method="post" OnValidSubmit="SendRegisterOtp" FormName="tenant-register-otp"
                  action="@RegisterTabUrl" class="w-100" style="max-width:560px;">
            <DataAnnotationsValidator />
            <AntiForgeryToken />
            <div class="card border-top-0 rounded-top-0 login-card register-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold">Đăng ký database mới</h5>
                    <p class="small text-muted mb-3">
                        Nhập email đăng ký. Hệ thống sẽ gửi mã OTP để xác nhận trước khi tạo database.
                    </p>
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="form-floating mb-3">
                        <InputText @bind-Value="RegisterOtpInput.Email" class="form-control" autocomplete="email" placeholder="name@company.com" />
                        <label>Email đăng ký</label>
                        <ValidationMessage For="() => RegisterOtpInput.Email" class="text-danger" />
                    </div>

                    <div class="small text-muted border rounded p-3 mb-3 bg-light">
                        Sau khi xác nhận OTP và tạo thành công, email sẽ nhận được:
                        <ul class="mb-0 mt-1">
                            <li>Database Name</li>
                            <li>SQL User / SQL Password</li>
                            <li>App User / App Password</li>
                            <li>Link đăng nhập</li>
                        </ul>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-success" disabled="@isBusy">
                        @(isBusy ? "Đang gửi mã OTP..." : "Gửi mã OTP xác nhận")
                    </button>
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <EditForm Model="RegisterInput" method="post" OnValidSubmit="RegisterTenant" FormName="tenant-register"
                  action="@RegisterOtpVerifyUrl(RegisterInput.Email)" class="w-100" style="max-width:560px;">
            <DataAnnotationsValidator />
            <AntiForgeryToken />
            <div class="d-none">
                <InputText @bind-Value="RegisterInput.Email" />
            </div>
            <div class="card border-top-0 rounded-top-0 login-card register-card">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold">Xác nhận email</h5>
                    <p class="small text-muted mb-3">
                        Mã OTP đã gửi tới <b>@RegisterInput.Email</b>. Nhập mã 6 số để hoàn tất đăng ký.
                    </p>
                    <ValidationSummary class="text-danger" role="alert" />

                    <div class="form-floating mb-3">
                        <InputText @bind-Value="RegisterInput.Otp" class="form-control" autocomplete="one-time-code" placeholder="123456" maxlength="6" />
                        <label>Mã OTP</label>
                        <ValidationMessage For="() => RegisterInput.Otp" class="text-danger" />
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-success mb-2" disabled="@isBusy">
                        @(isBusy ? "Đang xác nhận và tạo database..." : "Xác nhận OTP & đăng ký")
                    </button>
                </div>
            </div>
        </EditForm>

        <EditForm Model="RegisterResendInput" method="post" OnValidSubmit="SendRegisterOtp" FormName="tenant-register-resend"
                  action="@RegisterOtpVerifyUrl(RegisterResendInput.Email)" class="w-100" style="max-width:560px;">
            <AntiForgeryToken />
            <div class="d-none">
                <InputText @bind-Value="RegisterResendInput.Email" />
            </div>
            <button type="submit" class="w-100 btn btn-outline-secondary btn-sm" disabled="@isBusy">
                Gửi lại mã OTP
            </button>
        </EditForm>
    }
    }
</div>


<script>
    (function () {
        const storageKey = "lms_tenant_login_remember_all";

        function el(id) {
            return document.getElementById(id);
        }

        function trimValue(value) {
            return value === undefined || value === null ? "" : String(value).trim();
        }

        function setInputValue(id, value) {
            const input = el(id);
            if (!input || value === undefined || value === null) return;

            input.value = trimValue(value);
            input.dispatchEvent(new Event("input", { bubbles: true }));
            input.dispatchEvent(new Event("change", { bubbles: true }));
        }

        function readInputValue(id) {
            const input = el(id);
            return input ? trimValue(input.value) : "";
        }

        function trimInputInPlace(input) {
            if (!input) return;

            const trimmed = trimValue(input.value);
            if (trimmed === input.value) return;

            input.value = trimmed;
            input.dispatchEvent(new Event("input", { bubbles: true }));
            input.dispatchEvent(new Event("change", { bubbles: true }));
        }

        function trimAllLoginInputs() {
            ["tenantDatabaseName", "tenantSqlUserId", "tenantSqlPassword", "tenantAppUserName", "tenantAppPassword"].forEach(function (id) {
                trimInputInPlace(el(id));
            });
        }

        function saveRememberedLogin() {
            const remember = el("tenantRememberMe");
            if (!remember || !remember.checked) {
                localStorage.removeItem(storageKey);
                return;
            }

            const data = {
                databaseName: readInputValue("tenantDatabaseName"),
                sqlUserId: readInputValue("tenantSqlUserId"),
                sqlPassword: readInputValue("tenantSqlPassword"),
                appUserName: readInputValue("tenantAppUserName"),
                appPassword: readInputValue("tenantAppPassword")
            };

            localStorage.setItem(storageKey, JSON.stringify(data));
        }

        function loadRememberedLogin() {
            const raw = localStorage.getItem(storageKey);
            if (!raw) return;

            try {
                const data = JSON.parse(raw);
                setInputValue("tenantDatabaseName", data.databaseName);
                setInputValue("tenantSqlUserId", data.sqlUserId);
                setInputValue("tenantSqlPassword", data.sqlPassword);
                setInputValue("tenantAppUserName", data.appUserName);
                setInputValue("tenantAppPassword", data.appPassword);

                const remember = el("tenantRememberMe");
                if (remember) {
                    remember.checked = true;
                    remember.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }
            catch {
                localStorage.removeItem(storageKey);
            }
        }

        function applyQueryPrefill() {
            const params = new URLSearchParams(window.location.search);
            const mappings = [
                ["tenantDatabaseName", "db"],
                ["tenantSqlUserId", "sqlUser"],
                ["tenantSqlPassword", "sqlPass"],
                ["tenantAppUserName", "appUser"],
                ["tenantAppPassword", "appPass"]
            ];

            let appliedSensitive = false;
            mappings.forEach(function (pair) {
                const value = params.get(pair[1]);
                if (!value) return;

                setInputValue(pair[0], value);
                if (pair[1] !== "db") appliedSensitive = true;
            });

            if (appliedSensitive) {
                const clean = new URL(window.location.href);
                ["sqlUser", "sqlPass", "appUser", "appPass"].forEach(function (key) {
                    clean.searchParams.delete(key);
                });
                window.history.replaceState({}, "", clean.pathname + clean.search + clean.hash);
            }
        }

        function hookRememberLogin() {
            const form = el("tenantLoginForm");
            if (!form) return;

            loadRememberedLogin();
            applyQueryPrefill();

            if (form.dataset.rememberHooked === "1") return;
            form.dataset.rememberHooked = "1";

            form.addEventListener("submit", function () {
                trimAllLoginInputs();
                saveRememberedLogin();
            });

            const remember = el("tenantRememberMe");
            if (remember) {
                remember.addEventListener("change", function () {
                    if (remember.checked) saveRememberedLogin();
                    else localStorage.removeItem(storageKey);
                });
            }

            ["tenantDatabaseName", "tenantSqlUserId", "tenantSqlPassword", "tenantAppUserName", "tenantAppPassword"].forEach(function (id) {
                const input = el(id);
                if (!input) return;

                input.addEventListener("blur", function () {
                    trimInputInPlace(input);
                });

                input.addEventListener("paste", function () {
                    setTimeout(function () {
                        trimInputInPlace(input);
                    }, 0);
                });

                input.addEventListener("input", function () {
                    const rememberNow = el("tenantRememberMe");
                    if (rememberNow && rememberNow.checked) saveRememberedLogin();
                });
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", hookRememberLogin);
        }
        else {
            setTimeout(hookRememberLogin, 0);
        }

        window.lmsTenantLoginRemember = {
            load: hookRememberLogin,
            save: saveRememberedLogin,
            clear: function () { localStorage.removeItem(storageKey); }
        };
    })();
</script>

<style>
    .login-shell {
        min-height: 100vh;
        background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 45%, #ecfdf5 100%);
        padding-left: 16px;
        padding-right: 16px;
    }

    .login-brand .brand-badge {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        margin: 0 auto 10px auto;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 800;
        background: linear-gradient(135deg, #0f766e, #2563eb);
        box-shadow: 0 12px 26px rgba(37, 99, 235, .22);
    }

    .login-brand h1 {
        font-weight: 800;
        letter-spacing: .2px;
        margin: 0;
        color: #0f172a;
    }

    .login-brand p {
        color: #64748b;
        margin: 4px 0 0 0;
        font-size: 14px;
    }

    .tenant-tabs .nav-link {
        font-weight: 700;
        color: #475569;
        border-radius: 14px 14px 0 0;
    }

    .tenant-tabs .nav-link.active {
