    private string LoginOtpVerifyUrlForSession(string sessionId)
    {
        var q = new List<string> { "tab=login", "loginOtpStep=2", $"loginSession={Uri.EscapeDataString(sessionId)}" };
        if (!string.IsNullOrEmpty(ReturnUrl))
            q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        return $"/Account/Login?{string.Join("&", q)}";
    }

    private static string LoginSessionCacheKey(string sessionId)
        => LoginSessionCachePrefix + sessionId;

    private Task StoreLoginSessionAsync(string sessionId, LoginPendingSession session)
    {
        var options = new DistributedCacheEntryOptions
        {
            AbsoluteExpirationRelativeToNow = LoginOtpLifetime
        };
        var json = JsonSerializer.Serialize(session);
        return distributedCache.SetStringAsync(LoginSessionCacheKey(sessionId), json, options);
    }

    private async Task<LoginPendingSession?> GetLoginSessionAsync(string sessionId)
    {
        var json = await distributedCache.GetStringAsync(LoginSessionCacheKey(sessionId));
        if (string.IsNullOrWhiteSpace(json))
            return null;

        try
        {
            return JsonSerializer.Deserialize<LoginPendingSession>(json);
        }
        catch
        {
            return null;
        }
    }

    private Task ClearLoginSessionAsync(string sessionId)
        => distributedCache.RemoveAsync(LoginSessionCacheKey(sessionId));

    private async Task SendLoginOtpEmailAsync(string email, string otp)
    {
        var settings = ReadTenantSmtpSettings();
        var message = BuildLoginOtpMessage(email, otp, settings);
        var attempts = await BuildSmtpConnectionAttemptsAsync(settings);
        var failures = new List<string>();

        foreach (var attempt in attempts)
        {
            using var client = new MailKit.Net.Smtp.SmtpClient();
            try
            {
                await client.ConnectAsync(attempt.Host, settings.Port, attempt.SocketOptions);
                await client.AuthenticateAsync(settings.Username, settings.Password);
                await client.SendAsync(message);
                await client.DisconnectAsync(true);
                return;
            }
            catch (Exception ex)
            {
                failures.Add($"{attempt.Host}:{settings.Port} [{attempt.SocketOptions}] - {FlattenExceptionMessage(ex)}");
                try
                {
                    if (client.IsConnected)
                        await client.DisconnectAsync(true);
                }
                catch
                {
                }
            }
        }

        var attemptedHosts = string.Join(", ", attempts.Select(static a => a.Host).Distinct(StringComparer.OrdinalIgnoreCase));
        var detail = string.Join(" || ", failures);
        throw new InvalidOperationException(
            $"Không thể gửi mã OTP. Ứng dụng đã thử các host SMTP: {attemptedHosts}. Chi tiết: {detail}");
    }

    private static MimeMessage BuildLoginOtpMessage(string email, string otp, TenantSmtpSettings settings)
    {
        var sender = new MailboxAddress(settings.FromName, settings.FromEmail);
        var message = new MimeMessage();
        message.From.Add(sender);
        message.Sender = sender;
        message.To.Add(MailboxAddress.Parse(email));
        message.ReplyTo.Add(sender);
        message.Subject = "Mã OTP xác thực đăng nhập LMS";
        message.Body = new BodyBuilder
        {
            HtmlBody = BuildLoginOtpEmailHtml(email, otp)
        }.ToMessageBody();
        return message;
    }

    private static string BuildLoginOtpEmailHtml(string email, string otp)
    {
        string H(string? value) => WebUtility.HtmlEncode((value ?? string.Empty).Trim());

        return $@"
<div style='font-family:Segoe UI,Arial,sans-serif;background:#f8fafc;padding:24px;color:#0f172a;'>
  <div style='max-width:560px;margin:0 auto;background:white;border:1px solid #e2e8f0;border-radius:18px;overflow:hidden;'>
    <div style='padding:22px 26px;background:linear-gradient(135deg,#0f766e,#2563eb);color:white;'>
      <h2 style='margin:0;font-size:22px;'>LMS</h2>
      <div style='opacity:.88;margin-top:4px;'>Xác thực đăng nhập</div>
    </div>
    <div style='padding:24px 26px;'>
      <p>Xin chào,</p>
      <p>Bạn đang đăng nhập vào LMS với tài khoản liên kết email <b>{H(email)}</b>.</p>
      <p>Mã OTP của bạn:</p>
      <div style='font-size:28px;font-weight:800;letter-spacing:6px;color:#0f766e;margin:16px 0;'>{H(otp)}</div>
      <p style='font-size:13px;color:#64748b;'>Mã có hiệu lực trong {LoginOtpLifetime.TotalMinutes:0} phút. Không chia sẻ mã này cho người khác.</p>
    </div>
  </div>
</div>";
    }

    [ValidateAntiForgeryToken]
    public async Task SendRegisterOtp()
    {
        if (!MultiTenantEnabled)
        {
            errorMessage = "Chế độ Multi DB đang tắt. Đăng ký database tạm thời không khả dụng.";
            return;
        }

        var source = RegisterOtpInput ?? RegisterResendInput;
        if (source == null) return;

        var email = NormalizeEmail(source.Email);
        if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
        {
            errorMessage = "Email không hợp lệ.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        mailFailureCredentials = null;

        try
        {
            var generated = BuildTenantCredentials(email);
            if (await IsTenantDatabaseRegisteredAsync(generated.DatabaseName))
            {
                errorMessage = "Email này đã được đăng ký hoặc database tương ứng đã tồn tại. Vui lòng dùng email khác hoặc liên hệ LMS để cấp lại thông tin đăng nhập.";
                return;
            }

            var otp = GenerateOtpCode();
            await StoreRegisterOtpAsync(email, otp);

            try
            {
                await SendRegistrationOtpEmailAsync(email, otp);
            }
            catch (Exception mailEx)
            {
                Logger.LogError(mailEx, "Failed to send registration OTP to {Email}.", email);
                await ClearRegisterOtpAsync(email);
                errorMessage = "Gửi mã OTP thất bại: " + BuildMailErrorMessage(mailEx);
                return;
            }

            navSvc.NavigateTo(RegisterOtpVerifyUrl(email) + "&otpSent=1", forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    [ValidateAntiForgeryToken]
    public async Task RegisterTenant()
    {
        if (!MultiTenantEnabled)
        {
            errorMessage = "Chế độ Multi DB đang tắt. Đăng ký database tạm thời không khả dụng.";
            return;
        }

        if (RegisterInput == null) return;

        var email = NormalizeEmail(RegisterInput.Email);
        if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
        {
            errorMessage = "Email không hợp lệ.";
            registerStep = 1;
            return;
        }

        var otp = (RegisterInput.Otp ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(otp))
        {
            errorMessage = "Nhập mã OTP đã gửi tới email.";
            registerStep = 2;
            ApplyRegisterEmail(email);
            return;
        }

        if (!await ValidateRegisterOtpAsync(email, otp))
        {
            errorMessage = "Mã OTP không đúng hoặc đã hết hạn. Vui lòng gửi lại mã.";
            registerStep = 2;
            ApplyRegisterEmail(email);
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        mailFailureCredentials = null;

        var generated = BuildTenantCredentials(email);

        try
        {
            var admin = new AuthUser
            {
                Name = email,
                Usr = email,
                Email = email,
                Pass_viettel = generated.AppPassword,
                Department = "ADMIN",
                Branch = "SGN",
                CompanyCode = "AMSS"
            };

            var result = await tenantAuth.RegisterTenantAsync(
                generated.DatabaseName,
                generated.SqlUser,
                generated.SqlPassword,
                admin);

            if (!result.Flag)
            {
                errorMessage = IsDuplicateMessage(result.Message)
                    ? "Email này đã được đăng ký hoặc database tương ứng đã tồn tại. Vui lòng dùng email khác hoặc liên hệ LMS để cấp lại thông tin đăng nhập."
                    : result.Message;
                registerStep = 2;
                ApplyRegisterEmail(email);
                return;
            }

            await ClearRegisterOtpAsync(email);

            try
            {
                await SendTenantCreatedEmailAsync(generated);
            }
            catch (Exception mailEx)
            {
                Logger.LogError(mailEx, "Tenant created but email sending failed for {Email}.", email);
                successMessage = "Database đã tạo thành công nhưng SMTP chưa xác thực được. Anh kiểm tra Host/Port/UserName/Password/EnableSsl rồi gửi lại email.";
                errorMessage = "Gửi email thất bại: " + BuildMailErrorMessage(mailEx);
                mailFailureCredentials = BuildCredentialBackupText(generated);
                return;
            }

            navSvc.NavigateTo(BuildLoginPrefillPath(generated, includeRegistered: true), forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

