    private async Task<IReadOnlyList<SmtpConnectionAttempt>> BuildSmtpConnectionAttemptsAsync(TenantSmtpSettings settings)
    {
        var hosts = new List<string>();
        AddHostCandidate(hosts, settings.Host);

        foreach (var resolvedHost in await ResolveReverseDnsHostsAsync(settings.Host))
            AddHostCandidate(hosts, resolvedHost);

        var senderDomain = ExtractEmailDomain(settings.FromEmail) ?? ExtractEmailDomain(settings.Username);
        if (!string.IsNullOrWhiteSpace(senderDomain))
        {
            AddHostCandidate(hosts, $"smtp.{senderDomain}");
            AddHostCandidate(hosts, $"mail.{senderDomain}");
            AddHostCandidate(hosts, senderDomain);
        }

        if (settings.Host.StartsWith("mail.", StringComparison.OrdinalIgnoreCase)
            || settings.Host.StartsWith("smtp.", StringComparison.OrdinalIgnoreCase))
        {
            AddHostCandidate(hosts, settings.Host[(settings.Host.IndexOf('.') + 1)..]);
        }

        var socketOptions = BuildSocketOptions(settings.Port, settings.EnableSsl);
        return hosts
            .SelectMany(host => socketOptions.Select(option => new SmtpConnectionAttempt(host, option)))
            .ToList();
    }

    private static IReadOnlyList<SecureSocketOptions> BuildSocketOptions(int port, bool enableSsl)
    {
        var options = new List<SecureSocketOptions>();

        if (enableSsl)
        {
            options.Add(port == 465 ? SecureSocketOptions.SslOnConnect : SecureSocketOptions.StartTls);
            options.Add(SecureSocketOptions.Auto);
        }
        else
        {
            options.Add(SecureSocketOptions.None);
            options.Add(SecureSocketOptions.Auto);
        }

        return options.Distinct().ToList();
    }

    private static async Task<IReadOnlyList<string>> ResolveReverseDnsHostsAsync(string host)
    {
        var results = new List<string>();

        try
        {
            var addresses = await Dns.GetHostAddressesAsync(host);
            foreach (var address in addresses)
            {
                try
                {
                    var entry = await Dns.GetHostEntryAsync(address);
                    AddHostCandidate(results, entry.HostName);
                }
                catch
                {
                }
            }
        }
        catch
        {
        }

        return results;
    }

    private static void AddHostCandidate(ICollection<string> hosts, string? host)
    {
        var normalized = host?.Trim().TrimEnd('.');
        if (string.IsNullOrWhiteSpace(normalized))
            return;

        if (!hosts.Contains(normalized, StringComparer.OrdinalIgnoreCase))
            hosts.Add(normalized);
    }

    private static string? ExtractEmailDomain(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return null;

        var atIndex = email.LastIndexOf('@');
        if (atIndex < 0 || atIndex == email.Length - 1)
            return null;

        return email[(atIndex + 1)..].Trim();
    }

