@using MudBlazor
@using Microsoft.EntityFrameworkCore
@using ABFreight.Models
@using ABFreight.Services
@inject LeaveRequestService LeaveService
@inject AccountService AccountService
@inject GlobalServices GlobalServices
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-4">Đăng ký nghỉ phép</MudText>
    
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_leaveType" Label="Loại nghỉ phép" Required="true">
                    <MudSelectItem Value="1">Nghỉ phép năm</MudSelectItem>
                    <MudSelectItem Value="2">Nghỉ ốm</MudSelectItem>
                    <MudSelectItem Value="3">Nghỉ việc riêng</MudSelectItem>
                    <MudSelectItem Value="4">Nghỉ không lương</MudSelectItem>
                    <MudSelectItem Value="5">Xin ra ngoài</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_durationType" Label="Loại thời gian" Required="true" T="int">
                    @if (_leaveType != 5)
                    {
                        <MudSelectItem Value="1">Cả ngày</MudSelectItem>
                    }
                    <MudSelectItem Value="2">Nửa ngày</MudSelectItem>
                    <MudSelectItem Value="3">Theo giờ</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (_durationType == 1 || _durationType == 2)
            {
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_startDate" Label="Ngày bắt đầu" Required="true" DisableToolbar="true" />
                </MudItem>

                @if (_durationType == 1)
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_endDate" Label="Ngày kết thúc" Required="true" DisableToolbar="true" />
                    </MudItem>
                }
            }
            else if (_durationType == 3)
            {
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_startDate" Label="Ngày" Required="true" DisableToolbar="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTimePicker @bind-Time="_startTime" Label="Giờ bắt đầu" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTimePicker @bind-Time="_endTime" Label="Giờ kết thúc" Required="true" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudTextField @bind-Value="_reason" Label="Lý do nghỉ phép" Lines="3" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_submitting">
                    @(_submitting ? "Đang gửi..." : (_editingId.HasValue ? "Cập nhật yêu cầu" : "Gửi yêu cầu"))
                </MudButton>
                @if (_editingId.HasValue)
                {
                    <MudButton OnClick="CancelEdit" Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2">
                        Hủy chỉnh sửa
                    </MudButton>
                }
            </MudItem>
        </MudGrid>
    </MudForm>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6" Class="mb-2">Lịch sử đăng ký của tôi</MudText>
    <MudButton OnClick="LoadMyRequests" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Class="mb-2">
        Tải lại
    </MudButton>

    <MudTable Items="@_myRequests" Dense="true" Hover="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh>Loại</MudTh>
            <MudTh>Thời gian</MudTh>
            <MudTh>Lý do</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh>Ghi chú duyệt</MudTh>
            <MudTh>Thao tác</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@LeaveService.GetDurationTypeName(context.DurationType) - @GetLeaveTypeName(context.LeaveType)</MudTd>
            <MudTd>
                @if (context.DurationType == 1)
                {
                    <span>@context.StartDate.ToString("dd/MM/yyyy") - @context.EndDate.ToString("dd/MM/yyyy") (@context.TotalDays ngày)</span>
                }
                else if (context.DurationType == 2)
                {
                    <span>@context.StartDate.ToString("dd/MM/yyyy") (0.5 ngày)</span>
                }
                else
                {
                    <span>@context.StartDate.ToString("dd/MM/yyyy") @context.StartTime?.ToString(@"hh\:mm") - @context.EndTime?.ToString(@"hh\:mm") (@context.TotalHours h)</span>
                }
            </MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@GetStatusColor(context.Status)">
                    @LeaveService.GetStatusName(context.Status)
                </MudChip>
            </MudTd>
            <MudTd>@context.ApproverComment</MudTd>
            <MudTd>
                @if (context.Status == 1)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => EditRequest(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteRequest(context.Id)" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private MudForm? _form;
    private int _leaveType = 1;
    private int _durationType = 1;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private TimeSpan? _startTime = new TimeSpan(8, 0, 0);
    private TimeSpan? _endTime = new TimeSpan(17, 0, 0);
    private string _reason = string.Empty;
    private bool _submitting = false;
    private bool _loading = false;
    private List<LeaveRequest> _myRequests = new();
    private Guid? _editingId = null; // ID của đơn đang chỉnh sửa

    protected override async Task OnInitializedAsync()
    {
        await LoadMyRequests();
    }

    private void OnLeaveTypeChanged(int newValue)
    {
        _leaveType = newValue;
        // Nếu chọn "Xin ra ngoài" (type 5) và đang là "Cả ngày", chuyển sang "Nửa ngày"
        if (newValue == 5 && _durationType == 1)
        {
            _durationType = 2;
        }
    }

    private void OnDurationTypeChanged(int newValue)
    {
        _durationType = newValue;
        if (newValue == 2) // Half day
        {
            _endDate = _startDate;
        }
    }

    private async Task LoadMyRequests()
    {
        try
        {
            _loading = true;
            var auth = AccountService.GetAuth().Result;
            var userName = auth.User.Identity!.Name!;
            var userId = await GlobalServices.GetIdfromUser(userName);
            if (userId.HasValue)
            {
                _myRequests = await LeaveService.GetMyRequestsAsync(userId.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Submit()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid) return;

        // Validate: "Xin ra ngoài" chỉ cho phép nửa ngày hoặc theo giờ
        if (_leaveType == 5 && _durationType == 1)
        {
            Snackbar.Add("Xin ra ngoài chỉ cho phép chọn 'Nửa ngày' hoặc 'Theo giờ'", MudBlazor.Severity.Error);
            return;
        }

        if (!_startDate.HasValue)
        {
            Snackbar.Add("Vui lòng chọn ngày bắt đầu", MudBlazor.Severity.Error);
            return;
        }

        if (_durationType == 1 && !_endDate.HasValue)
        {
            Snackbar.Add("Vui lòng chọn ngày kết thúc", MudBlazor.Severity.Error);
            return;
        }

        if (_durationType == 3 && (!_startTime.HasValue || !_endTime.HasValue))
        {
            Snackbar.Add("Vui lòng chọn giờ bắt đầu và kết thúc", MudBlazor.Severity.Error);
            return;
        }

        _submitting = true;

        var request = new LeaveRequest
        {
            LeaveType = _leaveType,
            DurationType = _durationType,
            StartDate = _startDate.Value,
            EndDate = _durationType == 1 ? _endDate!.Value : _startDate.Value,
            StartTime = _durationType == 3 ? _startTime : null,
            EndTime = _durationType == 3 ? _endTime : null,
            Reason = _reason
        };

        BoolandMessReponse result;
        
        if (_editingId.HasValue)
        {
            // Update existing request
            result = await LeaveService.UpdateLeaveRequestAsync(_editingId.Value, request);
        }
        else
        {
            // Create new request
            result = await LeaveService.SubmitLeaveRequestAsync(request);
        }
        
        _submitting = false;

        Snackbar.Add(result.Message, result.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        if (result.Flag)
        {
            // Reset form
            _editingId = null;
            _reason = string.Empty;
            _startDate = DateTime.Today;
            _endDate = DateTime.Today;
            _startTime = new TimeSpan(8, 0, 0);
            _endTime = new TimeSpan(17, 0, 0);
            _leaveType = 1;
            _durationType = 1;
            await LoadMyRequests();
        }
    }

    private void EditRequest(LeaveRequest request)
    {
        _editingId = request.Id;
        _leaveType = request.LeaveType;
        _durationType = request.DurationType;
        _startDate = request.StartDate;
        _endDate = request.EndDate;
        _startTime = request.StartTime;
        _endTime = request.EndTime;
        _reason = request.Reason;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _editingId = null;
        _reason = string.Empty;
        _startDate = DateTime.Today;
        _endDate = DateTime.Today;
        _startTime = new TimeSpan(8, 0, 0);
        _endTime = new TimeSpan(17, 0, 0);
        _leaveType = 1;
        _durationType = 1;
    }

    private async Task DeleteRequest(Guid id)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Xác nhận xóa",
            "Bạn có chắc chắn muốn xóa yêu cầu nghỉ phép này?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm == true)
        {
            var result = await LeaveService.DeleteLeaveRequestAsync(id);
            Snackbar.Add(result.Message, result.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (result.Flag)
            {
                await LoadMyRequests();
            }
        }
    }

    private string GetLeaveTypeName(int type)
    {
        return type switch
        {
            1 => "Nghỉ phép năm",
            2 => "Nghỉ ốm",
            3 => "Nghỉ việc riêng",
            4 => "Nghỉ không lương",
            5 => "Xin ra ngoài",
            _ => "Khác"
        };
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            1 => Color.Warning,
            2 => Color.Success,
            3 => Color.Error,
            _ => Color.Default
        };
    }
}
