@using MudBlazor

@using ABFreight.Components.Charge.Pages;


<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Xem trước dữ liệu import</MudText>

        <MudDataGrid T="ChargeIndex.ChargePreviewModel"
                     Items="@PreviewData"
                     ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)"
                     Dense="true"
                     Bordered="true"
                     Hover="true"
                     Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.CHARGE" Title="Charge (VN)" />
                <PropertyColumn Property="x => x.CHARGE_CODE" Title="Charge Code" />
                <PropertyColumn Property="x => x.DVT" Title="Charge (English)" />
                <PropertyColumn Property="x => x.Unit" Title="VAT" />
                <PropertyColumn Property="x => x.LoaiDichVu_Charge" Title="Loại Dịch Vụ" />
                <PropertyColumn Property="x => x.TiengTrung" Title="Service Group" />
                <PropertyColumn Property="x => x.AccSelling" Title="Acc Selling" />
                <PropertyColumn Property="x => x.AccBuying" Title="Acc Buying" />
                <PropertyColumn Property="x => x.TK1" Title="Mã D.V.HDDT" />
                <PropertyColumn Property="x => x.TK2" Title="TK C2" />
                <PropertyColumn Property="x => x.TK3" Title="Hạn Tạm Ứng" />
            </Columns>
        </MudDataGrid>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close(DialogResult.Ok(true))">OK</MudButton>
        <MudButton OnClick="() => MudDialog.Cancel()">Hủy</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public List<ChargeIndex.ChargePreviewModel> PreviewData { get; set; } = new();
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    private bool _resizeColumn;
}
