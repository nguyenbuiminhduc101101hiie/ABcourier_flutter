@using MudBlazor
@using ABFreight.Models

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_vesselName" Label="Tên tàu" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_voyageInfo" Label="Thông tin chuyến" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_dwt" Label="DWT" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_grt" Label="GRT" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_nrt" Label="NRT" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_loa" Label="LOA" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_ata" Label="ATA" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_atb" Label="ATB" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_atd" Label="ATD" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_estimateHours" Label="Estimate (giờ)" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_items" Label="Khoản mục PDA" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_basedOn" Label="Cơ sở tính" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_rate" Label="Đơn giá / công thức" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_turnTime" Label="Turn/Time" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_qty" Label="Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_amountUsd" Label="Amount USD" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_amountVnd" Label="Amount VND" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_invoice" Label="Hóa đơn" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_remarks" Label="Ghi chú" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public QuanLy_Tau? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    public sealed class QuanLyTauDialogResult
    {
        public Guid Id { get; init; }
        public string? VesselName { get; init; }
        public string? VoyageInfo { get; init; }
        public decimal? DWT { get; init; }
        public decimal? GRT { get; init; }
        public decimal? NRT { get; init; }
        public decimal? LOA { get; init; }
        public DateTime? ATA { get; init; }
        public DateTime? ATB { get; init; }
        public DateTime? ATD { get; init; }
        public decimal? EstimateHours { get; init; }
        public string? Items { get; init; }
        public string? BasedOn { get; init; }
        public string? Rate { get; init; }
        public string? TurnTime { get; init; }
        public decimal? Qty { get; init; }
        public decimal? AmountUSD { get; init; }
        public decimal? AmountVND { get; init; }
        public string? Remarks { get; init; }
        public string? Invoice { get; init; }
        public bool IsEdit { get; init; }
    }

    private MudForm? _form;
    private string? _vesselName;
    private string? _voyageInfo;
    private decimal? _dwt;
    private decimal? _grt;
    private decimal? _nrt;
    private decimal? _loa;
    private DateTime? _ata;
    private DateTime? _atb;
    private DateTime? _atd;
    private decimal? _estimateHours;
    private string? _items;
    private string? _basedOn;
    private string? _rate;
    private string? _turnTime;
    private decimal? _qty;
    private decimal? _amountUsd;
    private decimal? _amountVnd;
    private string? _remarks;
    private string? _invoice;

    protected override void OnParametersSet()
    {
        if (Model is null)
            return;

        _vesselName = Model.VesselName;
        _voyageInfo = Model.VoyageInfo;
        _dwt = Model.DWT;
        _grt = Model.GRT;
        _nrt = Model.NRT;
        _loa = Model.LOA;
        _ata = Model.ATA;
        _atb = Model.ATB;
        _atd = Model.ATD;
        _estimateHours = Model.EstimateHours;
        _items = Model.Items;
        _basedOn = Model.BasedOn;
        _rate = Model.Rate;
        _turnTime = Model.TurnTime;
        _qty = Model.Qty;
        _amountUsd = Model.AmountUSD;
        _amountVnd = Model.AmountVND;
        _remarks = Model.Remarks;
        _invoice = Model.Invoice;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(new QuanLyTauDialogResult
        {
            Id = Model?.Id ?? Guid.Empty,
            VesselName = TrimOrNull(_vesselName),
            VoyageInfo = TrimOrNull(_voyageInfo),
            DWT = _dwt,
            GRT = _grt,
            NRT = _nrt,
            LOA = _loa,
            ATA = _ata,
            ATB = _atb,
            ATD = _atd,
            EstimateHours = _estimateHours,
            Items = TrimOrNull(_items),
            BasedOn = TrimOrNull(_basedOn),
            Rate = TrimOrNull(_rate),
            TurnTime = TrimOrNull(_turnTime),
            Qty = _qty,
            AmountUSD = _amountUsd,
            AmountVND = _amountVnd,
            Remarks = TrimOrNull(_remarks),
            Invoice = TrimOrNull(_invoice),
            IsEdit = IsEdit
        }));
    }

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
