

@attribute [AllowAnonymous]
@page "/AccountPass"
@using ABFreight.Shared
@layout SimpleLayout
@inject NavigationManager NavigationManager
@inject IForgotPasswordEmailService  EmailService
@inject AccountService acsv

<PageTitle>Quên mật khẩu</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
</HeadContent>

<div class="d-flex flex-column justify-content-center align-items-center" style="height:100vh;">
    <div class="card shadow-sm" style="width: 400px;">
        <div class="card-body">
            <h3 class="text-center mb-4">🔒 Quên mật khẩu</h3>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-info" role="alert">@message</div>
            }

            @if (step == 1)
            {
                <div class="form-floating mb-3">
                    <input id="email" class="form-control" @bind="email" placeholder="example@gmail.com" />
                    <label for="email">📧 Nhập email của bạn</label>
                </div>
              <button class="btn btn-primary w-100"
                        @onclick="SendVerificationCode"
                        disabled="@_processingUpload_message">
                    @if (_processingUpload_message)
                    {
                        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
                        <span>Đang gửi...</span>
                    }
                    else
                    {
                        <span>Gửi mã xác nhận</span>
                    }
                </button>

            }
            else if (step == 2)
            {
                <div class="form-floating mb-3">
                    <input id="code" class="form-control" @bind="enteredCode" placeholder="Mã xác nhận" />
                    <label for="code">🔐 Nhập mã xác nhận đã gửi</label>
                </div>
                <button class="btn btn-success w-100" @onclick="VerifyCode">Xác nhận</button>
            }
            else if (step == 3)
            {
                <div class="form-floating mb-3">
                    <input id="newPass" type="password" class="form-control" @bind="newPassword" placeholder="Mật khẩu mới" />
                    <label for="newPass">🔑 Nhập mật khẩu mới</label>
                </div>

                <div class="form-floating mb-3">
                    <input id="newPasscfm" type="password" class="form-control" @bind="newPasswordCfm" placeholder="Nhập lại mật khẩu" />
                    <label for="newPasscfm">🔁 Nhập lại mật khẩu mới</label>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                <button class="btn btn-warning w-100" @onclick="ResetPassword">Đặt lại mật khẩu</button>
            }

            <div class="mt-3 text-center">
                <NavLink class="btn btn-link" href="/Account/login">Quay lại đăng nhập</NavLink>
            </div>
        </div>
    </div>
</div>

@code {
    private string email;
    private string enteredCode;
    private string generatedCode;
    private string newPassword;
    private string newPasswordCfm;
    private string message;
    private int step = 1;
    private string errorMessage;

    public bool _processingUpload_message = false;
    private async Task SendVerificationCode()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            message = "Vui lòng nhập email.";
            return;
        }
        _processingUpload_message = true;
       
        var user =  acsv.GetUserDetail_byemail(email);
        if (user == null)
        {
            message = "Email không tồn tại trong hệ thống.";
            return;
        }

        generatedCode = new Random().Next(100000, 999999).ToString();
  
        await EmailService.SendEmailAsync(email, "Mã xác nhận đặt lại mật khẩu", $"Mã xác nhận của bạn là: {generatedCode}");
        _processingUpload_message = false;
        message = "Mã xác nhận đã được gửi đến email của bạn.";
        step = 2;
    }

    private Task VerifyCode()
    {
        if (enteredCode == generatedCode)
        {
            step = 3;
            message = "Mã xác nhận đúng. Vui lòng nhập mật khẩu mới.";
        }
        else
        {
            message = "Mã xác nhận không đúng. Vui lòng thử lại.";
        }
        return Task.CompletedTask;
    }

   private async Task ResetPassword()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            message = "Vui lòng nhập mật khẩu mới.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newPasswordCfm))
        {
            message = "Vui lòng nhập lại mật khẩu mới.";
            return;
        }

        if (newPassword != newPasswordCfm)
        {
            message = "Mật khẩu xác nhận không khớp.";
            return;
        }

        // (Tùy chọn) Kiểm tra độ dài tối thiểu
        if (newPassword.Length < 6)
        {
            message = "Mật khẩu phải có ít nhất 6 ký tự.";
            return;
        }

        var user = acsv.GetUserDetail_byemail(email);
        if (user != null)
        {
            user.Pass_viettel = newPassword;
            var result = await acsv.UpdateUser(user);
            if (result.Flag)
            {
                message = "✅ Mật khẩu đã được đặt lại thành công.";
                email = enteredCode = newPassword = newPasswordCfm = string.Empty;
                step = 4; // bước tiếp theo (ví dụ: thông báo hoàn tất)
            }
            else
            {
                message = "❌ Không thể đặt lại mật khẩu. Vui lòng thử lại sau.";
            }
        }
        else
        {
            message = "Không tìm thấy người dùng tương ứng với email đã nhập.";
        }
    }

}