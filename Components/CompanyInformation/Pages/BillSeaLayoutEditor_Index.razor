@page "/BillSeaLayoutEditor"
@attribute [Authorize]
@using ABFreight.Models
@using ABFreight.Services
@inject GlobalServices gsv
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject BillSeaLayoutFormService FormService

<PageTitle>Chỉnh layout form</PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">Chỉnh layout Bill / AN / DO / Booking</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mx-4" />
}

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
            <MudButton Color="@(_documentGroup == LayoutDocumentGroup.Bill ? Color.Primary : Color.Default)"
                       Variant="@(_documentGroup == LayoutDocumentGroup.Bill ? Variant.Filled : Variant.Outlined)"
                       OnClick="() => OnDocumentGroupChanged(LayoutDocumentGroup.Bill)">
                Bill
            </MudButton>
            <MudButton Color="@(_documentGroup == LayoutDocumentGroup.An ? Color.Primary : Color.Default)"
                       Variant="@(_documentGroup == LayoutDocumentGroup.An ? Variant.Filled : Variant.Outlined)"
                       OnClick="() => OnDocumentGroupChanged(LayoutDocumentGroup.An)">
                AN
            </MudButton>
            <MudButton Color="@(_documentGroup == LayoutDocumentGroup.Do ? Color.Primary : Color.Default)"
                       Variant="@(_documentGroup == LayoutDocumentGroup.Do ? Variant.Filled : Variant.Outlined)"
                       OnClick="() => OnDocumentGroupChanged(LayoutDocumentGroup.Do)">
                DO
            </MudButton>
            <MudButton Color="@(_documentGroup == LayoutDocumentGroup.Booking ? Color.Primary : Color.Default)"
                       Variant="@(_documentGroup == LayoutDocumentGroup.Booking ? Variant.Filled : Variant.Outlined)"
                       OnClick="() => OnDocumentGroupChanged(LayoutDocumentGroup.Booking)">
                Booking
            </MudButton>
        </MudButtonGroup>

        @if (_documentGroup == LayoutDocumentGroup.Bill)
        {
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Color="@(_listFormKind == BillLayoutFormKind.Sea ? Color.Primary : Color.Default)"
                           Variant="@(_listFormKind == BillLayoutFormKind.Sea ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => OnListFormKindChanged(BillLayoutFormKind.Sea)">
                    Sea
                </MudButton>
                <MudButton Color="@(_listFormKind == BillLayoutFormKind.Air ? Color.Primary : Color.Default)"
                           Variant="@(_listFormKind == BillLayoutFormKind.Air ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => OnListFormKindChanged(BillLayoutFormKind.Air)">
                    Air
                </MudButton>
                <MudButton Color="@(_listFormKind == BillLayoutFormKind.Trang2 ? Color.Primary : Color.Default)"
                           Variant="@(_listFormKind == BillLayoutFormKind.Trang2 ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => OnListFormKindChanged(BillLayoutFormKind.Trang2)">
                    Trang 2
                </MudButton>
            </MudButtonGroup>
        }
        else if (_documentGroup == LayoutDocumentGroup.An)
        {
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Color="@(IsSeaSideSelected ? Color.Primary : Color.Default)"
                           Variant="@(IsSeaSideSelected ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => OnListFormKindChanged(BillLayoutFormKind.AnSea)">
                    Sea
                </MudButton>
                <MudButton Color="@(IsAirSideSelected ? Color.Primary : Color.Default)"
                           Variant="@(IsAirSideSelected ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => OnListFormKindChanged(BillLayoutFormKind.AnAir)">
                    Air
                </MudButton>
            </MudButtonGroup>
        }

        <MudSelect T="Guid?"
                   Label="@($"Chọn form {BillLayoutFormKindHelper.GetLongDisplayName(_listFormKind)}")"
                   Value="_selectedFormId"
                   ValueChanged="OnSelectedFormChanged"
                   ToStringFunc="FormIdToName"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:280px;"
                   Disabled="_loading || !_forms.Any()">
            @foreach (var form in _forms)
            {
                <MudSelectItem T="Guid?" Value="@form.BillSeaLayoutFormId">
                    @form.FormName@(form.IsCustomized ? " (đã chỉnh)" : "")
                </MudSelectItem>
            }
        </MudSelect>
        <MudButton OnClick="CreateNewForm"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="_loading">
            Tạo form mới
        </MudButton>
        <MudButton OnClick="DeleteSelectedForm"
                   Size="Size.Small"
                   Color="Color.Error"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="_loading || _selectedFormId is null">
            Xóa form
        </MudButton>
        <MudButton OnClick="ReloadForms"
                   Size="Size.Small"
                   Color="Color.Default"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_loading">
            Tải lại danh sách
        </MudButton>
        @if (_selectedForm is not null && BillLayoutFormKindHelper.SupportsAttach(_selectedForm.FormKind))
        {
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Color="@(!_editAttachMode ? Color.Primary : Color.Default)"
                           Variant="@(!_editAttachMode ? Variant.Filled : Variant.Outlined)"
                           OnClick="() => _editAttachMode = false">
                    Form chính
                </MudButton>
                <MudButton Color="@(_editAttachMode ? Color.Primary : Color.Default)"
                           Variant="@(_editAttachMode ? Variant.Filled : Variant.Outlined)"
                           Disabled="!_selectedForm.HasAttachForm"
                           OnClick="() => _editAttachMode = true">
                    Form Attach
                </MudButton>
            </MudButtonGroup>
            @if (!_selectedForm.HasAttachForm)
            {
                <MudButton OnClick="CreateAttachForm"
                           Size="Size.Small"
                           Color="Color.Secondary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           Disabled="_loading">
                    Tạo form Attach
                </MudButton>
            }
            else if (_editAttachMode)
            {
                <MudButton OnClick="DeleteAttachForm"
                           Size="Size.Small"
                           Color="Color.Error"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           Disabled="_loading">
                    Xóa form Attach
                </MudButton>
            }
        }
    </MudStack>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
        @switch (_documentGroup)
        {
            case LayoutDocumentGroup.An:
                <span><b>AN Sea</b> từ <b>BillArrivalNoticeNVOCC.mrt</b>. <b>AN Air</b> từ <b>BillArrivalNotice_Air.mrt</b>. Có thể chọn logo thay thế.</span>
                break;
            case LayoutDocumentGroup.Do:
                <span><b>DO</b> từ <b>BillDeliveryOrderNVOCC.mrt</b> (không tách Sea/Air). Có thể chọn logo thay thế.</span>
                break;
            case LayoutDocumentGroup.Booking:
                <span><b>Booking</b> từ <b>BookingRequestNVOCC.mrt</b> (không tách Sea/Air). <b>Image1</b> lấy logo từ <b>CompanyInfo.Logo</b>; connection string theo DB đang kết nối khi xuất.</span>
                break;
            default:
                <span><b>Bill Sea</b> từ <b>BillSea_NVOCC.mrt</b> (có thể tạo form Attach, thêm ảnh nền, bỏ line). <b>Bill Air</b> từ <b>BillAir.mrt</b> (ảnh nền Image1, bỏ line). <b>Trang 2</b> từ <b>BillTrang2.mrt</b> (chỉ ảnh full hoặc text full).</span>
                break;
        }
    </MudText>
</MudPaper>

@if (!_loading && _selectedFormId is Guid formId && _selectedForm is not null && (!_editAttachMode || _selectedForm.HasAttachForm))
{
    <BillSeaLayoutEditorPanel @key="@($"{formId}-{_editAttachMode}")"
                              TemplateId="formId"
                              TemplateName="@_selectedForm.FormName"
                              FormKind="_selectedForm.FormKind"
                              UserName="@_userName"
                              IsAttachMode="_editAttachMode" />
}
else if (_selectedForm is not null && _editAttachMode && !_selectedForm.HasAttachForm)
{
    <MudAlert Class="mx-4" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
        Form <b>@_selectedForm.FormName</b> chưa có form Attach. Bấm <b>Tạo form Attach</b> để tạo từ form chính hiện tại.
    </MudAlert>
}
else if (!_loading)
{
    <MudAlert Class="mx-4" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
        Chưa có form @BillLayoutFormKindHelper.GetLongDisplayName(_listFormKind). Bấm <b>Tạo form mới</b> để bắt đầu.
    </MudAlert>
}

@code {
    enum LayoutDocumentGroup { Bill, An, Do, Booking }

    M_CompanyInfo _company = new();
    string _userName = string.Empty;
    bool _loading;
    Guid? _selectedFormId;
    BillSeaLayoutFormSummary? _selectedForm;
    List<BillSeaLayoutFormSummary> _forms = new();
    bool _editAttachMode;
    BillLayoutFormKind _listFormKind = BillLayoutFormKind.Sea;
    LayoutDocumentGroup _documentGroup = LayoutDocumentGroup.Bill;

    bool IsSeaSideSelected =>
        _listFormKind is BillLayoutFormKind.Sea or BillLayoutFormKind.AnSea;

    bool IsAirSideSelected =>
        _listFormKind is BillLayoutFormKind.Air or BillLayoutFormKind.AnAir;

    protected override async Task OnInitializedAsync()
    {
        _userName = asv.GetAuth().Result.User.Identity!.Name!;
        await LoadPageAsync();
    }

    async Task LoadPageAsync()
    {
        try
        {
            _loading = true;

            if (!await ssv.CheckPermission(_userName, "View", "Companyinformation"))
            {
                ShowMessage("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }

            _company = await gsv.GetSingleCompany_info();
            await ReloadForms();
        }
        catch (Exception ex)
        {
            ShowMessage("Không tải được dữ liệu: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task ReloadForms()
    {
        _forms = await FormService.ListFormsAsync(_listFormKind);
        if (_selectedFormId is Guid currentId && _forms.Any(x => x.BillSeaLayoutFormId == currentId))
        {
            _selectedForm = _forms.First(x => x.BillSeaLayoutFormId == currentId);
            return;
        }

        _selectedFormId = _forms.FirstOrDefault()?.BillSeaLayoutFormId;
        _selectedForm = _forms.FirstOrDefault();
        _editAttachMode = false;
    }

    async Task OnDocumentGroupChanged(LayoutDocumentGroup group)
    {
        if (_documentGroup == group)
            return;

        _documentGroup = group;
        var kind = group switch
        {
            LayoutDocumentGroup.An => BillLayoutFormKind.AnSea,
            LayoutDocumentGroup.Do => BillLayoutFormKind.Do,
            LayoutDocumentGroup.Booking => BillLayoutFormKind.Booking,
            _ => BillLayoutFormKind.Sea
        };
        await OnListFormKindChanged(kind);
    }

    async Task OnListFormKindChanged(BillLayoutFormKind kind)
    {
        if (_listFormKind == kind)
            return;

        _listFormKind = kind;
        _documentGroup = kind switch
        {
            BillLayoutFormKind.AnSea or BillLayoutFormKind.AnAir => LayoutDocumentGroup.An,
            BillLayoutFormKind.Do => LayoutDocumentGroup.Do,
            BillLayoutFormKind.Booking => LayoutDocumentGroup.Booking,
            BillLayoutFormKind.Sea or BillLayoutFormKind.Air or BillLayoutFormKind.Trang2 => LayoutDocumentGroup.Bill,
            _ => LayoutDocumentGroup.Bill
        };
        _editAttachMode = false;
        _selectedFormId = null;
        _selectedForm = null;

        try
        {
            _loading = true;
            await ReloadForms();
        }
        catch (Exception ex)
        {
            ShowMessage("Không tải được danh sách form: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    Task OnSelectedFormChanged(Guid? formId)
    {
        _selectedFormId = formId;
        _selectedForm = formId is null
            ? null
            : _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == formId);
        _editAttachMode = false;
        return Task.CompletedTask;
    }

    string FormIdToName(Guid? id) =>
        id is null ? string.Empty : _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == id)?.FormName ?? string.Empty;

    List<BillLayoutFormKind> GetAllowedKindsForCreate() => _documentGroup switch
    {
        LayoutDocumentGroup.An => new List<BillLayoutFormKind> { BillLayoutFormKind.AnSea, BillLayoutFormKind.AnAir },
        LayoutDocumentGroup.Do => new List<BillLayoutFormKind> { BillLayoutFormKind.Do },
        LayoutDocumentGroup.Booking => new List<BillLayoutFormKind> { BillLayoutFormKind.Booking },
        _ => new List<BillLayoutFormKind> { BillLayoutFormKind.Sea, BillLayoutFormKind.Air, BillLayoutFormKind.Trang2 }
    };

    async Task CreateNewForm()
    {
        if (!await ssv.CheckPermission(_userName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Title"] = $"Tạo form {BillLayoutFormKindHelper.GetLongDisplayName(_listFormKind)} mới",
            ["DefaultFormKind"] = _listFormKind,
            ["AllowedKinds"] = GetAllowedKindsForCreate()
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<BillSeaLayoutFormNameDialog>("Tạo form mới", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not BillLayoutFormCreateRequest request)
            return;

        try
        {
            _loading = true;
            var created = await FormService.CreateFormAsync(request.FormName, request.FormKind, _userName);
            _listFormKind = request.FormKind;
            _documentGroup = request.FormKind switch
            {
                BillLayoutFormKind.AnSea or BillLayoutFormKind.AnAir => LayoutDocumentGroup.An,
                BillLayoutFormKind.Do => LayoutDocumentGroup.Do,
                BillLayoutFormKind.Booking => LayoutDocumentGroup.Booking,
                BillLayoutFormKind.Sea or BillLayoutFormKind.Air or BillLayoutFormKind.Trang2 => LayoutDocumentGroup.Bill,
                _ => LayoutDocumentGroup.Bill
            };
            await ReloadForms();
            _selectedFormId = created.BillSeaLayoutFormId;
            _selectedForm = _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == created.BillSeaLayoutFormId);
            ShowMessage($"Đã tạo form '{created.FormName}'.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task DeleteSelectedForm()
    {
        if (_selectedFormId is not Guid formId || _selectedForm is null)
            return;

        if (!await ssv.CheckPermission(_userName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            $"Xóa form {BillLayoutFormKindHelper.GetLongDisplayName(_selectedForm.FormKind)}",
            $"Bạn có chắc muốn xóa form '{_selectedForm.FormName}'?" + (_selectedForm.HasAttachForm ? "\n\nForm Attach đi kèm cũng sẽ bị xóa." : ""),
            yesText: "Xóa",
            cancelText: "Hủy");
        if (confirmed != true)
            return;

        try
        {
            _loading = true;
            await FormService.DeleteFormAsync(formId);
            _editAttachMode = false;
            await ReloadForms();
            ShowMessage("Đã xóa form.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task CreateAttachForm()
    {
        if (_selectedFormId is not Guid formId || _selectedForm is null)
            return;

        if (!await ssv.CheckPermission(_userName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _loading = true;
            await FormService.CreateAttachFormAsync(formId);
            await ReloadForms();
            _selectedForm = _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == formId);
            _editAttachMode = true;
            ShowMessage($"Đã tạo form Attach cho '{_selectedForm?.FormName}'.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task DeleteAttachForm()
    {
        if (_selectedFormId is not Guid formId || _selectedForm is null || !_selectedForm.HasAttachForm)
            return;

        if (!await ssv.CheckPermission(_userName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "Xóa form Attach",
            $"Bạn có chắc muốn xóa form Attach của '{_selectedForm.FormName}'?",
            yesText: "Xóa",
            cancelText: "Hủy");
        if (confirmed != true)
            return;

        try
        {
            _loading = true;
            await FormService.DeleteAttachFormAsync(formId);
            _editAttachMode = false;
            await ReloadForms();
            _selectedForm = _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == formId);
            ShowMessage("Đã xóa form Attach.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    void ShowMessage(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
