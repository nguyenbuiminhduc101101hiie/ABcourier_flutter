@using System.Globalization
@using System.Xml.Linq
@using Microsoft.AspNetCore.Components.Forms
@using ABFreight.Models
@using ABFreight.Services
@inject BillSeaLayoutFormService FormService
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .bsf-grid {
        display: grid;
        grid-template-rows: repeat(3, minmax(0, 1fr));
        grid-auto-flow: column;
        grid-auto-columns: 220px;
        gap: 8px;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 4px 4px 10px 4px;
        scrollbar-gutter: stable;
    }

    .bsf-grid::-webkit-scrollbar { height: 8px; }
    .bsf-grid::-webkit-scrollbar-thumb { background: #bdbdbd; border-radius: 4px; }

    .bsf-card {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 4px 6px;
        background: #fafafa;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 56px;
        transition: border-color .15s, box-shadow .15s;
    }

    .bsf-card:hover { border-color: #1976d2; box-shadow: 0 1px 4px rgba(25,118,210,0.15); }
    .bsf-card--used { background: #f1f8e9; border-color: #aed581; }
    .bsf-card--pending { background: #fff3e0; border-color: #fb8c00; box-shadow: 0 0 0 2px rgba(251,140,0,0.25); }

    .bsf-card-row {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }
    .bsf-card-row--meta { justify-content: space-between; }

    .bsf-card-name {
        font-weight: 600;
        font-size: 12.5px;
        color: #212121;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1 1 auto;
        min-width: 0;
    }

    .bsf-card-type {
        font-size: 10.5px;
        color: #1976d2;
        background: rgba(25,118,210,0.08);
        border-radius: 3px;
        padding: 1px 5px;
        flex: 0 0 auto;
        white-space: nowrap;
    }

    .bsf-badge {
        font-size: 10.5px;
        padding: 1px 6px;
        border-radius: 8px;
        white-space: nowrap;
    }
    .bsf-badge--used { background: #2e7d32; color: #fff; }
    .bsf-badge--missing { background: transparent; color: #757575; border: 1px solid #bdbdbd; }

    .bsf-card-actions { display: flex; gap: 2px; flex: 0 0 auto; }
    .bsf-card-actions .mud-icon-button { padding: 3px; }
    .bsf-card-actions .mud-icon-button .mud-icon-root { font-size: 16px; }
</style>

@if (IsTrang2Form)
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <b>Trang 2</b> — form <b>@TemplateName</b> (template <b>BillTrang2.mrt</b>)
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            Chỉ có 2 lựa chọn nội dung: ảnh full bill hoặc text full bill. Dùng khi Export Bill → chọn <b>Trang 2</b>.
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Loại nội dung</b></MudText>
        <MudRadioGroup T="bool" Value="_trang2ImageMode" ValueChanged="OnTrang2ModeChanged">
            <MudRadio T="bool" Value="true" Color="Color.Primary">Thêm hình full bill</MudRadio>
            <MudRadio T="bool" Value="false" Color="Color.Primary">Nhập text full bill</MudRadio>
        </MudRadioGroup>

        @if (_trang2ImageMode)
        {
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-4">
                @if (_formBillAirDataUrl is not null)
                {
                    <MudImage Src="@_formBillAirDataUrl" Alt="Trang 2" Style="max-height:280px; max-width:100%; border:1px solid #e0e0e0;" ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                    <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true">
                        Chưa có ảnh. Chọn ảnh để phủ toàn bộ trang A4.
                    </MudAlert>
                }
                <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif,.webp" FilesChanged="OnTrang2ImageFileChanged">
                    <ButtonTemplate Context="btnCtx">
                        <MudButton HtmlTag="label"
                                   for="@btnCtx"
                                   Size="Size.Small"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Image"
                                   Disabled="_loading || TemplateId == Guid.Empty">
                            Chọn ảnh full bill
                        </MudButton>
                    </ButtonTemplate>
                </MudFileUpload>
                @if (_hasCustomFormBillAir)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="ClearTrang2Image" Disabled="_loading">
                        Xóa ảnh
                    </MudButton>
                }
            </MudStack>
        }
        else
        {
            <MudTextField @bind-Value="_trang2PageText"
                          Label="Text full bill"
                          Variant="Variant.Outlined"
                          Lines="18"
                          Class="mt-4"
                          Immediate="true"
                          Placeholder="Nhập nội dung Trang 2 (điều khoản, ghi chú...)" />
            <MudButton Class="mt-3"
                       Size="Size.Small"
                       Color="Color.Success"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_loading || TemplateId == Guid.Empty"
                       OnClick="SaveTrang2Text">
                Lưu text Trang 2
            </MudButton>
        }
    </MudPaper>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mx-4" />
    }
}
else
{

<MudStack Row Spacing="2" Class="pa-4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    <MudButton OnClick="LoadLayout"
               Size="Size.Small"
               Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_loading">
        Tải form
    </MudButton>
    <MudButton OnClick="SaveLayout"
               Size="Size.Small"
               Color="Color.Success"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="_loading || !_pages.Any()">
        Lưu layout công ty
    </MudButton>
    <MudButton OnClick="ResetToDefaultTemplate"
               Size="Size.Small"
               Color="Color.Warning"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Restore"
               Disabled="_loading || (!IsAttachMode && !_usesCustomTemplate)">
        @(IsAttachMode ? "Tạo lại Attach" : "Khôi phục mặc định")
    </MudButton>
    <MudButton OnClick="UndoLastChange"
               Size="Size.Small"
               Color="Color.Default"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Undo"
               Disabled="_loading || _undoStack.Count == 0">
        Hoàn tác
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.HorizontalLine)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.HorizontalLine ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.HorizontalLine ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.HorizontalRule"
               Disabled="_loading || CurrentPage is null || _hideAllLines">
        Line ngang
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.VerticalLine)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.VerticalLine ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.VerticalLine ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.MoreVert"
               Disabled="_loading || CurrentPage is null || _hideAllLines">
        Line dọc
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.StaticText)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.StaticText ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.StaticText ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.TextFields"
               Disabled="_loading || CurrentPage is null">
        Label text
    </MudButton>
    <MudButton OnClick="ToggleFieldBrowser"
               Size="Size.Small"
               Color="@(_showFieldBrowser ? Color.Primary : Color.Default)"
               Variant="@(_showFieldBrowser ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.TableView"
               Disabled="_loading || _dataSources.Count == 0">
        @(_showFieldBrowser ? "Ẩn trường DL" : "Trường dữ liệu")
    </MudButton>
    <MudButton OnClick="DeleteSelected"
               Size="Size.Small"
               Color="Color.Error"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Delete"
               Disabled="_loading || !HasDeletableSelection()">
        Xóa đã chọn
    </MudButton>
    <MudButton OnClick="ToggleCanvasImages"
               Size="Size.Small"
               Color="@(_showCanvasImages ? Color.Primary : Color.Default)"
               Variant="@(_showCanvasImages ? Variant.Filled : Variant.Outlined)"
               StartIcon="@(_showCanvasImages ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
               Disabled="_loading || CurrentPage is null">
        @(_showCanvasImages ? "Ẩn ảnh" : "Hiện ảnh")
    </MudButton>
    <MudButton OnClick="ToggleBands"
               Size="Size.Small"
               Color="@(_showBands ? Color.Primary : Color.Default)"
               Variant="@(_showBands ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.ViewDay"
               Disabled="_loading || CurrentPage is null">
        @(_showBands ? "Ẩn band" : "Hiện band")
    </MudButton>
    @if (_pages.Count > 1)
    {
        <MudSelect T="string"
                   Label="Chọn page"
                   @bind-Value="_selectedPageName"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:220px;">
            @foreach (var pageLayout in _pages)
            {
                <MudSelectItem Value="@pageLayout.PageName">@pageLayout.PageName (@pageLayout.Elements.Count phần tử)</MudSelectItem>
            }
        </MudSelect>
    }
    <MudTextField @bind-Value="_keyword"
                  Label="Lọc tên"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="min-width:240px;" />
</MudStack>

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.subtitle2"><b>@GetLogoSectionTitle()</b></MudText>
        @if (_logoDataUrl is not null)
        {
            <MudImage Src="@_logoDataUrl" Alt="Logo form" Style="max-height:72px; max-width:180px;" ObjectFit="ObjectFit.Contain" />
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Chưa có logo</MudText>
        }
        <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif,.webp" FilesChanged="OnFormLogoFileChanged">
            <ButtonTemplate Context="btnCtx">
                <MudButton HtmlTag="label"
                           for="@btnCtx"
                           Size="Size.Small"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Image"
                           Disabled="_loading || TemplateId == Guid.Empty">
                    Chọn logo
                </MudButton>
            </ButtonTemplate>
        </MudFileUpload>
        @if (_hasCustomFormLogo)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="ClearFormLogo" Disabled="_loading">
                Xóa logo form
            </MudButton>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @if (_hasCustomFormLogo)
            {
                <span>Đang dùng <b>logo riêng</b> của form <b>@TemplateName</b>.</span>
            }
            else
            {
                <span>Chưa chọn logo riêng — preview/export dùng <b>logo công ty</b>.</span>
            }
        </MudText>
    </MudStack>
</MudPaper>

@if (BillLayoutFormKindHelper.SupportsFormBackground(FormKind))
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Spacing="2">
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.subtitle2"><b>@GetFormBackgroundSectionTitle()</b></MudText>
                @if (_formBillAirDataUrl is not null && (_hasCustomFormBillAir || BillLayoutFormKindHelper.SupportsFormBillAir(FormKind)))
                {
                    <MudImage Src="@_formBillAirDataUrl" Alt="Nền form Bill" Style="max-height:72px; max-width:180px;" ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Chưa có ảnh nền</MudText>
                }
                <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif,.webp" FilesChanged="OnFormBillAirFileChanged">
                    <ButtonTemplate Context="btnCtx">
                        <MudButton HtmlTag="label"
                                   for="@btnCtx"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Wallpaper"
                                   Disabled="_loading || TemplateId == Guid.Empty">
                            Chọn ảnh nền
                        </MudButton>
                    </ButtonTemplate>
                </MudFileUpload>
                @if (_hasCustomFormBillAir)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="ClearFormBillAir" Disabled="_loading">
                        Xóa ảnh nền
                    </MudButton>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @if (_hasCustomFormBillAir)
                    {
                        <span>Đang dùng <b>ảnh nền riêng</b> của form <b>@TemplateName</b>.</span>
                    }
                    else if (BillLayoutFormKindHelper.SupportsFormBillAir(FormKind))
                    {
                        <span>Chưa chọn riêng — preview/export dùng <b>Image1</b> mặc định từ <b>BillAir.mrt</b>.</span>
                    }
                    else
                    {
                        <span>Chưa chọn ảnh nền — export Sea dùng nền công ty (nguồn <b>FormBillSea</b>) nếu có.</span>
                    }
                </MudText>
            </MudStack>
            <MudCheckBox T="bool"
                         Value="_hideAllLines"
                         ValueChanged="OnHideAllLinesChanged"
                         Label="Bỏ toàn bộ line trong form (dùng khi đã có ảnh nền)"
                         Color="Color.Primary"
                         Dense="true"
                         Disabled="_loading || TemplateId == Guid.Empty" />
            @if (_hideAllLines)
            {
                <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Tất cả line ngang/dọc đã tắt trên form. Bỏ chọn để hiện lại line khi cần chỉnh tay.
                </MudAlert>
            }
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mx-4" />
}

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        @if (IsAttachMode)
        {
            <span>Form <b>Attach</b> của <b>@TemplateName</b> (Sea) — 2 page.</span>
        }
        else
        {
            <span>Layout form <b>@BillLayoutFormKindHelper.GetLongDisplayName(FormKind)</b> <b>@TemplateName</b> từ template <b>@GetSourceTemplateName()</b>.</span>
        }
        @if (_usesCustomTemplate) { <span> Đang dùng <b>bản đã chỉnh</b>.</span> }
        else if (!IsAttachMode) { <span> Đang dùng <b>nội dung gốc</b>.</span> }
        else { <span> Đang dùng <b>bản Attach mặc định</b>.</span> }
        Bấm Line ngang / Line dọc / Label text rồi click lên canvas để đặt. Giữ Ctrl + click để chọn nhiều phần tử.
        Bấm <b>Trường dữ liệu</b> để mở danh sách toàn bộ cột của các table đã link (HBL, MBL, Container, Customer, Job, CompanyInfomation) — bạn có thể <b>thêm cột chưa có</b> hoặc <b>ẩn cột không cần</b> ngay trên bill.
        Bấm <b>Hiện ảnh</b> để xem logo/nền form khi căn chỉnh; <b>Ẩn ảnh</b> để di chuyển các phần tử dễ hơn.
        Bấm <b>Hiện band</b> để xem các dải band (PageHeader / ReportTitle / Data / ReportSummary...) — chọn 1 band rồi kéo cạnh dưới hoặc nhập số để đổi <b>chiều cao band</b>.
    </MudText>
</MudPaper>

@if (_pendingPlacementKind is not null)
{
    <MudAlert Class="mx-4 mb-4" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true">
        Đang chọn vị trí cho <b>@GetPlacementLabel()</b> — click lên form để đặt. Bấm lại nút trên hoặc phím Esc để hủy.
    </MudAlert>
}

@if (_selectedNames.Count == 1 && _selectedElement is { Kind: BillSeaElementKind.HorizontalLine or BillSeaElementKind.VerticalLine })
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudNumericField T="double"
                             Value="_selectedElement.LineSize"
                             ValueChanged="OnSelectedLineSizeChanged"
                             Label="Độ dày line"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="20"
                             Step="1"
                             Style="max-width:160px;" />
            <MudSlider T="double"
                       Value="_selectedElement.LineSize"
                       ValueChanged="OnSelectedLineSizeChanged"
                       Min="1"
                       Max="20"
                       Step="1"
                       Style="min-width:220px;max-width:360px;" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_selectedElement.LineSize.ToString("0.##", CultureInfo.InvariantCulture) pt
            </MudText>
        </MudStack>
    </MudPaper>
}

@if (_selectedNames.Count == 1 && _selectedElement is { Kind: BillSeaElementKind.Band })
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.subtitle2" Style="color:#6a1b9a;font-weight:700;">
                Band: @GetBandLabel(_selectedElement)
            </MudText>
            <MudNumericField T="double"
                             Value="_selectedElement.Height"
                             ValueChanged="OnSelectedBandHeightChanged"
                             Label="Chiều cao band (inch)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="@MinBoxSizeInches"
                             Max="@PageHeightInches"
                             Step="0.05"
                             Format="0.##"
                             Style="max-width:200px;" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Kéo cạnh dưới band trên canvas hoặc nhập số để đổi chiều cao (tối đa ~3.5 inch).
            </MudText>
        </MudStack>
    </MudPaper>
}

@if (HasSelectedTextElements())
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Spacing="3">
            @if (_selectedNames.Count == 1 && _selectedElement?.Kind == BillSeaElementKind.StaticText)
            {
                <MudTextField Value="_selectedElement.Text"
                              ValueChanged="@((string value) => OnSelectedTextChanged(value))"
                              Label="Nội dung label đang chọn"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Lines="6"
                              Style="white-space:pre-wrap;"
                              HelperText="Enter để xuống dòng. Xuống dòng sẽ hiện trên bill (WordWrap)." />
            }
            else if (GetSelectedTextElements().Count > 1)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Cỡ chữ cho @GetSelectedTextElements().Count phần tử text đang chọn
                </MudText>
            }

            <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudNumericField T="double"
                                 Value="GetFontSizeEditorValue()"
                                 ValueChanged="OnSelectedFontSizeChanged"
                                 Label="Cỡ chữ"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="4"
                                 Max="72"
                                 Step="1"
                                 Style="max-width:160px;" />
                <MudSlider T="double"
                           Value="GetFontSizeEditorValue()"
                           ValueChanged="OnSelectedFontSizeChanged"
                           Min="4"
                           Max="72"
                           Step="1"
                           Style="min-width:220px;max-width:360px;" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @GetFontSizeEditorValue().ToString("0.##", CultureInfo.InvariantCulture) pt
                </MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_showFieldBrowser && _dataSources.Any())
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Spacing="2">
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudIcon Icon="@Icons.Material.Filled.TableView" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle2"><b>Trường dữ liệu sẵn có (@_dataSources.Sum(x => x.Columns.Count) cột)</b></MudText>
                <MudTextField @bind-Value="_fieldKeyword"
                              Label="Lọc cột"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Style="min-width:240px;" />
                <MudSwitch T="bool"
                           Value="_showOnlyMissing"
                           ValueChanged="@((bool v) => _showOnlyMissing = v)"
                           Label="Chỉ hiện cột chưa có trên bill"
                           Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Cuộn ngang để xem thêm cột. Click <b>+</b> để đặt cột lên bill; <b>🎯</b> highlight phần tử đang dùng; <b>🚫</b> ẩn (xóa) phần tử có Text khớp đúng cột.
                </MudText>
            </MudStack>
            <MudExpansionPanels MultiExpansion="true" Dense="true">
                @foreach (var source in _dataSources)
                {
                    var visibleColumns = GetFilteredColumns(source);
                    if (visibleColumns.Count == 0)
                    {
                        continue;
                    }
                    var totalUsage = source.Columns.Sum(c => CountFieldUsage(source.Name, c.Name));

                    <MudExpansionPanel IsInitiallyExpanded="@(_dataSources.Count <= 2 || totalUsage > 0)" Dense="true">
                        <TitleContent>
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
                                <MudText Typo="Typo.body2"><b>@source.Name</b></MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@visibleColumns.Count cột</MudChip>
                                @if (totalUsage > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success">@totalUsage đang dùng</MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <div class="bsf-grid">
                                @foreach (var column in visibleColumns)
                                {
                                    var usage = CountFieldUsage(source.Name, column.Name);
                                    var pendingExpression = BuildFieldExpression(source.Name, column.Name);
                                    var isPending = _pendingPlacementKind == BillSeaElementKind.DataText
                                        && string.Equals(_pendingDataExpression, pendingExpression, StringComparison.Ordinal);
                                    var cardClass = "bsf-card" + (usage > 0 ? " bsf-card--used" : "") + (isPending ? " bsf-card--pending" : "");

                                    <div class="@cardClass" title="@source.Name.@column.Name">
                                        <div class="bsf-card-row">
                                            <span class="bsf-card-name">@column.Name</span>
                                            <span class="bsf-card-type">@column.FriendlyType</span>
                                        </div>
                                        <div class="bsf-card-row bsf-card-row--meta">
                                            @if (usage > 0)
                                            {
                                                <span class="bsf-badge bsf-badge--used">Đang dùng @usage</span>
                                            }
                                            else
                                            {
                                                <span class="bsf-badge bsf-badge--missing">Chưa có</span>
                                            }
                                            <div class="bsf-card-actions">
                                                <MudTooltip Text="@(isPending ? "Bấm lại hoặc Esc để hủy" : "Click để chọn vị trí và đặt cột này trên bill")">
                                                    <MudIconButton Icon="@(isPending ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)"
                                                                   Color="@(isPending ? Color.Warning : Color.Primary)"
                                                                   Variant="Variant.Filled"
                                                                   Size="Size.Small"
                                                                   OnClick="() => BeginAddDataField(source.Name, column.Name)"
                                                                   Disabled="_loading || CurrentPage is null" />
                                                </MudTooltip>
                                                @if (usage > 0)
                                                {
                                                    <MudTooltip Text="Chọn các phần tử đang dùng cột này trên canvas">
                                                        <MudIconButton Icon="@Icons.Material.Filled.MyLocation"
                                                                       Color="Color.Info"
                                                                       Variant="Variant.Outlined"
                                                                       Size="Size.Small"
                                                                       OnClick="() => HighlightFieldUsage(source.Name, column.Name)"
                                                                       Disabled="_loading" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Ẩn các phần tử có Text khớp đúng cột này">
                                                        <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff"
                                                                       Color="Color.Error"
                                                                       Variant="Variant.Outlined"
                                                                       Size="Size.Small"
                                                                       OnClick="() => HideFieldElements(source.Name, column.Name)"
                                                                       Disabled="_loading" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudStack>
    </MudPaper>
}

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    @if (CurrentPage is null)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
            Bấm "Tải form" để bắt đầu thiết kế.
        </MudAlert>
    }
    else
    {
        <div style="@GetCanvasStyle()" tabindex="0" @onkeydown="OnCanvasKeyDown">
            @if (CurrentPage.MarginLeft > 0 || CurrentPage.MarginTop > 0 || CurrentPage.MarginRight > 0 || CurrentPage.MarginBottom > 0)
            {
                <div style="@GetPageMarginGuideStyle()" title="Vùng lề trang (Margins)"></div>
            }

            @if (_selectedNames.Count > 1)
            {
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="position:absolute;top:4px;right:8px;z-index:120;">
                    Đã chọn @_selectedNames.Count phần tử
                </MudText>
            }

            @if (_showCanvasImages)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="position:absolute;top:4px;left:8px;z-index:120;">
                    Đang hiện ảnh nền/logo để so sánh
                </MudText>
            }

            <div style="@GetElementsLayerStyle()">
            @if (_showCanvasImages)
            {
                var backgroundImage = GetFormBackgroundImage();
                if (backgroundImage is not null && GetImagePreviewUrl(backgroundImage) is { } backgroundUrl)
                {
                    <div style="@GetBackgroundImageLayerStyle(backgroundImage)">
                        <img src="@backgroundUrl" alt="Form Bill" style="width:100%;height:100%;object-fit:fill;pointer-events:none;user-select:none;" />
                    </div>
                }
                else if (BillLayoutFormKindHelper.SupportsFormBackground(FormKind)
                         && _hasCustomFormBillAir
                         && _formBillAirDataUrl is not null)
                {
                    <div style="@GetFullPageBackgroundStyle()">
                        <img src="@_formBillAirDataUrl" alt="Nền form Bill" style="width:100%;height:100%;object-fit:fill;pointer-events:none;user-select:none;" />
                    </div>
                }
            }

            @foreach (var item in SortedElements)
            {
                @if (IsFormBackgroundImage(item))
                {
                    continue;
                }

                @if (item.Kind == BillSeaElementKind.Band)
                {
                    @if (_showBands)
                    {
                        <div style="@GetBandStyle(item)"
                             @onmousedown="(e => OnElementMouseDown(item, e))"
                             @onmousedown:preventDefault="true">
                            <span style="@GetBandLabelStyle(item)">@GetBandLabel(item)</span>

                            @if (IsSelected(item) && _selectedNames.Count == 1)
                            {
                                <div style="@GetBandResizeHandleStyle()"
                                     @onmousedown="(e => BeginBoxResize(item, BoxResizeHandle.South, e))"
                                     @onmousedown:preventDefault="true"
                                     @onmousedown:stopPropagation="true"></div>
                            }
                        </div>
                    }
                }
                else if (item.Kind is BillSeaElementKind.HorizontalLine or BillSeaElementKind.VerticalLine)
                {
                    @if (_hideAllLines)
                    {
                        continue;
                    }
                    <div style="@GetLineContainerStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        <div style="@GetLineVisualStyle(item)"></div>

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            <div style="@GetLineHandleStyle(item, isStart: true)"
                                 @onmousedown="(e => BeginLineResize(item, isStart: true, e))"
                                 @onmousedown:preventDefault="true"
                                 @onmousedown:stopPropagation="true"></div>
                            <div style="@GetLineHandleStyle(item, isStart: false)"
                                 @onmousedown="(e => BeginLineResize(item, isStart: false, e))"
                                 @onmousedown:preventDefault="true"
                                 @onmousedown:stopPropagation="true"></div>
                        }
                    </div>
                }
                else if (item.Kind == BillSeaElementKind.Image)
                {
                    var previewUrl = _showCanvasImages ? GetImagePreviewUrl(item) : null;
                    <div style="@GetImageBoxStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        @if (previewUrl is not null)
                        {
                            <img src="@previewUrl" alt="@item.Name" style="width:100%;height:100%;object-fit:contain;pointer-events:none;" />
                        }
                        else
                        {
                            <span style="@GetImageLabelStyle(item)">@(string.IsNullOrWhiteSpace(item.Text) ? item.Name : item.Text)</span>
                        }

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            @foreach (var handle in BoxResizeHandles)
                            {
                                <div style="@GetBoxHandleStyle(handle)"
                                     @onmousedown="(e => BeginBoxResize(item, handle, e))"
                                     @onmousedown:preventDefault="true"
                                     @onmousedown:stopPropagation="true"></div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div style="@GetBoxStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        <span style="@GetTextPreviewStyle(item)">
                            @(string.IsNullOrWhiteSpace(item.Text) ? item.Name : item.Text)
                        </span>

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            @foreach (var handle in BoxResizeHandles)
                            {
                                <div style="@GetBoxHandleStyle(handle)"
                                     @onmousedown="(e => BeginBoxResize(item, handle, e))"
                                     @onmousedown:preventDefault="true"
                                     @onmousedown:stopPropagation="true"></div>
                            }
                        }
                    </div>
                }
            }
            </div>

            @if (_pendingPlacementKind is not null && _placementPreviewVisible)
            {
                <div style="@GetPlacementPreviewStyle()"></div>
            }

            @if (_pendingPlacementKind is not null)
            {
                <div style="@GetPlacementOverlayStyle()"
                     @onmousemove="OnPlacementMouseMove"
                     @onmouseleave="OnPlacementMouseLeave"
                     @onmousedown="OnPlacementClick"
                     @onmousedown:preventDefault="true"
                     @onmousedown:stopPropagation="true"></div>
            }

            @if (_activeItem is not null)
            {
                <div style="position:absolute;inset:0;z-index:10000;cursor:@GetOverlayCursor();background:transparent;touch-action:none;"
                     @onmousemove="OnCanvasMouseMove"
                     @onmousemove:preventDefault="true"
                     @onmouseup="EndInteraction"
                     @onmouseleave="EndInteraction"></div>
            }
        </div>
    }
</MudPaper>

}

@code {
    [Parameter] public Guid TemplateId { get; set; }
    [Parameter] public string TemplateName { get; set; } = string.Empty;
    [Parameter] public BillLayoutFormKind FormKind { get; set; } = BillLayoutFormKind.Sea;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public bool IsAttachMode { get; set; }

    bool IsTrang2Form => BillLayoutFormKindHelper.SupportsTrang2Content(FormKind);

    const double PreviewWidthPx = 900;
    const long MaxLogoBytes = 2 * 1024 * 1024;
    const long MaxFormBillAirBytes = 5 * 1024 * 1024;
    bool _trang2ImageMode = true;
    string _trang2PageText = string.Empty;
    string? _logoDataUrl;
    string? _formBillAirDataUrl;
    byte[]? _companyLogoBytes;
    byte[]? _defaultBillAirImage1Bytes;
    bool _hasCustomFormLogo;
    bool _hasCustomFormBillAir;
    bool _hideAllLines;
    bool _showCanvasImages;
    bool _showBands = true;
    bool _usesCustomTemplate;
    bool _loading;
    string _keyword = string.Empty;
    string _selectedPageName = string.Empty;
    List<BillSeaPageLayout> _pages = new();
    BillSeaDesignElement? _activeItem;
    BillSeaDesignElement? _selectedElement;
    ElementInteraction _interaction = ElementInteraction.None;
    double _dragPointerStartClientX;
    double _dragPointerStartClientY;
    double _dragAnchorStartLeft;
    double _dragAnchorStartTop;
    int _designCounter;
    BillSeaElementKind? _pendingPlacementKind;
    string? _pendingDataExpression;
    bool _showFieldBrowser;
    bool _showOnlyMissing;
    string _fieldKeyword = string.Empty;
    List<BillSeaDataSource> _dataSources = new();
    bool _placementPreviewVisible;
    double _placementPreviewLeft;
    double _placementPreviewTop;
    bool _interactionUndoPushed;
    string? _propertyEditUndoElementName;
    readonly Stack<List<BillSeaPageLayout>> _undoStack = new();
    readonly HashSet<string> _sessionAddedNames = new(StringComparer.OrdinalIgnoreCase);
    readonly HashSet<string> _selectedNames = new(StringComparer.OrdinalIgnoreCase);
    readonly Dictionary<string, (double Left, double Top)> _dragGroupStarts = new(StringComparer.OrdinalIgnoreCase);

    const int MaxUndoSteps = 50;

    static readonly BoxResizeHandle[] BoxResizeHandles =
    {
        BoxResizeHandle.NorthWest,
        BoxResizeHandle.North,
        BoxResizeHandle.NorthEast,
        BoxResizeHandle.West,
        BoxResizeHandle.East,
        BoxResizeHandle.SouthWest,
        BoxResizeHandle.South,
        BoxResizeHandle.SouthEast
    };

    enum ElementInteraction
    {
        None,
        Move,
        LineResizeStart,
        LineResizeEnd,
        BoxResizeNorthWest,
        BoxResizeNorth,
        BoxResizeNorthEast,
        BoxResizeWest,
        BoxResizeEast,
        BoxResizeSouthWest,
        BoxResizeSouth,
        BoxResizeSouthEast
    }

    enum BoxResizeHandle
    {
        NorthWest,
        North,
        NorthEast,
        West,
        East,
        SouthWest,
        South,
        SouthEast
    }

    const double MinBoxSizeInches = 0.15;

    BillSeaPageLayout? CurrentPage =>
        _pages.FirstOrDefault(p => string.Equals(p.PageName, _selectedPageName, StringComparison.OrdinalIgnoreCase))
        ?? _pages.FirstOrDefault();

    double PageWidthInches => CurrentPage?.PageWidthInches ?? 8.27;
    double PageHeightInches => CurrentPage?.PageHeightInches ?? 11.69;
    double Scale => PreviewWidthPx / PageWidthInches;
    double PreviewHeightPx => PageHeightInches * Scale;

    IEnumerable<BillSeaDesignElement> FilteredElements
    {
        get
        {
            var items = CurrentPage?.Elements ?? Enumerable.Empty<BillSeaDesignElement>();
            return string.IsNullOrWhiteSpace(_keyword)
                ? items
                : items.Where(x => x.Name.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                    || x.Text.Contains(_keyword, StringComparison.OrdinalIgnoreCase));
        }
    }

    IEnumerable<BillSeaDesignElement> SortedElements =>
        FilteredElements.OrderBy(GetElementZIndex);

    string GetSourceTemplateName() =>
        BillLayoutFormKindHelper.GetDefaultTemplateFile(FormKind);

    string GetLogoSectionTitle() => FormKind switch
    {
        BillLayoutFormKind.Air => "Logo (CompanyLogo)",
        BillLayoutFormKind.AnAir => "Logo (Image1)",
        BillLayoutFormKind.AnSea or BillLayoutFormKind.Do => "Logo (CompanyLogo)",
        BillLayoutFormKind.Booking => "Logo (Image1 ← CompanyInfo.Logo)",
        _ => "Logo form"
    };

    string GetFormBackgroundSectionTitle() => FormKind switch
    {
        BillLayoutFormKind.Air => "Ảnh nền form Bill Air (Image1)",
        BillLayoutFormKind.Sea => "Ảnh nền form Bill Sea (background)",
        _ => "Ảnh nền form Bill"
    };

    Guid _lastAssetsTemplateId = Guid.Empty;
    readonly SemaphoreSlim _assetsLock = new(1, 1);

    protected override async Task OnParametersSetAsync()
    {
        if (TemplateId == Guid.Empty || TemplateId == _lastAssetsTemplateId)
            return;

        _lastAssetsTemplateId = TemplateId;
        if (IsTrang2Form)
            await LoadTrang2ContentAsync();
        else
            await LoadFormAssetsAsync();
    }

    async Task LoadTrang2ContentAsync()
    {
        if (TemplateId == Guid.Empty)
            return;

        try
        {
            _loading = true;
            var content = await FormService.GetTrang2ContentAsync(TemplateId);
            _trang2ImageMode = content.ImageMode;
            _trang2PageText = content.PageText;
            _hasCustomFormBillAir = content.HasImage;
            var imageBytes = content.HasImage
                ? await FormService.GetFormBillAirAsync(TemplateId)
                : null;
            _formBillAirDataUrl = BuildLogoDataUrl(imageBytes);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không tải được nội dung Trang 2: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task OnTrang2ModeChanged(bool imageMode)
    {
        if (_trang2ImageMode == imageMode)
            return;

        if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _loading = true;
            _trang2ImageMode = imageMode;
            await FormService.SaveTrang2ContentAsync(TemplateId, imageMode, _trang2PageText);
            if (imageMode)
            {
                _hasCustomFormBillAir = await FormService.HasCustomFormBillAirAsync(TemplateId);
                _formBillAirDataUrl = BuildLogoDataUrl(
                    _hasCustomFormBillAir ? await FormService.GetFormBillAirAsync(TemplateId) : null);
            }
            else
            {
                _hasCustomFormBillAir = false;
                _formBillAirDataUrl = null;
            }

            ShowMessage(imageMode ? "Đã chuyển sang chế độ hình full bill." : "Đã chuyển sang chế độ text full bill.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không đổi được chế độ Trang 2: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task OnTrang2ImageFileChanged(IBrowserFile? file)
    {
        if (file is null || TemplateId == Guid.Empty || !IsTrang2Form)
            return;

        if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            if (file.Size > MaxFormBillAirBytes)
            {
                ShowMessage("Ảnh Trang 2 tối đa 5MB.", MudBlazor.Severity.Warning);
                return;
            }

            _loading = true;
            await using var stream = file.OpenReadStream(MaxFormBillAirBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var imageBytes = ms.ToArray();
            await FormService.SaveFormBillAirAsync(TemplateId, imageBytes);
            await FormService.SaveTrang2ContentAsync(TemplateId, imageMode: true, _trang2PageText);
            _trang2ImageMode = true;
            _hasCustomFormBillAir = true;
            _formBillAirDataUrl = BuildLogoDataUrl(imageBytes);
            ShowMessage($"Đã lưu ảnh full bill cho form '{TemplateName}'.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không lưu được ảnh Trang 2: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task ClearTrang2Image()
    {
        if (TemplateId == Guid.Empty || !IsTrang2Form)
            return;

        if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _loading = true;
            await FormService.ClearFormBillAirAsync(TemplateId);
            _hasCustomFormBillAir = false;
            _formBillAirDataUrl = null;
            ShowMessage("Đã xóa ảnh Trang 2.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không xóa được ảnh: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SaveTrang2Text()
    {
        if (TemplateId == Guid.Empty || !IsTrang2Form)
            return;

        if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _loading = true;
            _trang2ImageMode = false;
            await FormService.SaveTrang2ContentAsync(TemplateId, imageMode: false, _trang2PageText, clearImageWhenText: true);
            _hasCustomFormBillAir = false;
            _formBillAirDataUrl = null;
            ShowMessage($"Đã lưu text full bill cho form '{TemplateName}'.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không lưu được text Trang 2: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    void ToggleCanvasImages() => _showCanvasImages = !_showCanvasImages;

    void ToggleBands() => _showBands = !_showBands;

    // Chỉ Bill Air dùng Image1 làm nền form. AN Air dùng Image1 làm logo — phải hiện ô để kéo/chọn.
    bool IsFormBackgroundImage(BillSeaDesignElement item) =>
        BillLayoutFormKindHelper.SupportsFormBillAir(FormKind)
        && item.Kind == BillSeaElementKind.Image
        && string.Equals(item.Name, "Image1", StringComparison.OrdinalIgnoreCase);

    BillSeaDesignElement? GetFormBackgroundImage() =>
        CurrentPage?.Elements.FirstOrDefault(IsFormBackgroundImage);

    string? GetImagePreviewUrl(BillSeaDesignElement item)
    {
        if (string.Equals(item.Name, "Image1", StringComparison.OrdinalIgnoreCase))
        {
            return BillLayoutFormKindHelper.SupportsFormBillAir(FormKind)
                ? _formBillAirDataUrl
                : _logoDataUrl;
        }

        if (string.Equals(item.Name, "CompanyLogo", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Name, "Text1", StringComparison.OrdinalIgnoreCase))
        {
            return _logoDataUrl;
        }

        return null;
    }

    async Task LoadFormAssetsAsync()
    {
        await _assetsLock.WaitAsync();
        try
        {
            await LoadFormAssetsCoreAsync();
        }
        finally
        {
            _assetsLock.Release();
        }
    }

    async Task LoadFormAssetsCoreAsync()
    {
        if (TemplateId == Guid.Empty)
        {
            _hasCustomFormLogo = false;
            _hasCustomFormBillAir = false;
            _logoDataUrl = null;
            _formBillAirDataUrl = null;
            return;
        }

        try
        {
            _companyLogoBytes ??= await FormService.GetCompanyLogoAsync();

            _hasCustomFormLogo = await FormService.HasCustomFormLogoAsync(TemplateId);
            var formLogo = await FormService.GetFormLogoAsync(TemplateId);
            _logoDataUrl = BuildLogoDataUrl(_hasCustomFormLogo ? formLogo : _companyLogoBytes);

            if (BillLayoutFormKindHelper.SupportsFormBackground(FormKind))
            {
                if (BillLayoutFormKindHelper.SupportsFormBillAir(FormKind))
                    _defaultBillAirImage1Bytes ??= await FormService.GetDefaultBillAirImage1Async();

                _hasCustomFormBillAir = await FormService.HasCustomFormBillAirAsync(TemplateId);
                var formBillAir = await FormService.GetFormBillAirAsync(TemplateId);
                _formBillAirDataUrl = BuildLogoDataUrl(
                    _hasCustomFormBillAir
                        ? formBillAir
                        : (BillLayoutFormKindHelper.SupportsFormBillAir(FormKind) ? _defaultBillAirImage1Bytes : null));

                try
                {
                    var doc = IsAttachMode
                        ? await FormService.LoadAttachFormDocumentAsync(TemplateId)
                        : await FormService.LoadFormDocumentAsync(TemplateId);
                    _hideAllLines = BillSeaLayoutMrtHelper.AreAllLinesDisabled(doc);
                }
                catch
                {
                    // Giữ nguyên _hideAllLines nếu chưa load được document.
                }
            }
            else
            {
                _hasCustomFormBillAir = false;
                _formBillAirDataUrl = null;
                _hideAllLines = false;
            }
        }
        catch (Exception ex)
        {
            _hasCustomFormLogo = false;
            _hasCustomFormBillAir = false;
            _logoDataUrl = BuildLogoDataUrl(_companyLogoBytes);
            _formBillAirDataUrl = BuildLogoDataUrl(_defaultBillAirImage1Bytes);
            ShowMessage($"Không tải được logo/form bill: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    static string? BuildLogoDataUrl(byte[]? logo)
    {
        if (logo is not { Length: > 0 })
            return null;

        return $"data:{DetectImageMime(logo)};base64,{Convert.ToBase64String(logo)}";
    }

    static string DetectImageMime(byte[] data)
    {
        if (data.Length >= 3 && data[0] == 0xFF && data[1] == 0xD8 && data[2] == 0xFF)
            return "image/jpeg";
        if (data.Length >= 8 && data[0] == 0x89 && data[1] == 0x50 && data[2] == 0x4E && data[3] == 0x47)
            return "image/png";
        if (data.Length >= 6 && data[0] == 0x47 && data[1] == 0x49 && data[2] == 0x46)
            return "image/gif";
        if (data.Length >= 12 && data[8] == 0x57 && data[9] == 0x45 && data[10] == 0x42 && data[11] == 0x50)
            return "image/webp";
        return "image/png";
    }

    async Task OnFormBillAirFileChanged(IBrowserFile? file)
    {
        if (file is null || TemplateId == Guid.Empty || !BillLayoutFormKindHelper.SupportsFormBackground(FormKind))
            return;

        if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
        {
            ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            if (file.Size > MaxFormBillAirBytes)
            {
                ShowMessage("Ảnh nền form tối đa 5MB.", MudBlazor.Severity.Warning);
                return;
            }

            _loading = true;
            await using var stream = file.OpenReadStream(MaxFormBillAirBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
