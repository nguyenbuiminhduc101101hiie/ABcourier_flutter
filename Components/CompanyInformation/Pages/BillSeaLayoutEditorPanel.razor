    void ToggleFieldBrowser() => _showFieldBrowser = !_showFieldBrowser;

    static string BuildFieldExpression(string tableName, string columnName) =>
        "{" + tableName + "." + columnName + "}";

    int CountFieldUsage(string tableName, string columnName)
    {
        var token = tableName + "." + columnName;
        var count = 0;
        foreach (var page in _pages)
        {
            foreach (var element in page.Elements)
            {
                if (element.Kind != BillSeaElementKind.DataText && element.Kind != BillSeaElementKind.StaticText)
                    continue;

                if (string.IsNullOrEmpty(element.Text))
                    continue;

                if (ContainsFieldToken(element.Text, token))
                    count++;
            }
        }

        return count;
    }

    static bool ContainsFieldToken(string text, string token)
    {
        var idx = text.IndexOf(token, StringComparison.OrdinalIgnoreCase);
        while (idx >= 0)
        {
            var endIdx = idx + token.Length;
            var charBefore = idx == 0 ? '\0' : text[idx - 1];
            var charAfter = endIdx >= text.Length ? '\0' : text[endIdx];
            var isLeftBoundary = charBefore == '\0' || (!char.IsLetterOrDigit(charBefore) && charBefore != '_' && charBefore != '.');
            var isRightBoundary = charAfter == '\0' || (!char.IsLetterOrDigit(charAfter) && charAfter != '_');
            if (isLeftBoundary && isRightBoundary)
                return true;

            idx = text.IndexOf(token, endIdx, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    List<BillSeaDataColumn> GetFilteredColumns(BillSeaDataSource source)
    {
        IEnumerable<BillSeaDataColumn> query = source.Columns;
        if (!string.IsNullOrWhiteSpace(_fieldKeyword))
            query = query.Where(c => c.Name.Contains(_fieldKeyword, StringComparison.OrdinalIgnoreCase));
        if (_showOnlyMissing)
            query = query.Where(c => CountFieldUsage(source.Name, c.Name) == 0);
        return query.ToList();
    }

    void BeginAddDataField(string tableName, string columnName)
    {
        if (CurrentPage is null)
            return;

        var expression = BuildFieldExpression(tableName, columnName);
        if (_pendingPlacementKind == BillSeaElementKind.DataText
            && string.Equals(_pendingDataExpression, expression, StringComparison.Ordinal))
        {
            CancelPlacement();
            return;
        }

        EndInteraction();
        _pendingPlacementKind = BillSeaElementKind.DataText;
        _pendingDataExpression = expression;
        _placementPreviewVisible = false;
    }

    void HighlightFieldUsage(string tableName, string columnName)
    {
        if (CurrentPage is null)
            return;

        var token = tableName + "." + columnName;
        var matches = CurrentPage.Elements
            .Where(x => (x.Kind == BillSeaElementKind.DataText || x.Kind == BillSeaElementKind.StaticText)
                        && !string.IsNullOrEmpty(x.Text)
                        && ContainsFieldToken(x.Text, token))
            .ToList();

        if (matches.Count == 0)
        {
            ShowMessage($"Không tìm thấy phần tử nào dùng {token} trên page hiện tại.", MudBlazor.Severity.Info);
            return;
        }

        _selectedNames.Clear();
        foreach (var m in matches)
            _selectedNames.Add(m.Name);
        _selectedElement = matches[0];
        _propertyEditUndoElementName = null;
        ShowMessage($"Đã chọn {matches.Count} phần tử dùng {token}.", MudBlazor.Severity.Info);
    }

    void HideFieldElements(string tableName, string columnName)
    {
        if (CurrentPage is null)
            return;

        var expression = BuildFieldExpression(tableName, columnName);
        var token = tableName + "." + columnName;

        var exactMatches = CurrentPage.Elements
            .Where(x => (x.Kind == BillSeaElementKind.DataText || x.Kind == BillSeaElementKind.StaticText)
                        && string.Equals((x.Text ?? string.Empty).Trim(), expression, StringComparison.Ordinal))
            .ToList();

        var complexMatches = CurrentPage.Elements
            .Where(x => (x.Kind == BillSeaElementKind.DataText || x.Kind == BillSeaElementKind.StaticText)
                        && !string.IsNullOrEmpty(x.Text)
                        && !exactMatches.Contains(x)
                        && ContainsFieldToken(x.Text, token))
            .ToList();

        if (exactMatches.Count == 0 && complexMatches.Count == 0)
        {
            ShowMessage($"Không có phần tử nào để ẩn cho {token}.", MudBlazor.Severity.Info);
            return;
        }

        if (exactMatches.Count == 0)
        {
            ShowMessage(
                $"Cột {token} chỉ xuất hiện trong biểu thức phức tạp ({complexMatches.Count} phần tử). Hãy chọn phần tử trên canvas rồi bấm Xóa nếu muốn ẩn.",
                MudBlazor.Severity.Warning);
            return;
        }

        PushUndo();
        var namesToRemove = exactMatches.Select(x => x.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        CurrentPage.Elements.RemoveAll(x => namesToRemove.Contains(x.Name));
        foreach (var name in namesToRemove)
            _sessionAddedNames.Remove(name);
        _selectedNames.RemoveWhere(n => namesToRemove.Contains(n));
        _selectedElement = GetSelectedElements().FirstOrDefault();

        var summary = exactMatches.Count + " phần tử đã được ẩn cho " + token;
        if (complexMatches.Count > 0)
            summary += $" (còn {complexMatches.Count} biểu thức phức tạp dùng cột này, không tự động ẩn).";
        ShowMessage(summary, MudBlazor.Severity.Success);
    }

