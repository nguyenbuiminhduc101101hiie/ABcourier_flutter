@using ABFreight.Models
@using ABFreight.Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (ResolvedAllowedKinds.Count > 1)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Loại form</b></MudText>
            <MudRadioGroup @bind-Value="_formKind" T="BillLayoutFormKind">
                @foreach (var kind in ResolvedAllowedKinds)
                {
                    <MudRadio Value="@kind" Color="Color.Primary">@BillLayoutFormKindHelper.GetLongDisplayName(kind)</MudRadio>
                }
            </MudRadioGroup>
        }

        <MudTextField @bind-Value="_formName"
                      Label="Tên form"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-3"
                      Immediate="true"
                      Placeholder="@GetPlaceholder()" />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Form mới sẽ copy từ template gốc <b>@GetTemplateName()</b>.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_formName)">
            Tạo
        </MudButton>
        <MudButton OnClick="Cancel">Hủy</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Tên form";

    [Parameter]
    public BillLayoutFormKind DefaultFormKind { get; set; } = BillLayoutFormKind.Sea;

    [Parameter]
    public List<BillLayoutFormKind>? AllowedKinds { get; set; }

    string _formName = string.Empty;
    BillLayoutFormKind _formKind = BillLayoutFormKind.Sea;

    List<BillLayoutFormKind> ResolvedAllowedKinds =>
        AllowedKinds is { Count: > 0 }
            ? AllowedKinds
            : new List<BillLayoutFormKind> { BillLayoutFormKind.Sea, BillLayoutFormKind.Air };

    protected override void OnParametersSet()
    {
        var allowed = ResolvedAllowedKinds;
        _formKind = allowed.Contains(DefaultFormKind) ? DefaultFormKind : allowed[0];
    }

    string GetTemplateName() => BillLayoutFormKindHelper.GetDefaultTemplateFile(_formKind);

    string GetPlaceholder() => _formKind switch
    {
        BillLayoutFormKind.AnSea => "VD: AN Sea chuẩn, AN Sea khách A...",
        BillLayoutFormKind.AnAir => "VD: AN Air chuẩn, AN Air khách A...",
        BillLayoutFormKind.Do => "VD: DO NVOCC chuẩn, DO khách A...",
        BillLayoutFormKind.Air => "VD: Bill Air khách A...",
        BillLayoutFormKind.Trang2 => "VD: Trang 2 điều khoản, Trang 2 ảnh...",
        BillLayoutFormKind.Booking => "VD: Booking chuẩn, Booking khách A...",
        _ => "VD: Bill NVOCC chuẩn, Bill Sea khách A..."
    };

    void Submit()
    {
        var name = _formName.Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;

        MudDialog.Close(DialogResult.Ok(new BillLayoutFormCreateRequest
        {
            FormName = name,
            FormKind = _formKind
        }));
    }

    void Cancel() => MudDialog.Cancel();
}
