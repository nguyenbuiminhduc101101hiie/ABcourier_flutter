@using System.Globalization


@inject IDialogService Dialog
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar
@inject AccountService asv
@inject SupportServices supsv
@inject SharedServices sv
@inject ShipmentService shipsv
@inject DNTUServices DNTUSv
@inject SharedServices ssv
@inject CustomerService csv
@attribute [Authorize]
@inject IDialogService DialogService
@inject HistoryLogService HistoryLogService
@using System.Text.Json;


<PageTitle>@Localizer["DNTT_khac"] </PageTitle>
<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["DNTT_khac"]" Subtitle="Advance payment (vendor &amp; other)">
        <Toolbar>
<MudStack Row Justify="Justify.FlexStart" Class="pa-2 flex-wrap">
    <MudButton HtmlTag="label"
               OnClick="Refresh_DNTT"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_DNTT_Logistics()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>

    <MudButton Disabled="_processingUpload"
               OnClick="ExportBill"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Download">
        @if (_processingUpload)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">Processing</MudText>
        }
        else
        {
            <MudText>@Localizer["Export_Bill"]</MudText>
        }
    </MudButton>

</MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card" Elevation="0">
<MudDataGrid T="M_DNTT_Logistics" Items="@Listdata_DNTT" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">

    <Columns>
        <HierarchyColumn T="M_DNTT_Logistics" />

        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.So" Title="@Localizer["So"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x => x.Approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
            </CellTemplate>
            <EditTemplate>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.timeDuyet" Title="@Localizer["Ngayduyet"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x => CustomerName(x.Customerid)" Title="@Localizer["Customer"]">
        </PropertyColumn>

        <PropertyColumn Property="x => x.NGAY" Title="@Localizer["NGAY"]" Required="false" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Kinhgui" Title="@Localizer["Kinhgui"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tennguoidenghi" Title="@Localizer["Tennguoidenghi"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Bophan" Title="@Localizer["bophan"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Noidung" Title="@Localizer["noidung"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.PTTT" Title="@Localizer["PTTT"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Sotientruocthue" Title="@Localizer["Sotientruocthue"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Sotienthue" Title="@Localizer["tienthue"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Loaitiente" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.PTTT" Title="@Localizer["PTTT"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Sotk" Title="@Localizer["sotk"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Hbl" Title="@Localizer["HBL"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Bkno" Title="@Localizer["Bkno"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Chungtukemtheo" Title="@Localizer["Chungtukemtheo"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Nguoilap" Title="@Localizer["Nguoilap"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Ketoantruong" Title="@Localizer["Ketoantruong"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Giamdoc" Title="@Localizer["Giamdoc"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => x.SoLanGuiEmail" Title="@Localizer["SoLanGuiEmail"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>


        <PropertyColumn Property="x => x.Lidoduyet" Title="@Localizer["Lidoduyet"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

    </Columns>

    <ChildRowContent>

        <Credit_details _dntt_details="context.Item" Customers="Customers" />

    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager T="M_DNTT_Logistics" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>
    </MudPaper>
</div>

@code {
    string usr;
    List<M_Customer> Customers = new List<M_Customer>();

    List<ChargeModel> charges = new List<ChargeModel>();
    List<M_Credit> CreditSelecteds = new List<M_Credit>();
    List<M_HBL> HBLSelecteds = new List<M_HBL>();
    List<M_HBL> HBLs = new List<M_HBL>();
    List<M_HBL> HBLs_search = new List<M_HBL>();
    List<M_Job> Jobs_search = new List<M_Job>();
    List<(M_Job job, Guid mblid)> Jobs = new List<(M_Job job, Guid mblid)>();
    List<M_DNTT_Logistics> Listdata_DNTT = new List<M_DNTT_Logistics>();
    private M_DNTT_Logistics selectedRow;
    private bool _resizeColumn;
    MudDataGrid<M_DNTT_Logistics> mudTable;
    string search_string;
    string search;
    M_DNTT_Logistics detail;
    private bool FilterFunc1(M_DNTT_Logistics sbd) => FilterFunc(sbd, search);
    public M_DNTT_Logistics DNTTs_by_id { get; set; }
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    Guid? customer_id;
    public bool Chk_vendor = false;
    public bool Chk_job = false;
    double? sotientruocthue;
    double? sotienthue;
    double? sotiensauthue;
    string? BKNO;
    string? HBL;
    string? CUR;
    double? TIGIA;
    string? STK;
    public Guid CustomerSelected;
    public Guid jobSelected;
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    List<string> trangthais = new List<string>();

    private bool FilterFunc(M_DNTT_Logistics sbd, string searchString)
    {

        if (string.IsNullOrWhiteSpace(sbd.So))

            return true;
        if (string.IsNullOrWhiteSpace(searchString))

            return true;
        if (sbd.So!.Contains(searchString, StringComparison.OrdinalIgnoreCase))

            return true;
        if ($"{sbd.So} ".Contains(searchString))

            return true;

        return false;
    }
    protected async override Task OnInitializedAsync()
    {
 
        charges = await supsv.GetListCharge();

        Customers = await csv.GetListAll();
        usr = asv.GetAuth().Result.User.Identity!.Name!;

        // await Refresh_DNTT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTT").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
    }
    bool _loading = false;

    async Task Refresh_DNTT()
    {
        try
        {

            detail = null!;
            _loading = true;

            if (Listdata_DNTT != null)
            {
                Listdata_DNTT.Clear();
            }

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "DNTT"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata_DNTT = DNTUSv.GetListDNTT_all();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }
    bool _loadingCredit = false;
    private Func<M_DNTT_Logistics, string> _cellStyleFunc => x =>
    {

        string style = "";

        if (string.IsNullOrEmpty(x.Trangthai))
            return "color: #000000";

        var rs = M_Trangthais
        .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
        && t.Tieude.Equals("DNTT", StringComparison.InvariantCultureIgnoreCase))
        .Select(t => t.Mamau)
        .FirstOrDefault();
        return "color: " + rs;


    };
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    string jobidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Jobs_search.FirstOrDefault(x => x.JobID == cusid);
        return rs == null ? string.Empty : rs.JobNo!;
    }
    string Charidtocharge(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.DVT} - {rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }

    async Task SelectedItemsChanged(HashSet<M_Credit> items)
    {
        CreditSelecteds = items.ToList();
        sotientruocthue = CreditSelecteds.Sum(x => x.thanhtien);
        sotiensauthue = CreditSelecteds.Sum(x => x.thanhtiensauthue);
        sotienthue = CreditSelecteds.Sum(x => x.thue);
        var hblList = CreditSelecteds
            .Select(x => GetHBL(x.hblid))
            .Where(h => !string.IsNullOrWhiteSpace(h))
            .ToList();

        var distinctHblList = hblList.Distinct().ToList();
        var distinctHBL = distinctHblList.Count == 1 ? distinctHblList[0] : string.Join(", ", distinctHblList);

        HBL = distinctHBL;

        var bknoList = await DNTUSv.GetListBKno_from_hbl(distinctHBL);
        BKNO = bknoList.Count == 1
            ? bknoList[0]
            : string.Join(", ", bknoList.Distinct());

        TIGIA = CreditSelecteds.FirstOrDefault()?.tigiacredit;
        CUR = CreditSelecteds.FirstOrDefault()?.tiente;
        customer_id = CreditSelecteds.FirstOrDefault()?.customerid;

    }
    void SelectedItemsChangedHBL(HashSet<M_HBL> items)
    {
        HBLSelecteds = items.ToList();
    }
    private async Task<IEnumerable<Guid>> SearchCus(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<Guid>> SearchJob(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Jobs_search.Select(x => x.JobID);
            }
            // MBL.Porname = mst_Consignee;
            return Jobs_search.Where(x => !string.IsNullOrEmpty(x.JobNo) && (x.JobNo).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.JobID);

        }
        catch (Exception)
        {
            throw;
        }
    }

    private bool _processingUpload = false;
    string cur_type = "VND"; // default
    private async Task ExportBill()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            if (detail == null)
            {
                CallSnackBar(Localizer["SelectOneData"], MudBlazor.Severity.Warning);
                return;
            }
            var rs = await DNTUSv.ExportBill_DNTT(detail.Id!);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }

    string formatDate(DateTime? date)
    {
        if (date == null)
            return string.Empty;
        return date.Value.ToString("dd/MM/yyyy");
    }

    string AgentidtoName(Guid id)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == id);
        return rs.CodeName();
    }
    string Getjobno(Guid? mblid)
    {
        if (mblid == Guid.Empty) return string.Empty;
        var rs = Jobs.FirstOrDefault(x => x.mblid != Guid.Empty && x.mblid == mblid);
        return string.IsNullOrEmpty(rs.job.JobNo) ? string.Empty : rs.job.JobNo;
    }
    string GetHBL(Guid? hblid)
    {
        if (hblid == Guid.Empty) return string.Empty;
        var rs = HBLs.FirstOrDefault(x => x.hblID != Guid.Empty && x.hblID == hblid);
        return string.IsNullOrEmpty(rs.hbl) ? string.Empty : rs.hbl;
    }


    async Task CommittedItem(M_DNTT_Logistics item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.Id != Guid.Empty ? await DNTUSv.UpdateDNTT_Detail(item) : await DNTUSv.CreateDNTT_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh_DNTT();
    }
    int? index_no;

    async Task DeleteItem(M_DNTT_Logistics item)
    {
        if (item.Approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "DNTT"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var item_dntt = item;
            var rs = await DNTUSv.DeleteDNTT_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete DNTT", "DNTT", item.Id, item.So, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh_DNTT();
        }

    }
    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    void RowClicked(DataGridRowClickEventArgs<M_DNTT_Logistics> args)
    {

        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_DNTT_Logistics m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    string CustomerName(Guid? customerID)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs.CodeName();
    }

    private async Task OpenCreateDialog(Models.M_DNTT_Logistics tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "DNTT"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTT_Detail, tr }, { x => x.Status, "other" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? Localizer["DNTT_VendorOther_Create"] : Localizer["DNTT_VendorOther_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_DNTT_Logistics)result.Data;
                var rs = await DNTUSv.UpdateCreateDNTT(data);

                await HistoryLogService.LogAsync(usr, "ADD DNTT Other", "DNTT", data.Id, data.So, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                {
                    severity = MudBlazor.Severity.Success;
                    foreach (var items in CreditSelecteds)
                    {
                        var creditList = await shipsv.GetCredit_ByID(items.creditid);
                        var credit = creditList.FirstOrDefault();
                        if (credit != null)
                        {
                            credit.DNTT = true;
                            credit.sodntt = data.So;
                            await shipsv.UpdateCreditMBL_DNTT(credit);
                        }


                    }
                  

                }

                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }


    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            if (Listdata_DNTT != null)
            {
                Listdata_DNTT.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "DNTT"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            Listdata_DNTT = await DNTUSv.GetListDNTT_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_DNTT_Logistics tr)
    {

        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNTT"))
        {
            var OldData = JsonSerializer.Deserialize<M_DNTT_Logistics>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTT_Detail, tr }, { x => x.Status, "edit" }, { x => x.TYPE, "" } };

            var dialog = await DialogService.ShowAsync<ADD>(Localizer["DNTT_VendorOther_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_DNTT_Logistics)result.Data;
                var rs = await DNTUSv.UpdateCreateDNTT(data);

                await HistoryLogService.LogAsync(usr, "Update DNTT Other", "DNTT", data.Id, data.So, new { OldData = OldData, NewData = data });

                //--------------------------------------------
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_DNTT_Logistics tr)
    {

        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "DNTT"))
        {
            var OldData = JsonSerializer.Deserialize<M_DNTT_Logistics>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTT_Detail, tr }, { x => x.Status, "Duplicate" }, { x => x.TYPE, "" } };

            var dialog = await DialogService.ShowAsync<ADD>(Localizer["DNTT_VendorOther_Duplicate"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_DNTT_Logistics)result.Data;
                var rs = await DNTUSv.UpdateCreateDNTT(data);
                await HistoryLogService.LogAsync(usr, "Duplicate DNTT Other", "DNTT", data.Id, data.So, new { OldData = OldData, NewData = data });

                //--------------------------------------------
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;

                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                await HandleRefresh_create(data.Id);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task UpdatebyCheckboxClick(M_DNTT_Logistics item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "DNTT"))
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
        var rs = await DNTUSv.UpdateCreateDNTT(item);
        CallSnackBar(rs[0], rs[1] == "1" ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }


}