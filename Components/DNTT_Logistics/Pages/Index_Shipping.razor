    private async Task OpenCreateDialog(Models.M_DNTT_Logistics tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "DNTT"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            // var parameters = new DialogParameters<ADD> { { x => x._DNTT_Detail, tr }, { x => x.Status, "add" }, { x => x.Customer_id, customer_id }, { x => x.sotientruocthue, sotientruocthue }, { x => x.sotienthue, sotienthue }, { x => x.sotiensauthue, sotiensauthue }, { x => x.BKNO, BKNO }, { x => x.HBL, HBL } };
            STK = csv.GetCus_BankFromID(customer_id);

            var parameters = new DialogParameters
            {
                { nameof(ADD._DNTT_Detail), tr },
                { nameof(ADD.Status), "add" },
                { nameof(ADD.Customer_id), customer_id },
                { nameof(ADD.sotientruocthue), sotientruocthue },
                { nameof(ADD.sotienthue), sotienthue },
                { nameof(ADD.sotiensauthue), sotiensauthue },
                { nameof(ADD.BKNO), BKNO },
                { nameof(ADD.HBL), HBL },
                { nameof(ADD.CUR), "VND" },
                { nameof(ADD.TIGIA), TIGIA },
                { nameof(ADD.TYPE), "" },
                { nameof(ADD.STK), STK}
            };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? Localizer["DNTT_Shipping_Create"] : Localizer["DNTT_Shipping_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_DNTT_Logistics)result.Data;
                var rs = await DNTUSv.UpdateCreateDNTT(data);

                await HistoryLogService.LogAsync(usr, "ADD DNTT", "DNTT", data.Id, data.So, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                {
                    severity = MudBlazor.Severity.Success;
                    foreach (var items in CreditSelecteds)
                    {
                        var creditList = await shipsv.GetCredit_ByID(items.creditid);
                        var credit = creditList.FirstOrDefault();
                        if (credit != null)
                        {
                            credit.DNTT = true;
                            credit.sodntt = data.So;
                            await shipsv.UpdateCreditMBL_DNTT(credit);
                        }
                        

                    }
                    await RefreshDebit();

                }

                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }


