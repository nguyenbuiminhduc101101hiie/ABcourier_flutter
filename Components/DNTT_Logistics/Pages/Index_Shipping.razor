@using System.Globalization


@inject IDialogService Dialog
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar
@inject AccountService asv
@inject SupportServices supsv
@inject SharedServices sv
@inject ShipmentService shipsv
@inject DNTUServices DNTUSv
@inject SharedServices ssv
@inject CustomerService csv
@attribute [Authorize]
@inject IDialogService DialogService
@inject HistoryLogService HistoryLogService
@using System.Text.Json; 

<PageTitle>@Localizer["DNTT"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["DNTT"]" Subtitle="MBL / credit &amp; advance payment (shipping)" />

<div class="pa-4" style="margin-top:15px; margin-bottom:10px;">
    <MudGrid>
        <MudItem xs=4>
            <MudAutocomplete T="Guid" @bind-Value="CustomerSelected" Label="@Localizer["search_vendor"]"
                             SearchFunc="SearchCus" ToStringFunc="CusidtoCusCode" MaxItems="10" Clearable />
        </MudItem>
        <MudItem xs="1">
            <MudCheckBox @bind-Checked="Chk_vendor" Label="Vendor" />
        </MudItem>
        <MudItem xs=4>
            <MudAutocomplete T="Guid" @bind-Value="jobSelected" Label="@Localizer["search_job"]"
                             SearchFunc="SearchJob" ToStringFunc="jobidtoCusCode" MaxItems="10" Clearable />
        </MudItem>
        <MudItem xs="1">
            <MudCheckBox @bind-Checked="Chk_job" Label="Job" />
        </MudItem>

        <MudItem xs="2">
            <MudButton HtmlTag="label"
                       OnClick="Refresh"
                       Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
        </MudItem>

        <MudItem xs="4">
            <MudDateRangePicker Label="@Localizer["searchdatefromto"]"
                                @bind-DateRange="_dateRange" />
        </MudItem>

        <MudItem xs="3">
            <MudButton HtmlTag="label"
                       OnClick="Refresh_Date"
                       Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["searchdatefromto"]
            </MudButton>
        </MudItem>
         <MudItem xs=5>
        </MudItem>
        <MudItem xs=6>
            <MudDataGrid T="M_HBL" Items="@HBLs" Filterable="true" MultiSelection="true" Class="custom-credit"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Bordered="true" Virtualize Height="550px;"
                         FixedHeader="true" HeaderClass="no-wrap" SelectOnRowClick="false" FooterClass="nondisplay"
                         ReadOnly="false" ColumnResizeMode="ResizeMode.Column" Loading="_loading" SelectedItemsChanged="SelectedItemsChangedHBL">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@Localizer["HBL List"]</MudText>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Search" OnClick="RefreshDebit">
                        @Localizer["getcredit"]
                    </MudButton>
                </ToolBarContent>
                <Columns>
                    <SelectColumn T="M_HBL" />
                    <PropertyColumn Property="x => Getjobno(x.mblid)" Title="@Localizer["Job No."]" Required="false" />
                    <PropertyColumn Property="x => x.hbl" Title="@Localizer["HBL"]" />
                    <PropertyColumn Property="x => x.dathudebit" Title="@Localizer["Debit_Received"]" Required="false" Filterable="false">
                        <CellTemplate>
                            <MudCheckBox Value="context.Item.dathudebit.HasValue ? context.Item.dathudebit.Value : false" ReadOnly />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.dachicredit" Title="@Localizer["Spent_Credit"]" Required="false" Filterable="false">
                        <CellTemplate>
                            <MudCheckBox Value="context.Item.dachicredit.HasValue ? context.Item.dachicredit.Value : false" ReadOnly />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.dathuchidaily" Title="@Localizer["Received_Spent_Agent"]" Required="false" Filterable="false">
                        <CellTemplate>
                            <MudCheckBox Value="context.Item.dathuchidaily.HasValue ? context.Item.dathuchidaily.Value : false" ReadOnly />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => formatDate(x.ETA)" Title="@Localizer["ETA"]" />
                    <PropertyColumn Property="x => formatDate(x.ETD)" Title="@Localizer["ETD"]" />
                    <PropertyColumn Property="x => CusidtoCusCode(x.CustomerID)" Title="@Localizer["Main_Customer"]" Required CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => AgentidtoName(x.AgentID)" Title="@Localizer["Agent"]" Required CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.bkno" Title="@Localizer["No."]" />
                    <PropertyColumn Property="x => x.Air_wareHouse" Title="@Localizer["Warehouse"]" />
                    <PropertyColumn Property="x => x.Air_type" Title="@Localizer["CFS-CY"]" />
                    <PropertyColumn Property="x => x.shipper" Title="@Localizer["Shipper"]" Required="false" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.consignee" Title="@Localizer["consignee"]" Required="false" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.notify1" Title="@Localizer["Notify"]" Required="false" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.SaleName" Title="@Localizer["SaleName"]" Required CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.statusHBL" Title="@Localizer["status"]" Required="false" />
                </Columns>
            </MudDataGrid>
        </MudItem>
        <MudItem xs=6>
            <MudDataGrid T="M_Credit" Items="@Listdata" Filterable="true" MultiSelection="true" SelectedItemsChanged="@SelectedItemsChanged"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="550px;" Class="custom-credit"
                         FixedHeader="true" HeaderClass="no-wrap" SelectOnRowClick="false" FooterClass="nondisplay"
                         ReadOnly="true" Bordered="true" ColumnResizeMode="ResizeMode.Column" Loading="_loadingCredit">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@Localizer["Credits"]</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <Columns>
                    <SelectColumn T="M_Credit" />
                    <PropertyColumn Property="x => GetHBL(x.hblid)" Title="@Localizer["HBL"]" Required="false" />
                    <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x =>  Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.dongia" Title="@Localizer["unitprice"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false" />
                    <PropertyColumn Property="x => x.thue" Title="@Localizer["vat"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["thanhtiensauthue"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.chiho" Title="@Localizer["thuho"]" Required="false" />
                    <PropertyColumn Property="x => x.tigiacredit" Title="@Localizer["Exc_Credit"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.tigiahoadondauvao" Title="@Localizer["Output_Invoice_Rate"]" Format="#,##0.##" Required="false" />
                    <PropertyColumn Property="x => x.approve" Title="@Localizer["Approve"]" />
                    <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                    <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                    <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                </Columns>
            </MudDataGrid>
        </MudItem>

        <MudItem xs=6></MudItem>
        <MudItem xs=6>
            <MudStack Row Class="pa-4">

            </MudStack>
        </MudItem>

    </MudGrid>
    <MudText Class="pa-2" Typo="Typo.h6">@Localizer["DNTT"]</MudText>
    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudButton HtmlTag="label"
                   OnClick="Refresh_DNTT"
                   Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["reload"]
        </MudButton>
        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenCreateDialog(new Models.M_DNTT_Logistics()))"
                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add">
            @Localizer["new"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenEditDialog(detail))"
                   Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Edit">
            @Localizer["edit"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenDuplicateDialog(detail))"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CopyAll">
            @Localizer["duplicate"]
        </MudButton>

         <MudButton Disabled="_processingUpload"
                   OnClick="ExportBill"
                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download">
            @if (_processingUpload)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Processing</MudText>
            }
            else
            {
                <MudText>@Localizer["Export_Bill"]</MudText>
            }
        </MudButton>

    </MudStack>


    <MudDataGrid T="M_DNTT_Logistics" Items="@Listdata_DNTT" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
    FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
    FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
    ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
    RowClick="@RowClicked" EditDialogOptions="@options"
                 ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">

        <Columns>
            <HierarchyColumn T="M_DNTT_Logistics" />

            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.So" Title="@Localizer["So"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Property="x => x.Approve" Title="@Localizer["Approve"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Property="x => x.timeDuyet" Title="@Localizer["Ngayduyet"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Property="x => CustomerName(x.Customerid)" Title="@Localizer["Customer"]">
            </PropertyColumn>

            <PropertyColumn Property="x => x.NGAY" Title="@Localizer["NGAY"]" Required="false" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Kinhgui" Title="@Localizer["Kinhgui"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Tennguoidenghi" Title="@Localizer["Tennguoidenghi"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Bophan" Title="@Localizer["bophan"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Noidung" Title="@Localizer["noidung"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.PTTT" Title="@Localizer["PTTT"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Sotientruocthue" Title="@Localizer["Sotientruocthue"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Sotienthue" Title="@Localizer["tienthue"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Loaitiente" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.PTTT" Title="@Localizer["PTTT"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Sotk" Title="@Localizer["sotk"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Hbl" Title="@Localizer["HBL"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Bkno" Title="@Localizer["Bkno"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Chungtukemtheo" Title="@Localizer["Chungtukemtheo"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Nguoilap" Title="@Localizer["Nguoilap"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Ketoantruong" Title="@Localizer["Ketoantruong"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.Giamdoc" Title="@Localizer["Giamdoc"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

            <PropertyColumn Property="x => x.SoLanGuiEmail" Title="@Localizer["SoLanGuiEmail"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

 
            <PropertyColumn Property="x => x.Lidoduyet" Title="@Localizer["Lidoduyet"]" Required="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>

        </Columns>

         <ChildRowContent>

            <Credit_details _dntt_details="context.Item" Customers="Customers" />

        </ChildRowContent>

        <PagerContent>
            <MudDataGridPager T="M_DNTT_Logistics" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
        </PagerContent>
    </MudDataGrid>
</div>
</div>
@code {
    string usr;
    List<M_Customer> Customers = new List<M_Customer>();

    List<ChargeModel> charges = new List<ChargeModel>();
    List<M_Credit> CreditSelecteds = new List<M_Credit>();
    List<M_HBL> HBLSelecteds = new List<M_HBL>();
    List<M_HBL> HBLs = new List<M_HBL>();
    List<M_HBL> HBLs_search = new List<M_HBL>();
    List<M_Job> Jobs_search = new List<M_Job>();
    List<(M_Job job, Guid mblid)> Jobs = new List<(M_Job job, Guid mblid)>();
    List<M_DNTT_Logistics> Listdata_DNTT = new List<M_DNTT_Logistics>();
    private M_DNTT_Logistics selectedRow;
    private bool _resizeColumn;
    MudDataGrid<M_DNTT_Logistics> mudTable;
    string search_string;
    string search;
    M_DNTT_Logistics detail;
    private bool FilterFunc1(M_DNTT_Logistics sbd) => FilterFunc(sbd, search);
    public M_DNTT_Logistics DNTTs_by_id { get; set; }
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    Guid? customer_id;
    public bool Chk_vendor = false;
    public bool Chk_job = false;
    public bool chk_date = false;
    double? sotientruocthue;
    double? sotienthue;
    double? sotiensauthue;
    string? BKNO;
    string? HBL;
    string? CUR;
    double? TIGIA;
    string? STK;
    public Guid CustomerSelected; 
    public Guid jobSelected;
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    List<string> trangthais = new List<string>();
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);

    private bool FilterFunc(M_DNTT_Logistics sbd, string searchString)
    {

        if (string.IsNullOrWhiteSpace(sbd.So))

            return true;
        if (string.IsNullOrWhiteSpace(searchString))

            return true;
        if (sbd.So!.Contains(searchString, StringComparison.OrdinalIgnoreCase))

            return true;
        if ($"{sbd.So} ".Contains(searchString))

            return true;

        return false;
    }
    protected async override Task OnInitializedAsync()
    {
        Jobs_search = await shipsv.GetListJob();
        charges = await supsv.GetListCharge();
        // Customers = await csv.GetList_Bymaincus("Shipping");
        Customers = await csv.GetListAll();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Jobs = await shipsv.GetListJobNoAndMBLID();
        // await Refresh_DNTT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTT").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
    }
    bool _loading = false;
    List<M_Credit> Listdata = new List<M_Credit>();

    private Func<M_DNTT_Logistics, string> _cellStyleFunc => x =>
      {

          string style = "";

          if (string.IsNullOrEmpty(x.Trangthai))
              return "color: #000000";

          var rs = M_Trangthais
          .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
              && t.Tieude.Equals("DNTT", StringComparison.InvariantCultureIgnoreCase))
          .Select(t => t.Mamau)
          .FirstOrDefault();
          return "color: " + rs;


      };
    async Task Refresh()
    {
        try
        {

            if (Chk_vendor == true && Chk_job == false)
            {
                if (CustomerSelected == null || CustomerSelected == Guid.Empty)
                {
                    CallSnackBar(Localizer["NothingToSearch"], MudBlazor.Severity.Warning);
                    return;
                }
                _loading = true;
                // Simulate asynchronous loading to demonstrate a loading indicator
                HBLs.Clear();
                HBLSelecteds.Clear();
                Listdata.Clear();
                CreditSelecteds.Clear();
                StateHasChanged();
                await Task.Delay(500);
                if (!await ssv.CheckPermission(usr, "View", "HBL"))
                {
                    CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                    return;
                }
                HBLs = await DNTUSv.GetListHBL_ByCus(CustomerSelected);

                customer_id = CustomerSelected;
            }
            else if (Chk_vendor == false && Chk_job == true)
            {
                if (jobSelected == null || jobSelected == Guid.Empty)
                {
                    CallSnackBar(Localizer["NothingToSearch"], MudBlazor.Severity.Warning);
                    return;
                }
                _loading = true;
                // Simulate asynchronous loading to demonstrate a loading indicator
                HBLs.Clear();
                HBLSelecteds.Clear();
                Listdata.Clear();
                CreditSelecteds.Clear();
                StateHasChanged();
                await Task.Delay(500);
                if (!await ssv.CheckPermission(usr, "View", "HBL"))
                {
                    CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                    return;
                }
                HBLs = await DNTUSv.GetListHBL_Byjob(jobSelected);
            }
            else if (Chk_vendor == true && Chk_job == true)
            {
                if (CustomerSelected == null || CustomerSelected == Guid.Empty)
                {
                    CallSnackBar(Localizer["NothingToSearch"], MudBlazor.Severity.Warning);
                    return;
                }
                if (jobSelected == null || jobSelected == Guid.Empty)
                {
                    CallSnackBar(Localizer["NothingToSearch"], MudBlazor.Severity.Warning);
                    return;
                }
                HBLs.Clear();
                HBLSelecteds.Clear();
                Listdata.Clear();
                CreditSelecteds.Clear();
                StateHasChanged();
                await Task.Delay(500);
                if (!await ssv.CheckPermission(usr, "View", "HBL"))
                {
                    CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                    return;
                }
                HBLs = await DNTUSv.GetListHBL_Byjob_cus(jobSelected, CustomerSelected);
            }
            else
            {
                CallSnackBar(Localizer["SelectSearchCondition"], MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task Refresh_Date()
    {
        try
        {
            var startDate = _dateRange.Start.Value;
            var endDate = _dateRange.End.Value;
            if (startDate != null && endDate != null)
            {
                _loading = true;
                // Simulate asynchronous loading to demonstrate a loading indicator
                HBLs.Clear();
                HBLSelecteds.Clear();
                Listdata.Clear();
                CreditSelecteds.Clear();
                StateHasChanged();
                await Task.Delay(500);
                if (!await ssv.CheckPermission(usr, "View", "HBL"))
                {
                    CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                    return;
                }
                HBLs = await DNTUSv.GetListHBL_Bydate(startDate, endDate);

                customer_id = CustomerSelected;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }



    async Task Refresh_DNTT()
    {
        try
        {

            detail = null!;
            _loading = true;

            if (Listdata_DNTT != null)
            {
                Listdata_DNTT.Clear();
            }

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "DNTT"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata_DNTT = DNTUSv.GetListDNTT_all();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }
    bool _loadingCredit = false;
    async Task RefreshDebit()
    {
        try
        {
            if (HBLSelecteds.Count == 0)
            {
                CallSnackBar(Localizer["NothingToFind"], MudBlazor.Severity.Warning);
                return;
            }
            _loadingCredit = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            CreditSelecteds.Clear();
            StateHasChanged();
            await Task.Delay(500);
            // Listdata = await shipsv.GetListCreditHBL_where_maincode(HBLSelecteds,"Shipping");

            Listdata = await shipsv.GetListCreditHBL_where_maincode(HBLSelecteds);
        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingCredit = false;
        }
    }
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    string jobidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Jobs_search.FirstOrDefault(x => x.JobID == cusid);
        return rs == null ? string.Empty : rs.JobNo!;
    }
    string Charidtocharge(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.DVT} - {rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }

    async Task SelectedItemsChanged(HashSet<M_Credit> items)
    {
        CreditSelecteds = items.ToList();
        // sotientruocthue = CreditSelecteds.Sum(x => x.thanhtien); 
        // sotiensauthue = CreditSelecteds.Sum(x => x.thanhtiensauthue);
        // Tính tổng tiền theo đơn vị nội tệ
        // sotienthue = CreditSelecteds.Sum(x => x.thue);
        sotientruocthue = CreditSelecteds.Sum(x =>
            x.tiente == "USD" ? x.thanhtien * x.tigiacredit : x.thanhtien);

        sotiensauthue = CreditSelecteds.Sum(x =>
            x.tiente == "USD" ? x.thanhtiensauthue * x.tigiacredit : x.thanhtiensauthue);
        sotienthue = sotiensauthue - sotientruocthue;
        var hblList = CreditSelecteds
            .Select(x => GetHBL(x.hblid))
            .Where(h => !string.IsNullOrWhiteSpace(h))
            .ToList();

        var distinctHblList = hblList.Distinct().ToList();
        var distinctHBL = distinctHblList.Count == 1 ? distinctHblList[0] : string.Join(", ", distinctHblList);

        HBL = distinctHBL;

        var bknoList = await DNTUSv.GetListBKno_from_hbl(distinctHBL);
        BKNO = bknoList.Count == 1
            ? bknoList[0]
            : string.Join(", ", bknoList.Distinct());

        TIGIA = CreditSelecteds.FirstOrDefault()?.tigiacredit;
        CUR = CreditSelecteds.FirstOrDefault()?.tiente;
        customer_id = CreditSelecteds.FirstOrDefault()?.customerid;

    }
    void SelectedItemsChangedHBL(HashSet<M_HBL> items)
    {
        HBLSelecteds = items.ToList();
    }
    private async Task<IEnumerable<Guid>> SearchCus(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<Guid>> SearchJob(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Jobs_search.Select(x => x.JobID);
            }
            // MBL.Porname = mst_Consignee;
            return Jobs_search.Where(x => !string.IsNullOrEmpty(x.JobNo) && (x.JobNo).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.JobID);

        }
        catch (Exception)
        {
            throw;
        }
    }

