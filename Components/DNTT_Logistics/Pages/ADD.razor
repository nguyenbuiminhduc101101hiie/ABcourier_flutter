@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject tigiaVCBservices Vcbsv
@inject IJSRuntime JSRuntime
<MudDialog>
    <DialogContent>
        <div class="pp-schedule-dialog-shell">
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
                <MudCard Elevation="0" Class="pp-schedule-card">
                    <div class="pp-schedule-header">
                        <div>
                            <div class="pp-schedule-title">@Localizer["DNTT"]</div>
                            <div class="pp-schedule-subtitle">@Localizer["So"] / @Localizer["Customer"] / @Localizer["ThanhTien"]</div>
                        </div>
                    </div>
                    <MudForm Model="@_DNTT_Detail" @ref="@form">
                        <MudCardContent Class="pa-3">
                            <div class="pp-section pp-soft-section">
                                <div class="pp-section-title">Document</div>
                                <MudGrid Spacing="2">

                                    <MudItem xs="12" sm="2" Class="d-flex align-end pb-2">
                                        <MudButton Class="pp-action-button"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(Status == "edit")"
                                                   OnClick="() => Get_BGNHNo()">&gt;&gt;&gt;</MudButton>
                                    </MudItem>

                                    <MudItem xs="12" sm="5">
                                <MudTextField @bind-Value="_DNTT_Detail.So" Disabled="true" Label="@Localizer["So"]" Class="custom-label" Required="true" />
                            </MudItem>

                                    <MudItem xs="12" sm="5">
                                <MudDatePicker Class="custom-label" @bind-Date="_DNTT_Detail.NGAY"
                                For="@(() => _DNTT_Detail.NGAY)"
                                Label="@Localizer["NGAY"]"
                                DateFormat="dd/MM/yyyy"
                                Required="true" />
                            </MudItem>

                                </MudGrid>
                            </div>

                            <div class="pp-section">
                                <div class="pp-section-title">Details &amp; amounts</div>
                        <MudGrid Spacing="2">

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.Kinhgui" Label="@Localizer["Kinhgui"]" class="custom-label" CoerceValue SearchFunc="Searchlinhgui" />
                            </MudItem>



                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNTT_Detail.Tennguoidenghi"
                                Label="@Localizer["Tennguoidenghi"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_DNTT_Detail.Noidung" Label="@Localizer["noidung"]" Class="custom-label" Lines="3" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.Bophan" Label="@Localizer["bophan"]" class="custom-label" CoerceValue SearchFunc="Searchbophan" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class="custom-label" T="Guid?" Label="@Localizer["Customer"]"
                                @bind-Value="_DNTT_Detail.Customerid"
                                SearchFunc="Search_Customer"
                                ToStringFunc="GetCustomerLable" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.Sotk" Label="@Localizer["sotk"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNTT_Detail.Sotientruocthue"
                                Label="@Localizer["Sotientruocthue"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNTT_Detail.Sotienthue"
                                                 Label="@Localizer["tienthue"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNTT_Detail.Thanhtien"
                                Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.Loaitiente" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                            </MudItem>

                            <MudItem xs="6">
                                
                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                               OnClick="@(() => GetTigia(_DNTT_Detail))">
                                        @Localizer["gettigia"]
                                    </MudButton>

                                    <MudNumericField @bind-Value="_DNTT_Detail.Tigia"
                                                     Label="@Localizer["tigia"]"
                                                     Format="#,##0.##" Culture="@_en"
                                                     T="double?" Required="true" HideSpinButtons="true"
                                                     Dense="true"
                                                     Class="text-right custom-label" />
                                </MudStack>
                            </MudItem>


                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.PTTT" Label="@Localizer["PTTT"]" class="custom-label" CoerceValue SearchFunc="SearchPTTT" />
                            </MudItem>

                            <MudItem xs="6">

                                <MudAutocomplete @bind-Value="_DNTT_Detail.Bkno" Label="@Localizer["BookingNo"]" class="custom-label"  />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTT_Detail.Hbl" Label="@Localizer["HBL"]" class="custom-label"  />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNTT_Detail.Nguoilap"
                                Label="@Localizer["Nguoilap"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNTT_Detail.Ketoantruong"
                                Label="@Localizer["Ketoantruong"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNTT_Detail.Giamdoc"
                                Label="@Localizer["Giamdoc"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_DNTT_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12">
                                <MudStack Row>
                                    <MudFileUpload T="IBrowserFile"
                                    Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                    FilesChanged="@((t) => AttachFileToFTP(t, _DNTT_Detail))">
                                        <ButtonTemplate Context="context1">
                                            <MudIconButton HtmlTag="label" for="@context1"
                                            Size="Size.Small"
                                            Color="Color.Secondary"
                                            Icon="@Icons.Material.Filled.AttachFile" />
                                        </ButtonTemplate>
                                    </MudFileUpload>

                                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto;">
                                        <MudText Typo="Typo.h6">Files</MudText>

                                        @foreach (var item in Linksplit(_DNTT_Detail.Chungtukemtheo!))
                                        {
                                            var fileName = Path.GetFileName(item);
                                            var fileUrl = item.Replace("ftp", "http");
                                            var fileExtension = Path.GetExtension(fileName).ToLower();

                                            <MudPaper Elevation="3" Class="d-flex align-items-center justify-between ma-2 pa-2">
                                                <MudIcon Icon="@GetFileIcon(fileExtension)" Size="Size.Medium" />
                                                <MudText Class="mx-2" Style="flex-grow: 1;">@fileName</MudText>

                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                OnClick="@(() => SeeDetail(fileUrl))"
                                                Color="Color.Primary" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                OnClick="@(() => DeleteFiles(_DNTT_Detail, item))"
                                                Color="Color.Error" />
                                            </MudPaper>
                                        }
                                    </MudContainer>

                                </MudStack>
                            </MudItem>

                            <MudItem xs="3">
                                <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                                @bind-Value="UserHanding"
                                Label="@Localizer["User"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="3">
                                <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Getuser(_DNTT_Detail)">>>></MudButton>
                            </MudItem>

                            <MudItem xs="3">
                                <MudTextField @bind-Value="_DNTT_Detail.EmailUserApprove" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                Lines="3" AutoGrow Label="User Nhận Email" Required="false" />
                            </MudItem>

                            <MudItem xs="3">
                                <MudButton HtmlTag="label" Disabled="_processingUpload"
                                @onclick="@(() => SendMailnotify(_DNTT_Detail))"
                                Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Email">
                                    @if (_processingUpload)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["sendemail"]</MudText>
                                    }
                                </MudButton>

                            </MudItem>


                        </MudGrid>
                            </div>

                    </MudCardContent>
                </MudForm>

                </MudCard>
            </MudContainer>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="pp-dialog-actions-bar">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(async () => await Submit())">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    List<M_Customer> customers = new List<M_Customer>();
    [Parameter] public Models.M_DNTT_Logistics _DNTT_Detail { get; set; }
    [Parameter] public string Status { get; set; }
    [Parameter] public Guid Customer_id { get; set; }
    [Parameter] public double? sotientruocthue { get; set; }
    [Parameter] public double? sotienthue { get; set; }
    [Parameter] public double? sotiensauthue { get; set; }
    [Parameter] public string? HBL { get; set; }
    [Parameter] public string? BKNO { get; set; }
    [Parameter] public string? TYPE { get; set; }
    [Parameter] public string? CUR { get; set; }
    [Parameter] public double? TIGIA { get; set; }
    [Parameter] public string? STK { get; set; }
    List<string> currs = new List<string>();

    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();

    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();

    List<string> Bookings = new List<string>();
    List<Booking> M_Bookings = new List<Booking>();

    List<string> HBLs = new List<string>();
    List<M_HBL> M_HBLs = new List<M_HBL>();
    // List<M_DNTU> DNTUs_by_id = new List<M_DNTU>;
    // public M_DNTU DNTUs_by_id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (Status == "add")
        {
            _DNTT_Detail.Sotientruocthue = sotientruocthue;
            _DNTT_Detail.Sotienthue = sotienthue;
            _DNTT_Detail.Thanhtien = sotiensauthue;
            _DNTT_Detail.Bkno = BKNO;
            _DNTT_Detail.Hbl = HBL;
            _DNTT_Detail.Type = TYPE;
            _DNTT_Detail.Customerid = Customer_id;
            _DNTT_Detail.Loaitiente = CUR;
            _DNTT_Detail.Tigia = TIGIA;
            _DNTT_Detail.Sotk = STK;
            _DNTT_Detail.Trangthai = "Pending";
        }
        if (Status == "Duplicate")
        {
            _DNTT_Detail.Id = Guid.Empty;
            _DNTT_Detail.So="";
            _DNTT_Detail.NGAY = null;
            _DNTT_Detail.Approve = false;
        }

        DNTTs = DNTUSV.GetListDNTT_all();
        customers = await CusSV.GetListAll();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTT").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();

        currs = await Vcbsv.GetCur();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        M_Bookings = await Bksv.GetListSBooking();
        Bookings = M_Bookings.Select(x => x.BookingNo).ToList();

        M_HBLs = await shipmentsv.GetListHBLALL();
        HBLs = M_HBLs.Select(x => x.hbl).ToList();

    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("DNTT", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _DNTT_Detail.So = cn + "DNTT_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNTT") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "DNTT")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;

                _DNTT_Detail.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _DNTT_Detail.UserUpdate = UserName;
                _DNTT_Detail.Type = TYPE;

                //----update sotienhoanung , Conlai

                MudDialog!.Close(_DNTT_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }


    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string?>> Searchlinhgui(string? text)
    {
        try
        {
            var items = DNTTs.Select(x => x.Kinhgui).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> Searchbophan(string? text)
    {
        try
        {
            var items = DNTTs.Select(x => x.Bophan).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchPTTT(string? text)
    {
        try
        {
            var items = DNTTs.Select(x => x.PTTT).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }


    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

    private string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }


    async Task SeeDetail(string fileUrl)
    {
        // NavigationManager.NavigateTo(fileUrl, true);
        await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");

    }
    async Task DeleteFiles(M_DNTT_Logistics item, string link)
    {
        try
        {
            if (item.Chungtukemtheo!.Contains(";"))
                link = link + ";";
            item.Chungtukemtheo = item.Chungtukemtheo!.Replace(link, string.Empty);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_DNTT_Logistics item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_DNTT(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            item.Trangthai = "Completed";
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    private Task<IEnumerable<string>> Searchkinhgui(string value)
    {
        var items = M_HBLs
            .Select(x => x.hbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }
    private async Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return customers.Select(x => (Guid?)x.Customer_ID);

        return customers
        .Where(x => x.SearchKey().Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID)  // Convert Customer_ID to Guid?
        .ToList();


    }

    private string GetCustomerLable(Guid? id)
    {
        var rs = customers?.FirstOrDefault(x => x.Customer_ID == id);
        return rs.CodeName();
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_DNTT_Logistics item)
    {
        try
        {
            string[] users = item.EmailUserApprove.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
   
 
     
            if (emails != null && emailarray.Length > 0)
            {
                item.SoLanGuiEmail += 1;
                await DNTUSV.UpdateDNTT_Detail(item);
                var rs = await gsv.GuiThongBao_YCDuyetDNTT(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }




        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private async Task Getuser(M_DNTT_Logistics item)
    {
        if (string.IsNullOrEmpty(item.EmailUserApprove))
        {
            item.EmailUserApprove = UserHanding;
        }
        else
        {
            item.EmailUserApprove += "," + UserHanding + ",";
        }
    }
    private async Task GetTigia(M_DNTT_Logistics item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Loaitiente);
        item.Tigia = tigia_;
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }
}
