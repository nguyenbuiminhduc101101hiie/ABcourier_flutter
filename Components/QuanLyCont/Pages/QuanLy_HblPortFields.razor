@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@inject IDbContextFactory<AppDbContext> DbFactory

<MudItem xs="12" sm="6" md="4">
    <MudAutocomplete T="string"
                     Value="@_hblValue"
                     ValueChanged="OnHblNoChangedAsync"
                     Label="HB/L No"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     SearchFunc="SearchHblNo"
                     CoerceText="true"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     MaxLength="30" />
</MudItem>

<MudItem xs="12" sm="6" md="4">
    <MudAutocomplete T="string"
                     Value="@_polValue"
                     ValueChanged="OnPolValueChangedAsync"
                     Label="POL"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     SearchFunc="SearchPort"
                     CoerceText="true"
                     CoerceValue="false"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     MaxLength="50" />
</MudItem>

<MudItem xs="12" sm="6" md="4">
    <MudAutocomplete T="string"
                     Value="@_podValue"
                     ValueChanged="OnPodValueChangedAsync"
                     Label="POD"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     SearchFunc="SearchPort"
                     CoerceText="true"
                     CoerceValue="false"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     MaxLength="50" />
</MudItem>

@code {
    [Parameter] public string? HblNo { get; set; }
    [Parameter] public EventCallback<string?> HblNoChanged { get; set; }
    [Parameter] public string? Pol { get; set; }
    [Parameter] public EventCallback<string?> PolChanged { get; set; }
    [Parameter] public string? Pod { get; set; }
    [Parameter] public EventCallback<string?> PodChanged { get; set; }
    [Parameter] public EventCallback<M_HBL?> OnHblSelected { get; set; }

    private string? _hblValue;
    private string? _polValue;
    private string? _podValue;
    private bool _localPortUpdate;

    protected override void OnParametersSet()
    {
        _hblValue = HblNo;

        if (_localPortUpdate)
        {
            if (string.Equals(Pol, _polValue, StringComparison.Ordinal)
                && string.Equals(Pod, _podValue, StringComparison.Ordinal))
            {
                _localPortUpdate = false;
            }

            return;
        }

        if (!string.Equals(Pol, _polValue, StringComparison.Ordinal))
            _polValue = Pol;
        if (!string.Equals(Pod, _podValue, StringComparison.Ordinal))
            _podValue = Pod;
    }

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task OnHblNoChangedAsync(string? value)
    {
        _hblValue = TrimOrNull(value);
        await HblNoChanged.InvokeAsync(_hblValue);

        if (string.IsNullOrEmpty(_hblValue))
        {
            await ApplyPortValuesAsync(null, null);
            await OnHblSelected.InvokeAsync(null);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var match = await FindHblAsync(db, _hblValue);

        if (match is not null)
        {
            var pol = await ResolvePortDisplayAsync(db, match.polname, match.polcode);
            var pod = await ResolvePortDisplayAsync(db, match.podname, match.podcode);
            await ApplyPortValuesAsync(pol, pod);
        }

        await OnHblSelected.InvokeAsync(match);
    }

    private async Task ApplyPortValuesAsync(string? pol, string? pod)
    {
        _localPortUpdate = true;
        _polValue = pol;
        _podValue = pod;
        await PolChanged.InvokeAsync(pol);
        await PodChanged.InvokeAsync(pod);
    }

    private static async Task<M_HBL?> FindHblAsync(AppDbContext db, string hblNo)
    {
        var candidates = await db.HBL.AsNoTracking()
            .Where(x => x.hbl != null && x.hbl != string.Empty)
            .ToListAsync();

        return candidates.FirstOrDefault(x =>
            string.Equals(x.hbl?.Trim(), hblNo, StringComparison.OrdinalIgnoreCase));
    }

    private static async Task<string?> ResolvePortDisplayAsync(AppDbContext db, string? portName, string? portCode)
    {
        var name = TrimOrNull(portName);
        var code = TrimOrNull(portCode);

        if (!string.IsNullOrEmpty(name))
        {
            var byName = await db.Port.AsNoTracking()
                .Where(x => x.PORT == name
                            && x.PORT != string.Empty
                            && (x.CONTINUED == null || x.CONTINUED == true)
                            && x.show != false)
                .Select(x => x.PORT)
                .FirstOrDefaultAsync();
            if (!string.IsNullOrWhiteSpace(byName))
                return byName.Trim();

            return name;
        }

        if (string.IsNullOrEmpty(code))
            return null;

        var byCode = await db.Port.AsNoTracking()
            .Where(x => x.PORT_CODE == code
                        && x.PORT != null
                        && x.PORT != string.Empty
                        && (x.CONTINUED == null || x.CONTINUED == true)
                        && x.show != false)
            .Select(x => x.PORT)
            .FirstOrDefaultAsync();

        return !string.IsNullOrWhiteSpace(byCode) ? byCode.Trim() : code;
    }

    private async Task OnPolValueChangedAsync(string? value)
    {
        _localPortUpdate = true;
        _polValue = TrimOrNull(value);
        await PolChanged.InvokeAsync(_polValue);
    }

    private async Task OnPodValueChangedAsync(string? value)
    {
        _localPortUpdate = true;
        _podValue = TrimOrNull(value);
        await PodChanged.InvokeAsync(_podValue);
    }

    private async Task<IEnumerable<string>> SearchHblNo(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.HBL.AsNoTracking()
            .Where(x => x.hbl != null && x.hbl != string.Empty);

        if (!string.IsNullOrWhiteSpace(value))
        {
            var text = value.Trim();
            query = query.Where(x => x.hbl!.Contains(text));
        }

        return await query
            .Select(x => x.hbl!)
            .Distinct()
            .OrderBy(x => x)
            .Take(30)
            .ToListAsync();
    }

    private async Task<IEnumerable<string>> SearchPort(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Port.AsNoTracking()
            .Where(x => x.PORT != null
                        && x.PORT != string.Empty
                        && (x.CONTINUED == null || x.CONTINUED == true)
                        && x.show != false);

        if (!string.IsNullOrWhiteSpace(value))
        {
            var text = value.Trim();
            query = query.Where(x =>
                x.PORT!.Contains(text) ||
                (x.PORT_CODE != null && x.PORT_CODE.Contains(text)));
        }

        return await query
            .Select(x => x.PORT!)
            .Distinct()
            .OrderBy(x => x)
            .Take(30)
            .ToListAsync();
    }
}
