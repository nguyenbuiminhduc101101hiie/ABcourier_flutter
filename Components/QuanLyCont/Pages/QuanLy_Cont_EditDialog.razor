@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@inject IDbContextFactory<AppDbContext> DbFactory

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_principal" Label="Principal" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_chuCont" Label="Chủ cont" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                </MudItem>
                <QuanLy_HblPortFields @bind-HblNo="_hblNo"
                                      @bind-Pol="_pol"
                                      @bind-Pod="_pod"
                                      OnHblSelected="ApplyHblDetailsAsync" />
                <MudItem xs="12" sm="6" md="4">
                    @if (UseContainerAutocomplete)
                    {
                        <MudAutocomplete T="string"
                                         Value="_container"
                                         ValueChanged="OnContainerChangedAsync"
                                         Label="Container"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         SearchFunc="SearchContainerNoAsync"
                                         CoerceText="true"
                                         CoerceValue="true"
                                         ResetValueOnEmptyText="true"
                                         Strict="false"
                                         Clearable="true"
                                         MaxLength="20"
                                         HelperText="@GetContainerHelperText()" />
                    }
                    else
                    {
                        <MudTextField @bind-Value="_container"
                                      Label="Container"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="20"
                                      HelperText="@GetContainerHelperText()" />
                    }
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_contSize" Label="Size" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_contType" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="10" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_vessel" Label="Tàu" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_voy" Label="Chuyến" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_eta" Label="ETA" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_gateOut" Label="Gate out" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_emptyDate" Label="Ngày trả rỗng" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_yard" Label="Bãi" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_estimate" Label="Estimate" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_collect" Label="Collect" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_status" Label="Trạng thái" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_remark" Label="Ghi chú" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="500" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public QuanLy_Cont? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    public sealed class QuanLyContDialogResult
    {
        public Guid Id { get; init; }
        public string? Principal { get; init; }
        public string? ChuCont { get; init; }
        public string Container { get; init; } = string.Empty;
        public int? ContSize { get; init; }
        public string? ContType { get; init; }
        public string? HBL_No { get; init; }
        public string? POL { get; init; }
        public string? POD { get; init; }
        public string? Vessel { get; init; }
        public string? Voy { get; init; }
        public string? Remark { get; init; }
        public DateTime? ETA { get; init; }
        public DateTime? GateOut { get; init; }
        public DateTime? EmptyDate { get; init; }
        public string? Yard { get; init; }
        public string? Estimate { get; init; }
        public decimal? Collect { get; init; }
        public string? Status { get; init; }
        public bool IsEdit { get; init; }
    }

    private MudForm? _form;
    private string? _principal;
    private string? _chuCont;
    private string _container = string.Empty;
    private int? _contSize;
    private string? _contType;
    private string? _hblNo;
    private string? _pol;
    private string? _pod;
    private string? _vessel;
    private string? _voy;
    private string? _remark;
    private DateTime? _eta;
    private DateTime? _gateOut;
    private DateTime? _emptyDate;
    private string? _yard;
    private string? _estimate;
    private decimal? _collect;
    private string? _status;
    private Guid? _hblId;
    private List<M_Container> _hblContainers = new();

    private bool UseContainerAutocomplete => _hblContainers.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Model is null)
            return;

        _principal = Model.Principal;
        _chuCont = Model.ChuCont;
        _container = Model.Container ?? string.Empty;
        _contSize = Model.ContSize;
        _contType = Model.ContType;
        _hblNo = Model.HBL_No;
        _pol = Model.POL;
        _pod = Model.POD;
        _vessel = Model.Vessel;
        _voy = Model.Voy;
        _remark = Model.Remark;
        _eta = Model.ETA;
        _gateOut = Model.GateOut;
        _emptyDate = Model.EmptyDate;
        _yard = Model.Yard;
        _estimate = Model.Estimate;
        _collect = Model.Collect;
        _status = Model.Status;

        if (!string.IsNullOrWhiteSpace(_hblNo))
            await LoadContainersForHblAsync(null, _hblNo);
        else
            await LoadContainersForHblAsync(null, null);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(new QuanLyContDialogResult
        {
            Id = Model?.Id ?? Guid.Empty,
            Principal = TrimOrNull(_principal),
            ChuCont = TrimOrNull(_chuCont),
            Container = _container?.Trim() ?? string.Empty,
            ContSize = _contSize,
            ContType = TrimOrNull(_contType),
            HBL_No = TrimOrNull(_hblNo),
            POL = TrimOrNull(_pol),
            POD = TrimOrNull(_pod),
            Vessel = TrimOrNull(_vessel),
            Voy = TrimOrNull(_voy),
            Remark = TrimOrNull(_remark),
            ETA = _eta,
            GateOut = _gateOut,
            EmptyDate = _emptyDate,
            Yard = TrimOrNull(_yard),
            Estimate = TrimOrNull(_estimate),
            Collect = _collect,
            Status = TrimOrNull(_status),
            IsEdit = IsEdit
        }));
    }

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private Task OnHblNoChangedAsync(string? value)
    {
        _hblNo = value;
        return Task.CompletedTask;
    }

    private Task OnPolChangedAsync(string? value)
    {
        _pol = value;
        return Task.CompletedTask;
    }

    private Task OnPodChangedAsync(string? value)
    {
        _pod = value;
        return Task.CompletedTask;
    }

    private async Task ApplyHblDetailsAsync(M_HBL? match)
    {
        if (match is null && !string.IsNullOrWhiteSpace(_hblNo))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            match = await db.HBL.AsNoTracking()
                .Where(x => x.hbl != null && x.hbl != string.Empty)
                .FirstOrDefaultAsync(x => x.hbl!.Trim() == _hblNo.Trim());
        }

        if (match is null)
        {
            await LoadContainersForHblAsync(null, null);
            return;
        }

        await LoadContainersForHblAsync(match.hblID, match.hbl);

        _vessel = TrimOrNull(match.vessel);
        _voy = TrimOrNull(match.voy);
        _eta = match.ETA;

        if (_hblContainers.Count > 0)
            ApplyFirstContainerForHbl();
        else
        {
            _container = string.Empty;
            _contSize = null;
            _contType = null;
        }
    }

    private void ApplyFirstContainerForHbl()
    {
        var first = _hblContainers.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.CONTAINER_NO));
        if (first is null)
            return;

        _container = first.CONTAINER_NO!.Trim();
        ApplyContainerSizeType(first);
    }

    private async Task LoadContainersForHblAsync(Guid? hblId, string? hblNo)
    {
        if ((hblId is null || hblId == Guid.Empty) && string.IsNullOrWhiteSpace(hblNo))
        {
            _hblId = null;
            _hblContainers = new List<M_Container>();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if ((hblId is null || hblId == Guid.Empty) && !string.IsNullOrWhiteSpace(hblNo))
        {
            var hbl = await db.HBL.AsNoTracking()
                .FirstOrDefaultAsync(x => x.hbl == hblNo.Trim());
            hblId = hbl?.hblID;
        }

        if (hblId is null || hblId == Guid.Empty)
        {
            _hblId = null;
            _hblContainers = new List<M_Container>();
            return;
        }

        _hblId = hblId;
        _hblContainers = await db.Container.AsNoTracking()
            .Where(x => x.hblid == hblId
                        && (x.CONTINUED == null || x.CONTINUED == true)
                        && x.CONTAINER_NO != null
                        && x.CONTAINER_NO != string.Empty)
            .OrderBy(x => x.CONTAINER_NO)
            .ToListAsync();
    }

    private Task<IEnumerable<string>> SearchContainerNoAsync(string value)
    {
        IEnumerable<M_Container> query = _hblContainers.Where(x => !string.IsNullOrWhiteSpace(x.CONTAINER_NO));
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => x.CONTAINER_NO!.Contains(k, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(query
            .Select(x => x.CONTAINER_NO!.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Take(50));
    }

    private Task OnContainerChangedAsync(string? value)
    {
        _container = value?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(_container))
            return Task.CompletedTask;

        var container = _hblContainers.FirstOrDefault(x =>
            string.Equals(x.CONTAINER_NO?.Trim(), _container, StringComparison.OrdinalIgnoreCase));
        if (container is not null)
            ApplyContainerSizeType(container);

        return Task.CompletedTask;
    }

    private void ApplyContainerSizeType(M_Container container)
    {
        if (string.IsNullOrWhiteSpace(container.CTN_SIZE_TYPE))
            return;

        var sizeType = container.CTN_SIZE_TYPE.Trim();
        var digitLength = 0;
        while (digitLength < sizeType.Length && char.IsDigit(sizeType[digitLength]))
            digitLength++;

        if (digitLength > 0 && int.TryParse(sizeType[..digitLength], out var size))
            _contSize = size;
        if (digitLength < sizeType.Length)
            _contType = TrimOrNull(sizeType[digitLength..]);
    }

    private string? GetContainerHelperText()
    {
        if (_hblId is null || _hblId == Guid.Empty)
            return "Chưa chọn HB/L — nhập thủ công số container, size, type";

        return _hblContainers.Count == 0
            ? "HB/L chưa có container — nhập thủ công số container, size, type"
            : $"Có {_hblContainers.Count} container thuộc HB/L — chọn từ danh sách";
    }
}
