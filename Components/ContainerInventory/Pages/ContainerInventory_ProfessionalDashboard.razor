@page "/ContainerInventory"
@page "/container/inventory"

@using System.Data
@using System.Data.Common
@using System.Text
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor
@using ABFreight.Data

@attribute [Authorize]

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>8.3.3 Container Inventory</PageTitle>

<div class="container-inventory-page">
    <MudPaper Class="ci-header pa-4 mb-3" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
            <div>
                <MudText Typo="Typo.h5" Class="ci-title">8.3.3 Container Inventory</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Statistics from all yard/import tables using one common inventory logic: Current In Yard + In/Out Yard + VSS import/export + APS Yard 8.3.6 + SP-ITC Yard 8.3.7 tables.
                </MudText>
                @if (!string.IsNullOrWhiteSpace(_sourceInfo))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data source: @_sourceInfo</MudText>
                }
            </div>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport834Async"
                           Disabled="_busy">
                    8.3.4 Import
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport835Async"
                           Disabled="_busy">
                    8.3.5 Import
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport836Async"
                           Disabled="_busy">
                    8.3.6 Import
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport837Async"
                           Disabled="_busy">
                    8.3.7 SP-ITC
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Refresh
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCsvAsync"
                           Disabled="_busy || !FilteredRecords.Any()">
                    CSV
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintAsync"
                           Disabled="_busy">
                    Print
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-2">
            @_errorMessage
        </MudAlert>
    }

    <MudPaper Class="ci-card pa-3 mb-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_search"
                              Label="Search"
                              Placeholder="Container, BOOK, BL, depot, port, vessel..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_sourceFilter" Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in SourceOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_agentFilter" Label="AGENT" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in AgentOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_lineFilter" Label="LINE" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in LineOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_depotFilter" Label="DEPOT" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in DepotOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_sizeFilter" Label="Size/Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@("20DC")">20DC</MudSelectItem>
                    <MudSelectItem T="string" Value="@("40HC")">40HC / 40HQ</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OTHER")">OTHER</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@StatusInDepot">In Depot</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusWaitingPort">Waiting Port Arrival</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusArrivedPort">Arrived at Port</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusInTransit">In Transit</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1">
                <MudSelect T="string" @bind-Value="_felFilter" Label="Load F/E" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@("E")">E - Empty</MudSelectItem>
                    <MudSelectItem T="string" Value="@("F")">F - Full</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OTHER")">Other / Unknown</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1">
                <MudSelect T="string" @bind-Value="_damageFilter" Label="Damage" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@("D")">D - Damaged</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OK")">OK</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1">
                <MudCheckBox T="bool" @bind-Checked="_excludeDamaged" Label="Hide DAM" Color="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="1">
                <MudNumericField T="int"
                                 @bind-Value="_demFreeDays"
                                 Label="DEM free"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Immediate="true" />
            </MudItem>

            <MudItem xs="12" md="1">
                <MudNumericField T="int"
                                 @bind-Value="_detFreeDays"
                                 Label="DET free"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Immediate="true" />
            </MudItem>

            <MudItem xs="12" md="1">
                <MudNumericField T="int?"
                                 @bind-Value="_minDemDaysFilter"
                                 Label="DEM ≥"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Immediate="true"
                                 Clearable="true" />
            </MudItem>

            <MudItem xs="12" md="1">
                <MudNumericField T="int?"
                                 @bind-Value="_minDetDaysFilter"
                                 Label="DET ≥"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Immediate="true"
                                 Clearable="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-depot pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">In Depot</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@InDepotRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-wait pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Waiting Port Arrival</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@WaitingPortRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.PendingActions" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-port pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Arrived at Port</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@ArrivedPortRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-transit pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">In Transit</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@InTransitRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Warning" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        <b>Inventory logic:</b> E/F/Other is the container load status. D is a separate damage condition and may overlap E or F.
    </MudAlert>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">IN DEPOT</MudText>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@InDepotRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="InDepotGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="330px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherLoadCount" Title="Other Load" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damaged" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">ARRIVED AT PORT</MudText>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">@ArrivedPortRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="ArrivedPortGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="330px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherLoadCount" Title="Other Load" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damaged" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">WAITING PORT ARRIVAL</MudText>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">@WaitingPortRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="WaitingPortGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="300px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherLoadCount" Title="Other Load" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damaged" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">IN TRANSIT</MudText>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">@InTransitRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="InTransitGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="300px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherLoadCount" Title="Other Load" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damaged" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="ci-card pa-3 mt-3" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
            <div>
                <MudText Typo="Typo.subtitle1" Class="ci-section-title">CONTAINER DETAIL</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Rows: @FilteredRecords.Count.ToString("N0") / @_records.Count.ToString("N0")</MudText>
            </div>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">Latest container position, movement, all dates, seal and bill info</MudChip>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@(_showContainerDetailGrid ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                           OnClick="@(() => _showContainerDetailGrid = !_showContainerDetailGrid)">
                    @(_showContainerDetailGrid ? "Hide detail list" : "Show detail list")
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_showContainerDetailGrid)
        {
            <MudDataGrid T="ContainerRecord"
                         Items="FilteredRecords"
                         Dense="true"
                         Hover="true"
                         Bordered="true"
                         Striped="true"
                         Filterable="true"
                         FixedHeader="true"
                         Height="480px"
                         Class="ci-detail-grid ci-click-grid"
                         Loading="_busy"
                         RowClick="OnContainerRowClick"
                         @bind-SelectedItem="_selectedRecord">
                <Columns>
                    <PropertyColumn Property="x => x.DepotDisplay" Title="DEPOT" CellClass="fw-bold ci-pin-col" />
                    <PropertyColumn Property="x => x.ITEM_NO" Title="Container" CellClass="fw-bold ci-pin-col" />
                    <PropertyColumn Property="x => x.YOM" Title="YOM" />
                    <PropertyColumn Property="x => x.MovementDisplay" Title="IN / OUT" />
                    <PropertyColumn Property="x => x.EventTs" Title="Last Event" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.ARR_TS" Title="Gate In / Date In" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.TIME_IN" Title="Time In" />
                    <PropertyColumn Property="x => x.DEP_TS" Title="Gate Out / Date Out" Format="dd/MM/yyyy HH:mm" />
                    <TemplateColumn Title="DEM Days" CellClass="text-end fw-bold" HeaderClass="text-end">
                        <CellTemplate Context="ctx">@CalculateDemGrossDays(ctx.Item).ToString("N0")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="DEM Billable" CellClass="text-end fw-bold" HeaderClass="text-end">
                        <CellTemplate Context="ctx">@CalculateDemBillableDays(ctx.Item).ToString("N0")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="DET Days" CellClass="text-end fw-bold" HeaderClass="text-end">
                        <CellTemplate Context="ctx">@CalculateDetGrossDays(ctx.Item).ToString("N0")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="DET Billable" CellClass="text-end fw-bold" HeaderClass="text-end">
                        <CellTemplate Context="ctx">@CalculateDetBillableDays(ctx.Item).ToString("N0")</CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.INS_DATE" Title="INS Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.CC_TS" Title="Customs Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.CLEAN_METHOD" Title="Clean Method" />
                    <PropertyColumn Property="x => x.CLEAN_STATUS" Title="Clean Status" />
                    <PropertyColumn Property="x => x.PTI_DATE" Title="PTI Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.PTI_SETTING" Title="PTI Setting" />
                    <PropertyColumn Property="x => x.PTI_STATUS" Title="PTI Status" />
                    <PropertyColumn Property="x => x.ESTIMATED_DATE" Title="Estimated Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.APPROVAL_DATE" Title="Approval Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.REJECT_DATE" Title="Reject Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.REPAIRED_DATE" Title="Repaired Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.REGISTERED_DATE" Title="Registered Date" Format="dd/MM/yyyy HH:mm" />
                    <PropertyColumn Property="x => x.SHIPPER" Title="Shipper" />
                    <PropertyColumn Property="x => x.CurrentLocationDisplay" Title="Current Location" />
                    <PropertyColumn Property="x => x.Status" Title="Current Status" />
                    <PropertyColumn Property="x => x.DamageDisplay" Title="Damage" />
                    <PropertyColumn Property="x => x.ISO" Title="ISO / Size" />
                    <PropertyColumn Property="x => x.SizeType" Title="Size Group" />
                    <PropertyColumn Property="x => x.LoadStatusDisplay" Title="Load F/E" />
                    <PropertyColumn Property="x => x.DamageStatusDisplay" Title="Damage Status" />
                    <PropertyColumn Property="x => x.FEL" Title="Raw FEL" />
                    <PropertyColumn Property="x => x.WEIGHT" Title="WEIGHT" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                    <PropertyColumn Property="x => x.VGM_WEIGHT" Title="VGM" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                    <PropertyColumn Property="x => x.BOOK_NO" Title="Bill / Booking" />
