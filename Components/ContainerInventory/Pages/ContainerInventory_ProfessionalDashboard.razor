        public string CLEAN_METHOD { get; set; } = string.Empty;
        public string CLEAN_STATUS { get; set; } = string.Empty;
        public DateTime? PTI_DATE { get; set; }
        public string PTI_SETTING { get; set; } = string.Empty;
        public string PTI_STATUS { get; set; } = string.Empty;
