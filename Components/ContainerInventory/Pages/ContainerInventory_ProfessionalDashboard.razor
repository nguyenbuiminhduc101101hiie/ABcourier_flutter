        public string SizeType { get; set; } = "OTHER";
        public string Status { get; set; } = StatusInDepot;
        public string StatusReason { get; set; } = string.Empty;

        public string DepotDisplay => FirstNonEmpty(DEPOT, LOCATION, DISCH_PORT, FINAL_DISCH_PORT, PLACE_OF_DELIVERY, "N/A");
        public string CurrentLocationDisplay => FirstNonEmpty(LOCATION, DEPOT, DISCH_PORT, FINAL_DISCH_PORT, PLACE_OF_RECEIPT, PLACE_OF_DELIVERY, "N/A");
        public string MovementDisplay
        {
            get
            {
                var text = FirstNonEmpty(EventMethod, CATEGORY, ARR_BY, DEP_BY);
                if (LooksLikeOutMovement(text) || IsValidDate(DEP_TS))
                    return "OUT / Export";
                if (LooksLikeInMovement(text) || IsValidDate(ARR_TS))
                    return "IN / Import";
                return string.IsNullOrWhiteSpace(text) ? "N/A" : text.Trim();
            }
        }
        public string LoadStatusDisplay => IsEmptyFel(this) ? "E" : IsFullFel(this) ? "F" : "Other";
        public string DamageStatusDisplay => IsDamaged(this) ? "D" : "OK";
        public string DamageDisplay => IsDamaged(this) ? FirstNonEmpty(DAM, GHICHU, FEL, "Damage / Check") : "OK";
        public string ContainerKey => !string.IsNullOrWhiteSpace(ITEM_NO) ? ITEM_NO.Trim() : !string.IsNullOrWhiteSpace(ITEM_KEY) ? ITEM_KEY.Trim() : Id?.ToString() ?? string.Empty;
        public DateTime? EventDate => FirstNonEmptyDate(EventTs, DEP_TS, ARR_TS, INS_DATE, REPORT_DATE, REPORT_TO, REPORT_FROM, DateImport, CreatedAt);
    }

