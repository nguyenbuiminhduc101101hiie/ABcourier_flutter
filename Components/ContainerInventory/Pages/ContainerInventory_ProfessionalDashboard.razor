    private async Task LoadAsync()
    {
        try
        {
            _busy = true;
            _errorMessage = string.Empty;
            _sourceInfo = string.Empty;
            _loadedSources.Clear();

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();

            if (conn.State != ConnectionState.Open)
                await conn.OpenAsync();

            var sources = await FindInventorySourceTablesAsync(conn);
            _loadedSources = sources;

            if (sources.Count == 0)
            {
                _records.Clear();
                _errorMessage = "No compatible inventory/import tables were found. Required shape: Current table has ITEM_NO + ISO + DateImport, In/Out table has SOCONT + KICHCO + DateImport, or APS Yard table has CONTAINER + ISO_SZTP/ISO_TYPE + DATE_IMPORT/DATE_IN.";
                return;
            }

            var raw = new List<ContainerRecord>();

            foreach (var source in sources)
            {
                var dbColumns = await LoadColumnNamesAsync(conn, source.SchemaName, source.TableName);
                var selectedColumns = SourceColumns.Where(x => dbColumns.Contains(x)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

                if (selectedColumns.Count == 0)
                    continue;

                raw.AddRange(await LoadSourceRowsAsync(conn, source, selectedColumns));
            }

            _allEventRows = raw
                .Where(x => !string.IsNullOrWhiteSpace(x.ContainerKey))
                .ToList();

            _selectedRecord = null;
            _selectedDuplicateRows.Clear();

            _records = _allEventRows
                .Where(x => !string.IsNullOrWhiteSpace(x.ContainerKey))
                .GroupBy(x => x.ContainerKey, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var allRows = g.OrderByDescending(x => x.EventDate ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.DateImport ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.CreatedAt ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.ARR_TS ?? DateTime.MinValue)
                                   .ToList();

                    var latest = allRows.First();

                    latest.DuplicateCount = allRows.Count;
                    latest.DuplicateSourceTables = string.Join(", ",
                        allRows.Select(x => x.SourceTable)
                               .Where(x => !string.IsNullOrWhiteSpace(x))
                               .Distinct(StringComparer.OrdinalIgnoreCase));

                    latest.DuplicateEventHistory = string.Join(" | ",
                        allRows.Take(6).Select(x =>
                            $"{FormatDateTime(x.EventDate)} - {x.SourceTable} - {FirstNonEmpty(x.EventMethod, x.Status, x.FEL, x.CATEGORY)}"));

                    return latest;
                })
                .OrderBy(x => x.DepotDisplay)
                .ThenBy(x => x.LINE)
                .ThenBy(x => x.ITEM_NO)
                .ToList();

            foreach (var item in _records)
            {
                var statusInfo = ResolveStatusInfo(item);
                item.Status = statusInfo.Status;
                item.StatusReason = statusInfo.Reason;
            }

            _sourceInfo = $"{sources.Count:N0} table(s): {string.Join(", ", sources.Select(x => x.TableName))}";
            Snackbar.Add($"Loaded {_records.Count:N0} distinct containers from {_sourceInfo}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            var root = ex;

            while (root.InnerException is not null)
                root = root.InnerException;

            _errorMessage = root.Message;
            Snackbar.Add(root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<List<TableSource>> FindInventorySourceTablesAsync(DbConnection conn)
    {
        var result = new List<TableSource>();

        foreach (var tableName in PreferredSourceTables)
        {
            var source = await FindSpecificSourceTableAsync(conn, tableName);

            if (source is not null && !result.Any(x => x.SchemaName == source.SchemaName && x.TableName == source.TableName))
                result.Add(source);
        }

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT s.name AS SchemaName, t.name AS TableName
FROM sys.tables t
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE
(
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'ITEM_NO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'ISO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'DateImport'))
    OR
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'SOCONT')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'KICHCO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'DateImport'))
    OR
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'CONTAINER')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name IN (N'ISO_SZTP', N'ISO_TYPE', N'CONTAINER_TYPE'))
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name IN (N'DATE_IMPORT', N'DATE_IN', N'CREATED_AT')))
    OR
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'ContrNo')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name IN (N'ContainerType', N'Size'))
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name IN (N'DateIn', N'DateOut', N'CreatedAt')))
)
AND
(
       t.name LIKE N'%Yard%'
    OR t.name LIKE N'%YARD%'
    OR t.name LIKE N'%IN_OUT%'
    OR t.name LIKE N'%VSS%'
    OR t.name LIKE N'%Inventory%'
    OR t.name LIKE N'%Container%'
    OR t.name LIKE N'%Stock%'
    OR t.name LIKE N'%Depot%'
)
ORDER BY
  CASE
    WHEN t.name = N'M_YardMovement_AMS_26040816_Current_In_Yard2' THEN 0
    WHEN t.name = N'M_8_3_IN_OUT_YARD_1' THEN 1
    WHEN t.name = N'M_8_3_VSS_IN_OUT_YARD_Exp' THEN 2
    WHEN t.name = N'M_8_3_VSS_IN_OUT_YARD_Imp' THEN 3
    WHEN t.name = N'M_8_3_6_YARD_APS_STOCK' THEN 4
    WHEN t.name = N'M_8_3_6_YARD_APS_GATEIN' THEN 5
    WHEN t.name = N'M_8_3_6_YARD_APS_GATEOUT' THEN 6
    WHEN t.name = N'M_8_3_7_YARD_SP_ITC' THEN 7
    WHEN t.name LIKE N'%Current%In%Yard%' THEN 8
    WHEN t.name LIKE N'%IN_OUT%' THEN 7
    WHEN t.name LIKE N'%YARD%' THEN 8
    ELSE 9
  END,
  t.name;";

        await using var reader = await cmd.ExecuteReaderAsync();
        var candidates = new List<TableRef>();

        while (await reader.ReadAsync())
            candidates.Add(new TableRef(reader.GetString(0), reader.GetString(1)));

        await reader.CloseAsync();

        foreach (var c in candidates)
        {
            if (result.Any(x => x.SchemaName == c.SchemaName && x.TableName == c.TableName))
                continue;

            var source = await BuildSourceIfCompatibleAsync(conn, c.SchemaName, c.TableName);

            if (source is not null)
                result.Add(source);
        }

        return result;
    }

    private async Task<TableSource?> FindSpecificSourceTableAsync(DbConnection conn, string tableName)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT TOP 1 s.name AS SchemaName, t.name AS TableName
FROM sys.tables t
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE t.name = @TableName
ORDER BY s.name, t.name;";
        AddParameter(cmd, "@TableName", tableName);

        await using var reader = await cmd.ExecuteReaderAsync();

        if (!await reader.ReadAsync())
            return null;

        var schema = reader.GetString(0);
        var table = reader.GetString(1);
        await reader.CloseAsync();

        return await BuildSourceIfCompatibleAsync(conn, schema, table);
    }

    private async Task<TableSource?> BuildSourceIfCompatibleAsync(DbConnection conn, string schemaName, string tableName)
    {
        var columns = await LoadColumnNamesAsync(conn, schemaName, tableName);

        if (columns.Contains("ITEM_NO") && columns.Contains("ISO") && columns.Contains("DateImport"))
            return new TableSource(schemaName, tableName, "CurrentInYard");

        if (columns.Contains("SOCONT") && columns.Contains("KICHCO") && columns.Contains("DateImport"))
            return new TableSource(schemaName, tableName, "InOutYard");

        // 8.3.6 APS Yard container-level tables.
        // GENERAL and GENERAL_STATUS are summary tables and do not contain container numbers, so they are excluded here.
        if (columns.Contains("CONTAINER") &&
            (columns.Contains("ISO_SZTP") || columns.Contains("ISO_TYPE") || columns.Contains("CONTAINER_TYPE")) &&
            (columns.Contains("DATE_IMPORT") || columns.Contains("DATE_IN") || columns.Contains("CREATED_AT")))
        {
            if (tableName.Contains("GATEOUT", StringComparison.OrdinalIgnoreCase))
                return new TableSource(schemaName, tableName, "ApsYardGateOut");

            if (tableName.Contains("GATEIN", StringComparison.OrdinalIgnoreCase))
                return new TableSource(schemaName, tableName, "ApsYardGateIn");

            if (tableName.Contains("STOCK", StringComparison.OrdinalIgnoreCase))
                return new TableSource(schemaName, tableName, "ApsYardStock");

            return new TableSource(schemaName, tableName, "ApsYard");
        }

        // 8.3.7 SP-ITC Yard table created from JNL-SP-ITC Excel.
        if (columns.Contains("ContrNo") &&
            (columns.Contains("ContainerType") || columns.Contains("Size")) &&
            (columns.Contains("DateIn") || columns.Contains("DateOut") || columns.Contains("CreatedAt")))
            return new TableSource(schemaName, tableName, "SpItcYard837");

        return null;
    }

    private async Task<HashSet<string>> LoadColumnNamesAsync(DbConnection conn, string schemaName, string tableName)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT c.name
FROM sys.columns c
INNER JOIN sys.tables t ON t.object_id = c.object_id
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE s.name = @SchemaName AND t.name = @TableName;";
        AddParameter(cmd, "@SchemaName", schemaName);
        AddParameter(cmd, "@TableName", tableName);

        await using var reader = await cmd.ExecuteReaderAsync();

        while (await reader.ReadAsync())
            result.Add(reader.GetString(0));

        return result;
    }

    private async Task<List<ContainerRecord>> LoadSourceRowsAsync(DbConnection conn, TableSource source, List<string> selectedColumns)
    {
        var result = new List<ContainerRecord>();
        var selectList = string.Join(", ", selectedColumns.Select(QuoteName));

        var orderColumns = new[] { "DateImport", "DATE_IMPORT", "CreatedAt", "CREATED_AT", "EXEC_TS", "ARR_TS", "DEP_TS", "DATE_OUT", "DATE_IN" }
            .Where(c => selectedColumns.Contains(c, StringComparer.OrdinalIgnoreCase))
            .Select(QuoteName)
            .ToList();

        // SQL Server will throw "Incorrect syntax near ')'" when COALESCE has only one argument,
        // for example: ORDER BY COALESCE([DateImport]) DESC.
        var orderBy = orderColumns.Count switch
        {
            0 => "(SELECT NULL)",
            1 => $"{orderColumns[0]} DESC",
            _ => $"COALESCE({string.Join(", ", orderColumns)}) DESC"
        };

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = $@"
SELECT TOP (100000) {selectList}
FROM {QuoteName(source.SchemaName)}.{QuoteName(source.TableName)} WITH (NOLOCK)
ORDER BY {orderBy};";
        cmd.CommandTimeout = 180;

        await using var reader = await cmd.ExecuteReaderAsync();
        var ordinals = Enumerable.Range(0, reader.FieldCount)
            .ToDictionary(reader.GetName, i => i, StringComparer.OrdinalIgnoreCase);

        while (await reader.ReadAsync())
        {
            var isApsYard = source.SourceType.StartsWith("ApsYard", StringComparison.OrdinalIgnoreCase);
            var isInOut = source.SourceType == "InOutYard" || isApsYard;

            var method = FirstNonEmpty(
                GetString(reader, ordinals, "METHOD"),
                GetString(reader, ordinals, "OPERATION_METHOD"),
                GetString(reader, ordinals, "MOVE"),
                source.SourceType);

            var execTs = FirstNonEmptyDate(
                GetDateTime(reader, ordinals, "EXEC_TS"),
                GetDateTime(reader, ordinals, "DATE_OUT"),
                GetDateTime(reader, ordinals, "DATE_IN"));

            var looksOut = source.SourceType == "ApsYardGateOut" || LooksLikeOutMovement(method);
            var looksIn = source.SourceType == "ApsYardGateIn" || source.SourceType == "ApsYardStock" || LooksLikeInMovement(method);

            var arrTs = FirstNonEmptyDate(
                GetDateTime(reader, ordinals, "ARR_TS"),
                GetDateTime(reader, ordinals, "DATE_IN"));

            var depTs = FirstNonEmptyDate(
                GetDateTime(reader, ordinals, "DEP_TS"),
                GetDateTime(reader, ordinals, "DATE_OUT"));

            if (isInOut && arrTs is null && looksIn)
                arrTs = execTs;

            if (isInOut && depTs is null && looksOut)
                depTs = execTs;

            var note = FirstNonEmpty(
                GetString(reader, ordinals, "GHICHU"),
                GetString(reader, ordinals, "REMARK"),
                GetString(reader, ordinals, "NOTE"),
                GetString(reader, ordinals, "NOTE1"),
                GetString(reader, ordinals, "NOTE2"),
                GetString(reader, ordinals, "NOTE3"));

            var row = new ContainerRecord
            {
                Id = FirstNonEmptyGuid(
                    GetGuid(reader, ordinals, "Id"),
                    GetGuid(reader, ordinals, "ID")),

                SourceTable = source.TableName,
                SourceType = source.SourceType,
                EventMethod = method,
                EventTs = FirstNonEmptyDate(execTs, arrTs, depTs, GetDateTime(reader, ordinals, "DateIn"), GetDateTime(reader, ordinals, "DateOut"), GetDateTime(reader, ordinals, "DateImport"), GetDateTime(reader, ordinals, "DATE_IMPORT"), GetDateTime(reader, ordinals, "CreatedAt"), GetDateTime(reader, ordinals, "CREATED_AT")),

                AGENT = FirstNonEmpty(
                    GetString(reader, ordinals, "AGENT"),
                    GetString(reader, ordinals, "OPR"),
                    GetString(reader, ordinals, "OPT")),

                LINE = FirstNonEmpty(
                    GetString(reader, ordinals, "LINE"),
                    GetString(reader, ordinals, "OPR"),
                    GetString(reader, ordinals, "OPT")),

                DEPOT = FirstNonEmpty(
                    GetString(reader, ordinals, "DEPOT"),
                    GetString(reader, ordinals, "Depot")),
                REPORT_FROM = GetDateTime(reader, ordinals, "REPORT_FROM"),
                REPORT_TO = GetDateTime(reader, ordinals, "REPORT_TO"),
                REPORT_DATE = GetDateTime(reader, ordinals, "REPORT_DATE"),
                INS_DATE = GetDateTime(reader, ordinals, "INS_DATE"),
                TIME_IN = GetString(reader, ordinals, "TIME_IN"),
                CLEAN_METHOD = FirstNonEmpty(
                    GetString(reader, ordinals, "CLEAN_METHOD"),
                    GetString(reader, ordinals, "CLEAN")),
                CLEAN_STATUS = GetString(reader, ordinals, "CLEAN_STATUS"),
                PTI_DATE = GetDateTime(reader, ordinals, "PTI_DATE"),
                PTI_SETTING = GetString(reader, ordinals, "PTI_SETTING"),
                PTI_STATUS = GetString(reader, ordinals, "PTI_STATUS"),
                ESTIMATED_DATE = GetDateTime(reader, ordinals, "ESTIMATED_DATE"),
                APPROVAL_DATE = GetDateTime(reader, ordinals, "APPROVAL_DATE"),
                REJECT_DATE = GetDateTime(reader, ordinals, "REJECT_DATE"),
                REPAIRED_DATE = GetDateTime(reader, ordinals, "REPAIRED_DATE"),
                REGISTERED_DATE = GetDateTime(reader, ordinals, "REGISTERED_DATE"),
                SHIPPER = GetString(reader, ordinals, "SHIPPER"),

                ITEM_KEY = GetString(reader, ordinals, "ITEM_KEY"),

                ITEM_NO = FirstNonEmpty(
                    GetString(reader, ordinals, "ITEM_NO"),
                    GetString(reader, ordinals, "SOCONT"),
                    GetString(reader, ordinals, "CONTAINER"),
                    GetString(reader, ordinals, "ContrNo")),

                ISO = FirstNonEmpty(
                    GetString(reader, ordinals, "ISO"),
                    GetString(reader, ordinals, "KICHCO"),
                    GetString(reader, ordinals, "ISO_SZTP"),
                    GetString(reader, ordinals, "ISO_TYPE"),
                    GetString(reader, ordinals, "CONTAINER_TYPE"),
                    GetString(reader, ordinals, "ContainerType"),
                    GetString(reader, ordinals, "Size")),

                YOM = GetString(reader, ordinals, "YOM"),

                FEL = FirstNonEmpty(
                    GetString(reader, ordinals, "FEL"),
                    GetString(reader, ordinals, "TRANGTHAI"),
                    GetString(reader, ordinals, "FE"),
