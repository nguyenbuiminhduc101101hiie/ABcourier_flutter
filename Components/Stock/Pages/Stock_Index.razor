                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Container</MudText><MudText Typo="Typo.body2">@_containerTracking.Container</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Type</MudText><MudText Typo="Typo.body2">@(_containerTracking.Type ?? string.Empty)</MudText></MudItem>
