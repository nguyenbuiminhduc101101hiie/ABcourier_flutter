        => _ymSelectedAmsExp != null && _ymSelectedAmsExp.Id == row.Id ? "selected" : string.Empty;

    private bool YmContainFilter(string? value)
        => string.IsNullOrWhiteSpace(_ymFilterContainer)
        || (!string.IsNullOrWhiteSpace(value) && value.Contains(_ymFilterContainer, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<M_StockGateOut_HDS_08042026> GetFilteredYmHdsItems()
        => _ymHdsItems.Where(x => YmContainFilter(x.SoCont));
    private IEnumerable<M_8_3_Arrived> GetFilteredYmAgArrivedItems()
        => _ymAgArrivedItems.Where(x => YmContainFilter(x.CNTRNO));
    private IEnumerable<M_8_3_Exited> GetFilteredYmAgExitedItems()
        => _ymAgExitedItems.Where(x => YmContainFilter(x.CNTRNO));
    private IEnumerable<M_8_3_Unstuffed> GetFilteredYmAgUnstuffedItems()
        => _ymAgUnstuffedItems.Where(x => YmContainFilter(x.CNTRNO));
    private IEnumerable<M_8_3_Stuffed> GetFilteredYmAgStuffedItems()
        => _ymAgStuffedItems.Where(x => YmContainFilter(x.CNTRNO));
    private IEnumerable<M_8_3_VSS_IN_OUT_YARD_Imp> GetFilteredYmVssImpItems()
        => _ymVssImpItems.Where(x => YmContainFilter(x.SOCONT));
    private IEnumerable<M_8_3_VSS_IN_OUT_YARD_Exp> GetFilteredYmVssExpItems()
        => _ymVssExpItems.Where(x => YmContainFilter(x.SOCONT));
    private IEnumerable<M_8_3_IN_OUT_YARD_1> GetFilteredYmAmsImpItems()
        => _ymAmsImpItems.Where(x => YmContainFilter(x.SOCONT));
    private IEnumerable<M_YardMovement_AMS_26040816_Current_In_Yard2> GetFilteredYmAmsExpItems()
        => _ymAmsExpItems.Where(x => YmContainFilter(x.ITEM_NO));

    private async Task DeleteSelectedAsync()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "Delete", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to Delete"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected is null)
        {
            Snackbar.Add("Chọn một dòng để xóa.", MudBlazor.Severity.Warning);
            return;
        }

        var label = string.IsNullOrWhiteSpace(_selected.Container) ? _selected.StockID.ToString() : _selected.Container;
        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận xóa",
            $"Xóa bản ghi container \"{label}\"? Thao tác không hoàn tác.",
            yesText: "Xóa",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        _loading = true;
        try
        {
            var (ok, err) = await StockSvc.DeleteAsync(_selected.StockID);
            if (!ok)
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(err) ? "Xóa thất bại" : err, MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add("Đã xóa.", MudBlazor.Severity.Success);
            _selected = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Xóa lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnImportExcel(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0)
            return;

        var authState = await asv.GetAuth();
        var importUser = authState.User?.Identity?.Name;
        if (string.IsNullOrEmpty(importUser) || !await ssv.CheckPermission(importUser, "Add", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to Add"], MudBlazor.Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var userLogin = importUser;

            var result = await StockSvc.ImportFromExcelAsync(ms, userLogin);
            if (result.ErrorMessage != null)
            {
                Snackbar.Add("Import lỗi: " + result.ErrorMessage, MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add(
                $"Import xong: thêm {result.Inserted} dòng; bỏ qua trùng {result.SkippedDuplicate}; dòng trống (không số container) {result.SkippedEmpty}; đã gateout nên bỏ qua {result.SkippedGateOut}.",
                result.Inserted > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Info);

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Import lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatTime(TimeSpan? t) =>
        t.HasValue ? string.Format("{0:hh\\:mm}", t.Value) : string.Empty;

    private static string FormatDateTime(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty;

    private static string ToVnTimeText(DateTime? dt)
    {
        if (!dt.HasValue)
            return string.Empty;

        var utc = DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc);
        var vnTimeZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
        var vnTime = TimeZoneInfo.ConvertTimeFromUtc(utc, vnTimeZone);
        return vnTime.ToString("dd/MM/yyyy HH:mm");
    }

    private async Task LoadContainerTrackingAsync()
    {
        _containerTracking = null;
        if (string.IsNullOrWhiteSpace(_filterContainer))
            return;

        _containerTracking = await StockSvc.GetContainerTrackingAsync(_filterContainer);
    }

