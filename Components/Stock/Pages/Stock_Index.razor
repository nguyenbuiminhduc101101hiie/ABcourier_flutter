        <MudTextField @bind-Value="_ymFilterContainer" Label="Search Cont" Placeholder="SoCont / CNTRNO / SOCONT" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="mr-2" />
        @if (GetCurrentYmTab() == ExcelCrudTab.AMS)
        {
            <MudTextField @bind-Value="_ymAmsLineFilter" Label="LINE (chỉ Import)" Placeholder="Bỏ trống = import tất cả" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true" Class="mr-2" />
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshYmCurrentTabAsync" Disabled="_ymLoading || !_ymCanView">@Localizer["reload"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="YmAddCurrentAsync" Disabled="_ymLoading || !_ymCanAdd">@Localizer["new"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="YmEditCurrentAsync" Disabled="_ymLoading || !_ymCanEdit">@Localizer["edit"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="YmDeleteCurrentAsync" Disabled="_ymLoading || !_ymCanDelete">@Localizer["delete"]</MudButton>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_ymLoading || !_ymCanAdd">
            @Localizer["Ym_ImportExcel"]
            <InputFile OnChange="YmImportCurrentAsync" accept=".xlsx,.xls" style="display:none" />
        </MudButton>
    </MudPaper>;

    private async Task LoadYmPermissionAsync()
    {
        var authState = await asv.GetAuth();
        var username = authState.User?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(username))
            return;

        _ymCanView = await ssv.CheckPermission(username, "View", "Stock");
        _ymCanAdd = await ssv.CheckPermission(username, "Add", "Stock");
        _ymCanEdit = await ssv.CheckPermission(username, "Edit", "Stock");
        _ymCanDelete = await ssv.CheckPermission(username, "Delete", "Stock");
    }

    private async Task RefreshYmCurrentTabAsync()
    {
        if (!_ymCanView || !IsYmTabActive())
            return;
        _ymLoading = true;
        try
        {
            switch (GetCurrentYmTab())
            {
                case ExcelCrudTab.HDS: _ymHdsItems = await ExcelImportSvc.GetHdsAsync(); break;
                case ExcelCrudTab.AG:
                    _ymAgArrivedItems = await ExcelImportSvc.GetAgArrivedAsync();
                    _ymAgExitedItems = await ExcelImportSvc.GetAgExitedAsync();
                    _ymAgUnstuffedItems = await ExcelImportSvc.GetAgUnstuffedAsync();
                    _ymAgStuffedItems = await ExcelImportSvc.GetAgStuffedAsync();
                    break;
                case ExcelCrudTab.VSS:
                    _ymVssImpItems = await ExcelImportSvc.GetVssImpAsync();
                    _ymVssExpItems = await ExcelImportSvc.GetVssExpAsync();
                    break;
                case ExcelCrudTab.AMS:
                    _ymAmsImpItems = await ExcelImportSvc.GetAmsImpAsync();
                    _ymAmsExpItems = await ExcelImportSvc.GetAmsExpAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_LoadError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _ymLoading = false;
        }
    }

    private async Task YmImportCurrentAsync(InputFileChangeEventArgs e)
    {
        if (!_ymCanAdd || e.FileCount == 0 || !IsYmTabActive())
            return;
        _ymLoading = true;
        try
        {
            var authState = await asv.GetAuth();
            var importUser = authState.User?.Identity?.Name;
            await using var stream = e.File.OpenReadStream(50 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var currentTab = GetCurrentYmTab();
            var amsLineFilter = currentTab == ExcelCrudTab.AMS && !string.IsNullOrWhiteSpace(_ymAmsLineFilter)
                ? _ymAmsLineFilter.Trim()
                : null;
            var result = await ExcelImportSvc.ImportAsync(currentTab, ms, importUser, amsLineFilter: amsLineFilter);
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                Snackbar.Add(Localizer["Ym_ImportError", result.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }
            Snackbar.Add(Localizer["Ym_ImportSuccess", result.Inserted], MudBlazor.Severity.Success);
            await RefreshYmCurrentTabAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_ImportError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _ymLoading = false;
        }
    }

    private async Task YmAddCurrentAsync()
    {
        if (!_ymCanAdd || !IsYmTabActive())
            return;
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS: await YmOpenDialogAndSaveAsync(new M_StockGateOut_HDS_08042026 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow }); break;
            case ExcelCrudTab.AG:
                if (_ymAgActiveSubTab == 0)
                    await YmOpenDialogAndSaveAsync(new M_8_3_Arrived { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else if (_ymAgActiveSubTab == 1)
                    await YmOpenDialogAndSaveAsync(new M_8_3_Exited { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else if (_ymAgActiveSubTab == 2)
                    await YmOpenDialogAndSaveAsync(new M_8_3_Unstuffed { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else
                    await YmOpenDialogAndSaveAsync(new M_8_3_Stuffed { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.VSS:
                if (_ymVssActiveSubTab == 0)
                    await YmOpenDialogAndSaveAsync(new M_8_3_VSS_IN_OUT_YARD_Imp { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                else
                    await YmOpenDialogAndSaveAsync(new M_8_3_VSS_IN_OUT_YARD_Exp { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.AMS:
                if (_ymAmsActiveSubTab == 0)
                    await YmOpenDialogAndSaveAsync(new M_8_3_IN_OUT_YARD_1 { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                else
                    await YmOpenDialogAndSaveAsync(new M_YardMovement_AMS_26040816_Current_In_Yard2 { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                break;
        }
    }

    private async Task YmEditCurrentAsync()
    {
        if (!_ymCanEdit || !IsYmTabActive())
            return;
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS when _ymSelectedHds != null: await YmOpenDialogAndSaveAsync(_ymSelectedHds); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 0 && _ymSelectedAgArrived != null: await YmOpenDialogAndSaveAsync(_ymSelectedAgArrived); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 1 && _ymSelectedAgExited != null: await YmOpenDialogAndSaveAsync(_ymSelectedAgExited); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 2 && _ymSelectedAgUnstuffed != null: await YmOpenDialogAndSaveAsync(_ymSelectedAgUnstuffed); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 3 && _ymSelectedAgStuffed != null: await YmOpenDialogAndSaveAsync(_ymSelectedAgStuffed); break;
            case ExcelCrudTab.VSS when _ymVssActiveSubTab == 0 && _ymSelectedVssImp != null: await YmOpenDialogAndSaveAsync(_ymSelectedVssImp); break;
            case ExcelCrudTab.VSS when _ymVssActiveSubTab == 1 && _ymSelectedVssExp != null: await YmOpenDialogAndSaveAsync(_ymSelectedVssExp); break;
            case ExcelCrudTab.AMS when _ymAmsActiveSubTab == 0 && _ymSelectedAmsImp != null: await YmOpenDialogAndSaveAsync(_ymSelectedAmsImp); break;
            case ExcelCrudTab.AMS when _ymAmsActiveSubTab == 1 && _ymSelectedAmsExp != null: await YmOpenDialogAndSaveAsync(_ymSelectedAmsExp); break;
            default: Snackbar.Add(Localizer["Ym_SelectOneRowToEdit"], MudBlazor.Severity.Warning); break;
        }
    }

    private async Task YmDeleteCurrentAsync()
    {
        if (!_ymCanDelete || !IsYmTabActive())
            return;
        var confirm = await DialogService.ShowMessageBox(Localizer["Ym_Warning"], Localizer["Ym_DeleteConfirm"], yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;
        (bool Ok, string? Error) result = (false, Localizer["Ym_NoRowSelected"].Value);
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS when _ymSelectedHds != null: result = await ExcelImportSvc.DeleteAsync<M_StockGateOut_HDS_08042026>(_ymSelectedHds.Id); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 0 && _ymSelectedAgArrived != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_Arrived>(_ymSelectedAgArrived.Id); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 1 && _ymSelectedAgExited != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_Exited>(_ymSelectedAgExited.Id); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 2 && _ymSelectedAgUnstuffed != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_Unstuffed>(_ymSelectedAgUnstuffed.Id); break;
            case ExcelCrudTab.AG when _ymAgActiveSubTab == 3 && _ymSelectedAgStuffed != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_Stuffed>(_ymSelectedAgStuffed.Id); break;
            case ExcelCrudTab.VSS when _ymVssActiveSubTab == 0 && _ymSelectedVssImp != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_VSS_IN_OUT_YARD_Imp>(_ymSelectedVssImp.Id); break;
            case ExcelCrudTab.VSS when _ymVssActiveSubTab == 1 && _ymSelectedVssExp != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_VSS_IN_OUT_YARD_Exp>(_ymSelectedVssExp.Id); break;
            case ExcelCrudTab.AMS when _ymAmsActiveSubTab == 0 && _ymSelectedAmsImp != null: result = await ExcelImportSvc.DeleteAsync<M_8_3_IN_OUT_YARD_1>(_ymSelectedAmsImp.Id); break;
            case ExcelCrudTab.AMS when _ymAmsActiveSubTab == 1 && _ymSelectedAmsExp != null: result = await ExcelImportSvc.DeleteAsync<M_YardMovement_AMS_26040816_Current_In_Yard2>(_ymSelectedAmsExp.Id); break;
        }
        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? Localizer["Ym_DeleteFailed"].Value, MudBlazor.Severity.Error);
            return;
        }
        Snackbar.Add(Localizer["Ym_Deleted"], MudBlazor.Severity.Success);
        await RefreshYmCurrentTabAsync();
    }

    private async Task YmOpenDialogAndSaveAsync<T>(T model) where T : class, IExcelImportEntity
    {
        var dialog = DialogService.Show<Components.ExcelImport.Pages.ExcelImport_RowDialog>(Localizer["Ym_EditDialogTitle"], new DialogParameters { ["Model"] = model }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not T data)
            return;
        var saveResult = await ExcelImportSvc.UpsertAsync(data);
        if (!saveResult.Ok)
        {
            Snackbar.Add(saveResult.Error ?? Localizer["Ym_SaveFailed"].Value, MudBlazor.Severity.Error);
            return;
        }
        Snackbar.Add(Localizer["Ym_Saved"], MudBlazor.Severity.Success);
        await RefreshYmCurrentTabAsync();
    }

    private void OnYmHdsRowClick(DataGridRowClickEventArgs<M_StockGateOut_HDS_08042026> args) => _ymSelectedHds = args.Item;
    private void OnYmAgArrivedRowClick(DataGridRowClickEventArgs<M_8_3_Arrived> args) => _ymSelectedAgArrived = args.Item;
    private void OnYmAgExitedRowClick(DataGridRowClickEventArgs<M_8_3_Exited> args) => _ymSelectedAgExited = args.Item;
    private void OnYmAgUnstuffedRowClick(DataGridRowClickEventArgs<M_8_3_Unstuffed> args) => _ymSelectedAgUnstuffed = args.Item;
    private void OnYmAgStuffedRowClick(DataGridRowClickEventArgs<M_8_3_Stuffed> args) => _ymSelectedAgStuffed = args.Item;
    private void OnYmVssImpRowClick(DataGridRowClickEventArgs<M_8_3_VSS_IN_OUT_YARD_Imp> args) => _ymSelectedVssImp = args.Item;
    private void OnYmVssExpRowClick(DataGridRowClickEventArgs<M_8_3_VSS_IN_OUT_YARD_Exp> args) => _ymSelectedVssExp = args.Item;
    private void OnYmAmsImpRowClick(DataGridRowClickEventArgs<M_8_3_IN_OUT_YARD_1> args) => _ymSelectedAmsImp = args.Item;
    private void OnYmAmsExpRowClick(DataGridRowClickEventArgs<M_YardMovement_AMS_26040816_Current_In_Yard2> args) => _ymSelectedAmsExp = args.Item;
    private bool IsYmTabActive()
    {
        if (IsDepotUi)
            return false;
        if (IsPortUi)
            return true;
        return _ymActiveTab > 0;
    }

    private ExcelCrudTab GetCurrentYmTab()
    {
        if (IsPortUi)
            return (ExcelCrudTab)Math.Clamp(_ymActiveTab, 0, 3);
        return (ExcelCrudTab)(_ymActiveTab - 1);
    }
}
