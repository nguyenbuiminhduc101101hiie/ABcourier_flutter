                        <PropertyColumn Property="x => x.Opr" Title="Opr" />
                        <PropertyColumn Property="x => x.FE" Title="F/E" />
                        <PropertyColumn Property="x => x.Move" Title="Move" />
                        <TemplateColumn Title="Date in"><CellTemplate>@context.Item.DateIn?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Time"><CellTemplate>@FormatTime(context.Item.TimeIn)</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.Consignee" Title="Consignee" />
                        <PropertyColumn Property="x => x.Position" Title="Position" />
                        <PropertyColumn Property="x => x.Days" Title="Days" />
                        <PropertyColumn Property="x => x.Location" Title="Location" />
                        <PropertyColumn Property="x => x.YOM" Title="YOM" />
