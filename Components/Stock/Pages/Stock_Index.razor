@code {
    [Parameter] public string? StockUiScope { get; set; }

    [Parameter] public int InitialMainTabIndex { get; set; }

    private bool IsPortUi => string.Equals(StockUiScope, "port", StringComparison.OrdinalIgnoreCase);
    private bool IsDepotUi => string.Equals(StockUiScope, "depot", StringComparison.OrdinalIgnoreCase);

    private List<M_Stock> _items = new();
    private List<string> _locations = new();
    private bool _loading;
    private M_Stock? _selected;
    private StockContainerTrackingDto? _containerTracking;

    private string? _filterLocation;
    private string _filterContainer = string.Empty;
    private string _ymFilterContainer = string.Empty;
    private string _ymAmsLineFilter = string.Empty;
    private string _filterConsignee = string.Empty;
    private string _filterYom = string.Empty;
    private DateTime? _filterDateInFrom;
    private DateTime? _filterDateInTo;
    private int _ymActiveTab;
    private int _ymAgActiveSubTab;
    private int _ymVssActiveSubTab;
    private int _ymAmsActiveSubTab;
    private bool _ymLoading;
    private bool _ymCanView;
    private bool _ymCanAdd;
    private bool _ymCanEdit;
    private bool _ymCanDelete;
    private List<M_StockGateOut_HDS_08042026> _ymHdsItems = new();
    private List<M_8_3_Arrived> _ymAgArrivedItems = new();
    private List<M_8_3_Exited> _ymAgExitedItems = new();
    private List<M_8_3_Unstuffed> _ymAgUnstuffedItems = new();
    private List<M_8_3_Stuffed> _ymAgStuffedItems = new();
    private List<M_8_3_VSS_IN_OUT_YARD_Imp> _ymVssImpItems = new();
    private List<M_8_3_VSS_IN_OUT_YARD_Exp> _ymVssExpItems = new();
    private List<M_8_3_IN_OUT_YARD_1> _ymAmsImpItems = new();
    private List<M_YardMovement_AMS_26040816_Current_In_Yard2> _ymAmsExpItems = new();
    private M_StockGateOut_HDS_08042026? _ymSelectedHds;
    private M_8_3_Arrived? _ymSelectedAgArrived;
    private M_8_3_Exited? _ymSelectedAgExited;
    private M_8_3_Unstuffed? _ymSelectedAgUnstuffed;
    private M_8_3_Stuffed? _ymSelectedAgStuffed;
    private M_8_3_VSS_IN_OUT_YARD_Imp? _ymSelectedVssImp;
    private M_8_3_VSS_IN_OUT_YARD_Exp? _ymSelectedVssExp;
    private M_8_3_IN_OUT_YARD_1? _ymSelectedAmsImp;
    private M_YardMovement_AMS_26040816_Current_In_Yard2? _ymSelectedAmsExp;

    protected override async Task OnInitializedAsync()
    {
        if (IsPortUi)
            _ymActiveTab = Math.Clamp(InitialMainTabIndex, 0, 3);
        else if (IsDepotUi)
            _ymActiveTab = 0;
        else
            _ymActiveTab = Math.Clamp(InitialMainTabIndex, 0, 4);

        await RefreshAsync();
        await LoadYmPermissionAsync();
        if (_ymCanView)
            await RefreshYmCurrentTabAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<bool> EnsureStockViewPermissionAsync()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to view"], MudBlazor.Severity.Warning);
            return false;
        }

        return true;
    }

    private StockListFilter BuildFilter() => new(
        Location: string.IsNullOrWhiteSpace(_filterLocation) ? null : _filterLocation.Trim(),
        ContainerNo: string.IsNullOrWhiteSpace(_filterContainer) ? null : _filterContainer.Trim(),
        Consignee: string.IsNullOrWhiteSpace(_filterConsignee) ? null : _filterConsignee.Trim(),
        Yom: string.IsNullOrWhiteSpace(_filterYom) ? null : _filterYom.Trim(),
        DateInFrom: _filterDateInFrom,
        DateInTo: _filterDateInTo);

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            if (!await EnsureStockViewPermissionAsync())
            {
                _items.Clear();
                _locations.Clear();
                _selected = null;
                _containerTracking = null;
                return;
            }

            _items = await StockSvc.GetFilteredAsync(BuildFilter());
            await LoadContainerTrackingAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi tìm kiếm: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            if (!await EnsureStockViewPermissionAsync())
            {
                _items.Clear();
                _locations.Clear();
                _selected = null;
                _containerTracking = null;
                return;
            }

            _locations = await StockSvc.GetDistinctLocationsAsync();
            _items = await StockSvc.GetFilteredAsync(BuildFilter());
            await LoadContainerTrackingAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi tải dữ liệu: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<M_Stock> args)
    {
        _selected = args.Item;
    }

    private string StockRowClassFunc(M_Stock row, int _)
    {
        return _selected != null && _selected.StockID == row.StockID ? "selected" : string.Empty;
    }

    private string YmHdsRowClassFunc(M_StockGateOut_HDS_08042026 row, int _)
        => _ymSelectedHds != null && _ymSelectedHds.Id == row.Id ? "selected" : string.Empty;
    private string YmAgArrivedRowClassFunc(M_8_3_Arrived row, int _)
        => _ymSelectedAgArrived != null && _ymSelectedAgArrived.Id == row.Id ? "selected" : string.Empty;
    private string YmAgExitedRowClassFunc(M_8_3_Exited row, int _)
        => _ymSelectedAgExited != null && _ymSelectedAgExited.Id == row.Id ? "selected" : string.Empty;
