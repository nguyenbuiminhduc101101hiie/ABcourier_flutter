                        <TemplateColumn Title="Date import"><CellTemplate>@context.Item.DateImport?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.UserImport" Title="User import" />
                    </Columns>
                    <PagerContent><MudDataGridPager T="M_Stock" PageSizeOptions="new int[] { 10, 25, 50, 100 }" /></PagerContent>
                </MudDataGrid>
            </div>
