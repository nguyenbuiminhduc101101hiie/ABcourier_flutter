    private IEnumerable<PreviewRow> FilteredRows(SheetPreview sheet)
    {
        IEnumerable<PreviewRow> rows = sheet.Rows;

        if (_onlyProblem)
            rows = rows.Where(x => !CanImport(x));

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var q = _search.Trim();
            rows = rows.Where(x =>
                x.Container.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.ContainerType.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.IsoType.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.Location.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.Booking.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.Vessel.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                x.Remark.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        return rows;
    }

    private static bool CanImport(PreviewRow row) => !row.IsExisting && !row.IsBatchDuplicate && !row.IsInvalid;

    private static SheetTarget DetectTarget(string sheetName)
    {
        var key = NormalizeKey(sheetName);
        if (key == "GATEIN") return SheetTarget.GateIn;
        if (key == "GATEOUT") return SheetTarget.GateOut;
        if (key == "STOCK") return SheetTarget.Stock;
        return SheetTarget.Ignore;
    }

    private static int FindHeaderRow(ExcelWorksheet ws)
    {
        if (ws.Dimension is null)
            return -1;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 60); row++)
        {
            var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            for (var col = ws.Dimension.Start.Column; col <= ws.Dimension.End.Column; col++)
            {
                var text = ws.Cells[row, col].Text?.Trim();
                if (!string.IsNullOrWhiteSpace(text))
                    keys.Add(NormalizeKey(text));
            }

            if (keys.Contains("CONTAINER") && keys.Count >= 6)
                return row;
        }

        return -1;
    }

    private static void ExtractReportDates(ExcelWorksheet ws, SheetPreview sheet)
    {
        if (ws.Dimension is null)
            return;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 12); row++)
        {
            for (var col = ws.Dimension.Start.Column; col <= Math.Min(ws.Dimension.End.Column, 16); col++)
            {
                var key = NormalizeKey(ws.Cells[row, col].Text);
                if (key == "FROM") sheet.ReportFrom = CellDate(ws.Cells[row, col + 1]);
                if (key == "TO") sheet.ReportTo = CellDate(ws.Cells[row, col + 1]);
                if (key == "DATE") sheet.ReportDate = CellDate(ws.Cells[row, col + 2]) ?? CellDate(ws.Cells[row, col + 1]);
            }
        }

        sheet.ReportDate ??= sheet.ReportTo ?? sheet.ReportFrom;
    }

    private static string DetectDepot(ImportPreview preview)
    {
        var location = preview.Sheets.SelectMany(x => x.Rows)
            .Select(x => x.Location)
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x) && x.Contains("DEPOT", StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(location) ? string.Empty : location.Trim();
    }

    private static string ComputeSignature(PreviewRow r, string depot)
    {
        var values = new[]
        {
            N(depot), r.Target.ToString(), N(r.Container), N(r.ContainerType), N(r.IsoType), N(r.FE), N(r.Move), N(r.DateIn), N(r.TimeIn), N(r.DateOut),
            N(r.Location), N(r.Booking), N(r.Vessel), N(r.Voyage), N(r.Pol), N(r.Pod), N(r.Shipper), N(r.Consignee), N(r.Yom), N(r.SealNo),
            N(r.Vgm), N(r.MaxGross), N(r.TareWeight), N(r.Remark), N(r.Status), N(r.Grade), N(r.CleanMethod), N(r.CleanStatus), N(r.PtiDate),
            N(r.PtiSetting), N(r.PtiStatus), N(r.EstimatedDate), N(r.ApprovalDate), N(r.RejectDate), N(r.RepairedDate), N(r.RegisteredDate)
        };

        using var sha = SHA256.Create();
        return Convert.ToHexString(sha.ComputeHash(Encoding.UTF8.GetBytes(string.Join("␟", values))));
    }

    private static string Text(Dictionary<string, ExcelRange> cells, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (cells.TryGetValue(key, out var cell))
            {
                var value = cell.Text?.Trim();
                if (!string.IsNullOrWhiteSpace(value))
                    return value;
            }
        }
        return string.Empty;
    }

    private static decimal? DecimalValue(Dictionary<string, ExcelRange> cells, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!cells.TryGetValue(key, out var cell) || cell.Value is null)
                continue;

            if (cell.Value is decimal dec) return dec;
            if (cell.Value is double d) return Convert.ToDecimal(d);
            if (cell.Value is int i) return i;
            if (cell.Value is long l) return l;

            var text = cell.Text?.Trim().Replace(",", "");
            if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var value))
                return value;
        }
        return null;
    }

    private static DateTime? DateValue(Dictionary<string, ExcelRange> cells, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
            if (cells.TryGetValue(key, out var cell))
            {
                var dt = CellDate(cell);
                if (dt.HasValue)
                    return dt;
            }
        return null;
    }

    private static DateTime? CellDate(ExcelRange cell)
    {
        if (cell.Value is DateTime dt)
            return dt;
        if (cell.Value is double d && d > 20000 && d < 90000)
            return DateTime.FromOADate(d);

        var text = cell.Text?.Trim();
        if (DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt))
            return dt;
        if (DateTime.TryParse(text, new CultureInfo("vi-VN"), DateTimeStyles.None, out dt))
            return dt;
        return null;
    }

    private static string TimeText(Dictionary<string, ExcelRange> cells, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!cells.TryGetValue(key, out var cell) || cell.Value is null)
                continue;

            if (cell.Value is DateTime dt)
                return dt.ToString("HH:mm:ss", CultureInfo.InvariantCulture);
            if (cell.Value is double d && d >= 0 && d < 1)
                return TimeSpan.FromDays(d).ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture);

            var text = cell.Text?.Trim();
            if (!string.IsNullOrWhiteSpace(text))
                return text;
        }
        return string.Empty;
    }

    private static void Add(DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

    private static List<List<T>> Chunk<T>(List<T> source, int size)
    {
        var result = new List<List<T>>();
        for (var i = 0; i < source.Count; i += size)
            result.Add(source.Skip(i).Take(size).ToList());
        return result;
    }

    private static string NormalizeKey(string? text)
        => string.IsNullOrWhiteSpace(text) ? string.Empty : new string(text.Trim().ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());

    private static string N(string? value) => value?.Trim() ?? string.Empty;
    private static string N(decimal? value) => value?.ToString("0.####", CultureInfo.InvariantCulture) ?? string.Empty;
    private static string N(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm:ss.fffffff", CultureInfo.InvariantCulture) ?? string.Empty;
    private static string Fmt(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty;

    private static string RootMessage(Exception ex)
    {
        var root = ex;
        while (root.InnerException is not null)
            root = root.InnerException;
        return root.Message;
    }

    private static Color SheetColor(SheetPreview sheet)
    {
        if (sheet.Rows.Count == 0) return Color.Warning;
        if (sheet.Rows.Any(x => x.IsInvalid || x.IsBatchDuplicate)) return Color.Warning;
        if (sheet.Rows.Any(x => x.IsExisting)) return Color.Info;
        return Color.Success;
    }

    private static string SheetStatus(SheetPreview sheet)
    {
        if (sheet.Rows.Count == 0) return "No rows";
        if (sheet.Rows.Any(x => x.IsInvalid)) return "Has invalid";
        if (sheet.Rows.Any(x => x.IsBatchDuplicate)) return "Has duplicate";
        if (sheet.Rows.Any(x => x.IsExisting)) return "Has existing";
        return "Ready";
    }

