@page "/yard/alpine-inventory-import"
@attribute [Authorize]

@using System.Data
@using System.Data.Common
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Storage
@using MudBlazor
@using OfficeOpenXml
@using ABFreight.Data
@using ABFreight.Services

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar

<PageTitle>8.3.8 Import YARD Alpine Inventory</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="yard-import-page pa-3">
    <MudPaper Class="hero-card pa-4 mb-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" lg="8">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                    <div class="hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="page-title">8.3.8 Import YARD Alpine Inventory</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Import workbook dạng ALPINE Inventory: đọc GATE IN, GATE OUT và STOCK → preview → bỏ dòng trùng → ghi vào <b>@TableName</b>.
                        </MudText>
                    </div>
                </MudStack>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="flex-wrap action-bar">
                    <MudTextField T="string"
                                  @bind-Value="_importDepot"
                                  Label="Depot"
                                  Placeholder="PHUONG DONG DEPOT"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Style="min-width:220px;background:#fff;border-radius:12px;"
                                  Disabled="@(_busy || _preview is not null)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.LocationOn" />

                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Disabled="@_busy">
                        Chọn Excel
                        <InputFile OnChange="PreviewExcelAsync" accept=".xlsx" style="display:none" />
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || _preview is null || ImportableTotal == 0)">
                        Import DB
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ClearPreview"
                               Disabled="@_busy">
                        Reset
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">File</MudText>
                <MudText Typo="Typo.subtitle2" Class="fw-bold ellipsis">@(_preview?.FileName ?? "Chưa chọn")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">GATE IN</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold text-ok">@GateInCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Container rows</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">GATE OUT</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold text-warn">@GateOutCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Container rows</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">STOCK</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold text-info">@StockCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Current inventory</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">New / Existing</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@ImportableTotal.ToString("N0") / @ExistingTotal.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Ready / skipped</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudText Typo="Typo.caption">Database</MudText>
                <MudText Typo="Typo.subtitle2" Class="fw-bold ellipsis">@TableName</MudText>
                <MudText Typo="Typo.caption">Auto-created</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_busy)
    {
        <MudPaper Class="process-card pa-4 mb-3" Elevation="0">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="mt-2">Đang xử lý Excel / database...</MudText>
        </MudPaper>
    }

    @if (_preview is null)
    {
        <MudPaper Class="empty-card pa-6" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="fw-bold">Chọn file ALPINE Inventory để preview</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Hệ thống tự tìm header thật trong từng sheet, chỉ import 3 sheet container: <b>GATE IN</b>, <b>GATE OUT</b>, <b>STOCK</b>.
                    GENERAL và GENERAL_STATUS chỉ là summary nên không import.
                </MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="control-card pa-3 mb-3" Elevation="0">
            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" md="5">
                    <MudTextField T="string"
                                  @bind-Value="_search"
                                  Label="Search preview"
                                  Placeholder="Container, depot, booking, vessel, remark..."
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="int" @bind-Value="_previewLimit" Label="Rows" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int" Value="@(50)">50</MudSelectItem>
                        <MudSelectItem T="int" Value="@(100)">100</MudSelectItem>
                        <MudSelectItem T="int" Value="@(200)">200</MudSelectItem>
                        <MudSelectItem T="int" Value="@(500)">500</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudCheckBox T="bool" @bind-Value="_onlyProblem" Label="Chỉ dòng lỗi/trùng" Color="Color.Warning" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.DoneAll"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || ImportableTotal == 0)">
                        Import @ImportableTotal.ToString("N0") dòng mới
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="2" Class="mb-3">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudItem xs="12" md="4">
                    <MudPaper Class="sheet-summary-card pa-3" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@sheet.SheetName</MudText>
                                <MudText Typo="Typo.caption">Header row @sheet.HeaderRow · @sheet.Rows.Count.ToString("N0") rows</MudText>
                            </div>
                            <MudChip T="string" Color="@SheetColor(sheet)" Variant="Variant.Filled" Size="Size.Small">@SheetStatus(sheet)</MudChip>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudGrid Spacing="1">
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption">New</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-ok">@sheet.Rows.Count(CanImport).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption">Existing</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-info">@sheet.Rows.Count(x => x.IsExisting).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="4">
                                <MudText Typo="Typo.caption">Invalid/Dup</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-error">@sheet.Rows.Count(x => x.IsInvalid || x.IsBatchDuplicate).ToString("N0")</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudTabs @bind-ActivePanelIndex="_activeTab" Class="preview-tabs">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudTabPanel Text="@($"{sheet.SheetName} ({sheet.Rows.Count:N0})")">
                    <MudPaper Class="preview-card pa-3" Elevation="0">
                        <div class="preview-table-wrap">
                            <MudTable T="PreviewRow"
                                      Items="FilteredRows(sheet).Take(_previewLimit).ToList()"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true"
                                      Striped="true"
                                      Class="preview-table">
                                <HeaderContent>
                                    <MudTh Class="sticky-col">#</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh>Container</MudTh>
                                    <MudTh>Type</MudTh>
                                    <MudTh>ISO</MudTh>
                                    <MudTh>F/E</MudTh>
                                    <MudTh>Move</MudTh>
                                    <MudTh>Date In</MudTh>
                                    <MudTh>Date Out</MudTh>
                                    <MudTh>Location</MudTh>
                                    <MudTh>Booking</MudTh>
                                    <MudTh>Vessel</MudTh>
                                    <MudTh>Remark</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="row">
                                    <MudTd Class="sticky-col">@row.ExcelRow</MudTd>
                                    <MudTd>
                                        @if (CanImport(row))
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">New</MudChip>
                                        }
                                        else if (row.IsExisting)
                                        {
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small">Existing</MudChip>
                                        }
                                        else if (row.IsBatchDuplicate)
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Duplicate</MudChip>
                                        }
                                        else
                                        {
                                            <MudTooltip Text="@row.StatusMessage">
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small">Invalid</MudChip>
                                            </MudTooltip>
                                        }
                                    </MudTd>
                                    <MudTd Class="fw-bold">@row.Container</MudTd>
                                    <MudTd>@row.ContainerType</MudTd>
                                    <MudTd>@row.IsoType</MudTd>
                                    <MudTd>@row.FE</MudTd>
                                    <MudTd>@row.Move</MudTd>
                                    <MudTd>@Fmt(row.DateIn)</MudTd>
                                    <MudTd>@Fmt(row.DateOut)</MudTd>
                                    <MudTd>@row.Location</MudTd>
                                    <MudTd>@row.Booking</MudTd>
                                    <MudTd>@row.Vessel</MudTd>
                                    <MudTd>@row.Remark</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    private const string PermissionMenuName = "Inventory";
    private const string TableName = "M_8_3_8_YARD_ALPINE_INVENTORY";

    private bool _busy;
    private bool _canAdd;
    private string _usr = string.Empty;
    private string _importDepot = "PHUONG DONG DEPOT";
    private ImportPreview? _preview;
    private int _activeTab;
    private int _previewLimit = 100;
    private string _search = string.Empty;
    private bool _onlyProblem;

    private int GateInCount => _preview?.Sheets.Where(x => x.Target == SheetTarget.GateIn).Sum(x => x.Rows.Count) ?? 0;
    private int GateOutCount => _preview?.Sheets.Where(x => x.Target == SheetTarget.GateOut).Sum(x => x.Rows.Count) ?? 0;
    private int StockCount => _preview?.Sheets.Where(x => x.Target == SheetTarget.Stock).Sum(x => x.Rows.Count) ?? 0;
    private int ImportableTotal => _preview?.Sheets.Sum(x => x.Rows.Count(CanImport)) ?? 0;
    private int ExistingTotal => _preview?.Sheets.Sum(x => x.Rows.Count(r => r.IsExisting)) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        _canAdd = await ssv.CheckPermission(_usr, "Add", PermissionMenuName);
    }

    private async Task PreviewExcelAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add("Bạn không có quyền import Inventory.", MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        var file = e.File;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Chỉ hỗ trợ file .xlsx.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            _preview = null;
            _search = string.Empty;
            _onlyProblem = false;

            await using var input = file.OpenReadStream(100 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await input.CopyToAsync(ms);

            _preview = ReadPreview(ms.ToArray(), file.Name);
            if (_preview.Sheets.Count == 0)
                throw new InvalidOperationException("Không tìm thấy GATE IN, GATE OUT hoặc STOCK trong file.");

            var detectedDepot = DetectDepot(_preview);
            if (!string.IsNullOrWhiteSpace(detectedDepot))
                _importDepot = detectedDepot;

            foreach (var row in _preview.Sheets.SelectMany(x => x.Rows))
                row.Signature = ComputeSignature(row, _importDepot);

            await EnsureTableAsync();
            await MarkDuplicatesAsync(_preview);
            _activeTab = 0;

            Snackbar.Add($"Preview xong: {GateInCount:N0} Gate In, {GateOutCount:N0} Gate Out, {StockCount:N0} Stock. New {ImportableTotal:N0}, existing {ExistingTotal:N0}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add("Bạn không có quyền import Inventory.", MudBlazor.Severity.Warning);
            return;
        }

        if (_preview is null || ImportableTotal == 0)
        {
            Snackbar.Add("Không có dòng mới để import.", MudBlazor.Severity.Info);
            return;
        }

        if (string.IsNullOrWhiteSpace(_importDepot))
        {
            Snackbar.Add("Vui lòng nhập Depot.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await EnsureTableAsync();

            var rows = _preview.Sheets.SelectMany(s => s.Rows).Where(CanImport).ToList();
            var inserted = await InsertRowsAsync(rows, _preview.FileName, _importDepot.Trim());

            Snackbar.Add($"Import thành công {inserted:N0} dòng vào dbo.{TableName}.", MudBlazor.Severity.Success);
            ClearPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearPreview()
    {
        _preview = null;
        _activeTab = 0;
        _search = string.Empty;
        _onlyProblem = false;
    }

    private static ImportPreview ReadPreview(byte[] bytes, string fileName)
    {
        ConfigureEpplusLicense();
        using var ms = new MemoryStream(bytes);
        using var package = new ExcelPackage(ms);

        var preview = new ImportPreview { FileName = fileName };

        foreach (var ws in package.Workbook.Worksheets)
        {
            var target = DetectTarget(ws.Name);
            if (target == SheetTarget.Ignore)
                continue;

            var sheet = ReadDetailSheet(ws, target);
            preview.Sheets.Add(sheet);
        }

        return preview;
    }

    private static SheetPreview ReadDetailSheet(ExcelWorksheet ws, SheetTarget target)
    {
        var sheet = new SheetPreview { SheetName = ws.Name, Target = target };
        ExtractReportDates(ws, sheet);

        if (ws.Dimension is null)
            return sheet;

        sheet.HeaderRow = FindHeaderRow(ws);
        if (sheet.HeaderRow <= 0)
            return sheet;

        var headers = new List<HeaderColumn>();
        for (var col = ws.Dimension.Start.Column; col <= ws.Dimension.End.Column; col++)
        {
            var header = ws.Cells[sheet.HeaderRow, col].Text?.Trim() ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(header))
                headers.Add(new HeaderColumn(header, NormalizeKey(header), col));
        }

        for (var rowNo = sheet.HeaderRow + 1; rowNo <= ws.Dimension.End.Row; rowNo++)
        {
            var first = ws.Cells[rowNo, ws.Dimension.Start.Column].Text?.Trim() ?? string.Empty;
            if (first.Equals("Total", StringComparison.OrdinalIgnoreCase))
                break;

            var values = new Dictionary<string, ExcelRange>(StringComparer.OrdinalIgnoreCase);
            foreach (var h in headers)
                values[h.Key] = ws.Cells[rowNo, h.ColumnIndex];

            var container = Text(values, "CONTAINER");
            if (string.IsNullOrWhiteSpace(container))
                continue;

            var r = new PreviewRow
            {
                Target = target,
                SheetName = ws.Name,
                ExcelRow = rowNo,
                ReportFrom = sheet.ReportFrom,
                ReportTo = sheet.ReportTo,
                ReportDate = sheet.ReportDate,
                Seq = DecimalValue(values, "SEQ"),
                Eir = Text(values, "EIR"),
                Container = container,
                ContainerType = Text(values, "TYPE", "CONTAINERTYPE"),
                IsoType = Text(values, "ISOSZTP", "ISOTYPE"),
                Opt = Text(values, "OPT"),
                Opr = Text(values, "OPR"),
                FE = Text(values, "FE"),
                Move = Text(values, "MOVE"),
                DateIn = DateValue(values, "DATEIN"),
                TimeIn = TimeText(values, "TIME"),
                DateOut = DateValue(values, "DATEOUT"),
                Location = Text(values, "LOCATION"),
                Booking = Text(values, "BOOKING"),
                Vessel = Text(values, "VESSEL"),
                Voyage = Text(values, "VOYAGE"),
                Pol = Text(values, "POL"),
                Pod = Text(values, "POD"),
                Shipper = Text(values, "SHIPPER"),
                Consignee = Text(values, "CONSIGNEE"),
                Yom = Text(values, "YOM"),
                SealNo = Text(values, "SEALNO"),
                SealNo2 = Text(values, "SEALNO2"),
                Note1 = Text(values, "NOTE1"),
                Note2 = Text(values, "NOTE2"),
                Note3 = Text(values, "NOTE3"),
                RequiredGrade = Text(values, "REQUIREDGRADE"),
                Vgm = DecimalValue(values, "VGM"),
                MaxGross = DecimalValue(values, "MAXGROSS"),
                TareWeight = DecimalValue(values, "TAREWEIGHT"),
                TruckNo = Text(values, "TRUCKNO"),
                TruckerPhone = Text(values, "TRUCKERPHONE"),
                Position = Text(values, "POSITION"),
                Days = DecimalValue(values, "DAYS"),
                Remark = Text(values, "REMARK"),
                Status = Text(values, "STATUS"),
                Grade = Text(values, "GRADE"),
                CleanMethod = Text(values, "CLEANMETHOD", "CLEAN"),
                CleanStatus = Text(values, "CLEANSTATUS"),
                PtiDate = DateValue(values, "PTIDATE"),
                PtiSetting = Text(values, "PTISETTING"),
                PtiStatus = Text(values, "PTISTATUS"),
                EstimatedDate = DateValue(values, "ESTIMATEDDATE"),
                ApprovalDate = DateValue(values, "APPOVALDATE", "APPROVALDATE"),
                RejectDate = DateValue(values, "REJECTDATE"),
                RepairedDate = DateValue(values, "REPAIREDDATE"),
                RegisteredDate = DateValue(values, "REGISTEREDDATE"),
                InsDate = DateValue(values, "INSDATE")
            };

            sheet.Rows.Add(r);
        }

        return sheet;
    }

    private async Task EnsureTableAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Database.ExecuteSqlRawAsync(CreateTableSql);
    }

    private async Task MarkDuplicatesAsync(ImportPreview preview)
    {
        var fileSeen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var allSignatures = preview.Sheets.SelectMany(x => x.Rows).Select(x => x.Signature).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var existing = await LoadExistingSignaturesAsync(allSignatures);

        foreach (var row in preview.Sheets.SelectMany(x => x.Rows))
        {
            if (string.IsNullOrWhiteSpace(row.Container))
            {
                row.IsInvalid = true;
                row.StatusMessage = "Missing Container.";
                continue;
            }

            if (existing.Contains(row.Signature))
            {
                row.IsExisting = true;
                row.StatusMessage = "Đã có trong database.";
                continue;
            }

            if (!fileSeen.Add(row.Signature))
            {
                row.IsBatchDuplicate = true;
                row.StatusMessage = "Trùng dòng khác trong cùng file.";
            }
        }
    }

    private async Task<HashSet<string>> LoadExistingSignaturesAsync(List<string> signatures)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (signatures.Count == 0)
            return result;

        await using var db = await DbFactory.CreateDbContextAsync();
        var conn = db.Database.GetDbConnection();
        if (conn.State != ConnectionState.Open)
            await conn.OpenAsync();

        foreach (var chunk in Chunk(signatures, 200))
        {
            await using var cmd = conn.CreateCommand();
            var names = new List<string>();
            for (var i = 0; i < chunk.Count; i++)
            {
                var p = cmd.CreateParameter();
                p.ParameterName = "@s" + i;
                p.Value = chunk[i];
                cmd.Parameters.Add(p);
                names.Add(p.ParameterName);
            }

            cmd.CommandText = $"SELECT ROW_SIGNATURE FROM dbo.[{TableName}] WITH (NOLOCK) WHERE ROW_SIGNATURE IN ({string.Join(",", names)});";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
                result.Add(reader.GetString(0));
        }

        return result;
    }

    private async Task<int> InsertRowsAsync(List<PreviewRow> rows, string sourceFile, string depot)
    {
        var inserted = 0;
        var now = DateTime.Now;

        await using var db = await DbFactory.CreateDbContextAsync();
        await using var tran = await db.Database.BeginTransactionAsync();
        var conn = db.Database.GetDbConnection();
        if (conn.State != ConnectionState.Open)
            await conn.OpenAsync();

        foreach (var r in rows)
        {
            await using var cmd = conn.CreateCommand();
