    private static ImportPayload? BuildPayload(ExcelSheetPreview sheet, ExcelPreviewRow row, string depot, string sourceFile)
    {
        if (!HasRequiredBusinessKey(sheet, row))
        {
            row.StatusMessage = "Missing required business key.";
            return null;
        }

        var values = sheet.Target switch
        {
            ImportTarget.GateIn => GateInValues(row),
            ImportTarget.GateOut => GateOutValues(row),
            ImportTarget.Stock => StockValues(row),
            ImportTarget.General => GeneralValues(row),
            ImportTarget.GeneralStatus => GeneralStatusValues(row),
            _ => new Dictionary<string, object?>()
        };

        values["DEPOT"] = depot.Trim();
        values["REPORT_FROM"] = sheet.ReportFrom;
        values["REPORT_TO"] = sheet.ReportTo;
        values["REPORT_DATE"] = sheet.ReportDate;

        var signature = ComputeSignature(sheet.Target, values);
        var rawJson = JsonSerializer.Serialize(row.Values);

        return new ImportPayload(sheet.Target, TargetTable(sheet.Target), sourceFile, sheet.SheetName, row.ExcelRowNumber, values, rawJson, signature);
    }

