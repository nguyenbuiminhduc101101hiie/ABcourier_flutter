@page "/StockInOutImportPro"
@attribute [Authorize]
@using System.Data
@using System.Data.Common
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Storage
@using MudBlazor
@using OfficeOpenXml
@using ABFreight.Data
@using ABFreight.Services
@using ABFreight.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar

<PageTitle>8.3.6 Import APS Stock / In-Out Excel</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="aps-import-page pa-3">
    <MudPaper Class="hero-card pa-4 mb-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" lg="8">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                    <div class="hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="page-title">8.3.6 Import APS Stock / Gate In / Gate Out</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Select depot → choose Excel → auto-detect GATEIN / GATEOUT / Stock / General / General_Status → preview → skip existing rows → import new rows only.
                        </MudText>
                    </div>
                </MudStack>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="flex-wrap action-bar">
                    <MudAutocomplete T="string"
                                     @bind-Value="_importDepot"
                                     Label="Depot name"
                                     Placeholder="Select depot before preview"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Style="min-width:230px;background:#fff;border-radius:12px;"
                                     Disabled="@(_busy || _preview is not null)"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Warehouse"
                                     SearchFunc="SearchTerminal"
                                     CoerceText
                                     ResetValueOnEmptyText
                                     Clearable
                                     MaxItems="30" />

                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Disabled="@_busy">
                        Choose Excel
                        <InputFile OnChange="PreviewExcelAsync" accept=".xlsx" style="display:none" />
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || _preview is null || !_preview.HasImportableRows)">
                        Import DB
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ClearPreview"
                               Disabled="@_busy">
                        Reset
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.caption">Preview file</MudText>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold ellipsis">@(_preview?.FileName ?? "No file selected")</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Success" />
                    <div>
                        <MudText Typo="Typo.caption">Gate In</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@GateInRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Container / EIR</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.caption">Gate Out</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@GateOutRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Booking / DateOut</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Info" />
                    <div>
                        <MudText Typo="Typo.caption">Stock</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@StockRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">Current inventory</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Summarize" Color="Color.Secondary" />
                    <div>
                        <MudText Typo="Typo.caption">Summary</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@SummaryRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">General / Status</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="2">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@StatusIcon" Color="@StatusColor" />
                    <div>
                        <MudText Typo="Typo.caption">Status</MudText>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@StatusText</MudText>
                        <MudText Typo="Typo.caption">@ValidationText</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_busy)
    {
        <MudPaper Class="pa-4 mb-3 process-card" Elevation="0">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="mt-2">Processing Excel file...</MudText>
        </MudPaper>
    }

    @if (_preview is null)
    {
        <MudPaper Class="empty-card pa-6" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="fw-bold">Choose APS Excel file to preview</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    This screen reads the real APS workbook structure where headers are not always on row 1. It will detect <b>GATEIN</b>, <b>GATEOUT</b>, <b>Stock</b>, <b>General</b>, and <b>General_Status</b> automatically.
                </MudText>
                <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@_busy">
                    Choose Excel to preview
                    <InputFile OnChange="PreviewExcelAsync" accept=".xlsx" style="display:none" />
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="control-card pa-3 mb-3" Elevation="0">
            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_previewSearch"
                                  Label="Search preview"
                                  Placeholder="Container, EIR, booking, depot, location, status..."
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="int" @bind-Value="_previewLimit" Label="Preview rows" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int" Value="@(50)">50 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(100)">100 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(200)">200 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(500)">500 rows</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCheckBox T="bool" @bind-Value="_showAllColumns" Label="Show all columns" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCheckBox T="bool" @bind-Value="_onlyProblem" Label="Problem rows only" Color="Color.Warning" />
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || _preview is null || !_preview.HasImportableRows)">
                        Confirm import
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="2" Class="mb-3">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudPaper Class="sheet-summary-card pa-3" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="gap-2">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@sheet.SheetName</MudText>
                                <MudText Typo="Typo.caption">Target: <b>@TargetShortLabel(sheet.Target)</b></MudText><br />
                                <MudText Typo="Typo.caption">Header row: @sheet.HeaderRow · Columns: @sheet.Headers.Count · Rows: @sheet.Rows.Count.ToString("N0")</MudText>
                            </div>
                            <MudChip T="string" Color="@SheetColor(sheet)" Variant="Variant.Filled" Size="Size.Small">@SheetStatus(sheet)</MudChip>
                        </MudStack>

                        <MudDivider Class="my-2" />
                        <MudGrid Spacing="1">
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">New</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-ok">@ImportableRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Existing</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-info">@ExistingRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Duplicate</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-warn">@BatchDuplicateRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Errors</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-error">@InvalidRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                        </MudGrid>

                        @if (sheet.Warnings.Count > 0)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mt-2">
                                @foreach (var w in sheet.Warnings)
                                {
                                    <div>@w</div>
                                }
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudTabs @bind-ActivePanelIndex="_activeSheetTab" Class="preview-tabs">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudTabPanel Text="@SheetTabTitle(sheet)">
                    <MudPaper Class="preview-card pa-3" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
                            <div>
                                <MudText Typo="Typo.h6" Class="fw-bold">@sheet.SheetName</MudText>
                                <MudText Typo="Typo.caption">
                                    @TargetLongLabel(sheet.Target) · Preview @FilteredRows(sheet).Count().ToString("N0") rows / total @sheet.Rows.Count.ToString("N0") rows
                                </MudText>
                            </div>
                            <MudChip T="string" Color="@SheetColor(sheet)" Variant="Variant.Filled">@SheetStatus(sheet)</MudChip>
                        </MudStack>

                        @if (sheet.Rows.Count == 0)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
                                No importable data rows were found in this sheet.
                            </MudAlert>
                        }
                        else
                        {
                            <div class="preview-table-wrap">
                                <MudTable T="ExcelPreviewRow" Items="FilteredRows(sheet).Take(_previewLimit).ToList()" Dense="true" Hover="true" Bordered="true" Striped="true" Class="preview-table">
                                    <HeaderContent>
                                        <MudTh Class="sticky-col">#</MudTh>
                                        <MudTh>Import?</MudTh>
                                        @foreach (var header in VisibleHeaders(sheet))
                                        {
                                            <MudTh>@header</MudTh>
                                        }
                                    </HeaderContent>
                                    <RowTemplate Context="row">
                                        <MudTd Class="sticky-col">@row.ExcelRowNumber</MudTd>
                                        <MudTd>
                                            @if (CanImportRow(sheet, row))
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">New</MudChip>
                                            }
                                            else if (row.IsExisting)
                                            {
                                                <MudTooltip Text="@row.StatusMessage">
                                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Existing DB</MudChip>
                                                </MudTooltip>
                                            }
                                            else if (row.IsBatchDuplicate)
                                            {
                                                <MudTooltip Text="@row.StatusMessage">
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">File duplicate</MudChip>
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <MudTooltip Text="@row.StatusMessage">
                                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Invalid</MudChip>
                                                </MudTooltip>
                                            }
                                        </MudTd>
                                        @foreach (var header in VisibleHeaders(sheet))
                                        {
                                            <MudTd>@CellText(row, header)</MudTd>
                                        }
                                    </RowTemplate>
                                </MudTable>
                            </div>

                            @if (FilteredRows(sheet).Count() > _previewLimit)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    Showing @_previewLimit.ToString("N0") first rows. Import will process all valid rows.
                                </MudText>
                            }
                        }
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    private const string PermissionMenuName = "Inventory";

    private bool _busy;
    private bool _canAdd;
    private string _usr = string.Empty;
    private string _importDepot = string.Empty;
    private List<Terminal_> _terminals = new();
    private ImportPreview? _preview;
    private byte[]? _fileBytes;

    private int _activeSheetTab;
    private int _previewLimit = 100;
    private bool _showAllColumns = true;
    private bool _onlyProblem;
    private string _previewSearch = string.Empty;

    private int GateInRowsCount => _preview?.Sheets.Where(x => x.Target == ImportTarget.GateIn).Sum(ImportableRows) ?? 0;
    private int GateOutRowsCount => _preview?.Sheets.Where(x => x.Target == ImportTarget.GateOut).Sum(ImportableRows) ?? 0;
    private int StockRowsCount => _preview?.Sheets.Where(x => x.Target == ImportTarget.Stock).Sum(ImportableRows) ?? 0;
    private int SummaryRowsCount => _preview?.Sheets.Where(x => x.Target is ImportTarget.General or ImportTarget.GeneralStatus).Sum(ImportableRows) ?? 0;
    private int InvalidTotal => _preview?.Sheets.Sum(InvalidRows) ?? 0;
    private int ExistingTotal => _preview?.Sheets.Sum(ExistingRows) ?? 0;
    private int BatchDuplicateTotal => _preview?.Sheets.Sum(BatchDuplicateRows) ?? 0;
    private int ImportableTotal => _preview?.Sheets.Sum(ImportableRows) ?? 0;

    private string StatusText => _preview is null ? "No file selected" : (_preview.HasImportableRows ? "Ready to import" : "No new rows");
    private string ValidationText => _preview is null ? $"Depot: {DisplayDepot}" : $"New {ImportableTotal:N0} · Existing {ExistingTotal:N0} · Duplicate {BatchDuplicateTotal:N0} · Errors {InvalidTotal:N0}";
    private string DisplayDepot => string.IsNullOrWhiteSpace(_importDepot) ? "not entered" : _importDepot.Trim();
    private string StatusIcon => _preview is null ? Icons.Material.Filled.Pending : (_preview.HasImportableRows ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning);
    private Color StatusColor => _preview is null ? Color.Default : (_preview.HasImportableRows ? Color.Success : Color.Warning);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        _canAdd = await ssv.CheckPermission(_usr, "Add", PermissionMenuName);

        await using var db = await DbFactory.CreateDbContextAsync();
        _terminals = await db.Terminal
            .Where(x => !string.IsNullOrEmpty(x.TermiNalName))
            .OrderBy(x => x.TermiNalName)
            .ToListAsync();
    }

    private Task<IEnumerable<string?>> SearchTerminal(string? text)
    {
        var query = _terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName));

        if (!string.IsNullOrWhiteSpace(text))
        {
            query = query.Where(x =>
                x.TermiNalName!.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                (x.Code?.Contains(text, StringComparison.OrdinalIgnoreCase) == true));
        }

        return Task.FromResult<IEnumerable<string?>>(query.Select(x => x.TermiNalName).Distinct());
    }

    private async Task PreviewExcelAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add("You do not have permission to import inventory Excel.", MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        if (string.IsNullOrWhiteSpace(_importDepot))
        {
            Snackbar.Add("Please select Depot name before preview/import.", MudBlazor.Severity.Warning);
            return;
        }

        var file = e.File;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("This feature supports .xlsx only.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            _preview = null;
            _fileBytes = null;
            _previewSearch = string.Empty;
            _onlyProblem = false;

            await using var stream = file.OpenReadStream(100 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _fileBytes = ms.ToArray();

            _preview = ReadPreview(_fileBytes, file.Name);
            await EnsureTablesAsync();
            await MarkDuplicateRowsAsync(_preview);
            _activeSheetTab = 0;

            Snackbar.Add($"Previewed {_preview.Sheets.Sum(x => x.Rows.Count):N0} rows. New {ImportableTotal:N0}, existing {ExistingTotal:N0}, duplicates {BatchDuplicateTotal:N0}, errors {InvalidTotal:N0}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add("You do not have permission to import inventory Excel.", MudBlazor.Severity.Warning);
            return;
        }

        if (_preview is null)
        {
            Snackbar.Add("No Excel file selected for preview.", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_importDepot))
        {
            Snackbar.Add("Please select Depot name before import.", MudBlazor.Severity.Warning);
            return;
        }

        if (!_preview.HasImportableRows)
        {
            Snackbar.Add($"Nothing imported. Existing {ExistingTotal:N0}, duplicates {BatchDuplicateTotal:N0}, errors {InvalidTotal:N0}.", MudBlazor.Severity.Info);
            return;
        }

        try
        {
            _busy = true;
            await EnsureTablesAsync();

            var payloads = new List<ImportPayload>();
            foreach (var sheet in _preview.Sheets.Where(x => x.Target != ImportTarget.Unknown))
            {
                foreach (var row in sheet.Rows.Where(r => CanImportRow(sheet, r)))
                {
                    var payload = BuildPayload(sheet, row, _importDepot, _preview.FileName);
                    if (payload is not null)
                        payloads.Add(payload);
                }
            }

            var inserted = await InsertPayloadsAsync(payloads);
            Snackbar.Add($"Import completed: {inserted:N0} rows. Skipped: existing {ExistingTotal:N0}, file duplicates {BatchDuplicateTotal:N0}, errors {InvalidTotal:N0}.", MudBlazor.Severity.Success);
            ClearPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearPreview()
    {
        _preview = null;
        _fileBytes = null;
        _activeSheetTab = 0;
        _previewSearch = string.Empty;
        _onlyProblem = false;
    }

    private async Task EnsureTablesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Database.ExecuteSqlRawAsync(CreateTablesSql);
    }

    private async Task MarkDuplicateRowsAsync(ImportPreview preview)
    {
        var fileSignatures = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using var db = await DbFactory.CreateDbContextAsync();

        foreach (var group in preview.Sheets.Where(x => x.Target != ImportTarget.Unknown).GroupBy(x => x.Target))
        {
            var target = group.Key;
            var table = TargetTable(target);
            var rows = group.SelectMany(sheet => sheet.Rows.Select(row => new { Sheet = sheet, Row = row }))
                            .Where(x => HasRequiredBusinessKey(x.Sheet, x.Row))
                            .ToList();

            var payloads = rows.Select(x => new { x.Sheet, x.Row, Payload = BuildPayload(x.Sheet, x.Row, _importDepot, preview.FileName) })
                               .Where(x => x.Payload is not null)
                               .ToList();

            var existing = await LoadExistingSignaturesAsync(db, table, payloads.Select(x => x.Payload!.Signature).Distinct(StringComparer.OrdinalIgnoreCase).ToList());

            foreach (var item in payloads)
            {
                var sig = item.Payload!.Signature;
                if (existing.Contains(sig))
                {
                    item.Row.IsExisting = true;
                    item.Row.StatusMessage = "Already exists in database. The system compares all imported business columns including DEPOT, excluding Id/DateImport/UserImport/CreatedAt.";
                    continue;
                }

                var fileKey = $"{target}|{sig}";
                if (!fileSignatures.Add(fileKey))
                {
                    item.Row.IsBatchDuplicate = true;
                    item.Row.StatusMessage = "Duplicate of another Excel row by all imported business columns.";
                }
            }
        }
    }

    private static ImportPreview ReadPreview(byte[] bytes, string fileName)
    {
        ConfigureEpplusLicense();
        using var ms = new MemoryStream(bytes);
        using var package = new ExcelPackage(ms);

        var preview = new ImportPreview { FileName = fileName };
        foreach (var ws in package.Workbook.Worksheets)
        {
            var target = DetectTarget(ws.Name);
            ExcelSheetPreview sheet = target switch
            {
                ImportTarget.General => ReadGeneralWorksheet(ws),
                ImportTarget.GeneralStatus => ReadGeneralStatusWorksheet(ws),
                _ => ReadDetailWorksheet(ws, target)
            };

            preview.Sheets.Add(sheet);
        }

        return preview;
    }

    private static ExcelSheetPreview ReadDetailWorksheet(ExcelWorksheet ws, ImportTarget target)
    {
        var sheet = NewSheet(ws, target);
        if (ws.Dimension is null)
        {
            sheet.Warnings.Add("Empty sheet.");
            return sheet;
        }

        var headerRow = FindDetailHeaderRow(ws);
        sheet.HeaderRow = headerRow;
        if (target == ImportTarget.Unknown)
        {
            sheet.Warnings.Add("This sheet name is not recognized, so it will not be imported.");
            return sheet;
        }

        if (headerRow <= 0)
        {
            sheet.Target = ImportTarget.Unknown;
            sheet.Warnings.Add("Header row was not found. Expected columns like Container / EIR / Type / Move.");
            return sheet;
        }

        var startCol = ws.Dimension.Start.Column;
        var endCol = ws.Dimension.End.Column;
        var endRow = ws.Dimension.End.Row;

        for (var col = startCol; col <= endCol; col++)
        {
            var header = ws.Cells[headerRow, col].Text?.Trim();
            if (string.IsNullOrWhiteSpace(header))
                header = $"Column_{col}";

            header = MakeUniqueHeader(sheet.Headers, header);
            sheet.Headers.Add(header);
            sheet.HeaderColumns.Add(new ExcelHeaderColumn(header, NormalizeKey(header), col));
        }

        foreach (var row in Enumerable.Range(headerRow + 1, Math.Max(0, endRow - headerRow)))
        {
            var previewRow = ReadRow(ws, sheet.HeaderColumns, row);
            if (!previewRow.HasValue)
                continue;

            if (IsFooterRow(previewRow))
                continue;

            sheet.Rows.Add(previewRow);
        }

        if (!sheet.HeaderColumns.Any(x => x.Key == "CONTAINER"))
            sheet.Warnings.Add("Container column was not found. Rows without container number will be skipped.");

        return sheet;
    }

    private static ExcelSheetPreview ReadGeneralWorksheet(ExcelWorksheet ws)
    {
        var sheet = NewSheet(ws, ImportTarget.General);
        sheet.HeaderRow = 0;
        sheet.Headers.AddRange(new[] { "SECTION", "ROW_TYPE", "OPERATOR", "TYPE", "QUANTITY_CONT", "TEU" });
        sheet.HeaderColumns.AddRange(sheet.Headers.Select((h, i) => new ExcelHeaderColumn(h, NormalizeKey(h), i + 1)));

        if (ws.Dimension is null)
        {
            sheet.Warnings.Add("Empty sheet.");
            return sheet;
        }

        string section = string.Empty;
        for (var row = ws.Dimension.Start.Row; row <= ws.Dimension.End.Row; row++)
        {
            var b = ws.Cells[row, 2].Text?.Trim() ?? string.Empty;
            var c = ws.Cells[row, 3].Text?.Trim() ?? string.Empty;
            var d = ws.Cells[row, 4].Text?.Trim() ?? string.Empty;
            var e = ws.Cells[row, 5].Text?.Trim() ?? string.Empty;

            if (IsSectionName(b))
            {
                section = b.Trim();
                continue;
            }

            if (string.IsNullOrWhiteSpace(section))
                continue;

            if (b.Contains("SUMMARY OF TEU", StringComparison.OrdinalIgnoreCase))
            {
                var r = NewManualRow(row, sheet.Headers);
                r.Set("SECTION", section);
                r.Set("ROW_TYPE", "SUMMARY");
                r.Set("TEU", e);
                sheet.Rows.Add(r);
                continue;
            }

            if (c.Equals("OPERATOR", StringComparison.OrdinalIgnoreCase) || d.Equals("TYPE", StringComparison.OrdinalIgnoreCase))
                continue;

            if (!string.IsNullOrWhiteSpace(c) || !string.IsNullOrWhiteSpace(d) || !string.IsNullOrWhiteSpace(e))
            {
                var r = NewManualRow(row, sheet.Headers);
                r.Set("SECTION", section);
                r.Set("ROW_TYPE", "DETAIL");
                r.Set("OPERATOR", c);
                r.Set("TYPE", d);
                r.Set("QUANTITY_CONT", e);
                sheet.Rows.Add(r);
            }
        }

        if (sheet.Rows.Count == 0)
            sheet.Warnings.Add("No General summary rows found.");

        return sheet;
    }

    private static ExcelSheetPreview ReadGeneralStatusWorksheet(ExcelWorksheet ws)
    {
        var sheet = NewSheet(ws, ImportTarget.GeneralStatus);
        if (ws.Dimension is null)
        {
            sheet.Warnings.Add("Empty sheet.");
            return sheet;
        }

        var headerRow = FindGeneralStatusHeaderRow(ws);
        sheet.HeaderRow = headerRow;
        if (headerRow <= 0)
        {
            sheet.Target = ImportTarget.Unknown;
            sheet.Warnings.Add("General_Status header row was not found.");
            return sheet;
        }

        var headers = GeneralStatusHeaders;
        sheet.Headers.AddRange(headers);
        for (var i = 0; i < headers.Count; i++)
            sheet.HeaderColumns.Add(new ExcelHeaderColumn(headers[i], NormalizeKey(headers[i]), i + 1));

        for (var row = headerRow + 2; row <= ws.Dimension.End.Row; row++)
        {
            var values = new[] { ws.Cells[row, 1].Text, ws.Cells[row, 2].Text, ws.Cells[row, 3].Text, ws.Cells[row, 23].Text, ws.Cells[row, 24].Text };
            if (values.All(string.IsNullOrWhiteSpace))
                continue;

            var r = NewManualRow(row, headers);
            for (var i = 0; i < headers.Count; i++)
            {
                var cell = ws.Cells[row, i + 1];
                var text = FormatCell(cell);
                r.Values[headers[i]] = text;
                r.DisplayByKey[NormalizeKey(headers[i])] = text;
                r.RawValues[NormalizeKey(headers[i])] = cell.Value;
            }
            sheet.Rows.Add(r);
        }

        return sheet;
    }

    private static ExcelSheetPreview NewSheet(ExcelWorksheet ws, ImportTarget target)
    {
        var sheet = new ExcelSheetPreview { SheetName = ws.Name, Target = target };
        ExtractReportDates(ws, sheet);
        return sheet;
    }

    private static ExcelPreviewRow ReadRow(ExcelWorksheet ws, List<ExcelHeaderColumn> headers, int row)
    {
        var previewRow = new ExcelPreviewRow { ExcelRowNumber = row };
        foreach (var h in headers)
        {
            var cell = ws.Cells[row, h.ColumnIndex];
            var raw = cell.Value;
            var text = FormatCell(cell);

            if (!string.IsNullOrWhiteSpace(text))
                previewRow.HasValue = true;

            previewRow.Values[h.OriginalHeader] = text;
            previewRow.RawValues[h.Key] = raw;
            previewRow.DisplayByKey[h.Key] = text;
        }

        return previewRow;
    }

    private static ExcelPreviewRow NewManualRow(int excelRow, IEnumerable<string> headers)
    {
        var r = new ExcelPreviewRow { ExcelRowNumber = excelRow, HasValue = true };
        foreach (var h in headers)
        {
            r.Values[h] = string.Empty;
            r.DisplayByKey[NormalizeKey(h)] = string.Empty;
            r.RawValues[NormalizeKey(h)] = null;
        }
        return r;
    }

    private static ImportTarget DetectTarget(string sheetName)
    {
        var name = NormalizeKey(sheetName);
        if (name.Contains("GATEIN")) return ImportTarget.GateIn;
        if (name.Contains("GATEOUT")) return ImportTarget.GateOut;
        if (name == "STOCK" || name.Contains("STOCK")) return ImportTarget.Stock;
        if (name.Contains("GENERALSTATUS")) return ImportTarget.GeneralStatus;
        if (name == "GENERAL" || name.Contains("GENERAL")) return ImportTarget.General;
        return ImportTarget.Unknown;
    }

    private static int FindDetailHeaderRow(ExcelWorksheet ws)
    {
        if (ws.Dimension is null)
            return -1;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 80); row++)
        {
            var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var count = 0;
            for (var col = ws.Dimension.Start.Column; col <= ws.Dimension.End.Column; col++)
            {
                var text = ws.Cells[row, col].Text?.Trim();
                if (string.IsNullOrWhiteSpace(text))
                    continue;
                count++;
                keys.Add(NormalizeKey(text));
            }

            if (count >= 6 && keys.Contains("CONTAINER") && (keys.Contains("EIR") || keys.Contains("TYPE") || keys.Contains("MOVE")))
                return row;
        }

        return -1;
    }

    private static int FindGeneralStatusHeaderRow(ExcelWorksheet ws)
    {
        if (ws.Dimension is null)
            return -1;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 80); row++)
        {
            var a = NormalizeKey(ws.Cells[row, 1].Text);
            var b = NormalizeKey(ws.Cells[row, 2].Text);
            var c = NormalizeKey(ws.Cells[row, 3].Text);
            if (a == "OPR" && b == "GRADE" && c == "STATUS")
                return row;
        }

        return -1;
    }

    private static void ExtractReportDates(ExcelWorksheet ws, ExcelSheetPreview sheet)
    {
        if (ws.Dimension is null)
            return;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 12); row++)
        {
            for (var col = ws.Dimension.Start.Column; col <= Math.Min(ws.Dimension.End.Column, 15); col++)
            {
                var text = NormalizeKey(ws.Cells[row, col].Text);
                if (text == "FROM") sheet.ReportFrom = CellDate(ws.Cells[row, col + 1]);
                if (text == "TO") sheet.ReportTo = CellDate(ws.Cells[row, col + 1]);
                if (text == "DATE") sheet.ReportDate = CellDate(ws.Cells[row, col + 2]) ?? CellDate(ws.Cells[row, col + 1]);
            }
        }

        if (sheet.ReportDate is null)
            sheet.ReportDate = sheet.ReportTo ?? sheet.ReportFrom;
    }

    private static DateTime? CellDate(ExcelRange cell)
    {
        if (cell.Value is null)
            return null;
        if (cell.Value is DateTime dt)
            return dt;
        if (cell.Value is double d && d > 20000 && d < 90000)
            return DateTime.FromOADate(d);

        var text = cell.Text?.Trim();
        if (DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt))
            return dt;
        if (DateTime.TryParse(text, new CultureInfo("vi-VN"), DateTimeStyles.None, out dt))
            return dt;
        return null;
    }

    private IEnumerable<ExcelPreviewRow> FilteredRows(ExcelSheetPreview sheet)
    {
        var rows = sheet.Rows.AsEnumerable();

        if (_onlyProblem)
            rows = rows.Where(r => !CanImportRow(sheet, r));

        if (!string.IsNullOrWhiteSpace(_previewSearch))
        {
            var q = _previewSearch.Trim();
            rows = rows.Where(r => r.Values.Any(v => !string.IsNullOrWhiteSpace(v.Value) && v.Value.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        return rows;
    }

    private List<string> VisibleHeaders(ExcelSheetPreview sheet)
    {
        if (_showAllColumns)
            return sheet.Headers;

        string[] preferred = sheet.Target switch
        {
            ImportTarget.GateIn => new[] { "Seq", "EIR", "Date in", "Time", "Container", "Type", "ISO SZTP", "Opt", "F/E", "Move", "Location", "Bill of lading", "Consignee", "Truck", "Seal No", "VGM", "Remark", "Status", "Grade", "Note", "Ins Date" },
            ImportTarget.GateOut => new[] { "SEQ", "EIR", "Date in", "Time", "Container", "Type", "ISO SZTP", "Opt", "F/E", "Move", "Location", "Booking", "Vessel", "Voyage", "POL", "POD", "Shipper", "SealNo", "VGM", "TruckNo", "TruckerPhone", "Grade", "DateOut", "Days", "Remark" },
            ImportTarget.Stock => new[] { "Seq", "Container", "Type", "ISO Type", "Opr", "F/E", "Move", "Date in", "Time", "Consignee", "Position", "Days", "Location", "Status", "Grade", "Clean Status", "Shipper", "Booking" },
            ImportTarget.General => new[] { "SECTION", "ROW_TYPE", "OPERATOR", "TYPE", "QUANTITY_CONT", "TEU" },
            ImportTarget.GeneralStatus => new[] { "OPR", "Grade", "Status", "20_DC", "40HC_DC", "Total_20", "Total_40", "CONT", "TEUS" },
            _ => sheet.Headers.ToArray()
        };

        var result = new List<string>();
        foreach (var header in preferred)
        {
            var key = NormalizeKey(header);
            var match = sheet.HeaderColumns.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (match is not null && !result.Contains(match.OriginalHeader, StringComparer.OrdinalIgnoreCase))
                result.Add(match.OriginalHeader);
            else if (sheet.Headers.Contains(header, StringComparer.OrdinalIgnoreCase))
                result.Add(header);
        }

        return result.Count > 0 ? result : sheet.Headers;
    }

    private int ImportableRows(ExcelSheetPreview sheet) => sheet.Target == ImportTarget.Unknown ? 0 : sheet.Rows.Count(r => CanImportRow(sheet, r));
    private int InvalidRows(ExcelSheetPreview sheet) => sheet.Target == ImportTarget.Unknown ? sheet.Rows.Count : sheet.Rows.Count(r => !HasRequiredBusinessKey(sheet, r));
    private int ExistingRows(ExcelSheetPreview sheet) => sheet.Rows.Count(r => r.IsExisting);
    private int BatchDuplicateRows(ExcelSheetPreview sheet) => sheet.Rows.Count(r => r.IsBatchDuplicate);

    private static bool CanImportRow(ExcelSheetPreview sheet, ExcelPreviewRow row)
        => HasRequiredBusinessKey(sheet, row) && !row.IsExisting && !row.IsBatchDuplicate;

    private static bool HasRequiredBusinessKey(ExcelSheetPreview sheet, ExcelPreviewRow row)
    {
        if (sheet.Target == ImportTarget.Unknown)
            return false;

        return sheet.Target switch
        {
            ImportTarget.GateIn or ImportTarget.GateOut or ImportTarget.Stock => !string.IsNullOrWhiteSpace(S(row, "Container")),
            ImportTarget.General => !string.IsNullOrWhiteSpace(S(row, "SECTION")),
            ImportTarget.GeneralStatus => !string.IsNullOrWhiteSpace(S(row, "OPR")) || !string.IsNullOrWhiteSpace(S(row, "CONT")) || !string.IsNullOrWhiteSpace(S(row, "TEUS")),
            _ => false
        };
    }

    private static bool IsFooterRow(ExcelPreviewRow row)
    {
        var seq = S(row, "Seq", "SEQ");
        var container = S(row, "Container");
        var type = S(row, "Type");
        return string.IsNullOrWhiteSpace(container)
               && (seq.Contains("Total", StringComparison.OrdinalIgnoreCase)
                   || type.Contains("Size type", StringComparison.OrdinalIgnoreCase)
                   || row.Values.Values.Any(v => v.Equals("Total", StringComparison.OrdinalIgnoreCase)));
    }

    private static bool IsSectionName(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        var key = NormalizeKey(text);
        return key is "GATEIN" or "GATEOUT" or "STOCK" or "STUFF" or "UNSTUFF";
    }

    private static Color SheetColor(ExcelSheetPreview sheet)
    {
        if (sheet.Target == ImportTarget.Unknown) return Color.Error;
        if (sheet.Rows.Count == 0) return Color.Warning;
        if (sheet.Rows.Any(r => r.IsExisting)) return Color.Info;
        if (sheet.Rows.Any(r => r.IsBatchDuplicate) || sheet.Rows.Any(r => !HasRequiredBusinessKey(sheet, r))) return Color.Warning;
        return Color.Success;
    }

    private static string SheetStatus(ExcelSheetPreview sheet)
    {
        if (sheet.Target == ImportTarget.Unknown) return "Not imported";
        if (sheet.Rows.Count == 0) return "No rows";
        if (sheet.Rows.Any(r => r.IsExisting)) return "Has existing DB rows";
        if (sheet.Rows.Any(r => r.IsBatchDuplicate)) return "Has file duplicate rows";
        if (sheet.Rows.Any(r => !HasRequiredBusinessKey(sheet, r))) return "Needs review";
        return "Ready";
    }

