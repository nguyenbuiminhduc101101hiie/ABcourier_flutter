    private async Task<int> InsertPayloadsAsync(List<ImportPayload> payloads)
    {
        if (payloads.Count == 0)
            return 0;

        var inserted = 0;
        var now = DateTime.Now;
        await using var db = await DbFactory.CreateDbContextAsync();
        await using var tran = await db.Database.BeginTransactionAsync();

        foreach (var payload in payloads)
        {
            var existing = await LoadExistingSignaturesAsync(db, payload.TableName, new List<string> { payload.Signature });
            if (existing.Contains(payload.Signature))
                continue;

            await using var cmd = db.Database.GetDbConnection().CreateCommand();
            if (db.Database.CurrentTransaction is not null)
                cmd.Transaction = db.Database.CurrentTransaction.GetDbTransaction();
            if (cmd.Connection!.State != ConnectionState.Open)
                await cmd.Connection.OpenAsync();

            var values = new Dictionary<string, object?>(payload.Values, StringComparer.OrdinalIgnoreCase)
            {
                ["ID"] = Guid.NewGuid(),
                ["SOURCE_FILE"] = payload.SourceFile,
                ["SHEET_NAME"] = payload.SheetName,
                ["EXCEL_ROW"] = payload.ExcelRowNumber,
                ["RAW_JSON"] = payload.RawJson,
                ["ROW_SIGNATURE"] = payload.Signature,
                ["DATE_IMPORT"] = now,
                ["USER_IMPORT"] = _usr,
                ["CREATED_AT"] = now
            };

            var cols = values.Keys.ToList();
            var paramNames = new List<string>();
            for (var i = 0; i < cols.Count; i++)
            {
                var p = cmd.CreateParameter();
                p.ParameterName = "@p" + i;
                p.Value = values[cols[i]] ?? DBNull.Value;
                cmd.Parameters.Add(p);
                paramNames.Add(p.ParameterName);
            }

            cmd.CommandText = $"INSERT INTO dbo.{QuoteName(payload.TableName)} ({string.Join(",", cols.Select(QuoteName))}) VALUES ({string.Join(",", paramNames)});";
            inserted += await cmd.ExecuteNonQueryAsync();
        }

        await tran.CommitAsync();
        return inserted;
    }

    private static async Task<HashSet<string>> LoadExistingSignaturesAsync(AppDbContext db, string tableName, List<string> signatures)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (signatures.Count == 0)
            return result;

        foreach (var chunk in Chunk(signatures, 200))
        {
            await using var cmd = db.Database.GetDbConnection().CreateCommand();
            if (db.Database.CurrentTransaction is not null)
                cmd.Transaction = db.Database.CurrentTransaction.GetDbTransaction();
            if (cmd.Connection!.State != ConnectionState.Open)
                await cmd.Connection.OpenAsync();

            var pNames = new List<string>();
            for (var i = 0; i < chunk.Count; i++)
            {
                var p = cmd.CreateParameter();
                p.ParameterName = "@s" + i;
                p.Value = chunk[i];
                cmd.Parameters.Add(p);
                pNames.Add(p.ParameterName);
            }

            cmd.CommandText = $"SELECT ROW_SIGNATURE FROM dbo.{QuoteName(tableName)} WITH (NOLOCK) WHERE ROW_SIGNATURE IN ({string.Join(",", pNames)});";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
                result.Add(reader.GetString(0));
        }

        return result;
    }

    private static string ComputeSignature(ImportTarget target, Dictionary<string, object?> values)
    {
        var ordered = BusinessColumns(target).Where(values.ContainsKey).Select(c => Canon(values[c]));
        var input = target + "|" + string.Join("␟", ordered);
        using var sha = SHA256.Create();
        return Convert.ToHexString(sha.ComputeHash(Encoding.UTF8.GetBytes(input)));
    }

    private static IEnumerable<string> BusinessColumns(ImportTarget target) => target switch
    {
        ImportTarget.GateIn => GateInSqlColumns,
        ImportTarget.GateOut => GateOutSqlColumns,
        ImportTarget.Stock => StockSqlColumns,
        ImportTarget.General => GeneralSqlColumns,
        ImportTarget.GeneralStatus => GeneralStatusSqlColumns,
        _ => Array.Empty<string>()
    };

