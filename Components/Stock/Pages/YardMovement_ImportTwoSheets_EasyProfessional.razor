            if (db.Database.CurrentTransaction is not null)
                cmd.Transaction = db.Database.CurrentTransaction.GetDbTransaction();
            if (cmd.Connection!.State != System.Data.ConnectionState.Open)
                await cmd.Connection.OpenAsync();

            var placeholders = new List<string>();
            var depotParam = cmd.CreateParameter();
            depotParam.ParameterName = "@Depot";
            depotParam.Value = string.IsNullOrWhiteSpace(depot) ? DBNull.Value : depot.Trim();
            cmd.Parameters.Add(depotParam);

            for (var i = 0; i < chunk.Count; i++)
            {
                var pName = "@Id" + i;
                placeholders.Add(pName);
                var p = cmd.CreateParameter();
                p.ParameterName = pName;
                p.Value = Guid.Parse(chunk[i]);
                cmd.Parameters.Add(p);
            }

            cmd.CommandText = $"UPDATE {QuoteName(table.SchemaName)}.{QuoteName(table.TableName)} SET DEPOT = @Depot WHERE Id IN ({string.Join(",", placeholders)});";
            await cmd.ExecuteNonQueryAsync();
        }
    }

    private static async Task<Dictionary<Guid, string>> LoadDepotMapAsync<T>(AppDbContext db, IEnumerable<Guid> ids) where T : class
    {
        var result = new Dictionary<Guid, string>();
        var idList = ids.Where(x => x != Guid.Empty).Distinct().ToList();
        if (idList.Count == 0)
            return result;

        var table = GetMappedTable<T>(db);
        foreach (var chunk in Chunk(idList.Select(x => x.ToString()).ToList(), 200))
        {
            await using var cmd = db.Database.GetDbConnection().CreateCommand();
            if (db.Database.CurrentTransaction is not null)
                cmd.Transaction = db.Database.CurrentTransaction.GetDbTransaction();
            if (cmd.Connection!.State != System.Data.ConnectionState.Open)
                await cmd.Connection.OpenAsync();

            var placeholders = new List<string>();
            for (var i = 0; i < chunk.Count; i++)
            {
                var pName = "@Id" + i;
                placeholders.Add(pName);
                var p = cmd.CreateParameter();
                p.ParameterName = pName;
                p.Value = Guid.Parse(chunk[i]);
                cmd.Parameters.Add(p);
            }

            cmd.CommandText = $"SELECT Id, DEPOT FROM {QuoteName(table.SchemaName)}.{QuoteName(table.TableName)} WITH (NOLOCK) WHERE Id IN ({string.Join(",", placeholders)});";
            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var id = reader.GetGuid(0);
                var depot = reader.IsDBNull(1) ? string.Empty : Convert.ToString(reader.GetValue(1)) ?? string.Empty;
                result[id] = depot.Trim();
            }
        }

        return result;
    }

    private static (string SchemaName, string TableName) GetMappedTable<T>(AppDbContext db) where T : class
    {
        var entityType = db.Model.FindEntityType(typeof(T))
            ?? throw new InvalidOperationException($"EF mapping was not found for {typeof(T).Name}.");

        var tableName = entityType.GetTableName()
            ?? throw new InvalidOperationException($"Table name was not found for {typeof(T).Name}.");

        var schemaName = entityType.GetSchema() ?? "dbo";
        return (schemaName, tableName);
    }

    private static string QuoteName(string value) => "[" + value.Replace("]", "]]", StringComparison.Ordinal) + "]";

    private static IEnumerable<List<string>> Chunk(List<string> values, int size)
    {
        for (var i = 0; i < values.Count; i += size)
            yield return values.Skip(i).Take(size).ToList();
    }

    private static Expression<Func<M_YardMovement_AMS_26040816_Current_In_Yard2, bool>> BuildCurrentItemNoFilter(List<string> values)
    {
        var parameter = Expression.Parameter(typeof(M_YardMovement_AMS_26040816_Current_In_Yard2), "x");
        var property = Expression.PropertyOrField(parameter, nameof(M_YardMovement_AMS_26040816_Current_In_Yard2.ITEM_NO));
        Expression body = Expression.Constant(false);

        foreach (var value in values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v.Trim()).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var constant = Expression.Constant(value, typeof(string));
            body = Expression.OrElse(body, Expression.Equal(property, constant));
        }

        return Expression.Lambda<Func<M_YardMovement_AMS_26040816_Current_In_Yard2, bool>>(body, parameter);
    }

    private static Expression<Func<M_8_3_IN_OUT_YARD_1, bool>> BuildInOutSoContFilter(List<string> values)
    {
        var parameter = Expression.Parameter(typeof(M_8_3_IN_OUT_YARD_1), "x");
        var property = Expression.PropertyOrField(parameter, nameof(M_8_3_IN_OUT_YARD_1.SOCONT));
        Expression body = Expression.Constant(false);

        foreach (var value in values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v.Trim()).Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var constant = Expression.Constant(value, typeof(string));
            body = Expression.OrElse(body, Expression.Equal(property, constant));
        }

        return Expression.Lambda<Func<M_8_3_IN_OUT_YARD_1, bool>>(body, parameter);
    }


    private static string S(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (row.DisplayByKey.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value))
                return value.Trim();

            if (row.RawValues.TryGetValue(key, out var raw) && raw is not null)
                return Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim() ?? string.Empty;
        }

        return string.Empty;
    }

    private static decimal? D(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!row.RawValues.TryGetValue(key, out var raw) || raw is null)
                continue;

            if (raw is decimal dec)
                return dec;
            if (raw is double d)
                return Convert.ToDecimal(d);
            if (raw is int i)
                return i;

            var text = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();
            if (string.IsNullOrWhiteSpace(text))
                continue;

            text = text.Replace(",", "");
            if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
                return v;
            if (decimal.TryParse(text, NumberStyles.Any, new CultureInfo("vi-VN"), out v))
                return v;
        }

        return null;
    }

    private static DateTime? DT(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!row.RawValues.TryGetValue(key, out var raw) || raw is null)
                continue;

            if (raw is DateTime dt)
                return dt;

            if (raw is double serial && serial > 20000 && serial < 90000)
                return DateTime.FromOADate(serial);

            var text = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();
            if (string.IsNullOrWhiteSpace(text))
                continue;

            if (DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt))
                return dt;
            if (DateTime.TryParse(text, new CultureInfo("vi-VN"), DateTimeStyles.None, out dt))
                return dt;
        }

        return null;
    }

    private static string MergeNote(ExcelPreviewRow row, HashSet<string> knownKeys, string baseNote)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(baseNote))
            parts.Add(baseNote.Trim());

        foreach (var pair in row.DisplayByKey)
        {
            if (knownKeys.Contains(pair.Key))
                continue;
            if (string.IsNullOrWhiteSpace(pair.Value))
                continue;

            parts.Add($"{pair.Key}: {pair.Value.Trim()}");
        }

        return string.Join("; ", parts.Distinct());
    }

    private static string FormatCell(ExcelRange cell)
    {
        if (cell.Value is null)
            return string.Empty;

        if (cell.Value is DateTime dt)
            return dt.ToString("dd/MM/yyyy HH:mm:ss");

        return cell.Text?.Trim() ?? Convert.ToString(cell.Value, CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private static string CellText(ExcelPreviewRow row, string header)
        => row.Values.TryGetValue(header, out var value) ? value : string.Empty;

    private static string MakeUniqueHeader(List<string> existing, string header)
    {
        if (!existing.Contains(header, StringComparer.OrdinalIgnoreCase))
            return header;

        var i = 2;
        var candidate = $"{header}_{i}";
        while (existing.Contains(candidate, StringComparer.OrdinalIgnoreCase))
        {
            i++;
            candidate = $"{header}_{i}";
        }

        return candidate;
    }

    private static string NormalizeKey(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var chars = text.Trim().ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray();
        return new string(chars);
    }

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;
        return value.Length <= maxLength ? value : value[..maxLength];
    }

    private static string RootMessage(Exception ex)
    {
        var root = ex;
        while (root.InnerException is not null)
            root = root.InnerException;
        return root.Message;
    }

    private static bool _epplusConfigured;
    private static void ConfigureEpplusLicense()
    {
        if (_epplusConfigured)
            return;

        try
        {
            var licenseProperty = typeof(ExcelPackage).GetProperty("License");
            var license = licenseProperty?.GetValue(null);
            var method = license?.GetType().GetMethod("SetNonCommercialOrganization");
            if (method is not null)
                method.Invoke(license, new object[] { "Logistics Management Software" });
            else
            {
                var contextProperty = typeof(ExcelPackage).GetProperty("LicenseContext");
                if (contextProperty is not null && contextProperty.PropertyType.IsEnum)
                {
                    var value = Enum.Parse(contextProperty.PropertyType, "NonCommercial");
                    contextProperty.SetValue(null, value);
                }
            }
        }
        catch
        {
            // EPPlus will throw a clear error if runtime still requires license setup.
        }

        _epplusConfigured = true;
    }

