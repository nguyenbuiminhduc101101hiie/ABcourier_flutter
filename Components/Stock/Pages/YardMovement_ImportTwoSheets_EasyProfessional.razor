    private static Color SheetColor(ExcelSheetPreview sheet)
    {
        if (sheet.Target == ImportTarget.Unknown)
            return Color.Error;
        if (sheet.Rows.Count == 0)
            return Color.Warning;
        if (sheet.Rows.Any(r => r.IsExisting))
            return Color.Info;
        if (sheet.Rows.Any(r => r.IsBatchDuplicate) || sheet.Rows.Count(r => !HasRequiredContainer(sheet, r)) > 0)
            return Color.Warning;
        return Color.Success;
    }

    private static string SheetStatus(ExcelSheetPreview sheet)
    {
        if (sheet.Target == ImportTarget.Unknown)
            return "Not imported";
        if (sheet.Rows.Count == 0)
            return "No rows";
        if (sheet.Rows.Any(r => r.IsExisting))
            return "Has existing DB rows";
        if (sheet.Rows.Any(r => r.IsBatchDuplicate))
            return "Has file duplicate rows";
        if (sheet.Rows.Count(r => !HasRequiredContainer(sheet, r)) > 0)
            return "Needs review";
        return "Ready";
    }

