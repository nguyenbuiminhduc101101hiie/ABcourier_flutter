    private static ImportPreview ReadPreview(byte[] bytes, string fileName)
    {
        ConfigureEpplusLicense();
        using var ms = new MemoryStream(bytes);
        using var package = new ExcelPackage(ms);

        var preview = new ImportPreview { FileName = fileName };
        foreach (var ws in package.Workbook.Worksheets)
        {
            var sheet = ReadWorksheet(ws);
            preview.Sheets.Add(sheet);
        }

        return preview;
    }

    private static ExcelSheetPreview ReadWorksheet(ExcelWorksheet ws)
    {
        var sheet = new ExcelSheetPreview { SheetName = ws.Name };

        if (ws.Dimension is null)
        {
            sheet.Target = ImportTarget.Unknown;
            sheet.Warnings.Add("Empty sheet.");
            return sheet;
        }

        var headerRow = FindHeaderRow(ws);
        sheet.HeaderRow = headerRow;
        if (headerRow <= 0)
        {
            sheet.Target = ImportTarget.Unknown;
            sheet.Warnings.Add("Header row was not found.");
            return sheet;
        }

        var startCol = ws.Dimension.Start.Column;
        var endCol = ws.Dimension.End.Column;
        var endRow = ws.Dimension.End.Row;

        for (var col = startCol; col <= endCol; col++)
        {
            var header = ws.Cells[headerRow, col].Text?.Trim();
            if (string.IsNullOrWhiteSpace(header))
                header = $"Column_{col}";

            header = MakeUniqueHeader(sheet.Headers, header);
            sheet.Headers.Add(header);
            sheet.HeaderColumns.Add(new ExcelHeaderColumn(header, NormalizeKey(header), col));
        }

        sheet.Target = DetectTarget(sheet);

        for (var row = headerRow + 1; row <= endRow; row++)
        {
            var previewRow = new ExcelPreviewRow { ExcelRowNumber = row };
            var hasValue = false;

            foreach (var h in sheet.HeaderColumns)
            {
                var cell = ws.Cells[row, h.ColumnIndex];
                var raw = cell.Value;
                var text = FormatCell(cell);

                if (!string.IsNullOrWhiteSpace(text))
                    hasValue = true;

                previewRow.Values[h.OriginalHeader] = text;
                previewRow.RawValues[h.Key] = raw;
                previewRow.DisplayByKey[h.Key] = text;
            }

            if (hasValue)
                sheet.Rows.Add(previewRow);
        }

        if (sheet.Target == ImportTarget.Unknown)
            sheet.Warnings.Add("This sheet does not match Current In Yard or In/Out Yard structure, so it will not be imported.");

        if (sheet.Target == ImportTarget.CurrentInYard && !sheet.HeaderColumns.Any(x => x.Key is "ITEMNO" or "SOCONT"))
            sheet.Warnings.Add("ITEM_NO/SOCONT was not found. Rows without container number will be skipped.");

        if (sheet.Target == ImportTarget.InOutYard && !sheet.HeaderColumns.Any(x => x.Key is "SOCONT" or "ITEMNO"))
            sheet.Warnings.Add("SOCONT/ITEM_NO was not found. Rows without container number will be skipped.");

        return sheet;
    }

    private static int FindHeaderRow(ExcelWorksheet ws)
    {
        if (ws.Dimension is null)
            return -1;

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 50); row++)
        {
            var count = 0;
            var hasContainerHeader = false;

            for (var col = ws.Dimension.Start.Column; col <= ws.Dimension.End.Column; col++)
            {
                var text = ws.Cells[row, col].Text?.Trim();
                if (string.IsNullOrWhiteSpace(text))
                    continue;

                count++;
                var key = NormalizeKey(text);
                if (key is "SOCONT" or "ITEMNO" or "ITEMKEY" or "CONTAINERNO" or "CNTRNO")
                    hasContainerHeader = true;
            }

            if (count >= 3 && hasContainerHeader)
                return row;
        }

        for (var row = ws.Dimension.Start.Row; row <= Math.Min(ws.Dimension.End.Row, 50); row++)
        {
            var count = 0;
            for (var col = ws.Dimension.Start.Column; col <= ws.Dimension.End.Column; col++)
            {
                if (!string.IsNullOrWhiteSpace(ws.Cells[row, col].Text))
                    count++;
            }

            if (count >= 3)
                return row;
        }

        return -1;
    }

    private static ImportTarget DetectTarget(ExcelSheetPreview sheet)
    {
        var name = NormalizeKey(sheet.SheetName);
        var keys = sheet.HeaderColumns.Select(x => x.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (name.Contains("CURRENTINYARD") || name.Contains("CURRENT") || (keys.Contains("ISO") && keys.Contains("VITRI")))
            return ImportTarget.CurrentInYard;

        if (name.Contains("INOUTYARD") || name.Contains("INOUT") || keys.Contains("METHOD") || keys.Contains("EXECTS") || keys.Contains("KICHCO"))
            return ImportTarget.InOutYard;

        if (keys.Contains("ITEMNO") && keys.Contains("ISO"))
            return ImportTarget.CurrentInYard;

        if (keys.Contains("SOCONT") && keys.Contains("TRANGTHAI") && keys.Contains("KICHCO"))
            return ImportTarget.InOutYard;

        return ImportTarget.Unknown;
    }

    private IEnumerable<ExcelPreviewRow> FilteredRows(ExcelSheetPreview sheet)
    {
        var rows = sheet.Rows.AsEnumerable();

        if (_onlyInvalid)
            rows = rows.Where(r => !CanImportRow(sheet, r));

        if (!string.IsNullOrWhiteSpace(_previewSearch))
        {
            var q = _previewSearch.Trim();
            rows = rows.Where(r => r.Values.Any(v => !string.IsNullOrWhiteSpace(v.Value) && v.Value.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        return rows;
    }

    private List<string> VisibleHeaders(ExcelSheetPreview sheet)
    {
        if (_showAllColumns)
            return sheet.Headers;

        string[] preferred = sheet.Target switch
        {
            ImportTarget.CurrentInYard => new[] { "AGENT", "LINE", "ITEMKEY", "SOCONT", "ITEMNO", "ISO", "TRANGTHAI", "FEL", "BOOKNO", "BILLOFLADING", "VITRI", "LOCATION", "KHUVUC", "NGAYNHAPBAI", "NGAYROIBAI", "SOSEAL", "GHICHU" },
            ImportTarget.InOutYard => new[] { "METHOD", "EXECTS", "LINE", "ITEMKEY", "SOCONT", "KICHCO", "TRANGTHAI", "TRONGLUONG", "TRONGLUONGVGM", "BLNO", "BOOKNO", "HUONG", "CANGDEN", "GIAO", "NHAN", "SOSEAL", "GHICHU" },
            _ => sheet.Headers.Select(NormalizeKey).ToArray()
        };

        var result = new List<string>();
        foreach (var key in preferred)
        {
            var match = sheet.HeaderColumns.FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));
            if (match is not null && !result.Contains(match.OriginalHeader, StringComparer.OrdinalIgnoreCase))
                result.Add(match.OriginalHeader);
        }

        return result.Count > 0 ? result : sheet.Headers;
    }

