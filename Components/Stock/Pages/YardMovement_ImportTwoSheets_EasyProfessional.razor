@page "/YardMovementImportPro"
@attribute [Authorize]
@using System.Globalization
@using System.Data.Common
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Storage
@using MudBlazor
@using OfficeOpenXml
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar

<PageTitle>8.3.4 Import Yard Movement CAT LAI</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="ym-pro-page pa-3">
    <MudPaper Class="hero-card pa-4 mb-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" lg="8">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                    <div class="hero-icon">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h5" Class="page-title">8.3.4 Import Container / Yard Movement CAT LAI</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Select depot → choose Excel → preview Sheet1/Sheet2 → check existing database rows by all business columns including DEPOT → import new rows only.
                        </MudText>
                    </div>
                </MudStack>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="flex-wrap action-bar">
                    <MudAutocomplete T="string"
                                     @bind-Value="_importDepot"
                                     Label="Depot name"
                                     Placeholder="Select depot before preview"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Style="min-width:220px;background:#fff;border-radius:10px;"
                                     Disabled="@(_busy || _preview is not null)"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Warehouse"
                                     SearchFunc="SearchTerminal"
                                     CoerceText
                                     ResetValueOnEmptyText
                                     Clearable
                                     MaxItems="30" />

                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               Disabled="@_busy">
                        Choose Excel file
                        <InputFile OnChange="PreviewExcelAsync" accept=".xlsx" style="display:none" />
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CloudUpload"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || _preview is null || !_preview.HasImportableRows)">
                        Import DB
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               OnClick="ClearPreview"
                               Disabled="@_busy">
                        Reset
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.caption">Preview file</MudText>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold ellipsis">@(_preview?.FileName ?? "No file selected")</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Info" />
                    <div>
                        <MudText Typo="Typo.caption">Current In Yard</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@CurrentRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">ITEM_NO / ISO / FEL</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.caption">In / Out Yard</MudText>
                        <MudText Typo="Typo.h6" Class="fw-bold">@InOutRowsCount.ToString("N0")</MudText>
                        <MudText Typo="Typo.caption">SOCONT / KICHCO / TRANGTHAI</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="kpi-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@StatusIcon" Color="@StatusColor" />
                    <div>
                        <MudText Typo="Typo.caption">Status</MudText>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@StatusText</MudText>
                        <MudText Typo="Typo.caption">@ValidationText</MudText>
                    </div>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_busy)
    {
        <MudPaper Class="pa-4 mb-3 process-card" Elevation="0">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="mt-2">Processing file, please wait...</MudText>
        </MudPaper>
    }

    @if (_preview is null)
    {
        <MudPaper Class="empty-card pa-6" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="fw-bold">Start by choosing an Excel file</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Enter <b>Depot name</b> first. The system will read <b>IN-OUT_YARD_1</b> and <b>Current_In_Yard2</b>, then preview all columns before import.
                </MudText>
                <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@_busy">
                    Choose Excel to preview
                    <InputFile OnChange="PreviewExcelAsync" accept=".xlsx" style="display:none" />
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="control-card pa-3 mb-3" Elevation="0">
            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_previewSearch"
                                  Label="Search preview"
                                  Placeholder="Container, booking, line, depot, location..."
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="int" @bind-Value="_previewLimit" Label="Preview rows" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int" Value="@(50)">50 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(100)">100 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(200)">200 rows</MudSelectItem>
                        <MudSelectItem T="int" Value="@(500)">500 rows</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudCheckBox T="bool" @bind-Value="_showAllColumns" Label="Show all columns" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudCheckBox T="bool" @bind-Value="_onlyInvalid" Label="Invalid rows only" Color="Color.Warning" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudButton FullWidth="true"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               OnClick="ConfirmImportAsync"
                               Disabled="@(_busy || _preview is null || !_preview.HasImportableRows)">
                        Confirm import
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid Spacing="2" Class="mb-3">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="sheet-summary-card pa-3" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="gap-2">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@sheet.SheetName</MudText>
                                <MudText Typo="Typo.caption">Target: <b>@TargetShortLabel(sheet.Target)</b></MudText><br />
                                <MudText Typo="Typo.caption">Header row: @sheet.HeaderRow · Columns: @sheet.Headers.Count · Rows: @sheet.Rows.Count.ToString("N0")</MudText>
                            </div>
                            <MudChip T="string" Color="@SheetColor(sheet)" Variant="Variant.Filled" Size="Size.Small">@SheetStatus(sheet)</MudChip>
                        </MudStack>

                        <MudDivider Class="my-2" />
                        <MudGrid Spacing="1">
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">New rows</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-ok">@ValidRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Existing DB</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-info">@ExistingRows(sheet).ToString("N0")</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Duplicate/Error</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold text-warn">@((BatchDuplicateRows(sheet) + InvalidRows(sheet)).ToString("N0"))</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudText Typo="Typo.caption">Extra columns</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@ExtraColumnCount(sheet).ToString("N0")</MudText>
                            </MudItem>
                        </MudGrid>

                        @if (sheet.Warnings.Count > 0)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mt-2">
                                @foreach (var w in sheet.Warnings)
                                {
                                    <div>@w</div>
                                }
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudTabs @bind-ActivePanelIndex="_activeSheetTab" Class="preview-tabs">
            @foreach (var sheet in _preview.Sheets)
            {
                <MudTabPanel Text="@SheetTabTitle(sheet)">
                    <MudPaper Class="preview-card pa-3" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
                            <div>
                                <MudText Typo="Typo.h6" Class="fw-bold">@sheet.SheetName</MudText>
                                <MudText Typo="Typo.caption">
                                    @TargetLongLabel(sheet.Target) · Preview @FilteredRows(sheet).Count().ToString("N0") rows / total @sheet.Rows.Count.ToString("N0") rows
                                </MudText>
                            </div>
                            <MudChip T="string" Color="@SheetColor(sheet)" Variant="Variant.Filled">@SheetStatus(sheet)</MudChip>
                        </MudStack>

                        @if (sheet.Rows.Count == 0)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
                                This sheet has no data. If the Excel file contains data, please check the header row and data range.
                            </MudAlert>
                        }
                        else
                        {
                            <div class="preview-table-wrap">
                                <MudTable T="ExcelPreviewRow" Items="FilteredRows(sheet).Take(_previewLimit).ToList()" Dense="true" Hover="true" Bordered="true" Striped="true" Class="preview-table">
                                    <HeaderContent>
                                        <MudTh Class="sticky-col">#</MudTh>
                                        <MudTh>Import?</MudTh>
                                        @foreach (var header in VisibleHeaders(sheet))
                                        {
                                            <MudTh>@header</MudTh>
                                        }
                                    </HeaderContent>
                                    <RowTemplate Context="row">
                                        <MudTd Class="sticky-col">@row.ExcelRowNumber</MudTd>
                                        <MudTd>
                                            @if (CanImportRow(sheet, row))
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">New</MudChip>
                                            }
                                            else if (row.IsExisting)
                                            {
                                                <MudTooltip Text="@row.StatusMessage">
                                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Existing DB</MudChip>
                                                </MudTooltip>
                                            }
                                            else if (row.IsBatchDuplicate)
                                            {
                                                <MudTooltip Text="@row.StatusMessage">
                                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">File duplicate</MudChip>
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Thiếu số cont</MudChip>
                                            }
                                        </MudTd>
                                        @foreach (var header in VisibleHeaders(sheet))
                                        {
                                            <MudTd>@CellText(row, header)</MudTd>
                                        }
                                    </RowTemplate>
                                </MudTable>
                            </div>

                            @if (FilteredRows(sheet).Count() > _previewLimit)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    Showing @_previewLimit.ToString("N0") first rows. When importing, the system imports all valid rows.
                                </MudText>
                            }
                        }
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    private const string PermissionMenuName = "Inventory";

    private bool _busy;
    private bool _canAdd;
    private string _usr = string.Empty;
    private string _importDepot = string.Empty;
    private List<Terminal_> _terminals = new();
    private ImportPreview? _preview;
    private byte[]? _fileBytes;

    private int _activeSheetTab;
    private int _previewLimit = 100;
    private bool _showAllColumns = true;
    private bool _onlyInvalid;
    private string _previewSearch = string.Empty;

    private int CurrentRowsCount => _preview?.Sheets.Where(x => x.Target == ImportTarget.CurrentInYard).Sum(ValidRows) ?? 0;
    private int InOutRowsCount => _preview?.Sheets.Where(x => x.Target == ImportTarget.InOutYard).Sum(ValidRows) ?? 0;
    private int InvalidTotal => _preview?.Sheets.Sum(InvalidRows) ?? 0;
    private int ExistingTotal => _preview?.Sheets.Sum(ExistingRows) ?? 0;
    private int BatchDuplicateTotal => _preview?.Sheets.Sum(BatchDuplicateRows) ?? 0;
    private int ImportableTotal => _preview?.Sheets.Sum(ValidRows) ?? 0;
    private string StatusText => _preview is null ? "No file selected" : (_preview.HasImportableRows ? "Ready to import" : "No new rows to import");
    private string ValidationText => _preview is null ? $"Depot: {DisplayDepot}" : $"Depot {DisplayDepot} · New {ImportableTotal:N0} · Existing DB {ExistingTotal:N0} · File duplicate {BatchDuplicateTotal:N0} · Errors {InvalidTotal:N0}";
    private string DisplayDepot => string.IsNullOrWhiteSpace(_importDepot) ? "not entered" : _importDepot.Trim();
    private string StatusIcon => _preview is null ? Icons.Material.Filled.Pending : (_preview.HasImportableRows ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning);
    private Color StatusColor => _preview is null ? Color.Default : (_preview.HasImportableRows ? Color.Success : Color.Warning);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        _canAdd = await ssv.CheckPermission(_usr, "Add", PermissionMenuName);

        await using var db = await DbFactory.CreateDbContextAsync();
        _terminals = await db.Terminal
            .Where(x => !string.IsNullOrEmpty(x.TermiNalName))
            .OrderBy(x => x.TermiNalName)
            .ToListAsync();
    }

    private Task<IEnumerable<string?>> SearchTerminal(string? text)
    {
        var query = _terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName));

        if (!string.IsNullOrWhiteSpace(text))
        {
            query = query.Where(x =>
                x.TermiNalName!.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                (x.Code?.Contains(text, StringComparison.OrdinalIgnoreCase) == true));
        }

        return Task.FromResult<IEnumerable<string?>>(query.Select(x => x.TermiNalName).Distinct());
    }

    private async Task PreviewExcelAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add("You do not have permission to import Yard Movement.", MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        if (string.IsNullOrWhiteSpace(_importDepot))
        {
            Snackbar.Add("Please select Depot name before preview/import.", MudBlazor.Severity.Warning);
            return;
        }

        var file = e.File;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("This feature supports .xlsx only. Please Save As Excel Workbook and import again.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            _preview = null;
            _fileBytes = null;
            _previewSearch = string.Empty;
            _onlyInvalid = false;

            await using var stream = file.OpenReadStream(100 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _fileBytes = ms.ToArray();

            _preview = ReadPreview(_fileBytes, file.Name);
            await MarkDuplicateRowsAsync(_preview);
            _activeSheetTab = 0;

            Snackbar.Add($"Previewed {_preview.Sheets.Sum(x => x.Rows.Count):N0} rows from {_preview.Sheets.Count:N0} sheet(s). New {ImportableTotal:N0}, existing DB {ExistingTotal:N0}, file duplicates {BatchDuplicateTotal:N0}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmImportAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add("You do not have permission to import Yard Movement.", MudBlazor.Severity.Warning);
            return;
        }

        if (_preview is null)
        {
            Snackbar.Add("No Excel file selected for preview.", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_importDepot))
        {
            Snackbar.Add("Please select Depot name before import.", MudBlazor.Severity.Warning);
            return;
        }

        if (!_preview.HasImportableRows)
        {
            if (ExistingTotal > 0 || BatchDuplicateTotal > 0)
                Snackbar.Add($"Nothing imported because there are no new rows. Existing database: {ExistingTotal:N0}; file duplicates: {BatchDuplicateTotal:N0}; errors: {InvalidTotal:N0}.", MudBlazor.Severity.Info);
            else
                Snackbar.Add("No valid rows to import.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            var now = DateTime.Now;
            var currentRows = new List<M_YardMovement_AMS_26040816_Current_In_Yard2>();
            var inOutRows = new List<M_8_3_IN_OUT_YARD_1>();
            var currentSignatures = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var inOutSignatures = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var sheet in _preview.Sheets)
            {
                if (sheet.Target == ImportTarget.CurrentInYard)
                {
                    foreach (var row in sheet.Rows.Where(r => CanImportRow(sheet, r)))
                    {
                        var entity = MapCurrentInYard(row, now, _usr);
                        if (string.IsNullOrWhiteSpace(entity.ITEM_NO))
                            continue;

                        var signature = CurrentSignature(entity, _importDepot);
                        if (currentSignatures.Add(signature))
                            currentRows.Add(entity);
                        else
                        {
                            row.IsBatchDuplicate = true;
                            row.StatusMessage = "Duplicate of another row in the Excel file.";
                        }
                    }
                }
                else if (sheet.Target == ImportTarget.InOutYard)
                {
                    foreach (var row in sheet.Rows.Where(r => CanImportRow(sheet, r)))
                    {
                        var entity = MapInOutYard(row, now, _usr);
                        if (string.IsNullOrWhiteSpace(entity.SOCONT))
                            continue;

                        var signature = InOutSignature(entity, _importDepot);
                        if (inOutSignatures.Add(signature))
                            inOutRows.Add(entity);
                        else
                        {
                            row.IsBatchDuplicate = true;
                            row.StatusMessage = "Duplicate of another row in the Excel file.";
                        }
                    }
                }
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            await EnsureDepotColumnsAsync(db);
            await using var tran = await db.Database.BeginTransactionAsync();

            if (currentRows.Count > 0)
                await db.Set<M_YardMovement_AMS_26040816_Current_In_Yard2>().AddRangeAsync(currentRows);

            if (inOutRows.Count > 0)
                await db.Set<M_8_3_IN_OUT_YARD_1>().AddRangeAsync(inOutRows);

            await db.SaveChangesAsync();

            if (currentRows.Count > 0)
                await UpdateDepotForRowsAsync<M_YardMovement_AMS_26040816_Current_In_Yard2>(db, currentRows.Select(x => x.Id), _importDepot);

            if (inOutRows.Count > 0)
                await UpdateDepotForRowsAsync<M_8_3_IN_OUT_YARD_1>(db, inOutRows.Select(x => x.Id), _importDepot);

            await tran.CommitAsync();

            Snackbar.Add($"Import completed: Current In Yard {currentRows.Count:N0} rows, In/Out Yard {inOutRows.Count:N0} rows. Skipped: existing DB {ExistingTotal:N0}, file duplicates {BatchDuplicateTotal:N0}, errors {InvalidTotal:N0}.", MudBlazor.Severity.Success);
            ClearPreview();
        }
        catch (Exception ex)
        {
            Snackbar.Add(RootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearPreview()
    {
        _preview = null;
        _fileBytes = null;
        _activeSheetTab = 0;
        _previewSearch = string.Empty;
        _onlyInvalid = false;
    }

    private async Task MarkDuplicateRowsAsync(ImportPreview preview)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await EnsureDepotColumnsAsync(db);

        var currentPreview = preview.Sheets
            .Where(s => s.Target == ImportTarget.CurrentInYard)
            .SelectMany(s => s.Rows.Where(r => HasRequiredContainer(s, r)).Select(r => new { Sheet = s, Row = r, Entity = MapCurrentInYard(r, DateTime.MinValue, string.Empty) }))
            .Where(x => !string.IsNullOrWhiteSpace(x.Entity.ITEM_NO))
            .ToList();

        var inOutPreview = preview.Sheets
            .Where(s => s.Target == ImportTarget.InOutYard)
            .SelectMany(s => s.Rows.Where(r => HasRequiredContainer(s, r)).Select(r => new { Sheet = s, Row = r, Entity = MapInOutYard(r, DateTime.MinValue, string.Empty) }))
            .Where(x => !string.IsNullOrWhiteSpace(x.Entity.SOCONT))
            .ToList();

        var currentItemNos = currentPreview.Select(x => x.Entity.ITEM_NO!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var inOutSoConts = inOutPreview.Select(x => x.Entity.SOCONT!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        var existingCurrent = new List<M_YardMovement_AMS_26040816_Current_In_Yard2>();
        foreach (var chunk in Chunk(currentItemNos, 200))
        {
            var filter = BuildCurrentItemNoFilter(chunk);
            existingCurrent.AddRange(await db.Set<M_YardMovement_AMS_26040816_Current_In_Yard2>()
                .AsNoTracking()
                .Where(filter)
