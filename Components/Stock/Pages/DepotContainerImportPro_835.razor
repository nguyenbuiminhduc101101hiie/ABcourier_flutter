    private int ValidRows(ExcelSheetPreview sheet) => sheet.Rows.Count(CanImportRow);
    private int InvalidRows(ExcelSheetPreview sheet) => sheet.Rows.Count(r => !HasRequiredData(r));
    private int ExistingRows(ExcelSheetPreview sheet) => sheet.Rows.Count(r => r.IsExisting);
    private int BatchDuplicateRows(ExcelSheetPreview sheet) => sheet.Rows.Count(r => r.IsBatchDuplicate);

    private static bool CanImportRow(ExcelPreviewRow row)
        => HasRequiredData(row) && !row.IsExisting && !row.IsBatchDuplicate;

    private static bool HasRequiredData(ExcelPreviewRow row)
    {
        var soCont = S(row, "SOCONT", "SO_CONT", "ITEM_NO", "ITEMNO", "CONTAINERNO", "CNTRNO");
        var itemKey = S(row, "ITEM_KEY", "ITEMKEY");

        return !string.IsNullOrWhiteSpace(soCont) || !string.IsNullOrWhiteSpace(itemKey);
    }

    private static Color SheetColor(ExcelSheetPreview sheet)
    {
        if (sheet.Rows.Count == 0)
            return Color.Warning;

        if (sheet.Rows.Any(r => r.IsExisting))
            return Color.Info;

        if (sheet.Rows.Any(r => r.IsBatchDuplicate) || sheet.Rows.Count(r => !HasRequiredData(r)) > 0)
            return Color.Warning;

        return Color.Success;
    }

    private static string SheetStatus(ExcelSheetPreview sheet)
    {
        if (sheet.Rows.Count == 0)
            return "No rows";

        if (sheet.Rows.Any(r => r.IsExisting))
            return "Has existing DB rows";

        if (sheet.Rows.Any(r => r.IsBatchDuplicate))
            return "Has file duplicate rows";

        if (sheet.Rows.Count(r => !HasRequiredData(r)) > 0)
            return "Needs review";

        return "Ready";
    }

    private static string SheetTabTitle(ExcelSheetPreview sheet) => $"{sheet.SheetName} ({sheet.Rows.Count:N0})";

    private static bool IsSupportedExcelFile(string fileName)
    {
        return fileName.EndsWith(".xls", StringComparison.OrdinalIgnoreCase)
            || fileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);
    }

    private static IEnumerable<List<string>> Chunk(List<string> values, int size)
    {
        for (var i = 0; i < values.Count; i += size)
            yield return values.Skip(i).Take(size).ToList();
    }

    private static string S(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (row.DisplayByKey.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value))
                return value.Trim();

            if (row.RawValues.TryGetValue(key, out var raw) && raw is not null && raw != DBNull.Value)
                return Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim() ?? string.Empty;
        }

        return string.Empty;
    }

    private static decimal? D(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!row.RawValues.TryGetValue(key, out var raw) || raw is null || raw == DBNull.Value)
                continue;

            if (raw is decimal dec)
                return dec;

            if (raw is double d)
                return Convert.ToDecimal(d);

            if (raw is int i)
                return i;

            var text = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();

            if (string.IsNullOrWhiteSpace(text))
                continue;

            text = text.Replace(",", "");

            if (decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
                return v;

            if (decimal.TryParse(text, NumberStyles.Any, new CultureInfo("vi-VN"), out v))
                return v;
        }

        return null;
    }

    private static int? I(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!row.RawValues.TryGetValue(key, out var raw) || raw is null || raw == DBNull.Value)
                continue;

            if (raw is int intValue)
                return intValue;

            if (raw is double doubleValue)
                return Convert.ToInt32(doubleValue);

            var text = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();

            if (int.TryParse(text, out var result))
                return result;
        }

        return null;
    }

    private static DateTime? DT(ExcelPreviewRow row, params string[] keys)
    {
        foreach (var key in keys.Select(NormalizeKey))
        {
            if (!row.RawValues.TryGetValue(key, out var raw) || raw is null || raw == DBNull.Value)
                continue;

            if (raw is DateTime dt)
                return dt;

            if (raw is double serial && serial > 20000 && serial < 90000)
                return DateTime.FromOADate(serial);

            var text = Convert.ToString(raw, CultureInfo.InvariantCulture)?.Trim();

            if (string.IsNullOrWhiteSpace(text))
                continue;

            if (DateTime.TryParse(text, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt))
                return dt;

            if (DateTime.TryParse(text, new CultureInfo("vi-VN"), DateTimeStyles.None, out dt))
                return dt;
        }

        return null;
    }

    private static string CellText(ExcelPreviewRow row, string header)
        => row.Values.TryGetValue(header, out var value) ? value : string.Empty;

    private static string FormatValue(object? value)
    {
        if (value is null || value == DBNull.Value)
            return string.Empty;

        if (value is DateTime dt)
            return dt.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture);

        if (value is double d)
            return d.ToString("0.####", CultureInfo.InvariantCulture);

        return Convert.ToString(value, CultureInfo.InvariantCulture)?.Trim() ?? string.Empty;
    }

    private static bool IsEmptyRow(DataRow row)
    {
        return row.ItemArray.All(x =>
            x == null ||
            x == DBNull.Value ||
            string.IsNullOrWhiteSpace(Convert.ToString(x)));
    }

    private static string MakeUniqueHeader(List<string> existing, string header)
    {
        if (!existing.Contains(header, StringComparer.OrdinalIgnoreCase))
            return header;

        var i = 2;
        var candidate = $"{header}_{i}";

        while (existing.Contains(candidate, StringComparer.OrdinalIgnoreCase))
        {
            i++;
            candidate = $"{header}_{i}";
        }

        return candidate;
    }

    private static string NormalizeKey(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var chars = text.Trim().ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray();
        return new string(chars);
    }

    private static string N(string? value) => string.IsNullOrWhiteSpace(value) ? string.Empty : value.Trim();
    private static string N(decimal? value) => value.HasValue ? value.Value.ToString("0.####", CultureInfo.InvariantCulture) : string.Empty;
    private static string N(int? value) => value.HasValue ? value.Value.ToString(CultureInfo.InvariantCulture) : string.Empty;
    private static string N(DateTime? value) => value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm:ss.fffffff", CultureInfo.InvariantCulture) : string.Empty;

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value))
            return string.Empty;

        return value.Length <= maxLength ? value : value[..maxLength];
    }

    private static string RootMessage(Exception ex)
    {
        var root = ex;

        while (root.InnerException is not null)
            root = root.InnerException;

        return root.Message;
    }

    private static readonly HashSet<string> RequiredContainerKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "SOCONT", "SO_CONT", "ITEMNO", "ITEM_NO", "ITEMKEY", "ITEM_KEY", "CONTAINERNO", "CNTRNO"
    };

    private sealed class ImportPreview
    {
        public string FileName { get; set; } = string.Empty;
        public List<ExcelSheetPreview> Sheets { get; set; } = new();
        public bool HasImportableRows => Sheets.Any(x => x.Rows.Any(CanImportRow));
    }

    private sealed class ExcelSheetPreview
    {
        public string SheetName { get; set; } = string.Empty;
        public int HeaderRow { get; set; }
        public List<string> Headers { get; set; } = new();
        public List<ExcelHeaderColumn> HeaderColumns { get; set; } = new();
        public List<ExcelPreviewRow> Rows { get; set; } = new();
        public List<string> Warnings { get; set; } = new();
    }

    private sealed class ExcelHeaderColumn
    {
        public ExcelHeaderColumn(string originalHeader, string key, int columnIndex)
        {
            OriginalHeader = originalHeader;
            Key = key;
            ColumnIndex = columnIndex;
        }

        public string OriginalHeader { get; }
        public string Key { get; }
        public int ColumnIndex { get; }
    }

    private sealed class ExcelPreviewRow
    {
        public int ExcelRowNumber { get; set; }
        public bool IsExisting { get; set; }
        public bool IsBatchDuplicate { get; set; }
        public string StatusMessage { get; set; } = string.Empty;
        public Dictionary<string, string> Values { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public Dictionary<string, object?> RawValues { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public Dictionary<string, string> DisplayByKey { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }
