@using MudBlazor
@using Microsoft.JSInterop
@using ABFreight.Models
@using ABFreight.Services
@using System.Text.RegularExpressions
@inject ChatGPTService ChatGPTSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<style>
    /* ========== FAB BUTTON ========== */
    .ai-fab {
        position: fixed;
        bottom: 28px;
        right: 28px;
        z-index: 9999;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 20px rgba(102, 126, 234, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        animation: ai-fab-pulse 2s infinite;
    }
    .ai-fab:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 30px rgba(102, 126, 234, 0.6);
    }
    @@keyframes ai-fab-pulse {
        0% { box-shadow: 0 4px 20px rgba(102, 126, 234, 0.4); }
        50% { box-shadow: 0 4px 30px rgba(102, 126, 234, 0.7); }
        100% { box-shadow: 0 4px 20px rgba(102, 126, 234, 0.4); }
    }
    .ai-fab-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: #ff4444;
        color: white;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    /* ========== CHAT WINDOW ========== */
    .ai-chat-window {
        position: fixed;
        bottom: 96px;
        right: 28px;
        z-index: 9998;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 8px 40px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .ai-chat-normal {
        width: 420px;
        height: 550px;
    }
    .ai-chat-expanded {
        width: 600px;
        height: 700px;
    }
    .ai-chat-fullscreen {
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
        border-radius: 0 !important;
    }

    /* ========== HEADER ========== */
    .ai-chat-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }
    .ai-chat-header-info {
        flex: 1;
    }
    .ai-chat-header-title {
        font-weight: 600;
        font-size: 15px;
        margin: 0;
    }
    .ai-chat-header-subtitle {
        font-size: 11px;
        opacity: 0.85;
        margin: 0;
    }
    .ai-chat-header-actions {
        display: flex;
        gap: 4px;
    }
    .ai-chat-header-actions button {
        background: rgba(255,255,255,0.15);
        border: none;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: background 0.2s;
    }
    .ai-chat-header-actions button:hover {
        background: rgba(255,255,255,0.3);
    }

    /* ========== STATUS BAR ========== */
    .ai-status-bar {
        background: #f0f4ff;
        padding: 6px 16px;
        font-size: 12px;
        color: #667eea;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    /* ========== MESSAGES ========== */
    .ai-chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #f8f9fc;
    }
    .ai-msg {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 13.5px;
        line-height: 1.55;
        position: relative;
        word-wrap: break-word;
    }
    .ai-msg-user {
        align-self: flex-end;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border-bottom-right-radius: 4px;
    }
    .ai-msg-assistant {
        align-self: flex-start;
        background: white;
        color: #333;
        border: 1px solid #e8ecf4;
        border-bottom-left-radius: 4px;
    }
    .ai-msg-time {
        font-size: 10px;
        opacity: 0.6;
        margin-top: 4px;
    }
    .ai-msg-copy {
        position: absolute;
        top: 4px;
        right: 4px;
        background: rgba(0,0,0,0.05);
        border: none;
        cursor: pointer;
        border-radius: 4px;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.2s;
        font-size: 12px;
    }
    .ai-msg:hover .ai-msg-copy {
        opacity: 1;
    }

    /* ========== TYPING ANIMATION ========== */
    .ai-typing {
        display: flex;
        gap: 4px;
        padding: 10px 14px;
        align-self: flex-start;
        background: white;
        border: 1px solid #e8ecf4;
        border-radius: 12px;
    }
    .ai-typing-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #667eea;
        animation: ai-typing-bounce 1.4s infinite ease-in-out both;
    }
    .ai-typing-dot:nth-child(1) { animation-delay: -0.32s; }
    .ai-typing-dot:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes ai-typing-bounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }

    /* ========== QUICK BUTTONS ========== */
    .ai-quick-buttons {
        padding: 8px 16px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        background: #f8f9fc;
        border-top: 1px solid #e8ecf4;
        flex-shrink: 0;
    }
    .ai-quick-btn {
        padding: 5px 10px;
        border: 1px solid #667eea;
        background: white;
        color: #667eea;
        border-radius: 16px;
        font-size: 11.5px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }
    .ai-quick-btn:hover {
        background: #667eea;
        color: white;
    }

    /* ========== INPUT AREA ========== */
    .ai-chat-input-area {
        padding: 10px 16px;
        border-top: 1px solid #e8ecf4;
        display: flex;
        gap: 8px;
        align-items: flex-end;
        background: white;
        flex-shrink: 0;
    }
    .ai-chat-input {
        flex: 1;
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 10px 14px;
        font-size: 13.5px;
        resize: none;
        max-height: 100px;
        min-height: 40px;
        outline: none;
        transition: border-color 0.2s;
        font-family: inherit;
    }
    .ai-chat-input:focus {
        border-color: #667eea;
    }
    .ai-chat-send {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
        transition: transform 0.2s;
    }
    .ai-chat-send:hover {
        transform: scale(1.1);
    }
    .ai-chat-send:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
    }

    /* ========== MARKDOWN TABLES ========== */
    .ai-msg-assistant table {
        border-collapse: collapse;
        width: 100%;
        margin: 8px 0;
        font-size: 12px;
    }
    .ai-msg-assistant th, .ai-msg-assistant td {
        border: 1px solid #ddd;
        padding: 4px 8px;
        text-align: left;
    }
    .ai-msg-assistant th {
        background: #f0f4ff;
        font-weight: 600;
    }
    .ai-msg-assistant code {
        background: #f0f0f0;
        padding: 1px 5px;
        border-radius: 3px;
        font-size: 12px;
    }
    .ai-msg-assistant pre {
        background: #1e1e1e;
        color: #dcdcdc;
        padding: 10px;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 12px;
    }
    .ai-msg-assistant ul, .ai-msg-assistant ol {
        padding-left: 20px;
        margin: 4px 0;
    }
    .ai-msg-assistant h3 { font-size: 14px; margin: 8px 0 4px; }
    .ai-msg-assistant h4 { font-size: 13px; margin: 6px 0 4px; }
    .ai-msg-assistant strong { font-weight: 600; }
    .ai-msg-assistant p { margin: 4px 0; }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 480px) {
        .ai-chat-normal, .ai-chat-expanded {
            width: calc(100vw - 16px);
            height: calc(100vh - 120px);
            right: 8px;
            bottom: 80px;
        }
        .ai-fab {
            bottom: 16px;
            right: 16px;
        }
    }
</style>

@* ========== FAB BUTTON ========== *@
<button class="ai-fab" @onclick="ToggleChat" title="AI Assistant">
    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Medium" />
    @if (_unreadCount > 0)
    {
        <span class="ai-fab-badge">@_unreadCount</span>
    }
</button>

@* ========== CHAT WINDOW ========== *@
@if (_isOpen)
{
    <div class="ai-chat-window @GetSizeClass()">
        @* Header *@
        <div class="ai-chat-header">
            <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Medium" />
            <div class="ai-chat-header-info">
                <p class="ai-chat-header-title">🤖 LMS AI Assistant</p>
                <p class="ai-chat-header-subtitle">Logistics Management System</p>
            </div>
            <div class="ai-chat-header-actions">
                <button @onclick="CycleSizeMode" title="Thay đổi kích thước">⛶</button>
                <button @onclick="ClearChat" title="Xóa lịch sử">🗑</button>
                <button @onclick="ToggleChat" title="Đóng">✕</button>
            </div>
        </div>

        @* Status Bar *@
        @if (!string.IsNullOrEmpty(_statusText))
        {
            <div class="ai-status-bar">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px;" />
                <span>@_statusText</span>
            </div>
        }

        @* Messages *@
        <div class="ai-chat-messages" id="aiChatMessages">
            @if (_messages.Count == 0)
            {
                <div style="text-align:center; padding:40px 20px; color:#999;">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Style="font-size:48px; color:#667eea; opacity:0.5;" />
                    <p style="margin-top:12px; font-size:14px;">Xin chào! Tôi là AI Assistant của LMS.</p>
                    <p style="font-size:12px; opacity:0.7;">Hãy hỏi tôi về dữ liệu hệ thống, nghiệp vụ logistics, hoặc bất kỳ điều gì!</p>
                </div>
            }

            @foreach (var msg in _messages)
            {
                <div class="ai-msg @(msg.Role == "user" ? "ai-msg-user" : "ai-msg-assistant")">
                    @if (msg.Role == "assistant")
                    {
                        <button class="ai-msg-copy" @onclick="() => CopyMessage(msg.Content)" title="Copy">📋</button>
                        @((MarkupString)RenderMarkdown(msg.Content))
                    }
                    else
                    {
                        @msg.Content
                    }
                    <div class="ai-msg-time">@msg.Timestamp.ToString("HH:mm")</div>
                </div>
            }

            @if (_isTyping)
            {
                <div class="ai-typing">
                    <div class="ai-typing-dot"></div>
                    <div class="ai-typing-dot"></div>
                    <div class="ai-typing-dot"></div>
                </div>
            }
        </div>

        @* Quick Buttons *@
        @if (_messages.Count == 0)
        {
            <div class="ai-quick-buttons">
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("📊 Tổng quan hệ thống")'>📊 Tổng quan</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("📦 Thống kê Job gần nhất")'>📦 Job</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("👥 Danh sách khách hàng")'>👥 Khách hàng</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("💰 Tình hình công nợ")'>💰 Công nợ</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("🚛 Thống kê Trucking")'>🚛 Trucking</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("📝 Báo giá mới nhất")'>📝 Báo giá</button>
                <button class="ai-quick-btn" @onclick='() => SendQuickMessage("🌐 Tìm kiếm giá cước vận tải biển")'>🌐 Tìm web</button>
            </div>
        }

        @* Input Area *@
        <div class="ai-chat-input-area">
            <textarea class="ai-chat-input"
                      @bind="_inputText"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="Nhập câu hỏi..."
                      rows="1"
                      disabled="@_isTyping"></textarea>
            <button class="ai-chat-send" @onclick="SendMessage" disabled="@(_isTyping || string.IsNullOrWhiteSpace(_inputText))" title="Gửi">
                ➤
            </button>
        </div>
    </div>
}

@code {
    private bool _isOpen = false;
    private bool _isTyping = false;
    private string _inputText = "";
    private string _statusText = "";
    private int _unreadCount = 0;
    private int _sizeMode = 0; // 0=normal, 1=expanded, 2=fullscreen
    private List<ChatMessage> _messages = new();

    private void ToggleChat()
    {
        _isOpen = !_isOpen;
        if (_isOpen) _unreadCount = 0;
    }

    private string GetSizeClass()
    {
        return _sizeMode switch
        {
            1 => "ai-chat-expanded",
            2 => "ai-chat-fullscreen",
            _ => "ai-chat-normal"
        };
    }

    private void CycleSizeMode()
    {
        _sizeMode = (_sizeMode + 1) % 3;
    }

    private void ClearChat()
    {
        _messages.Clear();
        _statusText = "";
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendQuickMessage(string text)
    {
        _inputText = text;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isTyping) return;

        var userMsg = _inputText.Trim();
        _inputText = "";

        // Add user message
        _messages.Add(new ChatMessage
        {
            Role = "user",
            Content = userMsg,
            Timestamp = DateTime.Now
        });

        _isTyping = true;
        _statusText = DetectStatus(userMsg);
        StateHasChanged();

        await ScrollToBottom();

        try
        {
            // Send to ChatGPT
            var response = await ChatGPTSvc.SendMessageAsync(_messages, userMsg);

            _messages.Add(new ChatMessage
            {
                Role = "assistant",
                Content = response,
                Timestamp = DateTime.Now
            });

            if (!_isOpen) _unreadCount++;
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage
            {
                Role = "assistant",
                Content = $"⚠️ Lỗi: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            _isTyping = false;
            _statusText = "";
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private string DetectStatus(string msg)
    {
        var q = msg.ToLower();
        if (q.Contains("tìm kiếm") || q.Contains("search") || q.Contains("web") || q.Contains("google") || q.Contains("internet"))
            return "🌐 Đang tìm kiếm trên web...";
        if (q.Contains("job") || q.Contains("customer") || q.Contains("booking") || q.Contains("debit") || q.Contains("credit")
            || q.Contains("khách") || q.Contains("trucking") || q.Contains("container") || q.Contains("hbl") || q.Contains("mbl")
            || q.Contains("tổng quan") || q.Contains("thống kê") || q.Contains("phiếu") || q.Contains("hóa đơn") || q.Contains("báo giá"))
            return "🔍 Đang truy vấn dữ liệu hệ thống...";
        return "🤔 Đang suy nghĩ...";
    }

    private async Task CopyMessage(string content)
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", content);
            Snackbar.Add("✅ Đã copy nội dung!", MudBlazor.Severity.Success);
        }
        catch
        {
            Snackbar.Add("⚠️ Không thể copy", MudBlazor.Severity.Warning);
        }
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        try
        {
            await JS.InvokeVoidAsync("scrollChatToBottom");
        }
        catch { }
    }

    /// <summary>
    /// Server-side Markdown to HTML renderer
    /// </summary>
    private string RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";

        var html = text;

        // Code blocks (```...```)
        html = Regex.Replace(html, @"```(\w*)\n(.*?)```", m =>
        {
            var code = System.Net.WebUtility.HtmlEncode(m.Groups[2].Value);
            return $"<pre><code>{code}</code></pre>";
        }, RegexOptions.Singleline);

        // Inline code (`...`)
        html = Regex.Replace(html, @"`([^`]+)`", "<code>$1</code>");

        // Tables
        html = RenderMarkdownTables(html);

        // Headers
        html = Regex.Replace(html, @"^#### (.+)$", "<h4>$1</h4>", RegexOptions.Multiline);
        html = Regex.Replace(html, @"^### (.+)$", "<h3>$1</h3>", RegexOptions.Multiline);
        html = Regex.Replace(html, @"^## (.+)$", "<h3>$1</h3>", RegexOptions.Multiline);

        // Bold
        html = Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Italic
        html = Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");

        // Unordered lists
        html = Regex.Replace(html, @"^- (.+)$", "<li>$1</li>", RegexOptions.Multiline);
        html = Regex.Replace(html, @"(<li>.*</li>(\n|$))+", m => $"<ul>{m.Value}</ul>", RegexOptions.Singleline);

        // Ordered lists
        html = Regex.Replace(html, @"^\d+\. (.+)$", "<li>$1</li>", RegexOptions.Multiline);

        // Links
        html = Regex.Replace(html, @"\[([^\]]+)\]\(([^\)]+)\)", "<a href=\"$2\" target=\"_blank\">$1</a>");

        // Line breaks
        html = Regex.Replace(html, @"\n\n", "</p><p>");
        html = Regex.Replace(html, @"\n", "<br/>");

        // Wrap in paragraph if not already structured
        if (!html.StartsWith("<"))
            html = $"<p>{html}</p>";

        return html;
    }

    private string RenderMarkdownTables(string text)
    {
        var lines = text.Split('\n');
        var result = new System.Text.StringBuilder();
        var inTable = false;
        var headerDone = false;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();

            if (trimmed.StartsWith("|") && trimmed.EndsWith("|"))
            {
                // Check if separator line
                if (Regex.IsMatch(trimmed, @"^\|[\s\-:|]+\|$"))
                {
                    headerDone = true;
                    continue;
                }

                if (!inTable)
                {
                    result.AppendLine("<table>");
                    inTable = true;
                    headerDone = false;
                }

                var cells = trimmed.Split('|', StringSplitOptions.RemoveEmptyEntries)
                    .Select(c => c.Trim())
                    .ToArray();

                var tag = !headerDone ? "th" : "td";
                result.Append("<tr>");
                foreach (var cell in cells)
                {
                    result.Append($"<{tag}>{cell}</{tag}>");
                }
                result.AppendLine("</tr>");

                if (!headerDone) headerDone = true;
            }
            else
            {
                if (inTable)
                {
                    result.AppendLine("</table>");
                    inTable = false;
                    headerDone = false;
                }
                result.AppendLine(line);
            }
        }

        if (inTable)
            result.AppendLine("</table>");

        return result.ToString();
    }
}
