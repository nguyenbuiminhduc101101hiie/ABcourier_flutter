@using System.Globalization
@using System.Text.Json
@using MudBlazor
@using ABFreight.Models
@inject tigiaVCBservices Vcbsv
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog Style="max-height: 92vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? Localizer["New"] : Localizer["edit"]) — Credit</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="6">
                    <MudAutocomplete T="Guid"
                                     @bind-Value="_item.customerid"
                                     Label="@Localizer["Customer"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     SearchFunc="SearchCustomer"
                                     ToStringFunc="CusidtoCusCode"
                                     Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudAutocomplete T="Guid"
                                     @bind-Value="_item.itemid"
                                     Label="@Localizer["Item"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     SearchFunc="SearchCharge"
                                     ToStringFunc="Charidtocharge"
                                     Clearable />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.dongia"
                                     Label="@Localizer["Unit Price"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     TextChanged="@(_ => CalculateTotal())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.soluong"
                                     Label="@Localizer["Quantity"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     TextChanged="@(_ => CalculateTotal())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="string"
                                     @bind-Value="_item.tiente"
                                     Label="@Localizer["Currency"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     CoerceValue
                                     SearchFunc="SearchCurr" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.thanhtien"
                                     Label="@Localizer["Total Price"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     Class="text-right"
                                     TextChanged="@(_ => SyncTotalIncVat())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.ContainerNo"
                                  Label="@Localizer["Cont. No."]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1" Color="Color.Primary">Chi tiết sửa chữa / container</MudText>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker @bind-Date="_item.Date_Of_EST"
                                   Label="Date Of EST"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy"
                                   Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.Size"
                                  Label="Size"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudDatePicker @bind-Date="_item.Date_In_Yard"
                                   Label="Date In Yard"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy"
                                   Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.Manufacturing_Date"
                                  Label="Manufacturing Date"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Placeholder="MM/yyyy"
                                  HelperText="Ví dụ: 05/2007" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.IT" Label="IT" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.Com_Code" Label="Com Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.LOC" Label="LOC" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.Location" Label="Location" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.DM_Code" Label="DM Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.RP_Code" Label="RP Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.Billing" Label="Billing" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.Owner" Label="Owner" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="8">
                    <MudTextField @bind-Value="_item.COMPONENTS_DETAILS"
                                  Label="Components Details"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.LHT" Label="LHT" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.WDT" Label="WDT" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.R" Label="R" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.Hours" Label="Hours" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_item.Labor_Cost" Label="Labor Cost" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_item.Material_Cost" Label="Material Cost" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_item.Labor_Rate" Label="Labor Rate" Variant="Variant.Outlined" Margin="Margin.Dense" Format="#,##0.##" Culture="@_en" HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.EstNo" Label="Est No" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_item.Grade" Label="Grade" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField @bind-Value="_item.DamageDetail" Label="Damage Detail" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_item.Remark" Label="Remark" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_item.ghichu_credit"
                                  Label="@Localizer["Notes"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_Credit? Model { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public List<M_Customer> Customers { get; set; } = new();
    [Parameter] public List<ChargeModel> Charges { get; set; } = new();
    [Parameter] public List<string> Currencies { get; set; } = new();

    private readonly CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private MudForm _form = default!;
    private M_Credit _item = new();

    protected override void OnInitialized()
    {
        _item = Model == null
            ? new M_Credit()
            : JsonSerializer.Deserialize<M_Credit>(JsonSerializer.Serialize(Model))!;
        ApplyFixedDefaults(_item);
        SyncTotalIncVat();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_item.customerid == Guid.Empty || _item.itemid == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn Customer và Item.", MudBlazor.Severity.Warning);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_item.Manufacturing_Date))
            _item.Manufacturing_Date = NormalizeManufacturingDate(_item.Manufacturing_Date);

        ApplyFixedDefaults(_item);
        SyncTotalIncVat();

        var usdRate = await Vcbsv.Getexchange_cur("USD");
        _item.tigiacredit = usdRate;
        _item.tigiahoadondauvao = usdRate;

        MudDialog.Close(DialogResult.Ok(_item));
    }

    private static void ApplyFixedDefaults(M_Credit item)
    {
        item.type = "CONT";
        item.thue = 0;
    }

    private static string? NormalizeManufacturingDate(string value)
    {
        var text = value.Trim();
        if (DateTime.TryParseExact(text, new[] { "MM/yyyy", "M/yyyy", "MM-yyyy", "M-yyyy" },
                CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
            return parsed.ToString("MM/yyyy", CultureInfo.InvariantCulture);
        return text;
    }

    private void CalculateTotal()
    {
        if (_item.soluong.HasValue && _item.dongia.HasValue)
        {
            _item.thanhtien = Math.Round((_item.soluong ?? 0) * (_item.dongia ?? 0), 2);
            SyncTotalIncVat();
        }
    }

    private void SyncTotalIncVat()
    {
        _item.thanhtiensauthue = _item.thanhtien;
    }

    private string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    private string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var rs = Charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}";
    }

    private Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Customers.Select(x => x.Customer_ID));
        return Task.FromResult(Customers
            .Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Customer_ID));
    }

    private Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Charges.Select(x => x.CHARGE_ID));
        return Task.FromResult(Charges
            .Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.CHARGE_ID));
    }

    private Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Currencies.AsEnumerable());
        return Task.FromResult(Currencies.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }
}
