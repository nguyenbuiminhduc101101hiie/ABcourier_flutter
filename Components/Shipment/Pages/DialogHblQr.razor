@using MudBlazor
@using ABFreight.Services
@inject HblQrService HblQrService
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@($"{_titleLabel} QR Code")</MudText>
    </TitleContent>
    <DialogContent>
        @if (string.IsNullOrWhiteSpace(HblNo))
        {
            <MudAlert Severity="MudBlazor.Severity.Warning">@($"{_titleLabel} không hợp lệ.")</MudAlert>
        }
        else if (!string.IsNullOrEmpty(_qrImageBase64))
        {
            <MudStack Spacing="3">
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                    Quét mã QR bên dưới để lấy số @_titleLabel.
                </MudAlert>
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
                    <img src="@($"data:image/png;base64,{_qrImageBase64}")" alt="HBL QR Code" style="max-width: 280px; height: auto;" />
                </MudStack>
                <MudText Typo="Typo.body2">@($"{_titleLabel}: ")<strong>@HblNo</strong></MudText>
                <MudTextField Label="@_titleLabel" ReadOnly="true" Value="@HblNo" Variant="Variant.Outlined" />
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? HblNo { get; set; }

    [Parameter]
    public string? TitleLabel { get; set; }

    private string? _qrImageBase64;
    private string _titleLabel = "HBL";

    protected override void OnInitialized()
    {
        _titleLabel = string.IsNullOrWhiteSpace(TitleLabel) ? Localizer["HBL"] : TitleLabel;
        _qrImageBase64 = HblQrService.GenerateQrCodeBase64(HblNo);
    }

    private void Close() => MudDialog.Close();
}
