@using ABFreight.Models
@using ABFreight.Services
@using MudBlazor
@inject ISnackbar Snackbar
@inject SupportServices supsv
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="dc-shell">

            <MudGrid Class="dc-header" AlignItems="Center">
                <MudItem xs="12" sm="8">
                    <MudText Typo="Typo.h6" Class="dc-title">
                        Quản lý Debit / Credit mặc định
                    </MudText>
                    <MudText Typo="Typo.caption" Class="dc-subtitle">
                        Thiết lập phí mặc định theo Item, Customer/Vendor, Shipment Type và Debit/Credit
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="4" Class="dc-header-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddNew"
                               Class="dc-add-btn">
                        Thêm mới
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Class="dc-filter-box">
                <MudGrid Spacing="1">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Label="Search Item"
                                      @bind-Value="_itemSearchText"
                                      Immediate="true"
                                      Dense="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Placeholder="Nhập mã/tên item..." />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Label="Search Customer/Vendor"
                                      @bind-Value="_customerSearchText"
                                      Immediate="true"
                                      Dense="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Business"
                                      Placeholder="Nhập mã/tên customer..." />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="string"
                                   Label="Debit/Credit"
                                   @bind-Value="_debitCreditSearchText"
                                   Clearable="true"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   AdornmentIcon="@Icons.Material.Filled.SwapHoriz">
                            <MudSelectItem Value="@("Debit")">Debit</MudSelectItem>
                            <MudSelectItem Value="@("Credit")">Credit</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="0" Class="dc-table-wrap">
                <MudTable Items="FilteredTemplates"
                          Hover="true"
                          Dense="true"
                          Bordered="false"
                          Striped="true"
                          SortLabel="Sort By"
                          Class="dc-table">

                    <HeaderContent>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => CharIdToCharge(x.ItemId)))">
                                Item
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => CusidtoCusCode(x.CustomerId)))">
                                Customer/Vendor
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.Amount))">
                                Amount
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.Cur ?? string.Empty))">
                                Currency
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.DebitCredit ?? string.Empty))">
                                Debit/Credit
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.Continued))">
                                Continued
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.UserCreate ?? string.Empty))">
                                User
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.ShipmentType ?? string.Empty))">
                                Shipment Type
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<DebitCreditTemplate, object>(x => x.type ?? string.Empty))">
                                @Localizer["Type"]
                            </MudTableSortLabel>
                        </MudTh>

                        <MudTh style="width:96px;text-align:center;">Actions</MudTh>
                    </HeaderContent>

                    <RowTemplate Context="row">
                        @if (editId == row.Id)
                        {
                            <MudTd>
                                <MudAutocomplete T="Guid"
                                                 @bind-Value="editModel.ItemId"
                                                 SearchFunc="SearchCharge"
                                                 ToStringFunc="CharIdToCharge"
                                                 Dense="true"
                                                 Immediate
                                                 MaxItems="50"
                                                 Required="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudTd>

                            <MudTd>
                                <MudAutocomplete T="Guid"
                                                 @bind-Value="editModel.CustomerId"
                                                 SearchFunc="SearchCustomer"
                                                 ToStringFunc="CusidtoCusCode"
                                                 Dense="true"
                                                 Immediate
                                                 MaxItems="50"
                                                 Required="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudTd>

                            <MudTd>
                                <MudNumericField T="double"
                                                 Min="0"
                                                 @bind-Value="editModel.Amount"
                                                 Format="##,##0"
                                                 Immediate
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudTd>

                            <MudTd>
                                <MudSelect T="string"
                                           @bind-Value="editModel.Cur"
                                           Required="true"
                                           Immediate
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    @foreach (var cur in Curs)
                                    {
                                        <MudSelectItem Value="@cur">@cur</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>

                            <MudTd>
                                <MudSelect T="string"
                                           @bind-Value="editModel.DebitCredit"
                                           Required="true"
                                           Immediate
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    <MudSelectItem Value="@("Debit")">Debit</MudSelectItem>
                                    <MudSelectItem Value="@("Credit")">Credit</MudSelectItem>
                                </MudSelect>
                            </MudTd>

                            <MudTd>
                                <MudCheckBox @bind-Checked="editModel.Continued"
                                             Dense="true"
                                             Color="Color.Primary" />
                            </MudTd>

                            <MudTd>
                                <MudTextField Value="editModel.UserCreate"
                                              Immediate
                                              Readonly
                                              Required
                                              Dense="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudTd>

                            <MudTd>
                                <MudSelect T="string"
                                           @bind-Value="editModel.ShipmentType"
                                           Required="true"
                                           Immediate
                                           Dense="true"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    <MudSelectItem Value="@("AI")">AI</MudSelectItem>
                                    <MudSelectItem Value="@("AE")">AE</MudSelectItem>
                                    <MudSelectItem Value="@("SI")">SI</MudSelectItem>
                                    <MudSelectItem Value="@("SE")">SE</MudSelectItem>
                                    <MudSelectItem Value="@("Truck")">Truck</MudSelectItem>
                                    <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                                </MudSelect>
                            </MudTd>

                            <MudTd>
                                <MudAutocomplete T="string"
                                                 @bind-Value="editModel.type"
                                                 Label="@Localizer["Type"]"
                                                 Required="true"
                                                 CoerceValue
                                                 Dense="true"
                                                 Immediate="true"
                                                 MaxItems="50"
                                                 SearchFunc="SearchType"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudTd>

                            <MudTd Class="dc-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Check"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="@(() => SaveRow(row))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               OnClick="CancelEdit" />
                            </MudTd>
                        }
                        else
                        {
                            <MudTd>
                                <span class="dc-item">@CharIdToCharge(row.ItemId)</span>
                            </MudTd>

                            <MudTd>
                                <span class="dc-muted">@CusidtoCusCode(row.CustomerId)</span>
                            </MudTd>

                            <MudTd>
                                <span class="dc-amount">@row.Amount.ToString("##,##0")</span>
                            </MudTd>

                            <MudTd>
                                <span class="dc-pill dc-pill-gray">@row.Cur</span>
                            </MudTd>

                            <MudTd>
                                @if (row.DebitCredit == "Debit")
                                {
                                    <span class="dc-pill dc-pill-debit">Debit</span>
                                }
                                else
                                {
                                    <span class="dc-pill dc-pill-credit">Credit</span>
                                }
                            </MudTd>

                            <MudTd>
                                <MudCheckBox Checked="@row.Continued"
                                             Disabled="true"
                                             Dense="true"
                                             Color="Color.Primary" />
                            </MudTd>

                            <MudTd>
                                <span class="dc-muted">@row.UserCreate</span>
                            </MudTd>

                            <MudTd>
                                <span class="dc-pill dc-pill-blue">@row.ShipmentType</span>
                            </MudTd>

                            <MudTd>
                                <span class="dc-muted">@(row.type ?? "")</span>
                            </MudTd>

                            <MudTd Class="dc-actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => StartEdit(row))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => DeleteRow(row))" />
                            </MudTd>
                        }
                    </RowTemplate>

                    <FooterContent>
                        <MudTr>
                            <MudTd colspan="10" Class="dc-footer-cell">
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddNew">
                                    Thêm mới
                                </MudButton>
                            </MudTd>
                        </MudTr>
                    </FooterContent>

                    <NoRecordsContent>
                        <MudText Align="Align.Center" Class="pa-4">
                            Không tìm thấy dữ liệu phù hợp.
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>

        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Size="Size.Small"
                   Disabled="@_isSubmitting"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit">
            Lưu
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   OnClick="Cancel">
            Hủy
        </MudButton>
    </DialogActions>
</MudDialog>

