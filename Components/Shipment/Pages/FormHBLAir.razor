@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer
@inject CustomerService csv

<style>
    .air-bl-container {
        max-width: 1320px;
        padding: 10px 14px 4px 14px !important;
    }

    .air-bl-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
    }

    .air-bl-title {
        font-size: 20px;
        font-weight: 700;
        color: #263238;
        line-height: 1.2;
    }

    .air-bl-subtitle {
        font-size: 12px;
        color: #607d8b;
        margin-top: 2px;
        max-width: 720px;
    }

    .air-bl-section {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 10px 12px 12px 12px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .04);
        margin-bottom: 10px;
    }

    .air-bl-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #118AB2;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .air-bl-section-title::before {
        content: "";
        width: 4px;
        height: 16px;
        border-radius: 4px;
        background: #118AB2;
        display: inline-block;
    }

    .air-bl-container .mud-input-control {
        margin-top: 0 !important;
    }

    .air-bl-container .mud-input-label {
        font-size: 12px !important;
        color: #455a64 !important;
        font-weight: 600 !important;
    }

    .air-bl-container .mud-input > input,
    .air-bl-container textarea {
        font-size: 13px !important;
    }

    .air-bl-textarea textarea {
        min-height: 72px !important;
        line-height: 1.35 !important;
    }

    .air-bl-textarea-tall textarea {
        min-height: 100px !important;
        line-height: 1.35 !important;
    }

    .air-bl-sample {
        border: 1px dashed #d7dde2;
        border-radius: 12px;
        background: #fafafa;
        padding: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .air-bl-sample .mud-image,
        .air-bl-sample img {
            max-width: 100%;
            object-fit: contain;
            box-shadow: none !important;
        }

    .air-bl-dialog-actions {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        padding: 8px 12px 10px 12px;
        border-top: 1px solid #e5e7eb;
    }

    @@media (max-width: 960px) {
        .air-bl-header {
            flex-direction: column;
        }

        .air-bl-container {
            padding: 8px !important;
        }
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudContainer Class="air-bl-container">
                <div class="air-bl-header">
                    <div>
                        <div class="air-bl-title">House Air Waybill (HAWB)</div>
                        <div class="air-bl-subtitle">Thông tin vận đơn hàng không: parties, routing, cước và chi tiết hàng hóa theo mẫu airway bill.</div>
                    </div>
                </div>

                <!-- HAWB number -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Số vận đơn</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" md="6" lg="4">
                            <MudTextField Class="air-bl-input"
                                          @bind-Value="HBLdetail.Air_PAM"
                                          Label="House Air Waybill No."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Parties -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Shipper / Consignee / Agent</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" lg="6">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudAutocomplete Class="air-bl-input air-bl-textarea"
                                                     @bind-Value="HBLdetail.shipper"
                                                     SearchFunc="Search"
                                                     Label="Shipper's Name and Address"
                                                     Lines="3"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Clearable="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Class="air-bl-input"
                                                  @bind-Value="HBLdetail.Air_ShipperAccountNumber"
                                                  Label="Shipper's Account Numer"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudAutocomplete Class="air-bl-input air-bl-textarea"
                                                     @bind-Value="HBLdetail.consignee"
                                                     SearchFunc="Search"
                                                     Label="Consignee's Name and Address"
                                                     Lines="3"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Clearable="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Class="air-bl-input"
                                                  @bind-Value="HBLdetail.Air_ConsigneeAccountNumber"
                                                  Label="Consignee's Account Number"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input air-bl-textarea"
                                                  @bind-Value="HBLdetail.Air_IssuingCarrier"
                                                  Label="Issuing Carrier's Agent Name and City"
                                                  Lines="3"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  AutoGrow="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Class="air-bl-input"
                                                  @bind-Value="HBLdetail.Air_AgentIATACode"
                                                  Label="Agent's IATA Code"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField Class="air-bl-input"
                                                  @bind-Value="HBLdetail.Air_AccountNo"
                                                  Label="Account No."
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input"
                                                  @bind-Value="HBLdetail.Air_AirportofDeparture"
                                                  Label="Airport of Departure (Addr. of first Carrier) and requested Routing"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="12" lg="6">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input air-bl-textarea-tall"
                                                  @bind-Value="HBLdetail.Air_AccountingInfomation"
                                                  Label="Accounting Infomation"
                                                  Lines="4"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  AutoGrow="true" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Routing & currency -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Routing / Currency / Valuation</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_to" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_ByfirstCarrier" Label="By First Carrier" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_to2" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_by2" Label="By" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_to3" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_by3" Label="By" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect Class="air-bl-input" @bind-Value="HBLdetail.Air_Currency" Label="Currency" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_CHGSCode" Label="CHGS Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_PPD" Label="WT/VAL PPD" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_COLL" Label="WT/VAL COLL" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_otherPPD" Label="Other PPD" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_otherCOLL" Label="Other COLL" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_DeclaredValuedForCarriage" Label="DV for Carriage" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_DeclaredValueForCustoms" Label="DV for Customs" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Destination & handling -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Destination / Flight / Handling</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" md="4">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_AirportOfDestination" Label="Airport of Destination" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_FlightDate1" Label="Flight/Date (1)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_FlightDate2" Label="Flight/Date (2)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_AmountOfInsurance" Label="Amount of Insurance" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="8">
                            <MudTextField Class="air-bl-input air-bl-textarea"
                                          T="string"
                                          Lines="2"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Value="@AirInsuranceReadonlyHint" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Class="air-bl-input air-bl-textarea"
                                          @bind-Value="HBLdetail.Air_HandlingInfomation"
                                          Label="Handling Information"
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          AutoGrow="true" />
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Cargo / charges detail row -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Cargo &amp; Charges Detail</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_NoOfPiecesRCP" Label="No. of Pieces RCP" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_GrossWieght" Label="Gross Weight" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_kglb" Label="kg lb" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_RateClass" Label="Rate Class" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_CommodityItemNo" Label="Commodity Item No." Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_ChargeableWeight" Label="Chargeable Weight" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_RateCharge" Label="Rate/Charge" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_Total" Label="Total" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Class="air-bl-input air-bl-textarea-tall" @bind-Value="HBLdetail.Air_NatureAndquantityOfgoods" Label="Nature &amp; Qty of Goods" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense" AutoGrow="true" />
                        </MudItem>
                    </MudGrid>
                </div>

                <!-- Totals prepaid / collect -->
                <div class="air-bl-section">
                    <div class="air-bl-section-title">Prepaid / Collect</div>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" lg="6">
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_WeightCharge_Prepaid" Label="Weight Charge - Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_WeightCharge_Collect" Label="Weight Charge - Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_Valuation_Prepaid" Label="Valuation Charge - Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_Valuation_Collect" Label="Valuation Charge - Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_Tax_Prepaid" Label="Tax - Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_Tax_Collect" Label="Tax - Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalOtherChargesDueAgent_Prepaid" Label="Total Other Charges Due Agent - Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalOtherChargesDueAgent_Collect" Label="Total Other Charges Due Agent - Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalOtherChargesDueCarrier_Prepaid" Label="Total Other Charges Due Carrier - Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalOtherChargesDueCarrier_Collect" Label="Total Other Charges Due Carrier - Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalPrepaid" Label="Total Prepaid" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalCollect" Label="Total Collect" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_CurrencyConversionRates" Label="Currency Conversion Rates" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_CCChargesInDestCurrenct" Label="CC Charges in Dest. Currency" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" T="string" Value="@AirCarrierUseOnlyHint" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_ChargesatDestination" Label="Charges at Destination" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="12" lg="6">
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input air-bl-textarea" @bind-Value="HBLdetail.Air_OtherCharges" Label="Other Charges" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="air-bl-sample">
                                        <MudImage Src="/imageforreport/airwaybill3.png" Alt="Air waybill sample" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input air-bl-textarea" @bind-Value="HBLdetail.Air_HisAgent" Label="His Agent" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="air-bl-sample">
                                        <MudImage Src="/imageforreport/airwaybill4.png" Alt="Air waybill sample" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Class="air-bl-input air-bl-textarea" @bind-Value="HBLdetail.Air_FlightDate2" Label="Flight Date" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12">
                                    <div class="air-bl-sample">
                                        <MudImage Src="/imageforreport/airwaybill5.png" Alt="Air waybill sample" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_TotalCollectCharges" Label="Total Collect Charges" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField Class="air-bl-input" @bind-Value="HBLdetail.Air_PAM" Label="House Air Waybill No." Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </div>
            </MudContainer>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <div class="air-bl-dialog-actions">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => mudDialog.Cancel())">@Localizer["Close"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => mudDialog.Close(HBLdetail!))">@Localizer["Save"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private const string AirInsuranceReadonlyHint =
        "INSURANCE. If shipperer requests insurance is in accordance with conditions on reverse hereof, indicale the amount to be insured in figures in box marked amount of insurance.";

    private const string AirCarrierUseOnlyHint = "For Carrier's Use only at Destination";

    [CascadingParameter] MudDialogInstance mudDialog { get; set; } = default!;
    [Parameter] public M_HBL HBLdetail { get; set; } = default!;

    List<M_Customer> customers = new();
    List<string> cuscmb = new();

    protected override async Task OnInitializedAsync()
    {
        customers = await csv.GetListAll();
        cuscmb = customers.Where(x => !string.IsNullOrWhiteSpace(x.EnglishName) || !string.IsNullOrWhiteSpace(x.addresstiengviet)).Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).ToList();
    }

    private async Task<IEnumerable<string>> Search(string value)
    {
        await Task.Delay(5);
        if (string.IsNullOrEmpty(value))
            return cuscmb;

        return cuscmb.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
