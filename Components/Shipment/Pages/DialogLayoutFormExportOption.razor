@using ABFreight.Models
@using ABFreight.Services
@inject BillSeaLayoutFormService FormService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
            Export @BillLayoutFormKindHelper.GetLongDisplayName(FormKind) - Chọn mẫu form
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Mẫu form @BillLayoutFormKindHelper.GetLongDisplayName(FormKind)</b></MudText>
        @if (_forms.Count == 0)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Chưa có form @BillLayoutFormKindHelper.GetLongDisplayName(FormKind). Tạo form tại menu 1.17 trước khi xuất.
            </MudAlert>
        }
        else
        {
            <MudRadioGroup @bind-Value="SelectedLayoutFormId" T="Guid?">
                @foreach (var form in _forms)
                {
                    <MudRadio T="Guid?" Value="@form.BillSeaLayoutFormId" Color="Color.Primary">
                        @form.FormName@(form.IsCustomized ? " (đã chỉnh)" : "")
                    </MudRadio>
                }
            </MudRadioGroup>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanExport)">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" /> Export
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public BillLayoutFormKind FormKind { get; set; } = BillLayoutFormKind.AnSea;

    private Guid? SelectedLayoutFormId { get; set; }
    private List<BillSeaLayoutFormSummary> _forms = new();

    bool CanExport => _forms.Count > 0 && SelectedLayoutFormId is not null;

    protected override async Task OnInitializedAsync()
    {
        _forms = await FormService.ListFormsAsync(FormKind);
        if (_forms.Count > 0)
            SelectedLayoutFormId = _forms[0].BillSeaLayoutFormId;
    }

    private void Submit()
    {
        if (!CanExport)
            return;

        MudDialog.Close(DialogResult.Ok(new LayoutFormExportOptions
        {
            LayoutFormId = SelectedLayoutFormId
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    public class LayoutFormExportOptions
    {
        public Guid? LayoutFormId { get; set; }
    }
}
