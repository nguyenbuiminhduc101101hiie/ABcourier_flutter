@using System.Globalization

@inject NavigationManager Navigation
@inject IDialogService Dialog
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar
@inject AccountService asv
@inject SupportServices supsv
@inject SharedServices sv
@inject ShipmentService shipsv
@inject DNTUServices DNTUSv
@inject SharedServices ssv
@inject CustomerService csv
@attribute [Authorize]
@inject IDialogService DialogService
@inject QuotationService Quosv
<MudDialog>

    <DialogContent>
        <PageTitle>@Localizer["Copy_Credit"]</PageTitle>

        <div class="pa-2" style="margin-top:10px; margin-bottom:10px;">
            <MudGrid>

                <MudItem xs=4>
                    <MudAutocomplete T="Guid" ValueChanged="Refresh_Quo" Label="@Localizer["search_quo"]"
                                     SearchFunc="SearchQuo" ToStringFunc="QuoidtoQuoNo" MaxItems="10" Clearable />
                </MudItem>
                <MudItem xs="2">
                    <MudButton HtmlTag="label"
                               OnClick="Refresh"
                               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Refresh">
                        @Localizer["reload"]
                    </MudButton>
                </MudItem>

                <MudItem xs=6>
                </MudItem>

                <MudItem xs=6>
                    <MudDataGrid T="M_Quotation" Items="@Quos" Filterable="true" MultiSelection="true" Class="custom-credit"
                                 FilterMode="@DataGridFilterMode.Simple" Dense="true" Bordered="true" Virtualize Height="550px;"
                                 FixedHeader="true" HeaderClass="no-wrap" SelectOnRowClick="false" FooterClass="nondisplay"
                                 ReadOnly="false" ColumnResizeMode="ResizeMode.Column" Loading="_loading" SelectedItemsChanged="SelectedItemsChangedQUOs">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">@Localizer["Quotation List"]</MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.Search" OnClick="RefreshQuo">
                                @Localizer["Get Quotation"]
                            </MudButton>
                        </ToolBarContent>
                        <Columns>
                            <SelectColumn T="M_Quotation" />
                            <PropertyColumn Property="x => CustomerName(x.customer_id)" Title="Customer">
                                <EditTemplate>
                                    <MudSelect @bind-Value="context.Item.customer_id" Label="Customer">
                                        @foreach (var item in Customers)
                                        {
                                            <MudSelectItem Value="@item.Customer_ID">@item.CodeName()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </EditTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.status" Title="@(Localizer["status"])">
                                <FooterTemplate>
                                    @Localizer["Group1"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.RFQ_No" Title="@(Localizer["RFQ_No"])">
                                <FooterTemplate>
                                    @Localizer["RFQ_No"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.quotationNo" Title="@(Localizer["QuotationNo"])">
                                <FooterTemplate>
                                    @Localizer["QuotationNo"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.BookingNo" Title="@(Localizer["BookingNo"])">
                                <FooterTemplate>
                                    @Localizer["BookingNo"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.Subject" Title="@(Localizer["Subject"])">
                                <FooterTemplate>
                                    @Localizer["Subject"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.quotationNo" Title="@(Localizer["QuotationNo"])">
                                <FooterTemplate>
                                    @Localizer["QuotationNo"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.o1" Title="@(Localizer["Group1"])">
                                <FooterTemplate>
                                    @Localizer["Group1"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.o2" Title="@(Localizer["Group2"])">
                                <FooterTemplate>
                                    @Localizer["Group2"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.o3" Title="@(Localizer["Group3"])">
                                <FooterTemplate>
                                    @Localizer["Group3"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.o4" Title="@(Localizer["Group4"])">
                                <FooterTemplate>
                                    @Localizer["Group4"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.terms" Title="@(Localizer["Terms"])">
                                <FooterTemplate>
                                    @Localizer["Terms"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.type" Title="@(Localizer["Type"])">
                                <FooterTemplate>
                                    @Localizer["Type"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.pol" Title="@(Localizer["POL"])">
                                <FooterTemplate>
                                    @Localizer["POL"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.pod" Title="@(Localizer["POD"])">
                                <FooterTemplate>
                                    @Localizer["POD"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.TransitTime" Title="@(Localizer["TransitTime"])">
                                <FooterTemplate>
                                    @Localizer["TransitTime"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.Transitport" Title="@(Localizer["Transitport"])">
                                <FooterTemplate>
                                    @Localizer["Transitport"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.shippingline" Title="@(Localizer["Shippingline"])">
                                <FooterTemplate>
                                    @Localizer["Shippingline"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.frequency" Title="@(Localizer["Frequency"])">
                                <FooterTemplate>
                                    @Localizer["Frequency"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.Routing" Title="@(Localizer["Routing"])">
                                <FooterTemplate>
                                    @Localizer["Routing"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.SaleName" Title="@(Localizer["SaleName"])">
                                <FooterTemplate>
                                    @Localizer["SaleName"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.remarks" Title="@(Localizer["Remarks"])">
                                <FooterTemplate>
                                    @Localizer["Remarks"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.validDate" Title="@(Localizer["ValidDate"])">
                                <FooterTemplate>
                                    @Localizer["ValidDate"]
                                </FooterTemplate>
                            </PropertyColumn>


                            <PropertyColumn Property="x => x.userupdate" Title="@(Localizer["Userupdate"])">
                                <FooterTemplate>
                                    @Localizer["Userupdate"]
                                </FooterTemplate>
                            </PropertyColumn>


                            <PropertyColumn Property="x => x.dateupdate" Title="@(Localizer["Dateupdate"])">
                                <FooterTemplate>
                                    @Localizer["Dateupdate"]
                                </FooterTemplate>
                            </PropertyColumn>


                            <PropertyColumn Property="x => x.MasterColoader" Title="@(Localizer["MasterColoader"])">
                                <FooterTemplate>
                                    @Localizer["MasterColoader"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.ETD" Title="@(Localizer["ETD"])">
                                <FooterTemplate>
                                    @Localizer["ETD"]
                                </FooterTemplate>
                            </PropertyColumn>

                            <PropertyColumn Property="x => x.ETA" Title="@(Localizer["ETA"])">
                                <FooterTemplate>
                                    @Localizer["ETA"]
                                </FooterTemplate>
                            </PropertyColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>


                <MudItem xs=6>
                    <MudDataGrid T="M_Credit" Items="@Listdata" Filterable="true" MultiSelection="true" SelectedItemsChanged="@SelectedItemsChanged" 
                                 FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="550px;" Class="custom-credit"
                                 FixedHeader="true" HeaderClass="no-wrap" SelectOnRowClick="false" FooterClass="nondisplay" 
                                 ReadOnly="true" Bordered="true" ColumnResizeMode="ResizeMode.Column" Loading="_loadingCredit">
                        <ToolBarContent>
                            
                            <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
                                <MudText Typo="Typo.h6">@Localizer["Credits"]</MudText>
                                <MudButton HtmlTag="label"
                                           OnClick="RefreshQuo"
                                           Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Refresh">
                                    @Localizer["reload"]
                                </MudButton>
                                <MudButton HtmlTag="label"
                                           OnClick="Copy"
                                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Add">
                                    @Localizer["Copy_Credit"]
                                </MudButton>
                            </MudStack>

                            

                            <MudSpacer />
                        </ToolBarContent>
                        <Columns>
                            <SelectColumn T="M_Credit" />
                      

                            <PropertyColumn Property="x => GetHBL(x.hblid)" Title="@Localizer["HBL"]" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x =>  Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Amount"]" Format="#,##0.##" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Amount Inc. VAT"]" Format="#,##0.##" Required="false" CellStyleFunc="_cellStyleFunc" />

                            <TemplateColumn Title="@Localizer["Copied"]">
                                <CellTemplate>
                                    <MudCheckBox @bind-Checked="context.Item.Copied" @bind-Value="context.Item.Copied" @bind-Value:after="@(()=> OnCopiedCheckboxWrapper(context.Item))">
                                    </MudCheckBox>
                                </CellTemplate>
                            </TemplateColumn>


                            <PropertyColumn Property="x => x.approve" Title="@Localizer["Approve"]" CellStyleFunc="_cellStyleFunc" />
                            <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" CellStyleFunc="_cellStyleFunc"  IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                            <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]"CellStyleFunc="_cellStyleFunc"  IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                            <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>
            </MudGrid>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    string usr;
    List<M_Customer> Customers = new List<M_Customer>();
    List<ChargeModel> charges = new List<ChargeModel>();
    List<M_Credit> DeditSelecteds = new List<M_Credit>();
    List<M_HBL> HBLs = new List<M_HBL>();
    private M_DNTT_Logistics selectedRow;
    private bool _resizeColumn;
    MudDataGrid<M_DNTT_Logistics> mudTable;
    string search_string;
    string search;
    bool _loadingCredit = false;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    Guid? customer_id;
    List<M_Credit> Listdata = new List<M_Credit>();
    [Parameter] public M_HBL _HBL_details { get; set; }
    List<M_Credit> Debit_detail = new List<M_Credit>();
    // Danh sách dòng đang được tick chọn
    private HashSet<M_Credit> SelectedItems { get; set; } = new();

    List<M_Quotation> QUOSelecteds = new List<M_Quotation>();
    List<M_Quotation> Quos = new List<M_Quotation>();

    protected async override Task OnInitializedAsync()
    {
        try
        {
            _loadingCredit = true;
            charges = await supsv.GetListCharge();
            Customers = await csv.GetListAll();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingCredit = false;
        }

    }

    void SelectedItemsChangedQUOs(HashSet<M_Quotation> items)
    {
        QUOSelecteds = items.ToList();
    }

    async Task RefreshQuo()
    {
        try
        {
            if (QUOSelecteds.Count == 0)
            {
                CallSnackBar("Nothing to find!", MudBlazor.Severity.Warning);
                return;
            }
            _loadingCredit = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            SelectedItems.Clear();
            StateHasChanged();
            await Task.Delay(500);
            // Listdata = await shipsv.GetListCreditHBL_where_maincode(HBLSelecteds,"Shipping");

            Listdata = await shipsv.GetListCreditQuotation(QUOSelecteds);
        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingCredit = false;
        }
    }

    private async Task<IEnumerable<Guid>> SearchQuo(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Quos.Select(x => x.quotationID);
            }
            // MBL.Porname = mst_Consignee;
            return Quos.Where(x => !string.IsNullOrEmpty(x.quotationNo) && (x.quotationNo).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.quotationID);

        }
        catch (Exception)
        {
            throw;
        }
    }
    string QuoidtoQuoNo(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = Quos.FirstOrDefault(x => x.quotationID == id);
        return rs == null ? string.Empty : rs.quotationNo!;
    }

    string CustomerName(Guid? customerID)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs.CodeName();
    }

    async Task Refresh_Quo(Guid QuoSelected)
    {
        try
        {
            if (QuoSelected == null || QuoSelected == Guid.Empty)
            {
                CallSnackBar("Nothing to search!", MudBlazor.Severity.Warning);
                return;
            }
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Quos.Clear();
            QUOSelecteds.Clear();
            Listdata.Clear();
            SelectedItems.Clear();
            StateHasChanged();
            await Task.Delay(500);

            Quos = await Quosv.GetListQuotation_ByID(QuoSelected);

        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }


    async Task Refresh()
    {
        try
        {
            Quos.Clear();
            Quos = await Quosv.GetListQuotation();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);
        }


    }

    bool _loading = false;

    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }


    string Charidtocharge(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.DVT} - {rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }

    async Task SelectedItemsChanged(HashSet<M_Credit> items)
    {

        var copiedItems = items.Where(x => x.Copied == true).ToList();
        var validItems = items.Where(x => x.Copied != true).ToHashSet(); 

        if (copiedItems.Any())
        {
            CallSnackBar($"Data Copied", MudBlazor.Severity.Error);

            // Cập nhật lại danh sách đã chọn (bỏ các dòng Copied khỏi SelectedItems)
            SelectedItems = validItems;

            // Cần gọi StateHasChanged để cập nhật giao diện sau khi thay đổi SelectedItems
            StateHasChanged();
        }

        DeditSelecteds = validItems.ToList();



    }


    string GetHBL(Guid? hblid)
    {
        if (hblid == Guid.Empty) return string.Empty;
        var rs = HBLs.FirstOrDefault(x => x.hblID != Guid.Empty && x.hblID == hblid);
        return string.IsNullOrEmpty(rs.hbl) ? string.Empty : rs.hbl;
    }

    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };

    async Task Copy()
    {
        try
        {
            foreach (var item in DeditSelecteds)
            {
                var newDebit = new M_Credit
                    {
                        creditid = Guid.Empty,
                        quotationid = Guid.Empty,
                        mblid = _HBL_details.mblid,
                        hblid = _HBL_details.hblID,
                        itemid = item.itemid,
                        customerid = item.customerid,
                        dongia = item.dongia,
                        soluong = item.soluong,
                        type = item.type,
                        thanhtien = item.thanhtien,
                        tiente = item.tiente,
                        thue = item.thue,
                        thanhtiensauthue = item.thanhtiensauthue,
                        chiho = item.chiho,
                        tigiacredit = item.tigiacredit,
                        tigiahoadondauvao = item.tigiahoadondauvao,
                        dateupdate = DateTime.Now.ToString("dd/mm/yyyy"),
                        userupdate = asv.GetAuth().Result.User.Identity!.Name!,
                        continued = true,
                        editable = true,
                        approve = false,
                        DNTT=false,
                        DNTU=false,
                        Copied = false,

                    };
                await shipsv.CreateCreditMBL(newDebit);
                item.Copied = true;
                await shipsv.UpdateCreditMBL_Copy_Credit(item);
            }
            CallSnackBar($"Copy Success", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar($"Somethings went wrong, {ex.Message}", MudBlazor.Severity.Error);
        }


    }
   

    private async Task OnCopiedCheckboxWrapper(M_Credit item)
    {
        item.Copied = false;
        var rs = await shipsv.UpdateCreditMBL_Copy_Credit(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

         await RefreshQuo();

    }

    private Func<M_Credit, string> _cellStyleFunc => x =>
     {
         if(x.Copied == true)
         {
             return "color: red;";
         }
         else
         {
             return "color: #000000";
         }
  
     };
}