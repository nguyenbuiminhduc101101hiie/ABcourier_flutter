@using MudBlazor
@using ABFreight.Models

<MudDialog Style="max-height: 95vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (IsDebit)
        {
            <DebitTab_QuanLy @key="@ContextKey"
                             QuanLyCont="QuanLyCont"
                             QuanLyTau="QuanLyTau"
                             GridHeight="calc(90vh - 140px)" />
        }
        else
        {
            <CreDitTab_QuanLy @key="@ContextKey"
                              QuanLyCont="QuanLyCont"
                              QuanLyTau="QuanLyTau"
                              GridHeight="calc(90vh - 140px)" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public QuanLy_Cont? QuanLyCont { get; set; }
    [Parameter] public QuanLy_Tau? QuanLyTau { get; set; }
    [Parameter] public bool IsDebit { get; set; } = true;
    [Parameter] public string Title { get; set; } = "Debit / Credit";

    private string ContextKey => IsDebit
        ? $"debit-{QuanLyCont?.Id ?? QuanLyTau?.Id}"
        : $"credit-{QuanLyCont?.Id ?? QuanLyTau?.Id}";

    private void Close() => MudDialog.Close();
}
