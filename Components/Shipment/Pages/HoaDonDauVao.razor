@using System.Globalization﻿
@using Microsoft.AspNetCore.Components.Forms
﻿
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject InvoicePdfImportService invoicePdfImportService
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
<MudTabs SliderColor="Color.Secondary">
    <MudTabPanel Text="Hóa Đơn Đầu Vào">
        <MudDataGrid T="M_HoaDonDauVao" Items="@Listdata" Filterable="true" @ref="mudTable"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>

                            <!-- Nút Add -->
                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="AddItem"
                                Disabled="@(_importingPdf || (isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false)))"
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Import PDF"]">
                                <MudIconButton Icon="@Icons.Material.Filled.UploadFile"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               HtmlTag="label"
                                               for="@_pdfInputId"
                                               Disabled="@(_importingPdf || (isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false)))"
                                               Variant="Variant.Filled"
                                               Class="btn-compact" />
                            </MudTooltip>
                            <InputFile id="@_pdfInputId" OnChange="ImportInvoicePdfAsync" accept=".pdf,application/pdf" style="display:none" />
                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.CreditScore" OnClick="@(() => CreateCongNo(context.Item))" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => TryStartEditing(context.Item))" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="Customer" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.customerid" Label="@Localizer["Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.dongia" Class="text-right"
                        Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.soluong"
                        Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtien" Label="@Localizer["Total Price"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.tiente" Label="@Localizer["Currency"]">
                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.tigia" Title="@Localizer["tigia"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.tigia" Label="@Localizer["tigia"]"
                                         Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" Required="true" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thue" Label="@Localizer["VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtiensauthue" Label="@Localizer["Total Price Inc. VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.sohoadonNoibo" Title="@Localizer["Offline invoice number"]" Required="false" />
                <PropertyColumn Property="x => x.sohoadonDientu" Title="@Localizer["Online invoice number"]" Required="false" />
                <PropertyColumn Property="x => x.ngayphathanhhoadonDientu" Title="@Localizer["Invoice issue date"]" Required="false">
                    <EditTemplate>
                        <MudDatePicker @bind-Date=context.Item.ngayphathanhhoadonDientu Label="@Localizer["Invoice issue date"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
            </Columns>
        </MudDataGrid>
        @if (Listdata.Count > 0)
        {
            <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">Total Inc. VAT: @(Listdata.Sum(x => x.thanhtiensauthue)!.Value.ToString("#,##0.##", _en)) VND</MudText>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">Total Công Nợ: @(ListdataCongNo.Sum(x => x.tongtien)!.Value.ToString("#,##0.##", _en)) VND</MudText>
            </MudStack>
        }
    </MudTabPanel>
    <MudTabPanel Text="Công Nợ Hóa Đơn Đầu Vào">
        <CongNoHoaDonDauVao HoaDonDetail="detail ==  null ? new M_HoaDonDauVao() : detail" />
    </MudTabPanel>
</MudTabs>
@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    M_HoaDonDauVao detail_hoadon;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    bool isMBL;
    string usr;
    protected async override Task OnInitializedAsync()
    {
        try
        {


            isMBL = MBLDetail == null ? false : true;
            if (isMBL)
            {
                if (MBLDetail.MblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng MBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            else
            {
                if (HBLDetail.hblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }
    bool _loading = false;
    bool _importingPdf = false;
    readonly string _pdfInputId = $"invoice-pdf-import-{Guid.NewGuid():N}";
    const long MaxPdfFileSize = 15 * 1024 * 1024;
    List<M_HoaDonDauVao> Listdata = new List<M_HoaDonDauVao>();
    List<M_CongNoHoaDonDauVao> ListdataCongNo = new List<M_CongNoHoaDonDauVao>();
    M_HoaDonDauVao detail;
    async Task Refresh()
    {
        try
        {
            detail = null;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "MBL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
                Listdata = await shipsv.GetListHoaDonDauVaoMBL(MBLDetail!.MblID);
            else
                Listdata = await shipsv.GetListHoaDonDauVaoHBL(HBLDetail!.hblID);
            ListdataCongNo.Clear();
            foreach (var item in Listdata)
            {
                var rs = await shipsv.GetListCongNoHoaDonDauVaoMBL(item!.hoadondauvaoid);
                ListdataCongNo.AddRange(rs);
            }
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_HoaDonDauVao> mudTable;
    async Task AddItem()
    {
        var item = new M_HoaDonDauVao();
    item.sohoadonNoibo = detail?.sohoadonNoibo;
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task ImportInvoicePdfAsync(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.FileCount == 0)
                return;

            if (e.FileCount > 1)
            {
                CallSnackBar(Localizer["Only one PDF file can be imported at a time."], MudBlazor.Severity.Warning);
                return;
            }

            var file = e.File;
            if (file == null)
            {
                CallSnackBar(Localizer["No file found to import."], MudBlazor.Severity.Warning);
                return;
            }

            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                CallSnackBar(Localizer["Invalid file format. Please select a PDF file."], MudBlazor.Severity.Warning);
                return;
            }

            if (file.Size <= 0)
            {
                CallSnackBar(Localizer["The PDF file is empty."], MudBlazor.Severity.Warning);
                return;
            }

            if (file.Size > MaxPdfFileSize)
            {
                CallSnackBar(Localizer["The PDF file exceeds the limit of {0}MB.", MaxPdfFileSize / 1024 / 1024], MudBlazor.Severity.Warning);
                return;
            }

            _importingPdf = true;

            await using var fileStream = file.OpenReadStream(MaxPdfFileSize);
            var parsed = await invoicePdfImportService.ParseAsync(fileStream);
            var errors = parsed.ValidationErrors();
            if (errors.Count > 0)
            {
                CallSnackBar(string.Join(" ", errors.Select(x => Localizer[x])), MudBlazor.Severity.Error);
                return;
            }

            var customerResult = await csv.GetOrCreateCustomerForInvoiceAsync(
                parsed.BuyerTaxCode,
                parsed.BuyerName,
                parsed.BuyerAddress,
                usr);

            if (!customerResult.Response.Flag || customerResult.Customer == null)
            {
                CallSnackBar(Localizer[customerResult.Response.Message], MudBlazor.Severity.Error);
                return;
            }

            if (!Customers.Any(x => x.Customer_ID == customerResult.Customer.Customer_ID))
            {
                Customers.Add(customerResult.Customer);
            }

            if (customerResult.IsCreated)
            {
                CallSnackBar(Localizer["New customer created: {0}", customerResult.Customer.COMPANY], MudBlazor.Severity.Info);
            }

            if (IsDuplicateImportedInvoice(parsed.Serial!, parsed.InvoiceIssueDate!.Value, parsed.TotalPayment!.Value))
            {
                CallSnackBar(Localizer["This invoice already exists in the current MBL/HBL. Skipped."], MudBlazor.Severity.Warning);
                return;
            }

            var item = new M_HoaDonDauVao
            {
                mblid = isMBL ? MBLDetail!.MblID : Guid.Empty,
                hblid = isMBL ? Guid.Empty : HBLDetail!.hblID,
                customerid = customerResult.Customer.Customer_ID,
                dongia = parsed.TotalAmount,
                soluong = 1,
                thanhtien = parsed.TotalAmount,
                tiente = "VND",
                tigia = 1,
                thue = parsed.VatRate,
                thanhtiensauthue = parsed.TotalPayment,
                sohoadonNoibo = parsed.Serial,
                sohoadonDientu = parsed.Serial,
                ngayphathanhhoadonDientu = parsed.InvoiceIssueDate,
                userupdate = usr,
                dateupdate = DateTime.Now.ToString(),
                continued = true,
                editable = true,
                approve = false,
                tennguoimua = parsed.BuyerName,
                mstnguoimua = parsed.BuyerTaxCode,
                diachinguoimua = parsed.BuyerAddress,
                nguonimport = "PDF",
                tenfile = file.Name
            };

            var createResult = await shipsv.CreateHoaDonDauVaoMBL(item);
            CallSnackBar(Localizer[createResult.Message], createResult.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            if (createResult.Flag)
                await Refresh();
        }
        catch (IOException ex)
        {
            CallSnackBar(Localizer["Cannot read PDF file: {0}", ex.Message], MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["PDF import failed: {0}", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _importingPdf = false;
        }
    }

    bool IsDuplicateImportedInvoice(string serial, DateTime issueDate, double totalPayment)
    {
        return Listdata.Any(x =>
            string.Equals(x.sohoadonDientu?.Trim(), serial.Trim(), StringComparison.OrdinalIgnoreCase)
            && x.ngayphathanhhoadonDientu.HasValue
            && x.ngayphathanhhoadonDientu.Value.Date == issueDate.Date
            && Math.Abs((x.thanhtiensauthue ?? 0) - totalPayment) < 0.01);
    }

    async Task DeleteItem(M_HoaDonDauVao item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteHoaDonDauVaoMBL(item);

            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_HoaDonDauVao item)
    {
        if (isMBL)
            item.mblid = MBLDetail!.MblID;
        else
            item.hblid = HBLDetail!.hblID;
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString();
        var rs = item.hoadondauvaoid != Guid.Empty ? await shipsv.UpdateHoaDonDauVaoMBL(item,detail_hoadon) : await shipsv.CreateHoaDonDauVaoMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_HoaDonDauVao Sis, int rowNumber)
    {
        if (Sis.approve.HasValue && Sis.approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
        // if (selectedRowNumber == rowNumber)
        // {
        //     selectedRowNumber = -1;
        //     return string.Empty;
        // }
        // else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        // {
        //     selectedRowNumber = rowNumber;
        //     return "selected";
        // }
        // else
        // {
        //     return string.Empty;
        // }
    }
    void RowClicked(DataGridRowClickEventArgs<M_HoaDonDauVao> args)
    {
        if (args.Item.approve.HasValue && args.Item.approve.Value)
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Info);
        else detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_HoaDonDauVao> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }
    private void CalculateTotal(M_HoaDonDauVao item)
    {
        if (item.soluong.HasValue && item.dongia.HasValue)
        {

            double soluong = item.soluong ?? 0;
            double dongia = item.dongia ?? 0;
            item.thanhtien = Math.Round(soluong * dongia, 2);
            CalculateThanhtiensauthue(item);
        }


    }

    private void CalculateThanhtiensauthue(M_HoaDonDauVao item)
    {
        if (item.thanhtien.HasValue && item.thue.HasValue)
        {
            double thanhtienValue = item.thanhtien ?? 0;
            double thueValue = item.thue ?? 0;
            item.thanhtiensauthue = Math.Round(thanhtienValue * (thueValue / 100 + 1), 2);
        }


    }
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    async Task CreateCongNo(M_HoaDonDauVao item)
    {
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };
        var parameters = new DialogParameters<DialogCreateCongNo> { { x => x.HDDV, item }, { x => x.isHDDR, false } };
        var dialog = await DialogService.ShowAsync<DialogCreateCongNo>($"Tạo công nợ", parameters, optionsdialog);
        var resultMess = await dialog.Result;
    }

    async Task UpdatebyCheckboxClick(M_HoaDonDauVao item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "HBL"))
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateHoaDonDauVaoMBL_approve(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task TryStartEditing(M_HoaDonDauVao item)
    {
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Warning);
            return;
        }
   
        detail_hoadon = JsonSerializer.Deserialize<M_HoaDonDauVao>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
}
