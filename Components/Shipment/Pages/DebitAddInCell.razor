@using System.Globalization
@using System.Linq
@inject IDialogService DialogService
@inject tigiaVCBservices Vcbsv
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ShipmentService shipsv
@inject ISnackbar Snackbar
<style>
    /* Cột tự giãn theo nội dung, không cắt chữ; màn hình hẹp thì scroll ngang */
    .debit-addincell-table table { table-layout: auto; width: max-content; min-width: 100%; }
    .debit-addincell-table th,
    .debit-addincell-table td { white-space: nowrap; padding: 4px 6px !important; }
    /* Độ rộng tối thiểu cho ô nhập khi đang sửa (theo thứ tự cột) */
    .debit-addincell-table td:nth-child(2) { min-width: 210px; } /* Số Debit */
    .debit-addincell-table td:nth-child(3),
    .debit-addincell-table td:nth-child(4) { min-width: 230px; } /* Khách hàng, Tên phí */
    .debit-addincell-table td:nth-child(5),
    .debit-addincell-table td:nth-child(8),
    .debit-addincell-table td:nth-child(11) { min-width: 120px; } /* Đơn giá, Thành tiền, Sau thuế */
    .debit-addincell-table td:nth-child(6),
    .debit-addincell-table td:nth-child(12),
    .debit-addincell-table td:nth-child(13) { min-width: 100px; } /* Loại, Tỉ giá */
    .debit-addincell-table td:nth-child(7),
    .debit-addincell-table td:nth-child(9),
    .debit-addincell-table td:nth-child(10) { min-width: 80px; } /* Số lượng, Loại tiền, Thuế */
</style>
<MudDialog>
    <DialogContent>
        <MudPaper Class="pa-4">
            <!-- Bảng hiển thị các dòng M_Debit -->
            <MudTable Items="@rows" Hover="true" Dense="true" FixedHeader HorizontalScrollbar="true" Class="debit-addincell-table">
                <HeaderContent>
                    <MudTh>Thao tác</MudTh>
                    <MudTh>Số Debit</MudTh>
                    <MudTh>Khách hàng</MudTh>
                    <MudTh>Tên phí</MudTh>
                    <MudTh>Đơn giá</MudTh>
                    <MudTh>Loại</MudTh>
                    <MudTh>Số lượng</MudTh>
                    <MudTh>Thành tiền</MudTh>
                    <MudTh>Loại tiền</MudTh>
                    <MudTh>Thuế (%)</MudTh>
                    <MudTh>Thành tiền sau thuế</MudTh>
                    <MudTh>Tỉ giá</MudTh>
                    <MudTh>Tỉ giá hóa đơn</MudTh>
                    <MudTh>Thu hộ</MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                     <MudTd>
                        @if (item.editable == true)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" OnClick="() => SaveRow(item)" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => BeginEdit(item)" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteRow(item)" />
                    </MudTd>
                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                                <MudAutocomplete T="string" @bind-Value="item.debitno"
                                                 Placeholder="Số Debit" SearchFunc="SearchDebitNo"
                                                 CoerceText="false" CoerceValue="true" Clearable />
                                <MudTooltip Text="Lấy số Debit mới">
                                    <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="() => GetNewDebitNo(item)" />
                                </MudTooltip>
                            </MudStack>
                        }
                        else
                        {
                            @item.debitno
                        }
                    </MudTd>
                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudAutocomplete T="Guid" Value="item.customerid" ValueChanged="@(v => ChangeCustomer(item, v))"
                                             Placeholder="Khách hàng" Required Lines="2"
                                             SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
                        }
                        else
                        {
                            @CusidtoCusCode(item.customerid)
                        }
                    </MudTd>
                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudAutocomplete @bind-Value="item.itemid" Required
                                             Placeholder="Phí" Lines="2"
                                             SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable />
                        }
                        else
                        {
                            @Charidtocharge(item.itemid)
                        }
                    </MudTd>
                    <MudTd Class="text-align: right;">
                        @if (item.editable == true)
                        {
                            <MudNumericField @bind-Value="item.dongia" Class="text-right"
                                             Format="#,##0.##" Culture="@_en" T="double?"
                                             Placeholder="Đơn giá" Immediate
                                             TextChanged="@(e => CalculateTotal(item))" HideSpinButtons="true" />
                        }
                        else
                        {
                            @(item.dongia?.ToString("#,##0.##"))
                        }
                    </MudTd>

                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudAutocomplete @bind-Value="item.type" Required
                                             @bind-Value:after="@(() => ApplyQuantityByType(item))"
                                             Placeholder="Loại"
                                             SearchFunc="SearchType" CoerceValue />
                        }
                        else
                        {
                            @(item.type)
                        }
                    </MudTd>

                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudNumericField T="double?" @bind-Value="item.soluong"
                                             Placeholder="Số lượng" 
                                             TextChanged="@(e => CalculateTotal(item))"
                                             Immediate="true" />
                        }
                        else
                        {
                            @(item.soluong)
                        }
                    </MudTd>

                    <MudTd Class="text-align: right;">
                        @if (item.editable == true)
                        {
                            <MudNumericField T="double?" @bind-Value="item.thanhtien"
                                             Placeholder="Thành tiền"
                                             Format="#,##0.##" Culture="@_en" T="double?"
                                             Immediate="true" HideSpinButtons="true" />
                        }
                        else
                        {
                            @(item.thanhtien?.ToString("#,##0.##"))
                        }
                    </MudTd>

                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudAutocomplete @bind-Value="item.tiente" Immediate
                                             Placeholder="Loại tiền" @bind-Value:after="@(() => ChangeTiGia(item))"
                                             Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                        }
                        else
                        {
                            @(item.tiente)
                        }
                    </MudTd>
                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudNumericField @bind-Value="item.thue"
                                             Placeholder="Thuế" Immediate
                                             Format="#,##0.##" Culture="@_en" T="double?"
                                             TextChanged="@(e => CalculateThanhtiensauthue(item))" HideSpinButtons="true" />
                        }
                        else
                        {
                            @(item.thue.ToString())
                        }
                    </MudTd>
                    <MudTd Class="text-align: right;">
                        @if (item.editable == true)
                        {
                            <MudNumericField @bind-Value="item.thanhtiensauthue"
                                             Placeholder="Thành tiền sau thuế"
                                             Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                        }
                        else
                        {
                            @(item.thanhtiensauthue!.Value.ToString("#,##0.##"))
                        }
                    </MudTd>
                    <MudTd Class="text-align: right;">
                        @if (item.editable == true)
                        {
                            <MudNumericField @bind-Value="item.tigiadebit"
                                            Placeholder="Tỉ giá" 
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                             Class="text-right" />
                        }
                        else
                        {
                            @(item.tigiadebit!.Value.ToString("#,##0.##"))
                        }
                    </MudTd>
                    <MudTd Class="text-align: right;">
                        @if (item.editable == true)
                        {
                            <MudNumericField @bind-Value="item.tigiahoandondaura"
                                             Placeholder="Tỉ giá hóa đơn"
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                             Class="text-right" />
                        }
                        else
                        {
                            @(item.tigiahoandondaura!.Value.ToString("#,##0.##"))
                        }
                    </MudTd>
                    <MudTd>
                        @if (item.editable == true)
                        {
                            <MudCheckBox @bind-Value="item.thuho"/>
                        }
                        else
                        {
                            <MudCheckBox Value="item.thuho" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider Class="my-4" />

            <!-- Nút thêm dòng mới -->
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew">
                Thêm dòng
            </MudButton>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Đóng</MudButton>
        @* <MudButton OnClick="Submit" Color="Color.Primary">Lưu</MudButton> *@
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public List<M_Debit> Debits { get; set; } = new();
    [Parameter] public List<M_Debit> Debitsdf { get; set; } = new();
    [Parameter] public List<string> currs { get; set; } = new();
    [Parameter] public string Type { get; set; } = default!;
    [Parameter] public string usr { get; set; } = default!;
    [Parameter] public bool isMBL { get; set; } = default!;
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public List<string> Types { get; set; } = new();
    [Parameter] public List<ChargeModel> charges { get; set; } = new();
    [Parameter] public Guid maincus { get; set; } = new();
    /// <summary>Số Debit của dòng đang chọn ở màn hình gọi; có thì "Thêm dòng" dùng số này.</summary>
    [Parameter] public string? DefaultDebitNo { get; set; }
    // Sao chép dữ liệu ra danh sách tạm để thao tác
    private List<M_Debit> rows = new();

    protected override void OnInitialized()
    {
        rows = Debits.Select(d =>
        {
            d.editable = false;
            return d;
        }).Where(x=>x.approve == false).ToList();
        rows.AddRange(Debitsdf.Select(d =>
        {
            d.editable = true;
            return d;
        }).Where(x => x.approve == false).ToList());
        CallSnackBar($"Loaded {Debitsdf.Count} from Debit Template", MudBlazor.Severity.Success);
    }
    // Container của lô (HBL/MBL) để gợi ý số lượng theo Type
    private List<M_Container> _containers = new();
    private bool _containersLoaded;

    protected async override Task OnParametersSetAsync()
    {
        Types = await shipsv.GetListTypeInDebitCredit();
        foreach (var i in Debitsdf)
            i.tigiadebit = i.tigiahoandondaura = await GetTigia(i.tiente);
        if (!_containersLoaded)
        {
            _containers = await GetContainersForShipmentAsync();
            _containersLoaded = true;
            // Dòng lấy từ template: số lượng theo Type (CBM / loại cont / 1)
            foreach (var i in Debitsdf)
                ApplyQuantityByType(i);
        }
    }
    async Task AddNew()
    {
        if (!await ssv.CheckPermission(usr, "Add", "HBL"))
        {
            CallSnackBar("You have not access to Add in HBL", MudBlazor.Severity.Warning);
            return;
        }
        var newRow = new M_Debit
            {
                // debitId = Guid.NewGuid(),
                customerid = maincus,
                editable = true,
                tiente = "VND",
                type = Types.First(),
                soluong = 1,
                dongia = 0,
                itemid = charges.First().CHARGE_ID,
                thanhtien = 0,
                thue = 0,
                thanhtiensauthue = 0
            };
        if (isMBL)
            newRow.mblid = MBLDetail!.MblID;
        else
            newRow.hblid = HBLDetail!.hblID;
        newRow.userupdate = usr;
        newRow.dateupdate = DateTime.Now.ToString();
        newRow.tigiadebit = newRow.tigiahoandondaura = await GetTigia(newRow.tiente);
        ApplyQuantityByType(newRow);
        // Dùng chung số Debit của lô + khách hàng (dòng gần nhất chưa in/duyệt), chưa có mới cấp số mới
        newRow.debitno = DefaultDebitNo
                         ?? FindReusableDebitNo(rows, newRow.customerid)
                         ?? await UpdateDebitNo(newRow, DateTime.Now);
        rows.Add(newRow);
    }

    /// <summary>
    /// Tìm DebitNo có thể dùng chung cho khách hàng: dòng mới nhất có số, chưa in Debit và chưa duyệt.
    /// </summary>
    public static string? FindReusableDebitNo(IEnumerable<M_Debit> debits, Guid customerId)
        => debits.LastOrDefault(x => x.customerid == customerId
                                     && !string.IsNullOrWhiteSpace(x.debitno)
                                     && x.daIndebit != true
                                     && x.approve != true)?.debitno;

    // Cấp số Debit mới cho riêng dòng này (tiêu 1 RefNo)
    async Task GetNewDebitNo(M_Debit item)
    {
        item.debitno = await UpdateDebitNo(item, DateTime.Now);
        CallSnackBar($"Đã lấy số Debit mới: {item.debitno}", MudBlazor.Severity.Info);
    }

    // Đổi khách hàng: dòng mới (chưa lưu) lấy lại số Debit dùng chung theo khách hàng mới
    async Task ChangeCustomer(M_Debit item, Guid customerId)
    {
        if (item.customerid == customerId) return;
        item.customerid = customerId;
        if (item.debitId == Guid.Empty && customerId != Guid.Empty)
            item.debitno = FindReusableDebitNo(rows.Where(x => x != item), customerId)
                           ?? await UpdateDebitNo(item, DateTime.Now);
    }

    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    private Task<IEnumerable<Guid>> SearchCustomer(string? text)
    {
        var cus = string.IsNullOrWhiteSpace(text)
            ? Customers
            : Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(cus.Select(x => x.Customer_ID));
    }

    private Task<IEnumerable<string>> SearchDebitNo(string? text)
    {
        var nos = rows.Concat(Debits)
            .Select(x => x.debitno)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(text))
            nos = nos.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(nos);
    }

    async Task BeginEdit(M_Debit row)
    {
        if (!await ssv.CheckPermission(usr, "Edit", "HBL"))
        {
            CallSnackBar("You have not access to Edit in HBL", MudBlazor.Severity.Warning);
            return;
        }
        row.editable = true;
        detail_Debit = row;
    }
    M_Debit detail_Debit = new();

    async Task<List<M_Container>> GetContainersForShipmentAsync()
    {
        if (isMBL && MBLDetail != null)
            return await shipsv.GetListContainerMBLAsync(MBLDetail.MblID);
        if (!isMBL && HBLDetail != null)
            return shipsv.GetListContainerHBL(HBLDetail.hblID);
        return new List<M_Container>();
    }

    static double SumContainerCbm(IEnumerable<M_Container> containers)
    {
        double sum = 0;
        foreach (var c in containers)
        {
            if (string.IsNullOrWhiteSpace(c.cbm))
                continue;
            var s = c.cbm.Trim().Replace(',', '.');
            if (double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
                sum += v;
            else if (double.TryParse(c.cbm.Trim(), NumberStyles.Any, CultureInfo.GetCultureInfo("vi-VN"), out v))
                sum += v;
        }
        return sum;
    }

    private static readonly System.Text.RegularExpressions.Regex ContainerSizeTokenRegex =
        new(@"(20|40|45)[A-Za-z]{0,4}", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string NormalizeAlnum(string? s)
        => string.IsNullOrWhiteSpace(s) ? string.Empty : new string(s.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();

    /// <summary>
    /// Giống DebitTab: Type "CBM" -> tổng CBM container của lô; Type chứa cont size (20/40/45, vd CONT 20GP)
    /// -> đếm số container cùng size/type; Type khác -> 1. Chỉ là gợi ý, người dùng vẫn sửa Số lượng được.
    /// </summary>
    private void ApplyQuantityByType(M_Debit item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.type))
            return;

        var typeText = item.type.Trim();
        var normalizedType = NormalizeAlnum(typeText);

        if (normalizedType.Contains("CBM"))
        {
            item.soluong = Math.Round(SumContainerCbm(_containers), 2);
        }
        else if (typeText.Contains("20") || typeText.Contains("40") || typeText.Contains("45"))
        {
            var tokenMatch = ContainerSizeTokenRegex.Match(normalizedType);
            var digitPrefix = tokenMatch.Success
                ? tokenMatch.Groups[1].Value
                : typeText.Contains("20") ? "20" : typeText.Contains("40") ? "40" : "45";
            var fullToken = tokenMatch.Success ? tokenMatch.Value : digitPrefix;

            var exactCount = _containers.Count(c => NormalizeAlnum(c.CTN_SIZE_TYPE) == fullToken);
            item.soluong = exactCount > 0
                ? exactCount
                : _containers.Count(c => NormalizeAlnum(c.CTN_SIZE_TYPE).Contains(digitPrefix));
        }
        else
        {
            item.soluong = 1;
        }

        CalculateTotal(item);
    }

    async Task SaveRow(M_Debit item)
    {
        var rs = item.debitId != Guid.Empty ? await shipsv.UpdateDebitMBL(item, detail_Debit) : await shipsv.CreateDebitMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        item.editable = false;
    }

    async Task DeleteRow(M_Debit row)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "HBL"))
        {
            CallSnackBar("You have not access to Delete in HBL", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteDebitMBL(row);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if(rs.Flag)
                rows.Remove(row);
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        // Trả dữ liệu về component gọi dialog
        rows.ForEach(x => x.editable = true);
        MudDialog.Close(DialogResult.Ok(rows));
    }
    
    private async Task ChangeTiGia(M_Debit item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.tiente ?? "");
        item.tigiadebit = item.tigiahoandondaura = tigia_;
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }
    private void CalculateTotal(M_Debit item)
    {
        if (item.soluong.HasValue && item.dongia.HasValue)
        {

            double soluong = item.soluong ?? 0;
            double dongia = item.dongia ?? 0;
            item.thanhtien = Math.Round(soluong * dongia, 2);
            CalculateThanhtiensauthue(item);
        }


    }

    private void CalculateThanhtiensauthue(M_Debit item)
    {
        if (item.thanhtien.HasValue && item.thue.HasValue)
        {
            double thanhtienValue = item.thanhtien ?? 0;
            double thueValue = item.thue ?? 0;
            item.thanhtiensauthue = Math.Round(thanhtienValue * (thueValue / 100 + 1), 2);
        }


    }
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    async Task<string> UpdateDebitNo(M_Debit item, DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("Debit", value.Month, value.Year, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        var flc = await shipsv.GetFLCByMBLID(isMBL ? MBLDetail!.MblID : HBLDetail!.mblid);
        var debitno = cn + tiepdaungu + Type + flc + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D4") : "RefNoError!");
        return debitno;
    }
    private async Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return charges.Select(x => x.CHARGE_ID);
            }
            // MBL.Porname = mst_Consignee;
            return charges.Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.CHARGE_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }

    string Charidtocharge(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }

    private async Task<IEnumerable<string>> SearchType(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Types;
            }
            // MBL.Porname = mst_Consignee;
            return Types.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<double?> GetTigia(string? cur)
    {
        var rs = await Vcbsv.Getexchange_cur(cur);
        return rs;
    }
}
