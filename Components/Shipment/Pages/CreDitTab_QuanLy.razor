@using System.Data
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using OfficeOpenXml
@using ExcelDataReader
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ShipmentService shipsv
@inject tigiaVCBservices Vcbsv
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="M_Credit"
             Items="@Listdata"
             Filterable="true"
             @ref="mudTable"
             Bordered="true"
             FilterMode="@DataGridFilterMode.Simple"
             Dense="true"
             Virtualize="true"
             FixedHeader="true"
             FixedFooter="true"
             HeaderClass="no-wrap"
             FooterClass="no-wrap"
             ReadOnly="true"
             MultiSelection="true"
             SelectOnRowClick="false"
             @bind-SelectedItems="_selectedItems"
             @bind-SelectedItems:after="FilterCopiedSelection"
             RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked"
             ColumnResizeMode="ResizeMode.Column"
             Loading="_loading"
             ShowColumnOptions="false"
             Height="@GridHeight">
    <Columns>
        <SelectColumn T="M_Credit" />

        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
            <HeaderTemplate>
                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
                    <MudTooltip Text="@Localizer["Reload"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="Refresh"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["New"]">
                        <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="NewItem"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["Add"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="AddItem"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                    @if (IsContContext)
                    {
                        <MudTooltip Text="Đẩy phí đã chọn sang HBL và Quản lý cont">
                            <MudIconButton Icon="@Icons.Material.Filled.Publish"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="PushSelectedFeesAsync"
                                           Variant="Variant.Filled"
                                           Disabled="@(!_canEditContext || _selectedItems.Count == 0)"
                                           Class="btn-compact" />
                        </MudTooltip>
                    }
                    <MudSelect T="string" @bind-Value="_importFileType"
                               Label="Loại file"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Style="min-width: 210px;">
                        @foreach (var opt in EorImportDefinitions.FileTypeOptions)
                        {
                            <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="@($"Import {CurrentImportTypeLabel} Excel")">
                        <MudButton HtmlTag="label"
                                   Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Upload"
                                   Disabled="@(!_canEditContext || _importing)"
                                   Class="btn-compact"
                                   Style="min-width: 36px; height: 30px; padding: 0 6px;">
                            <InputFile OnChange="OnImportInputChanged"
                                       accept=".xlsx,.xls"
                                       style="display:none" />
                        </MudButton>
                    </MudTooltip>
                </MudStack>
            </HeaderTemplate>
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell" />
        <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell" />
        <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.DNTT" Title="@Localizer["DNTT"]" IsEditable="false" Required="false">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.DNTT" ReadOnly="true" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false" />
        <PropertyColumn Property="x => x.ContainerNo" Title="@Localizer["Cont. No."]" Required="false" />
        <PropertyColumn Property="x => x.Date_Of_EST" Title="Date Of EST" Format="dd/MM/yyyy" Required="false" />
        <PropertyColumn Property="x => x.Size" Title="Size" Required="false" />
        <PropertyColumn Property="x => x.Date_In_Yard" Title="Date In Yard" Format="dd/MM/yyyy" Required="false" />
        <PropertyColumn Property="x => x.Manufacturing_Date" Title="Manufacturing Date" Required="false" />
        <PropertyColumn Property="x => x.IT" Title="IT" Required="false" />
        <PropertyColumn Property="x => x.Com_Code" Title="Com Code" Required="false" />
        <PropertyColumn Property="x => x.COMPONENTS_DETAILS" Title="Components Details" Required="false" />
        <PropertyColumn Property="x => x.LOC" Title="LOC" Required="false" />
        <PropertyColumn Property="x => x.DM_Code" Title="DM Code" Required="false" />
        <PropertyColumn Property="x => x.RP_Code" Title="RP Code" Required="false" />
        <PropertyColumn Property="x => x.LHT" Title="LHT" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.WDT" Title="WDT" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.R" Title="R" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.Hours" Title="Hours" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.Labor_Cost" Title="Labor Cost" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.Material_Cost" Title="Material Cost" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.Labor_Rate" Title="Labor Rate" Format="#,##0.##" Required="false" />
        <PropertyColumn Property="x => x.Billing" Title="Billing" Required="false" />
        <PropertyColumn Property="x => x.Owner" Title="Owner" Required="false" />
        <PropertyColumn Property="x => x.Location" Title="Location" Required="false" />
        <PropertyColumn Property="x => x.EstNo" Title="Est No" Required="false" />
        <PropertyColumn Property="x => x.Grade" Title="Grade" Required="false" />
        <PropertyColumn Property="x => x.DamageDetail" Title="Damage Detail" Required="false" />
        <PropertyColumn Property="x => x.Remark" Title="Remark" Required="false" />
        <PropertyColumn Property="x => x.ghichu_credit" Title="@Localizer["Notes"]" Required="false" />
        <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" />
        <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false" />
    </Columns>
</MudDataGrid>

@if (Listdata.Count > 0)
{
    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true" Style="margin-right:20px;">
            Total: @(Listdata.Sum(x => x.thanhtien / (x.tiente == "VND" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en)) USD
        </MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">
            Total: @(Listdata.Sum(x => x.thanhtien * (x.tiente == "USD" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en)) VND
        </MudText>
    </MudStack>
}

@code {
    [Parameter] public QuanLy_Cont? QuanLyCont { get; set; }
    [Parameter] public QuanLy_Tau? QuanLyTau { get; set; }
    [Parameter] public string GridHeight { get; set; } = "420px";

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private MudDataGrid<M_Credit> mudTable = default!;
    private List<M_Credit> Listdata = new();
    private List<M_Customer> Customers = new();
    private List<ChargeModel> charges = new();
    private List<string> currs = new();
    private M_Credit? detail;
    private M_Credit? detail_credit;
    private HashSet<M_Credit> _selectedItems = new();
    private bool _loading;
    private bool _importing;
    private bool _initialized;
    private string _importFileType = "EOR_ASR";

    private string CurrentImportTypeLabel =>
        EorImportDefinitions.FileTypeOptions.FirstOrDefault(x => x.Key == _importFileType).Label ?? _importFileType;

    private string usr = string.Empty;
    private Guid _loadedContextKey = Guid.Empty;
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private Guid CurrentContId => QuanLyCont?.Id ?? Guid.Empty;
    private Guid CurrentTauId => QuanLyTau?.Id ?? Guid.Empty;
    private bool IsContContext => CurrentContId != Guid.Empty;
    private bool IsTauContext => CurrentTauId != Guid.Empty;
    private bool _canEditContext => IsContContext || IsTauContext;

    protected override async Task OnParametersSetAsync()
    {
        await _loadGate.WaitAsync();
        try
        {
            if (!_initialized)
            {
                var auth = await asv.GetAuth();
                usr = auth.User.Identity?.Name ?? string.Empty;
                await LoadLookupsAsync();
                _initialized = true;
            }

            if (!_canEditContext)
            {
                Listdata = new();
                return;
            }

            var contextKey = IsContContext ? CurrentContId : CurrentTauId;
            if (_loadedContextKey != contextKey)
            {
                _loadedContextKey = contextKey;
                await Refresh();
            }
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private async Task LoadLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        currs = await db.Currency.AsNoTracking()
            .Select(x => x.Currency)
            .Where(x => x != null)
            .Distinct()
            .ToListAsync();

        charges = await db.Charge.AsNoTracking()
            .Where(x => x.CHARGE_CODE == null || !EF.Functions.Like(x.CHARGE_CODE, "%COMMISSION%"))
            .OrderByDescending(x => x.UPDATETIME)
            .ToListAsync();

        Customers = await db.Customer.AsNoTracking().OrderBy(x => x.shortname).ToListAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task Refresh()
    {
        _selectedItems.Clear();
        detail = null;

        if (!_canEditContext)
        {
            Listdata = new();
            return;
        }

        try
        {
            _loading = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.Credit.AsNoTracking().Where(x => x.continued == true);
            query = IsContContext
                ? query.Where(x => x.Quanly_contid == CurrentContId)
                : query.Where(x => x.Quanly_tauid == CurrentTauId);
            Listdata = await query.OrderByDescending(x => x.dateupdate).ToListAsync();
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot load Credit: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task NewItem()
    {
        var item = new M_Credit();
        SetContextIds(item);
        if (IsContContext && !string.IsNullOrWhiteSpace(QuanLyCont?.Container))
            item.ContainerNo = QuanLyCont.Container;
        await OpenEditDialogAsync(item, isNew: true);
    }

    private async Task AddItem()
    {
        var item = new M_Credit();
        if (detail != null)
        {
            item.customerid = detail.customerid;
            item.itemid = detail.itemid;
            item.ContainerNo = detail.ContainerNo;
        }
        SetContextIds(item);
        await OpenEditDialogAsync(item, isNew: true);
    }

    private async Task OpenEditDialogAsync(M_Credit model, bool isNew)
    {
        if (!_canEditContext)
            return;

        var parameters = new DialogParameters
        {
            ["Model"] = model,
            ["IsNew"] = isNew,
            ["Customers"] = Customers,
            ["Charges"] = charges,
            ["Currencies"] = currs
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<CreDitTab_QuanLy_EditDialog>(
            isNew ? "Thêm Credit" : "Sửa Credit",
            parameters,
            options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not M_Credit item)
            return;

        await CommittedItem(item);
    }

    private async Task DeleteItem(M_Credit item)
    {
        if (item.approve == true)
        {
            CallSnackBar("This Credit is approved!", MudBlazor.Severity.Info);
            return;
        }

        var resultMess = await DialogService.ShowMessageBox("Warning", "Deleting can not be undone!", yesText: "Delete!", cancelText: "Cancel");
        if (resultMess != true)
            return;

        var rs = await shipsv.DeleteCreditMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private async Task CommittedItem(M_Credit item)
    {
        SetContextIds(item);
        item.mblid = Guid.Empty;
        item.hblid = Guid.Empty;
        item.quotationid = Guid.Empty;
        item.ContainerNo = string.IsNullOrWhiteSpace(item.ContainerNo) ? null : item.ContainerNo.Trim();
        await ApplyCreditDefaultsAsync(item);
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        var rs = item.creditid != Guid.Empty
            ? await shipsv.UpdateCreditMBL(item, detail_credit ?? new M_Credit())
            : await shipsv.CreateCreditMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private async Task ApplyCreditDefaultsAsync(M_Credit item)
    {
        item.type = "CONT";
        item.thue = 0;
        item.thanhtiensauthue = item.thanhtien;
        var usdRate = await Vcbsv.Getexchange_cur("USD");
        item.tigiacredit = usdRate;
        item.tigiahoadondauvao = usdRate;
    }

    private void SetContextIds(M_Credit item)
    {
        item.Quanly_contid = IsContContext ? CurrentContId : null;
        item.Quanly_tauid = IsTauContext ? CurrentTauId : null;
    }

    private void FilterCopiedSelection()
    {
        // RemoveWhere giữ cùng reference HashSet — không gán new set để tránh treo UI.
        if (!_selectedItems.Any(x => x.Copied == true))
            return;

        _selectedItems.RemoveWhere(x => x.Copied == true);
        CallSnackBar("Phí đã đẩy sang HBL không thể chọn lại.", MudBlazor.Severity.Warning);
    }

    private async Task PushSelectedFeesAsync()
    {
        if (!IsContContext || QuanLyCont is null)
            return;

        if (string.IsNullOrWhiteSpace(QuanLyCont.HBL_No))
        {
            CallSnackBar("Container chưa có HB/L No.", MudBlazor.Severity.Warning);
            return;
        }

        var toPush = _selectedItems.Where(x => x.Copied != true).ToList();
        if (toPush.Count == 0)
        {
            CallSnackBar("Chọn ít nhất 1 dòng phí credit chưa đẩy.", MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Đẩy {toPush.Count} phí credit sang HB/L?\nMỗi phí tạo 1 bản ghi mới gắn hblid (giữ nguyên phí Quản lý cont).",
            yesText: "Đẩy",
            cancelText: "Hủy");
        if (confirm != true)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var hblCandidates = await db.HBL.AsNoTracking()
            .Where(x => x.hbl != null && x.hbl != string.Empty)
            .ToListAsync();
        var hbl = hblCandidates.FirstOrDefault(x =>
            string.Equals(x.hbl?.Trim(), QuanLyCont.HBL_No.Trim(), StringComparison.OrdinalIgnoreCase));
        if (hbl is null)
        {
            CallSnackBar("Không tìm thấy HB/L: " + QuanLyCont.HBL_No, MudBlazor.Severity.Warning);
            return;
        }

        var successCount = 0;
        foreach (var source in toPush)
        {
            var hblCopy = CloneCreditForPush(source);
            hblCopy.hblid = hbl.hblID;
            hblCopy.mblid = Guid.Empty;
            hblCopy.Quanly_contid = null;
            hblCopy.Quanly_tauid = null;
            if (string.IsNullOrWhiteSpace(hblCopy.ContainerNo))
                hblCopy.ContainerNo = TrimOrNull(QuanLyCont.Container);
            hblCopy.userupdate = usr;
            hblCopy.dateupdate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");

            var rsHbl = await shipsv.CreateCreditMBL(hblCopy);
            if (!rsHbl.Flag)
            {
                CallSnackBar(rsHbl.Message, MudBlazor.Severity.Error);
                continue;
            }

            source.Copied = true;
            source.userupdate = usr;
            var rsMark = await shipsv.UpdateCreditMBL_Copy_Credit(source);
            if (!rsMark.Flag)
                CallSnackBar(rsMark.Message, MudBlazor.Severity.Error);
            successCount++;
        }

        _selectedItems.Clear();
        await Refresh();
        CallSnackBar(successCount > 0
            ? $"Đã đẩy {successCount} phí credit sang HB/L."
            : "Không đẩy được phí credit.",
            successCount > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
    }

    private static M_Credit CloneCreditForPush(M_Credit source)
    {
        var clone = JsonSerializer.Deserialize<M_Credit>(JsonSerializer.Serialize(source))!;
        clone.creditid = Guid.Empty;
        clone.approve = false;
        clone.DNTT = false;
        clone.DNTU = false;
        clone.Copied = false;
        return clone;
    }

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    private string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}";
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Customers.Select(x => x.Customer_ID);
        return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
    }

    private async Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return charges.Select(x => x.CHARGE_ID);
        return charges.Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.CHARGE_ID);
    }

    private async Task UpdatebyCheckboxClick(M_Credit item)
    {
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateCreditMBL_approve(item);
        if (!rs.Flag)
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
    }

    private string SelectedRowClassFunc(M_Credit row, int _)
    {
        if (row.Copied == true)
            return "fee-row-pushed";
        if (row.approve == true)
            return "custom-disable";
        if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(row))
            return "selected";
        return string.Empty;
    }

    private void RowClicked(DataGridRowClickEventArgs<M_Credit> args)
    {
        if (args.Item.approve == true)
            CallSnackBar("This Credit is approved!", MudBlazor.Severity.Info);
        else
            detail = args.Item;
    }

    private async Task TryStartEditing(M_Credit item)
    {
        if (item.approve == true)
        {
            CallSnackBar("This Credit is approved!", MudBlazor.Severity.Warning);
            return;
        }

        detail_credit = JsonSerializer.Deserialize<M_Credit>(JsonSerializer.Serialize(item));
        await OpenEditDialogAsync(item, isNew: false);
    }

    private async Task OnImportInputChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        if (!EorImportDefinitions.Maps.TryGetValue(_importFileType, out var map))
        {
            CallSnackBar("Loại file chưa được hỗ trợ.", MudBlazor.Severity.Warning);
            return;
        }

        await ImportGenericEorAsync(file, map);
    }

    private async Task ImportGenericEorAsync(IBrowserFile file, EorColumnMap map)
    {
        if (!_canEditContext)
            return;

        if (IsContContext && string.IsNullOrWhiteSpace(QuanLyCont?.HBL_No))
        {
            CallSnackBar("Container chưa có HB/L No — không thể import. Vui lòng nhập HBL trước.", MudBlazor.Severity.Warning);
            return;
        }

        var isXlsx = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);
        var isXls = !isXlsx && file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase);
        if (!isXlsx && !isXls)
        {
            CallSnackBar("Chỉ nhận file Excel .xlsx hoặc .xls.", MudBlazor.Severity.Warning);
            return;
        }

        if (isXls && !map.RequiresXls)
        {
            CallSnackBar("Loại file này chỉ hỗ trợ .xlsx. Vui lòng lưu lại file dưới dạng .xlsx trước khi import.", MudBlazor.Severity.Warning);
            return;
        }

        // Phải đọc file vào memory TRƯỚC khi mở dialog / StateHasChanged,
        // nếu không InputFile bị dispose → lỗi _blazorFilesById.
        using var memoryStream = new MemoryStream();
        try
        {
            await using (var uploadStream = file.OpenReadStream(50 * 1024 * 1024))
            {
                await uploadStream.CopyToAsync(memoryStream);
            }
            memoryStream.Position = 0;
        }
        catch (Exception ex)
        {
            CallSnackBar("Không đọc được file Excel: " + ex.Message, MudBlazor.Severity.Error);
            return;
        }

        try
        {
            _importing = true;

            EorParseResult parseResult;
            try
            {
                parseResult = EorExcelParser.Parse(memoryStream, map);
            }
            catch (InvalidOperationException ex)
            {
                CallSnackBar(ex.Message, MudBlazor.Severity.Warning);
                return;
            }

            if (parseResult.Rows.Count == 0)
            {
                CallSnackBar("Không có dòng dữ liệu hợp lệ nào để import.", MudBlazor.Severity.Warning);
                return;
            }

            var previewDialog = await DialogService.ShowAsync<EorImportPreviewDialog>(
                "Xem trước dữ liệu import",
                new DialogParameters
                {
                    ["Rows"] = parseResult.Rows,
                    ["SkippedRowCount"] = parseResult.SkippedRowCount,
                    ["FileTypeLabel"] = CurrentImportTypeLabel
                },
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
            var previewResult = await previewDialog.Result;
            if (previewResult is null || previewResult.Canceled)
            {
                CallSnackBar("Đã hủy import.", MudBlazor.Severity.Info);
                return;
            }

            var customerDialog = await DialogService.ShowAsync<CreDitTab_QuanLy_ImportCustomerDialog>(
                "Chọn Customer",
                new DialogParameters { ["Customers"] = Customers },
                new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            var customerResult = await customerDialog.Result;
            if (customerResult is null || customerResult.Canceled || customerResult.Data is not Guid customerId || customerId == Guid.Empty)
            {
                CallSnackBar("Đã hủy import — chưa chọn Customer.", MudBlazor.Severity.Info);
                return;
            }

            var laborCharge = charges.FirstOrDefault(x =>
                string.Equals(x.CHARGE?.Trim(), "LABOR COST", StringComparison.OrdinalIgnoreCase));
            var materialCharge = charges.FirstOrDefault(x =>
                string.Equals(x.CHARGE?.Trim(), "MATERIAL COST", StringComparison.OrdinalIgnoreCase));
            if (laborCharge is null || materialCharge is null)
            {
                CallSnackBar("Không tìm thấy Charge \"LABOR COST\" hoặc \"MATERIAL COST\".", MudBlazor.Severity.Error);
                return;
            }

            var hblId = await ResolveHblIdFromQuanLyContAsync();
            if (IsContContext && !string.IsNullOrWhiteSpace(QuanLyCont?.HBL_No) && hblId == Guid.Empty)
            {
                CallSnackBar($"Không tìm thấy HBL trùng HBL_No: {QuanLyCont!.HBL_No}. Import vẫn tiếp tục với hblid trống.", MudBlazor.Severity.Warning);
            }

            var successCount = 0;
            foreach (var row in parseResult.Rows)
            {
                var baseCredit = new M_Credit
                {
                    customerid = customerId,
                    hblid = hblId,
                    tiente = row.Currency,
                    Date_Of_EST = row.DateOfEst,
                    Date_In_Yard = row.DateInYard,
                    Manufacturing_Date = row.ManufacturingDate,
                    ContainerNo = row.ContainerNo ?? (IsContContext ? TrimOrNull(QuanLyCont?.Container) : null),
                    Size = row.Size,
                    IT = row.IT,
                    Com_Code = row.ComCode,
                    COMPONENTS_DETAILS = row.ComponentDetails,
                    LOC = row.Loc,
                    DM_Code = row.DamCode,
                    RP_Code = row.RepCode,
                    LHT = row.Lht,
                    WDT = row.Wdt,
                    R = row.R,
                    soluong = 1,
                    Hours = row.Hours,
                    Labor_Cost = row.LaborCost,
                    Material_Cost = row.MaterialCost,
                    Labor_Rate = row.LaborRate,
                    Billing = row.Billing,
                    Owner = row.Owner,
                    Location = row.Location,
                    EstNo = row.EstNo,
                    Grade = row.Grade,
                    DamageDetail = row.DamageDetail,
                    Remark = row.Remark
                };

                if (row.LaborCost.HasValue && row.LaborCost != 0)
                {
                    var laborFee = CloneCreditBase(baseCredit);
                    laborFee.itemid = laborCharge.CHARGE_ID;
                    laborFee.dongia = row.LaborCost;
                    laborFee.soluong = 1;
                    laborFee.thanhtien = row.LaborCost;
                    if (await SaveImportedCreditAsync(laborFee))
                        successCount++;
                }

                if (row.MaterialCost.HasValue && row.MaterialCost != 0)
                {
                    var materialFee = CloneCreditBase(baseCredit);
                    materialFee.itemid = materialCharge.CHARGE_ID;
                    materialFee.dongia = row.MaterialCost;
                    materialFee.soluong = 1;
                    materialFee.thanhtien = row.MaterialCost;
                    if (await SaveImportedCreditAsync(materialFee))
                        successCount++;
                }
            }

            await Refresh();
            CallSnackBar(
                successCount > 0
                    ? $"Import {CurrentImportTypeLabel} thành công {successCount} phí credit.{(parseResult.SkippedRowCount > 0 ? $" Bỏ qua {parseResult.SkippedRowCount} dòng." : string.Empty)}"
                    : "Không import được phí credit nào.",
                successCount > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            CallSnackBar("Import Excel lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<bool> SaveImportedCreditAsync(M_Credit item)
    {
        SetContextIds(item);
        item.mblid = Guid.Empty;
        // hblid giữ nguyên (đã resolve từ QuanLy_Cont.HBL_No → M_HBL.hbl)
        item.quotationid = Guid.Empty;
        await ApplyCreditDefaultsAsync(item);
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        var rs = await shipsv.CreateCreditMBL(item);
        if (!rs.Flag)
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
        return rs.Flag;
    }

    private async Task<Guid> ResolveHblIdFromQuanLyContAsync()
    {
        if (!IsContContext || QuanLyCont is null || string.IsNullOrWhiteSpace(QuanLyCont.HBL_No))
            return Guid.Empty;

        var hblNo = QuanLyCont.HBL_No.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        var candidates = await db.HBL.AsNoTracking()
            .Where(x => x.hbl != null && x.hbl != string.Empty)
            .ToListAsync();
        var hbl = candidates.FirstOrDefault(x =>
            string.Equals(x.hbl?.Trim(), hblNo, StringComparison.OrdinalIgnoreCase));
        return hbl?.hblID ?? Guid.Empty;
    }

    private static M_Credit CloneCreditBase(M_Credit source) =>
        JsonSerializer.Deserialize<M_Credit>(JsonSerializer.Serialize(source))!;
}
