@using System.Globalization
@using System.Text.Json
@using MudBlazor
@using ABFreight.Models
@inject SupportServices supsv
@inject AccountService asv
@inject tigiaVCBservices Vcbsv
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog Style="max-height: 92vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? Localizer["New"] : Localizer["edit"]) — Debit</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.debitno"
                                  Label="@Localizer["Debit No."]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  ReadOnly
                                  Immediate />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="@Localizer["Selected Date Get Debit No"]"
                                   Date="_debitNoDate"
                                   DateChanged="OnDebitNoDateChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   DateFormat="MM/yyyy"
                                   Disabled="@(!string.IsNullOrEmpty(_item.debitno))" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_item.ContainerNo"
                                  Label="@Localizer["Cont. No."]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="6">
                    <MudAutocomplete T="Guid"
                                     @bind-Value="_item.customerid"
                                     Label="@Localizer["Customer"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     SearchFunc="SearchCustomer"
                                     ToStringFunc="CusidtoCusCode"
                                     Clearable />
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudAutocomplete T="Guid"
                                     @bind-Value="_item.itemid"
                                     Label="@Localizer["Item"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     SearchFunc="SearchCharge"
                                     ToStringFunc="Charidtocharge"
                                     Clearable />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.dongia"
                                     Label="@Localizer["Unit Price"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     TextChanged="@(_ => CalculateTotal())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.soluong"
                                     Label="@Localizer["Quantity"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     TextChanged="@(_ => CalculateTotal())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="string"
                                     @bind-Value="_item.type"
                                     Label="@Localizer["Type"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     CoerceValue
                                     SearchFunc="SearchType" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudAutocomplete T="string"
                                     @bind-Value="_item.tiente"
                                     Label="@Localizer["Currency"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required
                                     CoerceValue
                                     SearchFunc="SearchCurr" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.thanhtien"
                                     Label="@Localizer["Total Price"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     Class="text-right" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.thue"
                                     Label="@Localizer["VAT"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     TextChanged="@(_ => CalculateThanhtiensauthue())" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField @bind-Value="_item.thanhtiensauthue"
                                     Label="@Localizer["Total Price Inc. VAT"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Format="#,##0.##"
                                     Culture="@_en"
                                     HideSpinButtons="true"
                                     Class="text-right" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                    <MudCheckBox @bind-Checked="_item.thuho" Label="@Localizer["On Behaft"]" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12" sm="6" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   Style="min-width: 90px; height: 40px;"
                                   OnClick="GetTigia">
                            @Localizer["gettigia"]
                        </MudButton>
                        <MudNumericField @bind-Value="_item.tigiadebit"
                                         Label="@Localizer["Exchange Rate Debit"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Format="#,##0.##"
                                         Culture="@_en"
                                         Required
                                         HideSpinButtons="true"
                                         Class="text-right flex-grow-1" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   Style="min-width: 90px; height: 40px;"
                                   OnClick="GetTigiaInvoice">
                            @Localizer["gettigia"]
                        </MudButton>
                        <MudNumericField @bind-Value="_item.tigiahoandondaura"
                                         Label="@Localizer["Exchange Rate Invoice"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Format="#,##0.##"
                                         Culture="@_en"
                                         Required
                                         HideSpinButtons="true"
                                         Class="text-right flex-grow-1" />
                    </MudStack>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                    <MudCheckBox @bind-Checked="_item.khoa" Label="@Localizer["Locked"]" Color="Color.Warning" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_item.ghichu"
                                  Label="@Localizer["Notes"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_Debit? Model { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public string ShipmentTypeCode { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public List<M_Customer> Customers { get; set; } = new();
    [Parameter] public List<ChargeModel> Charges { get; set; } = new();
    [Parameter] public List<string> Types { get; set; } = new();
    [Parameter] public List<string> Currencies { get; set; } = new();

    private readonly CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private MudForm _form = default!;
    private M_Debit _item = new();
    private DateTime? _debitNoDate;

    protected override void OnInitialized()
    {
        _item = Model == null
            ? new M_Debit()
            : JsonSerializer.Deserialize<M_Debit>(JsonSerializer.Serialize(Model))!;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_item.customerid == Guid.Empty || _item.itemid == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn Customer và Item.", MudBlazor.Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(_item));
    }

    private async Task OnDebitNoDateChanged(DateTime? value)
    {
        _debitNoDate = value;
        if (!value.HasValue)
            return;

        var refno = await supsv.GetRefNoByFunc("Debit", value.Value.Month, value.Value.Year, UserName);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        var rs = asv.GetUserDetail();
        var cn = rs?.Branch ?? string.Empty;
        _item.debitno = cn + tiepdaungu + ShipmentTypeCode + value.Value.ToString("yyMM")
            + (refno.HasValue ? refno.Value.ToString("D4") : "RefNoError!");
    }

    private void CalculateTotal()
    {
        if (_item.soluong.HasValue && _item.dongia.HasValue)
        {
            _item.thanhtien = Math.Round((_item.soluong ?? 0) * (_item.dongia ?? 0), 2);
            CalculateThanhtiensauthue();
        }
    }

    private void CalculateThanhtiensauthue()
    {
        if (_item.thanhtien.HasValue && _item.thue.HasValue)
            _item.thanhtiensauthue = Math.Round((_item.thanhtien ?? 0) * ((_item.thue ?? 0) / 100 + 1), 2);
    }

    private async Task GetTigia()
    {
        var cur = _item.tiente;
        if (cur == "VND")
        {
            Snackbar.Add("Tiền tệ VND: lấy tỉ giá theo USD.", MudBlazor.Severity.Info);
            cur = "USD";
        }
        _item.tigiadebit = await Vcbsv.Getexchange_cur(cur);
    }

    private async Task GetTigiaInvoice()
    {
        var cur = _item.tiente;
        if (cur == "VND")
        {
            Snackbar.Add("Tiền tệ VND: lấy tỉ giá theo USD.", MudBlazor.Severity.Info);
            cur = "USD";
        }
        _item.tigiahoandondaura = await Vcbsv.Getexchange_cur(cur);
    }

    private string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    private string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var rs = Charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}";
    }

    private Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Customers.Select(x => x.Customer_ID));
        return Task.FromResult(Customers
            .Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Customer_ID));
    }

    private Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Charges.Select(x => x.CHARGE_ID));
        return Task.FromResult(Charges
            .Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.CHARGE_ID));
    }

    private Task<IEnumerable<string?>> SearchType(string? text)
    {
        var items = Types.Distinct().AsEnumerable();
        if (string.IsNullOrEmpty(text))
            return Task.FromResult(items.Cast<string?>());
        return Task.FromResult(items.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase)).Cast<string?>());
    }

    private Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Currencies.AsEnumerable());
        return Task.FromResult(Currencies.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }
}
