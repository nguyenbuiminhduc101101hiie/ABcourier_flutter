
<MudDialog>
    <DialogContent>
        <MudContainer>
            <MudGrid>
                <MudItem xs="7">@*<-Empty->*@</MudItem>
                <MudItem xs="5">
                    <MudTextField @bind-Value="MBLdetail.Air_PAM" Label="House Air Waybill No." />
                </MudItem>
                @*<---------Trái nữa trên--------->*@
                <MudItem xs="6">
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudAutocomplete @bind-Value="MBLdetail.Shipper"
                                         SearchFunc="Search"
                                         Label="Shipper's Name and Address"
                                         Lines="3"
                                         Clearable="true" />
                        <MudTextField @bind-Value="MBLdetail.Air_ShipperAccountNumber" Label="Shipper's Account Numer" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudAutocomplete @bind-Value="MBLdetail.Consignee"
                                         SearchFunc="Search"
                                         Label="Consignee's Name and Address"
                                         Lines="3"
                                         Clearable="true" />
                        <MudTextField @bind-Value="MBLdetail.Air_ConsigneeAccountNumber" Label="Consignee's Account Numer" />
                    </MudStack>
                    <MudTextField @bind-Value="MBLdetail.Air_IssuingCarrier" Label="Issuing Carrier's Agent Name and City" Lines="3" AutoGrow />
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_AgentIATACode" Label="Agent's IATA Code" />
                        <MudTextField @bind-Value="MBLdetail.Air_AccountNo" Label="Account No." />
                    </MudStack>
                    <MudTextField @bind-Value="MBLdetail.Air_AirportofDeparture" Label="Airport of Departure (Addr. of first Carrier) and requested Routing" />
                </MudItem>

                @*<---------Phải nữa trên--------->*@
                <MudItem xs="6">
                    <MudImage Src="/imageforreport/airwaybill.png"/>
                    <MudTextField @bind-Value="MBLdetail.Air_AccountingInfomation" Label="Accounting Infomation" Lines="4" AutoGrow />
                </MudItem>

                @*<-------------Giữa------------>*@
                <MudItem xs="12">
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_to" Label="To" />
                        <MudTextField @bind-Value="MBLdetail.Air_ByfirstCarrier" Label="By First Carrier" />
                        <MudTextField @bind-Value="MBLdetail.Air_to2" Label="To" />
                        <MudTextField @bind-Value="MBLdetail.Air_by2" Label="By" />
                        <MudTextField @bind-Value="MBLdetail.Air_to3" Label="To" />
                        <MudTextField @bind-Value="MBLdetail.Air_by3" Label="By" />
                        <MudSelect @bind-Value="MBLdetail.Air_Currency" Label="Currency" >
                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="MBLdetail.Air_CHGSCode" Label="CHGS Code" />
                        <MudTextField @bind-Value="MBLdetail.Air_PPD" Label="WT/VAL PPD" />
                        <MudTextField @bind-Value="MBLdetail.Air_COLL" Label="WT/VAL COLL" />
                        <MudTextField @bind-Value="MBLdetail.Air_otherPPD" Label="Other PPD" />
                        <MudTextField @bind-Value="MBLdetail.Air_otherCOLL" Label="Other COLL" />
                        <MudTextField @bind-Value="MBLdetail.Air_DeclaredValuedForCarriage" Label="DV for Carriage" />
                        <MudTextField @bind-Value="MBLdetail.Air_DeclaredValueForCustoms" Label="DV for Customs" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_AirportOfDestination" Label="AirPort of Destination" />
                        <MudTextField @bind-Value="MBLdetail.Air_FlightDate1" Label="Flight/Date (1)" />
                        <MudTextField @bind-Value="MBLdetail.Air_FlightDate2" Label="Flight/Date (2)" />
                        <MudTextField @bind-Value="MBLdetail.Air_AmountOfInsurance" Label="Amount of Insurance" />
                        <MudTextField T="string" Lines="2" ReadOnly Text="INSURANCE. If shipperer requests insurance is in accordance with conditions on reverse hereof, indicale the amount to be insured in figures in box marked amount of insurance." />
                    </MudStack>
                    <MudTextField @bind-Value="MBLdetail.Air_HandlingInfomation" Label="Handling Information" Lines="3" AutoGrow/>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_NoOfPiecesRCP" Label="No. of Pieces RCP" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_GrossWieght" Label="Gross Weight" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_kglb" Label="kg lb" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_RateClass" Label="Rate Class" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_CommodityItemNo" Label="Commodity Item No." Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_ChargeableWeight" Label="Chargeable Weight" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_RateCharge" Label="Rate/Charge" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_Total" Label="Total" Lines="5" AutoGrow />
                        <MudTextField @bind-Value="MBLdetail.Air_NatureAndquantityOfgoods" Label="Nature & Qty of Goods" Lines="5" AutoGrow />
                    </MudStack>
                </MudItem>
                @*<-------------Trái nữa dưới------------>*@
                <MudItem xs="6">
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_WeightCharge_Prepaid" Label="Weight Charge - Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_WeightCharge_Collect" Label="Weight Charge - Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_Valuation_Prepaid" Label="Valuation Charge - Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_Valuation_Collect" Label="Valuation Charge - Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_Tax_Prepaid" Label="Tax - Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_Tax_Collect" Label="Tax - Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_TotalOtherChargesDueAgent_Prepaid" Label="Total Other Charges Due Agent - Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_TotalOtherChargesDueAgent_Collect" Label="Total Other Charges Due Agent - Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_TotalOtherChargesDueCarrier_Prepaid" Label="Total Other Charges Due Carrier - Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_TotalOtherChargesDueCarrier_Collect" Label="Total Other Charges Due Carrier - Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_TotalPrepaid" Label="Total Prepaid" />
                        <MudTextField @bind-Value="MBLdetail.Air_TotalCollect" Label="Total Collect" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_CurrencyConversionRates" Label="Currency Conversion Rates" />
                        <MudTextField @bind-Value="MBLdetail.Air_CCChargesInDestCurrenct" Label="CC Charges in Dest. Currency" />
                    </MudStack>
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField T="string" Text="For Carrier's Use only at Destination" ReadOnly />
                        <MudTextField @bind-Value="MBLdetail.Air_ChargesatDestination" Label="Charges in Destination" />
                    </MudStack>
                </MudItem>

                @*<-------------Phải nữa dưới------------>*@
                <MudItem xs="6">
                    <MudTextField @bind-Value="MBLdetail.Air_OtherCharges" Label="Other Charges" Lines="3" />
                    <MudImage Src="/imageforreport/airwaybill3.png" />
                    <MudTextField @bind-Value="MBLdetail.Air_HisAgent" Label="His Agent" Lines="3" />
                    <MudImage Src="/imageforreport/airwaybill4.png" />
                    <MudTextField @bind-Value="MBLdetail.Air_FlightDate2" Label="Flight Date" Lines="3" />
                    <MudImage Src="/imageforreport/airwaybill5.png" />
                    <MudStack Row Justify="Justify.SpaceAround">
                        <MudTextField @bind-Value="MBLdetail.Air_TotalCollectCharges" Label="Total Collect Charges" />
                        <MudTextField @bind-Value="MBLdetail.Air_PAM" />
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => mudDialog.Cancel())">Close</MudButton>
        <MudButton Color="Color.Success" OnClick="@(() => mudDialog.Close(MBLdetail!))">Submit</MudButton>
    </DialogActions>
</MudDialog>

@inject CustomerService csv
@code {
    [CascadingParameter] MudDialogInstance mudDialog { get; set; }
    [Parameter] public M_MBL MBLdetail { get; set; } = default!;

    List<M_Customer> customers = new List<M_Customer>();
    List<string> cuscmb = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        customers = await csv.GetListAll();
        cuscmb = customers.Where(x => !string.IsNullOrWhiteSpace(x.EnglishName) || !string.IsNullOrWhiteSpace(x.addresstiengviet)).Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).ToList();
    }

    private async Task<IEnumerable<string>> Search(string value)
    {
        await Task.Delay(5);
        if (string.IsNullOrEmpty(value))
            return cuscmb;

        return cuscmb.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

}
