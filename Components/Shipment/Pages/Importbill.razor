@inject IStringLocalizer<SharedResource> Localizer

<style>
    .bill-dialog-container {
        padding: 8px 14px 0 14px;
        min-width: 1080px;
        max-width: 1280px;
    }

    .bill-header {
        padding: 4px 2px 10px 2px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 10px;
    }

    .bill-section {
        padding: 12px 14px;
        margin-bottom: 10px;
        border: 1px solid #e0e3eb;
        border-radius: 12px;
        background: #ffffff;
    }

    .bill-section-title {
        font-weight: 700;
        color: #118AB2;
        font-size: 14px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .bill-section-subtitle {
        color: #6b7280;
        font-size: 12px;
        margin-left: 6px;
        font-weight: 400;
    }

    .bill-compact .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .bill-compact .mud-input > input,
    .bill-compact .mud-input textarea {
        font-size: 13px !important;
    }

    .bill-compact .mud-input-label {
        font-size: 12px !important;
        color: #4b5563 !important;
    }

    .party-card {
        height: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fcfcfd;
        padding: 10px;
    }

    .bill-logo-card {
        height: 100%;
        min-height: 180px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #f9fafb;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px;
    }

        .bill-logo-card img,
        .bill-logo-card .mud-image {
            max-width: 100%;
            object-fit: contain;
        }

    .bill-mini-label {
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .text-right input,
    .text-right textarea {
        text-align: right !important;
    }

    .bill-dialog-actions {
        padding: 10px 18px 14px 18px !important;
        border-top: 1px solid #e5e7eb;
        width: 100%;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
    }

    .bill-actions-right {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    @@media(max - width: 1200px) {
        .bill-dialog-container {
            min-width: auto;
        }
    }
</style>

    <MudDialog>
        <DialogContent>
            <MudForm @ref="form">
                <MudContainer Class="bill-dialog-container bill-compact">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="bill-header">
                        <div>
                            <MudText Typo="Typo.h6">Master Bill Detail</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Update parties, routing, cargo and freight information
                            </MudText>
                        </div>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">MBL</MudText>
                            <MudText Typo="Typo.subtitle2">@MBL.Mbl</MudText>
                        </MudStack>
                    </MudStack>

                    <!-- 1. Document information -->
                    <MudPaper Class="bill-section" Elevation="0">
                        <MudText Class="bill-section-title">
                            1. Document Information
                            <span class="bill-section-subtitle">B/L number, MBL number and logo preview</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="7">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="6">
                                        <MudTextField Class="labelCustomColor"
                                                      @bind-Value="MBL.Bkno"
                                                      For="@(() => MBL.Bkno)"
                                                      Label="B/L No."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField Class="labelCustomColor"
                                                      @bind-Value="MBL.Mbl"
                                                      For="@(() => MBL.Mbl)"
                                                      Label="MBL"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>

                            <MudItem xs="12" md="5">
                          @*       <div class="bill-logo-card">
                                    <MudImage Src="ImageForReport/logobillsea.png" Alt="logo" Elevation="0" Class="card-img" />
                                </div> *@
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 2. Parties -->
                    <MudPaper Class="bill-section" Elevation="0">
                        <MudText Class="bill-section-title">
                            2. Parties
                            <span class="bill-section-subtitle">Search and edit shipper, consignee and notify party</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <div class="party-card">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="MBL.Shipper"
                                                     Label="Search Shipper"
                                                     SearchFunc="mst_S"
                                                     ToStringFunc="(x) => x"
                                                     ResetValueOnEmptyText="false"
                                                     Clearable="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MaxItems="50" />

                                    <MudTextField Class="labelCustomColor"
                                                  @bind-Value="MBL.Shipper"
                                                  For="@(() => MBL.Shipper)"
                                                  Label="Shipper"
                                                  Lines="5"
                                                  AutoGrow="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                </div>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <div class="party-card">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="MBL.Consignee"
                                                     Label="Search Consignee"
                                                     SearchFunc="mst_C"
                                                     ToStringFunc="(x) => x"
                                                     ResetValueOnEmptyText="false"
                                                     Clearable="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MaxItems="50" />

                                    <MudTextField Class="labelCustomColor"
                                                  @bind-Value="MBL.Consignee"
                                                  For="@(() => MBL.Consignee)"
                                                  Label="Consignee"
                                                  Lines="5"
                                                  AutoGrow="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                </div>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <div class="party-card">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="MBL.Notify1"
                                                     Label="Search Notify Party"
                                                     SearchFunc="mst_N"
                                                     ToStringFunc="(x) => x"
                                                     ResetValueOnEmptyText="false"
                                                     Clearable="true"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MaxItems="50" />

                                    <MudTextField Class="labelCustomColor"
                                                  @bind-Value="MBL.Notify1"
                                                  For="@(() => MBL.Notify1)"
                                                  Label="Notify Party"
                                                  Lines="5"
                                                  AutoGrow="true"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 3. Voyage and routing -->
                    <MudPaper Class="bill-section" Elevation="0">
                        <MudText Class="bill-section-title">
                            3. Voyage & Routing
                            <span class="bill-section-subtitle">Vessel, voyage and port movement details</span>
                        </MudText>

                        <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudAutocomplete T="string"
                                             Value="@MBL.Vessel"
                                             ValueChanged="@(v => MBL.Vessel = v)"
                                             Text="@MBL.Vessel"
                                             TextChanged="@(t => MBL.Vessel = t)"
                                             Label="Vessel"
                                             SearchFunc="mst_Vessels"
                                             ToStringFunc="(x) => x"
                                             Immediate="true"
                                             Strict="false"
                                             CoerceText="true"
                                             CoerceValue="true"
                                             ResetValueOnEmptyText="false"
                                             Clearable="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete T="string"
                                             Value="@MBL.Voy"
                                             ValueChanged="@(v => MBL.Voy = v)"
                                             Text="@MBL.Voy"
                                             TextChanged="@(t => MBL.Voy = t)"
                                             Label="Voy"
                                             SearchFunc="mst_Voys"
                                             ToStringFunc="(x) => x"
                                             Immediate="true"
                                             Strict="false"
                                             CoerceText="true"
                                             CoerceValue="true"
                                             ResetValueOnEmptyText="false"
                                             Clearable="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="@MBL.Porname"
                                                 ValueChanged="@OnPornameChanged"
                                                 Label="Place Of Receipt"
                                                 SearchFunc="mst_Ports"
                                                 ToStringFunc="(x) => x"
                                                 MaxItems="100"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="@MBL.Polname"
                                                 ValueChanged="@OnPolnameChanged"
                                                 Label="Port of Loading"
                                                 SearchFunc="mst_Ports"
                                                 ToStringFunc="(x) => x"
                                                 MaxItems="100"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="@MBL.Podname"
                                                 ValueChanged="@OnPodnameChanged"
                                                 Label="Port of Discharge"
                                                 SearchFunc="mst_Ports"
                                                 ToStringFunc="(x) => x"
                                                 MaxItems="100"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="@MBL.Delname"
                                                 ValueChanged="@OnDelnameChanged"
                                                 Label="Place of Delivery"
                                                 SearchFunc="mst_Ports"
                                                 ToStringFunc="(x) => x"
                                                 MaxItems="100"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.ShipOnboard"
                                              For="@(() => MBL.ShipOnboard)"
                                              Label="Shipped On Board"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.DateLaden"
                                              For="@(() => MBL.DateLaden)"
                                              Label="Date Laden"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 4. Cargo details -->
                    <MudPaper Class="bill-section" Elevation="0">
                        <MudText Class="bill-section-title">
                            4. Cargo Details
                            <span class="bill-section-subtitle">Container marks, package quantity, goods and measurements</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="3">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.markAndNumbers"
                                              For="@(() => MBL.markAndNumbers)"
                                              Label="Marks and Numbers"
                                              Lines="6"
                                              AutoGrow="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="2">
                                <MudTextField Class="labelCustomColor text-right"
                                              @bind-Value="MBL.NoOfPackages"
                                              For="@(() => MBL.NoOfPackages)"
                                              Label="No. of Packages"
                                              Lines="6"
                                              AutoGrow="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.Description"
                                              For="@(() => MBL.Description)"
                                              Label="Description of Goods"
                                              Lines="6"
                                              AutoGrow="true"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudGrid Spacing="2">
                                    <MudItem xs="6">
                                        <MudTextField Class="labelCustomColor text-right"
                                                      @bind-Value="MBL.Gross"
                                                      For="@(() => MBL.Gross)"
                                                      Label="Gross"
                                                      Lines="3"
                                                      AutoGrow="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudTextField Class="labelCustomColor text-right"
                                                      @bind-Value="MBL.CBM"
                                                      For="@(() => MBL.CBM)"
                                                      Label="Measurement"
                                                      Lines="3"
                                                      AutoGrow="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField Class="labelCustomColor"
                                                      @bind-Value="MBL.Say"
                                                      For="@(() => MBL.Say)"
                                                      Label="SAY"
                                                      Lines="2"
                                                      AutoGrow="true"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Immediate="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 5. Freight and issue -->
                    <MudPaper Class="bill-section" Elevation="0">
                        <MudText Class="bill-section-title">
                            5. Freight & Issue
                            <span class="bill-section-subtitle">Payment place, original copies and issue information</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.FreightPayableAt"
                                              For="@(() => MBL.FreightPayableAt)"
                                              Label="Freight Payable At"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.NumberOfOriginal"
                                              For="@(() => MBL.NumberOfOriginal)"
                                              Label="Number Of Original"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.PlaceAndDate"
                                              For="@(() => MBL.PlaceAndDate)"
                                              Label="Place And Date"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.FreightAmount"
                                              For="@(() => MBL.FreightAmount)"
                                              Label="Freight Amount"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="labelCustomColor"
                                              @bind-Value="MBL.ForDelivery"
                                              For="@(() => MBL.ForDelivery)"
                                              Label="For Delivery"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudContainer>
            </MudForm>
        </DialogContent>

        <DialogActions>
            <div class="bill-dialog-actions">
                <div class="bill-actions-right">
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Tertiary" OnClick="FillCont">
                        Fill Cont
                    </MudButton>
                    <MudButton Color="Color.Secondary" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="Submit">Save</MudButton>
                </div>
            </div>
        </DialogActions>
    </MudDialog>
    @inject CustomerService csv
    @inject ShipmentService ssv
    @inject SupportServices supsv
@code {
    MudForm form;
    Color ColorTextFields = Color.Primary;
    private void Submit()
    {
        SyncAllPortCodesFromNames();
        MudDialog!.Close(MBL);
    }

    private string? LookupPortCode(string? portName)
    {
        if (string.IsNullOrWhiteSpace(portName))
            return null;
        return csv.GetPortByExactPortName(portName.Trim())?.PORT_CODE;
    }

    private void SyncAllPortCodesFromNames()
    {
        MBL.Porcode = LookupPortCode(MBL.Porname);
        MBL.Polcode = LookupPortCode(MBL.Polname);
        MBL.Podcode = LookupPortCode(MBL.Podname);
        MBL.Delcode = LookupPortCode(MBL.Delname);
    }

    private Task OnPornameChanged(string? v)
    {
        MBL.Porname = v;
        MBL.Porcode = LookupPortCode(v);
        return Task.CompletedTask;
    }

    private Task OnPolnameChanged(string? v)
    {
        MBL.Polname = v;
        MBL.Polcode = LookupPortCode(v);
        return Task.CompletedTask;
    }

    private Task OnPodnameChanged(string? v)
    {
        MBL.Podname = v;
        MBL.Podcode = LookupPortCode(v);
        return Task.CompletedTask;
    }

    private Task OnDelnameChanged(string? v)
    {
        MBL.Delname = v;
        MBL.Delcode = LookupPortCode(v);
        return Task.CompletedTask;
    }

    private void AfterPornameEdited() => MBL.Porcode = LookupPortCode(MBL.Porname);
    private void AfterPolnameEdited() => MBL.Polcode = LookupPortCode(MBL.Polname);
    private void AfterPodnameEdited() => MBL.Podcode = LookupPortCode(MBL.Podname);
    private void AfterDelnameEdited() => MBL.Delcode = LookupPortCode(MBL.Delname);
    List<string> saleNames = new List<string>();
    List<string> countries = new List<string>();
    List<string> shippers = new List<string>();
    List<string> consignees = new List<string>();
    List<string> notifys = new List<string>();
    List<string> ports = new List<string>();
    List<string> vessels = new List<string>();
    List<string> voys = new List<string>();
    List<string>? Sales = new List<string>();

    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    private string shipper = "";
    private string consignee = "";
    private string notify = "";
    private string mst_Shipper = "";
    private string mst_Consignee = "";
    private string mst_Notify = "";
    private string mst_Vessel = "";
    private string mst_Voy = "";
    private string mst_POR = "";
    private string mst_POL = "";
    private string mst_POD = "";
    private string mst_DEL = "";
    private List<M_Container> ContDetail = new List<M_Container>();
    void Cancel() => MudDialog!.Cancel();
    protected async override Task OnInitializedAsync()
    {
        // Customers = await csv.GetListAll();
        // Countrys = Customers.Where(x => x.Country != "").Select(x => x.Country).ToList();
        // if (!EditOrNot) // duplicate lấy customer code mới
        // {
        //     customer.Customer_ID = Guid.NewGuid();
        //     var cuscode = await csv.GetCustomerCode();
        //     if (!cuscode.Item1.Flag)
        //         CallSnackBar(cuscode.Item1.Message, MudBlazor.Severity.Error);
        //     else
        //         customer.Customer_Code = cuscode.Item2.CustomerCode_Ref;
        // }
        if (MBLDetail != null)
        {
            MBL = MBLDetail;
        }
        SyncAllPortCodesFromNames();
        ContDetail = ssv.GetListContainerHBL(MBL.MblID);
        shippers = csv.queryListShippers() ?? new List<string>();
        consignees = shippers;
        notifys = shippers;
        ports = csv.queryListPorts() ?? new List<string>();
        vessels = await supsv.GetlistVessel() ?? new List<string>();
        voys = await supsv.GetlistVoy() ?? new List<string>();
    }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    M_Customer customer = new M_Customer();
    M_MBL MBL = new M_MBL();
    private async Task<IEnumerable<string>> mst_S(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return shippers;

            return shippers.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {

            throw;
        }

    }
    private async Task<IEnumerable<string>> mst_C(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return consignees;

            return consignees.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {

            throw;
        }

    }
    private async Task<IEnumerable<string>> mst_N(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return notifys;

            return notifys.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> mst_Ports(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return ports;

            return ports.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> mst_Voys(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return voys;

            return voys.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> mst_Vessels(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
                return vessels;

            return vessels.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    void mst_Port(string type)
    {
        try
        {
            if (type == "POL" && !string.IsNullOrEmpty(mst_POL))
            {
                var newValue = ssv.queryPort(mst_POL);
                if (newValue != null && newValue.PORT != MBL.Polname)
                {
                    MBL.Polname = newValue.PORT;
                    MBL.Polcode = newValue.PORT_CODE;
                }
            }
            else if (type == "POD" && !string.IsNullOrEmpty(mst_POD))
            {
                var newValue = ssv.queryPort(mst_POD);
                if (newValue != null && newValue.PORT != MBL.Podname)
                {
                    MBL.Podname = newValue.PORT;
                    MBL.Podcode = newValue.PORT_CODE;
                }
            }
            else if (type == "DEL" && !string.IsNullOrEmpty(mst_DEL))
            {
                var newValue = ssv.queryPort(mst_DEL);
                if (newValue != null && newValue.PORT != MBL.Delname)
                {
                    MBL.Delname = newValue.PORT;
                    MBL.Delcode = newValue.PORT_CODE;
                }
            }
            else if (type == "POR" && !string.IsNullOrEmpty(mst_POR))
            {
                var newValue = ssv.queryPort(mst_POR);
                if (newValue != null && newValue.PORT != MBL.Porname)
                {
                    MBL.Porname = newValue.PORT;
                    MBL.Porcode = newValue.PORT_CODE;
                }
            }
            else if (type == "Vessel" && !string.IsNullOrEmpty(mst_Vessel))
            {
                var newValue = ssv.queryVessel(mst_Vessel);
                if (newValue != null && newValue != "")
                {
                    MBL.Vessel = newValue;
                }
            }
            else if (type == "Voy" && !string.IsNullOrEmpty(mst_Voy))
            {
                var newValue = ssv.queryVoy(mst_Voy);
                if (newValue != null && newValue != "")
                {
                    MBL.Voy = newValue;
                }
            }
        }
        catch (Exception)
        {

            throw;
        }

    }
    void FillCont()
    {
        MBL.markAndNumbers = ssv.GetNumberandRemark(MBL.MblID);
        MBL.NoOfPackages = ssv.GetNoOfPackages(MBL.MblID);
        MBL.Description = ssv.GetDescriptionOfGoods(MBL.MblID, MBL.CustomerID);
        MBL.Gross = ssv.GetSumOfGross(MBL.MblID);
        MBL.CBM = ssv.GetSumOfCBM(MBL.MblID);
        MBL.Say = ssv.saycont(MBL.MblID);
    }

}
