@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<style>
    .credit-view-dialog .mud-dialog-content {
        padding: 16px 20px 8px 20px !important;
    }

    .credit-view-dialog .dvd-hero {
        background-color: #f0f7fb;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    .credit-view-dialog .dvd-section {
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    .credit-view-dialog .dvd-section-header {
        margin-bottom: 4px;
    }

    .credit-view-dialog .dvd-field-label {
        display: block;
    }
</style>

<MudDialog Class="credit-view-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@MudDialog.Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="dvd-hero" Elevation="0">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Secondary" />
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Customer"]</MudText>
                            <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(CustomerText) ? "-" : CustomerText)</MudText>
                        </div>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex justify-end align-center">
                    <MudChip T="string" Size="Size.Small" Variant="@(FlagVariant(Item.approve))" Color="@FlagColor(Item.approve, Color.Success)" Icon="@FlagIcon(Item.approve)">@Localizer["Approve"]</MudChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Secondary" />
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Item"]</MudText>
                            <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(ItemText) ? "-" : ItemText)</MudText>
                        </div>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="dvd-section" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="dvd-section-header">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@Localizer["Pricing"]</MudText>
            </MudStack>
            <MudDivider Class="mb-3" />
            <MudGrid Spacing="3">
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Unit Price"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.dongia)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Type"]</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.type) ? "-" : Item.type)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Quantity"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.soluong)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Loaitiente"]</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.tiente) ? "-" : Item.tiente)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Total Price"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.thanhtien)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["VAT"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.thue)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Total Price Inc. VAT"]</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight:600;">@FormatNumber(Item.thanhtiensauthue)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Exchange Rate Credit"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.tigiacredit)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Exchange Rate Invoice"]</MudText>
                    <MudText Typo="Typo.body1">@FormatNumber(Item.tigiahoadondauvao)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Class="dvd-section" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="dvd-section-header">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@Localizer["Other Info"]</MudText>
            </MudStack>
            <MudDivider Class="mb-3" />
            <MudGrid Spacing="3">
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Cont. No."]</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.ContainerNo) ? "-" : Item.ContainerNo)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["UserUpdate"]</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.userupdate) ? "-" : Item.userupdate)</MudText>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dvd-field-label">@Localizer["Dateupdate"]</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.dateupdate) ? "-" : Item.dateupdate)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_Credit Item { get; set; } = new();
    [Parameter] public string? CustomerText { get; set; }
    [Parameter] public string? ItemText { get; set; }

    static CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    static string FormatNumber(double? value) => value.HasValue ? value.Value.ToString("#,##0.##", _en) : "-";

    static Variant FlagVariant(bool? value) => (value ?? false) ? Variant.Filled : Variant.Outlined;
    static Color FlagColor(bool? value, Color trueColor) => (value ?? false) ? trueColor : Color.Default;
    static string FlagIcon(bool? value) => (value ?? false) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked;

    void Close() => MudDialog.Close();
}
