
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LenhDieuXeServices lsv
@inject YeuCauTruckingServices ysv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
@using System.Globalization
@inject IJSRuntime JSRuntime

<MudTabs SliderColor="Color.Primary">
    <MudTabPanel Text="@($"Truck [{(hbldetail != null ? hbldetail.hbl : null)}]")" Class="custom-tab">
        <MudDataGrid T="M_HBL" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-hbl-bg"

        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Bordered="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" EditDialogOptions="optionsdialog"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>

                            <!-- Nút Add -->
                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                               OnClick="AddItem" Disabled
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>
                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@($"{Localizer["House Trucking No"]} QR Code")">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.QrCode2" OnClick="@(() => OpenHblQrDialog(context.Item))" Disabled="@string.IsNullOrWhiteSpace(context.Item.hbl)" />
                        </MudTooltip>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => TryStartEditing(context.Item))" Disabled />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.hbl" Title="@Localizer["House Trucking No"]">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.hbl" Immediate Label="@Localizer["House Trucking No"]" Required />
                        <MudDatePicker Label="@Localizer["Select Date Get House Trucking No"]" DateChanged="((t)=>UpdateHBLNo(context.Item,(DateTime)t!))" ImmediateText DateFormat="MM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.release" Title="@Localizer["Release"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.release" Label="@Localizer["Release"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.release.HasValue ? context.Item.release.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.releaseNote" Title="@Localizer["Release Note"]" Required="false" Filterable="false" />
                <PropertyColumn Property="x => TDebit_(x.hblID)" Title="@Localizer["Debit"]" Required="false" Filterable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => TCredit_(x.hblID)" Title="@Localizer["Credit"]" Required="false" Filterable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => TProfit_(x.hblID)" Title="@Localizer["Profit"]" Required="false" Filterable="false" Sortable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;">
                    <HeaderTemplate>
                        <div class="mud-data-grid mud-table-cell column-header table-hbl-bg">
                            @Localizer["Profit"]
                            <MudRadioGroup @bind-Value="chkUSD" Style="margin-left:10px;">
                                <MudRadio Value="@true" Color="Color.Inherit" Size="Size.Small">USD</MudRadio>
                                <MudRadio Value="@false" Color="Color.Inherit" Size="Size.Small">VND</MudRadio>
                            </MudRadioGroup>
                            <MudCheckBox @bind-Checked="chkVAT" Label="VAT" Color="Color.Inherit" Size="Size.Small" />
                        </div>
                    </HeaderTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dathudebit" Title="@Localizer["Debit Received"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathudebit" Label="@Localizer["Debit Received"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dathudebit.HasValue ? context.Item.dathudebit.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dachicredit" Title="@Localizer["Spent Credit"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dachicredit" Label="@Localizer["Spent Credit"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dachicredit.HasValue ? context.Item.dachicredit.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dathuchidaily" Title="@Localizer["Received & Spent Agent"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathuchidaily" Label="@Localizer["Received & Spent Agent"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dathuchidaily.HasValue ? context.Item.dathuchidaily.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.statusHBL" Title="@Localizer["Status"]" Required="false">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.statusHBL" Label="@Localizer["Status"]">
                            @foreach (var item in trangthais)
                            {
                                <MudSelectItem Value="item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.CustomerID)" Title="@Localizer["Main Customer"]" Required CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.CustomerID" Label="@Localizer["Main Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode"/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Truck_LenhDieuXeNo" Title="@Localizer["Trucking dispatch order No"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.Truck_LenhDieuXeNo" Label="@Localizer["Trucking dispatch order No"]" Required
                        SearchFunc="SearchLenhDieuXe" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudLink OnClick="@(() => OpenDetailLenhDieuXe(context.Item.Truck_LenhDieuXeNo))">@context.Item.Truck_LenhDieuXeNo</MudLink>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Truck_YeucauTruckingNo" Title="@Localizer["Trucking Requirement No"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.Truck_YeucauTruckingNo" Label="@Localizer["Trucking Requirement No"]" Required
                        SearchFunc="SearchYCDieuXe" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudLink OnClick="@(() => OpenDetailYeucauTrucking(context.Item.Truck_YeucauTruckingNo))">@context.Item.Truck_YeucauTruckingNo</MudLink>
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Container" Class="custom-tab" Disabled>
        <ContainerTab HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
    <MudTabPanel Text="Debit" Class="custom-tab">
        <DebitTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty="false"/>
    </MudTabPanel>
    <MudTabPanel Text="Credit" Class="custom-tab">
        <CreditTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="false"/>
    </MudTabPanel>
    <MudTabPanel Text="Commission" Class="custom-tab" Disabled>
        <CreditTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="true" />
    </MudTabPanel>
    <MudTabPanel Text="Refund Duty" Class="custom-tab" Disabled>
        <DebitTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty="true" />
    </MudTabPanel>
    <MudTabPanel Text="Theo Dõi Lô Hàng" Class="custom-tab" Disabled>
        <TheoDoiLoHang HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
    <MudTabPanel Text="Map" Class="custom-tab" Disabled>
        <Map HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
</MudTabs>
@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
    M_HBL detail;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    List<string> trangthais = new List<string>();
    List<string> LenhDieuXeNo = new List<string>();
    List<string> YeuCauXeNo = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        try
        {
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            var tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude == "HBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            LenhDieuXeNo = await lsv.GetListTruckNo();
            YeuCauXeNo = await ysv.GetListYCTruckNo();
            await Refresh();
        }
        catch(Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    M_HBL hbldetail = new M_HBL();
    async Task Refresh()
    {
        try
        {
            hbldetail = null!;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            Listdata = await shipsv.GetListHBL(MBLDetail!.MblID);
            ListDebit = await shipsv.GetListDebitALL();
            ListCredit = await shipsv.GetListCreditALL();
            if (Listdata.Count > 0)
                hbldetail = Listdata[0];
        }
        finally
        {
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
        if (mudTable != null && Listdata.Count > 0)
            await mudTable.SetSelectedItemAsync(Listdata[0]);
    }
    MudDataGrid<M_HBL> mudTable;
    async Task AddItem()
    {
        var item = new M_HBL
            {
                bkno = MBLDetail!.Bkno,
                statusHBL = MBLDetail!.statusMBL,
                shipper = MBLDetail.Shipper,
                consignee = MBLDetail.Consignee,
                Truck_LenhDieuXeNo = MBLDetail.mbl_Truck_LenhDieuXeNo,
                Truck_YeucauTruckingNo = MBLDetail.mbl_Truck_YeucauTruckingNo,
                Continued = MBLDetail.Continued,
                editable = MBLDetail.Editable,
                userupdate = usr,
                dateupdate = DateTime.Now.ToString()
            };
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_HBL item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "HBL"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteHBLDetail(item);
            await HistoryLogService.LogAsync(usr, "Delete Trucking HBL", "HBL", item.hblID, item.hbl, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task UpdateHBLNo(M_HBL item, DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("HBL", value.Month, value.Year, usr);
        item.hbl = "Truck" + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D5") : "RefNoError!");
    }
    async Task CommittedItem(M_HBL item)
    {

        item.mblid = MBLDetail!.MblID;
        item.userupdate = usr;
        var rs = item.hblID != Guid.Empty ? await shipsv.UpdateHBLDetail(item,detail) : await shipsv.CreateHBLDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_HBL Sis, int rowNumber)
    {
        if (Sis.approve.HasValue && Sis.approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_HBL> args)
    {
        if (args.Item.approve.HasValue && args.Item.approve.Value)
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
        else hbldetail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_HBL> args)
    {

    }
    private async Task<IEnumerable<string>> SearchLenhDieuXe(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return LenhDieuXeNo;
            }
            // MBL.Porname = mst_Consignee;
            return LenhDieuXeNo.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchYCDieuXe(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return YeuCauXeNo;
            }
            // MBL.Porname = mst_Consignee;
            return YeuCauXeNo.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception ex)
        {
            throw;
        }
    }

    private async Task OpenDetailLenhDieuXe(string? no)
    {
        var tr = lsv.GetDetailByNo(no);
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["DataNotFound"], MudBlazor.Severity.Warning);
            return;
        }

        DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<LenhDieuXe.Pages.ADD> { { x => x._LenhDieuXe_Detail, tr }, { x => x.Status, "edit" } };
        var dialog = DialogService.Show<LenhDieuXe.Pages.ADD>(no, parameters, optionsdialog);
        var result = await dialog.Result;
        StateHasChanged();
        return;
    }
    private async Task OpenDetailYeucauTrucking(string? no)
    {
        var tr = ysv.GetDetailByNo(no);
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["DataNotFound"], MudBlazor.Severity.Warning);
            return;
        }
        DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<YeuCauTrucking.Pages.ADD> { { x => x._YeuCauTrucking_Detail, tr }, { x => x.Status, "edit" } };
        var dialog = await DialogService.ShowAsync<YeuCauTrucking.Pages.ADD>(no, parameters, optionsdialog);
        var result = await dialog.Result;
        StateHasChanged();
        return;
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }
    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    async Task UpdatebyCheckboxClick(M_HBL item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "HBL"))
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new System.Globalization.CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateHBLDetail(item, detail);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task TryStartEditing(M_HBL item)
    {
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Warning);
            return;
        }
    
        detail = JsonSerializer.Deserialize<M_HBL>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
    List<M_Debit> ListDebit = new();
    List<M_Credit> ListCredit = new();
    bool chkUSD = false, chkVAT = false;
    double? TProfit_(Guid id)
    {
        var debit = ListDebit;
        var credit = ListCredit;

        debit = ListDebit.Where(x => x.hblid == id).ToList();
        credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
        return totaldebit - totalcredit;
    }
    double? TDebit_(Guid id)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        return debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
    }
    double? TCredit_(Guid id)
    {
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        return credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
    }

    private async Task OpenHblQrDialog(M_HBL item)
    {
        if (string.IsNullOrWhiteSpace(item.hbl))
        {
            CallSnackBar("House Trucking No is empty.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(Shipment.Pages.DialogHblQr.HblNo)] = item.hbl,
            [nameof(Shipment.Pages.DialogHblQr.TitleLabel)] = Localizer["House Trucking No"],
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        await DialogService.ShowAsync<Shipment.Pages.DialogHblQr>(Localizer["House Trucking No"] + " QR Code", parameters, options);
    }
}