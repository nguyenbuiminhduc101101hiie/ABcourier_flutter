@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [Parameter] public string Type { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public bool isDuty { get; set; }
    [Parameter] public EventCallback<int> OnDataCountChanged { get; set; }
    M_Debit detail_Debit;

    bool IsDebitParentMissing => isMBL
        ? (MBLDetail?.MblID ?? Guid.Empty) == Guid.Empty
        : (HBLDetail?.hblID ?? Guid.Empty) == Guid.Empty;
    bool IsDebitCompletedLocked => !isMBL && HBLDetail?.debitCompleted == true;
    bool CanMutateDebitData => !IsDebitParentMissing && !IsDebitCompletedLocked;
    bool _togglingCompleted;

    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    bool isMBL;
    string usr;
    bool canUnlockDebit;
    List<ChargeModel> charges = new List<ChargeModel>();
    string type = "";
    List<string> currs = new List<string>();
    List<M_HoaDonDauRa> ListdataHoaDon = new List<M_HoaDonDauRa>();
    protected override async Task OnInitializedAsync()
    {
        try
        {


            isMBL = MBLDetail == null ? false : true;
            if (isMBL)
            {
                if (MBLDetail!.MblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng MBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            else
            {
                if (HBLDetail!.hblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            currs = await Vcbsv.GetCur();
            Types = await shipsv.GetListTypeInDebitCredit();
            type = await shipsv.GetTypeByMBLID(isMBL ? MBLDetail!.MblID : HBLDetail!.mblid); // Sea Air Truck HQ
            charges = await supsv.GetListChargeDuty(isDuty);
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            var userDetail = asv.GetUserDetail();
            var department = userDetail?.Department?.Trim();
            canUnlockDebit = string.Equals(department, "ACCOUNT", StringComparison.OrdinalIgnoreCase)
                || string.Equals(department, "ADMIN", StringComparison.OrdinalIgnoreCase);
            if (!isMBL)
                Ports = await supsv.GetListPort();
            Conts = shipsv.GetListContainerAll();
            if (!isMBL)
            {
                var hblConts = shipsv.GetListContainerHBL(HBLDetail!.hblID) ?? new List<M_Container>();
                var byType = hblConts
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.CTN_SIZE_TYPE) ? "N/A" : x.CTN_SIZE_TYPE!.Trim())
                    .Select(g => $"{g.Count()}x{g.Key}");
                _hblContCount = hblConts.Count == 0 ? "0" : string.Join(",", byType);
            }
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["PleaseSlowDown"], MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_Debit> Listdata = new List<M_Debit>();
    List<M_Container> Conts = new();
    string _hblContCount = "0";
    M_Debit detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "MBL"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
            {
                Listdata = await shipsv.GetListDebitMBL(MBLDetail!.MblID);
                ListdataHoaDon = await shipsv.GetListHoaDonDauRaMBL(MBLDetail!.MblID);
            }
            else
            {
                Listdata = await shipsv.GetListDebitHBL(HBLDetail!.hblID, isDuty);
                ListdataHoaDon = await shipsv.GetListHoaDonDauRaHBL(HBLDetail!.hblID);
            }

            // check có còn tồn tại hóa đơn không
            if (Listdata.Any(x => !string.IsNullOrWhiteSpace(x.sohoadondaura)))
            {
                var isexistinv = await shipsv.isExistInvoice(Listdata);
                if (!isexistinv) // không tồn tại hóa đơn nữa thì update lại debit
                {
                    Listdata.ForEach(x => x.sohoadondaura = null);
                    Listdata.ForEach(x => x.daXuatHoadon = false);
                    var rs = await shipsv.UpdateDebitMBL(Listdata);
                }
            }
            if (OnDataCountChanged.HasDelegate)
                await OnDataCountChanged.InvokeAsync(Listdata?.Count ?? 0);
        }
        catch(Exception ex)
        {
            CallSnackBar(Localizer["PleaseSlowDown"], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Debit> mudTable;
    async Task AddItem()
    {
        if (!EnsureCanMutateDebit()) return;
        if(detail  == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_Debit
        {
                debitno = detail.debitno,
                customerid = detail.customerid,
                itemid = detail.itemid
        };
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }


    private async Task CopyDebitQuotation()
    {
        if (!EnsureCanMutateDebit()) return;
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        if (HBLDetail == null || HBLDetail.hblID == Guid.Empty)
        {
            CallSnackBar(Localizer["SelectOneRowHbl"], MudBlazor.Severity.Warning);
            return;
        }

        // Copy theo Quotation (giữ nguyên chức năng cũ)
        var parameters = new DialogParameters<Copy_Debit>
        {
            { x => x._HBL_details, HBLDetail }
        };

        var dialog = await DialogService.ShowAsync<Copy_Debit>("Copy Data Debit", parameters, optionsdialog);
        var result = await dialog.Result;
        await Refresh();
        return;

    }

    private async Task CopyDebitFromMblHbl()
    {
        if (!EnsureCanMutateDebit()) return;
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        if (isMBL)
        {
            if (MBLDetail == null || MBLDetail.MblID == Guid.Empty)
            {
                CallSnackBar(Localizer["SelectOneRowMbl"], MudBlazor.Severity.Warning);
                return;
            }
        }
        else
        {
            if (HBLDetail == null || HBLDetail.hblID == Guid.Empty)
            {
                CallSnackBar(Localizer["SelectOneRowHbl"], MudBlazor.Severity.Warning);
                return;
            }
        }

        var parameters = new DialogParameters<Copy_Debit_HBL_MBL>
        {
            { x => x.MBLDetail, isMBL ? MBLDetail : null },
            { x => x.HBLDetail, isMBL ? null : HBLDetail },
            { x => x.isDuty, isDuty }
        };

        var dialog = await DialogService.ShowAsync<Copy_Debit_HBL_MBL>("Copy Data Debit", parameters, optionsdialog);
        var result = await dialog.Result;

        await Refresh();
    }
    async Task NewItem()
    {
        if (!EnsureCanMutateDebit()) return;
        var item = new M_Debit
        {
                customerid = isMBL ? MBLDetail!.CustomerID : HBLDetail!.CustomerID
        };
        // Dùng chung số Debit của lô + khách hàng (chưa in/duyệt), chưa có mới cấp số mới
        item.debitno = DebitAddInCell.FindReusableDebitNo(Listdata, item.customerid)
                       ?? await GenerateDebitNo(DateTime.Now);
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task NewItemIncell()
    {
        if (!EnsureCanMutateDebit()) return;
        var maincus = isMBL ? MBLDetail!.CustomerID : HBLDetail!.CustomerID;
        var df = new List<M_Debit>();
        // Có chọn 1 dòng (còn trong danh sách hiện tại) thì dùng số Debit của dòng đó
        var selectedDebitNo = detail != null && Listdata.Contains(detail) && !string.IsNullOrWhiteSpace(detail.debitno)
            ? detail.debitno
            : null;

        var takeTpldialog = DialogService.Show<TemplateDialog>("Lấy mẫu", new DialogParameters { ["IncludeCustomerId"] = false });
        var takeTpl = await takeTpldialog.Result;
        if (!takeTpl.Canceled && ((dynamic)takeTpl.Data).Result)
        {
            // Load template Debit của user, theo loại lô hàng (Sea/Air/Truck/HQ)
            var allTpl = await supsv.GetAllDebitCreditAsync();
            var defaults = allTpl
                .Where(t => t.DebitCredit.Equals("Debit", StringComparison.OrdinalIgnoreCase) && t.UserCreate == usr && t.ShipmentType == type);
            bool includeCustomerId = ((dynamic)takeTpl.Data).IncludeCustomerId;
            if (includeCustomerId) // có thì lọc theo cus
                defaults = defaults.Where(x => x.CustomerId == maincus);
            df = defaults
                .Select(t => new M_Debit
                    {
                        customerid = maincus,
                        editable = true,
                        tiente = t.Cur,
                        type = !string.IsNullOrWhiteSpace(t.type) ? t.type! : Types.First(),
                        soluong = 1,
                        dongia = t.Amount,
                        itemid = t.ItemId,
                        thanhtien = 0,
                        thue = 0,
                        thanhtiensauthue = 0,
                        userupdate = usr,
                        dateupdate = DateTime.Now.ToString()
                    })
                .ToList();
            if (isMBL)
                df.ForEach(x => x.mblid = MBLDetail!.MblID);
            else
                df.ForEach(x => x.hblid = HBLDetail!.hblID);
            var tigia = await Vcbsv.Getexchange_cur("VND");
            df.ForEach(x => x.tigiadebit = x.tigiahoandondaura = tigia);
            // Cả bộ mẫu dùng chung 1 số Debit: số của dòng đang chọn > số chưa in/duyệt của khách hàng > số mới
            if (df.Count > 0)
            {
                var sharedDebitNo = selectedDebitNo
                                    ?? DebitAddInCell.FindReusableDebitNo(Listdata, maincus)
                                    ?? await GenerateDebitNo(DateTime.Now);
                df.ForEach(x => x.debitno = sharedDebitNo);
            }
        }
        var parameters = new DialogParameters<DebitAddInCell> { { x => x.Debits, Listdata }, { x => x.Debitsdf, df }, { x=>x.currs, currs}, { x=>x.Type, type}, {x=>x.usr, usr}, {x=>x.isMBL,isMBL},
            {x=>x.MBLDetail , MBLDetail}, {x=>x.HBLDetail , HBLDetail}, {x=>x.Customers , Customers}, {x=>x.Types,Types}, {x=>x.charges,charges}, {x=>x.maincus,maincus}, {x=>x.DefaultDebitNo,selectedDebitNo}};
        // MaxWidth.False: dialog giãn gần hết chiều ngang màn hình để bảng hiển thị đủ cột
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.False, DisableBackdropClick = true, ClassBackground = "class-dialog-custom" };
        var dialog = DialogService.Show<DebitAddInCell>($"Quản lý Debit - Customer: {CusidtoCusCode(maincus)}", parameters, options);
        await dialog.Result;
        await Refresh();
    }

    async Task DeleteItem(M_Debit item)
    {
        if (!EnsureCanMutateDebit()) return;
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.khoa.HasValue && item.khoa.Value)
        {
            CallSnackBar("This Debit is locked!", MudBlazor.Severity.Info);
            return;
        }

        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["DebitApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteDebitMBL(item);
            await HistoryLogService.LogAsync(usr, "Delete Debit", "Shipment", item.debitId, item.debitno, new { OldData = item});
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_Debit item)
    {
        if (!EnsureCanMutateDebit()) return;
        if (detail_Debit != null
            && detail_Debit.debitId != Guid.Empty
            && detail_Debit.khoa == true
            && item.khoa != true
            && !canUnlockDebit)
        {
            item.khoa = true;
            CallSnackBar("Only ACCOUNT or ADMIN can unlock Debit!", MudBlazor.Severity.Warning);
            return;
        }
        if(isMBL)
            item.mblid = MBLDetail!.MblID;
        else 
            item.hblid = HBLDetail!.hblID;
        item.ContainerNo = string.IsNullOrWhiteSpace(item.ContainerNo) ? null : item.ContainerNo.Trim();
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString();
        var rs = item.debitId != Guid.Empty ? await shipsv.UpdateDebitMBL(item, detail_Debit) : await shipsv.CreateDebitMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Debit Sis, int rowNumber)
    {
        if (Sis.approve.HasValue && Sis.approve.Value)
            return "custom-disable";
        if (copiedDebitIds.Contains(Sis.debitId))
            return "debit-row-copied";
        if (mudTable?.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
            return "selected";
        return string.Empty;
    }
    void RowClicked(DataGridRowClickEventArgs<M_Debit> args)
    {
        if (args.Item.approve.HasValue && args.Item.approve.Value)
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Info);
        else detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_Debit> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
