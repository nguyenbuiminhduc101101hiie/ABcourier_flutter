    private async Task OnCopySourceHblChanged(Guid? hblId)
    {
        _copySourceHblId = hblId;
        sourceDebitList.Clear();
        sourceDebitGridVisible = true;

        if (hblId == null || hblId == Guid.Empty)
            return;

        if (hblId == CurrentHblId)
        {
            CallSnackBar("Không thể chọn chính HBL hiện tại.", MudBlazor.Severity.Warning);
            _copySourceHblId = null;
            return;
        }

        await _copyQuerySemaphore.WaitAsync();
        try
        {
            _loadingSourceDebit = true;
            StateHasChanged();
            await LoadSourceDebitsInternal(hblId.Value);
        }
        catch (Exception)
        {
            CallSnackBar("Lỗi khi tải Debit của HBL.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingSourceDebit = false;
            _copyQuerySemaphore.Release();
        }
    }

    private async Task LoadSourceDebitsInternal(Guid hblId)
    {
        sourceDebitList = await shipsv.GetListDebitHBL(hblId, isDuty);
    }

    private async Task<string> GenerateNewDebitNo(Guid targetMblId)
    {
        var now = DateTime.Now;
        var refno = await supsv.GetRefNoByFunc("Debit", now.Month, now.Year, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        var userDetail = asv.GetUserDetail();
        var cn = userDetail.Branch;
        var flc = await shipsv.GetFLCByMBLID(targetMblId);
        var shipmentType = await shipsv.GetTypeByMBLID(targetMblId);
        return cn + tiepdaungu + shipmentType + flc + now.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D4") : "RefNoError!");
    }

    private async Task CopySourceDebitToCurrent(M_Debit item)
    {
        if (!EnsureCanMutateDebit()) return;
        if (HBLDetail == null || HBLDetail.hblID == Guid.Empty)
        {
            CallSnackBar(Localizer["SelectOneRowHbl"], MudBlazor.Severity.Warning);
            return;
        }

        if (item == null)
            return;

        if (_copySourceHblId == HBLDetail.hblID)
        {
            CallSnackBar("Không thể copy Debit từ chính HBL hiện tại.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _copyingDebitRow = true;
            StateHasChanged();

            var sourceDebitNoKey = item.debitno ?? string.Empty;
            if (!_debitNoBySourceKey.TryGetValue(sourceDebitNoKey, out var targetDebitNo))
            {
                targetDebitNo = await GenerateNewDebitNo(HBLDetail.mblid);
                _debitNoBySourceKey[sourceDebitNoKey] = targetDebitNo;
            }

            var newDebit = new M_Debit
            {
                debitId = Guid.Empty,
                quotationid = item.quotationid,
                debitno = targetDebitNo,
                mblid = HBLDetail.mblid,
                hblid = HBLDetail.hblID,
                itemid = item.itemid,
                customerid = item.customerid,
                dongia = item.dongia,
                soluong = item.soluong,
                thanhtien = item.thanhtien,
                tiente = item.tiente,
                thue = item.thue,
                thanhtiensauthue = item.thanhtiensauthue,
                thuho = item.thuho,
                tigiadebit = item.tigiadebit,
                tigiahoandondaura = item.tigiahoandondaura,
                pol = item.pol,
                pod = item.pod,
                del = item.del,
                nhom = item.nhom,
                ghichu = item.ghichu,
                type = item.type,
                continued = true,
                editable = true,
                approve = false,
                dateupdate = DateTime.Now.ToString("dd/MM/yyyy"),
                userupdate = usr,
                daIndebit = false,
                daXuatHoadon = false,
                khoa = false,
                InArrival = false,
                sohoadondaura = null
            };

            var rs = await shipsv.CreateDebitMBL(newDebit);
            if (rs.Flag)
            {
                copiedDebitIds.Add(newDebit.debitId);
                CallSnackBar(rs.Message, MudBlazor.Severity.Success);
                await Refresh();
            }
            else
            {
                CallSnackBar(rs.Message, MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _copyingDebitRow = false;
            StateHasChanged();
        }
    }

    private bool _copyingToCredit;
    private async Task CopyDebitToCredit()
    {
        var item = mudTable?.SelectedItem ?? detail;
        if (item == null || item.debitId == Guid.Empty)
        {
            CallSnackBar("Vui lòng chọn 1 dòng Debit để copy sang Credit.", MudBlazor.Severity.Warning);
            return;
        }
        if (!isMBL && HBLDetail?.creditCompleted == true)
        {
            CallSnackBar("Credit đã xác nhận hoàn thành. Bỏ xác nhận Credit để thao tác.", MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            Localizer["Copy to Credit"],
            $"Copy dòng Debit \"{Charidtocharge(item.itemid)}\" sang Credit?",
            yesText: "OK", cancelText: "Cancel");
        if (confirm != true) return;

        try
        {
            _copyingToCredit = true;
            StateHasChanged();

            var newCredit = new M_Credit
            {
                creditid = Guid.Empty,
                mblid = item.mblid,
                hblid = item.hblid,
                Quanly_tauid = item.Quanly_tauid,
                Quanly_contid = item.Quanly_contid,
                quotationid = item.quotationid,
                customerid = item.customerid,
                itemid = item.itemid,
                dongia = item.dongia,
                soluong = item.soluong,
                thanhtien = item.thanhtien,
                tiente = item.tiente,
                thue = item.thue,
                thanhtiensauthue = item.thanhtiensauthue,
                chiho = item.thuho,
                tigiacredit = item.tigiadebit,
                tigiahoadondauvao = item.tigiahoandondaura,
                type = item.type,
                ghichu_credit = item.ghichu,
                ContainerNo = item.ContainerNo,
                continued = true,
                editable = true,
                approve = false,
                DNTT = false,
                DNTU = false,
                Copied = false,
                dathanhtoan = false,
                sodntt = null,
                userupdate = usr,
                dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"))
            };

            var rs = await shipsv.CreateCreditMBL(newCredit);
            CallSnackBar(rs.Flag ? "Đã copy Debit sang Credit. Mở/Reload tab Credit để xem." : rs.Message,
                rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _copyingToCredit = false;
            StateHasChanged();
        }
    }

    bool EnsureCanMutateDebit()
    {
        if (IsDebitCompletedLocked)
        {
            CallSnackBar("Debit đã xác nhận hoàn thành. Bỏ xác nhận để thao tác.", MudBlazor.Severity.Warning);
            return false;
        }
        return true;
    }

