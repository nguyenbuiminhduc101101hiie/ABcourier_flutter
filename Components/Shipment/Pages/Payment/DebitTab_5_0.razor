@using System.Globalization
@using System.Threading
@using MudBlazor
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject GlobalServices gsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@inject tigiaVCBservices Vcbsv
@using System.Text.Json;

<style>
    .pay-bl-tabs ::deep .mud-tabs-toolbar {
        background: linear-gradient(180deg, #fafcfd 0%, #f0f5f8 100%);
        border-radius: 12px !important;
        border: 1px solid #e0e0e0;
        padding: 4px 6px !important;
        margin-bottom: 10px;
    }

    .pay-bl-tabs ::deep .mud-tab {
        font-weight: 600;
        font-size: 13px;
        color: #455a64;
        text-transform: none !important;
    }

    .pay-bl-tabs ::deep .mud-tab.mud-tab-active {
        color: #118AB2 !important;
    }

    .pay-bl-tabs ::deep .mud-slider {
        background-color: #118AB2 !important;
    }

    .pay-bl-panel-sheet {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        overflow: hidden;
        margin-bottom: 10px;
    }

    .pay-bl-invoice-inner {
        padding: 12px 14px 16px;
        min-height: 120px;
    }

    .pay-bl-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 24px;
        padding: 10px 14px 12px;
        border-top: 1px solid #e5e7eb;
        background: linear-gradient(180deg, #fafbfc 0%, #f4f7f9 100%);
        font-size: 13px;
        color: #37474f;
    }

    .pay-bl-summary strong {
        color: #118AB2;
        font-weight: 700;
    }

    .pay-bl-datagrid ::deep .mud-table-toolbar,
    .pay-bl-datagrid ::deep thead th {
        font-size: 12px;
    }

    .debit-copy-search-panel {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        margin: 10px 12px 0;
    }

    .debit-copy-search-expansion .mud-expand-panel-header {
        min-height: 40px;
        padding: 0 12px;
    }

    .debit-copy-search-expansion .mud-expand-panel-content {
        padding: 8px 12px 12px;
    }

    .debit-copy-search-row {
        gap: 10px;
    }

    .debit-copy-search-field {
        flex: 0 0 auto;
    }

    .debit-copy-search-hblno {
        width: 180px;
    }

    .debit-copy-search-pol {
        width: 150px;
    }

    .debit-copy-search-pod {
        width: 150px;
    }

    .debit-copy-search-customer {
        width: 240px;
    }

    .debit-copy-search-etd {
        width: 140px;
    }

    .debit-copy-search-eta {
        width: 140px;
    }

    .debit-copy-search-input .mud-input-root,
    .debit-copy-search-input .mud-input-control {
        background: #ffffff !important;
    }

    .debit-copy-search-input .mud-input-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #475569 !important;
    }

    .debit-copy-search-input .mud-input-slot {
        min-height: 36px;
    }

    .debit-copy-search-btn {
        height: 36px;
        min-width: 96px;
        padding: 0 14px;
        margin-bottom: 1px;
        text-transform: none;
        font-weight: 600;
        letter-spacing: 0;
    }

    .debit-copy-grid-wrap {
        overflow-x: auto;
        max-width: 100%;
        text-align: left;
        margin: 0 12px;
    }

    .debit-copy-grid-wrap .mud-table-container,
    .debit-copy-grid-wrap .mud-table-root {
        margin-left: 0 !important;
        margin-right: auto !important;
    }

    .debit-copy-grid-wrap .debit-copy-grid .mud-table-container {
        height: auto !important;
        min-height: unset !important;
        max-height: 420px;
        overflow-y: auto;
    }

    .debit-copy-grid.stock-grid-autofit .mud-table-root {
        width: max-content;
        max-width: 100%;
    }

    .debit-copy-grid.stock-grid-autofit .mud-table-root td,
    .debit-copy-grid.stock-grid-autofit .mud-table-root th,
    .debit-copy-grid.stock-grid-autofit .mud-table-cell {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .debit-copy-grid .mud-table-cell.debit-copy-col-text {
        text-align: left !important;
    }

    .debit-copy-grid .mud-table-cell.debit-copy-col-num {
        text-align: right !important;
    }

    .pay-bl-datagrid .mud-table-row.debit-row-copied .mud-table-cell,
    .pay-bl-datagrid .mud-table-row.debit-row-copied:hover .mud-table-cell,
    .pay-bl-datagrid .mud-table-row.debit-row-copied:focus-within .mud-table-cell {
        background-color: #15803d !important;
        color: #ffffff !important;
    }

    .pay-bl-datagrid .mud-table-row.debit-row-copied:hover .mud-table-cell {
        background-color: #166534 !important;
        color: #ffffff !important;
    }

    .pay-bl-datagrid .mud-table-row.debit-row-copied .mud-table-cell .mud-input,
    .pay-bl-datagrid .mud-table-row.debit-row-copied .mud-table-cell .mud-input-slot,
    .pay-bl-datagrid .mud-table-row.debit-row-copied:hover .mud-table-cell .mud-input,
    .pay-bl-datagrid .mud-table-row.debit-row-copied:hover .mud-table-cell .mud-input-slot {
        color: #ffffff !important;
    }
</style>

<MudTabs SliderColor="Color.Primary" Class="pay-bl-tabs">
    <MudTabPanel Text="@(isDuty ? "Input" : "Debit")" BadgeColor="Color.Secondary" Class="custom-tab">
        <div class="pay-bl-panel-sheet">
        @if (!isMBL)
        {
            <MudExpansionPanels Class="debit-copy-search-panel mb-3" Elevation="0">
                <MudExpansionPanel Text="Tìm HBL để copy Debit"
                                   Icon="@Icons.Material.Filled.Search"
                                   @bind-IsExpanded="searchPanelExpanded"
                                   Dense="true"
                                   Class="debit-copy-search-expansion">
                    <MudStack Row="true"
                              Spacing="2"
                              AlignItems="AlignItems.End"
                              Wrap="Wrap.Wrap"
                              Class="debit-copy-search-row">
                        <div class="debit-copy-search-field debit-copy-search-hblno">
                            <MudAutocomplete T="Guid?"
                                             @ref="_hblNoAutocomplete"
                                             Class="debit-copy-search-input"
                                             Value="_copySourceHblId"
                                             ValueChanged="OnCopySourceHblChanged"
                                             Label="HBL No."
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchHblNoLike"
                                             ToStringFunc="HblIdToText"
                                             ResetValueOnEmptyText
                                             Clearable
                                             Strict="false"
                                             MinCharacters="0"
                                             DebounceInterval="300"
                                             MaxItems="20"
                                             ShowProgressIndicator="@_loadingHblNoSearch"
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-pol">
                            <MudAutocomplete T="string"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterPol"
                                             Label="POL"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterPort"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-pod">
                            <MudAutocomplete T="string"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterPod"
                                             Label="POD"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterPort"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-customer">
                            <MudAutocomplete T="Guid?"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterCustomerId"
                                             Label="@Localizer["Customer"]"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterCustomer"
                                             ToStringFunc="CusidNullableToCusCode"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-etd">
                            <MudDatePicker @bind-Date="_filterEtd"
                                           Label="ETD"
                                           Variant="Variant.Outlined"
                                           Dense="@true"
                                           Margin="Margin.Dense"
                                           Clearable
                                           DateFormat="dd/MM/yyyy"
                                           Class="debit-copy-search-input"
                                           FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-eta">
                            <MudDatePicker @bind-Date="_filterEta"
                                           Label="ETA"
                                           Variant="Variant.Outlined"
                                           Dense="@true"
                                           Margin="Margin.Dense"
                                           Clearable
                                           DateFormat="dd/MM/yyyy"
                                           Class="debit-copy-search-input"
                                           FullWidth="@true" />
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="SearchHblByFilter"
                                   Disabled="_loadingSearchHBL || _loading"
                                   Class="debit-copy-search-btn">
                            Search
                        </MudButton>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(searchHBLMessage))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2 px-1">@searchHBLMessage</MudText>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_copySourceHblId.HasValue && _copySourceHblId.Value != Guid.Empty)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1 px-3">
                    <MudText Typo="Typo.subtitle2">
                        Debit từ HBL: <b>@HblIdToText(_copySourceHblId)</b>
                        @if (sourceDebitList.Count > 0)
                        {
                            <span class="ms-2 text-secondary">(@sourceDebitList.Count dòng)</span>
                        }
                    </MudText>
                    <MudTooltip Text="@(sourceDebitGridVisible ? "Ẩn lưới Debit copy" : "Hiện lưới Debit copy")">
                        <MudIconButton Size="Size.Small"
                                       Icon="@(sourceDebitGridVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       Color="Color.Default"
                                       OnClick="ToggleSourceDebitGridVisible" />
                    </MudTooltip>
                </MudStack>
                @if (sourceDebitGridVisible)
                {
                    <div class="debit-copy-grid-wrap">
                        <MudDataGrid T="M_Debit"
                                     Items="@sourceDebitList"
                                     Filterable="true"
                                     FilterMode="@DataGridFilterMode.Simple"
                                     Dense="true"
                                     ReadOnly="true"
                                     Bordered="true"
                                     Hover="false"
                                     Loading="_loadingSourceDebit"
                                     ShowColumnOptions="false"
                                     Class="stock-grid-autofit debit-copy-grid mb-3"
                                     HeaderClass="no-wrap">
                            <ColGroup>
                                <col style="width: 36px;" />
                                <col style="width: 110px;" />
                                <col style="width: 140px;" />
                                <col style="width: 120px;" />
                                <col style="width: 90px;" />
                                <col style="width: 70px;" />
                                <col style="width: 70px;" />
                                <col style="width: 95px;" />
                                <col style="width: 55px;" />
                                <col style="width: 55px;" />
                                <col style="width: 105px;" />
                                <col style="width: 120px;" />
                            </ColGroup>
                            <Columns>
                                <TemplateColumn Title="" Filterable="false" Sortable="false" HeaderStyle="width: 36px;" CellStyle="width: 36px;" CellClass="d-flex justify-center">
                                    <CellTemplate>
                                        <MudTooltip Text="Copy xuống Debit HBL hiện tại">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.South"
                                                           Color="Color.Success"
                                                           OnClick="@(() => CopySourceDebitToCurrent(context.Item))"
                                                           Disabled="@(_copyingDebitRow || IsDebitCompletedLocked)" />
                                        </MudTooltip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.debitno" Title="@Localizer["Debit No."]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.type" Title="@Localizer["Type"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.ghichu" Title="@Localizer["Notes"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                            </Columns>
                        </MudDataGrid>
                    </div>
                    <MudDivider Class="my-2" />
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mb-1 px-3">
                Debit HBL hiện tại: <b>@(HBLDetail?.hbl ?? string.Empty)</b>
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 px-3">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(IsDebitCompletedLocked ? Color.Success : Color.Default)"
                         Variant="Variant.Filled">
                    @(IsDebitCompletedLocked ? "Debit đã xác nhận hoàn thành — đang khóa" : "Debit chưa xác nhận hoàn thành")
                </MudChip>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Color="@(IsDebitCompletedLocked ? Color.Warning : Color.Success)"
                           StartIcon="@(IsDebitCompletedLocked ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Verified)"
                           OnClick="ToggleDebitCompleted"
                           Disabled="@(HBLDetail == null || HBLDetail.hblID == Guid.Empty || _togglingCompleted)">
                    @(IsDebitCompletedLocked ? "Bỏ xác nhận Debit" : "Xác nhận hoàn thành Debit")
                </MudButton>
            </MudStack>
        }

        <MudDataGrid T="M_Debit" Items="@Listdata" Filterable="true" @ref="mudTable"
        Class="pay-bl-datagrid"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="@IsDebitCompletedLocked" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Variant="Variant.Filled"
                                Disabled="@IsDebitParentMissing"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="NewItem"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateDebitData)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["New In Cell"]">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="NewItemIncell"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateDebitData)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Add"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="AddItem"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateDebitData)"
                                Class="btn-compact" />
                            </MudTooltip>



                            <MudTooltip Text="@Localizer["Bills"]">
                                <MudMenu Icon="@Icons.Material.Filled.Download"
                                Color="Color.Success"
                                Size="Size.Small"
                                Variant="Variant.Filled"
                                Disabled="@IsDebitParentMissing"
                                AnchorOrigin="Origin.BottomCenter"
                                TransformOrigin="Origin.TopCenter">
                                    <MudMenuItem Disabled="_processingUpload" OnClick="ExportBill">
                                        @if (_processingUpload)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Exporting...</span>
                                        }
                                        else
                                        {
                                            @Localizer["Export Debit"]
                                        }
                                    </MudMenuItem>
                                    @if(!isDuty)
                                    {
                                        <MudMenuItem OnClick="CreateInvoice" Disabled="@IsDebitCompletedLocked">
                                            @Localizer["Create Invoice"]
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Copy_Debit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ControlPointDuplicate"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="CopyDebitQuotation"
                                Variant="Variant.Filled"
                                Disabled="@(HBLDetail == null || HBLDetail.hblID == Guid.Empty || IsDebitCompletedLocked)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="Copy Debit (MBL/HBL)">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="CopyDebitFromMblHbl"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateDebitData)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Copy to Credit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.MoveDown"
                                Color="Color.Warning"
                                Size="Size.Small"
                                OnClick="CopyDebitToCredit"
                                Variant="Variant.Filled"
                                Disabled="@(IsDebitParentMissing || _copyingToCredit)"
                                Class="btn-compact" />
                            </MudTooltip>

                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Visibility" OnClick="@(()=>ViewItem(context.Item))" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" Disabled="@(context.Item.khoa == true || IsDebitCompletedLocked)" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled="@(context.Item.khoa == true || IsDebitCompletedLocked)" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.debitno" Title="@Localizer["Debit No."]" Required="false" >
                    <EditTemplate>
                        @if (!isMBL)
                        {
                            <MudTextField T="string" Value="_hblContCount" Label="Số lượng cont" ReadOnly="true" />
                        }
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                            <MudAutocomplete T="string" @bind-Value="context.Item.debitno" Label="Debit No." Required
                                             SearchFunc="SearchDebitNo" CoerceText="false" CoerceValue="true" Clearable />
                            <MudTooltip Text="Lấy số Debit mới">
                                <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => UpdateDebitNo(context.Item, DateTime.Now))" />
                            </MudTooltip>
                        </MudStack>
                        <MudDatePicker Label="@Localizer["Selected Date Get Debit No"]" DateChanged="((t)=>UpdateDebitNo(context.Item,(DateTime)t!))" 
                        ImmediateText DateFormat="MM/yyyy"  Disabled="!string.IsNullOrEmpty(context.Item.debitno)"/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dathanhtoan" Title="Đã Thanh Toán" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathanhtoan" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thuho" Title="@Localizer["On Behaft"]" Required="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.thuho" Label="@Localizer["On Behaft"]" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.customerid" Label="@Localizer["Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" Clearable />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x =>  Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required
                        SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.dongia" Class="text-right"
                        Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.type" Title="@Localizer["Type"]" Required="false" >
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.type"
