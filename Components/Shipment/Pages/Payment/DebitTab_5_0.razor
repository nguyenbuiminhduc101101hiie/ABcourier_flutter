    async Task OnInvoicePrintedChanged(M_Debit item)
    {
        var previousValue = !(item.daXuatHoadon ?? false);
        if (!EnsureCanMutateDebit() || item.khoa == true || IsDebitCompletedLocked)
        {
            item.daXuatHoadon = previousValue;
            return;
        }

        var oldData = JsonSerializer.Deserialize<M_Debit>(JsonSerializer.Serialize(item));
        if (oldData != null)
            oldData.daXuatHoadon = previousValue;

        item.dateupdate = DateTime.Now.ToString();
        item.userupdate = usr;
        var rs = await shipsv.UpdateDebitMBL(item, oldData!);
        if (!rs.Flag)
        {
            item.daXuatHoadon = previousValue;
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
        }
    }

