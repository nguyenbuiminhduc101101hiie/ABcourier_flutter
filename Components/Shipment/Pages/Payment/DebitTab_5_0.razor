    private bool HasAtLeastOneHblFilter()
        => !string.IsNullOrWhiteSpace(_filterPol)
           || !string.IsNullOrWhiteSpace(_filterPod)
           || (_filterCustomerId.HasValue && _filterCustomerId.Value != Guid.Empty)
           || _filterEtd.HasValue
           || _filterEta.HasValue;

    private async Task SearchHblByFilter()
    {
        if (!HasAtLeastOneHblFilter())
        {
            CallSnackBar("Vui lòng nhập ít nhất 1 điều kiện: POL, POD, Customer, ETD hoặc ETA.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await _copyQuerySemaphore.WaitAsync(0))
        {
            CallSnackBar("Đang tải dữ liệu, vui lòng thử lại sau.", MudBlazor.Severity.Info);
            return;
        }

        try
        {
            _loadingSearchHBL = true;
            searchHBLMessage = null;
            searchedHBLs.Clear();
            _copySourceHblId = null;
            sourceDebitList.Clear();
            StateHasChanged();

            searchedHBLs = await shipsv.SearchHBLByFilter(
                _filterPol, _filterPod, _filterCustomerId, _filterEtd, _filterEta, CurrentHblId);
            CacheHblResults(searchedHBLs);

            searchHBLMessage = searchedHBLs.Count == 0
                ? "Không tìm thấy HBL phù hợp."
                : searchedHBLs.Count == 1
                    ? "Tìm thấy 1 HBL. Đã chọn tự động."
                    : $"Tìm thấy {searchedHBLs.Count} HBL. Chọn trong ô HBL No.";
        }
        catch (Exception)
        {
            CallSnackBar("Lỗi khi tìm HBL.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingSearchHBL = false;
            _copyQuerySemaphore.Release();
        }

        if (searchedHBLs.Count == 1)
        {
            await OnCopySourceHblChanged(searchedHBLs[0].hblID);
        }
        else if (searchedHBLs.Count > 1)
            await OpenHblNoSearchResults();
    }

