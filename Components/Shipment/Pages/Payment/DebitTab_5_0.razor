    private string HblIdToText(Guid? id)
    {
        if (id == null || id == Guid.Empty) return string.Empty;
        if (!_hblLookup.TryGetValue(id.Value, out var hbl))
            hbl = searchedHBLs.FirstOrDefault(x => x.hblID == id.Value);
        if (hbl == null) return string.Empty;

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(hbl.hbl))
            parts.Add(hbl.hbl);
        if (!string.IsNullOrWhiteSpace(hbl.polname))
            parts.Add(hbl.polname);
        if (!string.IsNullOrWhiteSpace(hbl.podname))
            parts.Add(hbl.podname);
        if (hbl.ETD.HasValue)
            parts.Add(hbl.ETD.Value.ToString("dd/MM/yyyy"));
        if (hbl.ETA.HasValue)
            parts.Add(hbl.ETA.Value.ToString("dd/MM/yyyy"));

        return string.Join(" | ", parts);
    }

    private void CacheHblResults(IEnumerable<M_HBL> hbls)
    {
        foreach (var hbl in hbls)
            _hblLookup[hbl.hblID] = hbl;
    }

    private async Task<IEnumerable<Guid?>> SearchHblNoLike(string text)
    {
        if (searchedHBLs.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(text))
                return searchedHBLs.Select(x => (Guid?)x.hblID);

            return searchedHBLs
                .Where(x => MatchesHblSearchText(x, text))
                .Select(x => (Guid?)x.hblID);
        }

        if (string.IsNullOrWhiteSpace(text))
            return Enumerable.Empty<Guid?>();

        if (!await _copyQuerySemaphore.WaitAsync(0))
        {
            return _hblLookup.Values
                .Where(x => MatchesHblSearchText(x, text))
                .Select(x => (Guid?)x.hblID);
        }

        try
        {
            _loadingHblNoSearch = true;
            StateHasChanged();

            var results = await shipsv.SearchHBLByHblNoLike(text, CurrentHblId);
            CacheHblResults(results);
            return results.Select(x => (Guid?)x.hblID);
        }
        finally
        {
            _loadingHblNoSearch = false;
            _copyQuerySemaphore.Release();
        }
    }

    private static bool MatchesHblSearchText(M_HBL hbl, string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return true;

        return (!string.IsNullOrEmpty(hbl.hbl) && hbl.hbl.Contains(text, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(hbl.polname) && hbl.polname.Contains(text, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(hbl.podname) && hbl.podname.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

