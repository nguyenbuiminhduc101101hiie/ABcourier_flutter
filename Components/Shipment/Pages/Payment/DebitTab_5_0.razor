    async Task ToggleDebitCompleted()
    {
        if (isMBL || HBLDetail == null || HBLDetail.hblID == Guid.Empty)
        {
            CallSnackBar("Vui lòng chọn 1 dòng HBL.", MudBlazor.Severity.Warning);
            return;
        }

        var next = !(HBLDetail.debitCompleted == true);
        var msg = next
            ? "Xác nhận hoàn thành Debit của HBL này? Sau khi xác nhận sẽ không thể thêm/sửa/xóa Debit."
            : "Bỏ xác nhận hoàn thành Debit? Bạn sẽ thao tác Debit được trở lại.";
        var ok = await DialogService.ShowMessageBox("Xác nhận", msg, yesText: "Đồng ý", cancelText: "Hủy");
        if (ok != true) return;

        try
        {
            _togglingCompleted = true;
            var rs = await shipsv.SetHblDebitCreditCompleted(HBLDetail.hblID, debitCompleted: next);
            if (rs.Flag)
            {
                HBLDetail.debitCompleted = next;
                CallSnackBar(rs.Message, MudBlazor.Severity.Success);
            }
            else
                CallSnackBar(rs.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _togglingCompleted = false;
        }
    }
}
