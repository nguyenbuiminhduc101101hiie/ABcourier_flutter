    private bool _processingUpload = false;
    private async Task ExportBill()
    {
        try
        {
            var cur_type = await ResolveCurrencyAsync();
            if (cur_type is null) return;

            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);

            var credits = isMBL
                ? (await shipsv.GetListCreditMBL(MBLDetail!.MblID))
                : (await shipsv.GetListCreditHBL(HBLDetail!.hblID, isCommission));
            if (!credits.Any())
            {
                CallSnackBar("Không tìm thấy dữ liệu credit để export.", MudBlazor.Severity.Warning);
                return;
            }

            var hblIds = credits
                .Where(x => x.hblid != Guid.Empty)
                .Select(x => x.hblid)
                .Distinct()
                .ToList();
            var hblInfos = new List<M_HBL>();
            foreach (var hblId in hblIds)
            {
                var hblInfo = await shipsv.GetHBL_byHBLid(hblId);
                if (hblInfo.hblID != Guid.Empty)
                {
                    hblInfos.Add(hblInfo);
                }
            }
            if (!hblInfos.Any() && !isMBL && HBLDetail != null && HBLDetail.hblID != Guid.Empty)
            {
                hblInfos.Add(HBLDetail);
            }
            if (!hblInfos.Any())
            {
                CallSnackBar("Không tìm thấy HBL cho credit đã chọn.", MudBlazor.Severity.Warning);
                return;
            }

            var rs = await shipsv.ExportCreditSI(credits, hblInfos, cur_type);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }

    private async Task<string?> ResolveBranchByCompanyAsync(string billType)
    {
        var companyOptions = await gsv.GetCompanyOtherList();
        var branchesByCompany = companyOptions
            .Where(x => string.Equals(x.Code?.Trim(), billType.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Branches?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!branchesByCompany.Any())
        {
            return string.Empty;
        }

        if (branchesByCompany.Count == 1)
        {
            return branchesByCompany[0]!;
        }

        var branchDialogOptions = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true,
            DisableBackdropClick = true
        };
        var branchParameters = new DialogParameters<Shipment.Pages.DialogBranchOption>
        {
            { x => x.BranchOptions, branchesByCompany! }
        };
        var branchDialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogBranchOption>("Credit - Chon Branch", branchParameters, branchDialogOptions);
        var branchResult = await branchDialogRef.Result;
        if (branchResult.Canceled)
        {
            return null;
        }
        return branchResult.Data?.ToString() ?? string.Empty;
    }

