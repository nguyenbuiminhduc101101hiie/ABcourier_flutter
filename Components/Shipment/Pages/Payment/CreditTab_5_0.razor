    private void CalculateTotal(M_Credit item)
    {
        if (item.soluong.HasValue && item.dongia.HasValue)
        {

            double soluong = item.soluong ?? 0;
            double dongia = item.dongia ?? 0;
            item.thanhtien = Math.Round(soluong * dongia, 2);
            CalculateThanhtiensauthue(item);
        }


    }

    private void CalculateThanhtiensauthue(M_Credit item)
    {
        if (item.thanhtien.HasValue && item.thue.HasValue)
        {
            double thanhtienValue = item.thanhtien ?? 0;
            double thueValue = item.thue ?? 0;
            item.thanhtiensauthue = Math.Round(thanhtienValue * (thueValue / 100 + 1), 2);
        }


    }

    private static readonly System.Text.RegularExpressions.Regex ContainerSizeTokenRegex =
        new(@"(20|40|45)[A-Za-z]{0,4}", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string NormalizeAlnum(string? s)
        => string.IsNullOrWhiteSpace(s) ? string.Empty : new string(s.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();

    private static double SumContainerCbm(IEnumerable<M_Container> containers)
    {
        double sum = 0;
        foreach (var c in containers)
        {
            if (string.IsNullOrWhiteSpace(c.cbm))
                continue;
            var s = c.cbm.Trim().Replace(',', '.');
            if (double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
                sum += v;
            else if (double.TryParse(c.cbm.Trim(), NumberStyles.Any, CultureInfo.GetCultureInfo("vi-VN"), out v))
                sum += v;
        }
        return sum;
    }

    /// <summary>
    /// Khi chọn Type: "CBM" -> tổng CBM container của HBL; type chứa cont size (20/40/45, vd CONT 20GP)
    /// -> đếm số container cùng size/type đó trong HBL; type khác -> mặc định 1.
    /// Chỉ set giá trị gợi ý ban đầu, người dùng vẫn sửa lại Quantity thủ công được sau đó.
    /// </summary>
    private void ApplyQuantityByType(M_Credit item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.type))
            return;

        var typeText = item.type.Trim();
        var normalizedType = NormalizeAlnum(typeText);
        var containers = GetContainerSourceForCurrentShipment().ToList();

        if (normalizedType.Contains("CBM"))
        {
            item.soluong = Math.Round(SumContainerCbm(containers), 2);
        }
        else if (typeText.Contains("20") || typeText.Contains("40") || typeText.Contains("45"))
        {
            var tokenMatch = ContainerSizeTokenRegex.Match(normalizedType);
            var digitPrefix = tokenMatch.Success
                ? tokenMatch.Groups[1].Value
                : typeText.Contains("20") ? "20" : typeText.Contains("40") ? "40" : "45";
            var fullToken = tokenMatch.Success ? tokenMatch.Value : digitPrefix;

            var exactCount = containers.Count(c => NormalizeAlnum(c.CTN_SIZE_TYPE) == fullToken);
            item.soluong = exactCount > 0
                ? exactCount
                : containers.Count(c => NormalizeAlnum(c.CTN_SIZE_TYPE).Contains(digitPrefix));
        }
        else
        {
            item.soluong = 1;
        }

        CalculateTotal(item);
    }

