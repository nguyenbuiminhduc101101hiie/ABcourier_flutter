@using System.Globalization﻿﻿
@using MudBlazor
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject GlobalServices gsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@inject tigiaVCBservices Vcbsv
@using System.Text.Json;

<style>
    .pay-bl-tabs ::deep .mud-tabs-toolbar {
        background: linear-gradient(180deg, #fafcfd 0%, #f0f5f8 100%);
        border-radius: 12px !important;
        border: 1px solid #e0e0e0;
        padding: 4px 6px !important;
        margin-bottom: 10px;
    }

    .pay-bl-tabs ::deep .mud-tab {
        font-weight: 600;
        font-size: 13px;
        color: #455a64;
        text-transform: none !important;
    }

    .pay-bl-tabs ::deep .mud-tab.mud-tab-active {
        color: #118AB2 !important;
    }

    .pay-bl-tabs ::deep .mud-slider {
        background-color: #118AB2 !important;
    }

    .pay-bl-panel-sheet {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
        overflow: hidden;
        margin-bottom: 10px;
    }

    .pay-bl-invoice-inner {
        padding: 12px 14px 16px;
        min-height: 120px;
    }

    .pay-bl-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 24px;
        padding: 10px 14px 12px;
        border-top: 1px solid #e5e7eb;
        background: linear-gradient(180deg, #fafbfc 0%, #f4f7f9 100%);
        font-size: 13px;
        color: #37474f;
    }

    .pay-bl-summary strong {
        color: #118AB2;
        font-weight: 700;
    }

    .pay-bl-datagrid ::deep .mud-table-toolbar,
    .pay-bl-datagrid ::deep thead th {
        font-size: 12px;
    }
</style>

<MudTabs SliderColor="Color.Primary" Class="pay-bl-tabs">
    <MudTabPanel Text="@(isCommission ? "Input" : "Credit")" Class="custom-tab">
        <div class="pay-bl-panel-sheet">
        @if (!isMBL)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 px-3 pt-3">
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@(IsCreditCompletedLocked ? Color.Success : Color.Default)"
                         Variant="Variant.Filled">
                    @(IsCreditCompletedLocked ? "Credit đã xác nhận hoàn thành — đang khóa" : "Credit chưa xác nhận hoàn thành")
                </MudChip>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Color="@(IsCreditCompletedLocked ? Color.Warning : Color.Success)"
                           StartIcon="@(IsCreditCompletedLocked ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Verified)"
                           OnClick="ToggleCreditCompleted"
                           Disabled="@(HBLDetail == null || HBLDetail.hblID == Guid.Empty || _togglingCompleted)">
                    @(IsCreditCompletedLocked ? "Bỏ xác nhận Credit" : "Xác nhận hoàn thành Credit")
                </MudButton>
            </MudStack>
        }
        <MudDataGrid T="M_Credit" Items="@Listdata" Filterable="true" @ref="mudTable" Bordered="true"
        Class="pay-bl-datagrid"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="@IsCreditCompletedLocked" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Class="btn-compact" />
                            </MudTooltip>

                            <!-- Nút Add -->
                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="AddItem"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateCreditData)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Copy_Credit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ControlPointDuplicate"
                                Color="Color.Success"
                                Size="Size.Small"
                                @onclick="@(HBLDetail != null ? (e => CopyCredit(HBLDetail)) : null)"
                                Variant="Variant.Filled"
                                Disabled
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="Copy Credit (MBL/HBL)">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="CopyCreditFromMblHbl"
                                Variant="Variant.Filled"
                                Disabled="@(!CanMutateCreditData)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Bills"]">
                                <MudMenu Icon="@Icons.Material.Filled.Download"
                                Color="Color.Success"
                                Size="Size.Small"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                AnchorOrigin="Origin.BottomCenter"
                                TransformOrigin="Origin.TopCenter">
                                    <MudMenuItem Disabled="_processingUpload" OnClick="ExportBill">
                                        @if (_processingUpload)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Exporting...</span>
                                        }
                                        else
                                        {
                                            @Localizer["Export Credit"]
                                        }
                                    </MudMenuItem>
                                </MudMenu>
                            </MudTooltip>
                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Visibility" OnClick="@(()=>ViewItem(context.Item))" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" Disabled="@IsCreditCompletedLocked" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled="@IsCreditCompletedLocked" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.customerid" Label="@Localizer["Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" Clearable />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required
                        SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.dathanhtoan" Title="Đã Thanh Toán" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathanhtoan" @bind-Value="context.Item.dathanhtoan" @bind-Value:after="@(()=>UpdateDaThanhToanByCheckboxClick(context.Item))" Disabled="@IsCreditCompletedLocked" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.dongia" Class="text-right"
                        Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.type" Title="@Localizer["Type"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.type"
                        @bind-Value:after="@(() => ApplyQuantityByType(context.Item))"
                        Label="@Localizer["Type"]" Required
                        SearchFunc="SearchType" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.soluong"
                        Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtien" Label="@Localizer["Total Price"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.tiente" Label="@Localizer["Currency"]">
                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thue" Label="@Localizer["VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtiensauthue" Label="@Localizer["Total Price Inc. VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.tigiacredit" Title="@Localizer["Exchange Rate Credit"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>
                            <MudNumericField @bind-Value="context.Item.tigiacredit" Label="@Localizer["Exchange Rate Credit"]"
                                             Format="#,##0.##" Culture="@_en" T="double?" Class="text-right"
                                             HideSpinButtons="true" Required />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.tigiahoadondauvao" Title="@Localizer["Exchange Rate Invoice"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia_invoice(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>
                            <MudNumericField @bind-Value="context.Item.tigiahoadondauvao" Label="@Localizer["Exchange Rate Invoice"]"
                                             Format="#,##0.##" Culture="@_en" T="double?" Class="text-right"
                                             HideSpinButtons="true" Required />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.ContainerNo" Title="@Localizer["Cont. No."]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete T="string"
                                         @bind-Value="context.Item.ContainerNo"
                                         Label="@Localizer["Cont. No."]"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         Clearable
                                         Strict="false"
                                         ResetValueOnEmptyText="true"
                                         SearchFunc="SearchContainerNo" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
        @if (Listdata.Count > 0)
        {
            <div class="pay-bl-summary">
                <span>Total Inc. VAT (USD): <strong>@(Listdata.Sum(x => x.thanhtiensauthue / (x.tiente == "VND" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en))</strong></span>
                <span>Total Inc. VAT (VND): <strong>@(Listdata.Sum(x => x.thanhtiensauthue * (x.tiente == "USD" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en))</strong></span>
                <span>Total Hóa đơn (VND): <strong>@(ListdataHoaDon.Sum(x => x.thanhtiensauthue)!.Value.ToString("#,##0.##", _en))</strong></span>
            </div>
        }
        </div>
    </MudTabPanel>
    @if (!isCommission)
    {
        <MudTabPanel Text="Hóa Đơn Đầu Vào" Class="custom-tab">
            <div class="pay-bl-panel-sheet">
                <div class="pay-bl-invoice-inner">
                    @if (isMBL)
                    {
                        <HoaDonDauVao MBLDetail="MBLDetail ==  null ? new M_MBL() : MBLDetail" Customers="Customers" />
                    }
                    else
                    {
                        <HoaDonDauVao HBLDetail="HBLDetail ==  null ? new M_HBL() : HBLDetail" Customers="Customers" />
                    }
                </div>
            </div>
        </MudTabPanel>
    }
</MudTabs>
@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [Parameter] public string Type { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public bool isCommission { get; set; }
    [Parameter] public EventCallback<int> OnDataCountChanged { get; set; }
    M_Credit detail_credit;

    bool IsCreditParentMissing => isMBL
        ? (MBLDetail?.MblID ?? Guid.Empty) == Guid.Empty
        : (HBLDetail?.hblID ?? Guid.Empty) == Guid.Empty;
    bool IsCreditCompletedLocked => !isMBL && HBLDetail?.creditCompleted == true;
    bool CanMutateCreditData => !IsCreditParentMissing && !IsCreditCompletedLocked;
    bool _togglingCompleted;

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }
    bool isMBL;
    void Cancel() => MudDialog!.Cancel();
    string usr;
    List<ChargeModel> charges = new List<ChargeModel>();
    List<string> Types = new List<string>();
    protected override async Task OnInitializedAsync()
    {
        try
        {


            isMBL = MBLDetail == null ? false : true;
            if (isMBL)
            {
                if (MBLDetail.MblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng MBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            else
            {
                if (HBLDetail.hblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            charges = await supsv.GetListCharge(isCommission);
            Types = await shipsv.GetListTypeInDebitCredit();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            Conts = shipsv.GetListContainerAll();
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["PleaseSlowDown"], MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_Credit> Listdata = new List<M_Credit>();
    List<M_Container> Conts = new();
    List<M_HoaDonDauVao> ListdataHoaDon = new List<M_HoaDonDauVao>();
    M_Credit detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "MBL"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
            {
                Listdata = await shipsv.GetListCreditMBL(MBLDetail!.MblID);
                ListdataHoaDon = await shipsv.GetListHoaDonDauVaoMBL(MBLDetail!.MblID);
            }
            else
            {
                Listdata = await shipsv.GetListCreditHBL(HBLDetail!.hblID, isCommission);
                ListdataHoaDon = await shipsv.GetListHoaDonDauVaoHBL(HBLDetail!.hblID);
            }
            if (OnDataCountChanged.HasDelegate)
                await OnDataCountChanged.InvokeAsync(Listdata?.Count ?? 0);

        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Credit> mudTable;
    async Task AddItem()
    {
        if (!EnsureCanMutateCredit()) return;
        var item = new M_Credit();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }
    private async Task GetTigia(M_Credit item)
    {
        item.tigiacredit = await Vcbsv.Getexchange_cur(item.tiente);
    }

    private async Task GetTigia_invoice(M_Credit item)
    {
        item.tigiahoadondauvao = await Vcbsv.Getexchange_cur(item.tiente);
    }

    async Task DeleteItem(M_Credit item)
    {
        if (!EnsureCanMutateCredit()) return;
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["CreditApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteCreditMBL(item);
            await HistoryLogService.LogAsync(usr, "Delete Credits", "Shipment", item.creditid, "", new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_Credit item)
    {
        if (!EnsureCanMutateCredit()) return;
        if (isMBL)
            item.mblid = MBLDetail!.MblID;
        else
            item.hblid = HBLDetail!.hblID;
        item.ContainerNo = string.IsNullOrWhiteSpace(item.ContainerNo) ? null : item.ContainerNo.Trim();
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString();
        var rs = item.creditid != Guid.Empty ? await shipsv.UpdateCreditMBL(item,detail_credit) : await shipsv.CreateCreditMBL(item);
        if (isCommission)
        {
            var resultMess = await DialogService.ShowMessageBox(
               "Info",
               "Bạn có muốn thêm Refund Duty từ Commission này không?",
               yesText: "Có", cancelText: "Không");
            if (resultMess.HasValue)
            {
                var debititem = new M_Debit();
                debititem.hblid = item.hblid;
                debititem.debitno = await shipsv.GetDebitNo(HBLDetail!.mblid);
                debititem.customerid = item.customerid;
                debititem.itemid = Guid.Parse("7502A284-225B-463C-8F61-3C415FD07031"); // default DUTY CMS;
                debititem.soluong = 1;
                debititem.thue = 0;
                debititem.dongia = debititem.thanhtien = debititem.thanhtiensauthue = item.thanhtiensauthue * (getVATfromCusID(item.customerid) / 100);
                debititem.tiente = item.tiente;
                debititem.tigiadebit = item.tigiacredit;
                debititem.tigiahoandondaura = item.tigiahoadondauvao;
                debititem.ghichu = "Nhập tự động từ Commission";
                debititem.thuho = debititem.daIndebit = debititem.daXuatHoadon = debititem.khoa = debititem.InArrival = false;
                debititem.userupdate = usr;
                debititem.type = "DUTY";
                var rsduty = await shipsv.CreateDebitMBL(debititem);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
        }
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Credit Sis, int rowNumber)
    {
        if (Sis.approve.HasValue && Sis.approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_Credit> args)
    {
        if (args.Item.approve.HasValue && args.Item.approve.Value)
            CallSnackBar(Localizer["CreditApproved"], MudBlazor.Severity.Info);
        else detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_Credit> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }
    private void CalculateThanhTien(M_Credit item)
    {
        if (item.dongia.HasValue && item.soluong.HasValue)
        {
            item.thanhtien = item.dongia * item.soluong;
            CalculateThanhTienSauThue(item); // Cập nhật luôn thành tiền sau thuế khi thành tiền thay đổi
        }
        else
        {
            item.thanhtien = 0; // Hoặc null, tùy theo yêu cầu của bạn
            item.thanhtiensauthue = 0;
        }
    }

