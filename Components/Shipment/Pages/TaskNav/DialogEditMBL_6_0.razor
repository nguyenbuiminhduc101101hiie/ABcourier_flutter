@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer
@inject IDialogService DialogService
@inject BookingService bksv

<style>
    .mbl-container {
        padding: 8px 14px 0 14px;
        min-width: 1060px;
        max-width: 1240px;
    }

    .mbl-header {
        padding: 4px 2px 10px 2px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 10px;
    }

    .mbl-section {
        padding: 12px 14px;
        margin-bottom: 10px;
        border: 1px solid #e0e3eb;
        border-radius: 12px;
        background: #ffffff;
    }

    .mbl-section-title {
        font-weight: 700;
        color: #118AB2;
        font-size: 14px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mbl-section-subtitle {
        color: #6b7280;
        font-size: 12px;
        margin-left: 6px;
        font-weight: 400;
    }

    .mbl-compact .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .mbl-compact .mud-input > input,
    .mbl-compact .mud-input textarea {
        font-size: 13px !important;
    }

    .mbl-compact .mud-input-label {
        font-size: 12px !important;
        color: #4b5563 !important;
    }

    .mbl-checkbox-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(170px, 1fr));
        gap: 4px 14px;
    }

    .mbl-party-box {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px;
        background: #fcfcfd;
        height: 100%;
    }

    .mbl-party-button {
        min-width: 48px;
        height: 32px;
        padding: 4px 10px;
    }

    .mbl-dialog-actions {
        padding: 10px 18px 14px 18px !important;
        border-top: 1px solid #e5e7eb;
        width: 100%;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

        @@media(max - width: 1200px) {
            .mbl-container {
                min-width: auto;
            }

            .mbl-checkbox-grid {
                grid-template-columns: repeat(2, minmax(170px, 1fr));
            }
        }
    </style>

    <MudDialog>
        <DialogContent>
            <MudForm @ref="_form">
                @if (MissingFields.Count > 0)
                {
                    <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-2">
                        Chưa nhập: <b>@string.Join(", ", MissingFields)</b> — vẫn lưu được, nhớ bổ sung sau.
                    </MudAlert>
                }
                <MudContainer Class="mbl-container mbl-compact">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mbl-header">
                        <div>
                            <MudText Typo="Typo.h6">@FormTitle</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Update master bill, schedule, customer and party information
                            </MudText>
                        </div>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">MBL</MudText>
                            <MudText Typo="Typo.subtitle2">@Item.Mbl</MudText>
                        </MudStack>
                    </MudStack>

                    <!-- 1. Master bill information -->
                    <MudPaper Class="mbl-section" Elevation="0">
                        <MudText Class="mbl-section-title">
                            1. Master Bill Information
                            <span class="mbl-section-subtitle">MBL number, customer and current status</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="Item.Mbl"
                                              Label="@Localizer["MBL"]"
                                              Placeholder="Để trống = tự tạo khi lưu"
                                              HelperText="@(string.IsNullOrWhiteSpace(Item.Mbl) ? "Để trống: tự tạo số MBL + yyMM + số thứ tự khi lưu" : null)"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="Item.statusMBL"
                                           Label="@Localizer["Status"]"
                                           Margin="Margin.Dense">
                                    @foreach (var status in TrangThai)
                                    {
                                        <MudSelectItem Value="@status">@status</MudSelectItem>
                                    }
                            </MudSelect>
                        </MudItem>

                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="Guid"
                                                 @bind-Value="Item.CustomerID"
                                                 Label="@Localizer["Main Customer"]"
                                                 SearchFunc="SearchCustomer"
                                                 ToStringFunc="CusidtoCusCode"
                                                 MaxItems="100"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="false"
                                                 Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 2. Status flags -->
                    <MudPaper Class="mbl-section" Elevation="0">
                        <MudText Class="mbl-section-title">
                            2. Status Flags
                            <span class="mbl-section-subtitle">Approval and finance collection status</span>
                        </MudText>

                        <div class="mbl-checkbox-grid">
                            <MudCheckBox @bind-Checked="Item.Approve"
                                         Label="@Localizer["Approve"]"
                                         Disabled="@(Item.Approve.HasValue && Item.Approve.Value)"
                                         Size="Size.Small"
                                         Style="margin:0;"
                                         @bind-Checked:after="() => UpdatebyCheckboxClickAsync(Item)" />

                            <MudCheckBox @bind-Checked="Item.dathudebit"
                                         Label="@Localizer["Debit Received"]"
                                         Size="Size.Small"
                                         Style="margin:0;" />

                            <MudCheckBox @bind-Checked="Item.dachicredit"
                                         Label="@Localizer["Spent Credit"]"
                                         Size="Size.Small"
                                         Style="margin:0;" />

                            <MudCheckBox @bind-Checked="Item.dathuchidaily"
                                         Label="@Localizer["Received & Spent Agent"]"
                                         Size="Size.Small"
                                         Style="margin:0;" />
                        </div>
                    </MudPaper>

                    <!-- 3. Schedule -->
                    <MudPaper Class="mbl-section" Elevation="0">
                        <MudText Class="mbl-section-title">
                            3. Schedule
                            <span class="mbl-section-subtitle">ETA, ETD and actual delivery date</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudDatePicker @bind-Date="Item.ETA"
                                               Label="@Localizer["ETA"]"
                                               DateFormat="dd/MM/yyyy"
                                               Margin="Margin.Dense"
                                               @bind-Date:after="() => SetActualdeldateAsync(Item)" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudDatePicker @bind-Date="Item.ETD"
                                               Label="@Localizer["ETD"]"
                                               DateFormat="dd/MM/yyyy"
                                               Margin="Margin.Dense"
                                               @bind-Date:after="() => SetActualdeldateAsync(Item)" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudDatePicker @bind-Date="Item.ActualDelDate"
                                               Label="@Localizer["ActualDel Date"]"
                                               DateFormat="dd/MM/yyyy"
                                               Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 4. Booking, route & vessel -->
                    <MudPaper Class="mbl-section" Elevation="0">
                        <MudText Class="mbl-section-title">
                            4. Booking, Route &amp; Vessel
                            <span class="mbl-section-subtitle">Lấy sẵn từ booking của job — vẫn sửa được</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="3">
                                <MudTextField T="string"
                                              Value="Item.Bkno"
                                              ValueChanged="OnBookingNoChanged"
                                              Label="@Localizer["BookingNo"]"
                                              HelperText="Nhập số Booking rồi rời ô để lấy Carrier"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Sync"
                                              OnAdornmentClick="@(() => LoadCarrierFromBookingAsync(true))"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="Item.Carrier"
                                              Label="Carrier"
                                              HelperText="@_carrierHint"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="Item.Vessel"
                                              Label="@Localizer["Vessel/Fly"]"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="Item.Voy"
                                              Label="@Localizer["voyage_no"]"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="Item.Polname"
                                                 ValueChanged="OnPolnameChanged"
                                                 Label="@Localizer["POL"]"
                                                 SearchFunc="SearchPort"
                                                 CoerceValue="true"
                                                 Clearable="true"
                                                 MaxItems="100"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Value="Item.Podname"
                                                 ValueChanged="OnPodnameChanged"
                                                 Label="@Localizer["POD"]"
                                                 SearchFunc="SearchPort"
                                                 CoerceValue="true"
                                                 Clearable="true"
                                                 MaxItems="100"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudTextField Value="@($"{Item.Polcode} / {Item.Podcode}")"
                                              Label="POL / POD Code"
                                              ReadOnly="true"
                                              Disabled="true"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- 5. Parties -->
                    <MudPaper Class="mbl-section" Elevation="0">
                        <MudText Class="mbl-section-title">
                            5. Parties
                            <span class="mbl-section-subtitle">Shipper, consignee and notify information</span>
                        </MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <div class="mbl-party-box">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="search_shipper"
                                                     Label="@Localizer["Shipper"]"
                                                     SearchFunc="SearchShipper"
                                                     MaxItems="50"
                                                     Clearable="true"
                                                     AutoFocus="false"
                                                     Margin="Margin.Dense" />

                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="mbl-party-button"
                                                   OnClick="() => Get_linkshipper()">
                                            Use
                                        </MudButton>

                                        <MudTextField @bind-Value="Item.Shipper"
                                                      Label="@Localizer["Shipper"]"
                                                      Lines="5"
                                                      HelperText="@(string.IsNullOrWhiteSpace(Item.Shipper) ? "Nên nhập" : null)"
                                                      Margin="Margin.Dense" />
                                    </MudStack>
                                </div>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <div class="mbl-party-box">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="search_Consignee"
                                                     Label="@Localizer["Consignee"]"
                                                     SearchFunc="SearchConsignee"
                                                     MaxItems="50"
                                                     Clearable="true"
                                                     AutoFocus="false"
                                                     Margin="Margin.Dense" />

                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="mbl-party-button"
                                                   OnClick="() => Get_linkConsignee()">
                                            Use
                                        </MudButton>

                                        <MudTextField @bind-Value="Item.Consignee"
                                                      Label="@Localizer["Consignee"]"
                                                      Lines="5"
                                                      HelperText="@(string.IsNullOrWhiteSpace(Item.Consignee) ? "Nên nhập" : null)"
                                                      Margin="Margin.Dense" />
                                    </MudStack>
                                </div>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <div class="mbl-party-box">
                                    <MudAutocomplete T="string"
                                                     @bind-Value="search_Notify"
                                                     Label="@Localizer["Notify"]"
                                                     SearchFunc="SearchNotify"
                                                     MaxItems="50"
                                                     Clearable="true"
                                                     AutoFocus="false"
                                                     Margin="Margin.Dense" />

                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class="mbl-party-button"
                                                   OnClick="() => Get_linkNotify()">
                                            Use
                                        </MudButton>

                                        <MudTextField @bind-Value="Item.Notify1"
                                                      Label="@Localizer["Notify"]"
                                                      Lines="5"
                                                      HelperText="@(string.IsNullOrWhiteSpace(Item.Notify1) ? "Nên nhập" : null)"
                                                      Margin="Margin.Dense" />
                                    </MudStack>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudContainer>
            </MudForm>
        </DialogContent>

        <DialogActions>
            <div class="mbl-dialog-actions">
                <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            </div>
        </DialogActions>
    </MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; } = default!;

    private MudForm? _form;

    [Parameter] public M_MBL Item { get; set; } = default!;
    [Parameter] public string FormTitle { get; set; } = "Edit MBL";
    [Parameter] public List<M_Customer>? Customers { get; set; } = new();
    [Parameter] public List<string> TrangThai { get; set; } = new();
    [Parameter] public List<PortModel> Ports { get; set; } = new();

    [Parameter] public Func<M_MBL, Task> SetActualdeldateAsync { get; set; } = default!;
    [Parameter] public Func<M_MBL, Task> UpdatebyCheckboxClickAsync { get; set; } = default!;

    string ShipperLabel => Localizer["Shipper"];
    string ConsigneeLabel => Localizer["Consignee"];
    string NotifyLabel => Localizer["Notify"];

    List<string> Shippers = new();
    List<string> Consignees = new();
    List<string> Notify = new();

    string search_shipper = "";
    string search_Consignee = "";
    string search_Notify = "";

    protected override void OnParametersSet()
    {
        if (Customers == null || Customers.Count == 0) return;

        Shippers = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();

        Consignees = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();

        Notify = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();
    }

    void Cancel() => MudDialog.Cancel();

    /// <summary>Các ô nên có nhưng không bắt buộc: chỉ cảnh báo, người dùng vẫn lưu được.</summary>
    private List<string> MissingFields
    {
        get
        {
            var list = new List<string>();
            if (Item.CustomerID == Guid.Empty) list.Add(Localizer["Main Customer"]);
            if (string.IsNullOrWhiteSpace(Item.Shipper)) list.Add(ShipperLabel);
            if (string.IsNullOrWhiteSpace(Item.Consignee)) list.Add(ConsigneeLabel);
            if (string.IsNullOrWhiteSpace(Item.Notify1)) list.Add(NotifyLabel);
            return list;
        }
    }

    private async Task Submit()
    {
        if (_form == null)
            return;

        // Còn thiếu thông tin → hỏi lại 1 lần, chọn "Vẫn lưu" là lưu (không chặn).
        var missing = MissingFields;
        if (missing.Count > 0)
        {
            var ok = await DialogService.ShowMessageBox(
                "Thiếu thông tin",
                (MarkupString)($"Chưa nhập: <b>{System.Net.WebUtility.HtmlEncode(string.Join(", ", missing))}</b>.<br/>Bạn vẫn muốn lưu MBL?" +
                    (string.IsNullOrWhiteSpace(Item.Mbl) ? "<br/>Số MBL để trống sẽ được tự tạo." : "")),
                yesText: "Vẫn lưu",
                cancelText: "Quay lại nhập");
            if (ok != true)
                return;
        }

        MudDialog.Close(Item);
    }

    /// <summary>Hiển thị khách hàng dạng "Mã - Tên".</summary>
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    string? _carrierHint;

    /// <summary>Đổi số Booking: lấy Carrier từ Booking đó.</summary>
    private async Task OnBookingNoChanged(string? value)
    {
        var changed = !string.Equals(Item.Bkno?.Trim(), value?.Trim(), StringComparison.OrdinalIgnoreCase);
        Item.Bkno = value;
        if (changed)
            await LoadCarrierFromBookingAsync(overwrite: true);
    }

    /// <summary>Tra Booking theo số Booking của MBL và điền Carrier.</summary>
    private async Task LoadCarrierFromBookingAsync(bool overwrite)
    {
        var bookingNo = Item.Bkno?.Trim();
        if (string.IsNullOrWhiteSpace(bookingNo))
        {
            _carrierHint = null;
            return;
        }
        var bk = await bksv.GetDetailBookingFromBookingNo(bookingNo);
        if (bk == null)
        {
            _carrierHint = $"Không tìm thấy Booking {bookingNo}";
        }
        else if (string.IsNullOrWhiteSpace(bk.Carrier))
        {
            _carrierHint = $"Booking {bookingNo} chưa có Carrier";
        }
        else
        {
            if (overwrite || string.IsNullOrWhiteSpace(Item.Carrier))
                Item.Carrier = bk.Carrier.Trim();
            _carrierHint = $"Lấy từ Booking {bookingNo}";
        }
        StateHasChanged();
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        await Task.Delay(1);
        if (Customers == null) return Array.Empty<Guid>();

        IEnumerable<M_Customer> query = Customers;
        if (!string.IsNullOrWhiteSpace(text))
        {
            query = Customers.Where(x =>
                x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase));
        }

        var ids = query.Select(x => x.Customer_ID).Distinct().ToList();
        if (Item.CustomerID != Guid.Empty && !ids.Contains(Item.CustomerID))
            ids.Insert(0, Item.CustomerID);
        return ids;
    }

    private async Task<IEnumerable<string>> SearchShipper(string text)
    {
        await Task.Delay(10);
        if (string.IsNullOrWhiteSpace(text)) return Shippers;
        return Shippers.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchConsignee(string text)
    {
        await Task.Delay(10);
        if (string.IsNullOrWhiteSpace(text)) return Consignees;
        return Consignees.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchNotify(string text)
    {
        await Task.Delay(10);
        if (string.IsNullOrWhiteSpace(text)) return Notify;
        return Notify.Where(x => !string.IsNullOrWhiteSpace(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private Task Get_linkshipper()
    {
        Item.Shipper = search_shipper;
        return Task.CompletedTask;
    }

    private Task Get_linkConsignee()
    {
        Item.Consignee = search_Consignee;
        return Task.CompletedTask;
    }

    private Task Get_linkNotify()
    {
        Item.Notify1 = search_Notify;
        return Task.CompletedTask;
    }

    private async Task<IEnumerable<string>> SearchPort(string text)
    {
        await Task.Delay(1);
        var names = Ports
            .Where(x => !string.IsNullOrWhiteSpace(x.PORT))
            .Select(x => x.PORT!)
            .Distinct();

        if (string.IsNullOrWhiteSpace(text))
            return names;

        return names.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private string? LookupPortCode(string? portName)
    {
        if (string.IsNullOrWhiteSpace(portName))
            return null;

        return Ports.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.PORT)
            && x.PORT!.Equals(portName.Trim(), StringComparison.OrdinalIgnoreCase))?.PORT_CODE;
    }

    private Task OnPolnameChanged(string? value)
    {
        Item.Polname = value;
        Item.Polcode = LookupPortCode(value);
        return Task.CompletedTask;
    }

    private Task OnPodnameChanged(string? value)
    {
        Item.Podname = value;
        Item.Podcode = LookupPortCode(value);
        return Task.CompletedTask;
    }
}
