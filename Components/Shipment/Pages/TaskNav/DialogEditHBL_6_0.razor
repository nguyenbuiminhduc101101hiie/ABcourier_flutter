@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@inject IStringLocalizer<SharedResource> Localizer
@inject BookingService bksv
@inject ISnackbar Snackbar
@inject IDbContextFactory<AppDbContext> DbFactory


<style>
    .hbl-container {
        padding: 8px 14px 0 14px;
        min-width: 1120px;
        max-width: 1280px;
    }

    .hbl-header {
        padding: 4px 2px 10px 2px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 10px;
    }

    .hbl-section {
        padding: 12px 14px;
        margin-bottom: 10px;
        border: 1px solid #e0e3eb;
        border-radius: 12px;
        background: #ffffff;
    }

    .hbl-section-title {
        font-weight: 700;
        color: #118AB2;
        font-size: 14px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .hbl-section-subtitle {
        color: #6b7280;
        font-size: 12px;
        margin-left: 6px;
        font-weight: 400;
    }

    .hbl-compact .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .hbl-compact .mud-input > input,
    .hbl-compact .mud-input textarea {
        font-size: 13px !important;
    }

    .hbl-compact .mud-input-label {
        font-size: 12px !important;
        color: #4b5563 !important;
    }

    .hbl-number input,
    .hbl-number .mud-input-slot {
        text-align: right !important;
        font-weight: 600;
    }

    .hbl-finance-box {
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        border-radius: 10px;
        padding: 8px 10px;
        min-height: 58px;
    }

    .hbl-finance-label {
        font-size: 11px;
        color: #6b7280;
        margin-bottom: 2px;
    }

    .hbl-finance-value {
        font-size: 17px;
        font-weight: 700;
        color: #111827;
        text-align: right;
    }

    .hbl-profit-value .mud-input-slot {
        text-align: right !important;
        font-weight: 700;
    }

    .hbl-checkbox-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(150px, 1fr));
        gap: 4px 14px;
    }

    .hbl-checkbox-grid-six {
        display: grid;
        grid-template-columns: repeat(6, minmax(120px, 1fr));
        gap: 4px 12px;
    }

    .hbl-party-box {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 10px;
        background: #fcfcfd;
    }

    .hbl-party-button {
        min-width: 48px;
        height: 32px;
        padding: 4px 10px;
    }

    .hbl-dialog-actions {
        padding: 10px 18px 14px 18px !important;
        border-top: 1px solid #e5e7eb;
    }

        @@media(max - width: 1200px) {
            .hbl-container {
                min-width: auto;
            }

            .hbl-checkbox-grid {
                grid-template-columns: repeat(3, minmax(150px, 1fr));
            }

            .hbl-checkbox-grid-six {
                grid-template-columns: repeat(3, minmax(120px, 1fr));
            }
        }
    </style>

    <MudDialog>
        <DialogContent>
            <MudContainer Class="hbl-container hbl-compact">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="hbl-header">
                    <div>
                        <MudText Typo="Typo.h6">Edit HBL</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Update shipment, finance, release status and party information
                        </MudText>
                    </div>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">HBL</MudText>
                        <MudText Typo="Typo.subtitle2">@Item.hbl</MudText>
                    </MudStack>
                </MudStack>

                <!-- 1. Document information -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        1. Document Information
                        <span class="hbl-section-subtitle">HBL number, booking and release details</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudTextField @bind-Value="Item.hbl"
                                          Immediate="true"
                                          Label="@Localizer["HBL"]"
                                          Required="true"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Selected Date Get HBL"]"
                                           DateChanged="OnHblRefDateChanged"
                                           ImmediateText="true"
                                           DateFormat="dd/MM/yyyy"
                                           Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete Class="pl-0"
                                             T="string"
                                             @bind-Value="Item.bkno"
                                             @bind-Value:after="OnBknoChangedAsync"
                                             For="@(() => Item.bkno)"
                                             Label="@Localizer["Bkno"]"
                                             SearchFunc="SearchBookingNo"
                                             Immediate="true"
                                             CoerceText="true"
                                             Clearable="true"
                                             MaxItems="200"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudCheckBox @bind-Checked="Item.release"
                                         Label="@Localizer["Release"]"
                                         Disabled="@(CurrentUserRole != AccountRole)"
                                         Size="Size.Small"
                                         Style="margin-top:18px;" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Item.releaseNote"
                                          Label="@Localizer["Release Note"]"
                                          Disabled="@(CurrentUserRole != AccountRole)"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- 2. Finance summary -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        2. Finance Summary
                        <span class="hbl-section-subtitle">Debit, credit and profit calculation</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <div class="hbl-finance-box">
                                <div class="hbl-finance-label">@Localizer["Debit"]</div>
                                <div class="hbl-finance-value">@FormatNumber(TDebit_(Item.hblID))</div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <div class="hbl-finance-box">
                                <div class="hbl-finance-label">@Localizer["Credit"]</div>
                                <div class="hbl-finance-value">@FormatNumber(TCredit_(Item.hblID))</div>
                            </div>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.subtitle2">@Localizer["Profit"]</MudText>
                                <MudRadioGroup @bind-Value="chkUSD" Dense="true">
                                    <MudRadio Value="true" Size="Size.Small" Color="Color.Inherit">USD</MudRadio>
                                    <MudRadio Value="false" Size="Size.Small" Color="Color.Inherit">VND</MudRadio>
                                </MudRadioGroup>
                                <MudCheckBox @bind-Checked="chkVAT"
                                             Label="VAT"
                                             Color="Color.Inherit"
                                             Size="Size.Small"
                                             Style="margin:0;" />
                                <MudTextField Value="@FormatNumber(TProfit_(Item.hblID))"
                                              Disabled="true"
                                              Margin="Margin.Dense"
                                              Class="hbl-profit-value"
                                              Style="max-width:180px;" />
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- 3. Status flags -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        3. Status Flags
                        <span class="hbl-section-subtitle">Operational and payment tracking</span>
                    </MudText>

                    <div class="hbl-checkbox-grid">
                        <MudCheckBox @bind-Checked="Item.approve"
                                     Label="@Localizer["Approve"]"
                                     Disabled="@(Item.approve.HasValue && Item.approve.Value)"
                                     Size="Size.Small"
                                     Style="margin:0;"
                                     @bind-Checked:after="() => UpdatebyCheckboxClickAsync(Item)" />

                        <MudCheckBox @bind-Checked="Item.issueinvoice"
                                     Label="@Localizer["Invoice Issued"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.dathudebit"
                                     Label="@Localizer["Debit Received"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.dachicredit"
                                     Label="@Localizer["Spent Credit"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.dathuchidaily"
                                     Label="@Localizer["Received & Spent Agent"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />
                    </div>

                    <MudDivider Class="my-2" />

                    <div class="hbl-checkbox-grid-six">
                        <MudCheckBox @bind-Checked="Item.Required"
                                     Label="@Localizer["ORIGINAL"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.Surrendered"
                                     Label="@Localizer["Surrendered"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.TelexRelease"
                                     Label="@Localizer["Seaway B/L"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.Prepaid"
                                     Label="@Localizer["Prepaid"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.Collect"
                                     Label="@Localizer["Collect"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />

                        <MudCheckBox @bind-Checked="Item.freight"
                                     Label="@Localizer["Freight"]"
                                     Size="Size.Small"
                                     Style="margin:0;" />
                    </div>
                </MudPaper>

                <!-- 4. Schedule and operations -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        4. Schedule & Operations
                        <span class="hbl-section-subtitle">Dates, customer, warehouse and assigned staff</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="Item.ETA"
                                           Label="@Localizer["ETA"]"
                                           DateFormat="dd/MM/yyyy"
                                           @bind-Date:after="() => SetActualdeldateAsync(Item)"
                                           Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="Item.ETD"
                                           Label="@Localizer["ETD"]"
                                           DateFormat="dd/MM/yyyy"
                                           @bind-Date:after="() => SetActualdeldateAsync(Item)"
                                           Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="Item.ActualDelDate"
                                           Label="@Localizer["ActualDel Date"]"
                                           DateFormat="dd/MM/yyyy"
                                           Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker @bind-Date="Item.datereport"
                                           Label="@Localizer["Date Report"]"
                                           DateFormat="dd/MM/yyyy"
                                           Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete @bind-Value="Item.CustomerID"
                                             Label="@Localizer["Main Customer"]"
                                             Required="true"
                                             SearchFunc="SearchCustomer"
                                             ToStringFunc="CusidtoCusCode"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete @bind-Value="Item.AgentID"
                                             Label="@Localizer["Agent"]"
                                             Required="true"
                                             SearchFunc="SearchAgent"
                                             ToStringFunc="AgentidtoName"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete @bind-Value="Item.Air_wareHouse"
                                             Label="@Localizer["Warehouse"]"
                                             Required="true"
                                             SearchFunc="SearchWHouse"
                                             CoerceValue="true"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudAutocomplete @bind-Value="Item.Air_type"
                                             Label="@Localizer["LoaiHang"]"
                                             Required="true"
                                             SearchFunc="SearchCFS"
                                             CoerceValue="true"
                                             Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="Item.statusHBL" Label="@Localizer["Status"]" Margin="Margin.Dense">
                                @foreach (var item in TrangThai)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="Item.SaleName" Label="@Localizer["Sale Name"]" Required="true" Margin="Margin.Dense">
                                @foreach (var item in SaleNames)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="Item.OPS" Label="@Localizer["OPS"]" Required="true" Margin="Margin.Dense">
                                @foreach (var item in ListUsers)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="Item.DOC" Label="@Localizer["DOC"]" Required="true" Margin="Margin.Dense">
                                @foreach (var item in ListUsers)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

                <!-- 5. Parties -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        5. Parties
                        <span class="hbl-section-subtitle">Search customer information, then apply it into the text box</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <div class="hbl-party-box">
                                <MudAutocomplete T="string"
                                                 @bind-Value="search_shipper"
                                                 Label="@Localizer["Shipper"]"
                                                 SearchFunc="SearchShipper"
                                                 MaxItems="50"
                                                 Clearable="true"
                                                 AutoFocus="false"
                                                 Margin="Margin.Dense" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Class="hbl-party-button my-1"
                                           OnClick="() => Get_linkshipper()">
                                    Use
                                </MudButton>
                                <MudTextField @bind-Value="Item.shipper"
                                              Label="@Localizer["Shipper"]"
                                              Lines="4"
                                              Required="true"
                                              Margin="Margin.Dense" />
                            </div>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <div class="hbl-party-box">
                                <MudAutocomplete T="string"
                                                 @bind-Value="search_Consignee"
                                                 Label="@Localizer["Consignee"]"
                                                 SearchFunc="SearchConsignee"
                                                 MaxItems="50"
                                                 Clearable="true"
                                                 AutoFocus="false"
                                                 Margin="Margin.Dense" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Class="hbl-party-button my-1"
                                           OnClick="() => Get_linkConsignee()">
                                    Use
                                </MudButton>
                                <MudTextField @bind-Value="Item.consignee"
                                              Label="@Localizer["Consignee"]"
                                              Lines="4"
                                              Required="true"
                                              Margin="Margin.Dense" />
                            </div>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <div class="hbl-party-box">
                                <MudAutocomplete T="string"
                                                 @bind-Value="search_Notify"
                                                 Label="@Localizer["Notify"]"
                                                 SearchFunc="SearchNotify"
                                                 Clearable="true"
                                                 AutoFocus="false"
                                                 Margin="Margin.Dense" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Class="hbl-party-button my-1"
                                           OnClick="() => Get_linkNotify()">
                                    Use
                                </MudButton>
                                <MudTextField @bind-Value="Item.notify1"
                                              Label="@Localizer["Notify"]"
                                              Lines="4"
                                              Required="true"
                                              Margin="Margin.Dense" />
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- 6. Remarks and free time -->
                <MudPaper Class="hbl-section" Elevation="0">
                    <MudText Class="hbl-section-title">
                        6. Remarks & Free Time
                        <span class="hbl-section-subtitle">Internal remarks and DEM/DET information</span>
                    </MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Item.remarks"
                                          Label="@Localizer["Remarks"]"
                                          Lines="3"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="double?"
                                             @bind-Value="Item.Dem"
                                             @bind-Value:after="RecalcCombine"
                                             Label="@Localizer["Dem"]"
                                             Clearable="true"
                                             Margin="Margin.Dense"
                                             Class="hbl-number" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="double?"
                                             @bind-Value="Item.Det"
                                             @bind-Value:after="RecalcCombine"
                                             Label="@Localizer["Det"]"
                                             Clearable="true"
                                             Margin="Margin.Dense"
                                             Class="hbl-number" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="double?"
                                             @bind-Value="Item.STO"
                                             Label="@Localizer["Sto"]"
                                             Clearable="true"
                                             Margin="Margin.Dense"
                                             Class="hbl-number" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="double?"
                                             Value="Item.Combine"
                                             Label="@Localizer["Combine"]"
                                             ReadOnly="true"
                                             Margin="Margin.Dense"
                                             Class="hbl-number" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudContainer>
        </DialogContent>

        <DialogActions>
            <div class="hbl-dialog-actions">
                <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            </div>
        </DialogActions>
    </MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public M_HBL Item { get; set; } = default!;

    [Parameter] public List<M_Customer> Customers { get; set; } = new();
    [Parameter] public List<string?> CFS { get; set; } = new();
    [Parameter] public List<string> Warehouse { get; set; } = new();
    [Parameter] public List<string> SaleNames { get; set; } = new();
    [Parameter] public List<string> ListUsers { get; set; } = new();
    [Parameter] public List<string> TrangThai { get; set; } = new();

    [Parameter] public List<M_Debit> ListDebit { get; set; } = new();
    [Parameter] public List<M_Credit> ListCredit { get; set; } = new();

    [Parameter] public string CurrentUserRole { get; set; } = "";

    [Parameter] public Func<M_HBL, Task> SetActualdeldateAsync { get; set; } = default!;
    [Parameter] public Func<M_HBL, DateTime, Task> UpdateHBLNoAsync { get; set; } = default!;
    [Parameter] public Func<M_HBL, Task> UpdatebyCheckboxClickAsync { get; set; } = default!;

    const string AccountRole = "ACCOUNT";

    string ShipperLabel => Localizer["Shipper"];
    string ConsigneeLabel => Localizer["Consignee"];
    string NotifyLabel => Localizer["Notify"];

    bool chkUSD = false;
    bool chkVAT = false;

    private List<string> BookingNoList { get; set; } = new();
    private string _lastBknoValidated = string.Empty;
    private string _lastBknoWarned = string.Empty;

    List<string> Shippers = new();
    List<string> Consignees = new();
    List<string> Notify = new();

    string search_shipper = "";
    string search_Consignee = "";
    string search_Notify = "";

    protected override async Task OnInitializedAsync()
    {
        RecalcCombine();

        BookingNoList = (await bksv.GetListSBooking() ?? new List<Models.Booking>())
            .Select(x => x.BookingNo)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();
    }

    private void RecalcCombine()
    {
        if (Item is null) return;
        Item.Combine = (Item.Dem ?? 0d) + (Item.Det ?? 0d);
    }

    protected override void OnParametersSet()
    {
        if (Customers == null || Customers.Count == 0) return;

        // Same format as the page: EnglishName + address in VND + phone + fax.
        Shippers = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();

        Consignees = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();

        Notify = Customers
            .Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax)
            .Distinct()
            .ToList();
    }

    private async Task<IEnumerable<string>> SearchBookingNo(string value)
    {
        await Task.Delay(1);

        if (BookingNoList == null || BookingNoList.Count == 0)
            return Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(value))
            return BookingNoList;

        return BookingNoList.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task OnBknoChangedAsync()
    {
        var bkno = Item?.bkno?.Trim();
        if (string.IsNullOrWhiteSpace(bkno))
            return;

        // Prevent repeated queries/warnings when value doesn't change.
        if (string.Equals(_lastBknoValidated, bkno, StringComparison.OrdinalIgnoreCase))
            return;

        _lastBknoValidated = bkno;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Check duplicate BKNO on other HBLs (exclude current HBL row).
            var matches = await db.HBL
                .AsNoTracking()
                .Where(x => x.bkno != null
                            && x.bkno.Trim() == bkno
                            && x.hblID != Item.hblID)
                .OrderByDescending(x => x.datereport)
                .Select(x => x.hbl)
                .Take(10)
                .ToListAsync();

            if (matches.Count == 0)
                return;

            // Don't spam same warning repeatedly.
            if (string.Equals(_lastBknoWarned, bkno, StringComparison.OrdinalIgnoreCase))
                return;

            _lastBknoWarned = bkno;

            var hblList = matches
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!.Trim())
                .Distinct()
                .ToList();

            var hblDisplay = hblList.Count == 0 ? "(không có HBL No.)" : string.Join(", ", hblList);

            Snackbar.Add($"BookingNo '{bkno}' đã tồn tại ở HBL: {hblDisplay}", MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            // Non-blocking: still allow user to proceed.
            Snackbar.Add($"Không kiểm tra được BKNO trùng: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    void Cancel() => MudDialog.Cancel();

    void Submit()
