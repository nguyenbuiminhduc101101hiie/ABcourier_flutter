    double? TProfit_(Guid id)
    {
        if (id == Guid.Empty) return 0;
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();

        var totaldebit = debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD" ? tien : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit);
            }
            return x.tiente == "VND" ? tien : tien * x.tigiadebit;
        });

        var totalcredit = credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD" ? tien : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit);
            }
            return x.tiente == "VND" ? tien : tien * x.tigiacredit;
        });

        return totaldebit - totalcredit;
    }

