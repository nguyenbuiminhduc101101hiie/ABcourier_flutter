@code {
    [Parameter] public M_Job? JobDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    M_MBL detail_mbl;
    string search_shipper = "";
    string search_Consignee = "";
    string search_Notify = "";

    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
    string usr;
    List<PortModel> Ports = new List<PortModel>();
    List<M_VesselSpace> VesselSpaces = new List<M_VesselSpace>();
    List<string> Shippers = new List<string>();
    List<string> Consignees = new List<string>();
    List<string> Notify1 = new List<string>();
    List<string> Voys = new List<string>();

    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<string> SaleNames = new List<string>();
    string type = "";
    string salecode_injob = "";
    protected async override Task OnInitializedAsync()
    {
        try
        {
            var tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude == "MBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            userdetail = asv.GetUserDetail();
            VesselSpaces = await supsv.GetListVesselSpace();
            Ports = await supsv.GetListPort();
            SaleNames = await supsv.GetListSale();
            Shippers = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Consignees = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Voys = VesselSpaces.Select(x => x.Voy).ToList()!;
            type = JobDetail!.Loai!; // Air Sea Truck HQ
            salecode_injob = await shipsv.GetsaleinJob_byJobId(JobDetail.JobID);
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            await Refresh();
        }
        catch(Exception ex)
        {
            CallSnackBar(string.Format(Localizer["RenderError"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    bool _loading = false;
    List<M_MBL> Listdata = new List<M_MBL>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            Mbldetail = null!;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            Listdata = await shipsv.GetListMBL(JobDetail!.JobID);
            if (Listdata.Count > 0)
                Mbldetail = Listdata[0];
        }
        finally
        {
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
        if (mudTable != null && Listdata.Count > 0)
            await mudTable.SetSelectedItemAsync(Listdata[0]);
    }
    MudDataGrid<M_MBL> mudTable;
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "MBL"))
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_MBL
        {
            Jobid = JobDetail!.JobID,
            SaleName = salecode_injob
        };
        await ApplyBookingInfoAsync(item);
        var addTitle = $"{Localizer["Add"]} MBL";
        await ShowMblEditDialogAsync(item, addTitle, checkApproved: false);
    }

    // Job có số booking thì lấy tuyến, tàu và lịch tàu từ booking đó điền sẵn cho MBL mới.
    async Task ApplyBookingInfoAsync(M_MBL item)
    {
        var bookingNo = JobDetail?.BookingNo?.Trim();
        if (string.IsNullOrWhiteSpace(bookingNo))
            return;

        var bk = await bksv.GetDetailBookingFromBookingNo(bookingNo);
        if (bk == null)
        {
            CallSnackBar($"Không tìm thấy booking {bookingNo} để lấy dữ liệu.", MudBlazor.Severity.Info);
            return;
        }

        item.Bkno = bookingNo;

        var (polName, polCode) = ResolveBookingPort(bk.hano_POL, bk.hano_POLCode);
        item.Polname = polName;
        item.Polcode = polCode;

        var (podName, podCode) = ResolveBookingPort(bk.hano_POD, bk.hano_PODCode);
        item.Podname = podName;
        item.Podcode = podCode;

        item.Vessel = bk.Vessel;
        item.Voy = bk.VoyNo;
        item.ETD = bk.ETD;
        item.ETA = bk.ETA;

        var customerId = bk.MaincusBk_Id_ ?? bk.Customer_ID;
        if ((!customerId.HasValue || customerId.Value == Guid.Empty)
            && Guid.TryParse(bk.MaincusBk_Id, out var parsedCustomerId)
            && parsedCustomerId != Guid.Empty)
        {
            customerId = parsedCustomerId;
        }

        if (customerId.HasValue && customerId.Value != Guid.Empty)
            item.CustomerID = customerId.Value;

        if (!string.IsNullOrEmpty(JobDetail?.Loai))
            await SetActualdeldate(item);
    }

    // Booking lưu cảng dạng "TÊN_CODE"; tách ra rồi đối chiếu danh mục cảng để lấy đúng tên và code.
    (string? Name, string? Code) ResolveBookingPort(string? bookingPort, string? bookingPortCode)
    {
        var code = string.IsNullOrWhiteSpace(bookingPortCode) ? null : bookingPortCode.Trim();

        if (string.IsNullOrWhiteSpace(bookingPort))
            return (null, code);

        var raw = bookingPort.Trim();
        var name = raw;

        var separator = raw.LastIndexOf('_');
        if (separator > 0)
        {
            name = raw.Substring(0, separator).Trim();
            var parsedCode = raw.Substring(separator + 1).Trim();
            if (!string.IsNullOrWhiteSpace(parsedCode))
                code = parsedCode;
        }

        var port = Ports.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.PORT)
                       && x.PORT!.Equals(name, StringComparison.OrdinalIgnoreCase))
                   ?? Ports.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.PORT_CODE)
                       && x.PORT_CODE!.Equals(code, StringComparison.OrdinalIgnoreCase));

        return port != null ? (port.PORT, port.PORT_CODE) : (name, code);
    }

    async Task DeleteItem(M_MBL item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "MBL"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve.HasValue && item.Approve.Value)
        {
            CallSnackBar(Localizer["MblApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteMBLDetail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_MBL item)
    {
        item.Shipper = (item.Shipper ?? string.Empty).Replace("\r\n", "\n");
        item.Jobid = JobDetail!.JobID;
        // Để trống số MBL → tự tạo (MBL + yyMM + số thứ tự), sửa lại được sau khi hãng tàu cấp số thật.
        if (string.IsNullOrWhiteSpace(item.Mbl))
        {
            item.Mbl = await shipsv.GenerateMblNoAsync();
            CallSnackBar($"Đã tự tạo số MBL {item.Mbl}", MudBlazor.Severity.Info);
        }
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        var rs = item.MblID != Guid.Empty ? await shipsv.UpdateMBLDetail(item, detail_mbl) : await shipsv.CreateMBLDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_MBL Sis, int rowNumber)
    {
        if (Sis.Approve.HasValue && Sis.Approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
        // if (selectedRowNumber == rowNumber)
        // {
