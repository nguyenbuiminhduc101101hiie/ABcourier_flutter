    {
        if (args.Item.Approve.HasValue && args.Item.Approve.Value)
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
        else Mbldetail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_MBL> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    private async Task OpenDialog()
    {
        if (Mbldetail == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }

        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };
        var parameters = new DialogParameters<DetailDialogHBL_6_0> { { x => x.detail, Mbldetail}, { x=>x.Customers, Customers} };
        var dialog = await DialogService.ShowAsync<DetailDialogHBL_6_0>($"HBL Job NO: {JobDetail!.JobNo} MBL NO: {Mbldetail.Mbl}", parameters, optionsdialog);
    }
    private async Task OpenImportDialog(M_MBL item)
    {
        if (item.Approve.HasValue && item.Approve.Value)
        {
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
            return;
        }
        detail_mbl = JsonSerializer.Deserialize<M_MBL>(JsonSerializer.Serialize(item));
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.ExtraLarge,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true,
            };
        if (type == "SI" || type == "SE")
        {
            var parameters = new DialogParameters<Importbill> { { x => x.MBLDetail, item } };
            var dialog = await DialogService.ShowAsync<Importbill>("Master Bill", parameters, optionsdialog);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                var data = (M_MBL)result.Data;
                data.UserUpdate = usr;
                var rs = await shipsv.UpdateMBLDetail(data, detail_mbl);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                // await HandleRefresh();
            }
        }
        else if (type == "AI" || type == "AE")
        {
            var parameters = new DialogParameters<FormMBLAir> { { x => x.MBLdetail, item } };
            var dialog = await DialogService.ShowAsync<FormMBLAir>("Master Bill Air", parameters, optionsdialog);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                var data = (M_MBL)result.Data;
                data.UserUpdate = usr;
                var rs = await shipsv.UpdateMBLDetail(data, detail_mbl);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                // await HandleRefresh();
            }
        }
        else
        {
            CallSnackBar(Localizer["NoEditFormForJobType"], MudBlazor.Severity.Warning);
        }
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }

    string formatDate(DateTime? date)
    {
        if (date == null)
            return string.Empty;
        return date.Value.ToString("dd/MM/yyyy");
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x=>x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => x.SearchKey().Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x=>x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchConsignee(string? text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Consignees;
            }
            // MBL.Porname = mst_Consignee;
            return Consignees.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchShipper(string? text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Shippers;
            }
            // MBL.Porname = mst_Consignee;
            return Shippers.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> SearchNotify(string? text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Consignees;
            }
            // MBL.Porname = mst_Consignee;
            return Consignees.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

