    async Task UpdatebyCheckboxClick(M_MBL item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "MBL"))
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        item.UserUpdate = usr;
        var rs = await shipsv.UpdateMBLDetail_approve(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task ShowMblEditDialogAsync(M_MBL sourceItem, string title, bool checkApproved = true)
    {
        if (checkApproved && sourceItem.Approve.HasValue && sourceItem.Approve.Value)
        {
            CallSnackBar(Localizer["MblApproved"], MudBlazor.Severity.Warning);
            return;
        }

        // Use copies so Cancel doesn't mutate the page's data.
        detail_mbl = sourceItem.DeepCopy();
        var editModel = sourceItem.DeepCopy();

        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };

        var dialog = await DialogService.ShowAsync<DialogEditMBL_6_0>(
            title,
            new DialogParameters<DialogEditMBL_6_0>
            {
                { x => x.Item, editModel },
                { x => x.FormTitle, title },
                { x => x.Customers, Customers ?? new List<M_Customer>() },
                { x => x.TrangThai, trangthais ?? new List<string>() },
                { x => x.Ports, Ports ?? new List<PortModel>() },
                { x => x.SetActualdeldateAsync, SetActualdeldate },
                { x => x.UpdatebyCheckboxClickAsync, UpdatebyCheckboxClick }
            },
            optionsdialog);

        var result = await dialog.Result;
        if (result.Canceled)
            return;

        var updated = (M_MBL)(result.Data ?? editModel);
        await CommittedItem(updated);
    }

    async Task TryStartEditing(M_MBL item)
    {
        var editTitle = $"{Localizer["Edit"]} MBL";
        await ShowMblEditDialogAsync(item, editTitle);
    }

    private bool _processingUploadManifest = false;
    async Task ExportManifestReport()
    {
        try
        {
            if (Mbldetail == null)
            {
                CallSnackBar(Localizer["SelectOneRowMbl"], MudBlazor.Severity.Warning);
                return;
            }
            _processingUploadManifest = true;
            StateHasChanged();
            await Task.Delay(1);
            var rs = await rsv.Emanifest(Mbldetail);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadManifest = false;
        }
    }
