    private Func<M_Job, bool> _quickFilter => x =>
    {
        // 1. Kiểm tra theo loại (checkbox)
        bool matchLoai = !chkSI && !chkSE && !chkAI && !chkAE && !chkTruck && !chkCustoms && !chkWH
                         || (chkSI && x.Loai?.Equals("SI", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkSE && x.Loai?.Equals("SE", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkAI && x.Loai?.Equals("AI", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkAE && x.Loai?.Equals("AE", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkTruck && x.Loai?.Equals("Truck", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkCustoms && x.Loai?.Equals("Customs", StringComparison.OrdinalIgnoreCase) == true)
                         || (chkWH && x.Loai?.Equals("WH", StringComparison.OrdinalIgnoreCase) == true);

        // 2. Kiểm tra theo search
        bool matchSearch = true;

        if (chkSearchAd)
        {
            bool hasContSearch =
            !string.IsNullOrWhiteSpace(SearchContNo) ||
            !string.IsNullOrWhiteSpace(SearchKGsCode) ||
            !string.IsNullOrWhiteSpace(SearchCBM) ||
            SearchPKGs.HasValue ||
            SearchGrossWT.HasValue;

            bool hasHDSearch =
            !string.IsNullOrWhiteSpace(SearchSoHDNoiBo) ||
            !string.IsNullOrWhiteSpace(SearchSoHDDienTu);

            bool hasDebitSearch =
            !string.IsNullOrWhiteSpace(SearchDebitNo);

            matchSearch = ListHBLs.Any(h =>
                ListMBLs.Any(m =>
                    m.Jobid == x.JobID &&
                    m.MblID == h.mblid &&

                    // Chỉ kiểm tra container nếu có điều kiện lọc container
                    (!hasContSearch || ListConts.Any(c =>
                        c.hblid == h.hblID &&
                        (string.IsNullOrWhiteSpace(SearchDescription) || (!string.IsNullOrWhiteSpace(c.description) && c.description.Contains(SearchDescription, StringComparison.OrdinalIgnoreCase))) &&
                        (string.IsNullOrWhiteSpace(SearchContNo) || (!string.IsNullOrWhiteSpace(c.CONTAINER_NO) && c.CONTAINER_NO.Contains(SearchContNo, StringComparison.OrdinalIgnoreCase))) &&
                        (string.IsNullOrWhiteSpace(SearchKGsCode) || (!string.IsNullOrWhiteSpace(c.pkgsCode) && c.pkgsCode.Contains(SearchKGsCode, StringComparison.OrdinalIgnoreCase))) &&
                        (string.IsNullOrWhiteSpace(SearchCBM) || (!string.IsNullOrWhiteSpace(c.cbm) && c.cbm.Contains(SearchCBM, StringComparison.OrdinalIgnoreCase))) &&
                        (!SearchPKGs.HasValue || (c.pkgs.HasValue && c.pkgs.Value == SearchPKGs.Value)) &&
                        (!SearchGrossWT.HasValue || (c.GrossWeight.HasValue && c.GrossWeight.Value == SearchGrossWT.Value))
                    )) &&

                    // Chỉ kiểm tra HoaDon nếu có điều kiện lọc HoaDon
                    (!hasHDSearch || ListHoaDonDRa.Any(hd =>
                        hd.hblid == h.hblID &&
                        (string.IsNullOrWhiteSpace(SearchSoHDNoiBo) || (!string.IsNullOrWhiteSpace(hd.sohoadonNoibo) && hd.sohoadonNoibo.Contains(SearchSoHDNoiBo, StringComparison.OrdinalIgnoreCase))) &&
                        (string.IsNullOrWhiteSpace(SearchSoHDDienTu) || (!string.IsNullOrWhiteSpace(hd.sohoadonDientu) && hd.sohoadonDientu.Contains(SearchSoHDDienTu, StringComparison.OrdinalIgnoreCase)))
                    )) &&

                    // Chỉ kiểm tra Debit nếu có điều kiện lọc Debit
                    (!hasDebitSearch || ListDebits.Any(db =>
                        db.hblid == h.hblID &&
                        (string.IsNullOrWhiteSpace(SearchDebitNo) || (!string.IsNullOrWhiteSpace(db.debitno) && db.debitno.Contains(SearchDebitNo, StringComparison.OrdinalIgnoreCase)))
                    )) &&

                    // Các điều kiện lọc theo HBL
                    (SearchCusID == Guid.Empty || h.CustomerID == SearchCusID) &&
                    (string.IsNullOrWhiteSpace(SearchPOL) || (!string.IsNullOrWhiteSpace(h.polname) && h.polname.Contains(SearchPOL, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(SearchPOD) || (!string.IsNullOrWhiteSpace(h.podname) && h.podname.Contains(SearchPOD, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(SearchHBL) || (!string.IsNullOrWhiteSpace(h.hbl) && h.hbl.Contains(SearchHBL, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(SearchShipper) || (!string.IsNullOrWhiteSpace(h.shipper) && h.shipper.Contains(SearchShipper, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(SearchConsignee) || (!string.IsNullOrWhiteSpace(h.consignee) && h.consignee.Contains(SearchConsignee, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrWhiteSpace(SearchNotify) || (!string.IsNullOrWhiteSpace(h.notify1) && h.notify1.Contains(SearchNotify, StringComparison.OrdinalIgnoreCase))) 
                )
            );
        }

        return matchLoai && matchSearch;
    };

    // Khớp filter "View Document": tìm theo Job/MBL/HBL/BK/Container/Customer.
    private bool MatchesViewDocFilter(M_Job x)
    {
        if (!HasViewDocFilter) return true;

        if (!string.IsNullOrWhiteSpace(SearchJobNo))
        {
            if (string.IsNullOrWhiteSpace(x.JobNo) ||
                !x.JobNo.Contains(SearchJobNo, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        bool needCheckChildren = !string.IsNullOrWhiteSpace(SearchMBL)
            || !string.IsNullOrWhiteSpace(SearchHBL)
            || !string.IsNullOrWhiteSpace(SearchBK)
            || !string.IsNullOrWhiteSpace(SearchContNo);

        if (!needCheckChildren) return true;

        var mbls = ListMBLs?.Where(m => m.Jobid == x.JobID).ToList() ?? new List<M_MBL>();
        var mblIds = mbls.Select(m => m.MblID).ToHashSet();
        var hbls = ListHBLs?
            .Where(h => (h.mblid != Guid.Empty && mblIds.Contains(h.mblid)) || h.Jobid == x.JobID)
            .ToList() ?? new List<M_HBL>();

        if (!string.IsNullOrWhiteSpace(SearchMBL))
        {
            if (!mbls.Any(m => !string.IsNullOrWhiteSpace(m.Mbl)
                && m.Mbl.Contains(SearchMBL, StringComparison.OrdinalIgnoreCase)))
                return false;
        }

        if (!string.IsNullOrWhiteSpace(SearchHBL))
        {
            if (!hbls.Any(h => !string.IsNullOrWhiteSpace(h.hbl)
                && h.hbl.Contains(SearchHBL, StringComparison.OrdinalIgnoreCase)))
                return false;
        }

        if (!string.IsNullOrWhiteSpace(SearchBK))
        {
            bool mblBk = mbls.Any(m => !string.IsNullOrWhiteSpace(m.Bkno)
                && m.Bkno.Contains(SearchBK, StringComparison.OrdinalIgnoreCase));
            bool hblBk = hbls.Any(h => !string.IsNullOrWhiteSpace(h.bkno)
                && h.bkno.Contains(SearchBK, StringComparison.OrdinalIgnoreCase));
            if (!mblBk && !hblBk) return false;
        }

        if (!string.IsNullOrWhiteSpace(SearchContNo))
        {
            var hblIds = hbls.Select(h => h.hblID).ToHashSet();
            if (!(ListConts?.Any(c => c.hblid.HasValue && hblIds.Contains(c.hblid.Value)
                && !string.IsNullOrWhiteSpace(c.CONTAINER_NO)
                && c.CONTAINER_NO.Contains(SearchContNo, StringComparison.OrdinalIgnoreCase)) ?? false))
                return false;
        }

        if (SearchCusID != Guid.Empty)
        {
            if (!hbls.Any(h => h.CustomerID == SearchCusID))
                return false;
        }

        return true;
    }

