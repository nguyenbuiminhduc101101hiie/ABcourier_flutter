    private bool showShipmentGridColorSettings = false;
    private bool showSummarySection = false;

    private string GetGridHeightOffset()
    {
        if (!showSummarySection)
            return "220px";

        return isExpand ? "430px" : "300px";
    }

    // Defaults should match values in wwwroot/app.css (:root + hardcoded legacy).
    private string shipmentHeaderBg = "#0077b6";
    private string shipmentSelectedRowBg = "#1E88E5";
    private string shipmentTabToolbarBg = "#ffffff";

    private sealed class ShipmentColorSettingsDto
    {
        public string? headerBg { get; set; }
        public string? selectedBg { get; set; }
        public string? tabToolbarBg { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadShipmentGridColorsFromStorage();

        if (HasViewDocFilter && !_viewDocAutoLoaded)
        {
            _viewDocAutoLoaded = true;
            if (await Refresh())
                await ApplyViewDocFilterToGrid();
        }
        else if (!string.IsNullOrWhiteSpace(NewJobBookingNo) && !_newJobFromBookingHandled)
        {
            _newJobFromBookingHandled = true;
            await Refresh();
            await AddNewJobRow(NewJobBookingNo);
        }

        await InvokeAsync(StateHasChanged);
    }

    // Áp filter vào MudDataGrid giống cơ chế OnRowDoubleClick — chỉ hiển thị lô đúng kết quả tìm.
    private async Task ApplyViewDocFilterToGrid()
    {
        if (!HasViewDocFilter || mudTable == null) return;

        var matches = (Listdata ?? new List<M_Job>())
            .Where(j => MatchesViewDocFilter(j))
            .ToList();

        if (matches.Count == 0)
        {
            CallSnackBar($"Không tìm thấy lô khớp: {ViewDocFilterText()}", MudBlazor.Severity.Warning);
            return;
        }

        var matchIds = matches.Select(j => j.JobID).ToHashSet();

        try { await mudTable.ClearFiltersAsync(); } catch { }
        chkSearchAd = false;

        var filter = new FilterDefinition<M_Job>
        {
            FilterFunction = x => matchIds.Contains(x.JobID),
            Title = nameof(M_Job.JobNo),
            Operator = "equals",
            Value = matches.First().JobNo,
        };

        try { await mudTable.AddFilterAsync(filter); } catch { }

        jobdetail = matches.First();
        try { mudTable.SelectedItem = matches.First(); } catch { }
    }

    private async Task LoadShipmentGridColorsFromStorage()
    {
        try
        {
            var settings = await JS.InvokeAsync<ShipmentColorSettingsDto?>("JNLGetShipmentColorSettings");
            if (settings == null)
                return;

            if (!string.IsNullOrWhiteSpace(settings.headerBg))
                shipmentHeaderBg = settings.headerBg;
            if (!string.IsNullOrWhiteSpace(settings.selectedBg))
                shipmentSelectedRowBg = settings.selectedBg;
            if (!string.IsNullOrWhiteSpace(settings.tabToolbarBg))
                shipmentTabToolbarBg = settings.tabToolbarBg;

            // Ensure the CSS variables are applied from stored values.
            await JS.InvokeVoidAsync(
                "JNLApplyShipmentColorSettings",
                shipmentHeaderBg,
                shipmentSelectedRowBg,
                shipmentTabToolbarBg);
        }
        catch
        {
            // Ignore JS/storage issues; app will use CSS defaults.
        }
    }

    private async Task ApplyShipmentGridColors()
    {
        await JS.InvokeVoidAsync(
            "JNLApplyShipmentColorSettings",
            shipmentHeaderBg,
            shipmentSelectedRowBg,
            shipmentTabToolbarBg);

        CallSnackBar(Localizer["ShipmentGridColorsUpdated"], MudBlazor.Severity.Success);
    }

    private async Task ResetShipmentGridColors()
    {
        shipmentHeaderBg = "#0077b6";
        shipmentSelectedRowBg = "#1E88E5";
        shipmentTabToolbarBg = "#ffffff";
        await ApplyShipmentGridColors();
    }

    string usr;
    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<TrangThai> tts = new List<TrangThai>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<string> SaleNames = new List<string>();
        bool isSale = false, chkSearchSales = false;
    string? _SaleName;

    // ====== View Document feature ======
    [Parameter] public string? InitialJobNo { get; set; }
    [Parameter] public string? InitialMBL { get; set; }
    [Parameter] public string? InitialHBL { get; set; }
    [Parameter] public string? InitialBK { get; set; }
    [Parameter] public string? InitialContainer { get; set; }
    [Parameter] public Guid? InitialCustomerId { get; set; }
    [Parameter] public string? InitialCustomerName { get; set; }

    // Số booking được đưa qua từ 6.1 Booking Request để tạo Job mới.
    [Parameter] public string? NewJobBookingNo { get; set; }

    private string? SearchJobNo;
    private string? SearchMBL;
    private string? SearchBK;
    private bool _viewDocAutoLoaded = false;
    private bool _newJobFromBookingHandled = false;

    private bool HasViewDocFilter =>
        !string.IsNullOrWhiteSpace(InitialJobNo)
        || !string.IsNullOrWhiteSpace(InitialMBL)
        || !string.IsNullOrWhiteSpace(InitialHBL)
        || !string.IsNullOrWhiteSpace(InitialBK)
        || !string.IsNullOrWhiteSpace(InitialContainer)
        || (InitialCustomerId.HasValue && InitialCustomerId.Value != Guid.Empty);

    private string ViewDocFilterText()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(InitialJobNo)) parts.Add($"Job: {InitialJobNo}");
        if (!string.IsNullOrWhiteSpace(InitialMBL)) parts.Add($"MBL: {InitialMBL}");
        if (!string.IsNullOrWhiteSpace(InitialHBL)) parts.Add($"HBL: {InitialHBL}");
        if (!string.IsNullOrWhiteSpace(InitialBK)) parts.Add($"BK: {InitialBK}");
        if (!string.IsNullOrWhiteSpace(InitialContainer)) parts.Add($"Container: {InitialContainer}");
        if (InitialCustomerId.HasValue && InitialCustomerId.Value != Guid.Empty)
        {
            var cusLabel = !string.IsNullOrWhiteSpace(InitialCustomerName)
                ? InitialCustomerName
                : CusidtoCusCode(InitialCustomerId.Value);
            parts.Add($"Cus: {cusLabel}");
        }
        return string.Join(" • ", parts);
    }

    private async Task ClearViewDocFilter()
    {
        InitialJobNo = InitialMBL = InitialHBL = InitialBK = InitialContainer = null;
        InitialCustomerId = null;
        InitialCustomerName = null;
        SearchJobNo = SearchMBL = SearchBK = null;
        SearchHBL = null;
        SearchContNo = null;
        SearchCusID = Guid.Empty;
        chkSearchAd = false;
        isExpand = false;
        if (mudTable != null)
        {
            try { await mudTable.ClearFiltersAsync(); } catch { }
        }
        StateHasChanged();
    }
    // ====== end View Document feature ======

    protected async override Task OnInitializedAsync()
    {
        try
        {
            userdetail = asv.GetUserDetail();
            Customers = await csv.GetList(userdetail);
            tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude.ToLower() == "job").OrderBy(x=>x.Noidung).Select(x=>x.Noidung).ToList();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            SaleNames = await supsv.GetListSale();
            BookingNoList = (await bksv.GetListSBooking() ?? new List<Models.Booking>())
                .Select(x => x.BookingNo)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderByDescending(x => x)
                .ToList();
            if (!string.IsNullOrEmpty(userdetail.Department)
                && userdetail.Department.ToUpper().Contains("SALES")
                && !userdetail.Department.Equals("SALES MANAGER", StringComparison.OrdinalIgnoreCase))
            {
                isSale = true;
                _SaleName = userdetail.Usr;
            }

            if (HasViewDocFilter)
            {
                SearchJobNo = InitialJobNo?.Trim();
                SearchMBL = InitialMBL?.Trim();
                SearchHBL = InitialHBL?.Trim();
                SearchBK = InitialBK?.Trim();
                SearchContNo = InitialContainer?.Trim();
                SearchCusID = InitialCustomerId ?? Guid.Empty;
                chkSearchAd = true;
                isExpand = true;
            }
            //await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["PleaseSlowDown"], MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_Job> Listdata = new List<M_Job>();
    List<M_MBL> ListMBLs = new List<M_MBL>();
    List<M_HBL> ListHBLs = new List<M_HBL>();
    List<M_Container> ListConts = new List<M_Container>();
    List<M_Debit> ListDebits = new List<M_Debit>();
    List<M_Credit> ListCredits = new List<M_Credit>();
    List<M_HoaDonDauRa> ListHoaDonDRa = new List<M_HoaDonDauRa>();
    List<M_HoaDonDauVao> ListHoaDonDVao = new List<M_HoaDonDauVao>();
    M_Job jobdetail;
    async Task<bool> Refresh()
    {
        try
        {
            _loading = true;
            Listdata.Clear();
            await Task.Delay(500);
            StateHasChanged();
            ListMBLs = await shipsv.GetListMBLALL();
            ListHBLs = await shipsv.GetListHBLALL();
            ListConts = shipsv.GetListContainerAll();
            ListDebits = await shipsv.GetListDebitALL();
            ListCredits = await shipsv.GetListCreditALL();
            ListHoaDonDRa = await shipsv.GetListHoaDonDauRaALL();
            ListHoaDonDVao = await shipsv.GetListHoaDonDauVaoALL();
            jobdetail = null;
            // Simulate asynchronous loading to demonstrate a loading indicator

            if (!await ssv.CheckPermission(usr, "View", "Shipment6"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return false;
            }
              Listdata = await shipsv.GetListJob_by_roles_Dept();
            // SALES MANAGER xem hết; sale thường chỉ lấy job của mình
            if (!string.IsNullOrEmpty(_SaleName)
                && !(userdetail.Department?.Equals("SALES MANAGER", StringComparison.OrdinalIgnoreCase) ?? false))
            {
                var mblIdsWithSale = ListHBLs
                   .Where(h => h.SaleName == _SaleName)
                   .Select(h => h.mblid)
                   .Distinct()
                   .ToHashSet();

                var jobIdsWithSale = ListMBLs
                    .Where(m => mblIdsWithSale.Contains(m.MblID))
                    .Select(m => m.Jobid)
                    .Distinct()
                    .ToHashSet();

                Listdata = Listdata.Where(job => jobIdsWithSale.Contains(job.JobID)).ToList();

            }
            return true;
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Job> mudTable;
    async Task UpdateJobNo(M_Job item ,DateTime value)
    {
        if (string.IsNullOrWhiteSpace(item.Loai))
            return;

        var refno = await supsv.GetRefNoByFunc("JOB", value.Month, value.Year, usr);
        var prefix = await GetJobNoPrefix(item);
        item.JobNo = prefix + item.Loai + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D5") : "RefNoError!");
    }

    async Task UpdateJobType(M_Job item, string? type)
    {
        var previousType = item.Loai;
        item.Loai = type;

        if (string.IsNullOrWhiteSpace(item.JobNo))
            return;

        var prefix = await GetJobNoPrefix(item);
        if (string.IsNullOrEmpty(prefix) || !item.JobNo.StartsWith(prefix, StringComparison.Ordinal))
            return;

        var jobSuffix = item.JobNo[prefix.Length..];
        if (!string.IsNullOrWhiteSpace(previousType) && jobSuffix.StartsWith(previousType, StringComparison.Ordinal))
            jobSuffix = jobSuffix[previousType.Length..];

        item.JobNo = prefix + type + jobSuffix;
    }

