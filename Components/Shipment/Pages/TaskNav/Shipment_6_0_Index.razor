
@* @page "/shipment" *@
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject ShipmentService shipsv
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]
@inject HistoryLogService HistoryLogService
@inject BookingService bksv
@using System.Text.Json;

<PageTitle>@Localizer["Shipment"]</PageTitle>

<div class="shipment-page">
    <PpScreenHeader Title="@Localizer["Shipment"]" Subtitle="6.0 · Operations &amp; tasks" />

    @if (HasViewDocFilter)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Filled" Dense="true" Class="mb-2"
                  ShowCloseIcon="true" CloseIconClicked="ClearViewDocFilter">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.FindInPage" />
                <MudText Typo="Typo.body2">
                    <b>View Document:</b> @ViewDocFilterText()
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="ClearViewDocFilter">
                    Hiện tất cả
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(NewJobBookingNo))
    {
        <MudAlert Severity="MudBlazor.Severity.Success" Variant="Variant.Filled" Dense="true" Class="mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.PostAdd" />
                <MudText Typo="Typo.body2">
                    <b>Tạo Job từ Booking:</b> @NewJobBookingNo
                </MudText>
            </MudStack>
        </MudAlert>
    }

    <MudPaper Class="shipment-shell" Elevation="0">
        @if (showSummarySection)
        {
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="shipment-summary">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h6" Class="shipment-title">@Localizer["Shipment6_Title"]</MudText>
                <MudText Typo="Typo.body2" Class="shipment-subtitle">@Localizer["Shipment6_Subtitle"]</MudText>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="shipment-stat-group">
                <MudPaper Class="shipment-stat-card" Elevation="0">
                    <MudText Typo="Typo.caption">@Localizer["Shipment_TotalJobs"]</MudText>
                    <MudText Typo="Typo.subtitle1">@(Listdata?.Count ?? 0)</MudText>
                </MudPaper>
                <MudPaper Class="shipment-stat-card" Elevation="0">
                    <MudText Typo="Typo.caption">MBL</MudText>
                    <MudText Typo="Typo.subtitle1">@(ListMBLs?.Count ?? 0)</MudText>
                </MudPaper>
                <MudPaper Class="shipment-stat-card" Elevation="0">
                    <MudText Typo="Typo.caption">HBL</MudText>
                    <MudText Typo="Typo.subtitle1">@(ListHBLs?.Count ?? 0)</MudText>
                </MudPaper>
            </MudStack>
        </MudStack>

        <MudPaper Class="shipment-filter-card" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="shipment-filter-header">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="shipment-section-icon" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2" Class="shipment-section-title">@Localizer["Shipment_AdvancedSearch"]</MudText>
                        <MudText Typo="Typo.caption" Class="shipment-section-caption">@Localizer["Shipment_AdvancedSearchCaption"]</MudText>
                    </MudStack>
                </MudStack>

                <MudSwitch @bind-Value="chkSearchAd"
                           @bind-Value:after="@(() => isExpand = chkSearchAd)"
                           Label="@Localizer["Search"]"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="shipment-search-switch" />
            </MudStack>

            <MudExpansionPanels Class="shipment-expansion" Elevation="0">
                <MudExpansionPanel Text="@Localizer["Shipment_SearchFromHBL"]"
                                   Icon="@Icons.Material.Filled.Search"
                                   @bind-IsExpanded="isExpand"
                                   Disabled="@(!chkSearchAd)"
                                   Class="shipment-expansion-panel">
                    <MudGrid Spacing="2" Class="shipment-search-grid">
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchHBL" Label="@Localizer["HBL No"]" SearchFunc="SearchFuncHBL" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchSoHDNoiBo" Label="@Localizer["InternalInvoiceNo"]" SearchFunc="SearchFuncSoHDnoibo" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchSoHDDienTu" Label="@Localizer["ElectronicInvoiceNo"]" SearchFunc="SearchFuncSoHDdientu" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchDebitNo" Label="@Localizer["DebitNo"]" SearchFunc="SearchFuncSoDebit" ResetValueOnEmptyText Clearable />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchPOL" Label="@Localizer["POL"]" SearchFunc="SearchPort" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchPOD" Label="@Localizer["POD"]" SearchFunc="SearchPort" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchDescription" Label="@Localizer["Description"]" SearchFunc="SearchFuncDes" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchCusID" Label="@Localizer["Customer"]" SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" ResetValueOnEmptyText Clearable />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchShipper" Label="@Localizer["Shipper"]" SearchFunc="SearchFucnShipper" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchConsignee" Label="@Localizer["Consignee"]" SearchFunc="SearchFucnConsn" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchNotify" Label="@Localizer["Notify"]" SearchFunc="SearchFucnNotify" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchContNo" Label="@Localizer["ContainerNo"]" SearchFunc="SearchFuncContNo" ResetValueOnEmptyText Clearable />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchPKGs" Label="@Localizer["PKGs"]" SearchFunc="SearchFucnPKGs" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchKGsCode" Label="@Localizer["PKGsCode"]" SearchFunc="SearchFucnPKGsCode" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchCBM" Label="@Localizer["CBM"]" SearchFunc="SearchFucnCBM" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudAutocomplete Class="shipment-input" @bind-Value="SearchGrossWT" Label="@Localizer["GrossWT"]" SearchFunc="SearchFucnGrossWT" ResetValueOnEmptyText Clearable />
                        </MudItem>
                    </MudGrid>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
        }

        <MudPaper Class="shipment-toolbar" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="shipment-toolbar-inner">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="shipment-action-group">
                    <MudTooltip Text="@(showSummarySection ? Localizer["Shipment_HideSummarySearch"] : Localizer["Shipment_ShowSummarySearch"])">
                        <MudIconButton Icon="@(showSummarySection ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Class="shipment-summary-toggle"
                                       OnClick="@(() => showSummarySection = !showSummarySection)" />
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Reload"]">
                        <MudButton StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="Refresh"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-primary">@Localizer["Reload"]</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["New"]">
                        <MudButton StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddItem"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-success">@Localizer["New"]</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Duplicate"]">
                        <MudButton StartIcon="@Icons.Material.Filled.CopyAll"
                                   OnClick="@(() => DuplicateItem())"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-secondary">@Localizer["Duplicate"]</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Shipment_HblMbl"]">
                        <MudButton StartIcon="@Icons.Material.Filled.NavigateNext"
                                   OnClick="@( () => {
                                       switch (jobdetail?.Loai)
                                       {
                                           case "Customs":
                                               OpenDialogCustoms();
                                               break;
                                           case "Truck":
                                               OpenDialogTrucking();
                                               break;
                                           default:
                                               OpenDialog();
                                               break;
                                       }
                                   })"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-navy">@Localizer["Shipment_HblMbl"]</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="Check List HBL-Booking">
                        <MudButton StartIcon="@Icons.Material.Filled.CompareArrows"
                                   OnClick="OpenCheckListHblBooking"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-check">Check List HBL-Booking</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Report"]">
                        <MudButton StartIcon="@Icons.Material.Filled.AddChart"
                                   OnClick="@(() => OpenShipmentReport())"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-purple">@Localizer["Report"]</MudButton>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Help"]">
                        <a href="HDSDhtml/Huong_dan_Tao_Moi_Job_Shipment.html" target="_blank" class="shipment-help-link">
                            <MudButton StartIcon="@Icons.Material.Filled.Info"
                                       Variant="Variant.Filled"
                                       Class="shipment-action-btn shipment-action-info">@Localizer["Help"]</MudButton>
                        </a>
                    </MudTooltip>

                    <MudTooltip Text="@Localizer["Shipment_GridColors"]">
                        <MudButton StartIcon="@Icons.Material.Filled.Palette"
                                   OnClick="@(() => showShipmentGridColorSettings = !showShipmentGridColorSettings)"
                                   Variant="Variant.Filled"
                                   Class="shipment-action-btn shipment-action-light">@Localizer["Shipment_Colors"]</MudButton>
                    </MudTooltip>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="shipment-type-filter">
                    <MudText Typo="Typo.caption" Class="shipment-filter-label">@Localizer["Type"]</MudText>
                    <MudSwitch @bind-Value="chkSI" Label="SI" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkSE" Label="SE" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkAI" Label="AI" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkAE" Label="AE" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkTruck" Label="Truck" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkCustoms" Label="Customs" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                    <MudSwitch @bind-Value="chkWH" Label="WH" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (showShipmentGridColorSettings)
        {
            <MudCard Class="shipment-color-card" Elevation="0">
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle1" Class="shipment-section-title">@Localizer["Shipment_GridColors"]</MudText>
                                <MudText Typo="Typo.caption" Class="shipment-section-caption">Change header, selected row and tab toolbar colors.</MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Class="shipment-section-icon" />
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">@Localizer["Shipment_GridHeaderRow"]</MudText>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <input type="color" value="@shipmentHeaderBg"
                                           @onchange="@((ChangeEventArgs e) => shipmentHeaderBg = e.Value?.ToString() ?? shipmentHeaderBg)"
                                           class="shipment-color-picker" />
                                    <MudTextField @bind-Value="shipmentHeaderBg" Label="@Localizer["Color"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">@Localizer["Shipment_GridSelectedRow"]</MudText>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <input type="color" value="@shipmentSelectedRowBg"
                                           @onchange="@((ChangeEventArgs e) => shipmentSelectedRowBg = e.Value?.ToString() ?? shipmentSelectedRowBg)"
                                           class="shipment-color-picker" />
                                    <MudTextField @bind-Value="shipmentSelectedRowBg" Label="@Localizer["Color"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.subtitle2">@Localizer["Shipment_GridTabToolbar"]</MudText>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <input type="color" value="@shipmentTabToolbarBg"
                                           @onchange="@((ChangeEventArgs e) => shipmentTabToolbarBg = e.Value?.ToString() ?? shipmentTabToolbarBg)"
                                           class="shipment-color-picker" />
                                    <MudTextField @bind-Value="shipmentTabToolbarBg" Label="@Localizer["Color"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudStack>
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd">
                            <MudButton OnClick="ResetShipmentGridColors" Variant="Variant.Outlined" Class="shipment-dialog-btn">@Localizer["Reset"]</MudButton>
                            <MudButton OnClick="ApplyShipmentGridColors" Variant="Variant.Filled" Class="shipment-action-btn shipment-action-primary">@Localizer["Apply"]</MudButton>
                            <MudButton OnClick="@(() => showShipmentGridColorSettings = false)" Variant="Variant.Text" Class="shipment-dialog-btn">Close</MudButton>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }

        <MudDataGrid T="M_Job" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-shipment-bg shipment-grid"
                     FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height=@($"calc(100vh - {GetGridHeightOffset()})") QuickFilter="_quickFilter"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" SortMode="SortMode.Single"
                     ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                     RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="false" RowClass="no-wrap-cell"
                     ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false" @ondblclick="@(() => OnRowDoubleClick(jobdetail))">
<Columns>
            <HierarchyColumn T="M_Job" ButtonDisabledFunc="@(x => x.Approve.HasValue && x.Approve.Value)" />
            <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Class="shipment-row-action edit-action" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {
                           
                                 detail = JsonSerializer.Deserialize<M_Job>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();
                         
                         
                       })" />
                    <MudIconButton Size="@Size.Small" Class="shipment-row-action delete-action" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))"/>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Loai_Nvo_Fre" Title="@Localizer["NVOCC/Freight"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.Loai_Nvo_Fre" Label="@Localizer["NVOCC/Freight"]">
                        <MudSelectItem Value="@("NVOCC-Freight")">NVOCC-Freight</MudSelectItem>
                        <MudSelectItem Value="@("Freight")">Freight</MudSelectItem>
                    
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Loai" Title="@Localizer["Type"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect T="string" Value="context.Item.Loai" ValueChanged="@(value => UpdateJobType(context.Item, value))" Label="@Localizer["Type"]" Required>
                        <MudSelectItem Value="@("AI")">AI</MudSelectItem>
                        <MudSelectItem Value="@("AE")">AE</MudSelectItem>
                        <MudSelectItem Value="@("SI")">SI</MudSelectItem>
                        <MudSelectItem Value="@("SE")">SE</MudSelectItem>
                        <MudSelectItem Value="@("Truck")">Truck</MudSelectItem>
                        <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                        <MudSelectItem Value="@("WH")">WH</MudSelectItem>
                    </MudSelect>
                    <MudDatePicker Label="@Localizer["Selected Date Create Job"]" DateChanged="((t)=>UpdateJobNo(context.Item,(DateTime)t!))" ImmediateText DateFormat="MM/yyyy" Disabled="@string.IsNullOrWhiteSpace(context.Item.Loai)" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.JobNo" Title="@Localizer["Job No"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudTextField @bind-Value="context.Item.JobNo" Immediate Label="@Localizer["Job No"]" Disabled Required />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => CountMBL(x.JobID)" Title="@Localizer["Total MBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => CountHBL(x.JobID)" Title="@Localizer["Total HBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => CountDebitHBL(x.JobID)" Title="@Localizer["Total Debit (HBL)"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => CountCreditHBL(x.JobID)" Title="@Localizer["Total Credit (HBL)"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => DebitCreditCompletedStatus(x.JobID)" Title="@Localizer["Debit/Credit Done"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => joinmbl(x.JobID)" Title="@Localizer["MBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => joinhbl(x.JobID)" Title="@Localizer["HBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => joinbooking(x.JobID)" Title="@Localizer["Booking No"]" Required="false" CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudAutocomplete T="string"
                                     @bind-Value="context.Item.BookingNo"
                                     Label="@Localizer["Booking No"]"
                                     SearchFunc="SearchFuncJobBookingNo"
                                     Immediate="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true"
                                     Required="false"
                                     MaxItems="200" />
                </EditTemplate>
            </PropertyColumn>
            
            <PropertyColumn Property="x => x.FLC" Title="@Localizer["FLC"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.FLC" Label="@Localizer["FLC"]">
                        <MudSelectItem Value="@("F")">F</MudSelectItem>
                        <MudSelectItem Value="@("L")">L</MudSelectItem>
                        <MudSelectItem Value="@("C")">C</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.statusJob" Title="@Localizer["Status"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.statusJob" Label="@Localizer["Status"]">
                        @foreach (var item in trangthais)
                        {
                            <MudSelectItem Value="item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>

             <PropertyColumn Property="x => x.Salecode" Title="@Localizer["Sale Name"]" Required CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.Salecode" Label="@Localizer["Sale Name"]" Required>
                            @foreach (var item in SaleNames)
                            {
                                <MudSelectItem Value="item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>

        @*     <PropertyColumn Property="x => x.CompanyCode" Title="@Localizer["Company Code"]" CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.CompanyCode" Label="@Localizer["Company Code"]">
                        <MudSelectItem Value="@("PASL")">PASL</MudSelectItem>
                        <MudSelectItem Value="@("VietStar")">VietStar</MudSelectItem>
                        <MudSelectItem Value="@("AMSS")">AMSS</MudSelectItem>
                        <MudSelectItem Value="@("HDS")">HDS</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn> *@

            <PropertyColumn Property="x => formatDate(x.Datecreate)" Title="@Localizer["Date Create"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=>x.Userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=> formatDate(x.Dateupdate)" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=>x.Approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                </CellTemplate>
                <EditTemplate>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x=>x.Editable" Title="@Localizer["Editable"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc">
                <CellTemplate>
