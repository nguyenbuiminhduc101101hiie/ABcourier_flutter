    string joinbooking(Guid jobid)
    {
        var list = ListMBLs.Where(x => x.Jobid == jobid);
        var listhbl = new List<M_HBL>();
        foreach (var item in list)
        {
            var hbls = ListHBLs.Where(x => x.mblid == item.MblID);
            listhbl.AddRange(hbls);
        }

        var directHbls = ListHBLs.Where(x => x.Jobid == jobid);
        listhbl.AddRange(directHbls);

        var rs = listhbl
            .Select(x => NormalizeDisplayText(x.bkno))
            .Where(x => x is not null)
            .Select(x => x!)
            .Concat(Listdata
                .Where(x => x.JobID == jobid)
                .Select(x => NormalizeDisplayText(x.BookingNo))
                .Where(x => x is not null)
                .Select(x => x!))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return string.Join(";", rs);
    }

    private static string? NormalizeDisplayText(string? value)
    {
        var cleanValue = value?.Trim();
        return string.IsNullOrWhiteSpace(cleanValue) ? null : cleanValue;
    }

    private List<string> BookingNoList { get; set; } = new();

    private async Task<IEnumerable<string>> SearchFuncJobBookingNo(string value)
    {
        await Task.Delay(1);

        var rs = BookingNoList
            .Concat(Listdata?.Select(x => x.BookingNo) ?? Enumerable.Empty<string?>())
            .Concat(ListMBLs?.Select(x => x.Bkno) ?? Enumerable.Empty<string?>())
            .Concat(ListHBLs?.Select(x => x.bkno) ?? Enumerable.Empty<string?>())
            .Select(NormalizeDisplayText)
            .Where(x => x is not null)
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (string.IsNullOrWhiteSpace(value))
            return rs;

        var keyword = value.Trim();
        var filtered = rs
            .Where(x => x.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!filtered.Any(x => x.Equals(keyword, StringComparison.OrdinalIgnoreCase)))
            filtered.Insert(0, keyword);

        return filtered;
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
