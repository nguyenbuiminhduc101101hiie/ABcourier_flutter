    async Task UpdateHBLNo(M_HBL item, DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("HBL", value.Month, value.Year, usr);

        // var func_loai = _jobLoai == "NVOCC-Freight" ? "JOBNVO" : "JOB";

        var func_loai = "HBL";
        var (includePol, includePod) = await supsv.GetPODPOL_BY_TiepDauNgu(func_loai);

        string Last3(string? code)
        {
            if (string.IsNullOrEmpty(code) || code.Length < 3)
                return string.Empty;
            return code.Substring(code.Length - 3);
        }
        string tiepdaungu = await supsv.GetTiepDauNguByFunc(func_loai);
        var polcode = includePol ? Last3(MBLDetail?.Polcode) : string.Empty;
        var podcode = includePod ? Last3(MBLDetail?.Podcode) : string.Empty;
        item.hbl = tiepdaungu + polcode + podcode + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D5") : "RefNoError!");
    }
    async Task CommittedItem(M_HBL item)
    {
        try
        {
            _loading = true;

            var newhblid = Guid.NewGuid();
            await mudTable.CancelEditingItemAsync();
            if (CopyOps.CopyMBLHBL) //coppy các tab bên trong
            {
                var rscop = await shipsv.DuplicateHBLDetailList(item, newhblid, CopyOps);
                await HistoryLogService.LogAsync(usr, "Duplicate HBL", "Shipment", item.hblID, item.hbl, item);

                if (!rscop.Flag)
                {
                    CallSnackBar(rscop.Message, rscop.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                    return;
                }
                item.dachicredit = item.dathuchidaily = item.dachicredit = item.dathudebit = false;
                item.debitCompleted = item.creditCompleted = false;
                item.hblID = Guid.Empty;
            }
            item.mblid = MBLDetail!.MblID;
            item.userupdate = usr;
            if(!item.datereport.HasValue) item.datereport= type.Contains("I") ? item.ETA : item.ETD;
            item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
            if (item.hblID == Guid.Empty)
            {
                item.hblID = newhblid;
                item.Continued = true;
                var rs = CopyOps.CopyMBLHBL ? await shipsv.CreateHBLDetailNotFromMBL(item) :await shipsv.CreateHBLDetail(item);
                await HistoryLogService.LogAsync(usr, "ADD HBL", "Shipment", item.hblID, item.hbl, item);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            else
            {
                var rs = await shipsv.UpdateHBLDetail(item, detail);


                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("somethings went wrong while commit HBL, code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

