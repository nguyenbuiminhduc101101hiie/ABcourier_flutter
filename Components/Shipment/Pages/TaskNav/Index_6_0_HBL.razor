                { x => x.CFS, CFS ?? new List<string?>() },
                { x => x.Warehouse, Warehouse ?? new List<string>() },
                { x => x.SaleNames, SaleNames ?? new List<string>() },
                { x => x.ListUsers, ListUsers ?? new List<string>() },
                { x => x.TrangThai, trangthais ?? new List<string>() },
                { x => x.ListDebit, ListDebit ?? new List<M_Debit>() },
                { x => x.ListCredit, ListCredit ?? new List<M_Credit>() },
                { x => x.CurrentUserRole, currentUserRole },
                { x => x.UpdateHBLNoAsync, UpdateHBLNo },
                { x => x.SetActualdeldateAsync, SetActualdeldate },
                { x => x.UpdatebyCheckboxClickAsync, UpdatebyCheckboxClick }
            },
            options);

        var result = await dialog.Result;
        if (result.Canceled)
            return;

        var updated = (M_HBL)(result.Data ?? editModel);
        await CommittedItem(updated);
    }

    async Task TryStartEditing(M_HBL item)
    {
        await ShowHblEditDialogAsync(item, Localizer["Edit"]);
