@code {

    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
    M_HBL detail;


    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    string usr;
    List<string> trangthais = new List<string>();
    List<string> SaleNames = new List<string>();
    List<string> Shippers = new List<string>();
    List<string> Consignees = new List<string>();
    List<string> Notify = new List<string>();
    List<string> CFS = new List<string>();
    List<string> Warehouse = new List<string>();
    List<string> ListUsers = new List<string>();

    public string type = "";
    string search_shipper ="";
    string search_Consignee = "";
    string search_Notify = "";
    string currentUserRole;
    string salecode_injob = "";
    /// <summary>Loại job (M_Job.Loai) — dùng tra TiepDauNgu khi ghép số HBL.</summary>
    string? _jobLoai;
    protected async override Task OnInitializedAsync()
    {
        try
        {
            var authState = await asv.GetAuth();
            var user = authState.User;
            currentUserRole = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
            var tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude == "HBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            Shippers = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Consignees = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Notify = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            CFS = await supsv.GetlistCFS();
            Warehouse = await supsv.GetlistWhouse();
            SaleNames = await supsv.GetListSale();
            ListUsers = await supsv.GetListUsers();
            type = await shipsv.GetTypeByMBLID(MBLDetail.MblID); // Sea Air Truck HQ
            salecode_injob = await shipsv.GetsaleinJob_byJobId(MBLDetail.Jobid);
            var job = await shipsv.GetJob_byid(MBLDetail.Jobid);
            _jobLoai = job?.Loai_Nvo_Fre;
            await Refresh();

        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    M_HBL hbldetail = new M_HBL();
    int containerCount;
    int debitCount;
    int creditCount;
    int commissionCount;
    int refundDutyCount;
    int theoDoiCount;
    int mapCount;
    int imageCount;

    void OnContainerCountChanged(int count) => containerCount = count;
    void OnDebitCountChanged(int count) => debitCount = count;
    void OnCreditCountChanged(int count) => creditCount = count;
    void OnCommissionCountChanged(int count) => commissionCount = count;
    void OnRefundDutyCountChanged(int count) => refundDutyCount = count;
    void OnTheoDoiCountChanged(int count) => theoDoiCount = count;
    void OnMapCountChanged(int count) => mapCount = count;
    void OnImageCountChanged(int count) => imageCount = count;

    async Task LoadTabCountsAsync()
    {
        if (hbldetail == null || hbldetail.hblID == Guid.Empty)
        {
            containerCount = debitCount = creditCount = commissionCount = 0;
            refundDutyCount = theoDoiCount = mapCount = imageCount = 0;
            return;
        }

        var id = hbldetail.hblID;
        try
        {
            // Sequential: shipsv methods share one DbContext (not safe for parallel)
            containerCount = shipsv.GetListContainerHBL(id)?.Count ?? 0;
            debitCount = (await shipsv.GetListDebitHBL(id, false)).Count;
            refundDutyCount = (await shipsv.GetListDebitHBL(id, true)).Count;
            creditCount = (await shipsv.GetListCreditHBL(id, false)).Count;
            commissionCount = (await shipsv.GetListCreditHBL(id, true)).Count;
            theoDoiCount = (await shipsv.GetListTheoDoiLoHang(id)).Count;
            mapCount = (await shipsv.GetlistVitrilohang(id)).Count;

            await using var db = await DbFactory.CreateDbContextAsync();
            imageCount = await db.HBL_Attachment.AsNoTracking().CountAsync(x => x.hblID == id);
        }
        catch
        {
            // giữ count cũ nếu load lỗi
        }
    }

    async Task Refresh()
    {
        try
        {
            hbldetail = null!;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);

            Listdata = await shipsv.GetListHBL(MBLDetail!.MblID);
            ListDebit = await shipsv.GetListDebitALL();
            ListCredit = await shipsv.GetListCreditALL();
            if (Listdata.Count > 0)
                hbldetail = Listdata[0];
            await LoadTabCountsAsync();
        }
        finally
        {
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
        if (mudTable != null && Listdata.Count > 0)
            await mudTable.SetSelectedItemAsync(Listdata[0]);
    }
    MudDataGrid<M_HBL> mudTable;

    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "HBL"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
