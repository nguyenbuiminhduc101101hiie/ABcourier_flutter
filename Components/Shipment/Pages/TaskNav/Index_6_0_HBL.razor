    async Task SetActualdeldate(M_HBL item)
    {
        if (item is null) return;

        try
        {
            var loaihang = await shipsv.GetTypeByMBLID(item.mblid);

            // e là xuất, k là nhập. Nếu loaihang null thì coi như không có 'E' để tránh lỗi treo.
            var loai = loaihang ?? string.Empty;
            item.ActualDelDate = loai.Contains("E", StringComparison.OrdinalIgnoreCase) ? item.ETA : item.ETD;
        }
        catch
        {
            // Fallback an toàn: nếu lỗi lấy loại hàng thì mặc định theo nhánh "k" (không phải 'E')
            item.ActualDelDate = item.ETD;
