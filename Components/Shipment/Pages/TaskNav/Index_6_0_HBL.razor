    CopyOptions CopyOps = new();
    async Task DuplicateItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "HBL"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        if (hbldetail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };
        CopyOps = new();
        var parameters = new DialogParameters<DialogDuplicate> { { x => x.isHBL, true } };
        var dialog = await DialogService.ShowAsync<DialogDuplicate>($"Duplicate Options", parameters, optionsdialog);
        var resultMess = await dialog.Result;
        if (resultMess.Canceled)
                return;
        CopyOps = (CopyOptions)resultMess.Data;
        var item = hbldetail.DeepCopy();
        if (!CopyOps.CopyMBLHBL)
            item.hblID = Guid.Empty;
        await UpdateHBLNo(item,DateTime.Now);
        await HistoryLogService.LogAsync(usr, "Duplicate HBL", "Shipment", item.hblID, item.hbl, item);
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    List<M_Debit> ListDebit = new();
    List<M_Credit> ListCredit = new();
    bool chkUSD = false, chkVAT = false;
    double? TProfit_(Guid id)
    {
        var debit = ListDebit;
        var credit = ListCredit;

        debit = ListDebit.Where(x => x.hblid == id).ToList();
        credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
        return totaldebit - totalcredit;
    }

