    private bool _processingUploadManifest = false;
    async Task ExportManifestReport()
    {
        try
        {
            if (hbldetail == null)
            {
                CallSnackBar("you must select 1 HBL.", MudBlazor.Severity.Warning);
                return;
            }
            _processingUploadManifest = true;
            StateHasChanged();
            await Task.Delay(1);
            var rs = await rsv.Emanifest(MBLDetail!, hbldetail);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadManifest = false;
        }
    }
