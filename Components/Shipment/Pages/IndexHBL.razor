            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
    }
    double? TCredit_(Guid id)
    {
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        return credit.Sum(x =>
