
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@using System.Globalization﻿
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
@inject IJSRuntime JSRuntime
<MudTabs SliderColor="Color.Primary">
    <MudTabPanel Text="@($"HBL [{(hbldetail != null ? hbldetail.hbl : null)}]")" Class="custom-tab">
        <MudDataGrid T="M_HBL" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-hbl-bg"

        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Bordered="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" EditDialogOptions="optionsdialog"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>

                            <!-- Nút Add -->
                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="AddItem" Disabled
                                Variant="Variant.Filled"
                                Class="btn-compact" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["Duplicate"]">
                                <MudIconButton OnClick="@(() => DuplicateItem())" Disabled
                                Size="Size.Small"
                                Color="Color.Tertiary"
                                Variant="Variant.Filled"
                                Icon="@Icons.Material.Filled.CopyAll"
                                Class="btn-compact" />
                            </MudTooltip>
                            <!-- Dropdown Export -->
                            <MudTooltip Text="@Localizer["Bills"]">
                                @if (_processingArrival || _processingUpload || _processingDO)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.Download" Disabled
                                    Color="Color.Success"
                                    Size="Size.Small"
                                    Variant="Variant.Filled"
                                    AnchorOrigin="Origin.BottomCenter"
                                    TransformOrigin="Origin.TopCenter">
                                        <MudMenuItem Disabled="_processingUpload" OnClick="ExportBill">
                                            @Localizer["Export_Bill"]
                                        </MudMenuItem>
                                        <MudMenuItem Disabled="_processingArrival" OnClick="ExportArrival">
                                            @Localizer["Arrival Notice"]
                                        </MudMenuItem>
                                        <MudMenuItem Disabled="_processingDO" OnClick="ExportDO">
                                            @Localizer["D/O"]
                                        </MudMenuItem>
                                        <MudMenuItem Disabled="_processingBBGN" OnClick="ExportBBGN">
                                            @Localizer["BBGN"]
                                        </MudMenuItem>
                                    </MudMenu>
                                }
                            </MudTooltip>
                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@($"{Localizer["HBL"]} QR Code")">
                            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Filled.QrCode2" OnClick="@(() => OpenHblQrDialog(context.Item))" Disabled="@string.IsNullOrWhiteSpace(context.Item.hbl)" />
                        </MudTooltip>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.EditCalendar" OnClick="@(()=>OpenImportDialog(context.Item))" Disabled/>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => TryStartEditing(context.Item))" Disabled/>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled/>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.hbl" Title="@Localizer["HBL"]">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.hbl" Immediate Label="HBL" Required />
                        <MudDatePicker Label="Selected Date Get HBL" DateChanged="((t)=>UpdateHBLNo(context.Item,(DateTime)t!))" ImmediateText DateFormat="MM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.release" Title="@Localizer["Release"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.release" Label="@Localizer["Release"]"  />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.release.HasValue ? context.Item.release.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.releaseNote" Title="@Localizer["Release Note"]" Required="false" Filterable="false"  />
                <PropertyColumn Property="x => TDebit_(x.hblID)" Title="@Localizer["Debit"]" Required="false" Filterable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => TCredit_(x.hblID)" Title="@Localizer["Credit"]" Required="false" Filterable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;" />
                <PropertyColumn Property="x => TProfit_(x.hblID)" Title="@Localizer["Profit"]" Required="false" Filterable="false" Sortable="false" Format="##,##0.##" Culture="@(CultureInfo.GetCultureInfo("en-US"))" CellStyle="text-align: right;">
                    <HeaderTemplate>
                        <div class="mud-data-grid mud-table-cell column-header table-hbl-bg">
                            @Localizer["Profit"]
                            <MudRadioGroup @bind-Value="chkUSD" Style="margin-left:10px;">
                                <MudRadio Value="@true" Color="Color.Inherit" Size="Size.Small">USD</MudRadio>
                                <MudRadio Value="@false" Color="Color.Inherit" Size="Size.Small">VND</MudRadio>
                            </MudRadioGroup>
                            <MudCheckBox @bind-Checked="chkVAT" Label="VAT" Color="Color.Inherit" Size="Size.Small" />
                        </div>
                    </HeaderTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.issueinvoice" Title="@Localizer["Invoice Issued"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.issueinvoice" Label="@Localizer["Invoice Issued"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.issueinvoice.HasValue ? context.Item.issueinvoice.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dathudebit" Title="@Localizer["Debit Received"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathudebit" Label="@Localizer["Debit Received"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dathudebit.HasValue ? context.Item.dathudebit.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dachicredit" Title="@Localizer["Spent Credit"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dachicredit" Label="@Localizer["Spent Credit"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dachicredit.HasValue ? context.Item.dachicredit.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dathuchidaily" Title="@Localizer["Received & Spent Agent"]" Required="false" Filterable="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.dathuchidaily" Label="@Localizer["Received & Spent Agent"]" />
                    </EditTemplate>
                    <CellTemplate>
                        <MudCheckBox Value="context.Item.dathuchidaily.HasValue ? context.Item.dathuchidaily.Value : false" ReadOnly />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => formatDate(x.ETA)" Title="@Localizer["ETA"]">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="context.Item.ETA" @bind-Date:after="@(()=>SetActualdeldate(context.Item))" Label="@Localizer["ETA"]" DateFormat="dd/MMM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => formatDate(x.ETD)" Title="@Localizer["ETD"]">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="context.Item.ETD" @bind-Date:after="@(()=>SetActualdeldate(context.Item))" Label="@Localizer["ETD"]" DateFormat="dd/MMM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => formatDate(x.ActualDelDate)" Title="@Localizer["ActualDel Date"]">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="context.Item.ActualDelDate" Label="@Localizer["ActualDel Date"]" DateFormat="dd/MMM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => formatDate(x.datereport)" Title="@Localizer["Date Report"]">
                    <EditTemplate>
                        <MudDatePicker @bind-Date="context.Item.datereport" Label="@Localizer["Date Report"]" DateFormat="dd/MMM/yyyy" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.CustomerID)" Title="@Localizer["Main Customer"]" Required CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.CustomerID" Label="@Localizer["Main Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => AgentidtoName(x.AgentID)" Title="@Localizer["Agent"]" Required CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.AgentID" Label="@Localizer["Agent"]" Required
                        SearchFunc="SearchAgent" ToStringFunc="AgentidtoName" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.bkno" Title="@Localizer["Bkno"]" />
                <PropertyColumn Property="x => x.Air_wareHouse" Title="@Localizer["Warehouse"]">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.Air_wareHouse" Label="@Localizer["Warehouse"]" Required
                        SearchFunc="SearchWHouse" CoerceValue />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Air_type" Title="@Localizer["LoaiHang"]" >
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.Air_type" Label="@Localizer["LoaiHang"]" Required
                        SearchFunc="SearchCFS" CoerceValue/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.shipper" Title="@Localizer["Shipper"]" Required="false" CellClass="no-wrap-cell" Hidden="true">
                    <EditTemplate>
                        <MudAutocomplete T="string" @bind-Value="@search_shipper" Label="@Localizer["Shipper"]" AutoFocus="false" 
                        SearchFunc="SearchShipper" MaxItems="50"/>

                        <MudStack Row>
                            <MudItem>
                                <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Get_linkshipper(context.Item)">>>></MudButton>
                            </MudItem>

                            <MudTextField @bind-Value="context.Item.shipper" Label="@Localizer["Shipper"]" Lines="4" Required />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.consignee" Title="@Localizer["Consignee"]" Required="false" CellClass="no-wrap-cell" Hidden="true">
                    <EditTemplate>

                        <MudAutocomplete T="string" @bind-Value="search_Consignee" Label="@Localizer["Consignee"]" 
                        SearchFunc="SearchConsignee" MaxItems="50" AutoFocus="false" />
                        <MudStack Row>
                            <MudItem>
                                <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Get_linkConsignee(context.Item)">>>></MudButton>
                            </MudItem>

                            <MudTextField @bind-Value="context.Item.consignee" Label="@Localizer["Consignee"]" Lines="4" Required />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.notify1" Title="@Localizer["Notify"]" Required="false" CellClass="no-wrap-cell" Hidden="true">
                    <EditTemplate>

                        <MudAutocomplete T="string" @bind-Value="@search_Notify" Label="@Localizer["Notify"]" AutoFocus="false" 
                        SearchFunc="SearchNotify" />
                        <MudStack Row>
                            <MudItem>
                                <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Get_linkNotify(context.Item)">>>></MudButton>
                            </MudItem>

                            <MudTextField @bind-Value="context.Item.notify1" Label="@Localizer["Notify"]" Lines="4" Required />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SaleName" Title="@Localizer["Sale Name"]" Required CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.SaleName" Label="@Localizer["Sale Name"]" Required>
                            @foreach (var item in SaleNames)
                            {
                                <MudSelectItem Value="item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.statusHBL" Title="@Localizer["Status"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.statusHBL" Label="@Localizer["Status"]">
                            @foreach (var item in trangthais)
                            {
                                <MudSelectItem Value="item">@item</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Container" Class="custom-tab" Disabled>
        <ContainerTab HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
    <MudTabPanel Text="Debit" Class="custom-tab">
        <DebitTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty = "false"/>
    </MudTabPanel>
    <MudTabPanel Text="Credit" Class="custom-tab">
        <CreditTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="false"/>
    </MudTabPanel>
    <MudTabPanel Text="Commission" Class="custom-tab">
        <CreditTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="true" />
    </MudTabPanel>
    <MudTabPanel Text="Refund Duty" Class="custom-tab">
        <DebitTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty = "true"/>
    </MudTabPanel>
    <MudTabPanel Text="Theo Dõi Lô Hàng" Class="custom-tab" Disabled>
        <TheoDoiLoHang HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
    <MudTabPanel Text="Map" Class="custom-tab" Disabled>
        <Map HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" />
    </MudTabPanel>
    <MudTabPanel Text="Cược Cont" Class="custom-tab" >
        <CuocCont HBLDetail="hbldetail == null ? new M_HBL() : hbldetail" Customers="Customers" />
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
    M_HBL detail;

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    string usr;
    List<string> trangthais = new List<string>();
    List<string> SaleNames = new List<string>();
    List<string> Shippers = new List<string>();
    List<string> Consignees = new List<string>();
    List<string> Notify = new List<string>();
    List<string> CFS = new List<string>();
    List<string> Warehouse = new List<string>();


    public string type = "";
    string search_shipper ="";
    string search_Consignee = "";
    string search_Notify = "";

    protected async override Task OnInitializedAsync()
    {
        try
        {

            var tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude == "HBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            Shippers = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Consignees = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            Notify = Customers.Select(x => x.EnglishName + "\n" + x.addresstiengviet + "\n" + x.Tel + "\n" + x.Fax).Distinct().ToList();
            CFS = await supsv.GetlistCFS();
            Warehouse = await supsv.GetlistWhouse();
            SaleNames = await supsv.GetListSale();
            type = await shipsv.GetTypeByMBLID(MBLDetail.MblID); // Sea Air Truck HQ
            await Refresh();

        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    M_HBL hbldetail = new M_HBL();
    async Task Refresh()
    {
        try
        {
            hbldetail = null!;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);

            Listdata = await shipsv.GetListHBL(MBLDetail!.MblID);
            ListDebit = await shipsv.GetListDebitALL();
            ListCredit = await shipsv.GetListCreditALL();
            if (Listdata.Count > 0)
                hbldetail = Listdata[0];
        }
        finally
        {
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
        if (mudTable != null && Listdata.Count > 0)
            await mudTable.SetSelectedItemAsync(Listdata[0]);
    }
    MudDataGrid<M_HBL> mudTable;
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "HBL"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        if (type == "SI" || type == "SE")
        {

            var item = new M_HBL
                {
                    bkno = MBLDetail!.Bkno,
                    statusMBL = MBLDetail!.statusMBL,
                    shipper = MBLDetail.Shipper,
                    consignee = MBLDetail.Consignee,
                    notify1 = MBLDetail.Notify1,
                    notify2 = MBLDetail.Notify2,
                    vessel = MBLDetail.Vessel,
                    voy = MBLDetail.Voy,
                    porname = MBLDetail.Porname,
                    porcode = MBLDetail.Porcode,
                    polname = MBLDetail.Polname,
                    polcode = MBLDetail.Polcode,
                    podname = MBLDetail.Podname,
                    podcode = MBLDetail.Podcode,
                    delcode = MBLDetail.Delcode,
                    delName = MBLDetail.Delname,
                    markAndNumbers = MBLDetail.markAndNumbers,
                    NoOfPackages = MBLDetail.NoOfPackages,
                    gross = MBLDetail.Gross,
                    cbm = MBLDetail.CBM,
                    freightPayableAt = MBLDetail.FreightPayableAt,
                    numberOfOriginal = MBLDetail.NumberOfOriginal,
                    placeAndDate = MBLDetail.PlaceAndDate,
                    freightAmount = MBLDetail.FreightAmount,
                    dateLaden = MBLDetail.DateLaden,
                    forDelivery = MBLDetail.ForDelivery,
                    description = MBLDetail.Description,
                    say = MBLDetail.Say,
                    loadStowCount = MBLDetail.LoadStowCount,
                    shipOnboard = MBLDetail.ShipOnboard,
                    CustomerID = MBLDetail.CustomerID,
                    AgentID = MBLDetail.AgentID,
                    Continued = MBLDetail.Continued,
                    editable = MBLDetail.Editable,
                    ETA = MBLDetail.ETA,
                    ETD = MBLDetail.ETD,
                    ActualDelDate = MBLDetail.ActualDelDate,
                    userupdate = usr,
                    dateupdate = DateTime.Now.ToString()
                };
            Listdata.Add(item);
        }
        else if (type == "AI" || type == "AE")
        {
            var item = new M_HBL
                {
                    bkno = MBLDetail!.Bkno,
                    statusMBL = MBLDetail!.statusMBL,
                    shipper = MBLDetail.Shipper,
                    consignee = MBLDetail.Consignee,
                    Air_ShipperAccountNumber = MBLDetail.Air_ShipperAccountNumber,
                    Air_ConsigneeAccountNumber = MBLDetail.Air_ConsigneeAccountNumber,
                    Air_IssuingCarrier = MBLDetail.Air_IssuingCarrier,
                    Air_AccountingInfomation = MBLDetail.Air_AccountingInfomation,
                    Air_AgentIATACode = MBLDetail.Air_AgentIATACode,
                    Air_AccountNo = MBLDetail.Air_AccountNo,
                    Air_AirportofDeparture = MBLDetail.Air_AirportofDeparture,
                    Air_to = MBLDetail.Air_to,
                    Air_ByfirstCarrier = MBLDetail.Air_ByfirstCarrier,
                    Air_to2 = MBLDetail.Air_to2,
                    Air_by2 = MBLDetail.Air_by2,
                    Air_to3 = MBLDetail.Air_to3,
                    Air_by3 = MBLDetail.Air_by3,
                    Air_Currency = MBLDetail.Air_Currency,
                    Air_CHGSCode = MBLDetail.Air_CHGSCode,
                    Air_PPD = MBLDetail.Air_PPD,
                    Air_COLL = MBLDetail.Air_COLL,
                    Air_otherPPD = MBLDetail.Air_otherPPD,
                    Air_otherCOLL = MBLDetail.Air_otherCOLL,
                    Air_DeclaredValuedForCarriage = MBLDetail.Air_DeclaredValuedForCarriage,
                    Air_DeclaredValueForCustoms = MBLDetail.Air_DeclaredValueForCustoms,
                    Air_AirportOfDestination = MBLDetail.Air_AirportOfDestination,
                    Air_FlightDate1 = MBLDetail.Air_FlightDate1,
                    Air_FlightDate2 = MBLDetail.Air_FlightDate2,
                    Air_AmountOfInsurance = MBLDetail.Air_AmountOfInsurance,
                    Air_HandlingInfomation = MBLDetail.Air_HandlingInfomation,
                    Air_NoOfPiecesRCP = MBLDetail.Air_NoOfPiecesRCP,
                    Air_GrossWieght = MBLDetail.Air_GrossWieght,
                    Air_kglb = MBLDetail.Air_kglb,
                    Air_RateClass = MBLDetail.Air_RateClass,
                    Air_CommodityItemNo = MBLDetail.Air_CommodityItemNo,
                    Air_ChargeableWeight = MBLDetail.Air_ChargeableWeight,
                    Air_RateCharge = MBLDetail.Air_RateCharge,
                    Air_Total = MBLDetail.Air_Total,
                    Air_NatureAndquantityOfgoods = MBLDetail.Air_NatureAndquantityOfgoods,
                    Air_WeightCharge_Prepaid = MBLDetail.Air_WeightCharge_Prepaid,
                    Air_WeightCharge_Collect = MBLDetail.Air_WeightCharge_Collect,
                    Air_Valuation_Prepaid = MBLDetail.Air_Valuation_Prepaid,
                    Air_Valuation_Collect = MBLDetail.Air_Valuation_Collect,
                    Air_Tax_Prepaid = MBLDetail.Air_Tax_Prepaid,
                    Air_Tax_Collect = MBLDetail.Air_Tax_Collect,
                    Air_TotalOtherChargesDueAgent_Prepaid = MBLDetail.Air_TotalOtherChargesDueAgent_Prepaid,
                    Air_TotalOtherChargesDueAgent_Collect = MBLDetail.Air_TotalOtherChargesDueAgent_Collect,
                    Air_TotalOtherChargesDueCarrier_Prepaid = MBLDetail.Air_TotalOtherChargesDueCarrier_Prepaid,
                    Air_TotalOtherChargesDueCarrier_Collect = MBLDetail.Air_TotalOtherChargesDueCarrier_Collect,
