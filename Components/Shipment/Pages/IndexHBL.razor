    List<M_Debit> ListDebit = new();
    List<M_Credit> ListCredit = new();
    bool chkUSD = false, chkVAT = false;
    double? TProfit_(Guid id)
    {
        var debit = ListDebit;
        var credit = ListCredit;
        
        debit = ListDebit.Where(x => x.hblid == id).ToList();
        credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
        return totaldebit - totalcredit;
    }
