@using MudBlazor
@using ABFreight.Models

<MudPaper Class="quanly-dc-child-panel pa-2" Elevation="0">
    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>

    <MudTabs Rounded="true" PanelClass="pa-2" Elevation="0" KeepPanelsAlive="false" @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="Debit">
            @if (_activeTab == 0)
            {
                @if (QuanLyCont is not null)
                {
                    <DebitTab_QuanLy @key="@($"child-cont-debit-{QuanLyCont.Id}")"
                                     QuanLyCont="QuanLyCont"
                                     GridHeight="280px" />
                }
                else if (QuanLyTau is not null)
                {
                    <DebitTab_QuanLy @key="@($"child-tau-debit-{QuanLyTau.Id}")"
                                     QuanLyTau="QuanLyTau"
                                     GridHeight="280px" />
                }
            }
        </MudTabPanel>
        <MudTabPanel Text="Credit">
            @if (_activeTab == 1)
            {
                @if (QuanLyCont is not null)
                {
                    <CreDitTab_QuanLy @key="@($"child-cont-credit-{QuanLyCont.Id}")"
                                      QuanLyCont="QuanLyCont"
                                      GridHeight="280px" />
                }
                else if (QuanLyTau is not null)
                {
                    <CreDitTab_QuanLy @key="@($"child-tau-credit-{QuanLyTau.Id}")"
                                      QuanLyTau="QuanLyTau"
                                      GridHeight="280px" />
                }
            }
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    [Parameter] public QuanLy_Cont? QuanLyCont { get; set; }
    [Parameter] public QuanLy_Tau? QuanLyTau { get; set; }
    [Parameter] public string Title { get; set; } = "Debit / Credit";

    private int _activeTab;
}
