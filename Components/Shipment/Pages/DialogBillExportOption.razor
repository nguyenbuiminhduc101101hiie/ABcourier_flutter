@using ABFreight.Models
@using ABFreight.Services
@inject BillSeaLayoutFormService FormService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
            Export Bill - Chọn mẫu @(IsTrang2Mode ? "Trang 2" : BillLayoutFormKindHelper.GetDisplayName(FormKind))
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (AllowTrang2)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Loại xuất</b></MudText>
            <MudRadioGroup T="bool" Value="IsTrang2Mode" ValueChanged="OnExportModeChanged">
                <MudRadio T="bool" Value="false" Color="Color.Primary">
                    Bill @BillLayoutFormKindHelper.GetDisplayName(FormKind)
                </MudRadio>
                <MudRadio T="bool" Value="true" Color="Color.Primary">
                    Trang 2
                </MudRadio>
            </MudRadioGroup>
            <MudDivider Class="my-3" />
        }

        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <b>Mẫu form @(IsTrang2Mode ? "Trang 2" : $"Bill {BillLayoutFormKindHelper.GetDisplayName(FormKind)}")</b>
        </MudText>
        @if (_forms.Count == 0)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                Chưa có form @(IsTrang2Mode ? "Trang 2" : $"Bill {BillLayoutFormKindHelper.GetDisplayName(FormKind)}"). Tạo form tại menu 1.17 trước khi xuất.
            </MudAlert>
        }
        else
        {
            <MudRadioGroup @bind-Value="SelectedLayoutFormId" T="Guid?">
                @foreach (var form in _forms)
                {
                    <MudRadio T="Guid?" Value="@form.BillSeaLayoutFormId" Color="Color.Primary">
                        @form.FormName@(Attach && !IsTrang2Mode && !form.HasAttachForm ? " (chưa có Attach)" : "")
                    </MudRadio>
                }
            </MudRadioGroup>
        }

        @if (IsTrang2Mode)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2 mb-3">
                <b>Trang 2</b> chỉ in nội dung đã tạo tại menu chỉnh layout (ảnh full hoặc text full) — không lấy dữ liệu HBL.
            </MudAlert>
        }
        else if (IsSea && Attach && SelectedForm is not null && !SelectedForm.HasAttachForm)
        {
            <MudAlert Severity="MudBlazor.Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-2 mb-3">
                Form <b>@SelectedForm.FormName</b> chưa có form Attach. Tạo tại menu 1.17.
            </MudAlert>
        }
        else if (IsSea && Attach && SelectedForm is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2 mb-3">
                Chế độ <b>Attach</b> sẽ dùng form Attach của <b>@SelectedForm.FormName</b>.
            </MudAlert>
        }

        @if (!IsTrang2Mode)
        {
            <MudDivider Class="my-3" />

            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Bản in</b></MudText>
            <MudRadioGroup @bind-Value="IsOriginal" T="bool">
                <MudRadio Value="false" Color="Color.Secondary">
                    <MudText>Draft</MudText>
                </MudRadio>
                <MudRadio Value="true" Color="Color.Secondary">
                    <MudText>Original</MudText>
                </MudRadio>
            </MudRadioGroup>

            @if (IsSea)
            {
                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Vessel / Voyage hiển thị</b></MudText>
                <MudRadioGroup @bind-Value="SelectedVesselOption" T="string">
                    <MudRadio Value="@PreCarriageOption" Color="Color.Tertiary">Pre-Carriage</MudRadio>
                    <MudRadio Value="@VesselVoyOption" Color="Color.Tertiary">Vessel &amp; Voy No.</MudRadio>
                </MudRadioGroup>

                <MudCheckBox @bind-Value="Attach"
                             Label="Attach"
                             Color="Color.Primary"
                             Class="mt-2" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanExport)">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" /> Export
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string PreCarriageOption = "precarriage";
    private const string VesselVoyOption   = "vesselvoy";

    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public BillLayoutFormKind FormKind { get; set; } = BillLayoutFormKind.Sea;

    /// <summary>Cho phép chọn thêm option Export Trang 2 (in form đã tạo ở layout editor).</summary>
    [Parameter]
    public bool AllowTrang2 { get; set; } = true;

    private bool IsSea => FormKind == BillLayoutFormKind.Sea;

    private bool IsTrang2Mode { get; set; }
    private bool IsOriginal { get; set; }
    private string SelectedVesselOption { get; set; } = PreCarriageOption;
    private bool Attach { get; set; }
    private Guid? SelectedLayoutFormId { get; set; }
    private List<BillSeaLayoutFormSummary> _forms = new();

    BillSeaLayoutFormSummary? SelectedForm =>
        SelectedLayoutFormId is Guid id
            ? _forms.FirstOrDefault(x => x.BillSeaLayoutFormId == id)
            : null;

    bool CanExport =>
        _forms.Count > 0
        && SelectedLayoutFormId is not null
        && (IsTrang2Mode || !IsSea || !Attach || SelectedForm?.HasAttachForm == true);

    protected override async Task OnInitializedAsync()
    {
        await ReloadFormsAsync();
    }

    async Task OnExportModeChanged(bool trang2)
    {
        if (IsTrang2Mode == trang2)
            return;

        IsTrang2Mode = trang2;
        if (trang2)
            Attach = false;
        await ReloadFormsAsync();
    }

    async Task ReloadFormsAsync()
    {
        var kind = IsTrang2Mode ? BillLayoutFormKind.Trang2 : FormKind;
        _forms = await FormService.ListFormsAsync(kind);
        SelectedLayoutFormId = _forms.Count > 0 ? _forms[0].BillSeaLayoutFormId : null;
    }

    private void Submit()
    {
        if (!CanExport)
            return;

        bool showPreCarriage = SelectedVesselOption == PreCarriageOption;
        MudDialog.Close(DialogResult.Ok(new BillExportOptions
        {
            IsOriginal = IsOriginal,
            ShowPreCarriage = showPreCarriage,
            Attach = !IsTrang2Mode && IsSea && Attach,
            LayoutFormId = SelectedLayoutFormId,
            IsTrang2 = IsTrang2Mode
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    public class BillExportOptions
    {
        public bool IsOriginal { get; set; }
        public bool ShowPreCarriage { get; set; } = true;
        public bool Attach { get; set; }
        public Guid? LayoutFormId { get; set; }
        public bool IsTrang2 { get; set; }
    }
}
