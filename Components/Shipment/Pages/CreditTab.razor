    private IEnumerable<M_Container> GetContainerSourceForCurrentShipment()
    {
        if (isMBL && MBLDetail != null && MBLDetail.MblID != Guid.Empty)
            return Conts.Where(x => x.mblid == MBLDetail.MblID);

        if (!isMBL && HBLDetail != null && HBLDetail.hblID != Guid.Empty)
            return Conts.Where(x => x.hblid == HBLDetail.hblID);

        return Enumerable.Empty<M_Container>();
    }

    private Task<IEnumerable<string?>> SearchContainerNo(string? text)
    {
        var items = GetContainerSourceForCurrentShipment()
            .Where(x => !string.IsNullOrWhiteSpace(x.CONTAINER_NO))
            .Select(x => x.CONTAINER_NO!.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<string?>>(items);

        var keyword = text.Trim();
        return Task.FromResult<IEnumerable<string?>>(items.Where(x => x.Contains(keyword, StringComparison.OrdinalIgnoreCase)));
    }

    bool EnsureCanMutateCredit()
    {
        if (IsCreditCompletedLocked)
        {
            CallSnackBar("Credit đã xác nhận hoàn thành. Bỏ xác nhận để thao tác.", MudBlazor.Severity.Warning);
            return false;
        }
        return true;
    }

    async Task ToggleCreditCompleted()
    {
        if (isMBL || HBLDetail == null || HBLDetail.hblID == Guid.Empty)
        {
            CallSnackBar("Vui lòng chọn 1 dòng HBL.", MudBlazor.Severity.Warning);
            return;
        }

        var next = !(HBLDetail.creditCompleted == true);
        var msg = next
            ? "Xác nhận hoàn thành Credit của HBL này? Sau khi xác nhận sẽ không thể thêm/sửa/xóa Credit."
            : "Bỏ xác nhận hoàn thành Credit? Bạn sẽ thao tác Credit được trở lại.";
        var ok = await DialogService.ShowMessageBox("Xác nhận", msg, yesText: "Đồng ý", cancelText: "Hủy");
        if (ok != true) return;

        try
        {
            _togglingCompleted = true;
            var rs = await shipsv.SetHblDebitCreditCompleted(HBLDetail.hblID, creditCompleted: next);
            if (rs.Flag)
            {
                HBLDetail.creditCompleted = next;
                CallSnackBar(rs.Message, MudBlazor.Severity.Success);
            }
            else
                CallSnackBar(rs.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _togglingCompleted = false;
        }
    }
