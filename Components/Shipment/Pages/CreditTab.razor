                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required
                        SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.DNTT" Title="@Localizer["DNTT"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.DNTT" @bind-Value="context.Item.DNTT" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.dongia" Class="text-right"
                        Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.type" Title="@Localizer["Type"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.type"
                        @bind-Value:after="@(() => ApplyQuantityByType(context.Item))"
                        Label="@Localizer["Type"]" Required
                        SearchFunc="SearchType" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.soluong"
                        Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtien" Label="@Localizer["Total Price"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>


           
                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.tiente" Label="@Localizer["Currency"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thue" Label="@Localizer["VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtiensauthue" Label="@Localizer["Total Price Inc. VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.tigiacredit" Title="@Localizer["Exchange Rate Credit"]" Format="#,##0.##"  Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>

                            <MudNumericField @bind-Value="context.Item.tigiacredit"
                                             Label="@Localizer["Exchange Rate Credit"]"
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                           
                                             Class="text-right" />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.tigiahoadondauvao" Title="@Localizer["Exchange Rate Invoice"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia_invoice(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>

                            <MudNumericField @bind-Value="context.Item.tigiahoadondauvao"
                                             Label="@Localizer["Exchange Rate Invoice"]"
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                             Class="text-right" />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ContainerNo" Title="@Localizer["Cont. No."]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete T="string"
                                         @bind-Value="context.Item.ContainerNo"
                                         Label="@Localizer["Cont. No."]"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         Clearable
                                         Strict="false"
                                         ResetValueOnEmptyText="true"
                                         SearchFunc="SearchContainerNo" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.ghichu_credit" Title="@Localizer["Notes"]" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.ghichu_credit" Label="@Localizer["Notes"]" Placeholder="Notes..."
                                      Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Notes"
                                      InputType="InputType.Text" Lines="3" />
                    </EditTemplate>
                </PropertyColumn>
    
                <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false">
                    <EditTemplate></EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
        @if(Listdata.Count > 0)
        {
            <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
                <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true" Style="margin-right:20px;">Total Inc. VAT: @(Listdata.Sum(x => x.thanhtiensauthue / (x.tiente == "VND" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en)) USD</MudText>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">Total Inc. VAT: @(Listdata.Sum(x => x.thanhtiensauthue * (x.tiente == "USD" ? x.tigiacredit : 1))!.Value.ToString("#,##0.##", _en)) VND</MudText>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">Total Hóa đơn:  @(ListdataHoaDon.Sum(x => x.thanhtiensauthue)!.Value.ToString("#,##0.##", _en)) VND</MudText>
            </MudStack>
        }
    </MudTabPanel>
    @if (!isCommission)
    {
        <MudTabPanel Text="Hóa Đơn Đầu Vào" Class="custom-tab" Disabled>
            @if (isMBL)
            {
                <HoaDonDauVao MBLDetail="MBLDetail ==  null ? new M_MBL() : MBLDetail" Customers="Customers"/>
            }
            else
            {
                <HoaDonDauVao HBLDetail="HBLDetail ==  null ? new M_HBL() : HBLDetail" Customers="Customers" />
            }
        </MudTabPanel>
    }
</MudTabs>
@code {
    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [Parameter] public string Type { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public bool isCommission { get; set; }
    [Parameter] public EventCallback<int> OnDataCountChanged { get; set; }
    M_Credit detail_credit;

    bool IsCreditParentMissing => isMBL
        ? (MBLDetail?.MblID ?? Guid.Empty) == Guid.Empty
        : (HBLDetail?.hblID ?? Guid.Empty) == Guid.Empty;
    bool IsCreditCompletedLocked => !isMBL && HBLDetail?.creditCompleted == true;
    bool CanMutateCreditData => !IsCreditParentMissing && !IsCreditCompletedLocked;
    bool _togglingCompleted;

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private bool _processingUpload = false;
    private async Task ExportBill()
    {
        try
        {
            var cur_type = await ResolveCurrencyAsync();
            if (cur_type is null) return;

            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);

            var credits = isMBL
                ? (await shipsv.GetListCreditMBL(MBLDetail!.MblID))
                : (await shipsv.GetListCreditHBL(HBLDetail!.hblID, isCommission));
            if (!credits.Any())
            {
                CallSnackBar("Không tìm thấy dữ liệu credit để export.", MudBlazor.Severity.Warning);
                return;
            }

            var hblIds = credits
                .Where(x => x.hblid != Guid.Empty)
                .Select(x => x.hblid)
                .Distinct()
                .ToList();
            var hblInfos = new List<M_HBL>();
            foreach (var hblId in hblIds)
            {
                var hblInfo = await shipsv.GetHBL_byHBLid(hblId);
                if (hblInfo.hblID != Guid.Empty)
                {
                    hblInfos.Add(hblInfo);
                }
            }
            if (!hblInfos.Any() && !isMBL && HBLDetail != null && HBLDetail.hblID != Guid.Empty)
            {
                hblInfos.Add(HBLDetail);
            }
            if (!hblInfos.Any())
            {
                CallSnackBar("Không tìm thấy HBL cho credit đã chọn.", MudBlazor.Severity.Warning);
                return;
            }

            var rs = await shipsv.ExportCreditSI(credits, hblInfos, cur_type);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
    private async Task<string?> ResolveBranchByCompanyAsync(string billType)
    {
        var companyOptions = await gsv.GetCompanyOtherList();
        var branchesByCompany = companyOptions
            .Where(x => string.Equals(x.Code?.Trim(), billType.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Branches?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!branchesByCompany.Any())
        {
            return string.Empty;
        }

        if (branchesByCompany.Count == 1)
        {
            return branchesByCompany[0]!;
        }

        var branchDialogOptions = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true,
            DisableBackdropClick = true
        };
        var branchParameters = new DialogParameters<Shipment.Pages.DialogBranchOption>
        {
            { x => x.BranchOptions, branchesByCompany! }
        };
        var branchDialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogBranchOption>("Credit - Chon Branch", branchParameters, branchDialogOptions);
        var branchResult = await branchDialogRef.Result;
        if (branchResult.Canceled)
        {
            return null;
        }
        return branchResult.Data?.ToString() ?? string.Empty;
    }
    private async Task<string?> ResolveCurrencyAsync()
    {
        var defaultCurrency = Listdata.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.tiente))?.tiente ?? "VND";
        var currencyDialogOptions = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true,
            DisableBackdropClick = true
        };
        var currencyDialogParameters = new DialogParameters<Shipment.Pages.DialogCurrencyOption>
        {
            { x => x.DefaultCurrency, defaultCurrency }
        };
        var currencyDialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogCurrencyOption>("Credit - Chon Currency", currencyDialogParameters, currencyDialogOptions);
        var currencyResult = await currencyDialogRef.Result;
        if (currencyResult.Canceled)
        {
            return null;
        }
        return currencyResult.Data?.ToString() ?? "VND";
    }
    private void Submit()
    {
        MudDialog!.Close();
    }
    bool isMBL;
    void Cancel() => MudDialog!.Cancel();
    string usr, type;
    List<ChargeModel> charges = new List<ChargeModel>();
    List<string> Types = new List<string>();
    List<string> currs = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        try
        {


            isMBL = MBLDetail == null ? false : true;
            if (isMBL)
            {
                if (MBLDetail.MblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng MBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            else
            {
                if (HBLDetail.hblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            currs = await Vcbsv.GetCur();
            charges = await supsv.GetListCharge(isCommission);
            Types = await shipsv.GetListTypeInDebitCredit();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            type = await shipsv.GetTypeByMBLID(isMBL ? MBLDetail!.MblID : HBLDetail!.mblid); // Sea Air Truck HQ
            Conts = shipsv.GetListContainerAll();
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }
    bool _loading = false;
    List<M_Credit> Listdata = new List<M_Credit>();
    List<M_Container> Conts = new();
    List<M_HoaDonDauVao> ListdataHoaDon = new List<M_HoaDonDauVao>();
    M_Credit detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "MBL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
            {
                Listdata = await shipsv.GetListCreditMBL(MBLDetail!.MblID);
                ListdataHoaDon = await shipsv.GetListHoaDonDauVaoMBL(MBLDetail!.MblID);
            }
            else
            {
                Listdata = await shipsv.GetListCreditHBL(HBLDetail!.hblID, isCommission);
                ListdataHoaDon = await shipsv.GetListHoaDonDauVaoHBL(HBLDetail!.hblID);
            }
            if (OnDataCountChanged.HasDelegate)
                await OnDataCountChanged.InvokeAsync(Listdata?.Count ?? 0);

        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Credit> mudTable;
    async Task AddItem()
    {
        if (!EnsureCanMutateCredit()) return;
        var item = new M_Credit();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }
    async Task DeleteItem(M_Credit item)
    {
        if (!EnsureCanMutateCredit()) return;
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar("This Credit is approved!", MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteCreditMBL(item);
            await HistoryLogService.LogAsync(usr, "Delete Credits", "Shipment", item.creditid, "", new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_Credit item)
    {
        if (!EnsureCanMutateCredit()) return;
