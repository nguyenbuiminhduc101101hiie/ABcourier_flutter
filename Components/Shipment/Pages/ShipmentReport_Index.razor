    /// <summary>
    /// 1 = đúng hạn, 0 = trễ, 2 = chưa đánh giá được (Pending / Cancelled / chưa có ngày giao thực tế hoặc ngày mốc).
    /// Hàng biển / hàng không, cả xuất và nhập (SE, AE, SI, AI), so ngày giao thực tế với ETA;
    /// Truck, Customs và loại khác so với ETD.
    /// Chỉ so phần ngày, bỏ phần giờ.
    /// </summary>
    int CheckOnTime(M_HBL item)
    {
        if (item == null)
            return 2;
        var status = item.statusHBL ?? string.Empty;
        if (status.Contains("Pending", StringComparison.OrdinalIgnoreCase)
            || status.Contains("Cancel", StringComparison.OrdinalIgnoreCase))
            return 2;
        if (item.ActualDelDate == null)
            return 2;

        var type = (GetJob(item)?.Loai ?? string.Empty).Trim().ToUpperInvariant();
        var compareWithEta = type is "SE" or "AE" or "SI" or "AI";
        var target = compareWithEta ? item.ETA : item.ETD;
        if (target == null)
            return 2;

        return item.ActualDelDate.Value.Date <= target.Value.Date ? 1 : 0;
    }
    private static bool IsVietnamese =>
        CultureInfo.CurrentUICulture.Name.StartsWith("vi", StringComparison.OrdinalIgnoreCase);

    /// <summary>Lấy bản dịch theo khóa; khóa chưa có trong bảng dịch thì dùng câu mặc định theo ngôn ngữ.</summary>
    string T(string key, string vi, string en)
    {
        var s = Localizer[key];
        return s.ResourceNotFound || string.IsNullOrWhiteSpace(s.Value) ? (IsVietnamese ? vi : en) : s.Value;
    }

    /// <summary>Chú thích khi rê chuột lên ✔ / ✘: ngày giao thực tế so với ngày mốc nào.</summary>
    string OnTimeHint(M_HBL item)
    {
        var type = (GetJob(item)?.Loai ?? string.Empty).Trim().ToUpperInvariant();
        var useEta = type is "SE" or "AE" or "SI" or "AI";
        var target = useEta ? item.ETA : item.ETD;
        var label = useEta ? "ETA" : "ETD";
        if (item.ActualDelDate == null || target == null)
            return string.Empty;
        var cmp = item.ActualDelDate.Value.Date <= target.Value.Date ? "≤" : ">";
        return $"ADD {formatDate(item.ActualDelDate)} {cmp} {label} {formatDate(target)}";
    }

