    /// <summary>Tính lại 3 biểu đồ. Gọi sau khi tải dữ liệu và khi đổi USD/VND hoặc VAT.</summary>
    void RebuildCharts()
    {
        Series = new List<ChartSeries>();
        if (Listdata.Count == 0)
        {
            labelsStatus = Array.Empty<string>();
            dataStatus = Array.Empty<double>();
            dataIssue = new double[] { 0, 0, 0, 0 };
            XAxisLabels = Array.Empty<string>();
            return;
        }

        var groupedLoai = Listdata
            .Where(x => !string.IsNullOrEmpty(x.statusHBL))
            .GroupBy(x => x.statusHBL)
            .Select(g => new { statusHBL = g.Key, SoLuong = g.Count() })
            .ToList();

        labelsStatus = groupedLoai.Select(x => x.statusHBL).ToArray()!;
        dataStatus = groupedLoai.Select(x => (double)x.SoLuong).ToArray();

        dataIssue = new double[]
        {
            Listdata.Count(x => x.issueinvoice == true),
            Listdata.Count(x => x.dathudebit == true),
            Listdata.Count(x => x.dachicredit == true),
            Listdata.Count(x => x.dathuchidaily == true)
        };

        // Biểu đồ lợi nhuận theo tháng (tối thiểu 4 tháng)
        var withDate = Listdata.Where(x => x.datereport.HasValue).ToList();
        if (withDate.Count == 0)
        {
            XAxisLabels = Array.Empty<string>();
            return;
        }
        var maxDate = withDate.Max(x => x.datereport!.Value);
        var months = withDate
            .Select(x => new DateTime(x.datereport!.Value.Year, x.datereport.Value.Month, 1))
            .Distinct()
            .OrderBy(x => x)
            .ToList();
        while (months.Count < 4)
        {
            var first = months.Count > 0 ? months[0] : new DateTime(maxDate.Year, maxDate.Month, 1);
            months.Insert(0, first.AddMonths(-1));
        }
        // Kèm năm để không lẫn khi khoảng ngày vắt qua năm
        XAxisLabels = months.Select(m => m.ToString("MM/yy")).ToArray();

        var profitPerMonth = months.Select(month => withDate
                .Where(x => x.datereport!.Value.Year == month.Year && x.datereport.Value.Month == month.Month)
                .Sum(x => TProfit_(x.hblID, "") ?? 0))
            .ToArray();

        Series.Add(new ChartSeries
        {
            Name = $"Profit ({(chkUSD ? "USD" : "VND")})",
            Data = profitPerMonth
        });
    }
