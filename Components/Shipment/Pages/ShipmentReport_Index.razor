    /// <summary>Một chứng từ gắn với HBL (số HĐ điện tử, phiếu thu, phiếu chi).</summary>
    sealed record ShipmentDocRef(Guid Id, string No, bool Approved);

    /// <summary>Chứng từ theo HBL (key = hblID).</summary>
    sealed class ShipmentDocRefs
    {
        public Dictionary<Guid, List<ShipmentDocRef>> Invoices { get; } = new();
        public Dictionary<Guid, List<ShipmentDocRef>> Receipts { get; } = new();
        public Dictionary<Guid, List<ShipmentDocRef>> Payments { get; } = new();

        public static IReadOnlyList<ShipmentDocRef> Get(Dictionary<Guid, List<ShipmentDocRef>> map, Guid hblId) =>
            map.TryGetValue(hblId, out var list) ? list : Array.Empty<ShipmentDocRef>();
    }

    static readonly char[] DocNoSeparators = { ',', ';', '/', '|', ' ', '\t', '\r', '\n' };

    static IEnumerable<string> SplitDocNos(string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? Enumerable.Empty<string>()
            : text.Split(DocNoSeparators, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// Số HĐ điện tử, phiếu thu, phiếu chi theo từng HBL.
    /// - HĐ điện tử: HoaDonDauRa.sohoadonDientu của HBL.
    /// - Phiếu thu: Debit.PhieuthuID của HBL, cộng phiếu thu có BillNo chứa đúng số HBL.
    /// - Phiếu chi: phiếu chi có ô HBL chứa đúng số HBL (phiếu chi không có khoá ngoại tới HBL).
    /// </summary>
    async Task<ShipmentDocRefs> LoadDocRefsAsync(List<M_HBL> hbls, IEnumerable<M_Debit>? debits)
    {
        const int chunkSize = 1000;
        var result = new ShipmentDocRefs();
        if (hbls == null || hbls.Count == 0)
            return result;

        var hblIds = hbls.Select(x => x.hblID).Where(id => id != Guid.Empty).Distinct().ToList();
        var hblIdByNo = hbls
            .Where(x => !string.IsNullOrWhiteSpace(x.hbl))
            .GroupBy(x => x.hbl!.Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Select(x => x.hblID).Distinct().ToList(), StringComparer.OrdinalIgnoreCase);

        static void Add(Dictionary<Guid, List<ShipmentDocRef>> map, Guid hblId, ShipmentDocRef doc)
        {
            if (!map.TryGetValue(hblId, out var list))
                map[hblId] = list = new List<ShipmentDocRef>();
            if (!list.Any(x => x.Id == doc.Id && string.Equals(x.No, doc.No, StringComparison.OrdinalIgnoreCase)))
                list.Add(doc);
        }

        await using var ctx = await DbFactory.CreateDbContextAsync();

        // 1) Số hoá đơn điện tử
        foreach (var chunk in hblIds.Chunk(chunkSize))
        {
            var ids = chunk.ToList();
            var rows = await ctx.HoaDonDauRa.AsNoTracking()
                .Where(x => x.continued == true && ids.Contains(x.hblid)
                            && x.sohoadonDientu != null && x.sohoadonDientu != "")
                .Select(x => new { x.hblid, x.sohoadonDientu })
                .Distinct()
                .ToListAsync();
            foreach (var r in rows)
                Add(result.Invoices, r.hblid, new ShipmentDocRef(r.hblid, r.sohoadonDientu!.Trim(), true));
        }

        // 2) Phiếu thu liên kết qua Debit.PhieuthuID
        var receiptHbls = (debits ?? Enumerable.Empty<M_Debit>())
            .Where(d => d.PhieuthuID.HasValue && d.PhieuthuID.Value != Guid.Empty)
            .Select(d => new { d.hblid, PhieuthuID = d.PhieuthuID!.Value })
            .Distinct()
            .ToList();
        var receiptById = new Dictionary<Guid, (string No, bool Approved)>();
        foreach (var chunk in receiptHbls.Select(x => x.PhieuthuID).Distinct().Chunk(chunkSize))
        {
            var ids = chunk.ToList();
            var rows = await ctx.Phieuthu.AsNoTracking()
                .Where(x => ids.Contains(x.PhieuthuID))
                .Select(x => new { x.PhieuthuID, x.SoPhieuthu, x.Approve })
                .ToListAsync();
            foreach (var r in rows)
                receiptById[r.PhieuthuID] = (r.SoPhieuthu ?? string.Empty, r.Approve == true);
        }
        foreach (var r in receiptHbls)
            if (receiptById.TryGetValue(r.PhieuthuID, out var p) && !string.IsNullOrWhiteSpace(p.No))
                Add(result.Receipts, r.hblid, new ShipmentDocRef(r.PhieuthuID, p.No.Trim(), p.Approved));

        if (hblIdByNo.Count > 0)
        {
            //    + phiếu thu cũ chỉ ghi số HBL trong BillNo
            var billRows = await ctx.Phieuthu.AsNoTracking()
                .Where(x => x.BillNo != null && x.BillNo != "" && x.SoPhieuthu != null && x.SoPhieuthu != "")
                .Select(x => new { x.PhieuthuID, x.SoPhieuthu, x.BillNo, x.Approve })
                .ToListAsync();
            foreach (var r in billRows)
                foreach (var no in SplitDocNos(r.BillNo))
                    if (hblIdByNo.TryGetValue(no, out var ids))
                        foreach (var id in ids)
                            Add(result.Receipts, id, new ShipmentDocRef(r.PhieuthuID, r.SoPhieuthu!.Trim(), r.Approve == true));

            // 3) Phiếu chi theo ô HBL
            var payRows = await ctx.Phieuchi.AsNoTracking()
                .Where(x => x.Hbl != null && x.Hbl != "" && x.Sophieuchi != null && x.Sophieuchi != "")
                .Select(x => new { x.PhieuchiID, x.Sophieuchi, x.Hbl, x.Approve })
                .ToListAsync();
            foreach (var r in payRows)
                foreach (var no in SplitDocNos(r.Hbl))
                    if (hblIdByNo.TryGetValue(no, out var ids))
                        foreach (var id in ids)
                            Add(result.Payments, id, new ShipmentDocRef(r.PhieuchiID, r.Sophieuchi!.Trim(), r.Approve == true));
        }

        foreach (var map in new[] { result.Invoices, result.Receipts, result.Payments })
            foreach (var key in map.Keys.ToList())
                map[key] = map[key].OrderBy(x => x.No, StringComparer.OrdinalIgnoreCase).ToList();

        return result;
    }

    static string DocNos(Dictionary<Guid, List<ShipmentDocRef>> map, Guid hblId) =>
        string.Join(", ", ShipmentDocRefs.Get(map, hblId).Select(x => x.No));

