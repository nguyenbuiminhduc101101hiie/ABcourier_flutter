    }

    // Lỗ (profit < 0) tô đỏ, còn lại xanh
    private Func<M_HBL, string> _cellStyleFunc => x =>
        (TProfit_(x.hblID, "") ?? 0) < 0 ? "color: #FF5733" : "color: #087210";

    string formatDate(DateTime? date)
    {
        if(date == null)
            return string.Empty;
        return date.Value.ToString("dd/MMM/yyyy");
    }
    bool chkPending = false, chkDeli = false, chkCancel = false, ChkOnTime = false, ChkLate = false, chkVAT = false, chkUSD = true;

    private Guid _searchCus;

    // Quy tắc lọc: trong cùng một nhóm là HOẶC, giữa các nhóm là VÀ.
    // Ví dụ chọn SI + "Đã xuất HĐ" => các lô SI ĐÃ xuất HĐ (trước đây ra SI HOẶC đã xuất HĐ).
    string _fHbl = string.Empty, _fRef = string.Empty, _fMbl = string.Empty;

    // ---------- Chọn cột hiển thị (lưu theo trình duyệt) ----------
    const string ColsStorageKey = "rpt242.hiddenCols";
    static readonly string[] DefaultHiddenCols = { "ref", "mbl", "booking" };
    HashSet<string> _hiddenCols = new(DefaultHiddenCols);

    List<(string Key, string Label)> ColumnDefs => new()
    {
        ("ref", "Ref (Job No)"), ("mbl", "MBL"), ("booking", T("Rpt242_BookingNo", "Số Booking", "Booking No.")),
        ("customer", Localizer["Customer"]), ("debitparties", T("Rpt242_DebitParties", "Đối tượng Debit", "Debit Parties")),
        ("creditparties", T("Rpt242_CreditParties", "Đối tượng Credit", "Credit Parties")),
        ("agent", "Agent"), ("carrier", "Carrier"), ("polpod", "POL/POD"), ("service", Localizer["Service Type"]),
        ("cargo", T("Rpt242_CargoKind", "Loại hàng", "Freight / NVOCC")), ("etd", "ETD"), ("eta", "ETA"),
        ("add", T("Rpt242_ActualDeliveryDate", "Ngày giao (ADD)", "Actual Delivery (ADD)")), ("status", Localizer["Status"]),
        ("debit", "Debit"), ("credit", "Credit"),
        ("debitdue", T("Rpt242_DebitDue", "Còn nợ Debit", "Debit outstanding")), ("creditdue", T("Rpt242_CreditDue", "Còn nợ Credit", "Credit outstanding")),
        ("profit", "Profit"), ("profitnvocc", "Profit NVOCC"), ("ontime", "On Time"),
        ("einvoice", T("Rpt242_EInvoiceNo", "Số HĐ online", "E-Invoice No.")), ("receipt", T("Rpt242_ReceiptNo", "Số phiếu thu", "Receipt No.")),
        ("payment", T("Rpt242_PaymentNo", "Số phiếu chi", "Payment No."))
    };

    string HiddenColsCss => _hiddenCols.Count == 0
        ? string.Empty
        : string.Join(",", _hiddenCols.Select(k => $".rpt242-grid .rc-{k}")) + "{display:none !important;}";

    async Task SetColumnVisible(string key, bool visible)
    {
        if (visible) _hiddenCols.Remove(key); else _hiddenCols.Add(key);
        if (!visible && key == "ref") _fRef = string.Empty;   // cột ẩn thì bỏ điều kiện lọc của cột đó
        if (!visible && key == "mbl") _fMbl = string.Empty;
        await SaveColumnsAsync();
    }

    async Task SetAllColumns(bool visible)
    {
        _hiddenCols = visible ? new() : ColumnDefs.Select(c => c.Key).ToHashSet();
        await SaveColumnsAsync();
    }

    async Task ResetColumns()
    {
        _hiddenCols = new(DefaultHiddenCols);
        _fRef = _fMbl = string.Empty;
        await SaveColumnsAsync();
    }

    async Task SaveColumnsAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", ColsStorageKey, string.Join(",", _hiddenCols)); }
        catch { /* trình duyệt chặn localStorage thì chỉ nhớ trong phiên */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var savedOf = await JS.InvokeAsync<string?>("localStorage.getItem", OfStorageKey);
            if (!string.IsNullOrEmpty(savedOf))
            {
                _ofCodes = new HashSet<string>(savedOf.Split('\u001f', StringSplitOptions.RemoveEmptyEntries), StringComparer.OrdinalIgnoreCase);
                _ofChargeIds = null;
                StateHasChanged();
            }
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ColsStorageKey);
            if (saved != null)
            {
                var valid = ColumnDefs.Select(c => c.Key).ToHashSet();
                _hiddenCols = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).Where(valid.Contains).ToHashSet();
                StateHasChanged();
            }
        }
        catch { }
    }

    static bool Like(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || (value?.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    private Func<M_HBL, bool> _quickFilter => x =>
    {
        // Nhóm 1: trạng thái lô hàng
        bool anyStatus = chkDeli || chkPending || chkCancel;
        bool matchStatus = !anyStatus
            || (chkDeli && x.statusHBL?.Contains("Deli", StringComparison.OrdinalIgnoreCase) == true)
            || (chkPending && x.statusHBL?.Contains("Pending", StringComparison.OrdinalIgnoreCase) == true)
            || (chkCancel && x.statusHBL?.Contains("Cancel", StringComparison.OrdinalIgnoreCase) == true);

        // Nhóm 2: đúng hạn / trễ hạn
        bool anyOnTime = ChkOnTime || ChkLate;
        bool matchOnTime = !anyOnTime
            || (ChkOnTime && CheckOnTime(x) == 1)
            || (ChkLate && CheckOnTime(x) == 0);

        // Nhóm 3: loại dịch vụ
        var loai = GetJob(x)?.Loai;
        bool anyType = chkSI || chkSE || chkAI || chkAE || chkTruck || chkCustoms;
        bool matchType = !anyType
            || (chkSI && loai?.Equals("SI", StringComparison.OrdinalIgnoreCase) == true)
            || (chkSE && loai?.Equals("SE", StringComparison.OrdinalIgnoreCase) == true)
            || (chkAI && loai?.Equals("AI", StringComparison.OrdinalIgnoreCase) == true)
            || (chkAE && loai?.Equals("AE", StringComparison.OrdinalIgnoreCase) == true)
            || (chkTruck && loai?.Equals("Truck", StringComparison.OrdinalIgnoreCase) == true)
            || (chkCustoms && loai?.Equals("Customs", StringComparison.OrdinalIgnoreCase) == true);

        // Nhóm 4: tình trạng tài chính
        bool anyFinance = chkInvIssued || chkDebitReceived || chkSpentCredit || chkReceivedSpentAgent;
        bool matchFinance = !anyFinance
            || (chkInvIssued && x.issueinvoice == true)
            || (chkDebitReceived && x.dathudebit == true)
            || (chkSpentCredit && x.dachicredit == true)
            || (chkReceivedSpentAgent && x.dathuchidaily == true);

        // Nhóm 5: khách hàng
        bool matchSearch = _searchCus == Guid.Empty || x.CustomerID == _searchCus;

        // Nhóm 6: ô lọc nhanh dưới tiêu đề HBL / Ref / MBL
        bool matchCols = Like(x.hbl, _fHbl) && Like(RefNo(x), _fRef) && Like(MblNo(x), _fMbl);

        return matchStatus && matchOnTime && matchType && matchFinance && matchSearch && matchCols;
    };

    DateRange frmtoDate = new DateRange(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-4),
                                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1));
    string CusidtoCusCode(Guid cusid)
    {
        var rs = Customers?.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs.CodeName();
    }
    string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
