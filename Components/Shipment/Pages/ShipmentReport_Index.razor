    {
        mblById = MBLs.GroupBy(x => x.MblID).ToDictionary(g => g.Key, g => g.First());
        jobById = Jobs.GroupBy(x => x.JobID).ToDictionary(g => g.Key, g => g.First());
        debitByHbl = ListDebit.ToLookup(x => x.hblid);
        creditByHbl = ListCredit.ToLookup(x => x.hblid);
    }

    async Task Refresh(DateRange frmtoDate)
    {
        try
        {
            _loading = true;
            // Xoá toàn bộ dữ liệu cũ để không còn sót MBL/Job/Debit/Credit của lần tìm trước
            ResetData();
            StateHasChanged();
            if (!await ssv.CheckPermission(usr, "View", "Shipment"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            var hbls = await shipsv.GetListHBLDateRange(frmtoDate);
            if (hbls.Count > 0)
            {
                MBLs = await shipsv.GetListMBLHBLs(hbls);
                ListDebit = await shipsv.GetListDebitHBLs(hbls);
                ListCredit = await shipsv.GetListCreditHBLs(hbls);
                if (MBLs.Count > 0)
                    Jobs = await shipsv.GetListJobByMBLs(MBLs);
                try
                {
                    _docRefs = await LoadDocRefsAsync(hbls, ListDebit);
                }
                catch (Exception ex)
                {
                    // Không để lỗi tra chứng từ làm hỏng cả báo cáo
                    CallSnackBar(ex.Message, MudBlazor.Severity.Warning);
                }
                try
                {
                    carrierByBookingNo = await LoadBookingCarriersAsync(hbls);
                }
                catch (Exception ex)
                {
                    CallSnackBar(ex.Message, MudBlazor.Severity.Warning);
                }
            }

            BuildLookups();
            Listdata = hbls;
            RebuildCharts();
        }
        catch(Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_HBL> mudTable;

