    /// <summary>Phí OF (cước biển): mã hoặc tên phí là OF / O/F / OCF, hoặc tên chứa "OCEAN FREIGHT".</summary>
    HashSet<Guid>? _ofChargeIds;
    HashSet<Guid> OfChargeIds => _ofChargeIds ??= OfCharges.Select(c => c.CHARGE_ID).ToHashSet();

    // Mã phí (CHARGE_CODE) người dùng chọn để tính Profit NVOCC; trống = tự nhận. Lưu theo trình duyệt.
    const string OfStorageKey = "rpt242.ofCodes";
    HashSet<string> _ofCodes = new(StringComparer.OrdinalIgnoreCase);
    string _ofSearch = string.Empty;

    /// <summary>Các phí được tính là cước OF: theo mã đã chọn, chưa chọn thì tự nhận theo mã / tên phí.</summary>
    List<ChargeModel> OfCharges => _ofCodes.Count > 0
        ? charges.Where(c => !string.IsNullOrWhiteSpace(c.CHARGE_CODE) && _ofCodes.Contains(c.CHARGE_CODE.Trim())).ToList()
        : charges.Where(c => IsOfCode(c.CHARGE_CODE) || IsOfName(c.CHARGE)).ToList();

    bool IsOfSelected(ChargeModel c) => _ofCodes.Count > 0
        ? _ofCodes.Contains((c.CHARGE_CODE ?? "").Trim())
        : IsOfCode(c.CHARGE_CODE) || IsOfName(c.CHARGE);

    /// <summary>Danh sách phí để chọn: phí đang tính OF lên đầu, lọc theo ô tìm.</summary>
    IEnumerable<ChargeModel> OfPickList => charges
        .Where(c => !string.IsNullOrWhiteSpace(c.CHARGE_CODE))
        .GroupBy(c => c.CHARGE_CODE!.Trim(), StringComparer.OrdinalIgnoreCase).Select(g => g.First())
        .Where(c => string.IsNullOrWhiteSpace(_ofSearch)
                    || (c.CHARGE_CODE?.Contains(_ofSearch.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.CHARGE?.Contains(_ofSearch.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(IsOfSelected).ThenBy(c => c.CHARGE_CODE)
        .Take(200);

    async Task SetOfCode(ChargeModel c, bool selected)
    {
        // Lần đầu chọn tay: bắt đầu từ các mã đang tự nhận để không mất lựa chọn hiện tại
        if (_ofCodes.Count == 0)
            foreach (var a in charges.Where(x => IsOfCode(x.CHARGE_CODE) || IsOfName(x.CHARGE)))
                if (!string.IsNullOrWhiteSpace(a.CHARGE_CODE)) _ofCodes.Add(a.CHARGE_CODE.Trim());
        var code = (c.CHARGE_CODE ?? "").Trim();
        if (selected) _ofCodes.Add(code); else _ofCodes.Remove(code);
        _ofChargeIds = null;
        await SaveOfCodesAsync();
    }

    async Task UseAutoOf()
    {
        _ofCodes.Clear();
        _ofChargeIds = null;
        await SaveOfCodesAsync();
    }

    async Task SaveOfCodesAsync()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", OfStorageKey, string.Join("\u001f", _ofCodes)); }
        catch { }
    }

    static string Norm(string? v) =>
        new string((v ?? string.Empty).ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());

    /// <summary>Mã phí: OF, O/F, O.F, OCF, OFR, hoặc OF kèm số / cỡ cont (OF20, OF40HC, O/F 40'...).</summary>
    static bool IsOfCode(string? code)
    {
        var n = Norm(code);
        if (n is "OF" or "OCF" or "OFR" or "OFT" or "SOF") return true;
        if (n.Length > 2 && n.StartsWith("OF") && char.IsDigit(n[2])) return true;
        // CHARGE_CODE có cụm "OF" đứng riêng: "OF-40", "SEA OF", "OF_USD"...
        var tokens = (code ?? string.Empty).ToUpperInvariant()
            .Split(new[] { ' ', '-', '_', '.', '(', ')', '\'', '"' }, StringSplitOptions.RemoveEmptyEntries);
        return tokens.Any(t => t is "OF" or "O/F") || n.Contains("OCEANFREIGHT") || n.Contains("SEAFREIGHT");
    }

    /// <summary>Tên phí: OF / O/F ..., hoặc có chữ Ocean freight / Sea freight / Cước biển.</summary>
    static bool IsOfName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return false;
        var n = Norm(name);
        if (IsOfCode(name)) return true;
        var lower = name.Trim().ToLowerInvariant();
        return n.Contains("OCEANFREIGHT") || n.Contains("SEAFREIGHT")
               || lower.StartsWith("of ") || lower.StartsWith("o/f") || lower.StartsWith("o.f")
               || lower.Contains("cước biển") || lower.Contains("cuoc bien");
    }

