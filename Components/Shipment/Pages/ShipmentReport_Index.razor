    /// <summary>Con mắt: xem chi tiết lô hàng (Debit, Credit, hóa đơn, phiếu thu/chi) và khóa / duyệt tại chỗ.</summary>
    private async Task OpenShipmentDetail(M_HBL item)
    {
        if (!await ssv.CheckPermission(usr, "View", "Shipment"))
        {
            CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            return;
        }
        var parameters = new DialogParameters<ShipmentDetail242Dialog>
        {
            { x => x.HblId, item.hblID },
            { x => x.JobNo, RefNo(item) },
            { x => x.MblNo, MblNo(item) },
            { x => x.ReceiptIds, ShipmentDocRefs.Get(_docRefs.Receipts, item.hblID).Select(d => d.Id).ToList() },
            { x => x.PaymentIds, ShipmentDocRefs.Get(_docRefs.Payments, item.hblID).Select(d => d.Id).ToList() },
            { x => x.CustomerLabel, (Func<Guid, string>)(id => { var p = PartyLabel(id); return string.IsNullOrEmpty(p.Code) ? CusidtoCusCode(id) : $"{p.Code} - {p.Name}"; }) },
            { x => x.ChargeLabel, (Func<Guid, string>)Charidtocharge },
            { x => x.StatusOptions, HblStatusOptions },
            { x => x.CreditTermOf, (Func<Guid, string>)CreditTerm }
        };
        var options = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.ExtraLarge, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ShipmentDetail242Dialog>(null, parameters, options);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not true)
            return;

        // Cập nhật lại dòng đang xem (cờ khóa, trạng thái duyệt chứng từ)
        try
        {
            var fresh = await shipsv.GetHBL_byHBLid(item.hblID);
            if (fresh != null)
            {
                item.approve = fresh.approve;
                item.debitCompleted = fresh.debitCompleted;
                item.creditCompleted = fresh.creditCompleted;
                item.statusHBL = fresh.statusHBL;
                item.ActualDelDate = fresh.ActualDelDate;
            }
            var refs = await LoadDocRefsAsync(new List<M_HBL> { item }, debitByHbl[item.hblID]);
            _docRefs.Invoices[item.hblID] = ShipmentDocRefs.Get(refs.Invoices, item.hblID).ToList();
            _docRefs.Receipts[item.hblID] = ShipmentDocRefs.Get(refs.Receipts, item.hblID).ToList();
            _docRefs.Payments[item.hblID] = ShipmentDocRefs.Get(refs.Payments, item.hblID).ToList();
        }
        catch (Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Warning);
        }
        StateHasChanged();
    }

