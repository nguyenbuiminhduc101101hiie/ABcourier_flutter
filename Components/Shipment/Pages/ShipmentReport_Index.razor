    /// <summary>
    /// Quy đổi một dòng phí sang USD hoặc VND (theo chkUSD).
    /// Tỷ giá trống/0 thì coi là 1 (trước đây tỷ giá null làm cả dòng thành null và bị bỏ khỏi tổng).
    /// Lưu ý: tỷ giá trên dòng phí được hiểu là tỷ giá sang VND, nên ngoại tệ khác USD/VND (EUR...) quy về USD chưa chính xác.
    /// </summary>
    double ConvertAmount(double? thanhtien, double? thanhtiensauthue, string? tiente, double? tigia)
    {
        var tien = (chkVAT ? thanhtiensauthue : thanhtien) ?? 0;
        var rate = (tigia == null || tigia == 0) ? 1 : tigia.Value;
        if (chkUSD)
            return string.Equals(tiente, "USD", StringComparison.OrdinalIgnoreCase) ? tien : tien / rate;
        return string.Equals(tiente, "VND", StringComparison.OrdinalIgnoreCase) ? tien : tien * rate;
    }

    double? TDebit_(Guid id)
        => debitByHbl[id].Sum(x => ConvertAmount(x.thanhtien, x.thanhtiensauthue, x.tiente, x.tigiadebit));

    double? TCredit_(Guid id)
        => creditByHbl[id].Sum(x => ConvertAmount(x.thanhtien, x.thanhtiensauthue, x.tiente, x.tigiacredit));

    double? TProfit_(Guid id, string type)
        => (TDebit_(id) ?? 0) - (TCredit_(id) ?? 0);

    private bool _processingUpload = false;
    async Task ExportReport()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            var itemsToExport = mudTable.FilteredItems.ToList();

            OfficeOpenXml.ExcelPackage.LicenseContext = OfficeOpenXml.LicenseContext.NonCommercial;
            using var package = new OfficeOpenXml.ExcelPackage();
            var worksheet = package.Workbook.Worksheets.Add("Report");

            // Tiêu đề cột
            var cur = $"{(chkUSD ? "USD" : "VND")}{(chkVAT ? ", VAT" : "")}";
            var headers = new[]
            {
                "HBL", "Ref (Job No)", "MBL", "Booking No.", "Customer", "POL/POD", "Service Type",
                "ETD", "ETA", "Actual Delivery (ADD)", "Status",
                $"Debit ({cur})", $"Credit ({cur})", $"Profit ({cur})", "On Time",
                "E-Invoice No.", "Receipt No.", "Payment No.",
                "Agent", "Carrier", "Freight / NVOCC", "Debit Parties", "Credit Parties", $"Debit outstanding ({cur})", $"Credit outstanding ({cur})", "Credit term", $"Profit NVOCC ({cur})"
            };
            const int colEtd = 8, colAdd = 10, colDebit = 12, colProfit = 14;
            var lastCol = headers.Length;
            for (var c = 0; c < headers.Length; c++)
                worksheet.Cells[1, c + 1].Value = headers[c];
            worksheet.Cells[1, 1, 1, lastCol].Style.Font.Bold = true;

            int row = 2;
            foreach (var item in itemsToExport)
            {
                var onTime = CheckOnTime(item);
                object?[] values =
                {
                    item.hbl, RefNo(item), MblNo(item), BookingNoOf(item), CusidtoCusCode(item.CustomerID),
                    $"{item.polcode} → {item.podcode}", TypeJob(item),
                    // Ghi ngày dạng Date thật để Excel sắp xếp / lọc được
                    item.ETD?.Date, item.ETA?.Date, item.ActualDelDate?.Date, item.statusHBL,
                    TDebit_(item.hblID), TCredit_(item.hblID), TProfit_(item.hblID, ""),
                    onTime == 1 ? "✔" : (onTime == 0 ? "✘" : ""),
                    DocNos(_docRefs.Invoices, item.hblID), DocNos(_docRefs.Receipts, item.hblID), DocNos(_docRefs.Payments, item.hblID),
                    AgentName(item), CarrierOf(item), CargoKind(item), DebitPartyNames(item.hblID), CreditPartyNames(item.hblID), DebitDue(item.hblID), CreditDue(item.hblID), CreditTerm(item.CustomerID), ProfitNvocc(item)
                };
                for (var c = 0; c < values.Length; c++)
                    worksheet.Cells[row, c + 1].Value = values[c];
                row++;
            }

            if (row > 2)
            {
                worksheet.Cells[2, colEtd, row - 1, colAdd].Style.Numberformat.Format = "dd/MMM/yyyy";
                worksheet.Cells[2, colDebit, row - 1, colProfit].Style.Numberformat.Format = "#,##0.##";
                worksheet.Cells[2, lastCol, row - 1, lastCol].Style.Numberformat.Format = "#,##0.##"; // Profit NVOCC
                worksheet.Cells[2, lastCol - 3, row - 1, lastCol - 2].Style.Numberformat.Format = "#,##0.##"; // Còn nợ Debit / Credit

                // Dòng tổng
                worksheet.Cells[row, 1].Value = "Total";
                for (var c = colDebit; c <= colProfit; c++)
                {
                    var letter = OfficeOpenXml.ExcelCellAddress.GetColumnLetter(c);
                    worksheet.Cells[row, c].Formula = $"SUM({letter}2:{letter}{row - 1})";
                }
                worksheet.Cells[row, colDebit, row, colProfit].Style.Numberformat.Format = "#,##0.##";
                worksheet.Cells[row, 1, row, lastCol].Style.Font.Bold = true;
            }

            worksheet.Cells.AutoFitColumns();

            // Tạo byte array
            var excelBytes = package.GetAsByteArray();
            var base64 = Convert.ToBase64String(excelBytes);

            // Gọi JS để tải file
            await JS.InvokeVoidAsync("saveAsFile", $"Shipment_Report_{DateTime.Now:yyyyMMddHHmmss}.xlsx", base64);
        }
        catch(Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
