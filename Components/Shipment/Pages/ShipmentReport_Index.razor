    private Task OpenInShipment50(M_HBL item, ShipmentLinkTarget target) => OpenInShipment(item, target, ShipmentScreen.S50);

    private async Task OpenInShipment(M_HBL item, ShipmentLinkTarget target, ShipmentScreen screen)
    {
        var (menu, prefix, compType) = screen switch
        {
            ShipmentScreen.S21 => ("Shipment", "2.1", typeof(Components.Shipment.Pages.ShipmentIndex)),
            ShipmentScreen.S60 => ("Shipment6", "6.0", typeof(Components.Shipment.Pages.TaskNav.Shipment_6_0_Index)),
            _ => ("Shipment5", "5.0", typeof(Components.Shipment.Pages.Payment.Shipment_5_0_Index))
        };
        if (!await ssv.CheckPermission(usr, "View", menu))
        {
            CallSnackBar($"{Localizer["NoPermission_View"]} ({prefix} Shipment)", MudBlazor.Severity.Warning);
            return;
        }

        var jobNo = RefNo(item);
        var mbl = MblNo(item);
        string? hblFilter = target == ShipmentLinkTarget.Hbl ? item.hbl?.Trim() : null;
        string? mblFilter = target == ShipmentLinkTarget.Mbl ? mbl : null;
        string? jobFilter = string.IsNullOrWhiteSpace(jobNo) ? null : jobNo;

        if (jobFilter == null && hblFilter == null && mblFilter == null)
        {
            CallSnackBar(Localizer["DataNotFound"], MudBlazor.Severity.Warning);
            return;
        }

        if (Layout == null)
        {
            // Không có layout (vd mở trang trực tiếp): giữ cách cũ là xem chi tiết HBL trong hộp thoại
            await OpenDetailHBL(item);
            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, compType);
            builder.AddAttribute(1, "InitialJobNo", jobFilter);
            builder.AddAttribute(2, "InitialMBL", mblFilter);
            builder.AddAttribute(3, "InitialHBL", hblFilter);
            builder.CloseComponent();
        };

        var label = target switch
        {
            ShipmentLinkTarget.Hbl => hblFilter,
            ShipmentLinkTarget.Mbl => mblFilter,
            _ => jobFilter
        };
        var key = $"Shipment{prefix}_RPT_{target}_{label}";
        await Layout.OpenTab(key, $"{prefix} {Localizer["Shipment"]} · {label}", content);
    }

