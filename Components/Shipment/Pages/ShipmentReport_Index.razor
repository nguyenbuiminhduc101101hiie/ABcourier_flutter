                : T("Rpt242_OfChargesUsed", "Phí đang tính là OF: ", "Charges treated as OF: ") + string.Join(", ", list.Select(c => $"{c.CHARGE_CODE} ({c.CHARGE})").Take(15));
        }
    }

    /// <summary>
    /// Profit của lô NVOCC = Debit phí OF − Credit phí OF (quy đổi USD/VND, VAT như cột Profit).
    /// Lô Freight để trống.
    /// </summary>
    double? ProfitNvocc(M_HBL item)
    {
        var of = OfChargeIds;
        var debits = debitByHbl[item.hblID].Where(x => of.Contains(x.itemid)).ToList();
        var credits = creditByHbl[item.hblID].Where(x => of.Contains(x.itemid)).ToList();
        if (debits.Count == 0 && credits.Count == 0)
            return null;
        var debit = debits.Sum(x => ConvertAmount(x.thanhtien, x.thanhtiensauthue, x.tiente, x.tigiadebit));
        var credit = credits.Sum(x => ConvertAmount(x.thanhtien, x.thanhtiensauthue, x.tiente, x.tigiacredit));
        return debit - credit;
    }

