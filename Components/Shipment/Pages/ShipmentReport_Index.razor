
@page "/shipmentreport"
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ABFreight.Data.AppDbContext> DbFactory
@attribute [Authorize]
@using System.Globalization
@using Microsoft.EntityFrameworkCore

<PageTitle>@Localizer["Shipment Report"]</PageTitle>
<style>
    /* 2.4.2: cột co theo dữ liệu — bảng rộng bằng nội dung, tiêu đề xuống dòng, dữ liệu một dòng */
    .rpt242-grid .mud-table-container { overflow-x: auto; }
    .rpt242-grid table.mud-table-root {
        table-layout: auto !important;
        width: auto !important;
        min-width: 0 !important;
    }
    .rpt242-grid .mud-table-head th.mud-table-cell {
        min-width: 0 !important;
        white-space: normal !important;
        line-height: 1.2;
        vertical-align: bottom;
        padding: 6px 6px !important;
        position: relative;
    }
    .rpt242-grid .mud-table-head th.mud-table-cell * { white-space: normal !important; }
    .rpt242-grid .mud-table-head .column-header { gap: 0 !important; }
    /* Nút sắp xếp / lọc trên tiêu đề nổi lên khi rê chuột, không chiếm bề rộng cột */
    .rpt242-grid .mud-table-head .column-options {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        opacity: 0;
        background: inherit;
        transition: opacity .15s;
    }
    .rpt242-grid .mud-table-head th.mud-table-cell:hover .column-options,
    .rpt242-grid .mud-table-head .column-options:focus-within { opacity: 1; }
    .rpt242-grid .mud-table-head .column-options .mud-icon-button { padding: 2px !important; }
    .rpt242-grid .mud-table-head .rpt242-hf { display: flex; flex-direction: column; gap: 2px; }
    .rpt242-grid .rpt242-filter {
        width: 100%; min-width: 60px; max-width: 160px; box-sizing: border-box;
        font-size: 11px; line-height: 1.2; padding: 1px 4px;
        border: 1px solid rgba(255,255,255,.55); border-radius: 4px;
        background: rgba(255,255,255,.95); color: #1f2937;
    }
    .rpt242-grid .rpt242-filter:focus { outline: 2px solid var(--mud-palette-primary); }
    .rpt242-grid .rpt242-eye { display: inline-flex; align-items: center; gap: 0; }
    .rpt242-grid .rpt242-shiplink .mud-link { cursor: pointer; }
    .rpt242-colmenu { padding: 6px 12px; max-height: 70vh; overflow-y: auto; min-width: 220px; }
    .rpt242-colmenu-head { display: flex; align-items: center; gap: 4px; margin-bottom: 4px; }
    .rpt242-grid .rpt242-term { margin-left: 4px; font-size: 10px; padding: 0 4px; border-radius: 6px; background: #fef3c7; color: #92400e; }
    .rpt242-grid .rpt242-status { display: inline-block; font-size: 11px; line-height: 1.4; padding: 0 6px; border: 1px solid; border-radius: 10px; }
    .rpt242-grid .rpt242-eye .mud-icon-button { padding: 2px !important; }
    .rpt242-grid .mud-table-body td.mud-table-cell,
    .rpt242-grid .mud-table-foot td.mud-table-cell {
        white-space: nowrap;
        padding: 4px 6px !important;
    }
</style>
<style>@HiddenColsCss</style>

<MudContainer MaxWidth=MaxWidth.False>
    
    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="3">
        <MudDateRangePicker @bind-DateRange="frmtoDate" Label="@Localizer["searchdatefromto"]" Color="Color.Primary"
                            HelperText="@T("Rpt242_DateRangeHint", "Lọc theo Date Report của HBL", "Filtered by HBL Date Report")" />
        <MudTooltip Arrow="true" Placement="Placement.Bottom">
            <ChildContent>
                <MudIconButton HtmlTag="label"
                            OnClick="@(()=>Refresh(frmtoDate))" Disabled="_loading"
                            Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                            Icon="@Icons.Material.Filled.Search"/>
            </ChildContent>
            <TooltipContent>
                <div style="text-align:left; max-width:340px; line-height:1.5; white-space:normal;">
                    @if (IsVietnamese)
                    {
                        <div><b>Tìm theo khoảng thời gian</b></div>
                        <div>Lọc theo <b>Date Report</b> của HBL (không phải ETD / ETA / ngày giao).</div>
                        <div>• Date Report mặc định là ngày tạo HBL; nếu để trống khi lưu thì hàng nhập (SI, AI) lấy ETA, hàng khác lấy ETD. Sửa ở cột Date Report trên màn Shipment.</div>
                        <div>• Lấy trọn cả ngày cuối của khoảng.</div>
                        <div>• ADMIN thấy mọi HBL; người khác chỉ thấy HBL có Sale Name là mình.</div>
                        <div>Bấm kính lúp để tải dữ liệu.</div>
                    }
                    else
                    {
                        <div><b>Search by period</b></div>
                        <div>Filters by the HBL <b>Date Report</b> (not ETD / ETA / delivery date).</div>
                        <div>• Date Report defaults to the HBL creation date; if left empty on save, imports (SI, AI) take ETA and others take ETD. Edit it in the Date Report column on the Shipment screen.</div>
                        <div>• The whole last day is included.</div>
                        <div>• ADMIN sees every HBL; other users see only HBLs where they are the Sale Name.</div>
                        <div>Click the magnifier to load data.</div>
                    }
                </div>
            </TooltipContent>
        </MudTooltip>

        <MudCheckBox @bind-Value="chkShowChart" Label="@Localizer["ShowChart"]" Color="Color.Primary" Size="Size.Medium" />
        <MudRadioGroup @bind-Value="chkUSD" @bind-Value:after="RebuildCharts">
            <MudRadio Value="@true" Color="Color.Primary" Size="Size.Small">USD</MudRadio>
            <MudRadio Value="@false" Color="Color.Primary" Size="Size.Small">VND</MudRadio>
        </MudRadioGroup>
        <MudCheckBox @bind-Value="chkVAT" @bind-Value:after="RebuildCharts" Label="VAT" Color="Color.Primary" Size="Size.Medium" />
        <MudCheckBox @bind-Value="ChkOnTime" Color="Color.Primary" Size="Size.Small">@Localizer["OnTimeDelivery"]</MudCheckBox>
        <MudCheckBox @bind-Value="ChkLate" Color="Color.Primary" Size="Size.Small">@Localizer["LateDelivery"]</MudCheckBox>
        <MudSwitch @bind-Value="chkPending" Label="@Localizer["Pending"]" Color="Color.Primary" Size="Size.Medium"/>
        <MudSwitch @bind-Value="chkDeli" Label="@Localizer["Delivered"]" Color="Color.Primary" Size="Size.Medium"/>
        <MudSwitch @bind-Value="chkCancel" Label="@Localizer["Cancelled"]" Color="Color.Primary" Size="Size.Medium"/>
    </MudStack>
    <MudDataGrid T="M_HBL" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-shipment-bg rpt242-grid"
                         FilterMode="@DataGridFilterMode.Simple" ShowColumnOptions="false" Dense="true" Virtualize="true" Height="calc(100vh - 41vh)" QuickFilter="_quickFilter"
                         FixedHeader="true" FixedFooter="true" FooterClass="no-wrap" RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true" RowClass="no-wrap-cell"
                         ColumnResizeMode="ResizeMode.Column" Loading="_loading">
                <ToolBarContent>
                    <MudButton Disabled="_processingUpload" Style="margin-left:20px;"
                               OnClick="@ExportReport"
                               Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Download">
                        @if (_processingUpload)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">@Localizer["Processing"]</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["Export"]</MudText>
                        }
                    </MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" Dense="true"
                             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Style="margin-left:6px;"
                             title="@T("Rpt242_OfPick", "Chọn mã phí (CHARGE_CODE) tính Profit NVOCC", "Choose charge codes for Profit NVOCC")">
                        <div class="rpt242-colmenu" @onclick:stopPropagation="true">
                            <div class="rpt242-colmenu-head">
                                <b>@T("Rpt242_OfPick", "Chọn mã phí (CHARGE_CODE) tính Profit NVOCC", "Choose charge codes for Profit NVOCC")</b>
                            </div>
                            <MudTextField @bind-Value="_ofSearch" Immediate="true" Placeholder="@T("Rpt242_OfSearch", "Tìm mã / tên phí", "Search code / name")"
                                          Margin="Margin.Dense" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                            <div class="rpt242-colmenu-head">
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="UseAutoOf">@T("Rpt242_OfAuto", "Tự nhận (mặc định)", "Auto (default)")</MudButton>
                                <span class="sd-kv" style="font-size:11px;">@(_ofCodes.Count == 0 ? T("Rpt242_OfAutoOn", "đang tự nhận", "auto") : $"{_ofCodes.Count} {T("Rpt242_OfChosen", "mã đã chọn", "selected")}")</span>
                            </div>
                            @foreach (var c in OfPickList)
                            {
                                <MudCheckBox T="bool" Value="@IsOfSelected(c)" ValueChanged="@(v => SetOfCode(c, v))" Dense="true" Size="Size.Small" Color="Color.Primary"
                                             Label="@($"{c.CHARGE_CODE} — {c.CHARGE}")" />
                            }
                        </div>
                    </MudMenu>
                    <MudMenu Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Dense="true"
                             AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Style="margin-left:12px;"
                             title="@T("Rpt242_ChooseCols", "Chọn cột hiển thị", "Choose columns")">
                        <div class="rpt242-colmenu" @onclick:stopPropagation="true">
                            <div class="rpt242-colmenu-head">
                                <b>@T("Rpt242_ChooseCols", "Chọn cột hiển thị", "Choose columns")</b>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetAllColumns(true))">@T("Rpt242_ShowAll", "Hiện tất cả", "Show all")</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ResetColumns">@T("Rpt242_Default", "Mặc định", "Default")</MudButton>
                            </div>
                            @foreach (var col in ColumnDefs)
                            {
                                <MudCheckBox T="bool" Value="@(!_hiddenCols.Contains(col.Key))" ValueChanged="@(v => SetColumnVisible(col.Key, v))"
                                             Label="@col.Label" Dense="true" Size="Size.Small" Color="Color.Primary" />
                            }
                        </div>
                    </MudMenu>
                    <MudText Typo="Typo.caption" Style="white-space:nowrap;">@T("Rpt242_Columns", "Cột", "Columns") (@(ColumnDefs.Count - _hiddenCols.Count)/@ColumnDefs.Count)</MudText>
                    <MudStack Spacing="2" Style="margin-left:20px;">
                        <MudStack Row>
                            <MudSwitch @bind-Value="chkSI" Label="SI" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkSE" Label="SE" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkAI" Label="AI" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkAE" Label="AE" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkTruck" Label="Truck" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkCustoms" Label="Customs" Color="Color.Primary" Size="Size.Small" />
                        </MudStack>
                       <MudStack Row>
                            <MudSwitch @bind-Value="chkInvIssued" Label="@Localizer["InvIssued"]" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkDebitReceived" Label="@Localizer["DebitReceived"]" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkSpentCredit" Label="@Localizer["SpentCredit"]" Color="Color.Primary" Size="Size.Small" />
                            <MudSwitch @bind-Value="chkReceivedSpentAgent" Label="@Localizer["RcvSpentAgent"]" Color="Color.Primary" Size="Size.Small" />
                       </MudStack>
                    </MudStack>
                    <MudSpacer />
                    <MudAutocomplete @bind-Value="_searchCus" Placeholder="@Localizer["SearchCustomers"]" Adornment="Adornment.Start" Immediate="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                                     Clearable ResetValueOnEmptyText SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
                </ToolBarContent>
                <Columns>
                    <TemplateColumn Sortable="false" Filterable="false" CellStyleFunc="_cellStyleFunc">
                        <HeaderTemplate>
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="@T("Rpt242_ViewDetail", "Xem chi tiết lô hàng", "Shipment details")" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <span class="rpt242-eye">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                               title="@T("Rpt242_ViewDetail", "Xem chi tiết lô hàng: Debit, Credit, hóa đơn, phiếu thu / chi", "Shipment details: Debit, Credit, invoices, receipts / payments")"
                                               OnClick="@(() => OpenShipmentDetail(context.Item))" />
                                @if (context.Item.approve == true && context.Item.debitCompleted == true && context.Item.creditCompleted == true)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Error" title="@T("Rpt242_ShipmentLocked", "Lô hàng đã khóa", "Shipment locked")" />
                                }
                            </span>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.hbl" Title="@Localizer["HBL"]" Required CellStyleFunc="_cellStyleFunc" Filterable="false">
                        <HeaderTemplate>
                            <div class="rpt242-hf">
                                <span>@Localizer["HBL"]</span>
                                <div @onclick:stopPropagation="true">
                                    <input class="rpt242-filter" type="text" placeholder="🔍" value="@_fHbl"
                                           @oninput="@(e => { _fHbl = e.Value?.ToString() ?? string.Empty; })" />
                                </div>
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            @ShipLink(context.Item, ShipmentLinkTarget.Hbl, context.Item.hbl)
                        </CellTemplate>
                        <FooterTemplate>
                            @Localizer["Total"]
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-ref" CellClass="rc-ref" FooterClass="rc-ref" Property="x => RefNo(x)" Title="@T("Rpt242_RefJobNo", "Ref (Job No)", "Ref (Job No)")" Required CellStyleFunc="_cellStyleFunc" Filterable="false">
                        <HeaderTemplate>
                            <div class="rpt242-hf">
                                <span>Ref</span>
                                <div @onclick:stopPropagation="true">
                                    <input class="rpt242-filter" type="text" placeholder="🔍" value="@_fRef"
                                           @oninput="@(e => { _fRef = e.Value?.ToString() ?? string.Empty; })" />
                                </div>
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(RefNo(context.Item)))
                            {
                                @ShipLink(context.Item, ShipmentLinkTarget.Job, RefNo(context.Item))
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-mbl" CellClass="rc-mbl" FooterClass="rc-mbl" Property="x => MblNo(x)" Title="@Localizer["MBL"]" Required CellStyleFunc="_cellStyleFunc" Filterable="false">
                        <HeaderTemplate>
                            <div class="rpt242-hf">
                                <span>@Localizer["MBL"]</span>
                                <div @onclick:stopPropagation="true">
                                    <input class="rpt242-filter" type="text" placeholder="🔍" value="@_fMbl"
                                           @oninput="@(e => { _fMbl = e.Value?.ToString() ?? string.Empty; })" />
                                </div>
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(MblNo(context.Item)))
                            {
                                @ShipLink(context.Item, ShipmentLinkTarget.Mbl, MblNo(context.Item))
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-booking" CellClass="rc-booking" FooterClass="rc-booking" Property="x => BookingNoOf(x)" Title="@T("Rpt242_BookingNo", "Số Booking", "Booking No.")" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(BookingNoOf(context.Item)))
                            {
                                <MudLink OnClick="@(() => OpenBooking(BookingNoOf(context.Item)))"
                                         title="@T("Rpt242_OpenBooking", "Mở Booking ở 6.1", "Open this booking in 6.1")">@BookingNoOf(context.Item)</MudLink>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-customer" CellClass="rc-customer" FooterClass="rc-customer" Property="x => CusidtoCusCode(x.CustomerID)" Title="@Localizer["Customer"]" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            <MudLink OnClick="@(() => EditPartyAsync(context.Item.CustomerID))"
                                     title="@T("Rpt242_EditCustomer", "Mở form sửa khách hàng", "Edit this customer")">@CusidtoCusCode(context.Item.CustomerID)</MudLink>
                            @if (!string.IsNullOrWhiteSpace(CreditTerm(context.Item.CustomerID)))
                            {
                                <span class="rpt242-term" title="@T("Rpt242_CreditTerm", "Hạn công nợ", "Credit term")">@T("Rpt242_TermShort", "HCN", "Term") @CreditTerm(context.Item.CustomerID)</span>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-debitparties" CellClass="rc-debitparties" FooterClass="rc-debitparties" Property="x => DebitPartyCodes(x.hblID)" Title="@T("Rpt242_DebitParties", "Đối tượng Debit", "Debit Parties")" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            @{ var dparties = DebitParties(context.Item.hblID); }
                            @for (var i = 0; i < dparties.Count; i++)
                            {
                                var party = dparties[i];
                                if (i > 0)
                                {
                                    <span>, </span>
                                }
                                <MudLink OnClick="@(() => OpenDebitIn50(context.Item))"
                                         title="@DebitLinkHint(party.Name)">@party.Code</MudLink>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-creditparties" CellClass="rc-creditparties" FooterClass="rc-creditparties" Property="x => CreditPartyCodes(x.hblID)" Title="@T("Rpt242_CreditParties", "Đối tượng Credit", "Credit Parties")" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            @{ var parties = CreditParties(context.Item.hblID); }
                            @for (var i = 0; i < parties.Count; i++)
                            {
                                var party = parties[i];
                                if (i > 0)
                                {
                                    <span>, </span>
                                }
                                <MudLink OnClick="@(() => OpenCreditIn50(context.Item))"
                                         title="@CreditLinkHint(party.Name)">@party.Code</MudLink>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-agent" CellClass="rc-agent" FooterClass="rc-agent" Property="x => AgentCode(x)" Title="@T("Rpt242_Agent", "Agent", "Agent")" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            <span title="@AgentName(context.Item)">@AgentCode(context.Item)</span>
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-carrier" CellClass="rc-carrier" FooterClass="rc-carrier" Property="x => CarrierOf(x)" Title="@T("Rpt242_Carrier", "Carrier", "Carrier")" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(CarrierOf(context.Item)))
                            {
                                <MudLink OnClick="@(() => EditCarrierAsync(CarrierOf(context.Item)))"
                                         title="@(CarrierHint(context.Item) + " · " + T("Rpt242_EditCarrier", "Mở form sửa hãng tàu", "Edit this carrier"))">@CarrierOf(context.Item)</MudLink>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-polpod" CellClass="rc-polpod" FooterClass="rc-polpod" Property="@(x => x.polcode + " → " + x.podcode)" Title="POL/POD" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-service" CellClass="rc-service" FooterClass="rc-service" Property="x=> TypeJob(x)" Title="@Localizer["Service Type"]" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-cargo" CellClass="rc-cargo" FooterClass="rc-cargo" Property="x => CargoKind(x)" Title="@T("Rpt242_CargoKind", "Loại hàng", "Freight / NVOCC")" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-etd" CellClass="rc-etd" FooterClass="rc-etd" Property="x=> formatDate(x.ETD)" Title="@Localizer["ETD"]" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-eta" CellClass="rc-eta" FooterClass="rc-eta" Property="x=> formatDate(x.ETA)" Title="@Localizer["ETA"]" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-add" CellClass="rc-add" FooterClass="rc-add" Property="x=> formatDate(x.ActualDelDate)" Title="@T("Rpt242_ActualDeliveryDate", "Ngày giao (ADD)", "Actual Delivery (ADD)")" Required CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-status" CellClass="rc-status" FooterClass="rc-status" Property="x=> x.statusHBL" Title="@Localizer["Status"]" Required CellStyleFunc="_cellStyleFunc">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(context.Item.statusHBL))
                            {
                                <span class="rpt242-status" style="@StatusStyle(context.Item.statusHBL)">@context.Item.statusHBL</span>
                            }
                        </CellTemplate>
                        <FooterTemplate>
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-debit" CellClass="rc-debit" FooterClass="rc-debit" Property="@(x => TDebit_(x.hblID))" Title="@Localizer["Debit"]" Required CellStyleFunc="_cellStyleFunc" Format="#,##0.##" CellStyle="text-align: right;" Culture="@_en" Filterable="false">
                        <FooterTemplate>
                            @((mudTable?.FilteredItems ?? Enumerable.Empty<M_HBL>()).Sum(x => TDebit_(x.hblID) ?? 0).ToString("##,##0.##", _en))
                        </FooterTemplate>
                    </PropertyColumn>
                    <PropertyColumn HeaderClass="rc-credit" CellClass="rc-credit" FooterClass="rc-credit" Property="@(x => TCredit_(x.hblID))" Title="@Localizer["Credit"]" Required CellStyleFunc="_cellStyleFunc" Format="#,##0.##" CellStyle="text-align: right;" Culture="@_en" Filterable="false">
                        <FooterTemplate>
                            @((mudTable?.FilteredItems ?? Enumerable.Empty<M_HBL>()).Sum(x => TCredit_(x.hblID) ?? 0).ToString("##,##0.##", _en))
                        </FooterTemplate>
                    </PropertyColumn>
