    /// <summary>Carrier lấy từ Booking của HBL (theo số Booking trên HBL); không có thì dùng Carrier lưu trên HBL, rồi Carrier của MBL.</summary>
    string CarrierOf(M_HBL item)
    {
        var bk = item.bkno?.Trim();
        if (!string.IsNullOrEmpty(bk) && carrierByBookingNo.TryGetValue(bk, out var carrier) && !string.IsNullOrWhiteSpace(carrier))
            return carrier;
        if (!string.IsNullOrWhiteSpace(item.Carrier))
            return item.Carrier.Trim();
        return mblById.TryGetValue(item.mblid, out var m) ? m.Carrier?.Trim() ?? string.Empty : string.Empty;
    }

    string CarrierHint(M_HBL item) =>
        string.IsNullOrWhiteSpace(item.bkno) ? string.Empty : "Booking " + item.bkno.Trim();

    /// <summary>Carrier của các Booking mà HBL tham chiếu (bản cập nhật mới nhất của mỗi số Booking).</summary>
    async Task<Dictionary<string, string>> LoadBookingCarriersAsync(List<M_HBL> hbls)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var bookingNos = hbls
            .Select(x => x.bkno?.Trim())
            .Where(x => !string.IsNullOrEmpty(x))
            .Select(x => x!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (bookingNos.Count == 0)
            return result;

        await using var ctx = await DbFactory.CreateDbContextAsync();
        foreach (var chunk in bookingNos.Chunk(1000))
        {
            var nos = chunk.ToList();
            var rows = await ctx.CONTAINEROUTBOUNDNOTIFY_sale.AsNoTracking()
                .Where(x => x.BookingNo != null && nos.Contains(x.BookingNo) && x.Carrier != null && x.Carrier != "")
                .Select(x => new { x.BookingNo, x.Carrier, x.UpdateTime })
                .ToListAsync();
            foreach (var g in rows.GroupBy(x => x.BookingNo!.Trim(), StringComparer.OrdinalIgnoreCase))
                result[g.Key] = g.OrderByDescending(x => x.UpdateTime).First().Carrier!.Trim();
        }
        return result;
    }

