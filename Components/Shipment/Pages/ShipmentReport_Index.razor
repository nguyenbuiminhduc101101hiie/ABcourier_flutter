    protected async override Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            userdetail = asv.GetUserDetail();
            Customers = await csv.GetList(userdetail);
            customerNameById = Customers
                .GroupBy(x => x.Customer_ID)
                .ToDictionary(g => g.Key, g => g.First().COMPANY ?? string.Empty);
            tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => (x.Tieude ?? string.Empty).ToLower() == "job").OrderBy(x=>x.Noidung).Select(x=>x.Noidung).ToList();
            var auth = await asv.GetAuth();
            usr = auth.User.Identity!.Name!;
            charges = await supsv.GetListCharge();
            _ofChargeIds = null;
            // Agent / nhà cung cấp trên Credit có thể không nằm trong danh sách khách theo user, nên tra trên toàn bộ danh mục
            partyById = (await csv.GetList())
                .GroupBy(x => x.Customer_ID)
                .ToDictionary(g => g.Key, g => g.First());
