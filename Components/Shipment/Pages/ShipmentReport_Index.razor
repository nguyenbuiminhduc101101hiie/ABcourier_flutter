    /// <summary>Carrier lưu dạng "tên viết tắt_tên công ty" (đối tượng Main Code Shipping): tìm lại đúng đối tượng để sửa.</summary>
    Guid FindCarrierId(string carrier)
    {
        var key = carrier.Trim();
        bool Eq(string? a) => !string.IsNullOrWhiteSpace(a) && string.Equals(a.Trim(), key, StringComparison.OrdinalIgnoreCase);
        var all = partyById.Values;
        var hit = all.FirstOrDefault(c => Eq($"{c.shortname}_{c.COMPANY}"))
               ?? all.Where(c => c.MainCode?.Contains("Shipping", StringComparison.OrdinalIgnoreCase) == true)
                     .FirstOrDefault(c => Eq(c.shortname) || Eq(c.COMPANY) || Eq(c.Customer_Code))
               ?? all.FirstOrDefault(c => Eq(c.shortname) || Eq(c.COMPANY) || Eq(c.Customer_Code));
        return hit?.Customer_ID ?? Guid.Empty;
    }

