@using MudBlazor
@using ABFreight.Models
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Chọn Customer trước khi Import</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
            Customer này sẽ gán vào tất cả phí Credit được import từ file EOR-ASR.
        </MudText>
        <MudAutocomplete T="Guid"
                         @bind-Value="_customerId"
                         Label="@Localizer["Customer"]"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Required
                         RequiredError="Vui lòng chọn Customer"
                         SearchFunc="SearchCustomer"
                         ToStringFunc="CusidtoCusCode"
                         Clearable />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Ok" Disabled="@(_customerId == Guid.Empty)">
            Tiếp tục Import
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<M_Customer> Customers { get; set; } = new();

    private Guid _customerId;

    private void Cancel() => MudDialog.Cancel();

    private void Ok()
    {
        if (_customerId == Guid.Empty)
            return;
        MudDialog.Close(DialogResult.Ok(_customerId));
    }

    private string CusidtoCusCode(Guid cusid)
    {
        if (cusid == Guid.Empty) return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : $"{rs.shortname} - {rs.COMPANY}";
    }

    private Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Customers.Select(x => x.Customer_ID));
        return Task.FromResult(Customers
            .Where(x => (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Customer_ID));
    }
}
