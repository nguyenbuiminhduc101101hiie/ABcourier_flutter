@using MudBlazor

@using ABFreight.Components.Charge.Pages;


<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">Xem trước dữ liệu import</MudText>
        <MudDataGrid Items="@PreviewData"
                     ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)"
                     Dense="true"
                     Hover="true"
                     Bordered="true"
                     Striped="true">
            <Columns>
                <PropertyColumn Property="x => x.STT" Title="STT" />
                <PropertyColumn Property="x => x.MainCode" Title="Main Code" />
                <PropertyColumn Property="x => x.SaleName" Title="Sale Name" />
                <PropertyColumn Property="x => x.ShortName" Title="Short Name" />
                <PropertyColumn Property="x => x.EnglishName" Title="English Name" />
                <PropertyColumn Property="x => x.AddressTV" Title="Address (TV)" />
                <PropertyColumn Property="x => x.Tel" Title="Tel" />
                <PropertyColumn Property="x => x.Fax" Title="Fax" />
                <PropertyColumn Property="x => x.Company" Title="Company" />
                <PropertyColumn Property="x => x.Address" Title="Address" />
                <PropertyColumn Property="x => x.Taxcode" Title="Tax Code" />
                <PropertyColumn Property="x => x.Email" Title="Email" />
                <PropertyColumn Property="x => x.Remark" Title="Remark" />
                <PropertyColumn Property="x => x.HanCongNo" Title="Hạn Công Nợ" />
                <PropertyColumn Property="x => x.DonViDoiTac" Title="Đơn Vị Đối Tác" />
                <PropertyColumn Property="x => x.TenNoiMoToKhai_gs" Title="Nơi Mở Tờ Khai" />
                <PropertyColumn Property="x => x.MaHangKhaiBaoHSCode_gs" Title="Mã Hàng (HS Code)" />
                <PropertyColumn Property="x => x.TenHang_gs" Title="Tên Hàng" />
                <PropertyColumn Property="x => x.tenNuocXuatXu_gs" Title="Nước Xuất Xứ" />
                <PropertyColumn Property="x => x.dieuKienGiaoHang_gs" Title="Điều Kiện Giao Hàng" />
                <PropertyColumn Property="x => x.PhuongTienVanChuyen_gs" Title="Phương Tiện Vận Chuyển" />
            </Columns>
        </MudDataGrid>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close(DialogResult.Ok(true))">OK</MudButton>
        <MudButton OnClick="() => MudDialog.Cancel()">Hủy</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public List<Components.CUSTOMER.Pages.Index.CustomerPreviewModel> PreviewData { get; set; } = new();
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    private bool _resizeColumn;
}
