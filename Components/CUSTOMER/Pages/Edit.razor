                CallSnackBar(Localizer["MainCode"] + " và " + Localizer["SaleName"] + " không được để trống.", MudBlazor.Severity.Warning);
            else if (mainCodeEmpty)
                CallSnackBar(Localizer["MainCode"] + " không được để trống.", MudBlazor.Severity.Warning);
            else
                CallSnackBar(Localizer["SaleName"] + " không được để trống.", MudBlazor.Severity.Warning);
