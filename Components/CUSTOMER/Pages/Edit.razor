@inject IStringLocalizer<SharedResource> Localizer

<MudDialog Class="customer-dialog-root">
    <DialogContent>
        <div class="customer-dialog-content">
            <div class="customer-dialog-scroll">
                <MudContainer Class="customer-dialog-container" MaxWidth="MaxWidth.False">
                    <div class="customer-dialog-header">
                        <div>
                            <MudText Typo="Typo.h6" Class="customer-dialog-title">Customer Information</MudText>
                            <MudText Typo="Typo.caption" Class="customer-dialog-subtitle">Manage base info, market info, contract, PIC, sale detail and related customer settings</MudText>
                        </div>
                    </div>
                    <MudTabs Class="customer-main-tabs" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="customer-tab-panel" MinimumTabWidth="110px">
                        <MudTabPanel Text="Base Info">
                            <MudTabs Class="customer-sub-tabs" Elevation="0" Rounded="true" Color="Color.Primary">
                                <MudTabPanel Text="Base Info (1)">
                                    <MudTabs Class="customer-inner-tabs" Elevation="0" Rounded="true" Color="Color.Tertiary">
                                        <MudGrid Spacing="1" Class="pa-1">
                                            <MudItem xs="12" Class="py-0">

                                                <MudItem xs="12" Class="py-0">
                                                    <a href="HDSDhtml/Huong_dan_Customer_Form_Chi_Tiet.html" target="_blank">
                                                        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Help"]</MudButton>
                                                    </a>
                                                </MudItem>
                                                <MudPaper Outlined="true" Class="pa-2" Style="border: 1px solid var(--mud-palette-lines-default);">
                                                    <MudGrid Spacing="0">
                                                        <MudItem xs="12" sm="6" md="5" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.COMPANY"
                                                                          For="@(() => customer.COMPANY)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["Debit Name"] />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.shortname"
                                                                          For="@(() => customer.shortname)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label="@Localizer["shortname"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                            <MudDatePicker Class="px-1 labelCustomColor" @bind-Date="customer.ngaythem"
                                                                           For="@(() => customer.ngaythem)" DateFormat="dd-MMM-yyyy"
                                                                           AdornmentColor="@ColorTextFields" Label=@Localizer["Date (Add)"] />
                                                        </MudItem>
                                                        <MudItem xs="12" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Address"
                                                                          For="@(() => customer.Address)" AdornmentColor="@ColorTextFields" Lines="2"
                                                                          Immediate="true" AutoGrow Label="@Localizer["addresstiengviet"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Tel"
                                                                          For="@(() => customer.Tel)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["Tel"] />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Fax"
                                                                          For="@(() => customer.Fax)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["Fax"] />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.ATTN"
                                                                          For="@(() => customer.ATTN)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["Attn"] />
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="12" Class="py-0">
                                                <MudPaper Outlined="true" Class="pa-2" Style="border: 1px solid var(--mud-palette-lines-default); background-color: #f0f9ff;">
                                                    <MudGrid Spacing="0">
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.EnglishName"
                                                                          For="@(() => customer.EnglishName)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label="@Localizer["EnglishName"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.TaxCode"
                                                                          For="@(() => customer.TaxCode)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label="@Localizer["TaxCode"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Email"
                                                                          For="@(() => customer.Email)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["INV. Email"] />
                                                        </MudItem>
                                                        <MudItem xs="12" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.addresstiengviet"
                                                                          For="@(() => customer.addresstiengviet)" AdornmentColor="@ColorTextFields" Lines="2"
                                                                          Immediate="true" AutoGrow Label="@Localizer["Address"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                            <MudAutocomplete T="string" Class="px-1 labelCustomColor" @bind-Value="customer.Country"
                                                                             AdornmentColor="@ColorTextFields" Immediate="true" SearchFunc="mst_Country" CoerceValue
                                                                             Clearable="true" Label="@Localizer["Country"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Province"
                                                                          For="@(() => customer.Province)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label="@Localizer["City"]" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                            <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.city"
                                                                          For="@(() => customer.city)" AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Label=@Localizer["City"] />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                            <MudSelect Class="px-1 labelCustomColor" @bind-Value="customer.Type"
                                                                       For="@(() => customer.Type)" AdornmentColor="@ColorTextFields"
                                                                       Immediate="true" Label=@Localizer["Type"]>
                                                                <MudSelectItem Value=@("HQ")>HQ</MudSelectItem>
                                                            </MudSelect>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="12" Class="py-0">
                                                <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Remarks_Customer"
                                                              For="@(() => customer.Remarks_Customer)" Lines="2" AdornmentColor="@ColorTextFields"
                                                              Immediate="true" AutoGrow Label=@Localizer["Remarks"] />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.sotaikhoan"
                                                              For="@(() => customer.sotaikhoan)" AdornmentColor="@ColorTextFields"
                                                              Immediate="true" AutoGrow Label=@Localizer["Bank"] />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.BIZName"
                                                              For="@(() => customer.BIZName)" AdornmentColor="@ColorTextFields"
                                                              Immediate="true" AutoGrow Label=@Localizer["BK Email"] />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Nationality"
                                                              For="@(() => customer.Nationality)" AdornmentColor="@ColorTextFields"
                                                              Immediate="true" AutoGrow Label=@Localizer["Doc. Email"] />
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Industry"
                                                              For="@(() => customer.Industry)" AdornmentColor="@ColorTextFields"
                                                              Immediate="true" AutoGrow Label=@Localizer["Industry"] />
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabs>
                                </MudTabPanel>
                                <MudTabPanel Text="Base Info (2)">
                                    <MudTabs Class="customer-inner-tabs" Elevation="0" Rounded="true" Color="Color.Tertiary">
                                        <MudCardContent Class="pa-2">
                                            <MudGrid Spacing="2">
                                                <MudItem xs=12 Class="pt-2 pb-1">
                                                    <a href="HDSDhtml/Huong_dan_Customer_Base_Info_1.html" target="_blank">
                                                        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Tutorial"]</MudButton>
                                                    </a>
                                                </MudItem>
                                                <MudItem xs="12" Style="background-color: lightcyan; display:flex" Class="py-1">
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="3" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.Customer_Code"
                                                                          For="@(() => customer.Customer_Code)"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow Disabled="EditOrNot"
                                                                          Label="@Localizer["Customer_Code"]" />
                                                        </MudItem>

                                                        <MudItem xs="2" Class="py-0">
                                                            <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.SaleName" Required
                                                                       For="@(() => customer.SaleName)"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Label="@Localizer["SaleName"]">
                                                                @foreach (var item in saleNames)
                                                                {
                                                                    <MudSelectItem Value="item">@item</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="2" Class="py-0">
                                                            <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.thoihanmove"
                                                                             For="@(() => customer.thoihanmove)"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true" HideSpinButtons="true"
                                                                             HelperTextOnFocus="true" HelperText="@Localizer["Sales Expiry date"]"
                                                                             Label="@Localizer["Ex.Date"]" />
                                                        </MudItem>
                                                        <MudItem xs="2" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor"
                                                                          Value="@GetMoveDate(customer?.Customer_Code)"
                                                                          Label="@Localizer["Move Date"]"
                                                                          ReadOnly="true" />
                                                        </MudItem>
                                                        <MudItem xs="3" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.Remarks_sale"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" AutoGrow
                                                                          InputType="InputType.Text"
                                                                          Pattern="[0-9,]*"
                                                                          OnBlur="@(() => FormatRemarksSale(customer.Remarks_sale))"
                                                                          Label="@Localizer["Limit/VND"]" />
                                                        </MudItem>
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudCard Style="background-color: lightcyan;" Class="border border-solid mud-border-primary pa-2">
                                                                <MudCardContent Class="pa-2">
                                                                    <MudGrid Spacing="1">
                                                                        <MudItem xs="8" Class="py-0">
                                                                            <MudSelect Class="pl-2 labelCustomColor" @bind-Value="selectedItem"
                                                                                       T="string"
                                                                                       AdornmentColor="@ColorTextFields"
                                                                                       Immediate="true"
                                                                                       Label=@Localizer["Choose"]>
                                                                                <MudSelectItem Value=@("AirLines")>Air Lines</MudSelectItem>
                                                                                <MudSelectItem Value=@("Agent-Network")>Agent-Network</MudSelectItem>
                                                                                <MudSelectItem Value=@("Customer")>Customer</MudSelectItem>
                                                                                <MudSelectItem Value=@("Vendor")>Vendor</MudSelectItem>
                                                                                <MudSelectItem Value=@("Shipping")>Shipping</MudSelectItem>
                                                                                <MudSelectItem Value=@("Trucking")>Trucking</MudSelectItem>
                                                                                <MudSelectItem Value=@("Romooc")>Romooc</MudSelectItem>
                                                                                <MudSelectItem Value=@("Personal")>Personal</MudSelectItem>
                                                                                <MudSelectItem Value=@("Others")>Others</MudSelectItem>
                                                                                <MudSelectItem Value=@("MovingPartner")>Moving-Partner</MudSelectItem>
                                                                                <MudSelectItem Value=@("MasterColoader")>Master Coloader</MudSelectItem>
                                                                                <MudSelectItem Value=@("LogisticsPartner")>Logistics Partner</MudSelectItem>
                                                                            </MudSelect>
                                                                        </MudItem>
                                                                        <MudItem xs="4" Class="py-0">
                                                                            <MudButton Class="custom-button pa-2 mt-2" Variant="Variant.Filled" Size="Size.Small" Color="Color.Tertiary" OnClick="addMainCode">>>></MudButton>
                                                                        </MudItem>
                                                                    </MudGrid>
                                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.MainCode"
                                                                                  For="@(() => customer.MainCode)" Lines="2"
                                                                                  AdornmentColor="@ColorTextFields" Required
                                                                                  Immediate="true" AutoGrow Label="@Localizer["MainCode"]" />

                                                                </MudCardContent>
                                                            </MudCard>

                                                        </MudItem>
                                                        <MudItem xs="6" Style="display:flex" Class="py-0">
                                                            <MudGrid Spacing="2">
                                                                <MudItem xs="6" Class="py-0">
                                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.giatri"
                                                                                  AdornmentColor="@ColorTextFields" OnBlur="@(() => FomatNumbergiatri(customer.giatri))"
                                                                                  Immediate="true" AutoGrow
                                                                                  Label=@Localizer["Exchange USD"] />
                                                                </MudItem>
                                                                <MudItem xs="6" Class="py-0">
                                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.phuphicourier"
                                                                                  For="@(() => customer.phuphicourier)"
                                                                                  AdornmentColor="@ColorTextFields"
                                                                                  Immediate="true" AutoGrow
                                                                                  Label=@Localizer["% Fuel"] />
                                                                </MudItem>
                                                                <MudItem xs="6" Class="py-0">
                                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.hancongno"
                                                                                  For="@(() => customer.hancongno)"
                                                                                  AdornmentColor="@ColorTextFields"
                                                                                  Immediate="true" AutoGrow
                                                                                  Label=@Localizer["Debt"] />
                                                                </MudItem>
                                                                <MudItem xs="6" Class="py-0">
                                                                    <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.freetime"
                                                                               AdornmentColor="@ColorTextFields"
                                                                               Immediate="true"
                                                                               Label=@Localizer["Free time"]>
                                                                        <MudSelectItem Value=@(new bool?(true))>True</MudSelectItem>
                                                                        <MudSelectItem Value=@(new bool?(false))>False</MudSelectItem>

                                                                    </MudSelect>
                                                                </MudItem>

                                                            </MudGrid>
                                                        </MudItem>
                                                        <MudItem xs="3" Class="py-0">
                                                            <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.PriceDEM"
                                                                             For="@(() => customer.PriceDEM)" Format="#,##0"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             Label=@Localizer["PriceDEM"] />
                                                        </MudItem>
                                                        <MudItem xs="3" Class="py-0">
                                                            <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.PriceDET"
                                                                             For="@(() => customer.PriceDET)" Format="#,##0"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             Label=@Localizer["PriceDET"] />
                                                        </MudItem>
                                                        @* <MudItem xs="6">
                                                    <MudSelect Class="pa-4 labelCustomColor" @bind-Value="customer.kpis"
                                                    For="@(() => customer.kpis)"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true"
                                                    Label="Status">
                                                        <MudSelectItem Value=@("Regular")>Regular</MudSelectItem>
                                                        <MudSelectItem Value=@("Vip")>Vip</MudSelectItem>
                                                        <MudSelectItem Value=@("Potential")>Potential</MudSelectItem>
                                                        <MudSelectItem Value=@("OneTime")>OneTime</MudSelectItem>
                                                        <MudSelectItem Value=@("Zero")>Zero</MudSelectItem>
                                                        <MudSelectItem Value=@("Lost")>Lost</MudSelectItem>
                                                        <MudSelectItem Value=@("Other")>Other</MudSelectItem>
                                                        <MudSelectItem Value=@("")></MudSelectItem>
                                                    </MudSelect>
                                                </MudItem> *@
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.status" Label=@Localizer["status"]>
                                                                @foreach (var item in trangthais)
                                                                {
                                                                    <MudSelectItem Value="item">@item</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                            </MudGrid>
                                        </MudCardContent>
                                    </MudTabs>
                                </MudTabPanel>
                                <MudTabPanel Text="Base Info (3)">
                                    <MudTabs Class="customer-inner-tabs" Elevation="0" Rounded="true" Color="Color.Tertiary"></MudTabs>
                                    <MudCardContent Class="pa-2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" Class="pt-2 pb-1">
                                                <a href="HDSDhtml/Huong_dan_Customer_Base_Info_3.html" target="_blank">
                                                    <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Tutorial"]</MudButton>
                                                </a>
                                            </MudItem>
                                            <MudItem xs="12" Style="background-color:lightcyan;" Class="py-1">
                                                <MudGrid Spacing="2">
                                                    <MudItem xs="12" sm="6" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.DonViDoiTac_gs"
                                                                      For="@(() => customer.DonViDoiTac_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["DonViDoiTac_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.TenHang_gs"
                                                                      For="@(() => customer.TenHang_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["TenHang_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.tenNuocXuatXu_gs"
                                                                      For="@(() => customer.tenNuocXuatXu_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["tenNuocXuatXu_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.PhuongTienVanChuyen_gs"
                                                                      For="@(() => customer.PhuongTienVanChuyen_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["PhuongTienVanChuyen_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.tendiadiemnhanhangcuoicung_gs"
                                                                      For="@(() => customer.tendiadiemnhanhangcuoicung_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["tendiadiemnhanhangcuoicung_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.tendiadiemxephang_gs"
                                                                      For="@(() => customer.tendiadiemxephang_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["tendiadiemxephang_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.dieuKienGiaoHang_gs"
                                                                      For="@(() => customer.dieuKienGiaoHang_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["dieuKienGiaoHang_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.MaHangKhaiBaoHSCode_gs"
                                                                      For="@(() => customer.MaHangKhaiBaoHSCode_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["MaHangKhaiBaoHSCode_gs"]" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.TenNoiMoToKhai_gs"
                                                                      For="@(() => customer.TenNoiMoToKhai_gs)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label="@Localizer["TenNoiMoToKhai_gs"]" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                    <MudCardContent Class="pa-2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" Class="py-0">
                                                <MudGrid Spacing="2">
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.PIC"
                                                                      For="@(() => customer.PIC)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label=@Localizer["PIC"] />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.contentofreport"
                                                                      For="@(() => customer.contentofreport)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label=@Localizer["Content Of Report"] />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.trafic"
                                                                      For="@(() => customer.trafic)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label=@Localizer["Trafic"] />
                                                    </MudItem>
                                                    <MudItem xs="6" sm="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.sea"
                                                                      For="@(() => customer.sea)"
                                                                      AdornmentColor="@ColorTextFields"
                                                                      Immediate="true" AutoGrow
                                                                      Label=@Localizer["Sea"] />
                                                    </MudItem>
                                                    <MudItem xs="6" sm="4" Class="py-0">
                                                        <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.air"
