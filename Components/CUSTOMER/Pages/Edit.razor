    string GetMoveDate(string? cuscode)
    {
        // Luôn lấy MoveDate từ MoveCustomer (ListMoveCus) trước — giống lưới Customer.
        // Chỉ khi tạo mới (!EditOrNot) và chưa có dòng move nào thì mới hiện ngày hôm nay (hint).
        MoveCustomer? data = null;
        if (ListMoveCus is { Count: > 0 })
        {
            if (!string.IsNullOrWhiteSpace(cuscode))
                data = ListMoveCus.Where(x => x.CustomerCode == cuscode).OrderByDescending(x => x.MoveDate).FirstOrDefault();
            if (data == null && customer.Customer_ID != Guid.Empty)
                data = ListMoveCus.Where(x => x.CustomerID == customer.Customer_ID).OrderByDescending(x => x.MoveDate).FirstOrDefault();
        }
        if (data != null && data.MoveDate.HasValue)
            return data.MoveDate.Value.ToString("dd/MMM/yyyy");
        if (!EditOrNot)
            return DateTime.Now.ToString("dd/MMM/yyyy");
        return string.Empty;
    }

    string? FomatNumberHanMuc(string value)
    {
        if (string.IsNullOrEmpty(customer.Remarks_Customer))
            return customer.Remarks_Customer;
        customer.Remarks_Customer = customer.Remarks_Customer.Replace(",", "");
        if (!double.TryParse(customer.Remarks_Customer, out double c))
            return string.Empty;
        customer.Remarks_Customer = c.ToString("#,##0").Replace(".", ",");
        StateHasChanged();
        return customer.Remarks_Customer;
    }

    string? FomatNumbergiatri(string value)
    {
        if (string.IsNullOrEmpty(customer.giatri))
            return customer.Remarks_Customer;
        customer.giatri = customer.giatri.Replace(",", "");
        if (!double.TryParse(customer.giatri, out double c))
            return string.Empty;
        customer.giatri = c.ToString("#,##0").Replace(".", ",");
        StateHasChanged();
        return customer.giatri;
    }

    string? FormatRemarksSale(string? value)
    {
        if (string.IsNullOrEmpty(customer.Remarks_sale))
            return customer.Remarks_sale;
        customer.Remarks_sale = customer.Remarks_sale.Replace(",", "");
        if (!double.TryParse(customer.Remarks_sale, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double num))
            return string.Empty;
        customer.Remarks_sale = num.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(".", ",");
        StateHasChanged();
        return customer.Remarks_sale;
    }

    private async Task<IEnumerable<string>> mst_Country(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return countries;
            }
            var result = countries
            .Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase))
            .ToList();
            return result;
            // if (result.Any())
            // {
            //     return result;
            // }
            // else
            // {
            //     return new List<string> { text };
            // }
        }
        catch (Exception)
        {
            throw;
        }
    }
