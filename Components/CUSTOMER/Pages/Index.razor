        cusdata.Customer_ID = Guid.Empty;
        var parameters = new DialogParameters<Edit> { { x => x.customer, cusdata }, { x => x.EditOrNot, false } };
        var dialog = await DialogService.ShowAsync<Edit>($"Customer - Duplicate {CusDetail.Customer_Code}", parameters, optionsdialog);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var data = (M_Customer)result.Data;
            var rs = await plsv.UpdateOrCreate(data, CusDetail, "Duplicate");
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await HandleRefresh();
            searchString1 = data.Customer_Code;
        }
        await TriggerGridClick();
        StateHasChanged();

    }
