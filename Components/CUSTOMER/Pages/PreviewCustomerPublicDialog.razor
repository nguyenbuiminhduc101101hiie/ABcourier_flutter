@using MudBlazor
@using ABFreight.Services
@using ABFreight.Models

<style>
    .cus-public-preview-dialog .mud-dialog-content {
        padding: 12px 16px 8px 16px !important;
        overflow: hidden;
    }

    .cus-public-preview-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: calc(100vh - 160px);
    }

    .cus-public-preview-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .cus-public-preview-table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        max-height: calc(100vh - 230px);
        overflow: auto;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .cus-public-preview-table {
        width: max-content;
        min-width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
    }

    .cus-public-preview-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #edf2f7;
        color: #1a202c;
        font-weight: 600;
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid #cbd5e0;
        white-space: nowrap;
    }

    .cus-public-preview-table tbody td {
        padding: 4px 6px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: middle;
    }

    .cus-public-preview-table tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    .cus-public-preview-table tbody tr:hover {
        background: #eef6ff;
    }

    .cus-public-preview-table tbody tr.row-excluded {
        opacity: 0.45;
        background: #f1f5f9 !important;
    }

    .cus-public-preview-table .col-row { width: 52px; }
    .cus-public-preview-table .col-action { width: 48px; text-align: center; }
    .cus-public-preview-table .col-code { min-width: 120px; }
    .cus-public-preview-table .col-sale { min-width: 70px; }
    .cus-public-preview-table .col-main { min-width: 120px; }
    .cus-public-preview-table .col-group { min-width: 120px; }
    .cus-public-preview-table .col-company { min-width: 180px; }
    .cus-public-preview-table .col-eng { min-width: 160px; }
    .cus-public-preview-table .col-tax { min-width: 110px; }
    .cus-public-preview-table .col-tel { min-width: 100px; }
    .cus-public-preview-table .col-email { min-width: 140px; }
    .cus-public-preview-table .col-addr { min-width: 180px; }
    .cus-public-preview-table .col-han { min-width: 80px; }
    .cus-public-preview-table .col-remark { min-width: 90px; }

    .cus-public-preview-table .mud-input-control {
        margin: 0 !important;
    }

    .cus-public-preview-table .mud-input > input {
        font-size: 0.78rem !important;
        padding: 4px 6px !important;
    }

    .cus-public-preview-muted {
        color: #64748b;
        font-size: 0.75rem;
    }

    .cus-public-preview-skip {
        max-height: 88px;
        overflow: auto;
        padding: 8px 10px;
        border-radius: 8px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        font-size: 0.78rem;
        color: #9a3412;
    }
</style>

<MudDialog Class="cus-public-preview-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Preview" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Xem trước & chỉnh sửa Import Partner List</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="cus-public-preview-wrap">
            <div class="cus-public-preview-summary">
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                    Sẽ import: @ReadyCount
                </MudChip>
                @if (ExcludedCount > 0)
                {
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                        Đã bỏ (user): @ExcludedCount
                    </MudChip>
                }
                @if (PreviewResult.Skipped.Count > 0)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                        Hệ thống bỏ qua: @PreviewResult.Skipped.Count
                    </MudChip>
                }
                <span class="cus-public-preview-muted">SaleName = NOMI · sửa trực tiếp ô rồi nhấn Xác nhận Import</span>
            </div>

            @if (PreviewResult.Skipped.Count > 0)
            {
                <div class="cus-public-preview-skip">
                    @foreach (var item in PreviewResult.Skipped)
                    {
                        <div>@item</div>
                    }
                </div>
            }

            <div class="cus-public-preview-table-wrap">
                <table class="cus-public-preview-table">
                    <thead>
                        <tr>
                            <th class="col-action"></th>
                            <th class="col-row">Dòng</th>
                            <th class="col-code">Customer Code</th>
                            <th class="col-sale">Sale</th>
                            <th class="col-main">Main Code</th>
                            <th class="col-group">Group</th>
                            <th class="col-company">Company</th>
                            <th class="col-eng">English Name</th>
                            <th class="col-tax">Tax Code</th>
                            <th class="col-tel">Tel</th>
                            <th class="col-email">Email</th>
                            <th class="col-addr">Address</th>
                            <th class="col-addr">Address TV</th>
                            <th class="col-han">Credit (Days)</th>
                            <th class="col-remark">Credit AMT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in EditableRows)
                        {
                            <tr class="@(x.ExcludedByUser ? "row-excluded" : null)">
                                <td class="col-action">
                                    <MudTooltip Text="@(x.ExcludedByUser ? "Đưa lại vào import" : "Bỏ dòng này khỏi import")">
                                        <MudIconButton Size="Size.Small"
                                                       Icon="@(x.ExcludedByUser ? Icons.Material.Filled.Undo : Icons.Material.Filled.DeleteOutline)"
                                                       Color="@(x.ExcludedByUser ? Color.Success : Color.Error)"
                                                       OnClick="@(() => ToggleExclude(x))" />
                                    </MudTooltip>
                                </td>
                                <td class="col-row">@x.ExcelRow</td>
                                <td class="col-code">
                                    <MudTextField @bind-Value="x.Customer_Code" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-sale">
                                    <MudTextField Value="@x.SaleName" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="true" />
                                </td>
                                <td class="col-main">
                                    <MudTextField @bind-Value="x.MainCode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-group">
                                    <MudTextField T="string" Value="@x.DonViDoiTac_gs" ValueChanged="@(v => OnGroupChanged(x, v))"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-company">
                                    <MudTextField @bind-Value="x.Company" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-eng">
                                    <MudTextField @bind-Value="x.EnglishName" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-tax">
                                    <MudTextField @bind-Value="x.TaxCode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-tel">
                                    <MudTextField @bind-Value="x.Tel" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-email">
                                    <MudTextField @bind-Value="x.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-addr">
                                    <MudTextField @bind-Value="x.Address" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-addr">
                                    <MudTextField @bind-Value="x.AddressTV" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-han">
                                    <MudTextField @bind-Value="x.HanCongNo" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                                <td class="col-remark">
                                    <MudTextField @bind-Value="x.Remarks_sale" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@x.ExcludedByUser" Immediate="true" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Hủy</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(ReadyCount == 0)"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Confirm">
            Xác nhận Import (@ReadyCount)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public CustomerPublicImportPreviewResult PreviewResult { get; set; } = new();

    private List<CustomerPublicImportPreviewRow> EditableRows { get; set; } = new();

    private int ReadyCount => EditableRows.Count(x => !x.ExcludedByUser);
    private int ExcludedCount => EditableRows.Count(x => x.ExcludedByUser);

    protected override void OnInitialized()
    {
        EditableRows = PreviewResult.Rows
            .Where(x => !x.IsSkipped)
            .Select(CloneRow)
            .ToList();
    }

    private static CustomerPublicImportPreviewRow CloneRow(CustomerPublicImportPreviewRow src) => new()
    {
        ExcelRow = src.ExcelRow,
        Customer_ID = src.Customer_ID,
        Customer_Code = src.Customer_Code,
        MainCode = src.MainCode,
        DonViDoiTac_gs = src.DonViDoiTac_gs,
        SaleName = src.SaleName ?? "NOMI",
        Company = src.Company,
        ShortName = src.ShortName,
        EnglishName = src.EnglishName,
        TaxCode = src.TaxCode,
        Tel = src.Tel,
        Email = src.Email,
        Address = src.Address,
        AddressTV = src.AddressTV,
        Fax = src.Fax,
        HanCongNo = src.HanCongNo,
        Remarks_sale = src.Remarks_sale,
        IsSkipped = false,
        ExcludedByUser = false
    };

    void ToggleExclude(CustomerPublicImportPreviewRow row)
    {
        row.ExcludedByUser = !row.ExcludedByUser;
    }

    void OnGroupChanged(CustomerPublicImportPreviewRow row, string? value)
    {
        row.DonViDoiTac_gs = value;
        row.MainCode = CustomerService.MapPartnerGroupToMainCode(value);
    }

    void Confirm()
    {
        var readyRows = EditableRows.Where(x => !x.ExcludedByUser).ToList();
        if (readyRows.Count == 0)
            return;

        var byId = PreviewResult.ToInsert
            .Where(c => c.Customer_ID != Guid.Empty)
            .ToDictionary(c => c.Customer_ID);

        var toSave = new List<M_Customer>();
        foreach (var row in readyRows)
        {
            M_Customer customer;
            if (row.Customer_ID.HasValue && byId.TryGetValue(row.Customer_ID.Value, out var existing))
                customer = existing;
            else
            {
                customer = new M_Customer
                {
                    Customer_ID = row.Customer_ID ?? Guid.NewGuid(),
                    Continued = true,
                    Approve = false,
                    Editable = false,
                    tilecom = 0,
                    thoihanmove = 30,
                    ngaythem = DateTime.Now,
                    Updatetime = DateTime.Now
                };
            }

            ApplyRowToCustomer(row, customer);
            toSave.Add(customer);
        }

        MudDialog.Close(DialogResult.Ok(toSave));
    }

    private static void ApplyRowToCustomer(CustomerPublicImportPreviewRow row, M_Customer customer)
    {
        customer.Customer_Code = row.Customer_Code?.Trim();
        customer.MainCode = string.IsNullOrWhiteSpace(row.MainCode)
            ? CustomerService.MapPartnerGroupToMainCode(row.DonViDoiTac_gs)
            : row.MainCode.Trim();
        customer.DonViDoiTac_gs = string.IsNullOrWhiteSpace(row.DonViDoiTac_gs) ? null : row.DonViDoiTac_gs.Trim();
        customer.SaleName = "NOMI";
        customer.COMPANY = row.Company?.Trim();
        customer.shortname = string.IsNullOrWhiteSpace(row.Company) ? row.ShortName?.Trim() : row.Company.Trim();
        customer.EnglishName = row.EnglishName?.Trim();
        customer.TaxCode = string.IsNullOrWhiteSpace(row.TaxCode) ? null : row.TaxCode.Trim();
        customer.Tel = row.Tel?.Trim();
        customer.Email = row.Email?.Trim();
        customer.Address = row.Address?.Trim();
        customer.addresstiengviet = row.AddressTV?.Trim();
        customer.Fax = row.Fax?.Trim();
        customer.hancongno = row.HanCongNo?.Trim();
        customer.Remarks_sale = string.IsNullOrWhiteSpace(row.Remarks_sale) ? "0" : row.Remarks_sale.Trim();
        customer.thoihanmove = 30;
    }

    void Cancel() => MudDialog.Cancel();
}
