    private bool FilterFunc(M_Customer sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        var q = searchString.Trim();
        return Has(sbd.Customer_Code, q) || Has(sbd.shortname, q) || Has(sbd.COMPANY, q)
            || Has(sbd.EnglishName, q) || Has(sbd.TaxCode, q) || Has(sbd.Tel, q)
            || Has(sbd.Email, q) || Has(sbd.SaleName, q) || Has(sbd.MainCode, q);
    }

    static bool Has(string? value, string q) =>
        !string.IsNullOrEmpty(value) && value.Contains(q, StringComparison.OrdinalIgnoreCase);

    int FilteredCount => string.IsNullOrWhiteSpace(searchString1) ? Cus.Count : Cus.Count(FilterFunc1);

