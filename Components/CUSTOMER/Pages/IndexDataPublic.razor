    private async Task MoveCustomer()
    {
        if (CusDetail == null)
        {
            CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(userdetail.Usr, "Edit", "System-Customer"))
        {
            CallSnackBar("You have not access to Move", MudBlazor.Severity.Warning);
            return;
        }
        var check = await csv.CheckMoveCusOver100(userdetail.Usr);
        if (!check.Flag)
        {
            CallSnackBar(check.Message, MudBlazor.Severity.Warning);
            return;
        }

        var movecus = new MoveCustomer();
        movecus.ID = Guid.NewGuid();
        movecus.CustomerCode = CusDetail.Customer_Code;
        movecus.SaleName = userdetail.Usr;
        movecus.MoveDate = DateTime.Now;
        movecus.CustomerID = CusDetail.Customer_ID;
        CusDetail.SaleName = userdetail.Usr;
        CusDetail.thoihanmove ??= 0;

        var rs = await csv.MoveCustomer(movecus, CusDetail);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        ListMoveCus = await csv.GetMoveCustomer();
        await TriggerGridClick();
        await HandleRefresh();
        StateHasChanged();

    }

    string GetMoveDate(string cuscode)
    {
        if (ListMoveCus == null || ListMoveCus.Count == 0)
            return string.Empty;
        var data = ListMoveCus.Where(x => x.CustomerCode == cuscode).OrderByDescending(x => x.MoveDate).FirstOrDefault();
        if (data == null)
            return string.Empty;
        return data!.MoveDate.HasValue ? data.MoveDate.Value.ToString("dd/MMM/yyyy")! : string.Empty;
    }
