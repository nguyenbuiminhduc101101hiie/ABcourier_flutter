                return;
            }
            var checkmovecus = await csv.CheckAndRefundMoveCustomer();
            if (checkmovecus.Item2 > 0) ListMoveCus = await csv.GetMoveCustomer();
            if (!checkmovecus.Item1.Flag)
                CallSnackBar(checkmovecus.Item1.Message, MudBlazor.Severity.Error);

            if (string.IsNullOrEmpty(_dksearch))
            {
                CallSnackBar("Enter search conditions", MudBlazor.Severity.Warning);
                return;
            }
            if (_selectedOption == SearchOption.Tax)
            {
                Cus = await csv.GetListNomi_by_tax(_dksearch);
            }
            else if (_selectedOption == SearchOption.ShortName)
            {
                Cus = await csv.GetListNomi_by_shortname(_dksearch);
            }
            else if (_selectedOption == SearchOption.DebitName)
            {
                Cus = await csv.GetListNomi_by_debitname(_dksearch);
            }
            else
            {
                Cus = await csv.GetListNomi_by_invoicename(_dksearch);
            }

            StateHasChanged();
        }
        finally
        {
            f_loading = false;
        }

