    private async Task importExcel(IBrowserFile file)
    {
        try
        {
            _processingUpload = true;
            Uploadtext = "Processing";

            var preview = await csv.PreviewCustomerPublicFromExcel(file);
            if (!string.IsNullOrEmpty(preview.ErrorMessage))
            {
                CallSnackBar(preview.ErrorMessage, MudBlazor.Severity.Error);
                return;
            }

            if (preview.Rows.Count == 0)
            {
                CallSnackBar("Không có dữ liệu hợp lệ trong file Excel (data từ dòng 8).", MudBlazor.Severity.Warning);
                return;
            }

            var parameters = new DialogParameters<PreviewCustomerPublicDialog>
            {
                { x => x.PreviewResult, preview }
            };
            var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.ExtraExtraLarge,
                FullWidth = true,
                CloseOnEscapeKey = true,
                NoHeader = false
            };
            var dialog = await DialogService.ShowAsync<PreviewCustomerPublicDialog>(
                "Xem trước Import Partner List", parameters, options);
            var result = await dialog.Result;

            if (result == null || result.Canceled)
                return;

            var toSave = result.Data as List<M_Customer>;
            if (toSave == null || toSave.Count == 0)
            {
                CallSnackBar("Không có dữ liệu để import sau khi chỉnh sửa.", MudBlazor.Severity.Warning);
                return;
            }

            List<string> message = await csv.SaveCustomerPublicImport(toSave);

            if (message[1] == "1")
            {
                var fullMsg = message[0];
                var userExcluded = preview.Rows.Count(x => !x.IsSkipped) - toSave.Count;
                if (userExcluded > 0)
                    fullMsg += $" (Bạn đã bỏ {userExcluded} dòng khỏi import.)";

                if (preview.Skipped.Count > 0)
                {
                    fullMsg += $" Hệ thống bỏ qua {preview.Skipped.Count} dòng đã tồn tại: " +
                               string.Join("; ", preview.Skipped);
                }

                var severity = preview.Skipped.Count > 0 || userExcluded > 0
                    ? MudBlazor.Severity.Warning
                    : MudBlazor.Severity.Success;
                CallSnackBar(fullMsg, severity);

                if (preview.Skipped.Count > 0 && fullMsg.Length > 120)
                    await DialogService.ShowMessageBox("Kết quả Import", fullMsg, yesText: "OK");

                await HandleRefresh();
            }
            else
            {
                CallSnackBar(message[0], MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            Uploadtext = "Import Partner List Excel";
            _processingUpload = false;
        }
    }

    private Func<M_Customer, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (string.IsNullOrEmpty(x.status))
            return "color: #000000";

        var rs = tts
            .Where(t => (t.Noidung).Contains(x.status, StringComparison.InvariantCultureIgnoreCase)
                && t.Tieude.Equals("CUSTOMER", StringComparison.InvariantCultureIgnoreCase))
            .Select(t => t.Mamau)
            .FirstOrDefault();
        return "color: " + rs;


    };
}
