@page "/sys/Customerpublic"
@inject NavigationManager navSvc
@inject ILogger<Index> Logger
@inject IJSRuntime js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SharedServices ssv
@inject AccountService asv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]

@inject CustomerService plsv

<PageTitle>@($"2.2.1 {Localizer["Public Client"]}")</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"2.2.1 {Localizer["Public Client"]}")" Subtitle="@HeaderSubtitle">
        <Toolbar>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudTextField @bind-Value="_dksearch"
                              Placeholder="@Localizer["SearchContent"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              OnKeyUp="@(async e => { if (e.Key == "Enter") await HandleSubmit(); })"
                              Class="customer-search" />
                <MudSelect T="SearchOption" @bind-Value="_selectedOption" Label="@Localizer["SearchBy"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width:150px">
                    <MudSelectItem Value="SearchOption.Tax">@Localizer["TaxCode"]</MudSelectItem>
                    <MudSelectItem Value="SearchOption.ShortName">@Localizer["ShortName"]</MudSelectItem>
                    <MudSelectItem Value="SearchOption.InvoiceName">@Localizer["InvoiceName"]</MudSelectItem>
                    <MudSelectItem Value="SearchOption.DebitName">@Localizer["DebitName"]</MudSelectItem>
                </MudSelect>
                <MudButton OnClick="HandleSubmit" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Search">
                    @Localizer["Search"]
                </MudButton>
                <MudTextField @bind-Value="searchString1"
                              Placeholder="@T("Customer_SearchHint", "Lọc nhanh: mã, tên, MST, điện thoại, email…", "Quick filter: code, name, tax code, phone, email…")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.FilterList"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="customer-search" />
                <MudButton OnClick="HandleRefresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>
                <MudButton OnClick="@(() => MoveCustomer())"
                           Disabled="@(CusDetail == null || CusDetail.SaleName == userdetail?.Usr)"
                           Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer["Move Customer"]
                </MudButton>
                <MudFileUpload T="IBrowserFile" Accept=".xlsx" Disabled="@(_processingUpload)" FilesChanged="importExcel" MaximumFileCount="1">
                    <ButtonTemplate>
                        <MudButton HtmlTag="label" for="@context.Id"
                                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                   Disabled="@(_processingUpload)"
                                   StartIcon="@(_processingUpload ? null : Icons.Material.Filled.UploadFile)">
                            @if (_processingUpload)
                            {
                                <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
                            }
                            @Localizer["ImportPartnerListExcel"]
                        </MudButton>
                    </ButtonTemplate>
                </MudFileUpload>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <div class="customer-list-layout">
        <MudPaper Class="product-price-card" Elevation="0">
            <MudDataGrid T="M_Customer" Items="@Cus" Class="customer-list-grid"
                         QuickFilter="@FilterFunc1" Filterable="false" ShowColumnOptions="false" SortMode="SortMode.Single"
                         Dense="true" Hover="true" Striped="true" Bordered="true" Virtualize="true"
                         Height="calc(100vh - 230px)" FixedHeader="true"
                         RowClick="@RowClicked" RowClassFunc="@SelectedRowClassFunc"
                         @ref="mudTable" ReadOnly="true" Loading="f_loading">
                <Columns>
                    <PropertyColumn Property="x => Cus.IndexOf(x) + 1" Title="@Localizer["no"]" CellStyleFunc="_cellStyleFunc" Filterable="false" Sortable="false" />
                    <PropertyColumn Property="x => x.Customer_Code" Title="@Localizer["Customer_Code"]" CellStyleFunc="_cellStyleFunc">
                        <CellTemplate><b>@context.Item.Customer_Code</b></CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.shortname" Title="@Localizer["shortname"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.COMPANY" Title="@Localizer["Debit Name"]" CellStyleFunc="_cellStyleFunc">
                        <CellTemplate><span class="customer-clip" title="@context.Item.COMPANY">@context.Item.COMPANY</span></CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.TaxCode" Title="@Localizer["TaxCode"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.MainCode" Title="@Localizer["MainCode"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.status" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Tel" Title="@Localizer["Tel"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Email" Title="Email" CellStyleFunc="_cellStyleFunc">
                        <CellTemplate><span class="customer-clip" title="@context.Item.Email">@context.Item.Email</span></CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.SaleName" Title="@Localizer["SaleName"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => GetMoveDate(x.Customer_Code)" Title="@Localizer["Move Date"]" CellStyleFunc="_cellStyleFunc" />
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="M_Customer" PageSizeOptions="@(new int[] { 20, 50, 100 })" />
                </PagerContent>
            </MudDataGrid>
        </MudPaper>

        <CustomerDetailPanel Customer="CusDetail"
                             MoveDate="@(CusDetail == null ? null : GetMoveDate(CusDetail.Customer_Code))"
                             StatusStyle="@(CusDetail == null ? null : _cellStyleFunc(CusDetail))"
                             CanEdit="@(false)" />
    </div>

    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
    </MudScrollToTop>
</div>
<script>
    window.triggerGridClick = () => {
    const gridElement = document.querySelector(".mudTable");
    if (gridElement) {
    gridElement.click();
    }
    }
</script>
