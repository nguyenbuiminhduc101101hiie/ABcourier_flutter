@* Khung chi tiết đối tượng (khách hàng / nhà cung cấp) dùng chung cho 2.2.1, 2.2.2, 2.2.3.
   Kèm CSS chung cho bố cục danh sách + khung chi tiết và lưới co cột theo dữ liệu. *@
@inject IStringLocalizer<SharedResource> Localizer

<style>
    .customer-list-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 380px;
        gap: 12px;
        align-items: start;
    }

    @@media (max-width: 1280px) {
        .customer-list-layout { grid-template-columns: minmax(0, 1fr); }
    }

    /* Cột co theo dữ liệu: bảng rộng bằng nội dung; tiêu đề được xuống dòng, dữ liệu một dòng */
    .customer-list-grid .mud-table-container { overflow-x: auto; }
    .customer-list-grid table.mud-table-root {
        table-layout: auto !important;
        width: auto !important;
        min-width: 0 !important;
    }
    .customer-list-grid .mud-table-head th.mud-table-cell {
        width: auto !important;
        min-width: 0 !important;
        white-space: normal !important;
        line-height: 1.2;
        vertical-align: bottom;
        padding: 6px 6px !important;
    }
    .customer-list-grid .mud-table-head th.mud-table-cell * { white-space: normal !important; }
    .customer-list-grid .mud-table-head .column-header { gap: 0 !important; }
    .customer-list-grid .mud-table-head .mud-table-sort-label { flex-wrap: nowrap; }
    .customer-list-grid .mud-table-head .mud-table-sort-label .mud-icon-root { font-size: 1rem; margin: 0 !important; }
    .customer-list-grid .mud-table-body td.mud-table-cell {
        width: auto !important;
        white-space: nowrap;
        padding: 4px 6px !important;
    }
    .customer-clip {
        display: inline-block;
        max-width: 240px;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }

    .customer-detail { padding: 12px 14px; position: sticky; top: 8px; max-height: calc(100vh - 150px); overflow-y: auto; }
    .customer-detail-title { font-weight: 600; font-size: 1.05rem; line-height: 1.3; }
    .customer-detail-sub { color: var(--mud-palette-text-secondary); font-size: .8rem; }
    .customer-section { margin-top: 12px; }
    .customer-section-title {
        font-size: .72rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
        color: var(--mud-palette-primary); border-bottom: 1px solid var(--mud-palette-lines-default);
        padding-bottom: 2px; margin-bottom: 6px;
    }
    .customer-field { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 8px; padding: 2px 0; font-size: .85rem; }
    .customer-field-label { color: var(--mud-palette-text-secondary); }
    .customer-field-value { word-break: break-word; white-space: pre-line; }
    .customer-empty { color: var(--mud-palette-text-secondary); text-align: center; padding: 40px 12px; }
    .customer-search { min-width: 260px; }
</style>

<MudPaper Class="product-price-card customer-detail" Elevation="0">
    @if (Customer == null)
    {
        <div class="customer-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Large" />
            <div>@(EmptyText ?? T("Customer_SelectHint", "Chọn một đối tượng để xem chi tiết", "Select a row to see its details"))</div>
        </div>
    }
    else
    {
        var v = Customer;
        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
            <div>
                <div class="customer-detail-title">@(string.IsNullOrWhiteSpace(v.COMPANY) ? v.shortname : v.COMPANY)</div>
                <div class="customer-detail-sub">@v.Customer_Code @(string.IsNullOrWhiteSpace(v.shortname) ? "" : $" · {v.shortname}")</div>
            </div>
            @if (OnEdit.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               Disabled="!CanEdit" OnClick="OnEdit" title="@Localizer["edit"]" />
            }
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(v.MainCode) || !string.IsNullOrWhiteSpace(v.status))
        {
            <MudStack Row="true" Spacing="1" Class="mt-2 flex-wrap">
                @if (!string.IsNullOrWhiteSpace(v.MainCode))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@v.MainCode</MudChip>
                }
                @if (!string.IsNullOrWhiteSpace(v.status))
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="@StatusStyle">@v.status</MudChip>
                }
            </MudStack>
        }

        <div class="customer-section">
            <div class="customer-section-title">@T("Customer_General", "Thông tin chung", "General")</div>
            @Field(Localizer["Debit Name"], v.COMPANY)
            @Field(Localizer["EnglishName"], v.EnglishName)
            @Field(Localizer["TaxCode"], v.TaxCode)
        </div>

        <div class="customer-section">
            <div class="customer-section-title">@T("Customer_Contact", "Liên hệ", "Contact")</div>
            @Field("ATTN", v.ATTN)
            @Field(Localizer["Tel"], v.Tel)
            @Field(Localizer["Fax"], v.Fax)
            @Field("Email", v.Email)
            @Field("Web", v.Web)
        </div>

        <div class="customer-section">
            <div class="customer-section-title">@T("Customer_AddressGroup", "Địa chỉ", "Address")</div>
            @Field(Localizer["addresstiengviet"], v.Address)
            @Field(Localizer["Address"], v.addresstiengviet)
            @Field(T("Customer_City", "Tỉnh / TP", "City"), JoinNonEmpty(v.city, v.Province))
            @Field(Localizer["Country"], v.Country)
        </div>

        <div class="customer-section">
            <div class="customer-section-title">@T("Customer_Payment", "Thanh toán", "Payment")</div>
            @Field(T("Customer_BankAccount", "Số tài khoản", "Bank account"), v.sotaikhoan)
            @Field(T("Customer_CreditTerm", "Hạn công nợ", "Credit term"), v.hancongno)
            @Field(T("Customer_Limit", "Hạn mức (VND)", "Limit (VND)"), v.Remarks_sale)
            @Field(T("Customer_Currency", "Tiền tệ", "Currency"), v.Cur)
        </div>

        <div class="customer-section">
            <div class="customer-section-title">@T("Customer_Owner", "Phụ trách", "Ownership")</div>
            @Field(Localizer["SaleName"], v.SaleName)
            @Field(Localizer["Move Date"], MoveDate)
            @Field(Localizer["Sales Expiry date"], v.thoihanmove?.ToString())
        </div>

        @if (HasCustomsInfo(v))
        {
            <MudExpansionPanels Elevation="0" Class="customer-section">
                <MudExpansionPanel Text="@T("Customer_Customs", "Thông tin khai báo hải quan", "Customs declaration info")" Dense="true">
                    @Field(Localizer["DonViDoiTac_gs"], v.DonViDoiTac_gs)
                    @Field(Localizer["TenNoiMoToKhai_gs"], v.TenNoiMoToKhai_gs)
                    @Field(Localizer["MaHangKhaiBaoHSCode_gs"], v.MaHangKhaiBaoHSCode_gs)
                    @Field(Localizer["TenHang_gs"], v.TenHang_gs)
                    @Field(Localizer["tenNuocXuatXu_gs"], v.tenNuocXuatXu_gs)
                    @Field(Localizer["PhuongTienVanChuyen_gs"], v.PhuongTienVanChuyen_gs)
                    @Field(Localizer["dieuKienGiaoHang_gs"], v.dieuKienGiaoHang_gs)
                    @Field(Localizer["tendiadiemnhanhangcuoicung_gs"], v.tendiadiemnhanhangcuoicung_gs)
                    @Field(Localizer["tendiadiemxephang_gs"], v.tendiadiemxephang_gs)
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @if (!string.IsNullOrWhiteSpace(v.Remarks_Customer))
        {
            <div class="customer-section">
                <div class="customer-section-title">@T("Customer_Notes", "Ghi chú", "Notes")</div>
                <div class="customer-field-value">@v.Remarks_Customer</div>
            </div>
        }
    }
</MudPaper>

@code {
    [Parameter] public M_Customer? Customer { get; set; }
    /// <summary>Ngày move của đối tượng (trang gọi tự tính).</summary>
    [Parameter] public string? MoveDate { get; set; }
    /// <summary>Style màu chữ của trạng thái (theo bảng Trạng thái).</summary>
    [Parameter] public string? StatusStyle { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public string? EmptyText { get; set; }

    static bool IsVietnamese =>
        System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi", StringComparison.OrdinalIgnoreCase);

    string T(string key, string vi, string en)
    {
        var s = Localizer[key];
        return s.ResourceNotFound || string.IsNullOrWhiteSpace(s.Value) ? (IsVietnamese ? vi : en) : s.Value;
    }

    static string? JoinNonEmpty(params string?[] parts) =>
        string.Join(", ", parts.Where(p => !string.IsNullOrWhiteSpace(p)).Select(p => p!.Trim()));

    static bool HasCustomsInfo(M_Customer v) =>
        new[] { v.DonViDoiTac_gs, v.TenNoiMoToKhai_gs, v.MaHangKhaiBaoHSCode_gs, v.TenHang_gs, v.tenNuocXuatXu_gs,
                v.PhuongTienVanChuyen_gs, v.dieuKienGiaoHang_gs, v.tendiadiemnhanhangcuoicung_gs, v.tendiadiemxephang_gs }
            .Any(x => !string.IsNullOrWhiteSpace(x));

    RenderFragment Field(string label, string? value) => __builder =>
    {
        <div class="customer-field">
            <span class="customer-field-label">@label</span>
            <span class="customer-field-value">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</span>
        </div>
    };
}
