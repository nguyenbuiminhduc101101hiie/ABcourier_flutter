@page "/accounting/general-ledger"
@page "/GeneralLedgerSummary"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using OfficeOpenXml
@using System.Globalization
@using System.Text
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>10.6.1 Sổ cái tổng hợp</PageTitle>

<div class="product-price-page gl-summary-page">
    <PpScreenHeader Title="10.6.1 Sổ cái tổng hợp" Subtitle="General Ledger · xem toàn bộ phát sinh đã ghi sổ">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Load
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetFilterAsync"
                           Disabled="_busy">
                    Reset
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="ToggleImportPanel"
                           Disabled="_busy">
                    Import Excel
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="DownloadImportTemplateAsync"
                           Disabled="_busy">
                    Mẫu Excel
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportLedgerStructureAsync"
                           Disabled="_busy">
                    Export file import lại
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Tertiary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TableView"
                           OnClick="ExportCongNoTongHopAsync"
                           Disabled="_busy">
                    Export
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Chọn theo"
                           Value="@_dateMode"
                           ValueChanged="OnDateModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Theo ngày</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày"
                               Date="_fromDate"
                               DateChanged="OnFromDateChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày"
                               Date="_toDate"
                               DateChanged="OnToDateChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Year"
                                 Value="_fiscalYear"
                                 ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2000"
                                 Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Month"
                                 Value="_periodMonth"
                                 ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="12" sm="1">
                <MudSelect T="string"
                           Label="Book"
                           @bind-Value="_book"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Tài khoản"
                           @bind-Value="_accountCode"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Class="gl-select">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    @foreach (var acc in _accountCodes)
                    {
                        <MudSelectItem T="string" Value="@acc">@acc</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

        </MudGrid>

        <MudGrid Spacing="2" AlignItems="Center" Class="mt-1">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchVoucher"
                              Label="Số chứng từ"
                              Placeholder="VoucherNo..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchCustomer"
                              Label="Khách hàng"
                              Placeholder="Tên đối tượng / khách hàng..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.PersonSearch" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchDescription"
                              Label="Diễn giải"
                              Placeholder="Nội dung diễn giải..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Notes" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchSource"
                              Label="Nguồn phát sinh"
                              Placeholder="Source..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Source" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            @DateModeHelpText
        </MudText>
    </MudPaper>

    @if (_showImportPanel)
    {
        <MudPaper Class="product-price-card pa-3 mb-2 import-card" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                <div>
                    <MudText Typo="Typo.h6" Class="import-title">IMPORT SỔ CÁI TỪ EXCEL</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Tool nhập liệu: chọn file → đọc thử → kiểm tra cân đối Nợ/Có → import vào GeneralLedgerEntries.
                    </MudText>
                </div>
                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Tổng dòng: @_importRows.Count.ToString("N0")</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Hợp lệ: @_importValidCount.ToString("N0")</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Lỗi: @_importErrorCount.ToString("N0")</MudChip>
                </MudStack>
            </MudStack>

            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-2">
                File Excel cần có dòng tiêu đề ở dòng 1. Cột bắt buộc: PostingDate, VoucherNo, AccountCode, Debit, Credit. Nếu DB chưa có CompanyId mặc định thì phải có cột CompanyId. Có thể dùng tên cột tiếng Việt như Ngày HT, Số chứng từ, TK, Nợ, Có.
            </MudAlert>

            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-2 import-upload-box" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.caption" Class="fw-bold">Chọn file Excel</MudText>
                        <InputFile OnChange="OnLedgerImportFileChanged" accept=".xlsx" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(_importFileName == string.Empty ? "Chưa chọn file" : _importFileName)</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudCheckBox T="bool" @bind-Value="_allowDuplicateImport" Label="Cho phép trùng số CT" Dense="true" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudCheckBox T="bool" @bind-Value="_importRebuildBalance" Label="Rebuild Balance sau import" Dense="true" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Preview" OnClick="PreviewImportAsync" Disabled="_busy || _importFile is null">Đọc thử / Validate</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="ImportLedgerRowsAsync" Disabled="_busy || !_importRows.Any() || _importErrorCount > 0">Import vào sổ cái</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="DownloadImportTemplateAsync" Disabled="_busy">Tải mẫu</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportLedgerStructureAsync" Disabled="_busy">Export theo mẫu import</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearImportPreview" Disabled="_busy">Xóa preview</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="2" Class="mt-2 mb-2">
                <MudItem xs="12" sm="3"><MudPaper Class="pa-2 import-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Tổng Nợ</MudText><MudText Typo="Typo.subtitle2" Class="fw-bold">@_importRows.Sum(x => x.Debit).ToString("N0")</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="3"><MudPaper Class="pa-2 import-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Tổng Có</MudText><MudText Typo="Typo.subtitle2" Class="fw-bold">@_importRows.Sum(x => x.Credit).ToString("N0")</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="3"><MudPaper Class="pa-2 import-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Chênh lệch</MudText><MudText Typo="Typo.subtitle2" Class="fw-bold" Color="@((_importRows.Sum(x => x.Debit) - _importRows.Sum(x => x.Credit)) == 0 ? Color.Success : Color.Error)">@((_importRows.Sum(x => x.Debit) - _importRows.Sum(x => x.Credit)).ToString("N0"))</MudText></MudPaper></MudItem>
                <MudItem xs="12" sm="3"><MudPaper Class="pa-2 import-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Số chứng từ</MudText><MudText Typo="Typo.subtitle2" Class="fw-bold">@_importRows.Select(x => x.VoucherNo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</MudText></MudPaper></MudItem>
            </MudGrid>

            @if (_importRows.Any())
            {
                <MudDataGrid T="LedgerImportRow"
                             Items="_importRows.Take(300).ToList()"
                             Dense="true"
                             Striped="true"
                             Hover="true"
                             Bordered="true"
                             FixedHeader="true"
                             Height="300px"
                             Class="import-preview-grid"
                             RowClassFunc="ImportRowClass">
                    <Columns>
                        <PropertyColumn Property="x => x.RowNo" Title="#" />
                        <PropertyColumn Property="x => x.StatusText" Title="Status" />
                        <PropertyColumn Property="x => x.PostingDate" Title="Ngày HT" Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.VoucherNo" Title="Số CT" />
                        <PropertyColumn Property="x => x.VoucherDate" Title="Ngày CT" Format="dd/MM/yyyy" />
                        <PropertyColumn Property="x => x.AccountCode" Title="TK" />
                        <PropertyColumn Property="x => x.CustomerId" Title="CustomerId" />
                        <PropertyColumn Property="x => x.CustomerCode" Title="Mã ĐT" />
                        <PropertyColumn Property="x => x.CustomerName" Title="Đối tượng" />
                        <PropertyColumn Property="x => x.CompanyId" Title="CompanyId" />
                        <PropertyColumn Property="x => x.BranchCode" Title="Branch" />
                        <PropertyColumn Property="x => x.Description" Title="Diễn giải" />
                        <PropertyColumn Property="x => x.Debit" Title="Nợ" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.Credit" Title="Có" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DebitFC" Title="DebitFC" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.CreditFC" Title="CreditFC" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.HBLNo" Title="HBL" />
                        <PropertyColumn Property="x => x.MBLNo" Title="MBL" />
                        <PropertyColumn Property="x => x.ContainerNo" Title="Container" />
                        <PropertyColumn Property="x => x.BookingNo" Title="Booking" />
                        <PropertyColumn Property="x => x.CurrencyCode" Title="Tiền tệ" />
                        <PropertyColumn Property="x => x.ExchangeRate" Title="Tỷ giá" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.Book" Title="Book" />
                        <PropertyColumn Property="x => x.ValidationMessage" Title="Thông báo" />
                    </Columns>
                </MudDataGrid>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">Preview tối đa 300 dòng đầu. Khi import sẽ nhập toàn bộ dòng hợp lệ trong file.</MudText>
            }
        </MudPaper>
    }

    <MudPaper Class="product-price-card pa-2 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Debit</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.Debit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Credit</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.Credit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Difference</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold"
                             Color="@(VisibleItems.Sum(x => x.Debit) - VisibleItems.Sum(x => x.Credit) == 0 ? Color.Success : Color.Error)">
                        @((VisibleItems.Sum(x => x.Debit) - VisibleItems.Sum(x => x.Credit)).ToString("N0"))
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Lines</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Count().ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudDataGrid @key="_gridKey"
                     T="GeneralLedgerSummaryRow"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Hover="true"
                     Bordered="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     ColumnResizeMode="ResizeMode.Column"
                     FixedHeader="true"
                     Height="calc(100vh - 340px)"
                     Class="gl-summary-grid"
                     RowClassFunc="RowClass"
                     SelectedItem="_selected"
                     SelectedItemChanged="OnSelectedChanged"
                     Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.PostingDate" Title="Ngày HT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="Số chứng từ" />
                <PropertyColumn Property="x => x.VoucherDate" Title="Ngày CT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherType" Title="Loại CT" />
                <PropertyColumn Property="x => x.AccountCode" Title="TK" />
                <PropertyColumn Property="x => x.AccountName" Title="Tên tài khoản" />
                <PropertyColumn Property="x => x.SoHD" Title="Số HĐ" />
                <PropertyColumn Property="x => x.CustomerName" Title="Đối tượng / Khách hàng" />
                <PropertyColumn Property="x => x.Description" Title="Diễn giải" />
                <PropertyColumn Property="x => x.HBLNo" Title="HBLNo" />
                <PropertyColumn Property="x => x.BookingNo" Title="BookingNo" />
                <PropertyColumn Property="x => x.SaleName" Title="SaleName" />
                <PropertyColumn Property="x => x.POLName" Title="POLName" />
                <PropertyColumn Property="x => x.PODName" Title="PODName" />
                <PropertyColumn Property="x => x.Debit" Title="Nợ" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Credit" Title="Có" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="Tiền tệ" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="Tỷ giá" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Book" Title="Book" />
                <PropertyColumn Property="x => x.SourceName" Title="Nguồn phát sinh" />
                <PropertyColumn Property="x => x.CreatedBy" Title="Người tạo" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GeneralLedgerSummaryRow" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>

            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                    Không có dữ liệu sổ cái theo điều kiện lọc hiện tại.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    [Parameter] public string? InitialAccountCode { get; set; }
    [Parameter] public int? InitialFiscalYear { get; set; }
    [Parameter] public int? InitialPeriodMonth { get; set; }
    [Parameter] public string? InitialBook { get; set; }
    [Parameter] public Guid? InitialCustomerId { get; set; }

    private const string PermissionMenuName = "GeneralLedgerEntries";
    private static bool _epplusLicenseConfigured;

    private void ConfigureEpplusLicense()
    {
        if (_epplusLicenseConfigured)
            return;

        var commercialLicenseKey = Configuration["EPPlus:LicenseKey"];
        ExcelPackage.LicenseContext = string.IsNullOrWhiteSpace(commercialLicenseKey)
            ? LicenseContext.NonCommercial
            : LicenseContext.Commercial;

        _epplusLicenseConfigured = true;
    }

    private bool _busy;
    private string _usr = string.Empty;
    private int _gridKey;

    private string _dateMode = "DATE_RANGE";
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "ALL";
    private string _accountCode = "ALL";
    private Guid? _customerIdFilter;
    private string _searchVoucher = string.Empty;
    private string _searchCustomer = string.Empty;
    private string _searchDescription = string.Empty;
    private string _searchSource = string.Empty;

    private List<GeneralLedgerSummaryRow> _rows = new();
    private List<string> _accountCodes = new();
    private GeneralLedgerSummaryRow? _selected;

    private bool _showImportPanel;
    private IBrowserFile? _importFile;
    private string _importFileName = string.Empty;
    private bool _allowDuplicateImport;
    private bool _importRebuildBalance = true;
    private List<LedgerImportRow> _importRows = new();
    private Guid? _defaultCompanyId;

    private int _importValidCount => _importRows.Count(x => x.IsValid);
    private int _importErrorCount => _importRows.Count(x => !x.IsValid);

    private IEnumerable<GeneralLedgerSummaryRow> VisibleItems =>
        _rows.Where(MatchesFilter).Where(MatchesSearch);

    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);

    private string DateModeHelpText => IsPeriodMode
        ? "Đang lọc theo kỳ kế toán: hệ thống dùng FiscalYear/FiscalPeriod và tự set Từ ngày - Đến ngày theo tháng."
        : "Đang lọc theo ngày hạch toán: hệ thống chỉ dùng PostingDate từ ngày - đến ngày, không ép FiscalYear/FiscalPeriod.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        ApplyInitialFilters();

        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();

        await LoadAsync();
    }

    private void ApplyInitialFilters()
    {
        var hasInitialPeriod = InitialFiscalYear.HasValue || InitialPeriodMonth.HasValue;

        _dateMode = hasInitialPeriod ? "PERIOD" : "DATE_RANGE";

        if (!string.IsNullOrWhiteSpace(InitialAccountCode))
            _accountCode = InitialAccountCode.Trim();

        if (InitialFiscalYear.HasValue)
            _fiscalYear = InitialFiscalYear.Value;

        if (InitialPeriodMonth.HasValue)
            _periodMonth = InitialPeriodMonth.Value;

        if (hasInitialPeriod)
        {
            _fiscalYear ??= DateTime.Today.Year;
            _periodMonth ??= DateTime.Today.Month;
        }

        if (!string.IsNullOrWhiteSpace(InitialBook))
            _book = InitialBook.Trim().ToUpperInvariant();

        if (InitialCustomerId.HasValue && InitialCustomerId.Value != Guid.Empty)
            _customerIdFilter = InitialCustomerId.Value;
    }

    private async Task OnDateModeChanged(string value)
