    private bool MatchesExportSeedFilter(M_GeneralLedgerEntries x)
    {
        if (!string.IsNullOrWhiteSpace(_accountCode)
            && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase))
        {
            var acc = _accountCode.Trim();
            if (string.IsNullOrWhiteSpace(x.AccountCode) || !x.AccountCode.StartsWith(acc, StringComparison.OrdinalIgnoreCase))
                return false;
        }

        if (_customerIdFilter.HasValue && _customerIdFilter.Value != Guid.Empty)
        {
            if (x.CustomerId != _customerIdFilter.Value)
                return false;
        }

        return true;
    }

    private static Guid? GetGuidPropertyValue(object target, string propertyName)
    {
        var prop = target.GetType().GetProperty(propertyName);
        if (prop is null)
            return null;

        var value = prop.GetValue(target);
        if (value is null)
            return null;

        if (value is Guid guidValue)
            return guidValue;

        if (Guid.TryParse(value.ToString(), out var parsed))
            return parsed;

        return null;
    }

