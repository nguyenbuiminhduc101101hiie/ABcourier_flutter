    private static void SetPropertyIfExists(object target, string propertyName, object? value)
    {
        var prop = target.GetType().GetProperty(propertyName);
        if (prop is null || !prop.CanWrite)
            return;

        if (value is null)
        {
            prop.SetValue(target, null);
            return;
        }

        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

        if (targetType == typeof(string))
        {
            prop.SetValue(target, value.ToString());
            return;
        }

        if (targetType == typeof(Guid))
        {
            if (value is Guid guidValue)
                prop.SetValue(target, guidValue);
            else if (Guid.TryParse(value.ToString(), out var parsedGuid))
                prop.SetValue(target, parsedGuid);
            return;
        }

        if (targetType == typeof(decimal))
        {
            if (value is decimal decimalValue)
                prop.SetValue(target, decimalValue);
            else if (decimal.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedDecimal))
                prop.SetValue(target, parsedDecimal);
            return;
        }

        prop.SetValue(target, value);
    }


    private async Task ExportLedgerStructureAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền export sổ cái.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            ConfigureEpplusLicense();

            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            // Export để import lại phải lấy đủ bút toán của chứng từ.
            // Vì nếu đang lọc theo Customer/Tài khoản mà chỉ export dòng đang thấy trên grid,
            // file import lại sẽ lệch Nợ/Có do thiếu dòng đối ứng.
            var baseQuery = db.GeneralLedgerEntries.AsNoTracking().AsQueryable();

            if (_fromDate.HasValue)
                baseQuery = baseQuery.Where(x => x.PostingDate >= _fromDate.Value.Date);

            if (_toDate.HasValue)
            {
                var toExclusive = _toDate.Value.Date.AddDays(1);
                baseQuery = baseQuery.Where(x => x.PostingDate < toExclusive);
            }

            if (IsPeriodMode && _fiscalYear.HasValue)
                baseQuery = baseQuery.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                baseQuery = baseQuery.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (!string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                if (_book == "TAX")
                    baseQuery = baseQuery.Where(x => x.IsTaxBook == true);

                if (_book == "MGMT")
                    baseQuery = baseQuery.Where(x => x.IsManagementBook == true);
            }

            // Không lọc CustomerId / AccountCode trực tiếp ở query export cuối,
            // mà chỉ dùng chúng để xác định chứng từ gốc cần export.
            // Như vậy file xuất ra luôn đủ dòng Nợ/Có của chứng từ và có thể import lại.
            var baseData = await baseQuery
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.AccountCode)
                .ThenBy(x => x.Id)
                .Take(100000)
                .ToListAsync();

            var seedData = baseData.Where(MatchesExportSeedFilter).ToList();

            if (seedData.Count == 0)
            {
                Snackbar.Add("Không có dữ liệu để export theo điều kiện lọc hiện tại.", MudBlazor.Severity.Warning);
                return;
            }

            var selectedVoucherIds = seedData
                .Select(x => GetGuidPropertyValue(x, "VoucherId"))
                .Where(x => x.HasValue && x.Value != Guid.Empty)
                .Select(x => x!.Value)
                .Distinct()
                .ToHashSet();

            var selectedSourceIds = seedData
                .Where(x => !string.IsNullOrWhiteSpace(x.SourceId))
                .Select(x => x.SourceId!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var selectedVoucherNos = seedData
                .Where(x => !string.IsNullOrWhiteSpace(x.VoucherNo))
                .Select(x => x.VoucherNo!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var data = baseData
                .Where(x =>
                {
                    var voucherId = GetGuidPropertyValue(x, "VoucherId");
                    if (voucherId.HasValue && voucherId.Value != Guid.Empty && selectedVoucherIds.Contains(voucherId.Value))
                        return true;

                    if (!string.IsNullOrWhiteSpace(x.SourceId) && selectedSourceIds.Contains(x.SourceId.Trim()))
                        return true;

                    if (!string.IsNullOrWhiteSpace(x.VoucherNo) && selectedVoucherNos.Contains(x.VoucherNo.Trim()))
                        return true;

                    return false;
                })
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.AccountCode)
                .ThenBy(x => x.Id)
                .ToList();

            if (data.Count == 0)
            {
                Snackbar.Add("Không có dữ liệu để export sau khi lấy đủ chứng từ.", MudBlazor.Severity.Warning);
                return;
            }

            var unbalancedVoucherCount = data
                .GroupBy(x => new
                {
                    Voucher = (x.VoucherNo ?? string.Empty).Trim().ToUpperInvariant(),
                    Book = GetBookForExport(x).Trim().ToUpperInvariant()
                })
                .Count(g => Math.Round(g.Sum(x => x.Debit) - g.Sum(x => x.Credit), 2) != 0);

            var customerIds = data
                .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
                .Select(x => x.CustomerId!.Value)
                .Distinct()
                .ToHashSet();

            var customerMap = new Dictionary<Guid, (string Code, string Name)>();
            if (customerIds.Count > 0)
            {
                var customers = (await db.Customer.AsNoTracking()
                    .Select(c => new
                    {
                        c.Customer_ID,
                        c.Customer_Code,
                        c.MainCode,
                        c.COMPANY,
                        c.EnglishName
                    })
                    .Take(50000)
                    .ToListAsync())
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .ToList();

                customerMap = customers.GroupBy(x => x.Customer_ID).ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var c = g.First();
                        var code = !string.IsNullOrWhiteSpace(c.Customer_Code) ? c.Customer_Code.Trim() : c.MainCode?.Trim() ?? string.Empty;
                        var name = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY.Trim() : c.EnglishName?.Trim() ?? string.Empty;
                        return (code, name);
                    });
            }

            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("GL Import");
            var summary = package.Workbook.Worksheets.Add("Summary");
            var guide = package.Workbook.Worksheets.Add("Guide");

            var headers = LedgerImportExportHeaders();
            for (var i = 0; i < headers.Length; i++)
            {
                ws.Cells[1, i + 1].Value = headers[i];
                ws.Cells[1, i + 1].Style.Font.Bold = true;
                ws.Cells[1, i + 1].Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                ws.Cells[1, i + 1].Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(31, 78, 121));
                ws.Cells[1, i + 1].Style.Font.Color.SetColor(System.Drawing.Color.White);
            }

            var rowIndex = 2;
            foreach (var line in data)
            {
                customerMap.TryGetValue(line.CustomerId ?? Guid.Empty, out var customer);

                var values = new object?[]
                {
                    line.PostingDate,
                    line.VoucherDate,
                    line.VoucherNo ?? string.Empty,
                    string.IsNullOrWhiteSpace(line.LedgerType) ? line.SourceModule ?? string.Empty : line.LedgerType,
                    line.AccountCode ?? string.Empty,
                    line.CustomerId?.ToString() ?? string.Empty,
                    customer.Code,
                    customer.Name,
                    line.CompanyId.ToString(),
                    GetPropertyText(line, "BranchCode"),
                    line.Description ?? string.Empty,
                    line.Debit,
                    line.Credit,
                    line.CurrencyCode ?? "VND",
                    line.ExchangeRate,
                    GetDecimalProperty(line, "DebitFC", line.Debit),
                    GetDecimalProperty(line, "CreditFC", line.Credit),
                    GetBookForExport(line),
                    line.SourceModule ?? string.Empty,
                    line.SourceId ?? string.Empty,
                    GetPropertyText(line, "VoucherLineId"),
                    GetPropertyText(line, "SupplierId"),
                    GetPropertyText(line, "EmployeeId"),
                    GetPropertyText(line, "ShipmentId"),
                    GetPropertyText(line, "ContractId"),
                    GetPropertyText(line, "HBLId"),
                    GetPropertyText(line, "MBLid"),
                    GetPropertyText(line, "AgentId"),
                    GetPropertyText(line, "ContainerId"),
                    GetPropertyText(line, "HBLNo"),
                    GetPropertyText(line, "MBLNo"),
                    GetPropertyText(line, "ContainerNo"),
                    GetPropertyText(line, "BookingNo"),
                    GetPropertyText(line, "ShipmentNo"),
                    GetPropertyText(line, "POL"),
                    GetPropertyText(line, "POD"),
                    GetPropertyText(line, "RouteCode"),
                    GetPropertyText(line, "TransportMode"),
                    GetPropertyText(line, "POLCode"),
                    GetPropertyText(line, "POLName"),
                    GetPropertyText(line, "PODCode"),
                    GetPropertyText(line, "PODName"),
                    GetPropertyText(line, "ContainerSizeType"),
                    GetPropertyText(line, "SealNo"),
                    GetPropertyText(line, "Jobid"),
                    GetPropertyText(line, "SaleName"),
                    GetPropertyText(line, "OPS"),
                    GetPropertyText(line, "DOC"),
                    GetPropertyText(line, "DELCode"),
                    GetPropertyText(line, "DELName"),
                    GetPropertyText(line, "PORCode"),
                    GetPropertyText(line, "PORName"),
                    GetPropertyText(line, "Vessel"),
                    GetPropertyText(line, "Voyage")
                };

                for (var col = 0; col < values.Length; col++)
                {
                    ws.Cells[rowIndex, col + 1].Value = values[col];

                    if (values[col] is DateTime)
                        ws.Cells[rowIndex, col + 1].Style.Numberformat.Format = "dd/mm/yyyy";

                    if (values[col] is decimal or double or int or long)
                        ws.Cells[rowIndex, col + 1].Style.Numberformat.Format = "#,##0.00";
                }

                rowIndex++;
            }

            if (ws.Dimension is not null)
            {
                ws.Cells[ws.Dimension.Address].AutoFitColumns();
                ws.View.FreezePanes(2, 1);
                ws.Cells[1, 1, 1, headers.Length].AutoFilter = true;
            }

            BuildExportSummarySheet(summary, data.Count, data.Sum(x => x.Debit), data.Sum(x => x.Credit));
            BuildExportGuideSheet(guide);

            var bytes = package.GetAsByteArray();
            var fileName = $"GL_Export_FullVoucher_Reimport_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await DownloadBytesAsync(bytes, fileName);

            if (unbalancedVoucherCount > 0)
            {
                Snackbar.Add($"Đã export {data.Count:N0} dòng nhưng còn {unbalancedVoucherCount:N0} chứng từ lệch Nợ/Có trong dữ liệu gốc.", MudBlazor.Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Đã export {data.Count:N0} dòng đủ chứng từ, file có thể import lại.", MudBlazor.Severity.Success);
            }
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            Snackbar.Add("Export Excel thất bại: " + root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task ExportCongNoTongHopAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xuất sổ công nợ tổng hợp.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            ConfigureEpplusLicense();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            if (!_fromDate.HasValue || !_toDate.HasValue)
            {
                Snackbar.Add("Vui lòng chọn Từ ngày / Đến ngày trước khi export.", MudBlazor.Severity.Warning);
                return;
            }

            var fromDate = _fromDate.Value.Date;
            var toDate = _toDate.Value.Date;
            var toExclusive = toDate.AddDays(1);

            await using var db = await DbFactory.CreateDbContextAsync();

            var query = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.CustomerId != null && x.CustomerId != Guid.Empty)
                .Where(x => x.PostingDate < toExclusive);

            if (!string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                if (_book == "TAX")
                    query = query.Where(x => x.IsTaxBook == true);

                if (_book == "MGMT")
                    query = query.Where(x => x.IsManagementBook == true);
            }

            var accountFilter = (_accountCode ?? string.Empty).Trim();
            var useDebtAccountsOnly = string.IsNullOrWhiteSpace(accountFilter)
                || string.Equals(accountFilter, "ALL", StringComparison.OrdinalIgnoreCase);

            if (useDebtAccountsOnly)
            {
                query = query.Where(x => x.AccountCode != null
                    && (x.AccountCode.StartsWith("131") || x.AccountCode.StartsWith("331")));
            }
            else
            {
                query = query.Where(x => x.AccountCode != null && x.AccountCode.StartsWith(accountFilter));
            }

            if (_customerIdFilter.HasValue && _customerIdFilter.Value != Guid.Empty)
                query = query.Where(x => x.CustomerId == _customerIdFilter.Value);

            var lines = await query
                .Select(x => new
                {
                    x.CustomerId,
                    x.AccountCode,
                    x.PostingDate,
                    x.Debit,
                    x.Credit,
                    x.DebitFC,
                    x.CreditFC
                })
                .ToListAsync();

            if (lines.Count == 0)
            {
                Snackbar.Add("Không có dữ liệu công nợ theo điều kiện lọc hiện tại.", MudBlazor.Severity.Warning);
                return;
            }

            var grouped = lines
                .GroupBy(x => x.CustomerId!.Value)
                .Select(g =>
                {
                    var opening = g.Where(x => x.PostingDate < fromDate).ToList();
                    var period = g.Where(x => x.PostingDate >= fromDate).ToList();

                    var openingDebit = opening.Sum(x => x.Debit);
                    var openingCredit = opening.Sum(x => x.Credit);
                    var openingNt = opening.Sum(x => x.DebitFC - x.CreditFC);

                    var periodDebit = period.Sum(x => x.Debit);
                    var periodCredit = period.Sum(x => x.Credit);
                    var periodNt = period.Sum(x => x.DebitFC - x.CreditFC);

                    var openingNet = openingDebit - openingCredit;
                    var closingNet = openingNet + periodDebit - periodCredit;
                    var closingNt = openingNt + periodNt;

                    SplitDebitCredit(openingNet, out var openDr, out var openCr);
                    SplitDebitCredit(closingNet, out var closeDr, out var closeCr);

                    return new CongNoTongHopExportRow
                    {
                        CustomerId = g.Key,
                        OpeningNt = openingNt,
                        OpeningDebit = openDr,
                        OpeningCredit = openCr,
                        PeriodNt = periodNt,
                        PeriodDebit = periodDebit,
                        PeriodCredit = periodCredit,
                        ClosingNt = closingNt,
                        ClosingDebit = closeDr,
                        ClosingCredit = closeCr
                    };
                })
                .Where(x => x.OpeningDebit != 0
                            || x.OpeningCredit != 0
                            || x.OpeningNt != 0
                            || x.PeriodDebit != 0
                            || x.PeriodCredit != 0
                            || x.PeriodNt != 0
                            || x.ClosingDebit != 0
                            || x.ClosingCredit != 0
                            || x.ClosingNt != 0)
                .ToList();

            var customerIds = grouped.Select(x => x.CustomerId).ToHashSet();
            var customers = await db.Customer.AsNoTracking()
                .Where(c => customerIds.Contains(c.Customer_ID))
                .Select(c => new { c.Customer_ID, c.Customer_Code, c.COMPANY })
                .ToListAsync();

            var customerMap = customers
                .GroupBy(x => x.Customer_ID)
                .ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var c = g.First();
                        return (
                            Code: (c.Customer_Code ?? string.Empty).Trim(),
                            Name: (c.COMPANY ?? string.Empty).Trim()
                        );
                    });

            foreach (var row in grouped)
            {
                if (customerMap.TryGetValue(row.CustomerId, out var info))
                {
                    row.CustomerCode = info.Code;
                    row.CustomerName = info.Name;
                }
            }

            if (!string.IsNullOrWhiteSpace(_searchCustomer))
            {
                var key = _searchCustomer.Trim();
                grouped = grouped
                    .Where(x => x.CustomerCode.Contains(key, StringComparison.OrdinalIgnoreCase)
                             || x.CustomerName.Contains(key, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            grouped = grouped
                .OrderBy(x => x.CustomerCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.CustomerName, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (grouped.Count == 0)
            {
                Snackbar.Add("Không có khách hàng thỏa điều kiện export.", MudBlazor.Severity.Warning);
                return;
            }

            var company = await db.CompanyInfomation.AsNoTracking().FirstOrDefaultAsync();
            var companyName = string.IsNullOrWhiteSpace(company?.NameTiengViet)
                ? "CÔNG TY TNHH HÀNG HẢI AMASIS"
                : company!.NameTiengViet!.Trim();
            var companyAddress = string.IsNullOrWhiteSpace(company?.AddressTiengViet)
                ? (company?.Address ?? "Số 27-29 Đường Ngô Thị Bì, Phường Tân Hưng, TP Hồ Chí Minh")
                : company!.AddressTiengViet!.Trim();
            var taxCode = string.IsNullOrWhiteSpace(company?.TaxCode) ? "0311095854" : company!.TaxCode!.Trim();

            var accountLabel = await BuildCongNoAccountLabelAsync(db, accountFilter, useDebtAccountsOnly, lines
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                .Select(x => x.AccountCode!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList());

            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("Sheet1");
            BuildCongNoTongHopSheet(ws, companyName, companyAddress, taxCode, fromDate, toDate, accountLabel, grouped);

            var bytes = package.GetAsByteArray();
            var fileName = $"SO_TONG_HOP_CONG_NO_{fromDate:yyyyMMdd}_{toDate:yyyyMMdd}_{DateTime.Now:HHmmss}.xlsx";
            await DownloadBytesAsync(bytes, fileName);

            Snackbar.Add($"Đã export sổ công nợ tổng hợp: {grouped.Count:N0} khách hàng.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            Snackbar.Add("Export sổ công nợ thất bại: " + root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private static void SplitDebitCredit(decimal net, out decimal debit, out decimal credit)
    {
        if (net > 0)
        {
            debit = net;
            credit = 0;
        }
        else if (net < 0)
        {
            debit = 0;
            credit = Math.Abs(net);
        }
        else
        {
            debit = 0;
            credit = 0;
        }
    }

    private async Task<string> BuildCongNoAccountLabelAsync(
        AppDbContext db,
        string accountFilter,
        bool useDebtAccountsOnly,
        List<string> accountCodesInData)
    {
        if (useDebtAccountsOnly)
            return "Tất cả TK công nợ 131… / 331…";

        var name = await db.DanhMucTaiKhoan.AsNoTracking()
            .Where(a => a.Taikhoan == accountFilter)
            .Select(a => a.Tentaikhoan)
            .FirstOrDefaultAsync();

        if (!string.IsNullOrWhiteSpace(name))
            return $"{accountFilter} - {name.Trim()}";

        if (accountCodesInData.Count == 1)
            return accountCodesInData[0];

        return accountFilter;
    }

