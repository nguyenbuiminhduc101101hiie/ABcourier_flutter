    private async Task EnrichAndValidateImportRowsAsync()
    {
        if (!_importRows.Any())
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var accountCodes = _importRows
            .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
            .Select(x => x.AccountCode.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var accountMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (accountCodes.Count > 0)
        {
            var accounts = (await db.DanhMucTaiKhoan.AsNoTracking()
                .Where(a => !string.IsNullOrWhiteSpace(a.Taikhoan))
                .Select(a => new { Code = a.Taikhoan, Name = a.Tentaikhoan })
                .ToListAsync())
                .Where(a => !string.IsNullOrWhiteSpace(a.Code) && accountCodes.Contains(a.Code.Trim()))
                .ToList();

            accountMap = accounts
                .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                .GroupBy(x => x.Code!)
                .ToDictionary(g => g.Key, g => g.First().Name ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        }

        var customerCodes = _importRows
            .Where(x => !string.IsNullOrWhiteSpace(x.CustomerCode))
            .Select(x => x.CustomerCode.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var customerIdsFromExcel = _importRows
            .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
            .Select(x => x.CustomerId!.Value)
            .Distinct()
            .ToHashSet();

        var customerMap = new Dictionary<string, (Guid Id, string Name)>(StringComparer.OrdinalIgnoreCase);
        var customerIdMap = new Dictionary<Guid, (string Code, string Name)>();

        if (customerCodes.Count > 0 || customerIdsFromExcel.Count > 0)
        {
            var customers = (await db.Customer.AsNoTracking()
                .Select(c => new { c.Customer_ID, c.Customer_Code, c.MainCode, c.COMPANY, c.EnglishName })
                .Take(50000)
                .ToListAsync())
                .Where(c => customerIdsFromExcel.Contains(c.Customer_ID)
                         || (!string.IsNullOrWhiteSpace(c.Customer_Code) && customerCodes.Contains(c.Customer_Code.Trim()))
                         || (!string.IsNullOrWhiteSpace(c.MainCode) && customerCodes.Contains(c.MainCode.Trim())))
                .ToList();

            foreach (var c in customers)
            {
                var code = !string.IsNullOrWhiteSpace(c.Customer_Code) ? c.Customer_Code.Trim() : c.MainCode?.Trim() ?? string.Empty;
                var name = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY : c.EnglishName ?? string.Empty;

                customerIdMap[c.Customer_ID] = (code, name);

                if (!string.IsNullOrWhiteSpace(c.Customer_Code))
                    customerMap[c.Customer_Code.Trim()] = (c.Customer_ID, name);

                if (!string.IsNullOrWhiteSpace(c.MainCode))
                    customerMap[c.MainCode.Trim()] = (c.Customer_ID, name);
            }
        }

        foreach (var row in _importRows)
        {
            if (!string.IsNullOrWhiteSpace(row.AccountCode))
            {
                if (accountMap.TryGetValue(row.AccountCode.Trim(), out var accountName))
                    row.AccountName = accountName;
                else
                    row.Errors.Add("Tài khoản không có trong danh mục");
            }

            if (row.CustomerId.HasValue && row.CustomerId.Value != Guid.Empty)
            {
                if (customerIdMap.TryGetValue(row.CustomerId.Value, out var customerById))
                {
                    if (string.IsNullOrWhiteSpace(row.CustomerCode))
                        row.CustomerCode = customerById.Code;

                    if (string.IsNullOrWhiteSpace(row.CustomerName))
                        row.CustomerName = customerById.Name;
                }
                else
                {
                    row.Errors.Add("CustomerId không tồn tại trong danh mục Customer");
                }
            }
            else if (!string.IsNullOrWhiteSpace(row.CustomerCode))
            {
                if (customerMap.TryGetValue(row.CustomerCode.Trim(), out var customer))
                {
                    row.CustomerId = customer.Id;
                    if (string.IsNullOrWhiteSpace(row.CustomerName))
                        row.CustomerName = customer.Name;
                }
                else
                {
                    row.Warnings.Add("Không tìm thấy mã đối tượng; vẫn import nhưng không gắn CustomerId");
                }
            }
        }

        ValidateImportVoucherBalance();

        if (!_allowDuplicateImport)
            await ValidateDuplicateVoucherAsync(db);
    }

    private void ValidateImportVoucherBalance()
    {
        foreach (var g in _importRows
            .Where(x => string.IsNullOrWhiteSpace(x.Errors.FirstOrDefault(e => e.Contains("thiếu", StringComparison.OrdinalIgnoreCase))))
            .GroupBy(x => new { Voucher = x.VoucherNo.Trim().ToUpperInvariant(), Book = x.Book.Trim().ToUpperInvariant() }))
        {
            var diff = Math.Round(g.Sum(x => x.Debit) - g.Sum(x => x.Credit), 2);
            if (diff != 0)
            {
                foreach (var row in g)
                    row.Errors.Add($"Chứng từ lệch Nợ/Có: {diff:N0}");
            }
        }
    }

    private async Task ValidateDuplicateVoucherAsync(AppDbContext db)
    {
        var voucherNos = _importRows
            .Where(x => !string.IsNullOrWhiteSpace(x.VoucherNo))
            .Select(x => x.VoucherNo.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (voucherNos.Count == 0)
            return;

        var existed = (await db.GeneralLedgerEntries.AsNoTracking()
            .Where(x => x.VoucherNo != null)
            .Select(x => x.VoucherNo!)
            .Distinct()
            .Take(200000)
            .ToListAsync())
            .Where(x => voucherNos.Contains(x, StringComparer.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (existed.Count == 0)
            return;

        var existedSet = existed.ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var row in _importRows.Where(x => existedSet.Contains(x.VoucherNo)))
            row.Errors.Add("Số chứng từ đã tồn tại trong sổ cái");
    }

    private async Task ImportLedgerRowsAsync()
    {
        if (!_importRows.Any())
        {
            Snackbar.Add("Chưa có dữ liệu preview để import.", MudBlazor.Severity.Warning);
            return;
        }

        if (_importRows.Any(x => !x.IsValid))
        {
            Snackbar.Add("File còn dòng lỗi. Vui lòng sửa Excel rồi đọc thử lại trước khi import.", MudBlazor.Severity.Error);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            var importBatchId = Guid.NewGuid();
            var now = DateTime.Now;

            var entities = _importRows.Select(row =>
            {
                var entity = new M_GeneralLedgerEntries
                {
                    Id = Guid.NewGuid(),
                    VoucherId = Guid.NewGuid(),
                    PostingDate = row.PostingDate!.Value.Date,
                    VoucherNo = row.VoucherNo.Trim(),
                    VoucherDate = (row.VoucherDate ?? row.PostingDate!.Value).Date,
                    LedgerType = string.IsNullOrWhiteSpace(row.VoucherType) ? "IMPORT" : row.VoucherType.Trim(),
                    SourceModule = string.IsNullOrWhiteSpace(row.SourceModule) ? "GL_IMPORT" : row.SourceModule.Trim(),
                    SourceId = string.IsNullOrWhiteSpace(row.SourceId) ? importBatchId.ToString() : row.SourceId.Trim(),
                    AccountCode = row.AccountCode.Trim(),
                    CustomerId = row.CustomerId,
                    Description = row.Description.Trim(),
                    Debit = row.Debit,
                    Credit = row.Credit,
                    CurrencyCode = string.IsNullOrWhiteSpace(row.CurrencyCode) ? "VND" : row.CurrencyCode.Trim().ToUpperInvariant(),
                    ExchangeRate = row.ExchangeRate <= 0 ? 1 : row.ExchangeRate,
                    FiscalYear = row.PostingDate!.Value.Year,
                    FiscalPeriod = row.PostingDate!.Value.Month,
                    IsTaxBook = row.Book.Equals("TAX", StringComparison.OrdinalIgnoreCase) || row.Book.Equals("TAX/MGMT", StringComparison.OrdinalIgnoreCase),
                    IsManagementBook = row.Book.Equals("MGMT", StringComparison.OrdinalIgnoreCase) || row.Book.Equals("TAX/MGMT", StringComparison.OrdinalIgnoreCase),
                    CreatedAt = now,
                    CreatedBy = string.IsNullOrWhiteSpace(_usr) ? "IMPORT" : _usr
                };

                SetLedgerImportExtraFields(entity, row);
                return entity;
            }).ToList();

            db.GeneralLedgerEntries.AddRange(entities);
            await db.SaveChangesAsync();

            if (_importRebuildBalance)
                await RebuildBalanceForImportedRowsAsync(entities);

            Snackbar.Add($"Import thành công {entities.Count:N0} dòng sổ cái. Batch: {importBatchId}", MudBlazor.Severity.Success);

            ClearImportPreview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            Snackbar.Add(root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RebuildBalanceForImportedRowsAsync(List<M_GeneralLedgerEntries> entities)
    {
        var periods = entities
            .SelectMany(x => GetBooksForLedgerLine(x).Select(book => new { x.FiscalYear, x.FiscalPeriod, Book = book }))
            .Distinct()
            .ToList();

        if (periods.Count == 0)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var conn = db.Database.GetDbConnection();
        var shouldClose = conn.State != System.Data.ConnectionState.Open;
        if (shouldClose)
            await conn.OpenAsync();

        try
        {
            foreach (var p in periods)
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "dbo.usp_CalculateAccountBalance_FromLedger";
                cmd.CommandType = System.Data.CommandType.StoredProcedure;
                cmd.CommandTimeout = 180;

                AddSqlParameter(cmd, "@FiscalYear", p.FiscalYear);
                AddSqlParameter(cmd, "@PeriodMonth", p.FiscalPeriod);
                AddSqlParameter(cmd, "@BookCode", p.Book);
                AddSqlParameter(cmd, "@CompanyId", DBNull.Value);

                await cmd.ExecuteNonQueryAsync();
            }
        }
        finally
        {
            if (shouldClose)
                await conn.CloseAsync();
        }
    }

    private static IEnumerable<string> GetBooksForLedgerLine(M_GeneralLedgerEntries line)
    {
        if (line.IsTaxBook == true)
            yield return "TAX";

        if (line.IsManagementBook == true)
            yield return "MGMT";
    }

    private static void AddSqlParameter(System.Data.Common.DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

