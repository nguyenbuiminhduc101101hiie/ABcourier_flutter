    private static bool IsExcelRowEmpty(ExcelWorksheet ws, int row, int endCol)
    {
        for (var col = 1; col <= endCol; col++)
        {
            if (!string.IsNullOrWhiteSpace(ws.Cells[row, col].Text))
                return false;
        }

        return true;
    }

    private static string GetTextCell(ExcelWorksheet ws, int row, Dictionary<string, int> map, string key)
    {
        if (!map.TryGetValue(key, out var col))
            return string.Empty;

        return ws.Cells[row, col].Text?.Trim() ?? string.Empty;
    }

    private static Guid? GetGuidCell(ExcelWorksheet ws, int row, Dictionary<string, int> map, string key)
    {
        var text = GetTextCell(ws, row, map, key);
        if (Guid.TryParse(text, out var value))
            return value;

        return null;
    }

    private static decimal GetDecimalCell(ExcelWorksheet ws, int row, Dictionary<string, int> map, string key)
    {
        if (!map.TryGetValue(key, out var col))
            return 0m;

        var cell = ws.Cells[row, col];
        if (cell.Value is decimal dec) return dec;
        if (cell.Value is double d) return Convert.ToDecimal(d);
        if (cell.Value is int i) return i;
        if (cell.Value is long l) return l;

        return ParseDecimal(cell.Text);
    }

    private static DateTime? GetDateCell(ExcelWorksheet ws, int row, Dictionary<string, int> map, string key)
    {
        if (!map.TryGetValue(key, out var col))
            return null;

        var cell = ws.Cells[row, col];
        if (cell.Value is DateTime dt)
            return dt.Date;

        if (cell.Value is double oa && oa > 0)
        {
            try { return DateTime.FromOADate(oa).Date; } catch { }
        }

        return ParseDate(cell.Text);
    }

    private static decimal ParseDecimal(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return 0m;

        var s = value.Trim()
            .Replace("VND", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("USD", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("₫", string.Empty)
            .Replace(" ", string.Empty);

        if (decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out var result))
            return result;

        if (decimal.TryParse(s, NumberStyles.Any, CultureInfo.GetCultureInfo("vi-VN"), out result))
            return result;

        if (decimal.TryParse(s.Replace(",", string.Empty), NumberStyles.Any, CultureInfo.InvariantCulture, out result))
            return result;

        return 0m;
    }

    private static DateTime? ParseDate(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        var formats = new[] { "dd/MM/yyyy", "d/M/yyyy", "yyyy-MM-dd", "MM/dd/yyyy", "M/d/yyyy", "dd-MM-yyyy", "d-M-yyyy" };
        if (DateTime.TryParseExact(value.Trim(), formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            return date.Date;

        if (DateTime.TryParse(value.Trim(), CultureInfo.GetCultureInfo("vi-VN"), DateTimeStyles.None, out date))
            return date.Date;

        return null;
    }

    private void NormalizeImportRow(LedgerImportRow row)
    {
        row.VoucherNo = row.VoucherNo.Trim();
        row.VoucherType = string.IsNullOrWhiteSpace(row.VoucherType) ? "IMPORT" : row.VoucherType.Trim();
        row.AccountCode = row.AccountCode.Trim();
        row.CustomerCode = row.CustomerCode.Trim();
        row.CustomerName = row.CustomerName.Trim();
        row.Description = row.Description.Trim();
        row.CurrencyCode = string.IsNullOrWhiteSpace(row.CurrencyCode) ? "VND" : row.CurrencyCode.Trim().ToUpperInvariant();
        row.ExchangeRate = row.ExchangeRate <= 0 ? 1 : row.ExchangeRate;
        row.DebitFC = row.DebitFC == 0 ? row.Debit : row.DebitFC;
        row.CreditFC = row.CreditFC == 0 ? row.Credit : row.CreditFC;
        row.Book = NormalizeImportBook(row.Book);
        row.SourceModule = string.IsNullOrWhiteSpace(row.SourceModule) ? "GL_IMPORT" : row.SourceModule.Trim();

        if (!row.VoucherDate.HasValue)
            row.VoucherDate = row.PostingDate;
    }

    private string NormalizeImportBook(string? book)
    {
        var b = (book ?? string.Empty).Trim().ToUpperInvariant();
        if (b is "TAX" or "MGMT" or "TAX/MGMT")
            return b;

        if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
            return "TAX";

        if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
            return "MGMT";

        return "TAX";
    }

    private static void ValidateImportRowBasic(LedgerImportRow row)
    {
        if (!row.PostingDate.HasValue)
            row.Errors.Add("Thiếu/ngày HT không hợp lệ");

        if (string.IsNullOrWhiteSpace(row.VoucherNo))
            row.Errors.Add("Thiếu số chứng từ");

        if (string.IsNullOrWhiteSpace(row.AccountCode))
            row.Errors.Add("Thiếu tài khoản");

        if (!row.CompanyId.HasValue || row.CompanyId.Value == Guid.Empty)
            row.Errors.Add("Thiếu CompanyId");

        if (row.Debit < 0 || row.Credit < 0)
            row.Errors.Add("Nợ/Có không được âm");

        if (row.Debit == 0 && row.Credit == 0)
            row.Errors.Add("Dòng không có phát sinh Nợ/Có");

        if (row.Debit > 0 && row.Credit > 0)
            row.Errors.Add("Một dòng không nên vừa Nợ vừa Có");
    }

    private static string NormalizeHeader(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var normalized = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder();

        foreach (var c in normalized)
        {
            var unicodeCategory = CharUnicodeInfo.GetUnicodeCategory(c);
            if (unicodeCategory == UnicodeCategory.NonSpacingMark)
                continue;

            if (char.IsLetterOrDigit(c))
                builder.Append(char.ToLowerInvariant(c));
        }

        return builder.ToString().Replace("đ", "d").Replace("Đ", "d");
    }

