    private static Dictionary<string, int> BuildImportHeaderMap(ExcelWorksheet ws)
    {
        var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var aliases = ImportHeaderAliases();

        for (var col = 1; col <= ws.Dimension.End.Column; col++)
        {
            var header = NormalizeHeader(ws.Cells[1, col].Text);
            if (string.IsNullOrWhiteSpace(header))
                continue;

            if (aliases.TryGetValue(header, out var canonical) && !map.ContainsKey(canonical))
                map[canonical] = col;
        }

        return map;
    }

