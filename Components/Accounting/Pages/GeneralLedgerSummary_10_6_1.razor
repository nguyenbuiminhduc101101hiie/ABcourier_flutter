            return;
        }

        try
        {
            _busy = true;
            _importRows.Clear();

            ConfigureEpplusLicense();

            await using var stream = _importFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            using var package = new ExcelPackage(ms);
            var ws = package.Workbook.Worksheets.FirstOrDefault();

            if (ws?.Dimension is null)
            {
                Snackbar.Add("File Excel không có dữ liệu.", MudBlazor.Severity.Warning);
                return;
            }

            _defaultCompanyId = await GetDefaultCompanyIdAsync();

            var headerMap = BuildImportHeaderMap(ws);
            var missing = new List<string>();
            foreach (var required in new[] { "PostingDate", "VoucherNo", "AccountCode" })
            {
                if (!headerMap.ContainsKey(required))
                    missing.Add(required);
            }

            if (missing.Any())
