    private static string GetPropertyText(object target, string propertyName)
    {
        var value = target.GetType().GetProperty(propertyName)?.GetValue(target);
        if (value is null)
            return string.Empty;

        return value switch
        {
            DateTime date => date.ToString("dd/MM/yyyy"),
            decimal dec => dec.ToString(CultureInfo.InvariantCulture),
            _ => value.ToString() ?? string.Empty
        };
    }

    private static decimal GetDecimalProperty(object target, string propertyName, decimal fallback = 0m)
    {
        var value = target.GetType().GetProperty(propertyName)?.GetValue(target);
        if (value is null)
            return fallback;

        if (value is decimal dec)
            return dec;

        if (value is double dbl)
            return Convert.ToDecimal(dbl);

        if (value is int i)
            return i;

        if (value is long l)
            return l;

        return decimal.TryParse(value.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : fallback;
    }

