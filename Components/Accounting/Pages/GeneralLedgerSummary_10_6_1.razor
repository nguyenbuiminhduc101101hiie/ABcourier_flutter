                    Description = GetTextCell(ws, row, headerMap, "Description"),
                    Debit = GetDecimalCell(ws, row, headerMap, "Debit"),
                    Credit = GetDecimalCell(ws, row, headerMap, "Credit"),
                    CurrencyCode = GetTextCell(ws, row, headerMap, "CurrencyCode"),
                    ExchangeRate = GetDecimalCell(ws, row, headerMap, "ExchangeRate"),
                    DebitFC = GetDecimalCell(ws, row, headerMap, "DebitFC"),
                    CreditFC = GetDecimalCell(ws, row, headerMap, "CreditFC"),
                    Book = GetTextCell(ws, row, headerMap, "Book"),
                    SourceModule = GetTextCell(ws, row, headerMap, "SourceModule"),
                    SourceId = GetTextCell(ws, row, headerMap, "SourceId"),
                    CompanyId = GetGuidCell(ws, row, headerMap, "CompanyId"),
                    VoucherLineId = GetGuidCell(ws, row, headerMap, "VoucherLineId"),
                    SupplierId = GetGuidCell(ws, row, headerMap, "SupplierId"),
                    EmployeeId = GetGuidCell(ws, row, headerMap, "EmployeeId"),
                    ShipmentId = GetGuidCell(ws, row, headerMap, "ShipmentId"),
                    ContractId = GetGuidCell(ws, row, headerMap, "ContractId"),
                    HBLId = GetGuidCell(ws, row, headerMap, "HBLId"),
                    MBLid = GetGuidCell(ws, row, headerMap, "MBLid"),
                    AgentId = GetGuidCell(ws, row, headerMap, "AgentId"),
                    ContainerId = GetGuidCell(ws, row, headerMap, "ContainerId"),
                    BranchCode = GetTextCell(ws, row, headerMap, "BranchCode"),
                    HBLNo = GetTextCell(ws, row, headerMap, "HBLNo"),
                    MBLNo = GetTextCell(ws, row, headerMap, "MBLNo"),
                    ContainerNo = GetTextCell(ws, row, headerMap, "ContainerNo"),
                    BookingNo = GetTextCell(ws, row, headerMap, "BookingNo"),
                    ShipmentNo = GetTextCell(ws, row, headerMap, "ShipmentNo"),
                    POL = GetTextCell(ws, row, headerMap, "POL"),
                    POD = GetTextCell(ws, row, headerMap, "POD"),
                    RouteCode = GetTextCell(ws, row, headerMap, "RouteCode"),
