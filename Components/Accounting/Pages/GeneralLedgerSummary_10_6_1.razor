        => row.IsValid ? string.Empty : "import-row-error";

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            _rows.Clear();
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var query = db.GeneralLedgerEntries.AsNoTracking().AsQueryable();

            if (_fromDate.HasValue)
                query = query.Where(x => x.PostingDate >= _fromDate.Value.Date);

            if (_toDate.HasValue)
            {
                var toExclusive = _toDate.Value.Date.AddDays(1);
                query = query.Where(x => x.PostingDate < toExclusive);
            }

            if (IsPeriodMode && _fiscalYear.HasValue)
                query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (!string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                if (_book == "TAX")
                    query = query.Where(x => x.IsTaxBook == true);

                if (_book == "MGMT")
                    query = query.Where(x => x.IsManagementBook == true);
            }

            if (!string.IsNullOrWhiteSpace(_accountCode)
                && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                var acc = _accountCode.Trim();
                query = query.Where(x => x.AccountCode != null && x.AccountCode.StartsWith(acc));
            }

            if (_customerIdFilter.HasValue && _customerIdFilter.Value != Guid.Empty)
            {
                query = query.Where(x => x.CustomerId == _customerIdFilter.Value);
            }

            var data = await query
                .OrderByDescending(x => x.PostingDate)
                .ThenByDescending(x => x.CreatedAt)
                .Take(5000)
                .ToListAsync();

            var customerIds = data
                .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
                .Select(x => x.CustomerId!.Value)
                .Distinct()
                .ToHashSet();

            var customerMap = new Dictionary<Guid, string>();
            if (customerIds.Count > 0)
            {
                var customers = (await db.Customer.AsNoTracking()
                    .Select(c => new
                    {
                        c.Customer_ID,
                        c.Customer_Code,
                        c.COMPANY
                    })
                    .Take(50000)
                    .ToListAsync())
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .ToList();

                customerMap = customers
                    .GroupBy(x => x.Customer_ID)
                    .ToDictionary(
                        g => g.Key,
                        g =>
                        {
                            var c = g.First();
                            return string.IsNullOrWhiteSpace(c.Customer_Code)
                                ? (c.COMPANY ?? string.Empty)
                                : $"{c.Customer_Code} - {c.COMPANY}";
                        });
            }

            var accountCodes = data
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                .Select(x => x.AccountCode!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var accountMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (accountCodes.Count > 0)
            {
                var accounts = (await db.DanhMucTaiKhoan.AsNoTracking()
                    .Where(a => !string.IsNullOrWhiteSpace(a.Taikhoan))
                    .Select(a => new
                    {
                        Code = a.Taikhoan,
                        Name = a.Tentaikhoan
                    })
                    .ToListAsync())
                    .Where(a => !string.IsNullOrWhiteSpace(a.Code) && accountCodes.Contains(a.Code.Trim()))
                    .ToList();

                accountMap = accounts
                    .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                    .GroupBy(x => x.Code!)
                    .ToDictionary(g => g.Key, g => g.First().Name ?? string.Empty, StringComparer.OrdinalIgnoreCase);
            }

            var sourceIdsText = data
                .Where(x => !string.IsNullOrWhiteSpace(x.SourceId))
                .Select(x => x.SourceId!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var sourceMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            if (sourceIdsText.Count > 0)
            {
                var sourceVouchers = (await db.AccountingVouchers.AsNoTracking()
                    .Where(v => !string.IsNullOrWhiteSpace(v.SourceId))
                    .Select(v => new
                    {
                        v.SourceId,
                        v.VoucherNo,
                        v.Description
                    })
                    .Take(100000)
                    .ToListAsync())
                    .Where(v => !string.IsNullOrWhiteSpace(v.SourceId) && sourceIdsText.Contains(v.SourceId.Trim()))
                    .ToList();

                foreach (var v in sourceVouchers)
                {
                    if (string.IsNullOrWhiteSpace(v.SourceId))
                        continue;

                    sourceMap[v.SourceId.Trim()] = string.IsNullOrWhiteSpace(v.Description)
                        ? v.VoucherNo
                        : $"{v.VoucherNo} - {v.Description}";
                }

                var sourceIdsGuid = sourceIdsText
                    .Select(x => Guid.TryParse(x, out var id) ? id : Guid.Empty)
                    .Where(x => x != Guid.Empty)
                    .Distinct()
                    .ToHashSet();

                if (sourceIdsGuid.Count > 0)
                {
                    var receipts = (await db.Phieuthu.AsNoTracking()
                        .Select(p => new
                        {
                            Id = p.PhieuthuID,
                            No = p.SoPhieuthu,
                            Description = p.Noidung
                        })
                        .Take(100000)
                        .ToListAsync())
                        .Where(p => sourceIdsGuid.Contains(p.Id))
                        .ToList();

                    foreach (var p in receipts)
                    {
                        sourceMap[p.Id.ToString()] = string.IsNullOrWhiteSpace(p.Description)
                            ? p.No
                            : $"{p.No} - {p.Description}";
                    }
                }
            }

            var voucherLineIds = data
                .Where(x => x.VoucherLineId.HasValue && x.VoucherLineId.Value != Guid.Empty)
                .Select(x => x.VoucherLineId!.Value)
                .Distinct()
                .ToHashSet();

            var voucherLineMap = new Dictionary<Guid, M_AccountingVoucherLines>();
            if (voucherLineIds.Count > 0)
            {
                var voucherLines = await db.AccountingVoucherLines.AsNoTracking()
                    .Where(x => voucherLineIds.Contains(x.Id))
                    .ToListAsync();

                voucherLineMap = voucherLines
                    .GroupBy(x => x.Id)
                    .ToDictionary(g => g.Key, g => g.First());
            }

            _rows = data.Select(x => new GeneralLedgerSummaryRow
            {
                Id = x.Id,
                PostingDate = x.PostingDate,
                VoucherNo = x.VoucherNo ?? string.Empty,
                VoucherDate = x.VoucherDate,
                VoucherType = string.IsNullOrWhiteSpace(x.LedgerType) ? x.SourceModule ?? string.Empty : x.LedgerType,
                AccountCode = x.AccountCode ?? string.Empty,
                AccountName = !string.IsNullOrWhiteSpace(x.AccountCode) && accountMap.TryGetValue(x.AccountCode, out var accName)
                    ? accName
                    : string.Empty,
                SoHD = x.SoHD ?? string.Empty,
                CustomerName = x.CustomerId.HasValue && customerMap.TryGetValue(x.CustomerId.Value, out var customerName)
                    ? customerName
                    : string.Empty,
                Description = x.Description ?? string.Empty,
                HBLNo = x.VoucherLineId.HasValue && voucherLineMap.TryGetValue(x.VoucherLineId.Value, out var voucherLine)
                    ? voucherLine.HBLNo ?? string.Empty
                    : string.Empty,
                BookingNo = x.VoucherLineId.HasValue && voucherLineMap.TryGetValue(x.VoucherLineId.Value, out voucherLine)
                    ? voucherLine.BookingNo ?? string.Empty
                    : string.Empty,
                SaleName = x.VoucherLineId.HasValue && voucherLineMap.TryGetValue(x.VoucherLineId.Value, out voucherLine)
                    ? voucherLine.SaleName ?? string.Empty
                    : string.Empty,
                POLName = x.VoucherLineId.HasValue && voucherLineMap.TryGetValue(x.VoucherLineId.Value, out voucherLine)
                    ? voucherLine.POLName ?? string.Empty
                    : string.Empty,
                PODName = x.VoucherLineId.HasValue && voucherLineMap.TryGetValue(x.VoucherLineId.Value, out voucherLine)
                    ? voucherLine.PODName ?? string.Empty
                    : string.Empty,
                Debit = x.Debit,
                Credit = x.Credit,
                CurrencyCode = x.CurrencyCode ?? string.Empty,
                ExchangeRate = x.ExchangeRate,
                Book =
                    x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" :
                    x.IsTaxBook == true ? "TAX" :
                    x.IsManagementBook == true ? "MGMT" :
                    string.Empty,
                SourceName = !string.IsNullOrWhiteSpace(x.SourceId) && sourceMap.TryGetValue(x.SourceId.Trim(), out var sourceName)
                    ? sourceName
                    : x.SourceModule ?? string.Empty,
                CreatedBy = x.CreatedBy ?? string.Empty
            }).ToList();

            _accountCodes = _rows
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                .Select(x => x.AccountCode)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            if (!string.IsNullOrWhiteSpace(_accountCode)
                && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase)
                && !_accountCodes.Contains(_accountCode, StringComparer.OrdinalIgnoreCase))
            {
                _accountCodes.Insert(0, _accountCode);
            }

            _gridKey++;
            Snackbar.Add($"Loaded {_rows.Count:N0} ledger lines.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private bool MatchesFilter(GeneralLedgerSummaryRow x)
    {
        if (!string.IsNullOrWhiteSpace(_accountCode)
            && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase)
            && !x.AccountCode.StartsWith(_accountCode.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    private bool MatchesSearch(GeneralLedgerSummaryRow x)
    {
        if (!string.IsNullOrWhiteSpace(_searchVoucher)
            && !x.VoucherNo.Contains(_searchVoucher.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchCustomer)
            && !x.CustomerName.Contains(_searchCustomer.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchDescription)
            && !x.Description.Contains(_searchDescription.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchSource)
            && !x.SourceName.Contains(_searchSource.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

