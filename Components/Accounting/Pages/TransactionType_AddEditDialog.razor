@using MudBlazor
@using ABFreight.Models

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.Code" Label="Code" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_model.IsActive" Label="IsActive" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_TransactionTypes Model { get; set; } = new();

    private MudForm? _form;
    private M_TransactionTypes _model = new();

    protected override void OnParametersSet()
    {
        _model = new M_TransactionTypes
        {
            Id = Model.Id,
            Code = Model.Code ?? string.Empty,
            Name = Model.Name ?? string.Empty,
            Description = Model.Description,
            IsActive = Model.IsActive
        };
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();
        if (string.IsNullOrWhiteSpace(_model.Code) || string.IsNullOrWhiteSpace(_model.Name))
            return;

        _model.Code = _model.Code.Trim();
        _model.Name = _model.Name.Trim();
        _model.Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim();
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}

