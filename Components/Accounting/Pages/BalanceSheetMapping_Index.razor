@page "/balance-sheet-mapping"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>10.10 @LblScreenTitle</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"10.10 {LblScreenTitle}")" Subtitle="@LblScreenSubtitle">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap align-items-center">
                <MudSelect T="Guid"
                           Value="_filterCompanyId"
                           ValueChanged="OnCompanyFilterChangedAsync"
                           Label="@LblCompany"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Style="min-width:220px"
                           Dense="true">
                    @foreach (var c in _customers)
                    {
                        <MudSelectItem Value="@c.Customer_ID">@CompanyLabel(c)</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialogAsync" Disabled="_busy || _filterCompanyId == Guid.Empty">@Localizer["new"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditDialogAsync" Disabled="_busy || _selected is null">@Localizer["edit"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null">@Localizer["delete"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">@Localizer["reload"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3" Elevation="0">
        <MudTextField @bind-Value="_search" Label="@Localizer["BalanceSheetMapping.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
        <MudDataGrid T="M_FinancialReportLine"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     RowClick="OnRowClick"
                     RowClassFunc="RowClass"
                     Height="calc(100vh - 300px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.ReportType" Title="@LblColReportType" />
                <PropertyColumn Property="x => x.LineCode" Title="@LblColLineCode" />
                <PropertyColumn Property="x => x.LineName" Title="@LblColLineName" />
                <PropertyColumn Property="x => x.Section" Title="@Localizer["BalanceSheetMapping.Section"]" />
                <PropertyColumn Property="x => x.ReportGroup" Title="@LblColReportGroup" />
                <TemplateColumn Title="@LblColParent" Sortable="false" Filterable="false">
                    <CellTemplate>
                        @{
                            var p = context.Item.ParentLine;
                        }
                        @if (p is null && context.Item.ParentLineId is null)
                        {
                            <span class="mud-text-secondary">—</span>
                        }
                        else if (p is null)
                        {
                            <span class="mud-text-secondary">@context.Item.ParentLineId</span>
                        }
                        else
                        {
                            <span>@p.LineCode — @p.LineName</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.LineLevel" Title="@LblColLineLevel" />
                <TemplateColumn Title="@LblColTotal" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.IsTotalLine ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@LblColBold" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.IsBold ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.DisplayOrder" Title="@Localizer["AccountMapping.DisplayOrder"]" />
                <TemplateColumn Title="@Localizer["AccountMapping.IsActive"]" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.Active ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CreatedAt" Title="@LblColCreated" Format="dd/MM/yyyy HH:mm" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="M_FinancialReportLine" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "BalanceSheetMapping";

    private const string LblScreenTitle = "Dòng báo cáo TC / Financial report lines";
    private const string LblScreenSubtitle = "FinancialReportLines — ReportType, LineCode, LineName, Section, ParentLineId, DisplayOrder, Active.";
    private const string LblCompany = "Công ty / Company";
    private const string LblSelectCompanyFirst = "Chọn công ty trước. / Select a company first.";
    private const string LblDuplicateLine = "Đã tồn tại dòng cùng loại BC và mã dòng. / A line with this report type and line code already exists.";
    private const string LblAddTitle = "Thêm dòng báo cáo / Add financial report line";
    private const string LblEditTitle = "Sửa dòng báo cáo / Edit financial report line";
    private const string LblHasChildLines = "Có dòng con trỏ tới dòng này; xóa hoặc đổi cha của các dòng con trước. / Child lines reference this row; remove or re-parent them first.";
    private const string LblColReportType = "Loại BC / Type";
    private const string LblColLineCode = "Mã dòng / Code";
    private const string LblColLineName = "Tên dòng / Name";
    private const string LblColReportGroup = "Nhóm / Group";
    private const string LblColParent = "Dòng cha / Parent";
    private const string LblColLineLevel = "Cấp / Level";
    private const string LblColTotal = "Tổng / Total";
    private const string LblColBold = "Đậm / Bold";
    private const string LblColCreated = "Tạo lúc / Created";

    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private Guid _filterCompanyId;
    private List<M_Customer> _customers = new();
    private List<M_FinancialReportLine> _items = new();
    private M_FinancialReportLine? _selected;

    private IEnumerable<M_FinancialReportLine> VisibleItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x =>
                (x.ReportType?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LineCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LineName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Section?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ReportGroup?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        _customers = await db.Customer.AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.COMPANY)
            .ThenBy(x => x.BIZName)
            .ToListAsync();

        if (_customers.Count > 0)
            _filterCompanyId = _customers[0].Customer_ID;

        await LoadAsync();
    }

    private static string CompanyLabel(M_Customer c)
    {
        var a = (c.COMPANY ?? string.Empty).Trim();
        var b = (c.BIZName ?? string.Empty).Trim();
        if (!string.IsNullOrEmpty(a) && !string.IsNullOrEmpty(b) && !string.Equals(a, b, StringComparison.OrdinalIgnoreCase))
            return $"{a} ({b})";
        return string.IsNullOrEmpty(a) ? b : a;
    }

    private string? SelectedCompanyDisplay()
        => _customers.FirstOrDefault(x => x.Customer_ID == _filterCompanyId) is { } c ? CompanyLabel(c) : null;

    private async Task OnCompanyFilterChangedAsync(Guid id)
    {
        _filterCompanyId = id;
        _selected = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetMapping.NoAccessView"], MudBlazor.Severity.Warning);
            _items.Clear();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_filterCompanyId == Guid.Empty)
            {
                _items.Clear();
                _selected = null;
                return;
            }

            _items = await db.FinancialReportLines.AsNoTracking()
                .Include(x => x.ParentLine)
                .Where(x => x.CompanyId == _filterCompanyId)
                .OrderBy(x => x.ReportType)
                .ThenBy(x => x.DisplayOrder)
                .ThenBy(x => x.LineCode)
                .ToListAsync();
            _selected = null;
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<M_FinancialReportLine> args)
    {
        var r = args.Item;
        _selected = new M_FinancialReportLine
        {
            Id = r.Id,
            CompanyId = r.CompanyId,
            ReportType = r.ReportType,
            LineCode = r.LineCode,
            LineName = r.LineName,
            Section = r.Section,
            ReportGroup = r.ReportGroup,
            ParentLineId = r.ParentLineId,
            LineLevel = r.LineLevel,
            IsTotalLine = r.IsTotalLine,
            IsBold = r.IsBold,
            DisplayOrder = r.DisplayOrder,
            Active = r.Active,
            CreatedAt = r.CreatedAt,
            UpdatedAt = r.UpdatedAt,
            ParentLine = r.ParentLine
        };
    }

    private string RowClass(M_FinancialReportLine row, int _) =>
        _selected?.Id == row.Id ? "selected-row-blue" : string.Empty;

    private async Task OpenAddDialogAsync()
    {
        if (_filterCompanyId == Guid.Empty)
        {
            CallSnack(LblSelectCompanyFirst, MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetMapping.NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<BalanceSheetMapping_AddEditDialog>(
            LblAddTitle,
            new DialogParameters
            {
                ["Model"] = new M_FinancialReportLine
                {
                    CompanyId = _filterCompanyId,
                    ReportType = "BalanceSheet",
                    LineLevel = 1,
                    DisplayOrder = 0,
                    Active = true
                },
                ["IsEdit"] = false,
                ["CompanyDisplayName"] = SelectedCompanyDisplay() ?? string.Empty
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_FinancialReportLine data)
            return;

        await SaveAsync(data, false);
    }

    private async Task OpenEditDialogAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetMapping.NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<BalanceSheetMapping_AddEditDialog>(
            LblEditTitle,
            new DialogParameters
            {
                ["Model"] = _selected,
                ["IsEdit"] = true,
                ["CompanyDisplayName"] = SelectedCompanyDisplay() ?? string.Empty
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_FinancialReportLine data)
            return;

        await SaveAsync(data, true);
    }

    private async Task SaveAsync(M_FinancialReportLine data, bool isEdit)
    {
        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!isEdit)
            {
                var dup = await db.FinancialReportLines.AsNoTracking().AnyAsync(x =>
                    x.CompanyId == data.CompanyId &&
                    x.ReportType == data.ReportType &&
                    x.LineCode == data.LineCode);
                if (dup)
                {
                    CallSnack(LblDuplicateLine, MudBlazor.Severity.Warning);
                    return;
                }

                var now = DateTime.UtcNow;
                data.Id = Guid.NewGuid();
                data.CreatedAt = now;
                data.UpdatedAt = null;
                db.FinancialReportLines.Add(data);
            }
            else
            {
                var dupOther = await db.FinancialReportLines.AsNoTracking().AnyAsync(x =>
                    x.Id != data.Id &&
                    x.CompanyId == data.CompanyId &&
                    x.ReportType == data.ReportType &&
                    x.LineCode == data.LineCode);
                if (dupOther)
                {
                    CallSnack(LblDuplicateLine, MudBlazor.Severity.Warning);
                    return;
                }

                var entity = await db.FinancialReportLines.FirstOrDefaultAsync(x => x.Id == data.Id);
                if (entity is null)
                {
                    CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                    return;
                }

                entity.LineName = data.LineName;
                entity.Section = data.Section;
                entity.ReportGroup = data.ReportGroup;
                entity.ParentLineId = data.ParentLineId;
                entity.LineLevel = data.LineLevel;
                entity.IsTotalLine = data.IsTotalLine;
                entity.IsBold = data.IsBold;
                entity.DisplayOrder = data.DisplayOrder;
                entity.Active = data.Active;
                entity.UpdatedAt = DateTime.UtcNow;
            }

            await db.SaveChangesAsync();
            CallSnack(Localizer["Common.SavedSuccessfully"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetMapping.NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["warning"], Localizer["askDelete"], yesText: Localizer["delete"], cancelText: Localizer["cancel"]);
        if (confirm != true)
            return;

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var hasChildren = await db.FinancialReportLines.AsNoTracking()
                .AnyAsync(x => x.ParentLineId == _selected.Id);
            if (hasChildren)
            {
                CallSnack(LblHasChildLines, MudBlazor.Severity.Warning);
                return;
            }

            var entity = await db.FinancialReportLines.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            db.FinancialReportLines.Remove(entity);
            await db.SaveChangesAsync();
            CallSnack(Localizer["Common.DeletedSuccessfully"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}

<style>
    .selected-row-blue { background-color: #2196f3 !important; }
</style>
