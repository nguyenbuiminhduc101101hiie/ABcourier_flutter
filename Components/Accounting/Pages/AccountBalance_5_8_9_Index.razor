    private async Task ClearExistingAccountBalanceForStageBatchAsync(System.Data.Common.DbConnection conn, Guid importBatchId)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
CREATE TABLE #BalanceIds
(
    Id UNIQUEIDENTIFIER NOT NULL PRIMARY KEY
);

INSERT INTO #BalanceIds(Id)
SELECT DISTINCT AB.Id
FROM dbo.account_balance AS AB
INNER JOIN dbo.AccountBalanceImportStaging AS S
    ON UPPER(LTRIM(RTRIM(ISNULL(AB.account_code, N'')))) = UPPER(LTRIM(RTRIM(ISNULL(S.account_code, N''))))
   AND AB.period_year = S.period_year
   AND AB.period_month = S.period_month
   AND UPPER(LTRIM(RTRIM(ISNULL(AB.book_code, N'TAX')))) = UPPER(LTRIM(RTRIM(ISNULL(S.book_code, N'TAX'))))
WHERE S.import_batch_id = @ImportBatchId;

-- Xóa bảng con đang FK về dbo.account_balance trước, nếu có.
DECLARE @Sql NVARCHAR(MAX) = N'';

SELECT @Sql = @Sql + N'
DELETE C
FROM ' + QUOTENAME(OBJECT_SCHEMA_NAME(fk.parent_object_id)) + N'.' + QUOTENAME(OBJECT_NAME(fk.parent_object_id)) + N' AS C
INNER JOIN #BalanceIds AS B ON C.' + QUOTENAME(pc.name) + N' = B.Id;'
FROM sys.foreign_key_columns fkc
INNER JOIN sys.foreign_keys fk
    ON fk.object_id = fkc.constraint_object_id
INNER JOIN sys.columns pc
    ON pc.object_id = fkc.parent_object_id
   AND pc.column_id = fkc.parent_column_id
INNER JOIN sys.columns rc
    ON rc.object_id = fkc.referenced_object_id
   AND rc.column_id = fkc.referenced_column_id
WHERE fkc.referenced_object_id = OBJECT_ID(N'dbo.account_balance')
  AND rc.name IN (N'Id', N'id');

IF LEN(@Sql) > 0
    EXEC sys.sp_executesql @Sql;

DELETE AB
FROM dbo.account_balance AS AB
INNER JOIN #BalanceIds AS B ON AB.Id = B.Id;
";
        cmd.CommandType = System.Data.CommandType.Text;
        cmd.CommandTimeout = 180;

        AddSqlParameter(cmd, "@ImportBatchId", importBatchId);

        await cmd.ExecuteNonQueryAsync();
    }


    private async Task ExportAccountBalanceToExcelAsync()
    {
        if (_items.Count == 0)
        {
            CallSnack("Không có dữ liệu để export.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            ConfigureEpplusLicense();

            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("AccountBalanceImport");
            var summary = package.Workbook.Worksheets.Add("Summary");
            var guide = package.Workbook.Worksheets.Add("Guide");

            var headers = GetAccountBalanceImportHeaders();
            WriteAccountBalanceHeaders(ws, headers);

            var exportRows = VisibleItems
                .OrderBy(x => NormalizeBookCode(x.BookCode))
                .ThenBy(x => x.PeriodYear)
                .ThenBy(x => x.PeriodMonth)
                .ThenBy(x => x.AccountCode)
                .ToList();

            for (var i = 0; i < exportRows.Count; i++)
            {
                var r = exportRows[i];
                var row = i + 2;

                ws.Cells[row, 1].Value = r.AccountCode;
                ws.Cells[row, 2].Value = r.PeriodYear;
                ws.Cells[row, 3].Value = r.PeriodMonth;
                ws.Cells[row, 4].Value = r.OpeningBalance;
                ws.Cells[row, 5].Value = r.DebitTotal;
                ws.Cells[row, 6].Value = r.CreditTotal;
                ws.Cells[row, 7].Value = r.ClosingBalance;
                ws.Cells[row, 8].Value = string.IsNullOrWhiteSpace(r.AccountType) ? AccountTypeFromAccountCode(r.AccountCode) : r.AccountType;
                ws.Cells[row, 9].Value = NormalizeBookCode(r.BookCode);
                ws.Cells[row, 10].Value = r.CalculatedFrom;
                ws.Cells[row, 11].Value = r.CalculatedTo;
                ws.Cells[row, 12].Value = r.LastCalculatedAt;
                ws.Cells[row, 13].Value = GetDateTimePropertyValue(r, "CreatedAt", "created_at");
                ws.Cells[row, 14].Value = GetDateTimePropertyValue(r, "UpdatedAt", "updated_at");
            }

            FormatAccountBalanceImportSheet(ws, exportRows.Count + 1);
            BuildAccountBalanceExportSummary(summary, exportRows);
            BuildAccountBalanceImportGuide(guide);

            var bytes = await package.GetAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"AccountBalance_ImportReady_{_bookFilter}_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await DownloadExcelByBase64Async(fileName, base64);

            CallSnack($"Export file import lại thành công: {exportRows.Count:N0} dòng.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

