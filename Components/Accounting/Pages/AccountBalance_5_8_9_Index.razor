    private async Task CarryForwardAccountBalanceAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack("Bạn không có quyền kết chuyển số dư.", MudBlazor.Severity.Warning);
            return;
        }

        if (_carryFromMonth < 1 || _carryFromMonth > 12 || _carryToMonth < 1 || _carryToMonth > 12)
        {
            CallSnack("Tháng kết chuyển không hợp lệ.", MudBlazor.Severity.Warning);
            return;
        }

        if (_carryFromYear == _carryToYear && _carryFromMonth == _carryToMonth)
        {
            CallSnack("Kỳ nguồn và kỳ đích không được trùng nhau.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "dbo.usp_CarryForwardAccountBalance_TT99";
                cmd.CommandType = System.Data.CommandType.StoredProcedure;
                cmd.CommandTimeout = 180;

                AddSqlParameter(cmd, "@FromYear", _carryFromYear);
                AddSqlParameter(cmd, "@FromMonth", _carryFromMonth);
                AddSqlParameter(cmd, "@ToYear", _carryToYear);
                AddSqlParameter(cmd, "@ToMonth", _carryToMonth);
                AddSqlParameter(cmd, "@BookCode", _carryBookCode == "ALL" ? DBNull.Value : _carryBookCode);
                AddSqlParameter(cmd, "@CompanyId", DBNull.Value);
                AddSqlParameter(cmd, "@CreatedBy", string.IsNullOrWhiteSpace(_usr) ? "system" : _usr);
                AddSqlParameter(cmd, "@Overwrite", _carryOverwrite);

                await cmd.ExecuteNonQueryAsync();
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            _fiscalYear = _carryToYear;
            _periodMonth = _carryToMonth;
            await LoadAccountingPeriodDatesAsync();

            CallSnack($"Kết chuyển thành công từ {_carryFromYear}/{_carryFromMonth:00} sang {_carryToYear}/{_carryToMonth:00}.", MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }


    private async Task ClearExistingAccountBalanceForRebuildAsync(System.Data.Common.DbConnection conn, string bookCode)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
CREATE TABLE #BalanceIds
(
    Id UNIQUEIDENTIFIER NOT NULL PRIMARY KEY
);

INSERT INTO #BalanceIds(Id)
SELECT Id
FROM dbo.account_balance
WHERE period_year = @FiscalYear
  AND period_month = @PeriodMonth
  AND UPPER(ISNULL(book_code, N'TAX')) = UPPER(@BookCode);

-- Xóa tất cả bảng con đang FK về dbo.account_balance.Id trước khi xóa account_balance.
-- Cách này an toàn hơn vì không cần biết tên bảng con là account_balance_gl_line hay tên khác.
DECLARE @Sql NVARCHAR(MAX) = N'';

SELECT @Sql = @Sql + N'
DELETE C
FROM ' + QUOTENAME(OBJECT_SCHEMA_NAME(fk.parent_object_id)) + N'.' + QUOTENAME(OBJECT_NAME(fk.parent_object_id)) + N' AS C
INNER JOIN #BalanceIds AS B ON C.' + QUOTENAME(pc.name) + N' = B.Id;'
FROM sys.foreign_key_columns fkc
INNER JOIN sys.foreign_keys fk
    ON fk.object_id = fkc.constraint_object_id
INNER JOIN sys.columns pc
    ON pc.object_id = fkc.parent_object_id
   AND pc.column_id = fkc.parent_column_id
INNER JOIN sys.columns rc
    ON rc.object_id = fkc.referenced_object_id
   AND rc.column_id = fkc.referenced_column_id
WHERE fkc.referenced_object_id = OBJECT_ID(N'dbo.account_balance')
  AND rc.name IN (N'Id', N'id');

IF LEN(@Sql) > 0
    EXEC sys.sp_executesql @Sql;

DELETE AB
FROM dbo.account_balance AS AB
INNER JOIN #BalanceIds AS B ON AB.Id = B.Id;
";
        cmd.CommandType = System.Data.CommandType.Text;
        cmd.CommandTimeout = 180;

        AddSqlParameter(cmd, "@FiscalYear", _fiscalYear);
        AddSqlParameter(cmd, "@PeriodMonth", _periodMonth);
        AddSqlParameter(cmd, "@BookCode", NormalizeBookCode(bookCode));

        await cmd.ExecuteNonQueryAsync();
    }

    private async Task CalculateAndUpsertAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["AccountBalance.NoAccessCalculate"], MudBlazor.Severity.Warning);
            return;
        }

        if (_periodMonth < 1 || _periodMonth > 12)
        {
            CallSnack(Localizer["AccountBalance.InvalidPeriodMonth"], MudBlazor.Severity.Warning);
            return;
        }

        if (IsDateRangeMode)
        {
            EnsureDateRange();
            SyncPeriodFromSelectedDate();
            CallSnack($"Account Balance tính theo kỳ; hệ thống sẽ calculate tháng {_periodMonth:00}/{_fiscalYear} theo ngày bắt đầu đã chọn.", MudBlazor.Severity.Info);
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                var booksToCalculate = string.Equals(_bookFilter, "ALL", StringComparison.OrdinalIgnoreCase)
                    ? new[] { "TAX", "MGMT" }
                    : new[] { NormalizeBookCode(_bookFilter) };

                foreach (var bookCode in booksToCalculate)
                {
                    // Fix duplicate key UQ_account_balance_account_period_book:
                    // trước khi rebuild kỳ/book thì xóa balance cũ và các bảng con đang tham chiếu account_balance.
                    // Sau đó mới chạy stored procedure tính lại từ GeneralLedgerEntries.
                    await ClearExistingAccountBalanceForRebuildAsync(conn, bookCode);

                    await using var cmd = conn.CreateCommand();
                    cmd.CommandText = "dbo.usp_CalculateAccountBalance_FromLedger";
                    cmd.CommandType = System.Data.CommandType.StoredProcedure;
                    cmd.CommandTimeout = 180;

                    AddSqlParameter(cmd, "@FiscalYear", _fiscalYear);
                    AddSqlParameter(cmd, "@PeriodMonth", _periodMonth);
                    AddSqlParameter(cmd, "@CompanyId", DBNull.Value);
                    AddSqlParameter(cmd, "@BookCode", bookCode);

                    await cmd.ExecuteNonQueryAsync();
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            CallSnack($"Calculated account balance {_fiscalYear}/{_periodMonth:00} - Book: {_bookFilter} thành công.", MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string AccountTypeFromAccountCode(string? accountCode, string? fallbackSection = null)
    {
        var code = string.IsNullOrWhiteSpace(accountCode)
            ? string.Empty
            : accountCode.Trim();

        if (code.StartsWith("1") || code.StartsWith("2"))
            return "ASSET";

        if (code.StartsWith("3"))
            return "LIABILITY";

        if (code.StartsWith("4"))
            return "EQUITY";

        if (code.StartsWith("5") || code.StartsWith("7"))
            return "REVENUE";

        if (code.StartsWith("6") || code.StartsWith("8"))
            return "EXPENSE";

        if (!string.IsNullOrWhiteSpace(fallbackSection))
        {
            var s = fallbackSection.Trim().ToUpperInvariant();
            if (s is "ASSET" or "LIABILITY" or "EQUITY" or "REVENUE" or "EXPENSE")
                return s;
        }

        return "OTHER";
    }

    private static List<M_account_balance_gl_line> OrderedGlLines(M_account_balance row) =>
        (row.GlSnapshotLines ?? Enumerable.Empty<M_account_balance_gl_line>())
            .OrderBy(l => l.PostingDate)
            .ThenBy(l => l.VoucherNo)
            .ToList();

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
