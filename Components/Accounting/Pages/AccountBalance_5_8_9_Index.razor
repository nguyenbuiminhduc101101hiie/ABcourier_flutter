    private void EnsureDateRange()
    {
        if (!_periodStartDate.HasValue)
            _periodStartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_periodEndDate.HasValue)
            _periodEndDate = DateTime.Today;

        _periodStartDate = _periodStartDate.Value.Date;
        _periodEndDate = _periodEndDate.Value.Date;

        if (_periodStartDate.Value > _periodEndDate.Value)
        {
            var temp = _periodStartDate;
            _periodStartDate = _periodEndDate;
            _periodEndDate = temp;
        }
    }

    private void SyncPeriodFromSelectedDate()
    {
        if (!_periodStartDate.HasValue)
            return;

        _fiscalYear = _periodStartDate.Value.Year;
        _periodMonth = _periodStartDate.Value.Month;
    }

    private (int StartPeriod, int EndPeriod) GetSelectedPeriodRange()
    {
        EnsureDateRange();
        var from = _periodStartDate!.Value;
        var to = _periodEndDate!.Value;
        return (from.Year * 100 + from.Month, to.Year * 100 + to.Month);
    }

