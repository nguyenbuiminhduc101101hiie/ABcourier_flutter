    private static decimal GetBalanceSideValue(object target, string directPropertyName, decimal signedBalance, bool debitSide)
    {
        var directValue = GetDecimalPropertyValue(target, directPropertyName, ToSnakeCase(directPropertyName));

        // If the new physical columns exist but have not been backfilled yet,
        // show the value derived from the signed balance instead of displaying 0 incorrectly.
        if (directValue.HasValue && (directValue.Value != 0 || signedBalance == 0))
            return directValue.Value;

        if (debitSide)
            return signedBalance > 0 ? signedBalance : 0;

        return signedBalance < 0 ? Math.Abs(signedBalance) : 0;
    }

    private static decimal? GetDecimalPropertyValue(object target, params string[] propertyNames)
    {
        if (target is null)
            return null;

        var type = target.GetType();
        foreach (var name in propertyNames)
        {
            var prop = type.GetProperty(name, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
            if (prop is null)
                continue;

            var value = prop.GetValue(target);
            if (value is null)
                continue;

            if (value is decimal dec)
                return dec;
            if (value is double dbl)
                return Convert.ToDecimal(dbl);
            if (value is float flt)
                return Convert.ToDecimal(flt);
            if (value is int i)
                return i;
            if (value is long l)
                return l;
            if (decimal.TryParse(Convert.ToString(value), out var parsed))
                return parsed;
        }

        return null;
    }

    private static string ToSnakeCase(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < value.Length; i++)
        {
            var ch = value[i];
            if (char.IsUpper(ch) && i > 0)
                sb.Append('_');

            sb.Append(char.ToLowerInvariant(ch));
        }

        return sb.ToString();
    }

    private static DateTime? GetDateTimePropertyValue(object target, params string[] propertyNames)
    {
        if (target is null)
            return null;

        var type = target.GetType();
        foreach (var name in propertyNames)
        {
            var prop = type.GetProperty(name);
            if (prop is null)
                continue;

            var value = prop.GetValue(target);
            if (value is DateTime dt)
                return dt;

            if (value is DateTimeOffset dto)
                return dto.DateTime;

            if (value is not null && DateTime.TryParse(value.ToString(), out var parsed))
                return parsed;
        }

        return null;
    }

