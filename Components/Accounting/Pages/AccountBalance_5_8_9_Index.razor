        {
            "HƯỚNG DẪN IMPORT ACCOUNT BALANCE",
            "1. Sheet import bắt buộc nằm đầu tiên và tên nên là AccountBalanceImport.",
            "2. Cột bắt buộc: account_code, period_year, period_month, opening_balance, debit_total, credit_total, closing_balance, book_code.",
            "3. Không cần nhập company_id. Hệ thống bỏ qua company_id khi import/export Balance.",
            "4. Nếu một dòng đã tồn tại cùng account_code + period_year + period_month + book_code, hệ thống sẽ bỏ qua ở stage.",
            "5. account_type hợp lệ nên là ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE hoặc OTHER.",
            "6. Không sửa tên cột nếu muốn import lại nhanh như MISA."
        };

        for (var i = 0; i < lines.Length; i++)
        {
            ws.Cells[i + 1, 1].Value = lines[i];
            if (i == 0)
            {
                ws.Cells[i + 1, 1].Style.Font.Bold = true;
                ws.Cells[i + 1, 1].Style.Font.Size = 14;
            }
        }

        ws.Cells[ws.Dimension.Address].AutoFitColumns();
    }

