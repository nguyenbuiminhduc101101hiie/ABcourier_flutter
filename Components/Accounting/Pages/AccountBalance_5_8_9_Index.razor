    private async Task LoadAccountingPeriodDatesAsync()
    {
        if (_fiscalYear < 2000 || _periodMonth < 1 || _periodMonth > 12)
            return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = @"
SELECT TOP (1)
    start_date,
    end_date
FROM dbo.accounting_period
WHERE fiscal_year = @fiscal_year
  AND period_month = @period_month
ORDER BY start_date;";
                cmd.CommandType = System.Data.CommandType.Text;

                AddSqlParameter(cmd, "@fiscal_year", _fiscalYear);
                AddSqlParameter(cmd, "@period_month", _periodMonth);

                await using var reader = await cmd.ExecuteReaderAsync();

                if (await reader.ReadAsync())
                {
                    _periodStartDate = reader.IsDBNull(0) ? null : reader.GetDateTime(0).Date;
                    _periodEndDate = reader.IsDBNull(1) ? null : reader.GetDateTime(1).Date;
                }
                else
                {
                    _periodStartDate = new DateTime(_fiscalYear, _periodMonth, 1);
                    _periodEndDate = _periodStartDate.Value.AddMonths(1).AddDays(-1);
                    CallSnack($"Không tìm thấy kỳ kế toán {_periodMonth:00}/{_fiscalYear}; dùng ngày mặc định theo tháng.", MudBlazor.Severity.Warning);
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }
        }
        catch (Exception ex)
        {
            CallSnack($"Không load được ngày kỳ kế toán: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["AccountBalance.NoAccessView"], MudBlazor.Severity.Warning);
            _items.Clear();
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            var query = db.AccountBalances.AsNoTracking()
                .Include(x => x.GlSnapshotLines)
                .AsQueryable();

            if (IsPeriodMode)
            {
                query = query.Where(x => x.PeriodYear == _fiscalYear
                                      && x.PeriodMonth == _periodMonth);
            }
            else
            {
                var periodRange = GetSelectedPeriodRange();
                query = query.Where(x => (x.PeriodYear * 100 + x.PeriodMonth) >= periodRange.StartPeriod
                                      && (x.PeriodYear * 100 + x.PeriodMonth) <= periodRange.EndPeriod);
            }

            if (!string.Equals(_bookFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                var book = NormalizeBookCode(_bookFilter);
                query = query.Where(x => x.BookCode == book);
            }

            _items = await query
                .OrderBy(x => x.BookCode)
                .ThenBy(x => x.AccountCode)
                .ToListAsync();

            CallSnack($"Loaded {_items.Count:N0} dòng - Book: {_bookFilter}.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string NormalizeBookCode(string? bookCode)
    {
        return string.IsNullOrWhiteSpace(bookCode)
            ? "TAX"
            : bookCode.Trim().ToUpperInvariant();
    }

    private static string BalanceKey(string? bookCode, string? accountCode)
    {
        var book = NormalizeBookCode(bookCode);
        var acc = string.IsNullOrWhiteSpace(accountCode) ? string.Empty : accountCode.Trim().ToUpperInvariant();
        return $"{book}|{acc}";
    }




    private async Task LoadStageAsync()
    {
        try
        {
            _busy = true;
            _stageItems.Clear();
            _stageBatchIds.Clear();

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = @"
SELECT TOP (1000)
    id,
    import_batch_id,
    account_code,
    period_year,
    period_month,
    opening_balance,
    debit_total,
    credit_total,
    closing_balance,
    account_type,
    company_id,
    book_code,
    import_note,
    created_at
FROM dbo.AccountBalanceImportStaging
WHERE
(
    (@use_period = 1 AND period_year = @period_year AND period_month = @period_month)
    OR
    (@use_period = 0 AND (period_year * 100 + period_month) BETWEEN @start_period AND @end_period)
)
ORDER BY created_at DESC, book_code, account_code;";
                cmd.CommandType = System.Data.CommandType.Text;

                var periodRange = GetSelectedPeriodRange();

                AddSqlParameter(cmd, "@use_period", IsPeriodMode ? 1 : 0);
                AddSqlParameter(cmd, "@period_year", _fiscalYear);
                AddSqlParameter(cmd, "@period_month", _periodMonth);
                AddSqlParameter(cmd, "@start_period", periodRange.StartPeriod);
                AddSqlParameter(cmd, "@end_period", periodRange.EndPeriod);

                await using var reader = await cmd.ExecuteReaderAsync();

                while (await reader.ReadAsync())
                {
                    _stageItems.Add(new AccountBalanceImportStageView
                    {
                        Id = reader.GetGuid(0),
                        ImportBatchId = reader.GetGuid(1),
                        AccountCode = reader.IsDBNull(2) ? string.Empty : Convert.ToString(reader.GetValue(2)) ?? string.Empty,
                        PeriodYear = reader.IsDBNull(3) ? 0 : Convert.ToInt32(reader.GetValue(3)),
                        PeriodMonth = reader.IsDBNull(4) ? 0 : Convert.ToInt32(reader.GetValue(4)),
                        OpeningBalance = reader.IsDBNull(5) ? 0 : Convert.ToDecimal(reader.GetValue(5)),
                        DebitTotal = reader.IsDBNull(6) ? 0 : Convert.ToDecimal(reader.GetValue(6)),
                        CreditTotal = reader.IsDBNull(7) ? 0 : Convert.ToDecimal(reader.GetValue(7)),
                        ClosingBalance = reader.IsDBNull(8) ? 0 : Convert.ToDecimal(reader.GetValue(8)),
                        AccountType = reader.IsDBNull(9) ? null : Convert.ToString(reader.GetValue(9)),
                        CompanyId = reader.IsDBNull(10) ? null : reader.GetGuid(10),
                        BookCode = reader.IsDBNull(11) ? null : Convert.ToString(reader.GetValue(11)),
                        ImportNote = reader.IsDBNull(12) ? null : Convert.ToString(reader.GetValue(12)),
                        CreatedAt = reader.IsDBNull(13) ? DateTime.MinValue : Convert.ToDateTime(reader.GetValue(13))
                    });
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            _stageBatchIds = _stageItems
                .Select(x => x.ImportBatchId)
                .Distinct()
                .ToList();

            if (!_selectedStageBatchId.HasValue && _lastImportBatchId.HasValue && _stageBatchIds.Contains(_lastImportBatchId.Value))
                _selectedStageBatchId = _lastImportBatchId.Value;

            if (!_selectedStageBatchId.HasValue && _stageBatchIds.Count > 0)
                _selectedStageBatchId = _stageBatchIds[0];

            CallSnack($"Loaded {_stageItems.Count:N0} stage rows.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplySelectedStageBatchToAccountBalanceAsync()
    {
        if (!_selectedStageBatchId.HasValue)
        {
            CallSnack("Chưa chọn batch stage.", MudBlazor.Severity.Warning);
            return;
        }

        _lastImportBatchId = _selectedStageBatchId;
        await ApplyLastImportBatchToAccountBalanceAsync();
    }

    private async Task ApplyLastImportBatchToAccountBalanceAsync()
    {
        if (!_lastImportBatchId.HasValue)
        {
            CallSnack("Chưa có batch import. Hãy Import Excel vào stage trước.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                if (IsBalanceImportAddMode)
                {
                    await AddStageBatchToExistingAccountBalanceAsync(conn, _lastImportBatchId.Value);
                }
                else
                {
                    // Import Balance kiểu MISA: nếu kỳ/TK/Book đã tồn tại thì xóa số cũ rồi ghi batch mới.
                    // Tránh lỗi unique index UQ_account_balance_account_period_book khi import lại file đã export.
                    await ClearExistingAccountBalanceForStageBatchAsync(conn, _lastImportBatchId.Value);

                    await using var cmd = conn.CreateCommand();
                    cmd.CommandText = "dbo.usp_ImportAccountBalanceStage_ToAccountBalance";
                    cmd.CommandType = System.Data.CommandType.StoredProcedure;
                    cmd.CommandTimeout = 180;

                    AddSqlParameter(cmd, "@ImportBatchId", _lastImportBatchId.Value);

                    await cmd.ExecuteNonQueryAsync();
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            var modeText = IsBalanceImportAddMode ? "cộng dồn vào số đang có" : "xóa số cũ và ghi số mới";
            CallSnack($"Đã đưa batch {_lastImportBatchId} từ stage vào account_balance theo chế độ {modeText}.", MudBlazor.Severity.Success);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            CallSnack(root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddStageBatchToExistingAccountBalanceAsync(System.Data.Common.DbConnection conn, Guid importBatchId)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
;WITH StageAgg AS
(
    SELECT
        account_code = LTRIM(RTRIM(account_code)),
        period_year,
        period_month,
        book_code = UPPER(LTRIM(RTRIM(ISNULL(book_code, N'TAX')))),
        opening_balance = SUM(ISNULL(opening_balance, 0)),
        debit_total = SUM(ISNULL(debit_total, 0)),
        credit_total = SUM(ISNULL(credit_total, 0)),
        closing_balance = SUM(ISNULL(closing_balance, 0)),
        account_type = MAX(NULLIF(LTRIM(RTRIM(ISNULL(account_type, N''))), N'')),
        calculated_from = MIN(created_at),
        calculated_to = MAX(created_at)
    FROM dbo.AccountBalanceImportStaging
    WHERE import_batch_id = @ImportBatchId
    GROUP BY
        LTRIM(RTRIM(account_code)),
        period_year,
        period_month,
        UPPER(LTRIM(RTRIM(ISNULL(book_code, N'TAX'))))
)
UPDATE AB
SET
    AB.opening_balance = ISNULL(AB.opening_balance, 0) + S.opening_balance,
    AB.debit_total = ISNULL(AB.debit_total, 0) + S.debit_total,
    AB.credit_total = ISNULL(AB.credit_total, 0) + S.credit_total,
    AB.closing_balance = ISNULL(AB.closing_balance, 0) + S.closing_balance,
    AB.account_type = COALESCE(S.account_type, AB.account_type),
    AB.calculated_from = COALESCE(AB.calculated_from, S.calculated_from),
    AB.calculated_to = COALESCE(S.calculated_to, AB.calculated_to),
    AB.last_calculated_at = SYSDATETIME(),
    AB.updated_at = SYSDATETIME()
FROM dbo.account_balance AS AB
INNER JOIN StageAgg AS S
    ON UPPER(LTRIM(RTRIM(ISNULL(AB.account_code, N'')))) = UPPER(LTRIM(RTRIM(ISNULL(S.account_code, N''))))
   AND AB.period_year = S.period_year
   AND AB.period_month = S.period_month
   AND UPPER(LTRIM(RTRIM(ISNULL(AB.book_code, N'TAX')))) = S.book_code;

;WITH StageAgg AS
(
    SELECT
        account_code = LTRIM(RTRIM(account_code)),
        period_year,
        period_month,
        book_code = UPPER(LTRIM(RTRIM(ISNULL(book_code, N'TAX')))),
        opening_balance = SUM(ISNULL(opening_balance, 0)),
        debit_total = SUM(ISNULL(debit_total, 0)),
        credit_total = SUM(ISNULL(credit_total, 0)),
        closing_balance = SUM(ISNULL(closing_balance, 0)),
        account_type = MAX(NULLIF(LTRIM(RTRIM(ISNULL(account_type, N''))), N'')),
        calculated_from = MIN(created_at),
        calculated_to = MAX(created_at)
    FROM dbo.AccountBalanceImportStaging
    WHERE import_batch_id = @ImportBatchId
    GROUP BY
        LTRIM(RTRIM(account_code)),
        period_year,
        period_month,
        UPPER(LTRIM(RTRIM(ISNULL(book_code, N'TAX'))))
)
INSERT INTO dbo.account_balance
(
    id,
    account_code,
    period_year,
    period_month,
    opening_balance,
    debit_total,
    credit_total,
    closing_balance,
    account_type,
    company_id,
    book_code,
    calculated_from,
    calculated_to,
    last_calculated_at,
    created_at,
    updated_at
)
SELECT
    NEWID(),
    S.account_code,
    S.period_year,
    S.period_month,
    S.opening_balance,
    S.debit_total,
    S.credit_total,
    S.closing_balance,
    S.account_type,
    NULL,
    S.book_code,
    S.calculated_from,
    S.calculated_to,
    SYSDATETIME(),
    SYSDATETIME(),
    SYSDATETIME()
FROM StageAgg AS S
WHERE NOT EXISTS
(
    SELECT 1
    FROM dbo.account_balance AS AB
    WHERE UPPER(LTRIM(RTRIM(ISNULL(AB.account_code, N'')))) = UPPER(LTRIM(RTRIM(ISNULL(S.account_code, N''))))
      AND AB.period_year = S.period_year
      AND AB.period_month = S.period_month
      AND UPPER(LTRIM(RTRIM(ISNULL(AB.book_code, N'TAX')))) = S.book_code
);
";
        cmd.CommandType = System.Data.CommandType.Text;
        cmd.CommandTimeout = 180;

        AddSqlParameter(cmd, "@ImportBatchId", importBatchId);

