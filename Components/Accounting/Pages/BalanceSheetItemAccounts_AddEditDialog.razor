@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Models
@using ABFreight.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ItemCode"
                                  Label="@Localizer["BalanceSheetItemAccounts.ItemCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Disabled="IsEdit" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.AccountCode"
                                  Label="@Localizer["BalanceSheetItemAccounts.AccountCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Disabled="IsEdit" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_accountNameBinding"
                                  Label="@Localizer["BalanceSheetItemAccounts.AccountName"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.Sign"
                                     Label="@Localizer["BalanceSheetItemAccounts.Sign"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HelperText="1 / -1" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_balanceSideBinding" Label="@Localizer["BalanceSheetItemAccounts.BalanceSide"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem Value="@("Debit")">Debit</MudSelectItem>
                        <MudSelectItem Value="@("Credit")">Credit</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudCheckBox T="bool" @bind-Value="_model.IsPrefixMatch" Label="@Localizer["BalanceSheetItemAccounts.IsPrefixMatch"]" Class="mt-4" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox T="bool" @bind-Value="_model.IsActive" Label="@Localizer["BalanceSheetItemAccounts.IsActive"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_noteBinding"
                                  Label="@Localizer["BalanceSheetItemAccounts.Note"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_BalanceSheetItemAccounts Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm? _form;
    private M_BalanceSheetItemAccounts _model = new();
    private string _noteBinding = string.Empty;
    private string _accountNameBinding = string.Empty;
    private string? _balanceSideBinding;

    protected override void OnParametersSet()
    {
        _model = new M_BalanceSheetItemAccounts
        {
            Id = Model.Id,
            ItemCode = Model.ItemCode ?? string.Empty,
            AccountCode = Model.AccountCode ?? string.Empty,
            AccountName = Model.AccountName,
            Sign = Model.Sign == 0 ? 1 : Model.Sign,
            BalanceSide = Model.BalanceSide,
            IsPrefixMatch = Model.IsPrefixMatch,
            IsActive = Model.IsActive,
            Note = Model.Note
        };
        _noteBinding = Model.Note ?? string.Empty;
        _accountNameBinding = Model.AccountName ?? string.Empty;
        _balanceSideBinding = string.IsNullOrWhiteSpace(Model.BalanceSide) ? null : Model.BalanceSide;
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();

        if (string.IsNullOrWhiteSpace(_model.ItemCode) || string.IsNullOrWhiteSpace(_model.AccountCode))
            return;

        _model.ItemCode = _model.ItemCode.Trim();
        _model.AccountCode = _model.AccountCode.Trim();
        _model.AccountName = string.IsNullOrWhiteSpace(_accountNameBinding) ? null : _accountNameBinding.Trim();
        _model.BalanceSide = string.IsNullOrWhiteSpace(_balanceSideBinding) ? null : _balanceSideBinding.Trim();
        _model.Note = string.IsNullOrWhiteSpace(_noteBinding) ? null : _noteBinding.Trim();

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
