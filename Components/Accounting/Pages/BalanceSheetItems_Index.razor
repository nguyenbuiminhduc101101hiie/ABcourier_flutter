@page "/balance-sheet-items"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["BalanceSheetItems.Title"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"10.11 {Localizer["BalanceSheetItems.Title"]}")" Subtitle="@Localizer["BalanceSheetItems.Subtitle"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialogAsync" Disabled="_busy">@Localizer["new"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditDialogAsync" Disabled="_busy || _selected is null">@Localizer["edit"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null">@Localizer["delete"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">@Localizer["reload"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3" Elevation="0">
        <MudTextField @bind-Value="_search" Label="@Localizer["BalanceSheetItems.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
        <MudDataGrid T="M_BalanceSheetItems"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     RowClick="OnRowClick"
                     RowClassFunc="RowClass"
                     Height="calc(100vh - 300px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.ItemCode" Title="@Localizer["BalanceSheetItems.ItemCode"]" />
                <PropertyColumn Property="x => x.ItemName" Title="@Localizer["BalanceSheetItems.ItemName"]" />
                <PropertyColumn Property="x => x.ParentItemCode" Title="@Localizer["BalanceSheetItems.ParentItemCode"]" />
                <PropertyColumn Property="x => x.Section" Title="@Localizer["BalanceSheetItems.Section"]" />
                <PropertyColumn Property="x => x.LevelNo" Title="@Localizer["BalanceSheetItems.LevelNo"]" />
                <PropertyColumn Property="x => x.SortOrder" Title="@Localizer["BalanceSheetItems.SortOrder"]" />
                <PropertyColumn Property="x => x.IsBold" Title="@Localizer["BalanceSheetItems.IsBold"]" />
                <PropertyColumn Property="x => x.IsTotal" Title="@Localizer["BalanceSheetItems.IsTotal"]" />
                <PropertyColumn Property="x => x.IsActive" Title="@Localizer["BalanceSheetItems.IsActive"]" />
                <PropertyColumn Property="x => x.CreatedDate" Title="@Localizer["BalanceSheetItems.CreatedDate"]" Format="dd/MM/yyyy HH:mm" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="M_BalanceSheetItems" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "BalanceSheetItems";

    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private List<M_BalanceSheetItems> _items = new();
    private M_BalanceSheetItems? _selected;

    private IEnumerable<M_BalanceSheetItems> VisibleItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x =>
                (x.ItemCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ItemName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ParentItemCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Section?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetItems.NoAccessView"], MudBlazor.Severity.Warning);
            _items.Clear();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.BalanceSheetItems.AsNoTracking()
                .OrderBy(x => x.Section)
                .ThenBy(x => x.SortOrder)
                .ThenBy(x => x.ItemCode)
                .ToListAsync();
            _selected = null;
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<M_BalanceSheetItems> args)
    {
        var r = args.Item;
        _selected = new M_BalanceSheetItems
        {
            Id = r.Id,
            ItemCode = r.ItemCode,
            ItemName = r.ItemName,
            ParentItemCode = r.ParentItemCode,
            Section = r.Section,
            LevelNo = r.LevelNo,
            SortOrder = r.SortOrder,
            IsBold = r.IsBold,
            IsTotal = r.IsTotal,
            IsActive = r.IsActive,
            CreatedDate = r.CreatedDate
        };
    }

    private string RowClass(M_BalanceSheetItems row, int _) =>
        _selected?.Id == row.Id ? "selected-row-blue" : string.Empty;

    private async Task OpenAddDialogAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetItems.NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<BalanceSheetItems_AddEditDialog>(
            Localizer["BalanceSheetItems.AddTitle"],
            new DialogParameters
            {
                ["Model"] = new M_BalanceSheetItems { IsActive = true },
                ["IsEdit"] = false
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_BalanceSheetItems data)
            return;

        await SaveAsync(data, false);
    }

    private async Task OpenEditDialogAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetItems.NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<BalanceSheetItems_AddEditDialog>(
            Localizer["BalanceSheetItems.EditTitle"],
            new DialogParameters
            {
                ["Model"] = _selected,
                ["IsEdit"] = true
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_BalanceSheetItems data)
            return;

        await SaveAsync(data, true);
    }

    private async Task SaveAsync(M_BalanceSheetItems data, bool isEdit)
    {
        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            if (!isEdit)
            {
                var dup = await db.BalanceSheetItems.AsNoTracking().AnyAsync(x => x.ItemCode == data.ItemCode);
                if (dup)
                {
                    CallSnack(Localizer["BalanceSheetItems.DuplicateItemCode"], MudBlazor.Severity.Warning);
                    return;
                }

                data.Id = Guid.NewGuid();
                data.CreatedDate = DateTime.UtcNow;
                db.BalanceSheetItems.Add(data);
            }
            else
            {
                var dupOther = await db.BalanceSheetItems.AsNoTracking().AnyAsync(x =>
                    x.Id != data.Id && x.ItemCode == data.ItemCode);
                if (dupOther)
                {
                    CallSnack(Localizer["BalanceSheetItems.DuplicateItemCode"], MudBlazor.Severity.Warning);
                    return;
                }

                var entity = await db.BalanceSheetItems.FirstOrDefaultAsync(x => x.Id == data.Id);
                if (entity is null)
                {
                    CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                    return;
                }

                entity.ItemCode = data.ItemCode;
                entity.ItemName = data.ItemName;
                entity.ParentItemCode = data.ParentItemCode;
                entity.Section = data.Section;
                entity.LevelNo = data.LevelNo;
                entity.SortOrder = data.SortOrder;
                entity.IsBold = data.IsBold;
                entity.IsTotal = data.IsTotal;
                entity.IsActive = data.IsActive;
            }

            await db.SaveChangesAsync();
            CallSnack(Localizer["Common.SavedSuccessfully"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["BalanceSheetItems.NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["warning"], Localizer["askDelete"], yesText: Localizer["delete"], cancelText: Localizer["cancel"]);
        if (confirm != true)
            return;

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.BalanceSheetItems.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            var hasLinks = await db.BalanceSheetItemAccounts.AsNoTracking().AnyAsync(x => x.ItemCode == entity.ItemCode);
            if (hasLinks)
            {
                CallSnack(Localizer["BalanceSheetItems.DeleteBlockedByAccounts"], MudBlazor.Severity.Warning);
                return;
            }

            db.BalanceSheetItems.Remove(entity);
            await db.SaveChangesAsync();
            CallSnack(Localizer["Common.DeletedSuccessfully"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}

<style>
    .selected-row-blue { background-color: #2196f3 !important; }
</style>
