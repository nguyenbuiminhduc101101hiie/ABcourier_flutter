    }

    private async Task UnpostAsync()
    {
        if (_selected is null)
            return;

        if (!CanEditDeleteByRole)
        {
            CallSnack("Chỉ ADMIN hoặc MANAGER mới được hủy ghi sổ.", MudBlazor.Severity.Warning);
            return;
        }

        if (!IsPostedVoucher(_selected))
        {
            CallSnack("Chứng từ chưa ghi sổ, không cần hủy ghi sổ.", MudBlazor.Severity.Info);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Hủy ghi sổ",
            "Hủy ghi sổ sẽ chuyển chứng từ về trạng thái Draft/Open và xóa các dòng đã post trong GeneralLedgerEntries của chứng từ này. Anh có chắc muốn tiếp tục không?",
            yesText: "Hủy ghi sổ",
            cancelText: "Đóng");

        if (confirm != true)
            return;

        try
        {
            var focusVoucherId = _selected.Id;
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == focusVoucherId);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            await db.Database.ExecuteSqlInterpolatedAsync($@"
IF OBJECT_ID(N'dbo.GeneralLedgerEntries', N'U') IS NOT NULL
BEGIN
    DELETE FROM dbo.GeneralLedgerEntries
    WHERE VoucherId = {focusVoucherId};
END");

            entity.Status = 1;
            entity.Ghiso = false;
            entity.PostedBy = null;
            entity.PostedDate = null;
            entity.ModifiedBy = _usr;
            entity.ModifiedDate = DateTime.Now;

            await db.SaveChangesAsync();
            CallSnack("Đã hủy ghi sổ. Chứng từ đã chuyển về Draft/Open. Nếu chứng từ đang Approve thì cần Hủy Approve trước khi sửa.", MudBlazor.Severity.Success);
            await LoadAsync(focusVoucherId);
        }
        catch (Exception ex)
        {
            CallSnack("Không thể hủy ghi sổ: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

