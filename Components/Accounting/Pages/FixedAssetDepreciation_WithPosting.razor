@page "/accounting/fixed-assets/depreciation-posting"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Models.Accounting
@using ABFreight.Services.Accounting

@inject IFixedAssetDepreciationService DepreciationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["FixedAssetDepreciationPosting.Title"]</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">10.4.7 @Localizer["FixedAssetDepreciationPosting.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["FixedAssetDepreciationPosting.Subtitle"]
                </MudText>
            </div>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_busy"
                       OnClick="CalculateAsync">
                @Localizer["FixedAssetDepreciationPosting.Reload"]
            </MudButton>
        </MudStack>
    </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid Spacing="2" AlignItems="AlignItems.End">
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="@Localizer["FixedAssetDepreciationPosting.FiscalYear"]"
                                     @bind-Value="_fiscalYear"
                                     Min="2000"
                                     Max="9999"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int"
                               Label="@Localizer["FixedAssetDepreciationPosting.FiscalPeriod"]"
                               @bind-Value="_fiscalPeriod">
                        @for (var month = 1; month <= 12; month++)
                        {
                            var monthValue = month;
                            <MudSelectItem T="int" Value="@monthValue">
                                @string.Format(Localizer["FixedAssetDepreciationPosting.MonthItem"].Value, monthValue)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch T="bool"
                               Color="Color.Primary"
                               @bind-Value="_prorateByDay">
                        @Localizer["FixedAssetDepreciationPosting.ProrateByDay"]
                    </MudSwitch>
                </MudItem>

                <MudItem xs="12">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Calculate"
                                   Disabled="@_busy"
                                   OnClick="CalculateAsync">
                            @Localizer["FixedAssetDepreciationPosting.Calculate"]
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_busy || SelectedSavableCount == 0)"
                                   OnClick="SaveDraftAsync">
                            @Localizer["FixedAssetDepreciationPosting.SaveDraft"]
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.AccountBalance"
                                   Disabled="@(_busy || SelectedDraftCount == 0)"
                                   OnClick="PostDraftAsync">
                            @Localizer["FixedAssetDepreciationPosting.Post"]
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Disabled="@(_busy || SelectedDraftCount == 0)"
                                   OnClick="DeleteDraftAsync">
                            @Localizer["FixedAssetDepreciationPosting.DeleteDraft"]
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="@Localizer["FixedAssetDepreciationPosting.SearchAsset"]"
                                  @bind-Value="_keyword"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="@Localizer["FixedAssetDepreciationPosting.FilterDepartment"]"
                                  @bind-Value="_departmentFilter"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Apartment" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
            @Localizer["FixedAssetDepreciationPosting.Info"]
        </MudAlert>

        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["FixedAssetDepreciationPosting.VisibleAssets"]</MudText>
                    <MudText Typo="Typo.h6">@VisibleRowCount</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["FixedAssetDepreciationPosting.SelectedToSave"]</MudText>
                    <MudText Typo="Typo.h6">@SelectedSavableCount</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["FixedAssetDepreciationPosting.SelectedOriginalCost"]</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(SelectedOriginalCost)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["FixedAssetDepreciationPosting.SelectedDepreciation"]</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(SelectedDepreciationAmount)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-3" Elevation="1">
            <MudTable T="FixedAssetDepreciationRow"
                      Items="@FilteredRows"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true"
                      FixedHeader="true"
                      Height="520px"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width:50px">
                        <MudCheckBox T="bool"
                                     Value="@AllSelectableSelected"
                                     ValueChanged="ToggleAll" />
                    </MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColAssetCode"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColAssetName"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColDepartment"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColDepStart"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColOriginalCost"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColOpeningAccum"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColMonthlyDep"]</MudTh>
                    <MudTh Align="Center">@Localizer["FixedAssetDepreciationPosting.ColDepDays"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColPeriodDep"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColClosingAccum"]</MudTh>
                    <MudTh Align="Right">@Localizer["FixedAssetDepreciationPosting.ColRemaining"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColDebitAccount"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColCreditAccount"]</MudTh>
                    <MudTh>@Localizer["FixedAssetDepreciationPosting.ColStatus"]</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColSelect"]">
                        <MudCheckBox T="bool"
                                     @bind-Value="context.Selected"
                                     Disabled="@(!context.CanSave)" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColAssetCode"]">
                        <MudText Typo="Typo.body2"><b>@context.AssetCode</b></MudText>
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColAssetName"]">@context.AssetName</MudTd>
                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColDepartment"]">@context.DepartmentCode</MudTd>
                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColDepStart"]">
                        @context.DepreciationStartDate.ToString("dd/MM/yyyy")
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColOriginalCost"]" Align="Right">
                        @FormatMoney(context.OriginalCost)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColOpeningAccum"]" Align="Right">
                        @FormatMoney(context.OpeningAccumulatedDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColMonthlyDep"]" Align="Right">
                        @FormatMoney(context.MonthlyDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColDepDays"]" Align="Center">
                        @context.DepreciableDays/@context.DaysInPeriod
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColPeriodDep"]" Align="Right">
                        <b>@FormatMoney(context.DepreciationAmount)</b>
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColClosingAccum"]" Align="Right">
                        @FormatMoney(context.ClosingAccumulatedDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColRemaining"]" Align="Right">
                        @FormatMoney(context.ClosingRemainingValue)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColDebitAccount"]">
                        <MudTextField T="string"
                                      @bind-Value="context.ExpenseAccount"
                                      Disabled="@(!context.CanSave)"
                                      MaxLength="20"
                                      Margin="Margin.Dense" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColCreditAccount"]">
                        <MudTextField T="string"
                                      @bind-Value="context.DepreciationAccount"
                                      Disabled="@(!context.CanSave)"
                                      MaxLength="20"
                                      Margin="Margin.Dense" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["FixedAssetDepreciationPosting.ColStatus"]">
                        <MudText Typo="Typo.caption"
                                 Color="@(GetStatusColor(context))">
                            @GetStatusText(context)
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(context.Message))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.Message
                            </MudText>
                        }
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Class="pa-4">
                        @Localizer["FixedAssetDepreciationPosting.NoData"]
                    </MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[] { 20, 50, 100 })" />
                </PagerContent>
            </MudTable>
        </MudPaper>
</MudStack>

<style>
    .summary-box {
        min-height: 78px;
        background: var(--mud-palette-background-grey);
    }
</style>

@code {
    // Màn hình khấu hao dùng dữ liệu TSCĐ chung toàn hệ thống.
    // Guid.Empty chỉ giữ để tương thích chữ ký service hiện tại.
    private static readonly Guid GlobalCompanyId = Guid.Empty;

    private string _userName = "system";
    private bool _busy;

    private int _fiscalYear = DateTime.Today.Year;
    private int _fiscalPeriod = DateTime.Today.Month;
    private bool _prorateByDay = true;
    private string? _keyword;
    private string? _departmentFilter;

    private List<FixedAssetDepreciationRow> _rows = [];

    private IEnumerable<FixedAssetDepreciationRow> FilteredRows
    {
        get
        {
            IEnumerable<FixedAssetDepreciationRow> query = _rows;

            var keyword = _keyword?.Trim();
            if (!string.IsNullOrWhiteSpace(keyword))
            {
                query = query.Where(x =>
                    x.AssetCode.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase) ||
                    x.AssetName.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase));
            }

            var department = _departmentFilter?.Trim();
            if (!string.IsNullOrWhiteSpace(department))
            {
                query = query.Where(x =>
                    x.DepartmentCode?.Contains(
                        department,
                        StringComparison.OrdinalIgnoreCase) ?? false);
            }

            return query;
        }
    }

    private int VisibleRowCount => FilteredRows.Count();

    private int SelectedSavableCount =>
        _rows.Count(x => x.Selected && x.CanSave);

    private int SelectedDraftCount =>
        _rows.Count(x => x.Selected && x.IsSavedDraft && !x.IsPosted);

    private decimal SelectedOriginalCost =>
        _rows
            .Where(x => x.Selected && x.CanSave)
            .Sum(x => x.OriginalCost);

    private decimal SelectedDepreciationAmount =>
        _rows
            .Where(x => x.Selected && x.CanSave)
            .Sum(x => x.DepreciationAmount);

    private bool AllSelectableSelected
    {
        get
        {
            var selectable = FilteredRows
                .Where(x => x.CanSave)
                .ToList();

            return selectable.Count > 0 &&
                   selectable.All(x => x.Selected);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        _userName = state.User.Identity?.Name ?? "system";

        await CalculateAsync();
    }

    private async Task CalculateAsync()
    {
        if (_busy)
            return;

        _busy = true;

        try
        {
            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();

            if (_rows.Count == 0)
            {
                Snackbar.Add(
                    Localizer["FixedAssetDepreciationPosting.NoEligibleAssets"],
                    MudBlazor.Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveDraftAsync()
    {
        if (_busy)
            return;

        var selectedRows = _rows
            .Where(x => x.Selected && x.CanSave)
            .ToList();

        if (selectedRows.Count == 0)
        {
            Snackbar.Add(
                Localizer["FixedAssetDepreciationPosting.NoAssetSelectedSave"],
                MudBlazor.Severity.Warning);
            return;
        }

        var invalidAccountRow = selectedRows.FirstOrDefault(x =>
            string.IsNullOrWhiteSpace(x.ExpenseAccount) ||
            string.IsNullOrWhiteSpace(x.DepreciationAccount));

        if (invalidAccountRow is not null)
        {
            Snackbar.Add(
                string.Format(
                    Localizer["FixedAssetDepreciationPosting.MissingAccounts"].Value,
                    invalidAccountRow.AssetCode),
                MudBlazor.Severity.Warning);
            return;
        }

        _busy = true;

        try
        {
            var saved = await DepreciationService.SaveDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay,
                selectedRows,
                _userName);

            Snackbar.Add(
                string.Format(
                    Localizer["FixedAssetDepreciationPosting.SaveDraftSuccess"].Value,
                    saved,
                    _fiscalPeriod.ToString("00"),
                    _fiscalYear),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PostDraftAsync()
    {
        if (_busy)
            return;

        var selectedDrafts = _rows
            .Where(x => x.Selected && x.IsSavedDraft && !x.IsPosted)
            .ToList();

        if (selectedDrafts.Count == 0)
        {
            Snackbar.Add(
                Localizer["FixedAssetDepreciationPosting.NoDraftSelectedPost"],
                MudBlazor.Severity.Warning);
            return;
        }

        var totalAmount = selectedDrafts.Sum(x => x.DepreciationAmount);

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["FixedAssetDepreciationPosting.PostConfirmTitle"],
            string.Format(
                Localizer["FixedAssetDepreciationPosting.PostConfirmBody"].Value,
                selectedDrafts.Count.ToString("N0"),
                _fiscalPeriod.ToString("00"),
                _fiscalYear,
                FormatMoney(totalAmount)),
            yesText: Localizer["FixedAssetDepreciationPosting.Post"],
            cancelText: Localizer["FixedAssetDepreciationPosting.Cancel"]);

        if (confirmed != true)
            return;

        _busy = true;

        try
        {
            var result = await DepreciationService.PostDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                selectedDrafts
                    .Select(x => x.FixedAssetId)
                    .ToList(),
                _userName);

            Snackbar.Add(
                string.Format(
                    Localizer["FixedAssetDepreciationPosting.PostSuccess"].Value,
                    result.VoucherNo,
                    result.PostedAssetCount.ToString("N0"),
                    result.LedgerLineCount.ToString("N0"),
                    FormatMoney(result.TotalAmount)),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(
                    Localizer["FixedAssetDepreciationPosting.PostFailed"].Value,
                    ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteDraftAsync()
    {
        if (_busy)
            return;

        var selectedDrafts = _rows
            .Where(x => x.Selected && x.IsSavedDraft && !x.IsPosted)
            .ToList();

        if (selectedDrafts.Count == 0)
        {
            Snackbar.Add(
                Localizer["FixedAssetDepreciationPosting.NoDraftSelectedDelete"],
                MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["FixedAssetDepreciationPosting.DeleteConfirmTitle"],
            string.Format(
                Localizer["FixedAssetDepreciationPosting.DeleteConfirmBody"].Value,
                selectedDrafts.Count,
                _fiscalPeriod.ToString("00"),
                _fiscalYear),
            yesText: Localizer["FixedAssetDepreciationPosting.Delete"],
            cancelText: Localizer["FixedAssetDepreciationPosting.Cancel"]);

        if (confirmed != true)
            return;

        _busy = true;

        try
        {
            var deleted = await DepreciationService.DeleteDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                selectedDrafts.Select(x => x.FixedAssetId).ToList());

            Snackbar.Add(
                string.Format(
                    Localizer["FixedAssetDepreciationPosting.DeleteSuccess"].Value,
                    deleted),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleAll(bool value)
    {
        foreach (var row in FilteredRows.Where(x => x.CanSave))
            row.Selected = value;
    }

    private string GetStatusText(FixedAssetDepreciationRow row)
    {
        if (row.IsPosted)
            return Localizer["FixedAssetDepreciationPosting.StatusPosted"];

        if (row.IsSavedDraft)
            return Localizer["FixedAssetDepreciationPosting.StatusDraft"];

        if (!row.CanSave)
            return Localizer["FixedAssetDepreciationPosting.StatusSkipped"];

        return Localizer["FixedAssetDepreciationPosting.StatusUnsaved"];
    }

    private static Color GetStatusColor(FixedAssetDepreciationRow row)
    {
        if (row.IsPosted)
            return Color.Success;

        if (row.IsSavedDraft)
            return Color.Primary;

        if (!row.CanSave)
            return Color.Warning;

        return Color.Default;
    }

    private static string FormatMoney(decimal value)
        => value.ToString("N0");
}
