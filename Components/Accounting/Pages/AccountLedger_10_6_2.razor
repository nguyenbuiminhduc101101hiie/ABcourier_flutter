@page "/accounting/account-ledger"
@page "/AccountLedger"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Configuration
@using Microsoft.JSInterop
@using OfficeOpenXml
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>10.6.2 Sổ cái theo tài khoản</PageTitle>

<div class="product-price-page account-ledger-page">
    <PpScreenHeader Title="10.6.2 Sổ cái theo tài khoản" Subtitle="Account Ledger · xem chi tiết phát sinh và số dư theo từng tài khoản">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Load
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetFilterAsync"
                           Disabled="_busy">
                    Reset
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportExcelAsync"
                           Disabled="_busy || !_rows.Any()">
                    Export
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Chọn theo"
                           Value="@_dateMode"
                           ValueChanged="OnDateModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Theo ngày</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày"
                               Date="@_fromDate"
                               DateChanged="OnFromDateChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày"
                               Date="@_toDate"
                               DateChanged="OnToDateChanged"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Year"
                                 Value="_fiscalYear"
                                 ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2000"
                                 Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Month"
                                 Value="_periodMonth"
                                 ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="12" sm="1">
                <MudSelect T="string"
                           Label="Book"
                           @bind-Value="_book"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Tài khoản"
                           @bind-Value="_accountCode"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Class="account-select">
                    @foreach (var acc in _accountOptions)
                    {
                        <MudSelectItem T="string" Value="@acc.Code">@($"{acc.Code} - {acc.Name}")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

        </MudGrid>

        <MudGrid Spacing="2" AlignItems="Center" Class="mt-1">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchVoucher"
                              Label="Số chứng từ"
                              Placeholder="VoucherNo..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchCustomer"
                              Label="Khách hàng"
                              Placeholder="Tên đối tượng / khách hàng..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.PersonSearch" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchDescription"
                              Label="Diễn giải"
                              Placeholder="Nội dung diễn giải..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Notes" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_searchSource"
                              Label="Nguồn phát sinh"
                              Placeholder="Source..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Source" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            @DateModeHelpText
        </MudText>
    </MudPaper>

    <MudPaper Class="product-price-card pa-3 mb-2 account-title-card" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="fw-bold">
                    SỔ CÁI TÀI KHOẢN @_accountCode
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_accountName
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @DateModeCaption: @(_fromDate?.ToString("dd/MM/yyyy") ?? "...") - @(_toDate?.ToString("dd/MM/yyyy") ?? "...") | Book: @_book
                </MudText>
            </MudStack>

            <MudChip T="string" Color="@(_closingBalance >= 0 ? Color.Success : Color.Error)" Variant="Variant.Filled">
                Số dư CK: @Math.Abs(_closingBalance).ToString("N0") @_closingSide
            </MudChip>
        </MudStack>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center ledger-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Số dư đầu kỳ</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@Math.Abs(_openingBalance).ToString("N0") @_openingSide</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center ledger-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Tổng phát sinh Nợ</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@_totalDebit.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center ledger-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Tổng phát sinh Có</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@_totalCredit.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center ledger-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Số dư cuối kỳ</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@Math.Abs(_closingBalance).ToString("N0") @_closingSide</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudDataGrid @key="_gridKey"
                     T="AccountLedgerRow"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Hover="true"
                     Bordered="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     ColumnResizeMode="ResizeMode.Column"
                     FixedHeader="true"
                     Height="calc(100vh - 430px)"
                     Class="account-ledger-grid"
                     Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.PostingDate" Title="Ngày HT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="Chứng từ" />
                <PropertyColumn Property="x => x.VoucherDate" Title="Ngày CT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.SoHD" Title="Số HĐ" />
                <PropertyColumn Property="x => x.Description" Title="Diễn giải" />
                <PropertyColumn Property="x => x.CustomerName" Title="Đối tượng / Khách hàng" />
                <PropertyColumn Property="x => x.OppositeAccountCode" Title="TK ĐƯ" />
                <PropertyColumn Property="x => x.Debit" Title="Nợ" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Credit" Title="Có" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.RunningBalanceAbs" Title="Số dư" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.RunningBalanceSide" Title="Dư Nợ/Có" />
                <PropertyColumn Property="x => x.Book" Title="Book" />
                <PropertyColumn Property="x => x.SourceName" Title="Nguồn" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="AccountLedgerRow" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>

            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                    Không có phát sinh cho tài khoản này.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";
    private static bool _epplusLicenseConfigured;

    private void ConfigureEpplusLicense()
    {
        if (_epplusLicenseConfigured)
            return;

        var commercialLicenseKey = Configuration["EPPlus:LicenseKey"];
        ExcelPackage.LicenseContext = string.IsNullOrWhiteSpace(commercialLicenseKey)
            ? LicenseContext.NonCommercial
            : LicenseContext.Commercial;

        _epplusLicenseConfigured = true;
    }

    private bool _busy;
    private string _usr = string.Empty;
    private int _gridKey;
    private string _dateMode = "DATE_RANGE";

    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "TAX";
    private string _accountCode = "131";
    private string _accountName = string.Empty;
    private string _searchVoucher = string.Empty;
    private string _searchCustomer = string.Empty;
    private string _searchDescription = string.Empty;
    private string _searchSource = string.Empty;

    private decimal _openingBalance;
    private decimal _closingBalance;
    private decimal _totalDebit;
    private decimal _totalCredit;
    private string _openingSide = string.Empty;
    private string _closingSide = string.Empty;

    private List<AccountOption> _accountOptions = new();
    private List<AccountLedgerRow> _rows = new();

    private IEnumerable<AccountLedgerRow> VisibleItems =>
        _rows.Where(MatchesSearch);

    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);

    private string DateModeCaption => IsPeriodMode ? "Theo kỳ" : "Theo ngày";

    private string DateModeHelpText => IsPeriodMode
        ? "Đang lọc theo kỳ kế toán: hệ thống dùng FiscalYear/FiscalPeriod và tự set Từ ngày - Đến ngày theo tháng."
        : "Đang lọc theo ngày hạch toán PostingDate: chọn Từ ngày - Đến ngày, không ép FiscalYear/FiscalPeriod.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAccountOptionsAsync();
        EnsureDateRange();
        await LoadAsync();
    }

    private async Task OnDateModeChanged(string value)
    {
        _dateMode = string.IsNullOrWhiteSpace(value) ? "DATE_RANGE" : value;

        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();

        await LoadAsync();
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _fromDate = date;
        EnsureDateRange();

        if (IsDateRangeMode)
            await LoadAsync();
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _toDate = date;
        EnsureDateRange();

        if (IsDateRangeMode)
            await LoadAsync();
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;

        if (IsPeriodMode)
            UpdateDateRange();

        await LoadAsync();
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;

        if (IsPeriodMode)
            UpdateDateRange();

        await LoadAsync();
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue)
            return;

        if (_periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        if (!_fromDate.HasValue)
            _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_toDate.HasValue)
            _toDate = DateTime.Today;

        if (_fromDate.Value.Date > _toDate.Value.Date)
        {
            var temp = _fromDate;
            _fromDate = _toDate;
            _toDate = temp;
        }

        _fromDate = _fromDate.Value.Date;
        _toDate = _toDate.Value.Date;
    }

    private async Task ResetFilterAsync()
    {
        _dateMode = "DATE_RANGE";
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "TAX";
        _accountCode = _accountOptions.FirstOrDefault()?.Code ?? "131";
        _searchVoucher = string.Empty;
        _searchCustomer = string.Empty;
        _searchDescription = string.Empty;
        _searchSource = string.Empty;

        EnsureDateRange();

        await LoadAsync();
    }

    private async Task LoadAccountOptionsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var accounts = await db.DanhMucTaiKhoan.AsNoTracking()
                .OrderBy(x => x.Taikhoan)
                .Select(x => new AccountOption
                {
                    Code = x.Taikhoan ?? string.Empty,
                    Name = x.Tentaikhoan ?? string.Empty
                })
                .ToListAsync();

            _accountOptions = accounts
                .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                .GroupBy(x => x.Code, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(x => x.Code)
                .ToList();

            if (!_accountOptions.Any(x => string.Equals(x.Code, _accountCode, StringComparison.OrdinalIgnoreCase)))
                _accountCode = _accountOptions.FirstOrDefault()?.Code ?? _accountCode;
        }
        catch
        {
            _accountOptions = new();
        }
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            _rows.Clear();
            return;
        }

        if (string.IsNullOrWhiteSpace(_accountCode))
        {
            Snackbar.Add("Vui lòng chọn tài khoản.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toExclusive = (_toDate?.Date ?? DateTime.Today).Date.AddDays(1);

            _accountName = await db.DanhMucTaiKhoan.AsNoTracking()
                .Where(x => x.Taikhoan == _accountCode)
                .Select(x => x.Tentaikhoan)
                .FirstOrDefaultAsync() ?? string.Empty;

            _openingBalance = await LoadOpeningBalanceAsync(db);

            var query = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.AccountCode == _accountCode);

            query = query.Where(x => x.PostingDate >= fromDate && x.PostingDate < toExclusive);

            if (IsPeriodMode && _fiscalYear.HasValue)
                query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsTaxBook == true);

            if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsManagementBook == true);

            var data = await query
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.CreatedAt)
                .ToListAsync();

            var customerIds = data
                .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
                .Select(x => x.CustomerId!.Value)
                .Distinct()
                .ToHashSet();

            var customerMap = new Dictionary<Guid, string>();
            if (customerIds.Count > 0)
            {
                var customers = await db.Customer.AsNoTracking()
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .Select(c => new
                    {
                        c.Customer_ID,
                        c.Customer_Code,
                        c.COMPANY
                    })
                    .ToListAsync();

                customerMap = customers
                    .GroupBy(x => x.Customer_ID)
                    .ToDictionary(
                        g => g.Key,
                        g =>
                        {
                            var c = g.First();
                            return string.IsNullOrWhiteSpace(c.Customer_Code)
                                ? (c.COMPANY ?? string.Empty)
                                : $"{c.Customer_Code} - {c.COMPANY}";
                        });
            }

            var voucherIds = data.Select(x => x.VoucherId).Where(x => x != Guid.Empty).Distinct().ToHashSet();
            var oppositeMap = new Dictionary<Guid, string>();

            if (voucherIds.Count > 0)
            {
                var voucherLines = await db.GeneralLedgerEntries.AsNoTracking()
                    .Where(x => voucherIds.Contains(x.VoucherId) && x.AccountCode != _accountCode)
                    .Select(x => new
                    {
                        x.VoucherId,
                        x.AccountCode
                    })
                    .ToListAsync();

                oppositeMap = voucherLines
                    .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                    .GroupBy(x => x.VoucherId)
                    .ToDictionary(
                        g => g.Key,
                        g => string.Join(", ", g.Select(x => x.AccountCode).Distinct().OrderBy(x => x)));
            }

            var sourceMap = await LoadSourceMapAsync(db, data);

            decimal running = _openingBalance;
            var rows = new List<AccountLedgerRow>();

            rows.Add(new AccountLedgerRow
            {
                PostingDate = fromDate,
                VoucherNo = "OPENING",
                VoucherDate = _fromDate ?? DateTime.Today,
                Description = "Số dư đầu kỳ",
                CustomerName = string.Empty,
                OppositeAccountCode = string.Empty,
                Debit = _openingBalance > 0 ? _openingBalance : 0,
                Credit = _openingBalance < 0 ? Math.Abs(_openingBalance) : 0,
                RunningBalance = running,
                RunningBalanceAbs = Math.Abs(running),
                RunningBalanceSide = GetSide(running),
                Book = _book,
                SourceName = "Account Balance"
            });

            foreach (var x in data)
            {
                running += x.Debit - x.Credit;

                rows.Add(new AccountLedgerRow
                {
                    Id = x.Id,
                    PostingDate = x.PostingDate,
                    VoucherNo = x.VoucherNo ?? string.Empty,
                    VoucherDate = x.VoucherDate,
                    SoHD = x.SoHD ?? string.Empty,
                    Description = x.Description ?? string.Empty,
                    CustomerName = x.CustomerId.HasValue && customerMap.TryGetValue(x.CustomerId.Value, out var customerName)
                        ? customerName
                        : string.Empty,
                    OppositeAccountCode = oppositeMap.TryGetValue(x.VoucherId, out var opposite)
                        ? opposite
                        : string.Empty,
                    Debit = x.Debit,
                    Credit = x.Credit,
                    RunningBalance = running,
                    RunningBalanceAbs = Math.Abs(running),
                    RunningBalanceSide = GetSide(running),
                    Book =
                        x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" :
                        x.IsTaxBook == true ? "TAX" :
                        x.IsManagementBook == true ? "MGMT" :
                        string.Empty,
                    SourceName = !string.IsNullOrWhiteSpace(x.SourceId) && sourceMap.TryGetValue(x.SourceId.Trim(), out var sourceName)
                        ? sourceName
                        : x.SourceModule ?? string.Empty
                });
            }

            _rows = rows;
            _totalDebit = data.Sum(x => x.Debit);
            _totalCredit = data.Sum(x => x.Credit);
            _closingBalance = running;
            _openingSide = GetSide(_openingBalance);
            _closingSide = GetSide(_closingBalance);

            _gridKey++;
            Snackbar.Add($"Loaded {_rows.Count:N0} ledger rows.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<decimal> LoadOpeningBalanceAsync(AppDbContext db)
    {
        var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        var balanceYear = IsPeriodMode && _fiscalYear.HasValue ? _fiscalYear.Value : fromDate.Year;
        var balanceMonth = IsPeriodMode && _periodMonth.HasValue ? _periodMonth.Value : fromDate.Month;
        var periodStart = new DateTime(balanceYear, balanceMonth, 1);

        var openingBalance = await db.AccountBalances.AsNoTracking()
            .Where(x => x.PeriodYear == balanceYear
                     && x.PeriodMonth == balanceMonth
                     && x.AccountCode == _accountCode
                     && x.BookCode == _book)
            .Select(x => (decimal?)x.OpeningBalance)
            .FirstOrDefaultAsync() ?? 0;

        if (IsPeriodMode || fromDate <= periodStart)
            return openingBalance;

        var movementQuery = db.GeneralLedgerEntries.AsNoTracking()
            .Where(x => x.AccountCode == _accountCode)
            .Where(x => x.PostingDate >= periodStart && x.PostingDate < fromDate);

        if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
            movementQuery = movementQuery.Where(x => x.IsTaxBook == true);

        if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
            movementQuery = movementQuery.Where(x => x.IsManagementBook == true);

        var movementBeforeFromDate = await movementQuery
            .SumAsync(x => (decimal?)(x.Debit - x.Credit)) ?? 0;

        return openingBalance + movementBeforeFromDate;
    }

    private async Task<Dictionary<string, string>> LoadSourceMapAsync(AppDbContext db, List<M_GeneralLedgerEntries> data)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        var sourceIdsText = data
            .Where(x => !string.IsNullOrWhiteSpace(x.SourceId))
            .Select(x => x.SourceId!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (sourceIdsText.Count == 0)
            return result;

        var sourceVouchers = await db.AccountingVouchers.AsNoTracking()
            .Where(v => !string.IsNullOrWhiteSpace(v.SourceId)
                     && sourceIdsText.Contains(v.SourceId))
            .Select(v => new
            {
                v.SourceId,
                v.VoucherNo,
                v.Description
            })
            .ToListAsync();

        foreach (var v in sourceVouchers)
        {
            if (string.IsNullOrWhiteSpace(v.SourceId))
                continue;

            result[v.SourceId.Trim()] = string.IsNullOrWhiteSpace(v.Description)
                ? v.VoucherNo
                : $"{v.VoucherNo} - {v.Description}";
        }

        var sourceIdsGuid = sourceIdsText
            .Select(x => Guid.TryParse(x, out var id) ? id : Guid.Empty)
            .Where(x => x != Guid.Empty)
            .Distinct()
            .ToHashSet();

        if (sourceIdsGuid.Count > 0)
        {
            var receipts = await db.Phieuthu.AsNoTracking()
                .Where(p => sourceIdsGuid.Contains(p.PhieuthuID))
                .Select(p => new
                {
                    Id = p.PhieuthuID,
                    No = p.SoPhieuthu,
                    Description = p.Noidung
                })
                .ToListAsync();

            foreach (var p in receipts)
            {
                result[p.Id.ToString()] = string.IsNullOrWhiteSpace(p.Description)
                    ? p.No
                    : $"{p.No} - {p.Description}";
            }
        }

        return result;
    }

    private bool MatchesSearch(AccountLedgerRow x)
    {
        if (!string.IsNullOrWhiteSpace(_searchVoucher)
            && !x.VoucherNo.Contains(_searchVoucher.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchCustomer)
            && !x.CustomerName.Contains(_searchCustomer.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchDescription)
            && !x.Description.Contains(_searchDescription.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchSource)
            && !x.SourceName.Contains(_searchSource.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    private async Task ExportExcelAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xuất sổ chi tiết công nợ.", MudBlazor.Severity.Warning);
            return;
        }

        EnsureDateRange();

        if (!_fromDate.HasValue || !_toDate.HasValue)
        {
            Snackbar.Add("Vui lòng chọn Từ ngày / Đến ngày trước khi export.", MudBlazor.Severity.Warning);
            return;
        }

        var detailRows = VisibleItems
            .Where(x => !string.Equals(x.VoucherNo, "OPENING", StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (detailRows.Count == 0 && _openingBalance == 0)
        {
            Snackbar.Add("Không có dữ liệu theo điều kiện search hiện tại để export.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            ConfigureEpplusLicense();

            await using var db = await DbFactory.CreateDbContextAsync();
            var company = await db.CompanyInfomation.AsNoTracking().FirstOrDefaultAsync();
            var companyName = string.IsNullOrWhiteSpace(company?.NameTiengViet)
                ? "CÔNG TY TNHH HÀNG HẢI AMASIS"
                : company!.NameTiengViet!.Trim();
            var companyAddress = string.IsNullOrWhiteSpace(company?.AddressTiengViet)
                ? (company?.Address ?? "27-29 Đường Ngô Thị Bì, Phường Tân Hưng, TP Hồ Chí Minh, Việt Nam")
                : company!.AddressTiengViet!.Trim();
            var taxCode = string.IsNullOrWhiteSpace(company?.TaxCode) ? "0311095854" : company!.TaxCode!.Trim();

            var customerHeader = ResolveExportCustomerHeader(detailRows);

            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("Sheet1");
            BuildChiTietCongNoSheet(
                ws,
                companyName,
                companyAddress,
                taxCode,
                _fromDate.Value.Date,
                _toDate.Value.Date,
                _accountCode,
                _accountName,
                customerHeader,
                _openingBalance,
                detailRows);

            var bytes = package.GetAsByteArray();
            var safeAccount = string.IsNullOrWhiteSpace(_accountCode) ? "TK" : _accountCode.Trim();
            var fileName = $"SO_CHI_TIET_CONG_NO_{safeAccount}_{_fromDate:yyyyMMdd}_{_toDate:yyyyMMdd}_{DateTime.Now:HHmmss}.xlsx";
            await DownloadBytesAsync(bytes, fileName);

            Snackbar.Add($"Đã export sổ chi tiết công nợ: {detailRows.Count:N0} dòng phát sinh.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            Snackbar.Add("Export Excel thất bại: " + root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private string ResolveExportCustomerHeader(List<AccountLedgerRow> detailRows)
    {
        if (!string.IsNullOrWhiteSpace(_searchCustomer))
            return _searchCustomer.Trim();

        var customers = detailRows
            .Select(x => x.CustomerName?.Trim() ?? string.Empty)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return customers.Count == 1 ? customers[0] : string.Empty;
    }

    private static void BuildChiTietCongNoSheet(
        ExcelWorksheet ws,
        string companyName,
        string companyAddress,
        string taxCode,
        DateTime fromDate,
        DateTime toDate,
        string accountCode,
        string accountName,
        string customerHeader,
        decimal openingBalance,
        List<AccountLedgerRow> detailRows)
    {
        const string fontName = "Times New Roman";

        ws.Cells["A1:M1"].Merge = true;
        ws.Cells["A1"].Value = companyName;
        ws.Cells["A1"].Style.Font.Bold = true;
        ws.Cells["A1"].Style.Font.Size = 16;
        ws.Cells["A1"].Style.Font.Name = fontName;
        ws.Row(1).Height = 21;

        ws.Cells["A2:M2"].Merge = true;
        ws.Cells["A2"].Value = $"{companyAddress}\nMST: {taxCode}";
        ws.Cells["A2"].Style.Font.Size = 12;
        ws.Cells["A2"].Style.Font.Name = fontName;
        ws.Cells["A2"].Style.WrapText = true;
        ws.Row(2).Height = 35;

        var title = string.IsNullOrWhiteSpace(accountName)
            ? $"SỔ {accountCode}"
            : $"SỔ {accountCode} - {accountName.Trim().ToUpperInvariant()}";

        ws.Cells["A4:M4"].Merge = true;
        ws.Cells["A4"].Value = title;
        ws.Cells["A4"].Style.Font.Bold = true;
        ws.Cells["A4"].Style.Font.Size = 15;
        ws.Cells["A4"].Style.Font.Name = fontName;
        ws.Cells["A4"].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;

        ws.Cells["A5:M5"].Merge = true;
        ws.Cells["A5"].Value = $"Từ ngày: {fromDate:dd/MM/yyyy}, đến ngày: {toDate:dd/MM/yyyy}";
        ws.Cells["A5"].Style.Font.Size = 10;
        ws.Cells["A5"].Style.Font.Name = fontName;
        ws.Cells["A5"].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;

        ws.Cells["A6:M6"].Merge = true;
        ws.Cells["A6"].Value = string.IsNullOrWhiteSpace(customerHeader)
            ? string.Empty
            : $"KHÁCH HÀNG: {customerHeader.Trim().ToUpperInvariant()}";
        ws.Cells["A6"].Style.Font.Size = 10;
        ws.Cells["A6"].Style.Font.Name = fontName;
        ws.Cells["A6"].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;

        ws.Cells["A7:M7"].Merge = true;
        ws.Cells["A7"].Value = "Đơn vị tính : Đồng VN";
        ws.Cells["A7"].Style.Font.Size = 10;
        ws.Cells["A7"].Style.Font.Name = fontName;
        ws.Cells["A7"].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Right;

        ws.Cells["A8:A9"].Merge = true;
        ws.Cells["A8"].Value = "Ngày tháng\nchứng từ";

        ws.Cells["B8:D8"].Merge = true;
        ws.Cells["B8"].Value = "Sổ phiếu chứng từ";
        ws.Cells["B9"].Value = "Nợ";
        ws.Cells["C9"].Value = "Có";
        ws.Cells["D9"].Value = "Số HĐ";

        ws.Cells["E8:E9"].Merge = true;
        ws.Cells["E8"].Value = "Cá nhân/Đơn vị";

        ws.Cells["F8:F9"].Merge = true;
        ws.Cells["F8"].Value = "Diễn giải";

        ws.Cells["G8:G9"].Merge = true;
        ws.Cells["G8"].Value = "TK/\nđối ứng";

        ws.Cells["H8:I8"].Merge = true;
        ws.Cells["H8"].Value = "Số phát sinh";
        ws.Cells["H9"].Value = "Nợ";
        ws.Cells["I9"].Value = "Có";

        ws.Cells["J8:K8"].Merge = true;
        ws.Cells["J8"].Value = "Số dư";
        ws.Cells["J9"].Value = "Nợ";
        ws.Cells["K9"].Value = "Có";

        ws.Cells["L8:M8"].Merge = true;
        ws.Cells["L8"].Value = "Ref.";
        ws.Cells["L9"].Value = "DN";
        ws.Cells["M9"].Value = "NO";

        var headerRange = ws.Cells["A8:M9"];
        headerRange.Style.Font.Bold = true;
        headerRange.Style.Font.Size = 10;
        headerRange.Style.Font.Name = fontName;
        headerRange.Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;
        headerRange.Style.VerticalAlignment = OfficeOpenXml.Style.ExcelVerticalAlignment.Center;
        headerRange.Style.WrapText = true;
        ApplyThinBorder(headerRange);

        var row = 10;
        var running = openingBalance;

        WriteOpeningRow(ws, row, accountCode, openingBalance, fontName);
        ApplyThinBorder(ws.Cells[row, 1, row, 13]);
        row++;

        decimal totalDebit = 0;
        decimal totalCredit = 0;

        foreach (var item in detailRows)
        {
            running += item.Debit - item.Credit;
            totalDebit += item.Debit;
            totalCredit += item.Credit;

            ws.Cells[row, 1].Value = item.PostingDate;
            ws.Cells[row, 1].Style.Numberformat.Format = "dd/MM/yyyy";

            if (item.Debit > 0)
                ws.Cells[row, 2].Value = item.VoucherNo;
            if (item.Credit > 0)
                ws.Cells[row, 3].Value = item.VoucherNo;

            ws.Cells[row, 4].Value = item.SoHD;
            ws.Cells[row, 5].Value = item.CustomerName;
            ws.Cells[row, 6].Value = item.Description;
            ws.Cells[row, 7].Value = item.OppositeAccountCode;

            if (item.Debit != 0)
                ws.Cells[row, 8].Value = item.Debit;
            if (item.Credit != 0)
                ws.Cells[row, 9].Value = item.Credit;

            if (running > 0)
                ws.Cells[row, 10].Value = Math.Abs(running);
            else if (running < 0)
                ws.Cells[row, 11].Value = Math.Abs(running);
            else
                ws.Cells[row, 10].Value = 0;

            ws.Cells[row, 12].Value = item.Book;
            ws.Cells[row, 13].Value = string.IsNullOrWhiteSpace(item.SourceName) ? item.VoucherNo : item.SourceName;

            ws.Cells[row, 1, row, 13].Style.Font.Name = fontName;
            ws.Cells[row, 1, row, 13].Style.Font.Size = 10;
            ws.Cells[row, 8, row, 11].Style.Numberformat.Format = "#,##0";
            ws.Cells[row, 8, row, 11].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Right;
            ApplyThinBorder(ws.Cells[row, 1, row, 13]);
            row++;
        }

        WriteTotalRow(ws, row, accountCode, totalDebit, totalCredit, running, fontName);
        ApplyThinBorder(ws.Cells[row, 1, row, 13]);
        row += 3;

        ws.Cells[row, 1, row, 4].Merge = true;
        ws.Cells[row, 1].Value = "Người lập biểu";
        ws.Cells[row, 5, row, 9].Merge = true;
        ws.Cells[row, 5].Value = "Kế toán trưởng";
        ws.Cells[row, 10, row, 13].Merge = true;
        ws.Cells[row, 10].Value = "Giám đốc";
        ws.Cells[row, 1, row, 13].Style.Font.Bold = true;
        ws.Cells[row, 1, row, 13].Style.Font.Size = 10;
        ws.Cells[row, 1, row, 13].Style.Font.Name = fontName;
        ws.Cells[row, 1, row, 13].Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;

        ws.Column(1).Width = 12;
        ws.Column(2).Width = 14;
        ws.Column(3).Width = 14;
        ws.Column(4).Width = 12;
        ws.Column(5).Width = 36;
        ws.Column(6).Width = 40;
        ws.Column(7).Width = 10;
        ws.Column(8).Width = 14;
        ws.Column(9).Width = 14;
        ws.Column(10).Width = 14;
        ws.Column(11).Width = 14;
        ws.Column(12).Width = 10;
        ws.Column(13).Width = 18;
    }

    private static void WriteOpeningRow(ExcelWorksheet ws, int row, string accountCode, decimal openingBalance, string fontName)
    {
        ws.Cells[row, 6].Value = $"Số đầu kỳ TK: {accountCode}";
        ws.Cells[row, 6].Style.Font.Bold = true;

        if (openingBalance > 0)
            ws.Cells[row, 10].Value = openingBalance;
        else if (openingBalance < 0)
            ws.Cells[row, 11].Value = Math.Abs(openingBalance);
        else
            ws.Cells[row, 10].Value = 0;

        ws.Cells[row, 1, row, 13].Style.Font.Name = fontName;
        ws.Cells[row, 1, row, 13].Style.Font.Size = 10;
        ws.Cells[row, 1, row, 13].Style.Font.Bold = true;
        ws.Cells[row, 8, row, 11].Style.Numberformat.Format = "#,##0";
    }

    private static void WriteTotalRow(
        ExcelWorksheet ws,
        int row,
        string accountCode,
        decimal totalDebit,
        decimal totalCredit,
        decimal closingBalance,
        string fontName)
    {
        ws.Cells[row, 6].Value = $"Tổng cộng TK: {accountCode}";
        ws.Cells[row, 8].Value = totalDebit;
        ws.Cells[row, 9].Value = totalCredit;

        if (closingBalance > 0)
            ws.Cells[row, 10].Value = Math.Abs(closingBalance);
        else if (closingBalance < 0)
            ws.Cells[row, 11].Value = Math.Abs(closingBalance);
        else
        {
            ws.Cells[row, 10].Value = 0;
            ws.Cells[row, 11].Value = 0;
        }

        ws.Cells[row, 1, row, 13].Style.Font.Name = fontName;
        ws.Cells[row, 1, row, 13].Style.Font.Size = 10;
        ws.Cells[row, 1, row, 13].Style.Font.Bold = true;
        ws.Cells[row, 8, row, 11].Style.Numberformat.Format = "#,##0";
    }

    private static void ApplyThinBorder(ExcelRange range)
    {
        range.Style.Border.Top.Style = OfficeOpenXml.Style.ExcelBorderStyle.Thin;
        range.Style.Border.Bottom.Style = OfficeOpenXml.Style.ExcelBorderStyle.Thin;
        range.Style.Border.Left.Style = OfficeOpenXml.Style.ExcelBorderStyle.Thin;
        range.Style.Border.Right.Style = OfficeOpenXml.Style.ExcelBorderStyle.Thin;
    }

    private async Task DownloadBytesAsync(byte[] bytes, string fileName)
    {
        var base64 = Convert.ToBase64String(bytes);
        var safeFileName = fileName.Replace("'", string.Empty).Replace("\\", string.Empty).Replace("/", string.Empty);
        await JS.InvokeVoidAsync(
            "downloadFileFromBase64",
            safeFileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);
    }

    private static string GetSide(decimal amount)
    {
        if (amount > 0)
            return "Nợ";

        if (amount < 0)
            return "Có";

        return "Cân";
    }

