@page "/accounting/general-ledger-entries"
@page "/GeneralLedgerEntries586"
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["GeneralLedgerEntries.Title"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"10.6 {Localizer["GeneralLedgerEntries.Title"]}")" Subtitle="GL postings">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAsync" Disabled="_busy">@Localizer["new"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditAsync" Disabled="_busy || _selected is null">@Localizer["edit"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null">@Localizer["delete"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">@Localizer["reload"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudTextField @bind-Value="_search"
                      Label="@Localizer["search"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-2" />
        <MudPaper Class="pa-2 mb-2 d-flex flex-wrap gap-3 gl-column-toggle" Elevation="0" Outlined="true">
            <MudText Typo="Typo.caption" Class="mr-2 d-flex align-center fw-bold">Hiển thị cột:</MudText>

            <MudCheckBox T="bool" Checked="_showIds" CheckedChanged="@((bool v) => ToggleColumns(() => _showIds = v))" Label="IDs" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showVoucher" CheckedChanged="@((bool v) => ToggleColumns(() => _showVoucher = v))" Label="Voucher" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showPeriod" CheckedChanged="@((bool v) => ToggleColumns(() => _showPeriod = v))" Label="Period" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showAccount" CheckedChanged="@((bool v) => ToggleColumns(() => _showAccount = v))" Label="Account" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showParty" CheckedChanged="@((bool v) => ToggleColumns(() => _showParty = v))" Label="Customer/Company" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showAmount" CheckedChanged="@((bool v) => ToggleColumns(() => _showAmount = v))" Label="Amount" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showBook" CheckedChanged="@((bool v) => ToggleColumns(() => _showBook = v))" Label="Book" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showSource" CheckedChanged="@((bool v) => ToggleColumns(() => _showSource = v))" Label="Source" Dense="true" Color="Color.Primary" />
            <MudCheckBox T="bool" Checked="_showAudit" CheckedChanged="@((bool v) => ToggleColumns(() => _showAudit = v))" Label="Audit" Dense="true" Color="Color.Primary" />
        </MudPaper>
        @if (FilterYear.HasValue || FilterMonth.HasValue || !string.IsNullOrWhiteSpace(FilterBook) || !string.IsNullOrWhiteSpace(FilterAccountCode) || FilterCustomerId.HasValue)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                Lọc sổ cái: Year=@(FilterYear?.ToString() ?? "ALL"), Month=@(FilterMonth?.ToString() ?? "ALL"), Book=@(FilterBook ?? "ALL"), Account=@(FilterAccountCode ?? "ALL")
            </MudAlert>
        }
        <MudDataGrid @key="_gridKey" T="M_GeneralLedgerEntries" Items="VisibleItems" Dense="true" Striped="true" Hover="true" Bordered="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     ColumnResizeMode="ResizeMode.Column" Class="auto-fit-grid"
                     FixedHeader="true"
                     Height="calc(100vh - 235px)"
                     RowClassFunc="RowClass" SelectedItem="_selected" SelectedItemChanged="OnSelectedChanged"
                     Loading="_busy">
            <Columns>
                @if (_showIds)
                {
                    <PropertyColumn Property="x => x.Id" Title="Entry Id" />
                    <PropertyColumn Property="x => x.VoucherId" Title="Voucher Id" />
                    <PropertyColumn Property="x => x.VoucherLineId" Title="Line Id" />
                }

                @if (_showVoucher)
                {
                    <PropertyColumn Property="x => x.VoucherNo" Title="Voucher No" />
                    <PropertyColumn Property="x => x.LedgerType" Title="Type" />
                    <PropertyColumn Property="x => x.VoucherDate" Title="Voucher Date" Format="dd/MM/yyyy" />
                    <PropertyColumn Property="x => x.PostingDate" Title="Posting Date" Format="dd/MM/yyyy" />
                }

                @if (_showPeriod)
                {
                    <PropertyColumn Property="x => x.FiscalYear" Title="Year" />
                    <PropertyColumn Property="x => x.FiscalPeriod" Title="Month" />
                }

                @if (_showParty)
                {
                    <PropertyColumn Property="x => GetCompanyShortName(x.CompanyId)" Title="Company/Owner" />
                    <PropertyColumn Property="x => GetCustomerName(x.CustomerId)" Title="Customer" />
                    <PropertyColumn Property="x => x.SupplierId" Title="SupplierId" />
                    <PropertyColumn Property="x => x.EmployeeId" Title="EmployeeId" />
                }

                @if (_showAccount)
                {
                    <PropertyColumn Property="x => x.AccountCode" Title="Account Code" />
                    <PropertyColumn Property="x => x.SoHD" Title="Số HĐ" />
                    <PropertyColumn Property="x => x.Description" Title="Description" />
                    <PropertyColumn Property="x => x.ShipmentId" Title="ShipmentId" />
                }

                @if (_showAmount)
                {
                    <PropertyColumn Property="x => x.Debit" Title="Debit" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    <PropertyColumn Property="x => x.Credit" Title="Credit" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                    <PropertyColumn Property="x => x.CurrencyCode" Title="Currency" />
                    <PropertyColumn Property="x => x.ExchangeRate" Title="Rate" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                }

                @if (_showBook)
                {
                    <PropertyColumn Property="x => x.IsTaxBook" Title="Tax" />
                    <PropertyColumn Property="x => x.IsManagementBook" Title="MGMT" />
                    <PropertyColumn Property="x => x.LedgerType" Title="Ledger Type" />
                }

                @if (_showSource)
                {
                    <PropertyColumn Property="x => x.SourceModule" Title="Source Module" />
                    <PropertyColumn Property="x => GetSourceName(x.SourceModule, x.SourceId)" Title="Source Name" />
                }

                @if (_showAudit)
                {
                    <PropertyColumn Property="x => x.CreatedBy" Title="Created By" />
                    <PropertyColumn Property="x => x.CreatedAt" Title="Created At" Format="dd/MM/yyyy HH:mm" />
                }
            </Columns>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private readonly string PermissionMenuName = "GeneralLedgerEntries";
    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private List<M_GeneralLedgerEntries> _rows = new();
    private Dictionary<Guid, string> _companyShortById = new();
    private M_GeneralLedgerEntries? _selected;
    private int _gridKey;

    private bool _showIds = false;
    private bool _showVoucher = true;
    private bool _showPeriod = true;
    private bool _showAccount = true;
    private bool _showParty = true;
    private bool _showAmount = true;
    private bool _showBook = true;
    private bool _showSource = true;
    private bool _showAudit = false;

    private Dictionary<Guid, string> _customerNameById = new();
    private Dictionary<string, string> _sourceNameById = new(StringComparer.OrdinalIgnoreCase);

    [SupplyParameterFromQuery(Name = "year")]
    public int? QueryYear { get; set; }

    [SupplyParameterFromQuery(Name = "month")]
    public int? QueryMonth { get; set; }

    [SupplyParameterFromQuery(Name = "book")]
    public string? QueryBook { get; set; }

    [SupplyParameterFromQuery(Name = "accountCode")]
    public string? QueryAccountCode { get; set; }

    [SupplyParameterFromQuery(Name = "customerId")]
    public Guid? QueryCustomerId { get; set; }

    [Parameter] public int? InitialYear { get; set; }
    [Parameter] public int? InitialMonth { get; set; }
    [Parameter] public string? InitialBook { get; set; }
    [Parameter] public string? InitialAccountCode { get; set; }
    [Parameter] public Guid? InitialCustomerId { get; set; }

    private int? FilterYear => InitialYear ?? QueryYear;
    private int? FilterMonth => InitialMonth ?? QueryMonth;
    private string? FilterBook => !string.IsNullOrWhiteSpace(InitialBook) ? InitialBook : QueryBook;
    private string? FilterAccountCode => !string.IsNullOrWhiteSpace(InitialAccountCode) ? InitialAccountCode : QueryAccountCode;
    private Guid? FilterCustomerId => InitialCustomerId ?? QueryCustomerId;

    private IEnumerable<M_GeneralLedgerEntries> VisibleItems =>
        _rows.Where(MatchesQueryFilters).Where(MatchesSearch);

    private bool MatchesQueryFilters(M_GeneralLedgerEntries x)
    {
        if (FilterYear.HasValue && x.FiscalYear != FilterYear.Value)
            return false;

        if (FilterMonth.HasValue && x.FiscalPeriod != FilterMonth.Value)
            return false;

        if (!string.IsNullOrWhiteSpace(FilterBook))
        {
            var book = FilterBook.Trim().ToUpperInvariant();
            if (book == "TAX" && x.IsTaxBook != true)
                return false;
            if (book == "MGMT" && x.IsManagementBook != true)
                return false;
        }

        if (!string.IsNullOrWhiteSpace(FilterAccountCode)
            && !string.Equals(x.AccountCode?.Trim(), FilterAccountCode.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        if (FilterCustomerId.HasValue && x.CustomerId != FilterCustomerId.Value)
            return false;

        return true;
    }

    private bool MatchesSearch(M_GeneralLedgerEntries x)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var key = _search.Trim();
        return (x.VoucherNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || GetCompanyShortName(x.CompanyId).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.AccountCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.SoHD?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Description?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.Debit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Credit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.CurrencyCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.ExchangeRate.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.SourceModule?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.IsTaxBook?.ToString().Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.IsManagementBook?.ToString().Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.LedgerType?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.CreatedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.CreatedAt.ToString("dd/MM/yyyy HH:mm").Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(QueryAccountCode))
            _search = QueryAccountCode.Trim();

        await LoadAsync();
    }

    private void ToggleColumns(Action action)
    {
        action();
        _gridKey++;
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            _rows.Clear();
            _companyShortById.Clear();
            _customerNameById.Clear();
            _sourceNameById.Clear();
            _selected = null;
            return;
        }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _rows = await db.GeneralLedgerEntries
                .AsNoTracking()
                .OrderByDescending(x => x.PostingDate)
                .ThenByDescending(x => x.CreatedAt)
                .ToListAsync();

            var companyIds = _rows.Select(x => x.CompanyId).Distinct().ToHashSet();
            if (companyIds.Count == 0)
            {
                _companyShortById = new Dictionary<Guid, string>();
            }
            else
            {
                var companyShortNames = await db.Customer.AsNoTracking()
                    .Where(c => !string.IsNullOrWhiteSpace(c.shortname))
                    .Select(c => new
                    {
                        CompanyId = c.Customer_ID,
                        ShortName = c.shortname
                    })
                    .ToListAsync();

                _companyShortById = companyShortNames
                    .Where(x => companyIds.Contains(x.CompanyId))
                    .GroupBy(x => x.CompanyId)
                    .ToDictionary(g => g.Key, g => g.First().ShortName!);
            }

            var customerIds = _rows
                .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
                .Select(x => x.CustomerId!.Value)
                .Distinct()
                .ToHashSet();

            if (customerIds.Count == 0)
            {
                _customerNameById = new Dictionary<Guid, string>();
            }
            else
            {
                var customers = await db.Customer.AsNoTracking()
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .Select(c => new
                    {
                        CustomerId = c.Customer_ID,
                        CustomerCode = c.Customer_Code,
                        Name = c.COMPANY
                    })
                    .ToListAsync();

                _customerNameById = customers
                    .GroupBy(x => x.CustomerId)
                    .ToDictionary(
                        g => g.Key,
                        g =>
                        {
                            var c = g.First();
                            return string.IsNullOrWhiteSpace(c.CustomerCode)
                                ? (c.Name ?? string.Empty)
                                : $"{c.CustomerCode} - {c.Name}";
                        });
            }

            var sourceIdsText = _rows
                .Where(x => !string.IsNullOrWhiteSpace(x.SourceId))
                .Select(x => x.SourceId!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            if (sourceIdsText.Count == 0)
            {
                _sourceNameById = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            }
            else
            {
                var sourceVouchers = await db.AccountingVouchers.AsNoTracking()
                    .Where(v => !string.IsNullOrWhiteSpace(v.SourceId)
                             && sourceIdsText.Contains(v.SourceId))
                    .Select(v => new
                    {
                        SourceId = v.SourceId,
                        VoucherNo = v.VoucherNo,
                        Description = v.Description
                    })
                    .ToListAsync();

                _sourceNameById = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

                foreach (var v in sourceVouchers)
                {
                    if (string.IsNullOrWhiteSpace(v.SourceId))
                        continue;

                    var display = string.IsNullOrWhiteSpace(v.Description)
                        ? v.VoucherNo
                        : $"{v.VoucherNo} - {v.Description}";

                    _sourceNameById[v.SourceId.Trim()] = display;
                }

                var sourceIdsGuid = sourceIdsText
                    .Select(x => Guid.TryParse(x, out var id) ? id : Guid.Empty)
                    .Where(x => x != Guid.Empty)
                    .Distinct()
                    .ToHashSet();

                if (sourceIdsGuid.Count > 0)
                {
                    var sourceReceipts = await db.Phieuthu.AsNoTracking()
                        .Where(p => sourceIdsGuid.Contains(p.PhieuthuID))
                        .Select(p => new
                        {
                            Id = p.PhieuthuID,
                            No = p.SoPhieuthu,
                            Description = p.Noidung
                        })
                        .ToListAsync();

                    foreach (var p in sourceReceipts)
                    {
                        var key = p.Id.ToString();

                        var display = string.IsNullOrWhiteSpace(p.Description)
                            ? p.No
                            : $"{p.No} - {p.Description}";

                        _sourceNameById[key] = display;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private string GetCompanyShortName(Guid companyId)
    {
        return _companyShortById.TryGetValue(companyId, out var shortName)
            ? shortName
            : string.Empty;
    }

    private string GetCustomerName(Guid? customerId)
    {
        if (!customerId.HasValue || customerId.Value == Guid.Empty)
            return string.Empty;

        return _customerNameById.TryGetValue(customerId.Value, out var name)
            ? name
            : customerId.Value.ToString();
    }

    private string GetSourceName(string? sourceModule, string? sourceId)
    {
        if (string.IsNullOrWhiteSpace(sourceId))
            return string.Empty;

        var key = sourceId.Trim();

        return _sourceNameById.TryGetValue(key, out var name)
            ? name
            : key;
    }

    private void OnSelectedChanged(M_GeneralLedgerEntries? item) => _selected = item;

    private string RowClass(M_GeneralLedgerEntries element, int rowNumber)
        => _selected is not null && element.Id == _selected.Id ? "selected-row-blue" : string.Empty;

    private async Task OpenAddAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            Snackbar.Add(Localizer["NoPermission"], MudBlazor.Severity.Warning);
            return;
        }
        var dr = await DialogService.ShowAsync<GeneralLedgerEntry_AddEditDialog>(Localizer["GeneralLedgerEntries.Title"], new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dr.Result;
        if (!result.Canceled) await LoadAsync();
    }

    private async Task OpenEditAsync()
    {
        if (_selected is null) return;
        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            Snackbar.Add(Localizer["NoPermission"], MudBlazor.Severity.Warning);
            return;
        }
        var parameters = new DialogParameters<GeneralLedgerEntry_AddEditDialog> { { x => x.EntryId, _selected.Id } };
        var dr = await DialogService.ShowAsync<GeneralLedgerEntry_AddEditDialog>(Localizer["GeneralLedgerEntries.Title"], parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dr.Result;
        if (!result.Canceled) await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selected is null) return;
        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            Snackbar.Add(Localizer["NoPermission"], MudBlazor.Severity.Warning);
            return;
        }
        var confirm = await DialogService.ShowMessageBox(Localizer["confirm"], Localizer["askDelete"], yesText: Localizer["yes"], cancelText: Localizer["cancel"]);
        if (confirm != true) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.GeneralLedgerEntries.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (row is null)
            {
                Snackbar.Add(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                return;
            }
            db.GeneralLedgerEntries.Remove(row);
            await db.SaveChangesAsync();
            _selected = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }
}

<style>
    .selected-row-blue {
        background-color: #2196f3 !important;
        color: #fff !important;
    }

    .auto-fit-grid .mud-table-container {
        overflow-x: auto;
    }

    .auto-fit-grid .mud-table-root .mud-table {
        width: max-content !important;
        min-width: 100%;
    }

    .auto-fit-grid .mud-table-cell {
        white-space: nowrap;
    }
</style>

