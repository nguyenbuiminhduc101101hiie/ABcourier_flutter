</style>

@code {
    private const string PermissionMenuName = "account_balance";

    private bool _busy;
    private string _usr = string.Empty;
    private string _dateMode = "DATE_RANGE";
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int _fiscalYear = DateTime.Today.Year;
    private int _periodMonth = DateTime.Today.Month;
    private string _bookCode = "TAX";
    private string _accountCode = "131";
    private List<string> _accountCodes = new();

    private List<TAccountLine> _lines = new();
    private List<TAccountLine> _debitLines = new();
    private List<TAccountLine> _creditLines = new();

    private decimal _totalDebit;
    private decimal _totalCredit;
    private decimal _balance;
    private string _balanceSide = "-";
    private string _accountCodeDisplay => string.IsNullOrWhiteSpace(_accountCode) ? "ALL" : _accountCode.Trim();
    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);
    private string DateModeHelpText => IsDateMode
        ? "Đang lọc theo ngày: dùng PostingDate từ Từ ngày đến Đến ngày, không ép FiscalYear/FiscalPeriod."
        : "Đang lọc theo kỳ: dùng FiscalYear/FiscalPeriod và tự set Từ ngày - Đến ngày theo tháng.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        EnsureDateRange();
        await LoadAccountCodesAsync();
        await LoadTAccountAsync();
    }

    private async Task ResetAsync()
    {
        _dateMode = "DATE_RANGE";
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _accountCode = "131";
        _bookCode = "TAX";
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;

        EnsureDateRange();
        await LoadAccountCodesAsync();
        await LoadTAccountAsync();
    }

    private void ApplyDateMode()
    {
        if (IsPeriodMode)
            UpdateDateRangeFromPeriod();
        else
            EnsureDateRange();
    }

    private void UpdateDateRangeFromPeriod()
    {
        if (_fiscalYear < 2000 || _fiscalYear > 2100)
            _fiscalYear = DateTime.Today.Year;

        if (_periodMonth < 1 || _periodMonth > 12)
            _periodMonth = DateTime.Today.Month;

        _fromDate = new DateTime(_fiscalYear, _periodMonth, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        if (!_fromDate.HasValue)
            _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_toDate.HasValue)
            _toDate = DateTime.Today;

        if (_fromDate.Value.Date > _toDate.Value.Date)
        {
            var temp = _fromDate;
            _fromDate = _toDate;
            _toDate = temp;
        }

        _fiscalYear = _fromDate.Value.Year;
        _periodMonth = _fromDate.Value.Month;
    }


    private async Task LoadAccountCodesAsync()
    {
        try
        {
            _busy = true;
            ApplyDateMode();

            await using var db = await DbFactory.CreateDbContextAsync();

            var fromDate = _fromDate!.Value.Date;
            var toExclusive = _toDate!.Value.Date.AddDays(1);

            var ledgerQuery = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode));

            if (IsPeriodMode)
            {
                ledgerQuery = ledgerQuery.Where(x => x.FiscalYear == _fiscalYear
                                                  && x.FiscalPeriod == _periodMonth);
            }
            else
            {
                ledgerQuery = ledgerQuery.Where(x => x.PostingDate >= fromDate
                                                  && x.PostingDate < toExclusive);
            }

            if (string.Equals(_bookCode, "TAX", StringComparison.OrdinalIgnoreCase))
                ledgerQuery = ledgerQuery.Where(x => x.IsTaxBook == true);

            if (string.Equals(_bookCode, "MGMT", StringComparison.OrdinalIgnoreCase))
                ledgerQuery = ledgerQuery.Where(x => x.IsManagementBook == true);

            var ledgerAccounts = await ledgerQuery
                .Select(x => x.AccountCode!)
                .Distinct()
                .ToListAsync();

            var balanceYear = IsPeriodMode ? _fiscalYear : fromDate.Year;
            var balanceMonth = IsPeriodMode ? _periodMonth : fromDate.Month;

            var balanceQuery = db.AccountBalances.AsNoTracking()
                .Where(x => x.PeriodYear == balanceYear
                         && x.PeriodMonth == balanceMonth
                         && !string.IsNullOrWhiteSpace(x.AccountCode));

            if (!string.Equals(_bookCode, "ALL", StringComparison.OrdinalIgnoreCase))
                balanceQuery = balanceQuery.Where(x => x.BookCode == _bookCode);

            var balanceAccounts = await balanceQuery
                .Select(x => x.AccountCode!)
                .Distinct()
                .ToListAsync();

            _accountCodes = ledgerAccounts
                .Concat(balanceAccounts)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            if (_accountCodes.Count > 0 && !_accountCodes.Contains(_accountCode, StringComparer.OrdinalIgnoreCase))
                _accountCode = _accountCodes.First();

            CallSnack($"Loaded {_accountCodes.Count:N0} accounts.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }


    private async Task LoadTAccountAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_accountCode))
        {
            CallSnack("Vui lòng nhập Account Code.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            ApplyDateMode();

            await using var db = await DbFactory.CreateDbContextAsync();

            var accountCode = _accountCode.Trim();
            var fromDate = _fromDate!.Value.Date;
            var toExclusive = _toDate!.Value.Date.AddDays(1);

            var query = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.AccountCode == accountCode);

            if (IsPeriodMode)
            {
                query = query.Where(x => x.FiscalYear == _fiscalYear
                                      && x.FiscalPeriod == _periodMonth);
            }
            else
            {
                query = query.Where(x => x.PostingDate >= fromDate
                                      && x.PostingDate < toExclusive);
            }

            if (string.Equals(_bookCode, "TAX", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsTaxBook == true);

            if (string.Equals(_bookCode, "MGMT", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsManagementBook == true);

            var data = await query
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .Select(x => new TAccountLine
                {
                    Id = x.Id,
                    BookCode =
                        x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" :
                        x.IsTaxBook == true ? "TAX" :
                        x.IsManagementBook == true ? "MGMT" :
                        "",
                    PostingDate = x.PostingDate,
                    VoucherNo = x.VoucherNo ?? string.Empty,
                    AccountCode = x.AccountCode ?? string.Empty,
                    SoHD = x.SoHD ?? string.Empty,
                    Description = x.Description ?? string.Empty,
                    Debit = x.Debit,
                    Credit = x.Credit
                })
                .ToListAsync();

            var openingBalance = await LoadOpeningBalanceAsync(db, fromDate, accountCode);

            if (openingBalance != 0)
            {
                var openingLine = new TAccountLine
                {
                    Id = Guid.NewGuid(),
                    BookCode = _bookCode,
                    PostingDate = fromDate,
                    VoucherNo = "OPENING",
                    AccountCode = accountCode,
                    Description = IsDateMode ? "Số dư đầu ngày" : "Số dư đầu kỳ",
                    Debit = openingBalance > 0 ? openingBalance : 0,
                    Credit = openingBalance < 0 ? Math.Abs(openingBalance) : 0
                };

                data.Insert(0, openingLine);
            }

            _lines = data;
            _debitLines = data.Where(x => x.Debit > 0).ToList();
            _creditLines = data.Where(x => x.Credit > 0).ToList();

            _totalDebit = data.Sum(x => x.Debit);
            _totalCredit = data.Sum(x => x.Credit);
            _balance = _totalDebit - _totalCredit;

            _balanceSide = _balance switch
            {
                > 0 => "Nợ",
                < 0 => "Có",
                _ => "Cân"
            };

            CallSnack($"Loaded {_lines.Count:N0} ledger lines.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<decimal> LoadOpeningBalanceAsync(AppDbContext db, DateTime fromDate, string accountCode)
    {
        var balanceYear = IsPeriodMode ? _fiscalYear : fromDate.Year;
        var balanceMonth = IsPeriodMode ? _periodMonth : fromDate.Month;

        var balanceQuery = db.AccountBalances.AsNoTracking()
            .Where(x => x.PeriodYear == balanceYear
                     && x.PeriodMonth == balanceMonth
                     && x.AccountCode == accountCode);

        if (!string.Equals(_bookCode, "ALL", StringComparison.OrdinalIgnoreCase))
            balanceQuery = balanceQuery.Where(x => x.BookCode == _bookCode);

        var openingBalance = await balanceQuery
            .Select(x => (decimal?)x.OpeningBalance)
            .SumAsync() ?? 0;

        if (IsDateMode)
        {
            var periodStart = new DateTime(fromDate.Year, fromDate.Month, 1);

            if (fromDate.Date > periodStart)
            {
                var priorQuery = db.GeneralLedgerEntries.AsNoTracking()
                    .Where(x => x.AccountCode == accountCode
                             && x.PostingDate >= periodStart
                             && x.PostingDate < fromDate.Date);

                if (string.Equals(_bookCode, "TAX", StringComparison.OrdinalIgnoreCase))
                    priorQuery = priorQuery.Where(x => x.IsTaxBook == true);

                if (string.Equals(_bookCode, "MGMT", StringComparison.OrdinalIgnoreCase))
                    priorQuery = priorQuery.Where(x => x.IsManagementBook == true);

                var priorMovement = await priorQuery
                    .Select(x => (decimal?)(x.Debit - x.Credit))
                    .SumAsync() ?? 0;

                openingBalance += priorMovement;
            }
        }

        return openingBalance;
    }


    private sealed class TAccountLine
    {
        public Guid Id { get; set; }
        public string BookCode { get; set; } = string.Empty;
        public DateTime PostingDate { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public string AccountCode { get; set; } = string.Empty;
        public string SoHD { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
