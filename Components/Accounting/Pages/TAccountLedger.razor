            white-space: nowrap;
        }

        .t-row small {
            display: block;
            color: #718096;
            margin-top: 1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

    .amount {
        text-align: right;
        font-weight: 700;
        font-family: Consolas, monospace;
        white-space: nowrap;
    }

    .empty-side {
        color: #718096;
        font-style: italic;
        text-align: center;
        padding: 28px 0;
    }

    .t-account-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #d7dde8;
        background: #f8fafc;
        font-weight: 700;
    }

        .t-account-footer div {
            padding: 6px 10px;
