@page "/accounting/t-account"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>T-Account Ledger</PageTitle>

<div class="product-price-page t-account-compact-page">
    <PpScreenHeader Title="10.13.3 T-Account Ledger" Subtitle="Sổ cái chữ T lấy chi tiết từ General Ledger" />

    <MudPaper Class="product-price-card compact-filter-card pa-2 mb-1" Elevation="0">
        <MudGrid Spacing="1" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="1">
                <MudSelect T="string"
                           @bind-Value="_dateMode"
                           Label="Chọn theo"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Theo ngày</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int" @bind-Value="_fiscalYear" Label="Year" Min="2000" Max="2100" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDateMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int" @bind-Value="_periodMonth" Label="Month" Min="1" Max="12" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsDateMode" />
            </MudItem>

            <MudItem xs="12" sm="1">
                <MudSelect T="string" @bind-Value="_bookCode" Label="Book" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           @bind-Value="_accountCode"
                           Label="Account Code"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Class="account-code-select"
                           Style="width:100%;">
                    @foreach (var acc in _accountCodes)
                    {
                        <MudSelectItem T="string" Value="@acc">@acc</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2" Class="d-flex align-center ga-1 compact-action-wrap">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FormatListBulleted"
                           Disabled="_busy"
                           OnClick="LoadAccountCodesAsync">
                    Accounts
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search"
                           Disabled="_busy"
                           OnClick="LoadTAccountAsync">
                    Load
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="_busy"
                           OnClick="ResetAsync">
                    Reset
                </MudButton>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="compact-help-text">
            @DateModeHelpText
        </MudText>
    </MudPaper>

    <MudPaper Class="compact-stats-card pa-1 mb-1" Elevation="0" Outlined="true">
        <MudGrid Spacing="1">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-1 text-center compact-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Debit</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_totalDebit.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-1 text-center compact-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Credit</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_totalCredit.ToString("N0")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-1 text-center compact-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Balance</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@Math.Abs(_balance).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-1 text-center compact-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Balance Side</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_balanceSide</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="compact-t-card pa-2 mb-1" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-1 fw-bold">
            TK @_accountCodeDisplay - Sổ cái chữ T
        </MudText>

        <div class="t-account-wrap">
            <div class="t-account-title">
                <span>NỢ</span>
                <span>CÓ</span>
            </div>

            <div class="t-account-body">
                <div class="t-account-side debit-side">
                    @if (_debitLines.Count == 0)
                    {
                        <div class="empty-side">Không có phát sinh Nợ</div>
                    }
                    else
                    {
                        @foreach (var item in _debitLines)
                        {
                            <div class="t-row">
                                <div>
                                    <b>@item.PostingDate.ToString("dd/MM/yyyy")</b>
                                    <span>@item.VoucherNo</span>
                                    @if (!string.IsNullOrWhiteSpace(item.SoHD))
                                    {
                                        <span>HĐ @item.SoHD</span>
                                    }
                                    <small>@item.Description</small>
                                </div>
                                <div class="amount">@item.Debit.ToString("N0")</div>
                            </div>
                        }
                    }
                </div>

                <div class="t-account-side credit-side">
                    @if (_creditLines.Count == 0)
                    {
                        <div class="empty-side">Không có phát sinh Có</div>
                    }
                    else
                    {
                        @foreach (var item in _creditLines)
                        {
                            <div class="t-row">
                                <div>
                                    <b>@item.PostingDate.ToString("dd/MM/yyyy")</b>
                                    <span>@item.VoucherNo</span>
                                    @if (!string.IsNullOrWhiteSpace(item.SoHD))
                                    {
                                        <span>HĐ @item.SoHD</span>
                                    }
                                    <small>@item.Description</small>
                                </div>
                                <div class="amount">@item.Credit.ToString("N0")</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="t-account-footer">
                <div>Tổng Nợ: @_totalDebit.ToString("N0")</div>
                <div>Tổng Có: @_totalCredit.ToString("N0")</div>
            </div>

            <div class="t-account-balance">
                Số dư cuối kỳ: @Math.Abs(_balance).ToString("N0") @_balanceSide
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="compact-detail-card pa-2" Elevation="0" Outlined="true">
        <MudText Typo="Typo.subtitle2" Class="mb-1 fw-bold">Chi tiết General Ledger</MudText>

        <MudDataGrid T="TAccountLine"
                     Items="_lines"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     Height="calc(100vh - 500px)"
                     FixedHeader="true"
                     Loading="_busy"
                     Class="compact-ledger-grid">
            <Columns>
                <PropertyColumn Property="x => x.BookCode" Title="Book" />
                <PropertyColumn Property="x => x.PostingDate" Title="Posting Date" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="Voucher No" />
                <PropertyColumn Property="x => x.AccountCode" Title="Account" />
                <PropertyColumn Property="x => x.SoHD" Title="Số HĐ" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.Debit" Title="Debit" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Credit" Title="Credit" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="TAccountLine" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

<style>

    .t-account-compact-page {
        background: #f8fafc;
    }

        .t-account-compact-page .product-price-card,
        .t-account-compact-page .compact-stats-card,
        .t-account-compact-page .compact-t-card,
        .t-account-compact-page .compact-detail-card {
            border-radius: 10px;
            border-color: #dbeafe;
        }

    .compact-filter-card {
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .t-account-compact-page .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .t-account-compact-page .mud-input,
    .t-account-compact-page .mud-select,
    .t-account-compact-page .mud-picker-input-button {
        font-size: 12px !important;
    }

    .t-account-compact-page .mud-button-root {
        min-height: 30px !important;
        padding: 4px 8px !important;
        font-size: 11px !important;
        white-space: nowrap;
    }

    .compact-action-wrap {
        gap: 4px !important;
        flex-wrap: nowrap !important;
    }

    .compact-help-text {
        display: block;
        margin-top: 2px;
        font-size: 11px;
        line-height: 1.1;
    }

    .compact-stat {
        min-height: 44px;
        border-radius: 8px;
        background: #ffffff;
    }

        .compact-stat .mud-typography-caption {
            font-size: 11px;
            line-height: 1.1;
        }

        .compact-stat .mud-typography-subtitle2 {
            font-size: 13px;
            line-height: 1.2;
        }

    .t-account-wrap {
        border: 1px solid #d7dde8;
        border-radius: 12px;
        overflow: hidden;
        background: white;
    }

    .t-account-title {
        display: grid;
        grid-template-columns: 1fr 1fr;
        background: linear-gradient(90deg, #087f8c, #2868d8);
        color: white;
        font-weight: 700;
        text-align: center;
    }

        .t-account-title span {
            padding: 6px 10px;
            font-size: 12px;
        }

            .t-account-title span:first-child {
                border-right: 2px solid white;
            }

    .t-account-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
