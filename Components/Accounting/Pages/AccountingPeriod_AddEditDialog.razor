@using MudBlazor
@using ABFreight.Models
@using Microsoft.Extensions.Localization
@using ABFreight.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudNumericField T="int"
                                     @bind-Value="_model.PeriodCode"
                                     Label="@Localizer["AccountingPeriod.PeriodCode"]"
                                     HelperText="@Localizer["AccountingPeriod.PeriodCodeAutoGenerated"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.FiscalYear" Label="@Localizer["AccountingPeriod.FiscalYear"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="3000" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.PeriodMonth" Label="@Localizer["AccountingPeriod.PeriodMonth"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_model.Status" Label="@Localizer["AccountingPeriod.Status"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        <MudSelectItem Value="@("OPEN")">@Localizer["AccountingPeriod.Status.Open"]</MudSelectItem>
                        <MudSelectItem Value="@("CLOSED")">@Localizer["AccountingPeriod.Status.Closed"]</MudSelectItem>
                        <MudSelectItem Value="@("LOCKED")">@Localizer["AccountingPeriod.Status.Locked"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_startDate" Label="@Localizer["AccountingPeriod.StartDate"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_endDate" Label="@Localizer["AccountingPeriod.EndDate"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" @bind-Value="_model.IsClosed" Label="@Localizer["AccountingPeriod.IsClosed"]" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_AccountingPeriod Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm? _form;
    private M_AccountingPeriod _model = new();
    private DateTime? _startDate;
    private DateTime? _endDate;

    protected override void OnParametersSet()
    {
        var now = DateTime.Now;
        _model = new M_AccountingPeriod
        {
            PeriodId = Model.PeriodId,
            FiscalYear = Model.FiscalYear == 0 ? now.Year : Model.FiscalYear,
            PeriodMonth = Model.PeriodMonth == 0 ? now.Month : Model.PeriodMonth,
            PeriodCode = Model.PeriodCode,
            StartDate = Model.StartDate == default ? new DateTime(now.Year, now.Month, 1) : Model.StartDate,
            EndDate = Model.EndDate == default ? new DateTime(now.Year, now.Month, DateTime.DaysInMonth(now.Year, now.Month)) : Model.EndDate,
            Status = string.IsNullOrWhiteSpace(Model.Status) ? "OPEN" : Model.Status,
            IsClosed = Model.IsClosed,
            CreatedAt = Model.CreatedAt,
            UpdatedAt = Model.UpdatedAt
        };

        _startDate = _model.StartDate;
        _endDate = _model.EndDate;
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();

        if (_startDate is null || _endDate is null)
            return;
        if (_model.FiscalYear < 2000 || _model.PeriodMonth < 1 || _model.PeriodMonth > 12)
            return;
        if (_startDate.Value.Date > _endDate.Value.Date)
            return;
        if (string.IsNullOrWhiteSpace(_model.Status))
            return;

        _model.StartDate = _startDate.Value.Date;
        _model.EndDate = _endDate.Value.Date;
        _model.Status = _model.Status.Trim().ToUpperInvariant();
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
