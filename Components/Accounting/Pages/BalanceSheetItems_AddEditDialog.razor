@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Models
@using ABFreight.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ItemCode"
                                  Label="@Localizer["BalanceSheetItems.ItemCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  Disabled="IsEdit" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ItemName"
                                  Label="@Localizer["BalanceSheetItems.ItemName"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_parentBinding"
                                  Label="@Localizer["BalanceSheetItems.ParentItemCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Section"
                                  Label="@Localizer["BalanceSheetItems.Section"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.LevelNo"
                                     Label="@Localizer["BalanceSheetItems.LevelNo"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.SortOrder"
                                     Label="@Localizer["BalanceSheetItems.SortOrder"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex flex-column justify-center">
                    <MudCheckBox T="bool" @bind-Value="_model.IsBold" Label="@Localizer["BalanceSheetItems.IsBold"]" />
                    <MudCheckBox T="bool" @bind-Value="_model.IsTotal" Label="@Localizer["BalanceSheetItems.IsTotal"]" />
                    <MudCheckBox T="bool" @bind-Value="_model.IsActive" Label="@Localizer["BalanceSheetItems.IsActive"]" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_BalanceSheetItems Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm? _form;
    private M_BalanceSheetItems _model = new();
    private string _parentBinding = string.Empty;

    protected override void OnParametersSet()
    {
        _model = new M_BalanceSheetItems
        {
            Id = Model.Id,
            ItemCode = Model.ItemCode ?? string.Empty,
            ItemName = Model.ItemName ?? string.Empty,
            ParentItemCode = Model.ParentItemCode,
            Section = Model.Section ?? string.Empty,
            LevelNo = Model.LevelNo,
            SortOrder = Model.SortOrder,
            IsBold = Model.IsBold,
            IsTotal = Model.IsTotal,
            IsActive = Model.IsActive,
            CreatedDate = Model.CreatedDate
        };
        _parentBinding = Model.ParentItemCode ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();

        if (string.IsNullOrWhiteSpace(_model.ItemCode) ||
            string.IsNullOrWhiteSpace(_model.ItemName) ||
            string.IsNullOrWhiteSpace(_model.Section))
            return;

        _model.ItemCode = _model.ItemCode.Trim();
        _model.ItemName = _model.ItemName.Trim();
        _model.Section = _model.Section.Trim();
        _model.ParentItemCode = string.IsNullOrWhiteSpace(_parentBinding) ? null : _parentBinding.Trim();

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
