    private static string GetRootMessage(Exception ex)
    {
        var e = ex;
        while (e.InnerException != null)
            e = e.InnerException;
        return e.Message;
    }

    private sealed class LedgerMiniRow
    {
        public Guid Id { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public string VoucherKey { get; set; } = string.Empty;
        public DateTime PostingDate { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string Book { get; set; } = string.Empty;
        public string SourceModule { get; set; } = string.Empty;
    }

    private sealed class CashFlowRow
    {
        public Guid Id { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime PostingDate { get; set; }
        public string CashAccount { get; set; } = string.Empty;
        public string CashAccountName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string SourceModule { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public decimal Amount { get; set; }
        public string Direction { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public string CounterpartSummary { get; set; } = string.Empty;
        public string Explanation { get; set; } = string.Empty;
    }

    private sealed class CashAccountSummary
    {
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public decimal Opening { get; set; }
        public decimal Inflow { get; set; }
        public decimal Outflow { get; set; }
        public decimal Closing { get; set; }
    }

    private sealed class CategoryCashRow
    {
        public string Category { get; set; } = string.Empty;
        public decimal Inflow { get; set; }
        public decimal Outflow { get; set; }
        public decimal Net => Inflow - Outflow;
    }
}

