    private LedgerMiniRow NewLedgerSim(string voucherNo, string module, string description, string accountCode, decimal debit, decimal credit)
    {
        return new LedgerMiniRow
        {
            Id = Guid.NewGuid(),
            VoucherNo = voucherNo,
            VoucherKey = BuildVoucherKey(voucherNo, DateTime.Today),
            PostingDate = DateTime.Today,
            AccountCode = accountCode,
            Description = description,
            Debit = debit,
            Credit = credit,
            Book = "TAX",
            SourceModule = module
        };
    }

    private void BuildCashRows()
    {
        _cashRows.Clear();

        foreach (var cashLine in _allLedgerRows.Where(x => IsCashAccount(x.AccountCode) && (x.Debit != 0 || x.Credit != 0)))
        {
            var counterparts = _allLedgerRows
                .Where(x => x.VoucherKey == cashLine.VoucherKey && x.Id != cashLine.Id)
                .OrderByDescending(x => x.Debit + x.Credit)
                .ToList();

            var direction = cashLine.Debit > 0 ? "IN" : "OUT";
            var category = ClassifyCashFlow(cashLine, counterparts, direction);

            if (IsInternalTransfer(cashLine, counterparts))
            {
                category = "Chuyển quỹ nội bộ";
                direction = cashLine.Debit > 0 ? "IN" : "TRANSFER";
            }

            _cashRows.Add(new CashFlowRow
            {
                Id = cashLine.Id,
                VoucherNo = cashLine.VoucherNo,
                PostingDate = cashLine.PostingDate,
                CashAccount = cashLine.AccountCode,
                CashAccountName = AccountName(cashLine.AccountCode),
                Description = cashLine.Description,
                SourceModule = cashLine.SourceModule,
                Debit = cashLine.Debit,
                Credit = cashLine.Credit,
                Amount = Math.Abs(cashLine.Debit > 0 ? cashLine.Debit : cashLine.Credit),
                Direction = direction,
                Category = category,
                CounterpartSummary = BuildCounterpartSummary(counterparts),
                Explanation = BuildExplanation(cashLine, counterparts, direction, category)
            });
        }

        BuildAccountSummaries();
    }

    private void BuildAccountSummaries()
    {
        var accounts = _openingByAccount.Keys
            .Concat(_cashRows.Select(x => x.CashAccount))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        _accountSummaries = accounts.Select(acc =>
        {
            var opening = GetOpening(acc);
            var inflow = _cashRows.Where(x => x.CashAccount.Equals(acc, StringComparison.OrdinalIgnoreCase) && x.Direction == "IN").Sum(x => x.Amount);
            var outflow = _cashRows.Where(x => x.CashAccount.Equals(acc, StringComparison.OrdinalIgnoreCase) && (x.Direction == "OUT" || x.Direction == "TRANSFER")).Sum(x => x.Amount);

            return new CashAccountSummary
            {
                AccountCode = acc,
                AccountName = AccountName(acc),
                Opening = opening,
                Inflow = inflow,
                Outflow = outflow,
                Closing = opening + inflow - outflow
            };
        }).ToList();
    }

    private decimal GetOpening(string accountCode)
    {
        return _openingByAccount.TryGetValue(accountCode, out var value) ? value : 0;
    }

    private bool IsCashAccount(string accountCode)
    {
        if (string.IsNullOrWhiteSpace(accountCode))
            return false;

        var prefixes = CashPrefixes();
        return prefixes.Any(p => accountCode.Trim().StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    private List<string> CashPrefixes()
    {
        var raw = string.IsNullOrWhiteSpace(_cashAccountFilter) ? "111,112" : _cashAccountFilter;
        return raw.Split(new[] { ',', ';', ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static bool IsAccount(string accountCode, string prefix) =>
        !string.IsNullOrWhiteSpace(accountCode) && accountCode.Trim().StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private bool IsInternalTransfer(LedgerMiniRow cashLine, List<LedgerMiniRow> counterparts) =>
        counterparts.Any(x => IsCashAccount(x.AccountCode));

    private string ClassifyCashFlow(LedgerMiniRow cashLine, List<LedgerMiniRow> counterparts, string direction)
    {
        var accounts = counterparts.Select(x => x.AccountCode).ToList();
        var module = cashLine.SourceModule ?? string.Empty;

        if (direction == "IN")
        {
            if (accounts.Any(x => IsAccount(x, "131")) || module.Contains("RECEIVE_AR", StringComparison.OrdinalIgnoreCase) || module.Contains("CUSTOMER_RECEIPT", StringComparison.OrdinalIgnoreCase))
                return "Thu khách hàng";
            if (accounts.Any(x => IsAccount(x, "3387")) || module.Contains("ADVANCE", StringComparison.OrdinalIgnoreCase))
                return "Khách trả trước";
            if (accounts.Any(x => IsAccount(x, "341")))
                return "Nhận tiền vay";
            if (accounts.Any(x => IsAccount(x, "411")))
                return "Góp vốn";
            if (accounts.Any(x => IsAccount(x, "511") || IsAccount(x, "711")))
                return "Doanh thu thu ngay";
            return "Tiền vào khác";
        }

        if (accounts.Any(x => IsAccount(x, "331")) || module.Contains("PAY_SUPPLIER", StringComparison.OrdinalIgnoreCase))
            return "Trả nhà cung cấp";
        if (accounts.Any(x => IsAccount(x, "334")) || module.Contains("SALARY", StringComparison.OrdinalIgnoreCase))
            return "Trả lương";
        if (accounts.Any(x => IsAccount(x, "333")) || module.Contains("VAT", StringComparison.OrdinalIgnoreCase) || module.Contains("CIT", StringComparison.OrdinalIgnoreCase))
            return "Nộp thuế";
        if (accounts.Any(x => IsAccount(x, "632") || IsAccount(x, "642") || IsAccount(x, "635")))
            return "Chi phí vận hành";
        if (accounts.Any(x => IsAccount(x, "141")))
            return "Tạm ứng nhân viên";
        if (accounts.Any(x => IsAccount(x, "242")))
            return "Chi phí trả trước";

        return "Tiền ra khác";
    }

    private string BuildCounterpartSummary(List<LedgerMiniRow> counterparts)
    {
        if (counterparts.Count == 0)
            return "Không có đối ứng trong cùng voucher";

        return string.Join("; ", counterparts
            .GroupBy(x => x.AccountCode)
            .Select(g =>
            {
                var debit = g.Sum(x => x.Debit);
                var credit = g.Sum(x => x.Credit);
                var amount = debit > 0 ? debit : credit;
                var side = debit > 0 ? "Nợ" : "Có";
                return $"{side} {g.Key}: {amount:N0}";
            }));
    }

    private string BuildExplanation(LedgerMiniRow cashLine, List<LedgerMiniRow> counterparts, string direction, string category)
    {
        var cashSide = direction == "IN" ? $"Nợ {cashLine.AccountCode}" : $"Có {cashLine.AccountCode}";
        var cashMeaning = direction == "IN" ? "tiền tăng" : "tiền giảm";
        return $"{cashSide} nghĩa là {cashMeaning}. Nhóm: {category}. Đối ứng: {BuildCounterpartSummary(counterparts)}.";
    }

    private string AccountName(string accountCode)
    {
        if (_accountNames.TryGetValue(accountCode, out var name))
            return name;

        if (accountCode.StartsWith("111")) return "Tiền mặt";
        if (accountCode.StartsWith("112")) return "Tiền gửi ngân hàng";
        if (accountCode.StartsWith("113")) return "Tiền đang chuyển";
        return accountCode;
    }

    private static string BuildVoucherKey(string? voucherNo, DateTime postingDate)
    {
        var v = string.IsNullOrWhiteSpace(voucherNo) ? "NO-VOUCHER" : voucherNo.Trim();
        return $"{v}|{postingDate:yyyyMMdd}";
    }

    private Color DirectionColor(string direction) => direction switch
    {
        "IN" => Color.Success,
        "OUT" => Color.Warning,
        "TRANSFER" => Color.Info,
        _ => Color.Default
    };

    private string DirectionText(string direction) => direction switch
    {
        "IN" => "Tiền vào",
        "OUT" => "Tiền ra",
        "TRANSFER" => "Chuyển quỹ",
        _ => direction
    };

    private async Task ResetAsync()
    {
        _usingSimulator = false;
        _dateMode = "PERIOD";
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "TAX";
        _cashAccountFilter = "111,112";
        _search = string.Empty;
        _directionFilter = "ALL";
        _categoryFilter = "ALL";
        UpdateDateRange();
        await LoadAsync();
    }

