@page "/accounting/cash-flow-t"
@page "/CashFlowT"
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>10.16 Theo dõi dòng tiền theo T</PageTitle>

<div class="product-price-page cash-flow-t-page">
    <PpScreenHeader Title="10.16 Theo dõi dòng tiền theo T"
                    Subtitle="Theo dõi tiền vào / tiền ra từ voucher → sổ cái → tài khoản tiền 111/112 → số dư cuối kỳ">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_busy">
                    Load
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayCircle" OnClick="LoadSimulatorAsync" Disabled="_busy">
                    Simulator
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.MenuBook" OnClick="OpenGeneralLedgerSummary" Disabled="_busy">
                    10.6.1 Sổ cái
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TableChart" OnClick="OpenAccountBalanceSnapshot" Disabled="_busy">
                    10.9.1 Balance
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintAsync" Disabled="_busy">
                    Print / PDF
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAsync" Disabled="_busy">
                    Reset
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="cash-filter-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="Chọn theo" Value="@_dateMode" ValueChanged="OnDateModeChanged"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Từ ngày - đến ngày</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Year" Value="_fiscalYear" ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Month" Value="_periodMonth" ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày" @bind-Date="_fromDate"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày" @bind-Date="_toDate"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudSelect T="string" Label="Book" @bind-Value="_book"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudTextField @bind-Value="_cashAccountFilter" Label="TK tiền"
                              Placeholder="111,112"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_search" Label="Search"
                              Placeholder="Voucher, HBL, mô tả, đối ứng..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="Dòng tiền" @bind-Value="_directionFilter"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    <MudSelectItem T="string" Value="@("IN")">Tiền vào</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OUT")">Tiền ra</MudSelectItem>
                    <MudSelectItem T="string" Value="@("TRANSFER")">Chuyển quỹ nội bộ</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" Label="Nhóm nghiệp vụ" @bind-Value="_categoryFilter"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    @foreach (var category in CategoryOptions)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="7">
                <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="cash-help-alert">
                    TK tiền là tài sản: <b>Nợ 111/112 = tiền vào</b>, <b>Có 111/112 = tiền ra</b>. Mỗi dòng tiền được nối với tài khoản đối ứng trong cùng voucher để biết tiền đến từ đâu và đi đâu.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <div id="cashFlowPrintArea">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="cash-stat-card opening-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="cash-stat-icon" />
                    <MudText Typo="Typo.caption">Số dư đầu kỳ</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@OpeningCash.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">111/112 trước kỳ đang xem</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="cash-stat-card in-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.SouthWest" Class="cash-stat-icon" />
                    <MudText Typo="Typo.caption">Tiền vào</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@PeriodCashIn.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Nợ 111/112 trong kỳ</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="cash-stat-card out-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.NorthEast" Class="cash-stat-icon" />
                    <MudText Typo="Typo.caption">Tiền ra</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@PeriodCashOut.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Có 111/112 trong kỳ</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="cash-stat-card closing-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Class="cash-stat-icon" />
                    <MudText Typo="Typo.caption">Số dư cuối kỳ</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@ClosingCash.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="@((PeriodNetCash >= 0) ? Color.Success : Color.Error)">
                        Net cash: @PeriodNetCash.ToString("N0")
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="cash-cycle-card pa-3 mb-2" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Chu trình dòng tiền logistics</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Theo dõi từ phát sinh công nợ → thu/chi tiền → số dư tiền cuối kỳ.</MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Color="@(_usingSimulator ? Color.Secondary : Color.Primary)" Variant="Variant.Filled">
                    @(_usingSimulator ? "Simulator" : "GeneralLedgerEntries")
                </MudChip>
            </MudStack>

            <div class="cash-cycle-line">
                <div class="cash-step">
                    <span class="step-no">1</span>
                    <div class="step-title">Xuất hóa đơn / AR</div>
                    <div class="step-value">@ExpectedCustomerIn.ToString("N0")</div>
                    <div class="step-note">Nợ 131: khách còn phải trả</div>
                </div>
                <div class="step-arrow">→</div>
                <div class="cash-step success">
                    <span class="step-no">2</span>
                    <div class="step-title">Thu tiền khách</div>
                    <div class="step-value">@CashFromCustomers.ToString("N0")</div>
                    <div class="step-note">Nợ 111/112 / Có 131</div>
                </div>
                <div class="step-arrow">→</div>
                <div class="cash-step warning">
                    <span class="step-no">3</span>
                    <div class="step-title">Ghi nhận AP vendor</div>
                    <div class="step-value">@ExpectedVendorOut.ToString("N0")</div>
                    <div class="step-note">Có 331: còn phải trả</div>
                </div>
                <div class="step-arrow">→</div>
                <div class="cash-step danger">
                    <span class="step-no">4</span>
                    <div class="step-title">Trả vendor / chi phí</div>
                    <div class="step-value">@CashPaidVendors.ToString("N0")</div>
                    <div class="step-note">Nợ 331 / Có 111/112</div>
                </div>
                <div class="step-arrow">→</div>
                <div class="cash-step final">
                    <span class="step-no">5</span>
                    <div class="step-title">Cash cuối kỳ</div>
                    <div class="step-value">@ClosingCash.ToString("N0")</div>
                    <div class="step-note">Đầu kỳ + vào - ra</div>
                </div>
            </div>
        </MudPaper>

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="7">
                <MudPaper Class="cash-t-card pa-3" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Sổ cái chữ T cho dòng tiền 111/112</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Bên Nợ là tiền vào, bên Có là tiền ra.</MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @_cashRows.Count.ToString("N0") dòng tiền
                        </MudChip>
                    </MudStack>

                    <div class="t-ledger">
                        <div class="t-title">TK tiền 111/112</div>
                        <div class="t-side debit-side">
                            <div class="side-head">NỢ - TIỀN VÀO</div>
                            @foreach (var row in VisibleCashRows.Where(x => x.Direction == "IN").Take(18))
                            {
                                <div class="t-line">
                                    <span>@row.PostingDate.ToString("dd/MM") · @row.VoucherNo</span>
                                    <b>@row.Amount.ToString("N0")</b>
                                    <small>@row.CounterpartSummary</small>
                                </div>
                            }
                            @if (!VisibleCashRows.Any(x => x.Direction == "IN"))
                            {
                                <div class="empty-line">Không có tiền vào.</div>
                            }
                        </div>
                        <div class="t-side credit-side">
                            <div class="side-head">CÓ - TIỀN RA</div>
                            @foreach (var row in VisibleCashRows.Where(x => x.Direction == "OUT" || x.Direction == "TRANSFER").Take(18))
                            {
                                <div class="t-line">
                                    <span>@row.PostingDate.ToString("dd/MM") · @row.VoucherNo</span>
                                    <b>@row.Amount.ToString("N0")</b>
                                    <small>@row.CounterpartSummary</small>
                                </div>
                            }
                            @if (!VisibleCashRows.Any(x => x.Direction == "OUT" || x.Direction == "TRANSFER"))
                            {
                                <div class="empty-line">Không có tiền ra.</div>
                            }
                        </div>
                        <div class="t-total debit-total">@VisibleCashRows.Where(x => x.Direction == "IN").Sum(x => x.Amount).ToString("N0")</div>
                        <div class="t-total credit-total">@VisibleCashRows.Where(x => x.Direction == "OUT" || x.Direction == "TRANSFER").Sum(x => x.Amount).ToString("N0")</div>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudPaper Class="cash-summary-card pa-3" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Tổng hợp theo nhóm dòng tiền</MudText>
                    <MudTable Items="CategoryRows" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Nhóm</MudTh>
                            <MudTh Class="text-end">Tiền vào</MudTh>
                            <MudTh Class="text-end">Tiền ra</MudTh>
                            <MudTh Class="text-end">Net</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="cat">
                            <MudTd DataLabel="Nhóm">@cat.Category</MudTd>
                            <MudTd DataLabel="Tiền vào" Class="text-end">@cat.Inflow.ToString("N0")</MudTd>
                            <MudTd DataLabel="Tiền ra" Class="text-end">@cat.Outflow.ToString("N0")</MudTd>
                            <MudTd DataLabel="Net" Class="text-end fw-bold">@cat.Net.ToString("N0")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="5">
                <MudPaper Class="cash-summary-card pa-3" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Số dư theo từng tài khoản tiền</MudText>
                    <MudTable Items="_accountSummaries" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>TK</MudTh>
                            <MudTh>Tên</MudTh>
                            <MudTh Class="text-end">Đầu kỳ</MudTh>
                            <MudTh Class="text-end">Vào</MudTh>
                            <MudTh Class="text-end">Ra</MudTh>
                            <MudTh Class="text-end">Cuối kỳ</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="acc">
                            <MudTd DataLabel="TK">@acc.AccountCode</MudTd>
                            <MudTd DataLabel="Tên">@acc.AccountName</MudTd>
                            <MudTd DataLabel="Đầu kỳ" Class="text-end">@acc.Opening.ToString("N0")</MudTd>
                            <MudTd DataLabel="Vào" Class="text-end">@acc.Inflow.ToString("N0")</MudTd>
                            <MudTd DataLabel="Ra" Class="text-end">@acc.Outflow.ToString("N0")</MudTd>
                            <MudTd DataLabel="Cuối kỳ" Class="text-end fw-bold">@acc.Closing.ToString("N0")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudPaper Class="cash-summary-card pa-3" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Giải thích nguyên tắc chữ T</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudAlert Severity="MudBlazor.Severity.Success" Dense="true">
                                <b>Nợ 111/112</b> = tiền tăng. Ví dụ: thu khách hàng, nhận tạm ứng, nhận vốn góp, nhận tiền vay, rút tiền về quỹ.
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">
                                <b>Có 111/112</b> = tiền giảm. Ví dụ: trả vendor, trả lương, nộp thuế, chi phí ngân hàng, chi phí văn phòng.
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12">
                            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                                Công thức dòng tiền: <b>Cash cuối kỳ = Cash đầu kỳ + Nợ 111/112 - Có 111/112</b>. Đối ứng 131/331 cho biết đang thu khách hay trả nhà cung cấp.
                            </MudAlert>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="cash-detail-card pa-3" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Chi tiết dòng tiền theo voucher</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Mỗi dòng là một phát sinh Nợ/Có của tài khoản tiền, nối với tài khoản đối ứng trong cùng voucher.</MudText>
                </MudStack>
                @if (_busy)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                }
            </MudStack>

            <MudTable Items="VisibleCashRows" Dense="true" Hover="true" Striped="true" Bordered="true" FixedHeader="true" Height="420px" Elevation="0">
                <HeaderContent>
                    <MudTh>Ngày</MudTh>
                    <MudTh>Voucher</MudTh>
                    <MudTh>TK tiền</MudTh>
                    <MudTh>Dòng tiền</MudTh>
                    <MudTh Class="text-end">Tiền vào</MudTh>
                    <MudTh Class="text-end">Tiền ra</MudTh>
                    <MudTh>Đối ứng</MudTh>
                    <MudTh>Nhóm</MudTh>
                    <MudTh>Diễn giải</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Ngày">@row.PostingDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Voucher">@row.VoucherNo</MudTd>
                    <MudTd DataLabel="TK tiền">@row.CashAccount</MudTd>
                    <MudTd DataLabel="Dòng tiền">
                        <MudChip T="string" Size="Size.Small" Color="@DirectionColor(row.Direction)" Variant="Variant.Filled">
                            @DirectionText(row.Direction)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Tiền vào" Class="text-end">@(row.Direction == "IN" ? row.Amount.ToString("N0") : "")</MudTd>
                    <MudTd DataLabel="Tiền ra" Class="text-end">@(row.Direction != "IN" ? row.Amount.ToString("N0") : "")</MudTd>
                    <MudTd DataLabel="Đối ứng">@row.CounterpartSummary</MudTd>
                    <MudTd DataLabel="Nhóm">@row.Category</MudTd>
                    <MudTd DataLabel="Diễn giải">@row.Explanation</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";

    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private bool _busy;
    private bool _usingSimulator;
    private string _usr = string.Empty;
    private string _dateMode = "PERIOD";
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private string _book = "TAX";
    private string _cashAccountFilter = "111,112";
    private string _search = string.Empty;
    private string _directionFilter = "ALL";
    private string _categoryFilter = "ALL";

    private List<LedgerMiniRow> _allLedgerRows = new();
    private List<CashFlowRow> _cashRows = new();
    private List<CashAccountSummary> _accountSummaries = new();
    private Dictionary<string, string> _accountNames = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, decimal> _openingByAccount = new(StringComparer.OrdinalIgnoreCase);

    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => !IsPeriodMode;
    private decimal OpeningCash => _accountSummaries.Sum(x => x.Opening);
    private decimal PeriodCashIn => _cashRows.Where(x => x.Direction == "IN").Sum(x => x.Amount);
    private decimal PeriodCashOut => _cashRows.Where(x => x.Direction == "OUT" || x.Direction == "TRANSFER").Sum(x => x.Amount);
    private decimal PeriodNetCash => PeriodCashIn - PeriodCashOut;
    private decimal ClosingCash => OpeningCash + PeriodNetCash;
    private decimal ExpectedCustomerIn => _allLedgerRows.Where(x => IsAccount(x.AccountCode, "131") && x.Debit > 0).Sum(x => x.Debit);
    private decimal CashFromCustomers => _cashRows.Where(x => x.Category == "Thu khách hàng").Sum(x => x.Amount);
    private decimal ExpectedVendorOut => _allLedgerRows.Where(x => IsAccount(x.AccountCode, "331") && x.Credit > 0).Sum(x => x.Credit);
    private decimal CashPaidVendors => _cashRows.Where(x => x.Category == "Trả nhà cung cấp").Sum(x => x.Amount);

    private IEnumerable<string> CategoryOptions => _cashRows
        .Select(x => x.Category)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x);

    private IEnumerable<CategoryCashRow> CategoryRows => _cashRows
        .GroupBy(x => x.Category)
        .Select(g => new CategoryCashRow
        {
            Category = g.Key,
            Inflow = g.Where(x => x.Direction == "IN").Sum(x => x.Amount),
            Outflow = g.Where(x => x.Direction == "OUT" || x.Direction == "TRANSFER").Sum(x => x.Amount)
        })
        .OrderByDescending(x => Math.Abs(x.Net));

    private IEnumerable<CashFlowRow> VisibleCashRows
    {
        get
        {
            IEnumerable<CashFlowRow> query = _cashRows;

            if (!string.Equals(_directionFilter, "ALL", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => string.Equals(x.Direction, _directionFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.Equals(_categoryFilter, "ALL", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => string.Equals(x.Category, _categoryFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var key = _search.Trim();
                query = query.Where(x =>
                    x.VoucherNo.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                    x.CashAccount.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                    x.Description.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                    x.CounterpartSummary.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                    x.Category.Contains(key, StringComparison.OrdinalIgnoreCase) ||
                    x.SourceModule.Contains(key, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.CashAccount);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        UpdateDateRange();
        await LoadAccountNamesAsync();
        await LoadAsync();
    }

    private async Task OnDateModeChanged(string value)
    {
        _dateMode = string.IsNullOrWhiteSpace(value) ? "PERIOD" : value;
        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();
        await LoadAsync();
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue || _periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        if (!_fromDate.HasValue)
            _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_toDate.HasValue)
            _toDate = DateTime.Today;

        if (_fromDate.Value.Date > _toDate.Value.Date)
        {
            var temp = _fromDate;
            _fromDate = _toDate;
            _toDate = temp;
        }
    }

    private async Task LoadAccountNamesAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var accounts = await db.DanhMucTaiKhoan.AsNoTracking().ToListAsync();

            _accountNames = accounts
                .Where(x => !string.IsNullOrWhiteSpace(x.Taikhoan))
                .GroupBy(x => x.Taikhoan!.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var item = g.First();
                        return !string.IsNullOrWhiteSpace(item.Accountname)
                            ? item.Accountname!
                            : (!string.IsNullOrWhiteSpace(item.Tentaikhoan) ? item.Tentaikhoan! : g.Key);
                    },
                    StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            _accountNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task LoadAsync()
    {
        _usingSimulator = false;

        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            ClearData();
            return;
        }

        try
        {
            _busy = true;
            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toExclusive = (_toDate?.Date ?? DateTime.Today).Date.AddDays(1);

            await using var db = await DbFactory.CreateDbContextAsync();

            var baseQuery = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.PostingDate >= fromDate && x.PostingDate < toExclusive)
                .Where(x => x.AccountCode != null);

            if (IsPeriodMode && _fiscalYear.HasValue)
                baseQuery = baseQuery.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                baseQuery = baseQuery.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
                baseQuery = baseQuery.Where(x => x.IsTaxBook == true || x.LedgerType == "TAX");

            if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
                baseQuery = baseQuery.Where(x => x.IsManagementBook == true || x.LedgerType == "MGMT");

            var data = await baseQuery
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.VoucherDate)
                .ThenBy(x => x.Id)
                .Take(12000)
                .ToListAsync();

            _allLedgerRows = data.Select(x => new LedgerMiniRow
            {
                Id = x.Id,
                VoucherNo = string.IsNullOrWhiteSpace(x.VoucherNo) ? "NO-VOUCHER" : x.VoucherNo!,
                VoucherKey = BuildVoucherKey(x.VoucherNo, x.PostingDate),
                PostingDate = x.PostingDate,
                AccountCode = x.AccountCode ?? string.Empty,
                Description = x.Description ?? string.Empty,
                Debit = x.Debit,
                Credit = x.Credit,
                Book = (x.IsTaxBook == true && x.IsManagementBook == true) ? "TAX/MGMT" :
                       (x.IsTaxBook == true) ? "TAX" :
                       (x.IsManagementBook == true) ? "MGMT" :
                       (!string.IsNullOrWhiteSpace(x.LedgerType) ? x.LedgerType! : string.Empty),
                SourceModule = x.SourceModule ?? string.Empty
            }).ToList();

            await LoadOpeningCashAsync(db, fromDate);
            BuildCashRows();
            Snackbar.Add($"Loaded {_cashRows.Count:N0} dòng tiền theo T.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GetRootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadOpeningCashAsync(AppDbContext db, DateTime fromDate)
    {
        var openingQuery = db.GeneralLedgerEntries.AsNoTracking()
            .Where(x => x.PostingDate < fromDate)
            .Where(x => x.AccountCode != null)
            .Where(x => x.AccountCode!.StartsWith("111") || x.AccountCode!.StartsWith("112") || x.AccountCode!.StartsWith("113"));

        if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
            openingQuery = openingQuery.Where(x => x.IsTaxBook == true || x.LedgerType == "TAX");

        if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
            openingQuery = openingQuery.Where(x => x.IsManagementBook == true || x.LedgerType == "MGMT");

        var openingData = await openingQuery.Take(50000).ToListAsync();
        _openingByAccount = openingData
            .Where(x => IsCashAccount(x.AccountCode ?? string.Empty))
            .GroupBy(x => (x.AccountCode ?? string.Empty).Trim(), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                g => g.Key,
                g => g.Sum(x => x.Debit - x.Credit),
                StringComparer.OrdinalIgnoreCase);
    }

