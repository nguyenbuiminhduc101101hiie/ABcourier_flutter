@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_line">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_line.LineNo_" Label="STT / LineNo" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudAutocomplete T="Guid"
                                     Label="Tài khoản (TK)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_selectedDmId"
                                     ValueChanged="OnDanhMucChangedAsync"
                                     SearchFunc="SearchDanhMucAsync"
                                     ToStringFunc="DanhMucToString"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="false"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_line.LineDescription" Label="Diễn giải" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid?"
                                     Label="Customer"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     @bind-Value="_line.CustomerId"
                                     SearchFunc="SearchCustomerAsync"
                                     ToStringFunc="CustomerToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid?"
                                     Label="Shipment (HBL)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_line.ShipmentId"
                                     ValueChanged="OnShipmentIdChangedAsync"
                                     SearchFunc="SearchHblAsync"
                                     ToStringFunc="HblToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Label="HBL No"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_line.HBLNo"
                                     ValueChanged="OnHblNoChangedAsync"
                                     SearchFunc="SearchHblNoAsync"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     Label="Container No"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_line.ContainerNo"
                                     ValueChanged="OnContainerNoChangedAsync"
                                     SearchFunc="SearchContainerNoAsync"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.ContainerSizeType" Label="Container Size/Type" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.BookingNo" Label="Booking No" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="_line.PORName" Label="POR" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="_line.POLName" Label="POL" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="_line.PODName" Label="POD" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudTextField @bind-Value="_line.DELName" Label="DEL" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.SaleName" Label="Sale Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.TransportMode" Label="Transport Mode" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ContractIdText" Label="Contract" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="@_line.InvoiceDate" DateChanged="OnInvoiceDateChanged" Label="Invoice Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.BranchId" Label="Branch" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="DepartmentIdText" Label="DepartmentId (Guid)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="@_line.DueDate" DateChanged="OnDueDateChanged" Label="Due Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Value="@(_line.InvoiceNo ?? string.Empty)"
                                  ValueChanged="OnInvoiceNoChanged"
                                  Label="Invoice No"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  HelperText="Có Invoice No → mặc định Tax Book; trống → Management Book (vẫn có thể tick tay)" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Value="@(_line.LedgerType ?? string.Empty)"
                               ValueChanged="OnLedgerTypeChanged"
                               Label="Ledger Type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var lt in LedgerTypeOptions)
                        {
                            <MudSelectItem Value="@lt">@lt</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.TaxCode" Label="Tax Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?" @bind-Value="_line.VatRate" Label="VAT Rate (%)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" @bind-Value="_line.SortKey" Label="Sort Key" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_line.IsTaxBook" Label="Is Tax Book" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_line.IsManagementBook" Label="Is Management Book" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_line.DebitAmount" Label="Nợ" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Format="N2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_line.CreditAmount" Label="Có" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Format="N2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid VoucherId { get; set; }
    [Parameter] public M_AccountingVoucherLines? Line { get; set; }

    private MudForm _form = default!;
    private M_AccountingVoucherLines _line = new();
    private Guid _selectedDmId;
    private List<DanhMucTaiKhoan> _danhMucs = new();
    private List<M_Customer> _customers = new();
    private List<M_HBL> _hbls = new();
    private List<M_Container> _containers = new();
    private List<M_Container> _containersForHbl = new();

    private static readonly string[] LedgerTypeOptions = { "FINANCIAL", "TAX", "MANAGEMENT","GENERAL" };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _danhMucs = await db.DanhMucTaiKhoan.AsNoTracking()
            .Where(x => !string.IsNullOrWhiteSpace(x.Taikhoan))
            .OrderBy(x => x.Taikhoan)
            .ToListAsync();
        _customers = await db.Customer.AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.Customer_Code)
            .ThenBy(x => x.COMPANY)
            .ToListAsync();
        _hbls = await db.HBL.AsNoTracking()
            .Where(x => x.hblID != Guid.Empty)
            .OrderByDescending(x => x.dateupdate)
            .ThenByDescending(x => x.hbl)
            .Take(2000)
            .ToListAsync();
        _containers = await db.Container.AsNoTracking()
            .Where(x => x.hblid != null && x.CONTAINER_NO != null && x.CONTAINER_NO != "")
            .OrderByDescending(x => x.UPDATETIME)
            .ThenBy(x => x.CONTAINER_NO)
            .Take(2000)
            .ToListAsync();

        if (Line is { } src && src.Id != Guid.Empty)
        {
            _line = new M_AccountingVoucherLines
            {
                Id = src.Id,
                VoucherId = src.VoucherId,
                LineNo_ = src.LineNo_,
                DanhMucTaiKhoanID = src.DanhMucTaiKhoanID,
                AccountCode = src.AccountCode,
                DebitAmount = src.DebitAmount,
                CreditAmount = src.CreditAmount,
                DebitAmountFC = src.DebitAmountFC,
                CreditAmountFC = src.CreditAmountFC,
                LineDescription = src.LineDescription,
                CustomerId = src.CustomerId,
                ShipmentId = src.ShipmentId,
                ContractId = src.ContractId,
                BranchId = src.BranchId,
                DepartmentId = src.DepartmentId,
                DueDate = src.DueDate,
                LedgerType = src.LedgerType,
                TaxCode = src.TaxCode,
                VatRate = src.VatRate,
                InvoiceNo = src.InvoiceNo,
                InvoiceDate = src.InvoiceDate,
                IsTaxBook = src.IsTaxBook,
                IsManagementBook = src.IsManagementBook,
                HBLNo = src.HBLNo,
                BookingNo = src.BookingNo,
                POLName = src.POLName,
                PODName = src.PODName,
                ContainerNo = src.ContainerNo,
                ContainerSizeType = src.ContainerSizeType,
                SaleName = src.SaleName,
                DELName = src.DELName,
                PORName = src.PORName,
                TransportMode = src.TransportMode,
                SortKey = src.SortKey
            };
            if (src.CustomerId is Guid customerId && customerId != Guid.Empty && _customers.All(x => x.Customer_ID != customerId))
            {
                var customer = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == customerId);
                if (customer is not null)
                    _customers.Add(customer);
            }
            if (src.ShipmentId is Guid shipmentId && shipmentId != Guid.Empty && _hbls.All(x => x.hblID != shipmentId))
            {
                var hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == shipmentId);
                if (hbl is not null)
                    _hbls.Add(hbl);
            }
            if (src.DanhMucTaiKhoanID is Guid dmId)
            {
                var dm = _danhMucs.FirstOrDefault(x => x.Id == dmId);
                if (dm is not null)
                    _selectedDmId = dm.Id;
            }

            await EnsureContainersForHblAsync(_line.ShipmentId, _line.HBLNo, db);
            ApplyBookFlagsFromInvoiceNo();
        }
        else
        {
            var next = 1;
            var existing = await db.AccountingVoucherLines.Where(x => x.VoucherId == VoucherId).Select(x => x.LineNo_).ToListAsync();
            foreach (var e in existing)
            {
                if (int.TryParse(e, out var n) && n >= next)
                    next = n + 1;
            }

            _line = new M_AccountingVoucherLines
            {
                Id = Guid.NewGuid(),
                VoucherId = VoucherId,
                LineNo_ = next.ToString(),
                DebitAmount = 0,
                CreditAmount = 0,
                DebitAmountFC = 0,
                CreditAmountFC = 0,
                IsTaxBook = false,
                IsManagementBook = true
            };
            _selectedDmId = _danhMucs.FirstOrDefault()?.Id ?? Guid.Empty;
            ApplyBookFlagsFromInvoiceNo();
        }

        if (_selectedDmId != Guid.Empty)
            await ApplyDanhMucAsync(_selectedDmId);
    }

    private async Task OnDanhMucChangedAsync(Guid id)
    {
        _selectedDmId = id;
        await ApplyDanhMucAsync(id);
    }

    private Task<IEnumerable<Guid>> SearchDanhMucAsync(string value)
    {
        IEnumerable<DanhMucTaiKhoan> query = _danhMucs;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.Taikhoan?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Tentaikhoan?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return Task.FromResult(query.Select(x => x.Id).Take(50));
    }

    private string DanhMucToString(Guid id)
    {
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return string.Empty;
        var tk = dm.Taikhoan ?? string.Empty;
        var ten = dm.Tentaikhoan ?? string.Empty;
        return string.IsNullOrWhiteSpace(ten) ? tk : $"{tk} - {ten}";
    }

    private Task ApplyDanhMucAsync(Guid id)
    {
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return Task.CompletedTask;
        _line.DanhMucTaiKhoanID = dm.Id;
        _line.AccountCode = (dm.Taikhoan ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(_line.LineDescription))
            _line.LineDescription = string.IsNullOrWhiteSpace(dm.Diengiai) ? (dm.Tentaikhoan ?? string.Empty) : dm.Diengiai;
        _line.DebitAmountFC = _line.DebitAmount;
        _line.CreditAmountFC = _line.CreditAmount;
        return Task.CompletedTask;
    }

    private void Cancel() => MudDialog.Cancel();

    private string ContractIdText
    {
        get => _line.ContractId ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                _line.ContractId = null;
            else if (Guid.TryParse(value.Trim(), out var g))
                _line.ContractId = g.ToString();
            else
                _line.ContractId = value.Trim();
        }
    }

    private Task OnInvoiceDateChanged(DateTime? date)
    {
        _line.InvoiceDate = date;
        return Task.CompletedTask;
    }

    private Task OnInvoiceNoChanged(string value)
    {
        _line.InvoiceNo = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        ApplyBookFlagsFromInvoiceNo();
        return Task.CompletedTask;
    }

    private void ApplyBookFlagsFromInvoiceNo()
    {
        var hasInvoiceNo = !string.IsNullOrWhiteSpace(_line.InvoiceNo);
        _line.IsTaxBook = hasInvoiceNo;
        _line.IsManagementBook = !hasInvoiceNo;
    }

    private Task OnDueDateChanged(DateTime? date)
    {
        _line.DueDate = date;
        return Task.CompletedTask;
    }

    private Task OnLedgerTypeChanged(string value)
    {
        _line.LedgerType = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        return Task.CompletedTask;
    }

    private string DepartmentIdText
    {
        get => _line.DepartmentId?.ToString() ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                _line.DepartmentId = null;
            else if (Guid.TryParse(value.Trim(), out var g))
                _line.DepartmentId = g;
        }
    }

    private Task<IEnumerable<Guid?>> SearchCustomerAsync(string value)
    {
        IEnumerable<M_Customer> query = _customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.Customer_Code?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.COMPANY?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => (Guid?)x.Customer_ID).Take(30));
    }

    private string CustomerToString(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        var c = _customers.FirstOrDefault(x => x.Customer_ID == id.Value);
        if (c is null)
            return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }

    private Task<IEnumerable<Guid?>> SearchHblAsync(string value)
    {
        IEnumerable<M_HBL> query = _hbls;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => (x.hbl?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => (Guid?)x.hblID).Take(30));
    }

    private string HblToString(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        var h = _hbls.FirstOrDefault(x => x.hblID == id.Value);
        return h?.hbl ?? string.Empty;
    }

    private async Task OnShipmentIdChangedAsync(Guid? id)
    {
        _line.ShipmentId = id;
        if (id is null || id == Guid.Empty)
        {
            _containersForHbl = new List<M_Container>();
            return;
        }
        var hbl = _hbls.FirstOrDefault(x => x.hblID == id.Value);
        if (hbl is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == id.Value);
            if (hbl is not null && _hbls.All(x => x.hblID != hbl.hblID))
                _hbls.Add(hbl);
        }
        if (hbl is null)
            return;

        ApplyHblToLine(hbl);
        await EnsureContainersForHblAsync(hbl.hblID, hbl.hbl, null);
        ApplyFirstContainerForHbl();
    }

    private Task<IEnumerable<string>> SearchHblNoAsync(string value)
    {
        IEnumerable<M_HBL> query = _hbls.Where(x => !string.IsNullOrWhiteSpace(x.hbl));
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => x.hbl!.Contains(k, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(query
            .Select(x => x.hbl!.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(50));
    }

    private async Task OnHblNoChangedAsync(string value)
    {
        _line.HBLNo = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        if (string.IsNullOrWhiteSpace(_line.HBLNo))
        {
            _containersForHbl = new List<M_Container>();
            return;
        }

        var hbl = _hbls.FirstOrDefault(x => string.Equals((x.hbl ?? string.Empty).Trim(), _line.HBLNo, StringComparison.OrdinalIgnoreCase));
        if (hbl is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hbl == _line.HBLNo);
            if (hbl is not null && _hbls.All(x => x.hblID != hbl.hblID))
                _hbls.Add(hbl);
        }
        if (hbl is null)
            return;

        ApplyHblToLine(hbl);
        await EnsureContainersForHblAsync(hbl.hblID, hbl.hbl, null);
        ApplyFirstContainerForHbl();
    }

    private void ApplyHblToLine(M_HBL hbl)
    {
        _line.ShipmentId = hbl.hblID;
        _line.HBLNo = hbl.hbl;
        _line.BookingNo = hbl.bkno;
        _line.POLName = hbl.polname;
        _line.PODName = hbl.podname;
        _line.DELName = hbl.delName;
        _line.PORName = hbl.porname;
        _line.SaleName = hbl.SaleName;
    }

    private void ApplyFirstContainerForHbl()
    {
        var first = _containersForHbl.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.CONTAINER_NO));
        if (first is null)
            return;
        _line.ContainerNo = first.CONTAINER_NO;
        _line.ContainerSizeType = first.CTN_SIZE_TYPE;
    }

    private async Task EnsureContainersForHblAsync(Guid? hblId, string? hblNo, AppDbContext? db)
    {
        if ((hblId is null || hblId == Guid.Empty) && string.IsNullOrWhiteSpace(hblNo))
        {
            _containersForHbl = new List<M_Container>();
            return;
        }

        if ((hblId is null || hblId == Guid.Empty) && !string.IsNullOrWhiteSpace(hblNo))
        {
            var matched = _hbls.FirstOrDefault(x => string.Equals((x.hbl ?? string.Empty).Trim(), hblNo!.Trim(), StringComparison.OrdinalIgnoreCase));
            if (matched is not null)
                hblId = matched.hblID;
        }

        if (hblId is null || hblId == Guid.Empty)
        {
            _containersForHbl = new List<M_Container>();
            return;
        }

        _containersForHbl = _containers.Where(x => x.hblid == hblId).ToList();
        if (_containersForHbl.Count > 0)
            return;

        var ownsDb = db is null;
        db ??= await DbFactory.CreateDbContextAsync();
        try
        {
            var fetched = await db.Container.AsNoTracking()
                .Where(x => x.hblid == hblId && x.CONTAINER_NO != null && x.CONTAINER_NO != "")
                .ToListAsync();
            foreach (var c in fetched)
            {
                if (_containers.All(x => x.CTN_ID != c.CTN_ID))
                    _containers.Add(c);
            }
            _containersForHbl = _containers.Where(x => x.hblid == hblId).ToList();
        }
        finally
        {
            if (ownsDb)
                await db.DisposeAsync();
        }
    }

    private Task<IEnumerable<string>> SearchContainerNoAsync(string value)
    {
        var source = _containersForHbl.Count > 0 ? _containersForHbl : _containers;
        IEnumerable<M_Container> query = source.Where(x => !string.IsNullOrWhiteSpace(x.CONTAINER_NO));
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => x.CONTAINER_NO!.Contains(k, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(query
            .Select(x => x.CONTAINER_NO!.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(50));
    }

    private Task OnContainerNoChangedAsync(string value)
    {
        _line.ContainerNo = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        if (string.IsNullOrWhiteSpace(_line.ContainerNo))
            return Task.CompletedTask;

        var source = _containersForHbl.Count > 0 ? _containersForHbl : _containers;
        var c = source.FirstOrDefault(x => string.Equals((x.CONTAINER_NO ?? string.Empty).Trim(), _line.ContainerNo, StringComparison.OrdinalIgnoreCase));
        if (c is not null)
            _line.ContainerSizeType = c.CTN_SIZE_TYPE;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_selectedDmId == Guid.Empty)
        {
            Snackbar.Add("Chọn tài khoản.", MudBlazor.Severity.Warning);
            return;
        }

        if (_line.DebitAmount > 0 && _line.CreditAmount > 0)
        {
            Snackbar.Add("Một dòng chỉ ghi Nợ hoặc Có.", MudBlazor.Severity.Warning);
            return;
        }

        _line.DebitAmountFC = _line.DebitAmount;
        _line.CreditAmountFC = _line.CreditAmount;
        _line.DanhMucTaiKhoanID = _selectedDmId;
        MudDialog.Close(DialogResult.Ok(_line));
    }
}
