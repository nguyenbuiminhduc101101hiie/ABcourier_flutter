    private async Task ResolveImportCustomersByTaxCodeAsync()
    {
        _importCustomerMatches.Clear();

        if (_importPreview is null || _importPreview.Lines.Count == 0)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var customers = await db.Customer
            .AsNoTracking()
            .Where(x =>
                x.Customer_ID != Guid.Empty &&
                x.TaxCode != null &&
                x.TaxCode != string.Empty)
            .Select(x => new CustomerTaxLookupRow
            {
                CustomerId = x.Customer_ID,
                TaxCode = x.TaxCode!,
                CustomerName =
                    x.COMPANY != null && x.COMPANY != string.Empty
                        ? x.COMPANY
                        : x.BIZName ?? string.Empty
            })
            .ToListAsync();

        var lookupGroups = customers
            .Where(x => !string.IsNullOrWhiteSpace(x.TaxCode))
            .GroupBy(x => NormalizeTaxCode(x.TaxCode))
            .Where(group => !string.IsNullOrWhiteSpace(group.Key))
            .ToDictionary(group => group.Key, group => group.ToList());

        foreach (var line in _importPreview.Lines)
        {
            var normalizedTaxCode = NormalizeTaxCode(line.CustomerCode);

            if (string.IsNullOrWhiteSpace(normalizedTaxCode))
            {
                _importCustomerMatches[line.ExcelRowNo] = new CustomerImportMatch
                {
                    SourceTaxCode = line.CustomerCode,
                    ErrorText = "Mã KH/MST trong file đang trống."
                };
                continue;
            }

            if (!lookupGroups.TryGetValue(normalizedTaxCode, out var matches) || matches.Count == 0)
            {
                _importCustomerMatches[line.ExcelRowNo] = new CustomerImportMatch
                {
                    SourceTaxCode = line.CustomerCode,
                    ErrorText = $"Không tìm thấy Customer có TaxCode = {line.CustomerCode}."
                };
                continue;
            }

            if (matches.Count > 1)
            {
                _importCustomerMatches[line.ExcelRowNo] = new CustomerImportMatch
                {
                    SourceTaxCode = line.CustomerCode,
                    ErrorText =
                        $"TaxCode {line.CustomerCode} đang trùng trên {matches.Count:N0} Customer."
                };
                continue;
            }

            var customer = matches[0];
            _importCustomerMatches[line.ExcelRowNo] = new CustomerImportMatch
            {
                SourceTaxCode = line.CustomerCode,
                CustomerId = customer.CustomerId,
                TaxCode = customer.TaxCode,
                CustomerName = customer.CustomerName
            };
        }
    }

    private CustomerImportMatch? GetImportCustomerMatch(AccountBalanceExcelLine line)
        => _importCustomerMatches.TryGetValue(line.ExcelRowNo, out var match)
            ? match
            : null;

    private bool HasImportCustomerProblem(AccountBalanceExcelLine line)
        => GetImportCustomerMatch(line)?.CustomerId is null;

    private string GetImportRowClass(AccountBalanceExcelLine line, int rowNumber)
    {
        if (line.HasError || HasImportCustomerProblem(line))
            return "import-row-error";

        if (line.HasWarning)
            return "import-row-warning";

        return string.Empty;
    }

    private List<CustomerBalanceImportRow> BuildCustomerBalanceImportRows()
    {
        if (_importPreview is null)
            return new List<CustomerBalanceImportRow>();

        var validLines = _importPreview.Lines
            .Where(line => !line.HasError)
            .Select(line => new
            {
                Line = line,
                Match = GetImportCustomerMatch(line)
            })
            .Where(x => x.Match?.CustomerId is not null)
            .ToList();

        return validLines
            .GroupBy(x => x.Match!.CustomerId!.Value)
            .Select(group =>
            {
                var openingNet = group.Sum(x => x.Line.OpeningDebit - x.Line.OpeningCredit);
                var closingNet = group.Sum(x => x.Line.ClosingDebit - x.Line.ClosingCredit);
                var first = group.First();

                return new CustomerBalanceImportRow
                {
                    CustomerId = group.Key,
                    CustomerTaxCode = first.Match!.TaxCode ?? first.Line.CustomerCode,
                    CustomerName = first.Match.CustomerName ?? first.Line.CustomerName,
                    SourceExcelRow = group.Min(x => x.Line.ExcelRowNo),
                    OpeningDebit = RoundMoney(openingNet > 0 ? openingNet : 0),
                    OpeningCredit = RoundMoney(openingNet < 0 ? Math.Abs(openingNet) : 0),
                    DebitTotal = RoundMoney(group.Sum(x => x.Line.PeriodDebit)),
                    CreditTotal = RoundMoney(group.Sum(x => x.Line.PeriodCredit)),
                    ClosingDebit = RoundMoney(closingNet > 0 ? closingNet : 0),
                    ClosingCredit = RoundMoney(closingNet < 0 ? Math.Abs(closingNet) : 0)
                };
            })
            .OrderBy(x => x.CustomerTaxCode)
            .ToList();
    }

    private async Task CommitCustomerBalanceImportAsync()
    {
        if (!CanCommitCustomerBalanceImport || _importPreview is null)
            return;

        var rows = BuildCustomerBalanceImportRows();
        if (rows.Count == 0)
        {
            Snackbar.Add("Không có dòng khách hàng hợp lệ để import.", MudBlazor.Severity.Warning);
            return;
        }

        var actionText = _importExistingMode switch
        {
            ExistingBalanceImportMode.RejectExisting => "thêm mới và báo lỗi nếu đã tồn tại",
            ExistingBalanceImportMode.UpdateExisting => "thêm mới hoặc cập nhật dữ liệu hiện có",
            ExistingBalanceImportMode.ReplaceCurrentAccountPeriod => "xóa toàn bộ dữ liệu cùng tài khoản/kỳ/sổ rồi nhập lại",
            _ => "import"
        };

        var confirmed = await DialogService.ShowMessageBox(
            "Xác nhận import Customer Account Balance",
            $"Hệ thống sẽ {actionText} cho {rows.Count:N0} khách hàng, " +
            $"tài khoản {_importPreview.AccountCode}, " +
            $"tháng {_importPreview.PeriodNo:00}/{_importPreview.FiscalYear}, " +
            $"sổ {DisplayBookCode(_importBookCode)}. " +
            (_syncAccountBalanceAfterImport
                ? "Sau đó hệ thống tự cập nhật một dòng tổng hợp vào account_balance."
                : "Không tự cập nhật account_balance."),
            yesText: "Import",
            cancelText: "Hủy");

        if (confirmed != true)
            return;

        _importing = true;
        _customerImportResult = null;

        try
        {
            _customerImportResult = await CommitCustomerBalanceRowsAsync(rows);

            _filterAccountCode = _importPreview.AccountCode.Trim();
            _filterYear = _importPreview.FiscalYear;
            _filterMonth = _importPreview.PeriodNo;
            _filterBookCode = NormalizeNullable(_importBookCode);
            _filterCustomerId = null;

            Snackbar.Add(
                $"Import thành công {rows.Count:N0} khách hàng: " +
                $"thêm {_customerImportResult.InsertedCount:N0}, " +
                $"cập nhật {_customerImportResult.UpdatedCount:N0}, " +
                $"xóa {_customerImportResult.DeletedCount:N0}.",
                MudBlazor.Severity.Success);

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GetRootExceptionMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task<CustomerBalanceImportResult> CommitCustomerBalanceRowsAsync(
        IReadOnlyCollection<CustomerBalanceImportRow> rows)
    {
        if (_importPreview is null)
            throw new InvalidOperationException("Dữ liệu preview không còn tồn tại.");

        var accountCode = _importPreview.AccountCode.Trim();
        var year = _importPreview.FiscalYear;
        var month = _importPreview.PeriodNo;
        var bookCode = NormalizeNullable(_importBookCode);
        var batchId = Guid.NewGuid();
        var result = new CustomerBalanceImportResult
        {
            CustomerCount = rows.Count
        };

        await using var db = await DbFactory.CreateDbContextAsync();
        var connection = db.Database.GetDbConnection();
        var mustClose = connection.State != ConnectionState.Open;

        if (mustClose)
            await connection.OpenAsync();

        await using var transaction = await connection.BeginTransactionAsync();

        try
        {
            await EnsureCustomerAccountBalanceTableAsync(connection, transaction);

            if (_importExistingMode == ExistingBalanceImportMode.ReplaceCurrentAccountPeriod)
            {
                result.DeletedCount = await DeleteCustomerBalancePeriodAsync(
                    connection,
                    transaction,
                    accountCode,
                    year,
                    month,
                    bookCode);
            }

            foreach (var row in rows)
            {
                var existingIds = await FindExistingCustomerBalanceIdsAsync(
                    connection,
                    transaction,
                    row.CustomerId,
                    accountCode,
                    year,
                    month,
                    bookCode);

                if (existingIds.Count > 1)
                {
                    throw new InvalidOperationException(
                        $"Khách hàng MST {row.CustomerTaxCode} có nhiều dòng trùng trong " +
                        "customer_account_balance. Hãy xử lý dữ liệu trùng trước khi import.");
                }

                if (existingIds.Count == 1)
                {
                    if (_importExistingMode == ExistingBalanceImportMode.RejectExisting)
                    {
                        throw new InvalidOperationException(
                            $"Khách hàng MST {row.CustomerTaxCode} đã có số dư cho " +
                            $"tài khoản {accountCode}, tháng {month:00}/{year}, " +
                            $"sổ {DisplayBookCode(bookCode)}.");
                    }

                    await UpdateCustomerBalanceImportRowAsync(
                        connection,
                        transaction,
                        existingIds[0],
                        row,
                        accountCode,
                        year,
                        month,
                        bookCode,
                        batchId);

                    result.UpdatedCount++;
                }
                else
                {
                    await InsertCustomerBalanceImportRowAsync(
                        connection,
                        transaction,
                        row,
                        accountCode,
                        year,
                        month,
                        bookCode,
                        batchId);

                    result.InsertedCount++;
                }
            }

            if (_syncAccountBalanceAfterImport)
            {
                var totals = await ReadSyncTotalsAsync(
                    connection,
                    transaction,
                    accountCode,
                    year,
                    month,
                    bookCode);

                if (totals.RowCount == 0)
                    throw new InvalidOperationException("Không có dữ liệu chi tiết để cập nhật account_balance.");

                var accountBalanceIds = await ReadAccountBalanceIdsAsync(
                    connection,
                    transaction,
                    accountCode,
                    year,
                    month,
                    bookCode);

                if (accountBalanceIds.Count > 1)
                {
                    throw new InvalidOperationException(
                        "account_balance đang có nhiều hơn một dòng cho cùng tài khoản/kỳ/mã sổ. " +
                        "Hãy xử lý dữ liệu trùng trước khi import.");
                }

                if (accountBalanceIds.Count == 1)
                {
                    await UpdateAccountBalanceAsync(
                        connection,
                        transaction,
                        accountBalanceIds[0],
                        totals,
                        accountCode,
                        year,
                        month,
                        bookCode);
                }
                else
                {
                    await InsertAccountBalanceAsync(
                        connection,
                        transaction,
                        totals,
                        accountCode,
                        year,
                        month,
                        bookCode);
                }

                result.AccountBalanceSynced = true;
            }

            await transaction.CommitAsync();
            return result;
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
        finally
        {
            if (mustClose)
                await connection.CloseAsync();
        }
    }

    private static async Task EnsureCustomerAccountBalanceTableAsync(
        DbConnection connection,
        DbTransaction transaction)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT CASE WHEN
    OBJECT_ID(N'dbo.customer_account_balance', N'U') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'customer_id') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'account_code') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'period_year') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'period_month') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'opening_debit') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'opening_credit') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'debit_total') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'credit_total') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'closing_debit') IS NOT NULL
    AND COL_LENGTH(N'dbo.customer_account_balance', N'closing_credit') IS NOT NULL
THEN CAST(1 AS BIT)
ELSE CAST(0 AS BIT)
END;";

        var value = await command.ExecuteScalarAsync();
        if (value is null || value == DBNull.Value || !Convert.ToBoolean(value))
        {
            throw new InvalidOperationException(
                "Chưa có bảng dbo.customer_account_balance hoặc bảng thiếu cột. " +
                "Hãy chạy Create_CustomerAccountBalance.sql trước.");
        }
    }

    private async Task<int> DeleteCustomerBalancePeriodAsync(
        DbConnection connection,
        DbTransaction transaction,
        string accountCode,
        int year,
        int month,
        string? bookCode)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
DELETE FROM dbo.customer_account_balance
WHERE company_id = @CompanyId
  AND account_code = @AccountCode
  AND period_year = @PeriodYear
  AND period_month = @PeriodMonth
  AND ((book_code = @BookCode) OR (book_code IS NULL AND @BookCode IS NULL));";

        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@AccountCode", accountCode, DbType.String);
        AddParameter(command, "@PeriodYear", year, DbType.Int32);
        AddParameter(command, "@PeriodMonth", month, DbType.Int32);
        AddNullableString(command, "@BookCode", bookCode);

        return await command.ExecuteNonQueryAsync();
    }

    private async Task<List<Guid>> FindExistingCustomerBalanceIdsAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid customerId,
        string accountCode,
        int year,
        int month,
        string? bookCode)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT id
FROM dbo.customer_account_balance WITH (UPDLOCK, HOLDLOCK)
WHERE company_id = @CompanyId
  AND customer_id = @CustomerId
  AND account_code = @AccountCode
  AND period_year = @PeriodYear
  AND period_month = @PeriodMonth
  AND ((book_code = @BookCode) OR (book_code IS NULL AND @BookCode IS NULL));";

        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@CustomerId", customerId, DbType.Guid);
        AddParameter(command, "@AccountCode", accountCode, DbType.String);
        AddParameter(command, "@PeriodYear", year, DbType.Int32);
        AddParameter(command, "@PeriodMonth", month, DbType.Int32);
        AddNullableString(command, "@BookCode", bookCode);

        var ids = new List<Guid>();
        await using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
            ids.Add(reader.GetGuid(0));

        return ids;
    }

    private async Task InsertCustomerBalanceImportRowAsync(
        DbConnection connection,
        DbTransaction transaction,
        CustomerBalanceImportRow row,
        string accountCode,
        int year,
        int month,
        string? bookCode,
        Guid batchId)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
INSERT INTO dbo.customer_account_balance
(
    id,
    company_id,
    customer_id,
    account_code,
    period_year,
    period_month,
    book_code,
    opening_debit,
    opening_credit,
    debit_total,
    credit_total,
    closing_debit,
    closing_credit,
    source_file_name,
    source_excel_row,
    import_batch_id,
    created_at,
    updated_at
)
VALUES
(
    NEWID(),
    @CompanyId,
    @CustomerId,
    @AccountCode,
    @PeriodYear,
    @PeriodMonth,
    @BookCode,
    @OpeningDebit,
    @OpeningCredit,
    @DebitTotal,
    @CreditTotal,
    @ClosingDebit,
    @ClosingCredit,
    @SourceFileName,
    @SourceExcelRow,
    @ImportBatchId,
    SYSUTCDATETIME(),
    SYSUTCDATETIME()
);";

        AddCustomerBalanceImportParameters(
            command,
            row,
            accountCode,
            year,
            month,
            bookCode,
            batchId);

        await command.ExecuteNonQueryAsync();
    }

    private async Task UpdateCustomerBalanceImportRowAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid id,
        CustomerBalanceImportRow row,
        string accountCode,
        int year,
        int month,
        string? bookCode,
        Guid batchId)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
UPDATE dbo.customer_account_balance
SET opening_debit = @OpeningDebit,
    opening_credit = @OpeningCredit,
    debit_total = @DebitTotal,
    credit_total = @CreditTotal,
    closing_debit = @ClosingDebit,
    closing_credit = @ClosingCredit,
    source_file_name = @SourceFileName,
    source_excel_row = @SourceExcelRow,
    import_batch_id = @ImportBatchId,
    updated_at = SYSUTCDATETIME()
WHERE id = @Id
  AND company_id = @CompanyId;";

        AddParameter(command, "@Id", id, DbType.Guid);
        AddCustomerBalanceImportParameters(
            command,
            row,
            accountCode,
            year,
            month,
            bookCode,
            batchId);

        var affected = await command.ExecuteNonQueryAsync();
        if (affected == 0)
            throw new InvalidOperationException("Không tìm thấy dòng Customer Account Balance cần cập nhật.");
    }

    private void AddCustomerBalanceImportParameters(
        DbCommand command,
        CustomerBalanceImportRow row,
        string accountCode,
        int year,
        int month,
        string? bookCode,
        Guid batchId)
    {
        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@CustomerId", row.CustomerId, DbType.Guid);
        AddParameter(command, "@AccountCode", accountCode, DbType.String);
        AddParameter(command, "@PeriodYear", year, DbType.Int32);
        AddParameter(command, "@PeriodMonth", month, DbType.Int32);
        AddNullableString(command, "@BookCode", bookCode);
        AddParameter(command, "@OpeningDebit", row.OpeningDebit, DbType.Decimal);
        AddParameter(command, "@OpeningCredit", row.OpeningCredit, DbType.Decimal);
        AddParameter(command, "@DebitTotal", row.DebitTotal, DbType.Decimal);
        AddParameter(command, "@CreditTotal", row.CreditTotal, DbType.Decimal);
        AddParameter(command, "@ClosingDebit", row.ClosingDebit, DbType.Decimal);
        AddParameter(command, "@ClosingCredit", row.ClosingCredit, DbType.Decimal);
        AddNullableString(command, "@SourceFileName", _importFileName);
        AddParameter(command, "@SourceExcelRow", row.SourceExcelRow, DbType.Int32);
        AddParameter(command, "@ImportBatchId", batchId, DbType.Guid);
    }

    private void ResetImport()
    {
        if (_readingImport || _importing)
            return;

        _importPreview = null;
        _customerImportResult = null;
        _importCustomerMatches.Clear();
        _importFileName = null;
        _showOnlyImportProblems = false;
    }

    private static string NormalizeTaxCode(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        return new string(
            value
                .Trim()
                .Where(char.IsLetterOrDigit)
                .Select(char.ToUpperInvariant)
                .ToArray());
    }

    private static decimal RoundMoney(decimal value)
        => decimal.Round(value, 2, MidpointRounding.AwayFromZero);

    private static string ShortGuid(Guid value)
        => value.ToString("N")[..8];

    private static string GetRootExceptionMessage(Exception exception)
    {
        var current = exception;
        while (current.InnerException is not null)
            current = current.InnerException;

        return current.Message;
    }

    private static MudBlazor.Severity ToSeverity(ExcelImportMessageLevel level)
        => level switch
        {
            ExcelImportMessageLevel.Error => MudBlazor.Severity.Error,
            ExcelImportMessageLevel.Warning => MudBlazor.Severity.Warning,
            _ => MudBlazor.Severity.Info
        };

    private static string CompanyLabel(M_Customer customer)
    {
        var company = (customer.COMPANY ?? string.Empty).Trim();
        var business = (customer.BIZName ?? string.Empty).Trim();

        if (!string.IsNullOrWhiteSpace(company) &&
            !string.IsNullOrWhiteSpace(business) &&
            !string.Equals(company, business, StringComparison.OrdinalIgnoreCase))
        {
            return $"{company} ({business})";
        }

        if (!string.IsNullOrWhiteSpace(company))
            return company;

        if (!string.IsNullOrWhiteSpace(business))
            return business;

        return CustomerLabel(customer);
    }

    private static string CustomerLabel(M_Customer customer)
    {
        var code = (customer.Customer_Code ?? customer.MaDT ?? string.Empty).Trim();
        var name = (customer.COMPANY ?? customer.BIZName ?? string.Empty).Trim();

        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(name))
            return $"{code} - {name}";

        if (!string.IsNullOrWhiteSpace(name))
            return name;

        if (!string.IsNullOrWhiteSpace(code))
            return code;

        return customer.Customer_ID.ToString();
    }

    private static string DisplayBookCode(string? value)
        => string.IsNullOrWhiteSpace(value) ? "(Mặc định)" : value.Trim();

    private static string? NormalizeNullable(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string FormatMoney(decimal value)
        => value.ToString("N2");

    private static void AddNullableString(DbCommand command, string name, string? value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.DbType = DbType.String;
        parameter.Value = string.IsNullOrWhiteSpace(value)
            ? DBNull.Value
            : value.Trim();
        command.Parameters.Add(parameter);
    }

    private static void AddParameter(DbCommand command, string name, object value, DbType dbType)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.DbType = dbType;
        parameter.Value = value;

        if (dbType == DbType.Decimal)
        {
            parameter.Precision = 18;
            parameter.Scale = 2;
        }

        command.Parameters.Add(parameter);
    }

