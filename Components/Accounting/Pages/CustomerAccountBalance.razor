                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal"
                                         Label="Cuối kỳ Nợ"
                                         Value="@CalculatedClosingDebit"
                                         ReadOnly="true"
                                         HideSpinButtons="true"
                                         Format="N2" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal"
