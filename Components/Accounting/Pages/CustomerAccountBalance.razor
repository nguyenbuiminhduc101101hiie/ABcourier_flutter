</style>

@code {
    private const long MaxUploadSize = 20 * 1024 * 1024;

    private MudTable<CustomerBalanceRow>? _table;
    private MudForm? _editForm;

    private AccountBalanceExcelPreview? _importPreview;
    private ExistingBalanceImportMode _importExistingMode = ExistingBalanceImportMode.RejectExisting;
    private CustomerBalanceImportResult? _customerImportResult;
    private readonly Dictionary<int, CustomerImportMatch> _importCustomerMatches = new();

    private bool _importExpanded;
    private bool _readingImport;
    private bool _importing;
    private bool _showOnlyImportProblems;
    private bool _syncAccountBalanceAfterImport = true;
    private string? _importFileName;
    private string? _importBookCode;

    private readonly List<M_Customer> _companies = new();
    private readonly List<M_Customer> _customers = new();

    private Guid _companyId;
    private bool _companyResolved;
    private string _companySourceHint = "Ưu tiên lấy từ claim đăng nhập.";

    private bool _loading;
    private bool _saving;
    private bool _editorExpanded;

    private int _filterYear = DateTime.Today.Year;
    private int? _filterMonth = DateTime.Today.Month;
    private string? _filterAccountCode;
    private string? _filterBookCode;
    private Guid? _filterCustomerId;

    private CustomerBalanceSummary _summary = new();

    private Guid? _editId;
    private Guid? _editCustomerId;
    private string _editAccountCode = "131";
    private int _editYear = DateTime.Today.Year;
    private int _editMonth = DateTime.Today.Month;
    private string? _editBookCode;
    private decimal _editOpeningDebit;
    private decimal _editOpeningCredit;
    private decimal _editDebitTotal;
    private decimal _editCreditTotal;

    private decimal CalculatedClosingNet =>
        _editOpeningDebit - _editOpeningCredit +
        _editDebitTotal - _editCreditTotal;

    private decimal CalculatedClosingDebit =>
        CalculatedClosingNet > 0 ? CalculatedClosingNet : 0;

    private decimal CalculatedClosingCredit =>
        CalculatedClosingNet < 0 ? Math.Abs(CalculatedClosingNet) : 0;

    private string? EditorWarning
    {
        get
        {
            if (_editOpeningDebit > 0 && _editOpeningCredit > 0)
                return "Số dư đầu kỳ không được đồng thời có cả bên Nợ và bên Có.";

            return null;
        }
    }

    private IEnumerable<AccountBalanceExcelLine> VisibleImportLines =>
        _importPreview is null
            ? Enumerable.Empty<AccountBalanceExcelLine>()
            : _showOnlyImportProblems
                ? _importPreview.Lines.Where(line =>
                    line.HasError ||
                    line.HasWarning ||
                    HasImportCustomerProblem(line))
                : _importPreview.Lines;

    private int MatchedImportCustomerCount =>
        _importCustomerMatches.Values.Count(x => x.CustomerId.HasValue);

    private int UnmatchedImportCustomerCount =>
        _importCustomerMatches.Values.Count(x => !x.CustomerId.HasValue);

    private int ImportWriteRowCount =>
        BuildCustomerBalanceImportRows().Count;

    private bool CanCommitCustomerBalanceImport =>
        !_readingImport &&
        !_importing &&
        _companyResolved &&
        _importPreview is { CanImport: true } &&
        _importPreview.FiscalYear is >= 2000 and <= 2200 &&
        _importPreview.PeriodNo is >= 1 and <= 12 &&
        !string.IsNullOrWhiteSpace(_importPreview.AccountCode) &&
        UnmatchedImportCustomerCount == 0 &&
        ImportWriteRowCount > 0;

    private bool CanSyncAccountBalance =>
        _companyResolved &&
        _filterMonth.HasValue &&
        !string.IsNullOrWhiteSpace(_filterAccountCode);

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAndResolveCompanyAsync();
    }

    private async Task LoadCustomersAndResolveCompanyAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;

        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.Customer
            .AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.COMPANY)
            .ThenBy(x => x.BIZName)
            .ThenBy(x => x.Customer_Code)
            .ToListAsync();

        _companies.Clear();
        _companies.AddRange(rows);

        _customers.Clear();
        _customers.AddRange(rows);

        var claimCompanyId = TryGetCompanyIdFromClaims(user);
        if (claimCompanyId.HasValue)
        {
            _companyId = claimCompanyId.Value;
            _companyResolved = true;
            _companySourceHint = $"Lấy từ claim đăng nhập: {_companyId}";
            return;
        }

        if (_companies.Count > 0)
        {
            _companyId = _companies[0].Customer_ID;
            _companyResolved = true;
            _companySourceHint = $"Đã chọn mặc định: {CompanyLabel(_companies[0])}";
            return;
        }

        _companyId = Guid.Empty;
        _companyResolved = false;
        _companySourceHint = "Không có dữ liệu Customer để xác định công ty.";
    }

    private static Guid? TryGetCompanyIdFromClaims(System.Security.Claims.ClaimsPrincipal user)
    {
        var claimNames = new[]
        {
            "CompanyId",
            "company_id",
            "TenantCompanyId",
            "tenant_company_id"
        };

        foreach (var claimName in claimNames)
        {
            var value = user.FindFirst(claimName)?.Value;
            if (Guid.TryParse(value, out var companyId) && companyId != Guid.Empty)
                return companyId;
        }

        return null;
    }

    private async Task OnCompanyChangedAsync(Guid companyId)
    {
        _companyId = companyId;
        _companyResolved = companyId != Guid.Empty;

        var selected = _companies.FirstOrDefault(x => x.Customer_ID == companyId);
        _companySourceHint = selected is null
            ? "Đã chọn CompanyId thủ công."
            : $"Đã chọn: {CompanyLabel(selected)}";

        ResetEditor();

        if (_importPreview is not null)
            await ResolveImportCustomersByTaxCodeAsync();

        await ReloadAsync();
    }

    private async Task<TableData<CustomerBalanceRow>> LoadServerDataAsync(TableState state)
    {
        if (!_companyResolved)
        {
            return new TableData<CustomerBalanceRow>
            {
                Items = Array.Empty<CustomerBalanceRow>(),
                TotalItems = 0
            };
        }

        _loading = true;
        var cancellationToken = CancellationToken.None;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync(cancellationToken);
            var connection = db.Database.GetDbConnection();
            var mustClose = connection.State != ConnectionState.Open;

            if (mustClose)
                await connection.OpenAsync(cancellationToken);

            try
            {
                var where = BuildWhereSql();
                var orderBy = BuildOrderBy(state);
                var offset = Math.Max(0, state.Page) * Math.Max(1, state.PageSize);

                await using var command = connection.CreateCommand();
                command.CommandText = $@"
SELECT
    cab.id,
    cab.company_id,
    cab.customer_id,
    cab.account_code,
    cab.period_year,
    cab.period_month,
    cab.book_code,
    cab.opening_debit,
    cab.opening_credit,
    cab.debit_total,
    cab.credit_total,
    cab.closing_debit,
    cab.closing_credit,
    cab.created_at,
    cab.updated_at,
    COALESCE(NULLIF(LTRIM(RTRIM(c.Customer_Code)), ''),
             NULLIF(LTRIM(RTRIM(c.MaDT)), ''),
             CONVERT(NVARCHAR(36), cab.customer_id)) AS customer_code,
    COALESCE(NULLIF(LTRIM(RTRIM(c.COMPANY)), ''),
             NULLIF(LTRIM(RTRIM(c.BIZName)), ''),
             N'(Không có tên)') AS customer_name,
    COUNT_BIG(1) OVER() AS total_rows
FROM dbo.customer_account_balance cab
LEFT JOIN dbo.Customer c
    ON c.Customer_ID = cab.customer_id
{where}
ORDER BY {orderBy}
OFFSET @Offset ROWS FETCH NEXT @PageSize ROWS ONLY;";

                AddFilterParameters(command);
                AddParameter(command, "@Offset", offset, DbType.Int32);
                AddParameter(command, "@PageSize", Math.Max(1, state.PageSize), DbType.Int32);

                var result = new List<CustomerBalanceRow>();
                var totalRows = 0;

                await using (var reader = await command.ExecuteReaderAsync(cancellationToken))
                {
                    while (await reader.ReadAsync(cancellationToken))
                    {
                        if (totalRows == 0 && !reader.IsDBNull(17))
                            totalRows = Convert.ToInt32(reader.GetInt64(17));

                        result.Add(new CustomerBalanceRow
                        {
                            Id = reader.GetGuid(0),
                            CompanyId = reader.GetGuid(1),
                            CustomerId = reader.GetGuid(2),
                            AccountCode = reader.GetString(3),
                            PeriodYear = reader.GetInt32(4),
                            PeriodMonth = reader.GetInt32(5),
                            BookCode = reader.IsDBNull(6) ? null : reader.GetString(6),
                            OpeningDebit = reader.GetDecimal(7),
                            OpeningCredit = reader.GetDecimal(8),
                            DebitTotal = reader.GetDecimal(9),
                            CreditTotal = reader.GetDecimal(10),
                            ClosingDebit = reader.GetDecimal(11),
                            ClosingCredit = reader.GetDecimal(12),
                            CreatedAt = reader.GetDateTime(13),
                            UpdatedAt = reader.GetDateTime(14),
                            CustomerCode = reader.GetString(15),
                            CustomerName = reader.GetString(16)
                        });
                    }
                }

                await LoadSummaryAsync(connection, cancellationToken);

                return new TableData<CustomerBalanceRow>
                {
                    Items = result,
                    TotalItems = totalRows
                };
            }
            finally
            {
                if (mustClose)
                    await connection.CloseAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không thể tải Customer Account Balance: {ex.Message}", MudBlazor.Severity.Error);

            return new TableData<CustomerBalanceRow>
            {
                Items = Array.Empty<CustomerBalanceRow>(),
                TotalItems = 0
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSummaryAsync(DbConnection connection, CancellationToken cancellationToken)
    {
        await using var command = connection.CreateCommand();
        command.CommandText = $@"
SELECT
    COUNT_BIG(1) AS row_count,
    COUNT_BIG(DISTINCT customer_id) AS customer_count,
    COALESCE(SUM(opening_debit), 0) AS opening_debit,
    COALESCE(SUM(opening_credit), 0) AS opening_credit,
    COALESCE(SUM(debit_total), 0) AS debit_total,
    COALESCE(SUM(credit_total), 0) AS credit_total,
    COALESCE(SUM(closing_debit), 0) AS closing_debit,
    COALESCE(SUM(closing_credit), 0) AS closing_credit
FROM dbo.customer_account_balance
{BuildWhereSql(alias: null)};";

        AddFilterParameters(command, alias: null);

        await using var reader = await command.ExecuteReaderAsync(cancellationToken);
        if (!await reader.ReadAsync(cancellationToken))
        {
            _summary = new CustomerBalanceSummary();
            return;
        }

        _summary = new CustomerBalanceSummary
        {
            RowCount = Convert.ToInt32(reader.GetInt64(0)),
            CustomerCount = Convert.ToInt32(reader.GetInt64(1)),
            OpeningDebit = reader.GetDecimal(2),
            OpeningCredit = reader.GetDecimal(3),
            DebitTotal = reader.GetDecimal(4),
            CreditTotal = reader.GetDecimal(5),
            ClosingDebit = reader.GetDecimal(6),
            ClosingCredit = reader.GetDecimal(7)
        };
    }

    private string BuildWhereSql(string? alias = "cab")
    {
        var prefix = string.IsNullOrWhiteSpace(alias) ? string.Empty : alias + ".";
        var conditions = new List<string>
        {
            $"{prefix}company_id = @CompanyId",
            $"{prefix}period_year = @PeriodYear"
        };

        if (_filterMonth.HasValue)
            conditions.Add($"{prefix}period_month = @PeriodMonth");

        if (!string.IsNullOrWhiteSpace(_filterAccountCode))
            conditions.Add($"{prefix}account_code = @AccountCode");

        if (_filterCustomerId.HasValue)
            conditions.Add($"{prefix}customer_id = @CustomerId");

        if (!string.IsNullOrWhiteSpace(_filterBookCode))
            conditions.Add($"{prefix}book_code = @BookCode");

        return "WHERE " + string.Join("\n  AND ", conditions);
    }

    private void AddFilterParameters(DbCommand command, string? alias = "cab")
    {
        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@PeriodYear", _filterYear, DbType.Int32);

        if (_filterMonth.HasValue)
            AddParameter(command, "@PeriodMonth", _filterMonth.Value, DbType.Int32);

        if (!string.IsNullOrWhiteSpace(_filterAccountCode))
            AddParameter(command, "@AccountCode", _filterAccountCode.Trim(), DbType.String);

        if (_filterCustomerId.HasValue)
            AddParameter(command, "@CustomerId", _filterCustomerId.Value, DbType.Guid);

        if (!string.IsNullOrWhiteSpace(_filterBookCode))
            AddParameter(command, "@BookCode", _filterBookCode.Trim(), DbType.String);
    }

    private static string BuildOrderBy(TableState state)
    {
        var column = state.SortLabel switch
        {
            "customer" => "customer_code",
            "account" => "cab.account_code",
            "period" => "cab.period_year, cab.period_month",
            "updated" => "cab.updated_at",
            _ => "cab.account_code, cab.period_year, cab.period_month, customer_code"
        };

        var direction = state.SortDirection == SortDirection.Descending ? "DESC" : "ASC";
        return $"{column} {direction}";
    }

    private async Task SaveBalanceAsync()
    {
        if (!_companyResolved || _saving)
            return;

        await _editForm!.Validate();
        if (!_editForm.IsValid)
            return;

        if (!_editCustomerId.HasValue)
        {
            Snackbar.Add("Chưa chọn khách hàng.", MudBlazor.Severity.Warning);
            return;
        }

        if (_editOpeningDebit > 0 && _editOpeningCredit > 0)
        {
            Snackbar.Add("Đầu kỳ không được đồng thời có cả số dư Nợ và số dư Có.", MudBlazor.Severity.Warning);
            return;
        }

        _saving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var connection = db.Database.GetDbConnection();
            var mustClose = connection.State != ConnectionState.Open;

            if (mustClose)
                await connection.OpenAsync();

            await using var transaction = await connection.BeginTransactionAsync();

            try
            {
                await using var command = connection.CreateCommand();
                command.Transaction = transaction;

                if (_editId.HasValue)
                {
                    command.CommandText = @"
UPDATE dbo.customer_account_balance
SET customer_id = @CustomerId,
    account_code = @AccountCode,
    period_year = @PeriodYear,
    period_month = @PeriodMonth,
    book_code = @BookCode,
    opening_debit = @OpeningDebit,
    opening_credit = @OpeningCredit,
    debit_total = @DebitTotal,
    credit_total = @CreditTotal,
    closing_debit = @ClosingDebit,
    closing_credit = @ClosingCredit,
    updated_at = SYSUTCDATETIME()
WHERE id = @Id
  AND company_id = @CompanyId;";

                    AddParameter(command, "@Id", _editId.Value, DbType.Guid);
                }
                else
                {
                    command.CommandText = @"
INSERT INTO dbo.customer_account_balance
(
    id,
    company_id,
    customer_id,
    account_code,
    period_year,
    period_month,
    book_code,
    opening_debit,
    opening_credit,
    debit_total,
    credit_total,
    closing_debit,
    closing_credit,
    created_at,
    updated_at
)
VALUES
(
    NEWID(),
    @CompanyId,
    @CustomerId,
    @AccountCode,
    @PeriodYear,
    @PeriodMonth,
    @BookCode,
    @OpeningDebit,
    @OpeningCredit,
    @DebitTotal,
    @CreditTotal,
    @ClosingDebit,
    @ClosingCredit,
    SYSUTCDATETIME(),
    SYSUTCDATETIME()
);";
                }

                AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
                AddParameter(command, "@CustomerId", _editCustomerId.Value, DbType.Guid);
                AddParameter(command, "@AccountCode", _editAccountCode.Trim(), DbType.String);
                AddParameter(command, "@PeriodYear", _editYear, DbType.Int32);
                AddParameter(command, "@PeriodMonth", _editMonth, DbType.Int32);
                AddNullableString(command, "@BookCode", _editBookCode);
                AddParameter(command, "@OpeningDebit", _editOpeningDebit, DbType.Decimal);
                AddParameter(command, "@OpeningCredit", _editOpeningCredit, DbType.Decimal);
                AddParameter(command, "@DebitTotal", _editDebitTotal, DbType.Decimal);
                AddParameter(command, "@CreditTotal", _editCreditTotal, DbType.Decimal);
                AddParameter(command, "@ClosingDebit", CalculatedClosingDebit, DbType.Decimal);
                AddParameter(command, "@ClosingCredit", CalculatedClosingCredit, DbType.Decimal);

                var affected = await command.ExecuteNonQueryAsync();
                if (_editId.HasValue && affected == 0)
                    throw new InvalidOperationException("Không tìm thấy dòng cần cập nhật hoặc dòng thuộc công ty khác.");

                await transaction.CommitAsync();
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }
            finally
            {
                if (mustClose)
                    await connection.CloseAsync();
            }

            Snackbar.Add(
                _editId.HasValue ? "Đã cập nhật số dư khách hàng." : "Đã thêm số dư khách hàng.",
                MudBlazor.Severity.Success);

            ResetEditor();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            var message = ex.Message.Contains("UX_customer_account_balance_business_key", StringComparison.OrdinalIgnoreCase) ||
                          ex.Message.Contains("duplicate", StringComparison.OrdinalIgnoreCase)
