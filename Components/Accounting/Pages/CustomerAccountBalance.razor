                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(!_companyResolved || _saving)"
                                       OnClick="SaveBalanceAsync">
                                @(_saving ? "ĐANG LƯU..." : _editId.HasValue ? "CẬP NHẬT" : "THÊM MỚI")
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       Disabled="@_saving"
                                       OnClick="ResetEditor">
                                Hủy chỉnh sửa
                            </MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="pa-4" Elevation="1">
        <MudTable T="CustomerBalanceRow"
                  @ref="_table"
                  ServerData="LoadServerDataAsync"
                  Loading="@_loading"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Striped="true"
                  Breakpoint="Breakpoint.None"
                  RowsPerPage="25">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Chi tiết số dư khách hàng</MudText>
