                    <MudItem xs="12">
                        @if (!string.IsNullOrWhiteSpace(EditorWarning))
                        {
                            <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-3">
                                @EditorWarning
                            </MudAlert>
