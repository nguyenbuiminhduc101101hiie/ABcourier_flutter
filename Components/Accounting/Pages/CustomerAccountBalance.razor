                <MudTd DataLabel="Kỳ">@context.PeriodMonth.ToString("00")/@context.PeriodYear</MudTd>
                <MudTd DataLabel="Mã sổ">@DisplayBookCode(context.BookCode)</MudTd>
                <MudTd DataLabel="ĐK Nợ" Align="Right">@FormatMoney(context.OpeningDebit)</MudTd>
                <MudTd DataLabel="ĐK Có" Align="Right">@FormatMoney(context.OpeningCredit)</MudTd>
                <MudTd DataLabel="PS Nợ" Align="Right">@FormatMoney(context.DebitTotal)</MudTd>
                <MudTd DataLabel="PS Có" Align="Right">@FormatMoney(context.CreditTotal)</MudTd>
                <MudTd DataLabel="CK Nợ" Align="Right">@FormatMoney(context.ClosingDebit)</MudTd>
                <MudTd DataLabel="CK Có" Align="Right">@FormatMoney(context.ClosingCredit)</MudTd>
                <MudTd DataLabel="Cập nhật">@context.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Thao tác">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
