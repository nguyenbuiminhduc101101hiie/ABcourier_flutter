            <HeaderContent>
                <MudTh><MudTableSortLabel T="CustomerBalanceRow" SortLabel="customer">Mã KH</MudTableSortLabel></MudTh>
                <MudTh>Tên khách hàng</MudTh>
                <MudTh><MudTableSortLabel T="CustomerBalanceRow" SortLabel="account">Tài khoản</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="CustomerBalanceRow" SortLabel="period">Kỳ</MudTableSortLabel></MudTh>
                <MudTh>Mã sổ</MudTh>
                <MudTh Align="Right">ĐK Nợ</MudTh>
                <MudTh Align="Right">ĐK Có</MudTh>
                <MudTh Align="Right">PS Nợ</MudTh>
                <MudTh Align="Right">PS Có</MudTh>
                <MudTh Align="Right">CK Nợ</MudTh>
                <MudTh Align="Right">CK Có</MudTh>
                <MudTh><MudTableSortLabel T="CustomerBalanceRow" SortLabel="updated">Cập nhật</MudTableSortLabel></MudTh>
