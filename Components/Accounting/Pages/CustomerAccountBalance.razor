    private async Task SyncAccountBalanceAsync()
    {
        if (!CanSyncAccountBalance || !_filterMonth.HasValue)
            return;

        var accountCode = _filterAccountCode!.Trim();
        var bookCode = NormalizeNullable(_filterBookCode);

        var confirmed = await DialogService.ShowMessageBox(
            "Cập nhật Account Balance",
            $"Cộng toàn bộ số dư khách hàng của tài khoản {accountCode}, " +
            $"tháng {_filterMonth.Value:00}/{_filterYear}, sổ {DisplayBookCode(bookCode)} " +
            "và ghi một dòng tổng hợp vào account_balance?",
            yesText: "Cập nhật",
            cancelText: "Hủy");

        if (confirmed != true)
            return;

        _saving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var connection = db.Database.GetDbConnection();
            var mustClose = connection.State != ConnectionState.Open;

            if (mustClose)
                await connection.OpenAsync();

            await using var transaction = await connection.BeginTransactionAsync();

            try
            {
                var totals = await ReadSyncTotalsAsync(
                    connection,
                    transaction,
                    accountCode,
                    _filterYear,
                    _filterMonth.Value,
                    bookCode);

                if (totals.RowCount == 0)
                    throw new InvalidOperationException("Không có số dư khách hàng phù hợp để cộng tổng.");

                var existingIds = await ReadAccountBalanceIdsAsync(
                    connection,
                    transaction,
                    accountCode,
                    _filterYear,
                    _filterMonth.Value,
                    bookCode);

                if (existingIds.Count > 1)
                {
                    throw new InvalidOperationException(
                        "account_balance đang có nhiều hơn một dòng cho cùng tài khoản/kỳ/mã sổ. " +
                        "Hãy xử lý dữ liệu trùng trước khi cập nhật.");
                }

                if (existingIds.Count == 1)
                {
                    await UpdateAccountBalanceAsync(
                        connection,
                        transaction,
                        existingIds[0],
                        totals,
                        accountCode,
                        _filterYear,
                        _filterMonth.Value,
                        bookCode);
                }
                else
                {
                    await InsertAccountBalanceAsync(
                        connection,
                        transaction,
                        totals,
                        accountCode,
                        _filterYear,
                        _filterMonth.Value,
                        bookCode);
                }

                await transaction.CommitAsync();

                Snackbar.Add(
                    $"Đã cập nhật account_balance từ {totals.RowCount:N0} dòng của " +
                    $"{totals.CustomerCount:N0} khách hàng.",
                    MudBlazor.Severity.Success);
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }
            finally
            {
                if (mustClose)
                    await connection.CloseAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<SyncTotals> ReadSyncTotalsAsync(
        DbConnection connection,
        DbTransaction transaction,
        string accountCode,
        int year,
        int month,
        string? bookCode)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT
    COUNT_BIG(1),
    COUNT_BIG(DISTINCT customer_id),
    COALESCE(SUM(opening_debit), 0),
    COALESCE(SUM(opening_credit), 0),
    COALESCE(SUM(debit_total), 0),
    COALESCE(SUM(credit_total), 0),
    COALESCE(SUM(closing_debit), 0),
    COALESCE(SUM(closing_credit), 0)
FROM dbo.customer_account_balance
WHERE company_id = @CompanyId
  AND account_code = @AccountCode
  AND period_year = @PeriodYear
  AND period_month = @PeriodMonth
  AND ((book_code = @BookCode) OR (book_code IS NULL AND @BookCode IS NULL));";

        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@AccountCode", accountCode, DbType.String);
        AddParameter(command, "@PeriodYear", year, DbType.Int32);
        AddParameter(command, "@PeriodMonth", month, DbType.Int32);
        AddNullableString(command, "@BookCode", bookCode);

        await using var reader = await command.ExecuteReaderAsync();
        await reader.ReadAsync();

        return new SyncTotals
        {
            RowCount = Convert.ToInt32(reader.GetInt64(0)),
            CustomerCount = Convert.ToInt32(reader.GetInt64(1)),
            OpeningDebit = reader.GetDecimal(2),
            OpeningCredit = reader.GetDecimal(3),
            DebitTotal = reader.GetDecimal(4),
            CreditTotal = reader.GetDecimal(5),
            ClosingDebit = reader.GetDecimal(6),
            ClosingCredit = reader.GetDecimal(7)
        };
    }

    private async Task<List<Guid>> ReadAccountBalanceIdsAsync(
        DbConnection connection,
        DbTransaction transaction,
        string accountCode,
        int year,
        int month,
        string? bookCode)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT id
FROM dbo.account_balance WITH (UPDLOCK, HOLDLOCK)
WHERE company_id = @CompanyId
  AND account_code = @AccountCode
  AND period_year = @PeriodYear
  AND period_month = @PeriodMonth
  AND ((book_code = @BookCode) OR (book_code IS NULL AND @BookCode IS NULL));";

        AddParameter(command, "@CompanyId", _companyId, DbType.Guid);
        AddParameter(command, "@AccountCode", accountCode, DbType.String);
        AddParameter(command, "@PeriodYear", year, DbType.Int32);
        AddParameter(command, "@PeriodMonth", month, DbType.Int32);
        AddNullableString(command, "@BookCode", bookCode);

        var ids = new List<Guid>();
        await using var reader = await command.ExecuteReaderAsync();
        while (await reader.ReadAsync())
            ids.Add(reader.GetGuid(0));

        return ids;
    }

    private async Task UpdateAccountBalanceAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid id,
        SyncTotals totals,
        string accountCode,
        int year,
        int month,
        string? bookCode)
    {
        var fromDate = new DateTime(year, month, 1);
        var toDate = fromDate.AddMonths(1).AddSeconds(-1);
        var openingNet = totals.OpeningDebit - totals.OpeningCredit;
        var closingNet = totals.ClosingDebit - totals.ClosingCredit;

        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
UPDATE dbo.account_balance
SET opening_balance = @OpeningBalance,
    debit_total = @DebitTotal,
    credit_total = @CreditTotal,
    closing_balance = @ClosingBalance,
    account_type = @AccountType,
    calculated_from = @CalculatedFrom,
    calculated_to = @CalculatedTo,
    last_calculated_at = SYSUTCDATETIME(),
    updated_at = SYSUTCDATETIME(),
    openingdebit = @OpeningDebit,
    openingcredit = @OpeningCredit,
    closingdebit = @ClosingDebit,
    closingcredit = @ClosingCredit,
    opening_debit = @OpeningDebit,
    opening_credit = @OpeningCredit,
    closing_debit = @ClosingDebit,
    closing_credit = @ClosingCredit
WHERE id = @Id;";

        AddParameter(command, "@Id", id, DbType.Guid);
        AddParameter(command, "@OpeningBalance", openingNet, DbType.Decimal);
        AddParameter(command, "@DebitTotal", totals.DebitTotal, DbType.Decimal);
        AddParameter(command, "@CreditTotal", totals.CreditTotal, DbType.Decimal);
        AddParameter(command, "@ClosingBalance", closingNet, DbType.Decimal);
        AddNullableString(command, "@AccountType", ResolveAccountType(totals));
        AddParameter(command, "@CalculatedFrom", fromDate, DbType.DateTime2);
        AddParameter(command, "@CalculatedTo", toDate, DbType.DateTime2);
        AddParameter(command, "@OpeningDebit", totals.OpeningDebit, DbType.Decimal);
        AddParameter(command, "@OpeningCredit", totals.OpeningCredit, DbType.Decimal);
        AddParameter(command, "@ClosingDebit", totals.ClosingDebit, DbType.Decimal);
        AddParameter(command, "@ClosingCredit", totals.ClosingCredit, DbType.Decimal);

        await command.ExecuteNonQueryAsync();
    }

