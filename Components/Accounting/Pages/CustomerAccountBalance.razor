@page "/accounting/customer-account-balance"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Data
@using System.Data.Common
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Models.Accounting.ExcelImport
@using ABFreight.Services.Accounting.ExcelImport

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IAccountBalanceExcelImportService ImportService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Số dư công nợ khách hàng</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="flex-wrap">
            <div>
                <MudText Typo="Typo.h5">Customer Account Balance</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Quản lý số dư chi tiết theo khách hàng, tài khoản, năm, tháng và mã sổ
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           Disabled="@(_loading || _saving || _readingImport || _importing)"
                           OnClick="ToggleImportPanel">
                    @(_importExpanded ? "Đóng import" : "Import Excel")
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_loading"
                           OnClick="ReloadAsync">
                    Làm mới
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!_companyResolved)
    {
        <MudAlert Severity="MudBlazor.Severity.Warning" Variant="Variant.Outlined">
            Không lấy được CompanyId từ claim đăng nhập. Hãy chọn công ty ở bộ lọc bên dưới.
        </MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-3">Bộ lọc</MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="Guid"
                           Label="Công ty"
                           Value="_companyId"
                           ValueChanged="OnCompanyChangedAsync"
                           Disabled="@_loading"
                           Required="true"
                           HelperText="@_companySourceHint">
                    @foreach (var company in _companies)
                    {
                        <MudSelectItem T="Guid" Value="@company.Customer_ID">
                            @CompanyLabel(company)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudNumericField T="int"
                                 Label="Năm"
                                 @bind-Value="_filterYear"
                                 Min="2000"
                                 Max="2200"
                                 HideSpinButtons="true"
                                 Disabled="@_loading" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="int?"
                           Label="Tháng"
                           @bind-Value="_filterMonth"
                           Clearable="true"
                           Disabled="@_loading">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <MudSelectItem T="int?" Value="@((int?)month)">Tháng @month</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudTextField T="string"
                              Label="Tài khoản"
                              @bind-Value="_filterAccountCode"
                              Immediate="true"
                              MaxLength="20"
                              Placeholder="Ví dụ: 131"
                              Disabled="@_loading" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudTextField T="string"
                              Label="Mã sổ"
                              @bind-Value="_filterBookCode"
                              Immediate="true"
                              MaxLength="50"
                              Placeholder="Để trống = tất cả"
                              Disabled="@_loading" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="Guid?"
                           Label="Khách hàng"
                           @bind-Value="_filterCustomerId"
                           Clearable="true"
                           Disabled="@_loading">
                    @foreach (var customer in _customers)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)customer.Customer_ID)">
                            @CustomerLabel(customer)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="h-100 flex-wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@(!_companyResolved || _loading)"
                               OnClick="ApplyFilterAsync">
                        Tìm kiếm
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.FilterAltOff"
                               Disabled="@_loading"
                               OnClick="ClearFilterAsync">
                        Xóa lọc
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Calculate"
                               Disabled="@(!CanSyncAccountBalance || _loading || _saving)"
                               OnClick="SyncAccountBalanceAsync">
                        Cập nhật Account Balance
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_importExpanded)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Class="mb-3 flex-wrap">
                <div>
                    <MudText Typo="Typo.h6">Import Excel số dư công nợ khách hàng</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Mã KH trong Excel được đối chiếu với mã số thuế Customer.TaxCode,
                        sau đó lưu từng khách hàng vào customer_account_balance
                    </MudText>
                </div>

                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           Disabled="@(_readingImport || _importing)"
                           OnClick="ResetImport">
                    Xóa dữ liệu import
                </MudButton>
            </MudStack>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="ExistingBalanceImportMode"
                               Label="Xử lý dữ liệu đã tồn tại"
                               @bind-Value="_importExistingMode"
                               Disabled="@(_readingImport || _importing)">
                        <MudSelectItem T="ExistingBalanceImportMode"
                                       Value="@ExistingBalanceImportMode.RejectExisting">
                            An toàn - Báo lỗi nếu đã tồn tại
                        </MudSelectItem>
                        <MudSelectItem T="ExistingBalanceImportMode"
                                       Value="@ExistingBalanceImportMode.UpdateExisting">
                            Cập nhật số dư khách hàng hiện có
                        </MudSelectItem>
                        <MudSelectItem T="ExistingBalanceImportMode"
                                       Value="@ExistingBalanceImportMode.ReplaceCurrentAccountPeriod">
                            Xóa và thay thế toàn bộ tài khoản/kỳ/sổ
                        </MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudTextField T="string"
                                  Label="Mã sổ khi import"
                                  @bind-Value="_importBookCode"
                                  MaxLength="50"
                                  Placeholder="Để trống = NULL"
                                  Disabled="@(_readingImport || _importing)" />
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudCheckBox T="bool"
                                 Label="Sau khi import, tự cộng tổng và cập nhật account_balance"
                                 @bind-Value="_syncAccountBalanceAfterImport"
                                 Disabled="@(_readingImport || _importing)" />
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Class="pa-4 upload-box" Outlined="true">
                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Spacing="3"
                                  Class="flex-wrap">
                            <InputFile OnChange="HandleCustomerBalanceFileSelectedAsync"
                                       accept=".xlsx,.xlsm"
                                       disabled="@(_readingImport || _importing || !_companyResolved)" />

                            @if (_readingImport)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Color="Color.Primary" />
                                <MudText>Đang đọc file và đối chiếu mã số thuế...</MudText>
                            }
                            else if (!string.IsNullOrWhiteSpace(_importFileName))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Description"
                                         Color="Color.Primary" />
                                <MudText>@_importFileName</MudText>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudAlert Severity="MudBlazor.Severity.Info"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="mt-3">
                Dữ liệu gốc được lưu vào <b>customer_account_balance</b> theo Customer_ID.
                Bảng <b>account_balance</b> chỉ nhận một dòng tổng hợp theo tài khoản, kỳ và mã sổ.
            </MudAlert>

            @if (_importPreview is not null)
            {
                <MudDivider Class="my-4" />

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Label="Đơn vị trong file"
                                      Value="_importPreview.CompanyNameInFile"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudTextField T="string"
                                      Label="MST đơn vị"
                                      Value="_importPreview.TaxCodeInFile"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudTextField T="string"
                                      Label="Tài khoản"
                                      @bind-Value="_importPreview.AccountCode"
                                      Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="int"
                                         Label="Năm"
                                         @bind-Value="_importPreview.FiscalYear"
                                         Min="2000"
                                         Max="2200"
                                         HideSpinButtons="true" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="int"
                                         Label="Tháng"
                                         @bind-Value="_importPreview.PeriodNo"
                                         Min="1"
                                         Max="12"
                                         HideSpinButtons="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6" lg="3">
                        <MudPaper Class="pa-3 import-summary-card" Outlined="true">
                            <MudText Typo="Typo.caption">Khách hàng đã khớp MST</MudText>
                            <MudText Typo="Typo.h6">@MatchedImportCustomerCount.ToString("N0")</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" lg="3">
                        <MudPaper Class="pa-3 import-summary-card" Outlined="true">
                            <MudText Typo="Typo.caption">Không khớp / trùng MST</MudText>
                            <MudText Typo="Typo.h6" Color="@(UnmatchedImportCustomerCount > 0 ? Color.Error : Color.Success)">
                                @UnmatchedImportCustomerCount.ToString("N0")
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" lg="3">
                        <MudPaper Class="pa-3 import-summary-card" Outlined="true">
                            <MudText Typo="Typo.caption">Lỗi dữ liệu Excel</MudText>
                            <MudText Typo="Typo.h6" Color="@(_importPreview.ErrorCount > 0 ? Color.Error : Color.Success)">
                                @_importPreview.ErrorCount.ToString("N0")
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" lg="3">
                        <MudPaper Class="pa-3 import-summary-card" Outlined="true">
                            <MudText Typo="Typo.caption">Số dòng sẽ ghi sau khi gộp KH</MudText>
                            <MudText Typo="Typo.h6">@ImportWriteRowCount.ToString("N0")</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @foreach (var message in _importPreview.Messages)
                {
                    <MudAlert Severity="@ToSeverity(message.Level)"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mt-2">
                        @if (message.ExcelRowNo.HasValue)
                        {
                            <b>Dòng Excel @message.ExcelRowNo:</b>
                        }
                        @message.Message
                    </MudAlert>
                }

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mt-4 mb-2 flex-wrap">
                    <MudText Typo="Typo.h6">Xem trước và đối chiếu khách hàng</MudText>
                    <MudCheckBox T="bool"
                                 Label="Chỉ hiện dòng lỗi/cảnh báo"
                                 @bind-Value="_showOnlyImportProblems" />
                </MudStack>

                <div class="import-preview-scroll">
                    <MudTable T="AccountBalanceExcelLine"
                              Items="@VisibleImportLines"
                              Dense="true"
                              Hover="true"
                              Bordered="true"
                              Striped="true"
                              Breakpoint="Breakpoint.None"
                              RowClassFunc="GetImportRowClass">
                        <HeaderContent>
                            <MudTh>Dòng</MudTh>
                            <MudTh>Mã KH/MST</MudTh>
                            <MudTh>Tên trong file</MudTh>
                            <MudTh>Customer_ID</MudTh>
                            <MudTh>Khách hàng hệ thống</MudTh>
                            <MudTh Align="Right">ĐK Nợ</MudTh>
                            <MudTh Align="Right">ĐK Có</MudTh>
                            <MudTh Align="Right">PS Nợ</MudTh>
                            <MudTh Align="Right">PS Có</MudTh>
                            <MudTh Align="Right">CK Nợ</MudTh>
                            <MudTh Align="Right">CK Có</MudTh>
                            <MudTh>Kết quả</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Dòng">@context.ExcelRowNo</MudTd>
                            <MudTd DataLabel="Mã KH/MST">@context.CustomerCode</MudTd>
                            <MudTd DataLabel="Tên trong file">@context.CustomerName</MudTd>
                            <MudTd DataLabel="Customer_ID">
                                @if (GetImportCustomerMatch(context)?.CustomerId is Guid customerId)
                                {
                                    <MudTooltip Text="@customerId.ToString()">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Success"
                                                 Variant="Variant.Outlined">
                                            @ShortGuid(customerId)
                                        </MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                                             Color="Color.Error"
                                             Size="Size.Small" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Khách hàng hệ thống">
                                @{
                                    var match = GetImportCustomerMatch(context);
                                }
                                @if (match?.CustomerId is not null)
                                {
                                    <MudText Typo="Typo.body2">@match.CustomerName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        MST: @match.TaxCode
                                    </MudText>
                                }
                                else
                                {
                                    <MudTooltip Text="@(match?.ErrorText ?? "Chưa đối chiếu")">
                                        <MudText Typo="Typo.body2" Color="Color.Error">
                                            @(match?.ErrorText ?? "Chưa đối chiếu")
                                        </MudText>
                                    </MudTooltip>
                                }
                            </MudTd>
                            <MudTd DataLabel="ĐK Nợ" Align="Right">@FormatMoney(context.OpeningDebit)</MudTd>
                            <MudTd DataLabel="ĐK Có" Align="Right">@FormatMoney(context.OpeningCredit)</MudTd>
                            <MudTd DataLabel="PS Nợ" Align="Right">@FormatMoney(context.PeriodDebit)</MudTd>
                            <MudTd DataLabel="PS Có" Align="Right">@FormatMoney(context.PeriodCredit)</MudTd>
                            <MudTd DataLabel="CK Nợ" Align="Right">@FormatMoney(context.ClosingDebit)</MudTd>
                            <MudTd DataLabel="CK Có" Align="Right">@FormatMoney(context.ClosingCredit)</MudTd>
                            <MudTd DataLabel="Kết quả">
                                @if (context.HasError)
                                {
                                    <MudTooltip Text="@context.ErrorText">
                                        <MudIcon Icon="@Icons.Material.Filled.Error"
                                                 Color="Color.Error"
                                                 Size="Size.Small" />
                                    </MudTooltip>
                                }
                                else if (HasImportCustomerProblem(context))
                                {
                                    <MudTooltip Text="@(GetImportCustomerMatch(context)?.ErrorText ?? "Không khớp khách hàng")">
                                        <MudIcon Icon="@Icons.Material.Filled.PersonOff"
                                                 Color="Color.Error"
                                                 Size="Size.Small" />
                                    </MudTooltip>
                                }
                                else if (context.HasWarning)
                                {
                                    <MudTooltip Text="@context.WarningText">
                                        <MudIcon Icon="@Icons.Material.Filled.Warning"
                                                 Color="Color.Warning"
                                                 Size="Size.Small" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Đã khớp mã số thuế và sẵn sàng import">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                 Color="Color.Success"
                                                 Size="Size.Small" />
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <MudDivider Class="my-4" />

                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Publish"
                               Disabled="@(!CanCommitCustomerBalanceImport)"
                               OnClick="CommitCustomerBalanceImportAsync">
                        @(_importing ? "ĐANG IMPORT..." : "IMPORT VÀO CUSTOMER ACCOUNT BALANCE")
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               Disabled="@(_readingImport || _importing)"
                               OnClick="ResetImport">
                        Hủy dữ liệu xem trước
                    </MudButton>

                    @if (_customerImportResult is not null)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Success" Dense="true">
                            Import thành công: thêm @_customerImportResult.InsertedCount,
                            cập nhật @_customerImportResult.UpdatedCount,
                            xóa @_customerImportResult.DeletedCount dòng;
                            tổng @_customerImportResult.CustomerCount khách hàng.
                            @if (_customerImportResult.AccountBalanceSynced)
                            {
                                <span> Đã cập nhật account_balance.</span>
                            }
                        </MudAlert>
                    }
                </MudStack>
            }
        </MudPaper>
    }

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-3 summary-card" Outlined="true">
                <MudText Typo="Typo.caption">Số khách hàng</MudText>
                <MudText Typo="Typo.h6">@_summary.CustomerCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_summary.RowCount.ToString("N0") dòng số dư
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-3 summary-card" Outlined="true">
                <MudText Typo="Typo.caption">Đầu kỳ</MudText>
                <MudText Typo="Typo.body1">Nợ: @FormatMoney(_summary.OpeningDebit)</MudText>
                <MudText Typo="Typo.body1">Có: @FormatMoney(_summary.OpeningCredit)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-3 summary-card" Outlined="true">
                <MudText Typo="Typo.caption">Phát sinh</MudText>
                <MudText Typo="Typo.body1">Nợ: @FormatMoney(_summary.DebitTotal)</MudText>
                <MudText Typo="Typo.body1">Có: @FormatMoney(_summary.CreditTotal)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Class="pa-3 summary-card" Outlined="true">
                <MudText Typo="Typo.caption">Cuối kỳ</MudText>
                <MudText Typo="Typo.body1">Nợ: @FormatMoney(_summary.ClosingDebit)</MudText>
                <MudText Typo="Typo.body1">Có: @FormatMoney(_summary.ClosingCredit)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudExpansionPanels>
        <MudExpansionPanel Text="Thêm hoặc chỉnh sửa số dư khách hàng"
                           @bind-Expanded="_editorExpanded">
            <MudForm @ref="_editForm">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudSelect T="Guid?"
                                   Label="Khách hàng"
                                   @bind-Value="_editCustomerId"
                                   Required="true"
                                   RequiredError="Chưa chọn khách hàng"
                                   Disabled="@_saving">
                            @foreach (var customer in _customers)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)customer.Customer_ID)">
                                    @CustomerLabel(customer)
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudTextField T="string"
                                      Label="Tài khoản"
                                      @bind-Value="_editAccountCode"
                                      Required="true"
                                      RequiredError="Chưa nhập tài khoản"
                                      MaxLength="20"
                                      Disabled="@_saving" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="int"
                                         Label="Năm"
                                         @bind-Value="_editYear"
                                         Min="2000"
                                         Max="2200"
                                         Required="true"
                                         HideSpinButtons="true"
                                         Disabled="@_saving" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudSelect T="int"
                                   Label="Tháng"
                                   @bind-Value="_editMonth"
                                   Required="true"
                                   Disabled="@_saving">
                            @for (var month = 1; month <= 12; month++)
                            {
                                <MudSelectItem T="int" Value="@month">Tháng @month</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudTextField T="string"
                                      Label="Mã sổ"
                                      @bind-Value="_editBookCode"
                                      MaxLength="50"
                                      Placeholder="Để trống = NULL"
                                      Disabled="@_saving" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal"
                                         Label="Đầu kỳ Nợ"
                                         @bind-Value="_editOpeningDebit"
                                         Min="0"
                                         Immediate="true"
                                         HideSpinButtons="true"
                                         Format="N2"
                                         Disabled="@_saving" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal"
                                         Label="Đầu kỳ Có"
                                         @bind-Value="_editOpeningCredit"
                                         Min="0"
                                         Immediate="true"
                                         HideSpinButtons="true"
                                         Format="N2"
                                         Disabled="@_saving" />
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudNumericField T="decimal"
                                         Label="Phát sinh Nợ"
