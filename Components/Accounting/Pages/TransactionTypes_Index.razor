@page "/TransactionTypes"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["TransactionTypes_Title"]</PageTitle>

<div class="product-price-page transaction-type-page">
    <PpScreenHeader Title="@($"10.5 {Localizer["TransactionTypes_Title"]}")" Subtitle="Transaction types · cấu hình mẫu bút toán tự động">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="tt-toolbar flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddTransactionTypeDialogAsync" Disabled="_busy">Thêm loại CT</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditTransactionTypeDialogAsync" Disabled="_busy || _selected is null">Sửa</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="OpenDetailsDialogAsync" Disabled="_busy || _selected is null">Cấu hình dòng</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null">Xóa</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">Reload</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" sm="3">
            <MudPaper Class="tt-stat-card active-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="tt-stat-icon" />
                <MudText Typo="Typo.caption">Active Types</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_items.Count(x => x.IsActive == true).ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="tt-stat-card inactive-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Block" Class="tt-stat-icon" />
                <MudText Typo="Typo.caption">Inactive Types</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_items.Count(x => x.IsActive != true).ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="tt-stat-card detail-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="tt-stat-icon" />
                <MudText Typo="Typo.caption">Mapping Lines</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_mappingItems.Count.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudPaper Class="tt-stat-card selected-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.TouchApp" Class="tt-stat-icon" />
                <MudText Typo="Typo.caption">Selected</MudText>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">@(_selected?.Code ?? "None")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="product-price-card tt-guide-card pa-3 mb-2" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold guide-title">
                    Hướng dẫn ghi Nợ / Có
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Dùng để kiểm tra nhanh cấu hình dòng hạch toán trước khi hệ thống sinh phiếu kế toán tự động.
                </MudText>
            </MudStack>
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                Debit / Credit guide
            </MudChip>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudPaper Class="guide-box debit-guide" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Bên Nợ thường dùng</MudText>
                    <MudText Typo="Typo.body2">
                        Ghi Nợ khi <b>tăng tài sản</b>, <b>tăng chi phí</b>, hoặc <b>giảm công nợ phải trả</b>.
                    </MudText>
                    <MudText Typo="Typo.caption">
                        Ví dụ: 111, 112, 131, 1331, 156, 632, 641, 642.
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="guide-box credit-guide" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Bên Có thường dùng</MudText>
                    <MudText Typo="Typo.body2">
                        Ghi Có khi <b>giảm tài sản</b>, <b>tăng doanh thu</b>, hoặc <b>tăng công nợ phải trả</b>.
                    </MudText>
                    <MudText Typo="Typo.caption">
                        Ví dụ: 111, 112, 131, 331, 33311, 511, 411, 421.
                    </MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="guide-box balance-guide" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Nguyên tắc bắt buộc</MudText>
                    <MudText Typo="Typo.body2">
                        Mỗi nghiệp vụ phải cân: <b>Tổng Nợ = Tổng Có</b>.
                    </MudText>
                    <MudText Typo="Typo.caption">
                        Nếu lệch, phiếu không nên cho duyệt / ghi sổ.
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTable Items="_postingExamples" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0" Class="tt-guide-table mt-2">
            <HeaderContent>
                <MudTh>Nghiệp vụ</MudTh>
                <MudTh>Định khoản mẫu</MudTh>
                <MudTh>Giải thích</MudTh>
            </HeaderContent>
            <RowTemplate Context="ex">
                <MudTd DataLabel="Nghiệp vụ">@ex.Title</MudTd>
                <MudTd DataLabel="Định khoản mẫu">
                    @foreach (var line in ex.EntryLines)
                    {
                        <div>@line</div>
                    }
                </MudTd>
                <MudTd DataLabel="Giải thích">@ex.Explanation</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudPaper Class="product-price-card tt-main-card pa-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center" Class="mb-2">
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_search"
                              Class="tt-search"
                              Label="Tìm kiếm"
                              Placeholder="Code, tên nghiệp vụ, mô tả..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="7">
                <MudPaper Class="tt-selected-panel pa-2" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                Loại chứng từ đang chọn: @(_selected == null ? "Chưa chọn" : $"{_selected.Code} - {_selected.Name}")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Details: @GetSelectedDetails().Count dòng | @_selected?.Description
                            </MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(_selected?.IsActive == true ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled">
                            @(_selected?.IsActive == true ? "Active" : "Inactive")
                        </MudChip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudDataGrid T="M_TransactionTypes"
                     Class="transaction-types-grid"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     RowClick="OnRowClick"
                     RowClassFunc="RowClass"
                     Height="calc(100vh - 280px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <HierarchyColumn T="M_TransactionTypes" Filterable="false" />

                <TemplateColumn Title="Status" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(context.Item.IsActive == true ? Color.Success : Color.Warning)"
                                 Variant="Variant.Filled">
                            @(context.Item.IsActive == true ? "Active" : "Inactive")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Code" Title="Mã nghiệp vụ" />
                <PropertyColumn Property="x => x.Name" Title="Tên nghiệp vụ" />
                <PropertyColumn Property="x => x.Description" Title="Mô tả" />

                <TemplateColumn Title="Số dòng" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @GetDetailsByTransactionId(context.Item.Id).Count
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Action" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   OnClick="@(() => OpenDetailsFromGrid(context.Item))">
                            Details
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                @if (_expandedRowIds.Contains(context.Item.Id))
                {
                    var details = GetDetailsByTransactionId(context.Item.Id);
                    <MudPaper Class="tt-details-panel" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle2" Class="mb-1 tt-details-title">
                            Cấu hình hạch toán: @context.Item.Code - @context.Item.Name
                        </MudText>
                        @if (details.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Chưa có dòng mapping cho nghiệp vụ này.
                            </MudText>
                        }
                        else
                        {
                            var detailRows = BuildDetailGuideRows(details);

                            <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                                Mỗi dòng bên dưới là một dòng bút toán hệ thống sẽ sinh ra. Đọc theo thứ tự SortOrder: dòng nào ghi Nợ, dòng nào ghi Có, tài khoản nào bị tăng/giảm và vì sao phải ghi như vậy.
                            </MudAlert>

                            <MudTable Items="detailRows" Class="tt-detail-table" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Dòng</MudTh>
                                    <MudTh>Loại dòng</MudTh>
                                    <MudTh>Nợ / Có</MudTh>
                                    <MudTh>Tài khoản</MudTh>
                                    <MudTh>Tên tài khoản</MudTh>
                                    <MudTh>Ý nghĩa dòng này</MudTh>
                                    <MudTh>Giải thích cách hạch toán</MudTh>
                                    <MudTh>Thứ tự</MudTh>
                                    <MudTh>Trạng thái</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="detail">
                                    <MudTd DataLabel="Dòng" Class="fw-bold">@detail.LineNo</MudTd>
                                    <MudTd DataLabel="Line Type">@detail.LineType</MudTd>
                                    <MudTd DataLabel="Nợ / Có">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@detail.SideColor"
                                                 Variant="Variant.Filled">
                                            @detail.Side
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Account Code" Class="fw-bold">@detail.AccountCode</MudTd>
                                    <MudTd DataLabel="Account Name">@detail.AccountName</MudTd>
                                    <MudTd DataLabel="Ý nghĩa dòng này" Class="line-meaning-cell">
                                        @detail.ShortExplanation
                                    </MudTd>
                                    <MudTd DataLabel="Giải thích cách hạch toán" Class="line-explain-cell">
                                        @detail.FullExplanation
                                    </MudTd>
                                    <MudTd DataLabel="Sort Order">@detail.SortOrder</MudTd>
                                    <MudTd DataLabel="Trạng thái">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@detail.StatusColor"
                                                 Variant="Variant.Outlined">
                                            @detail.StatusText
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                }
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="M_TransactionTypes" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "TransactionTypes";
    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private List<M_TransactionTypes> _items = new();
    private List<M_TransactionTypeMappings> _mappingItems = new();
    private Dictionary<Guid, DanhMucTaiKhoan> _danhMucById = new();
    private readonly HashSet<Guid> _expandedRowIds = new();
    private M_TransactionTypes? _selected;
    private M_TransactionTypes _edit = new() { IsActive = true };

    private readonly List<PostingExample> _postingExamples = new()
    {
        new PostingExample
        {
            Title = "Bán dịch vụ / ghi nhận phải thu khách hàng",
            EntryLines = new List<string> { "Nợ 131 - Phải thu khách hàng", "Có 511 - Doanh thu", "Có 33311 - Thuế GTGT đầu ra" },
            Explanation = "Tăng công nợ khách hàng và ghi nhận doanh thu, thuế GTGT phải nộp."
        },
        new PostingExample
        {
            Title = "Khách hàng thanh toán",
            EntryLines = new List<string> { "Nợ 111/112 - Tiền mặt/ngân hàng", "Có 131 - Phải thu khách hàng" },
            Explanation = "Tiền tăng, đồng thời giảm công nợ phải thu của khách hàng."
        },
        new PostingExample
        {
            Title = "Ghi nhận chi phí hãng tàu / vendor",
            EntryLines = new List<string> { "Nợ 632/641/642 - Chi phí", "Nợ 1331 - Thuế GTGT đầu vào", "Có 331 - Phải trả vendor" },
            Explanation = "Ghi nhận chi phí và thuế đầu vào, đồng thời tăng công nợ phải trả vendor."
        },
        new PostingExample
        {
            Title = "Thanh toán cho vendor / hãng tàu",
            EntryLines = new List<string> { "Nợ 331 - Phải trả vendor", "Có 111/112 - Tiền mặt/ngân hàng" },
            Explanation = "Giảm công nợ phải trả, đồng thời giảm tiền."
        }
    };

    private IEnumerable<M_TransactionTypes> VisibleItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x =>
                (x.Code?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            _items.Clear();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.TransactionTypes.AsNoTracking().OrderBy(x => x.Code).ToListAsync();
            _mappingItems = await db.TransactionTypeMappings.AsNoTracking()
                .OrderBy(x => x.TransactionID)
                .ThenBy(x => x.SortOrder)
                .ToListAsync();
            var danhMucs = await db.DanhMucTaiKhoan.AsNoTracking().ToListAsync();
            _danhMucById = danhMucs.ToDictionary(x => x.Id, x => x);
            _selected = null;
            _expandedRowIds.Clear();
            _edit = new M_TransactionTypes { IsActive = true };
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<M_TransactionTypes> args)
    {
        _selected = args.Item;
        if (_expandedRowIds.Contains(args.Item.Id))
            _expandedRowIds.Remove(args.Item.Id);
        else
            _expandedRowIds.Add(args.Item.Id);

        _edit = new M_TransactionTypes
        {
            Id = args.Item.Id,
            Code = args.Item.Code,
            Name = args.Item.Name,
            Description = args.Item.Description,
            IsActive = args.Item.IsActive
        };
    }

    private string RowClass(M_TransactionTypes row, int _) => _selected?.Id == row.Id ? "selected-row-blue" : string.Empty;
    private List<M_TransactionTypeMappings> GetSelectedDetails() =>
        _selected is null
            ? new List<M_TransactionTypeMappings>()
            : _mappingItems.Where(x => x.TransactionID == _selected.Id).OrderBy(x => x.SortOrder).ToList();
    private List<M_TransactionTypeMappings> GetDetailsByTransactionId(Guid transactionId) =>
        _mappingItems.Where(x => x.TransactionID == transactionId).OrderBy(x => x.SortOrder).ToList();
    private string GetDanhMucCode(Guid? id) =>
        id is null || id == Guid.Empty || !_danhMucById.TryGetValue(id.Value, out var dm)
            ? string.Empty
            : (dm.Taikhoan ?? string.Empty);
    private string GetDanhMucName(Guid? id) =>
        id is null || id == Guid.Empty || !_danhMucById.TryGetValue(id.Value, out var dm)
            ? string.Empty
            : (!string.IsNullOrWhiteSpace(dm.Accountname) ? dm.Accountname! : (dm.Tentaikhoan ?? string.Empty));

    private static string NormalizeLineType(string? lineType)
    {
        return string.IsNullOrWhiteSpace(lineType)
            ? string.Empty
            : lineType.Trim().ToUpperInvariant();
    }

    private static string GetDebitCreditSide(string? lineType)
    {
        var type = NormalizeLineType(lineType);

        if (type.Contains("DEBIT") || type.Contains("DR") || type.Contains("NO") || type.Contains("NỢ"))
            return "Nợ";

        if (type.Contains("CREDIT") || type.Contains("CR") || type.Contains("CO") || type.Contains("CÓ"))
            return "Có";

        return "Chưa rõ";
    }

    private static Color GetDebitCreditColor(string? lineType)
    {
        var side = GetDebitCreditSide(lineType);
        return side == "Nợ" ? Color.Info :
               side == "Có" ? Color.Warning :
               Color.Default;
    }

    private static string GetDebitCreditExplanation(string? lineType, string accountCode, string accountName)
    {
        var side = GetDebitCreditSide(lineType);
        var acc = string.IsNullOrWhiteSpace(accountCode) ? string.Empty : accountCode.Trim();

        if (side == "Nợ")
        {
            if (acc.StartsWith("111") || acc.StartsWith("112"))
                return "Ghi Nợ để tăng tiền mặt / tiền gửi ngân hàng.";
            if (acc.StartsWith("131"))
                return "Ghi Nợ 131 để tăng công nợ phải thu khách hàng.";
            if (acc.StartsWith("133"))
                return "Ghi Nợ 1331 để ghi nhận thuế GTGT đầu vào được khấu trừ.";
            if (acc.StartsWith("331"))
                return "Ghi Nợ 331 để giảm công nợ phải trả vendor.";
            if (acc.StartsWith("6") || acc.StartsWith("8"))
                return "Ghi Nợ để ghi nhận chi phí phát sinh.";
            if (acc.StartsWith("1") || acc.StartsWith("2"))
                return "Ghi Nợ để tăng tài sản.";
            return $"Ghi Nợ tài khoản {acc} {accountName}.";
        }

        if (side == "Có")
        {
            if (acc.StartsWith("111") || acc.StartsWith("112"))
                return "Ghi Có để giảm tiền mặt / tiền gửi ngân hàng.";
            if (acc.StartsWith("131"))
                return "Ghi Có 131 để giảm công nợ phải thu khách hàng.";
            if (acc.StartsWith("331"))
                return "Ghi Có 331 để tăng công nợ phải trả vendor.";
            if (acc.StartsWith("333"))
                return "Ghi Có 333 để ghi nhận thuế phải nộp.";
            if (acc.StartsWith("511") || acc.StartsWith("5") || acc.StartsWith("7"))
                return "Ghi Có để ghi nhận doanh thu / thu nhập.";
            return $"Ghi Có tài khoản {acc} {accountName}.";
        }

        return "Chưa xác định được Nợ/Có từ LineType. Nên đặt LineType rõ: Debit hoặc Credit.";
    }

    private sealed class PostingExample
    {
        public string Title { get; set; } = string.Empty;
        public List<string> EntryLines { get; set; } = new();
        public string Explanation { get; set; } = string.Empty;
    }

    private sealed class TransactionDetailGuideRow
    {
        public int LineNo { get; set; }
        public string LineType { get; set; } = string.Empty;
        public string Side { get; set; } = string.Empty;
        public Color SideColor { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string ShortExplanation { get; set; } = string.Empty;
        public string FullExplanation { get; set; } = string.Empty;
        public int SortOrder { get; set; }
        public string StatusText { get; set; } = string.Empty;
        public Color StatusColor { get; set; }
    }

    private List<TransactionDetailGuideRow> BuildDetailGuideRows(List<M_TransactionTypeMappings> details)
    {
        return details
            .OrderBy(x => x.SortOrder ?? 0)
            .Select((detail, index) =>
            {
                var accountCode = GetDanhMucCode(detail.DanhMucTaiKhoanID);
                var accountName = GetDanhMucName(detail.DanhMucTaiKhoanID);
                var side = GetDebitCreditSide(detail.LineType);
                var lineNo = index + 1;

                return new TransactionDetailGuideRow
                {
                    LineNo = lineNo,
                    LineType = string.IsNullOrWhiteSpace(detail.LineType) ? "—" : detail.LineType!.Trim(),
                    Side = side,
                    SideColor = GetDebitCreditColor(detail.LineType),
                    AccountCode = accountCode,
                    AccountName = accountName,
                    ShortExplanation = GetDebitCreditExplanation(detail.LineType, accountCode, accountName),
                    FullExplanation = GetLineFullExplanation(lineNo, details.Count, detail.LineType, accountCode, accountName),
                    SortOrder = detail.SortOrder ?? 0,
                    StatusText = detail.IsActive == true ? "Active" : "Inactive",
                    StatusColor = detail.IsActive == true ? Color.Success : Color.Warning
                };
            })
            .ToList();
    }

    private static string GetLineFullExplanation(int lineNo, int totalLines, string? lineType, string accountCode, string accountName)
    {
        var side = GetDebitCreditSide(lineType);
        var acc = string.IsNullOrWhiteSpace(accountCode) ? "chưa chọn TK" : accountCode.Trim();
        var name = string.IsNullOrWhiteSpace(accountName) ? string.Empty : $" - {accountName.Trim()}";
        var positionText = totalLines <= 1
            ? "Nghiệp vụ này hiện chỉ có 1 dòng, nên cần bổ sung dòng đối ứng để Tổng Nợ = Tổng Có."
            : $"Đây là dòng {lineNo}/{totalLines}; hệ thống đọc theo SortOrder để tạo bút toán.";

        if (side == "Nợ")
        {
            return $"{positionText} Ghi Nợ TK {acc}{name}. Bên Nợ thường dùng để tăng tài sản/chi phí hoặc tăng công nợ phải thu; riêng TK 331 thì ghi Nợ để giảm khoản phải trả vendor. Dòng này phải được đối ứng với một hoặc nhiều dòng Có trong cùng nghiệp vụ.";
        }

        if (side == "Có")
        {
            return $"{positionText} Ghi Có TK {acc}{name}. Bên Có thường dùng để ghi nhận doanh thu/thuế phải nộp/tăng công nợ phải trả hoặc giảm tiền/tài sản; riêng TK 131 thì ghi Có để giảm khoản phải thu khách hàng. Dòng này phải được đối ứng với một hoặc nhiều dòng Nợ trong cùng nghiệp vụ.";
        }

        return $"{positionText} Chưa xác định được dòng này là Nợ hay Có vì LineType chưa rõ. Nên sửa LineType thành Debit hoặc Credit để hệ thống tự giải thích và kiểm tra cân đối chính xác.";
    }

    private async Task SaveAsync()
    {
        var isNew = _edit.Id == Guid.Empty;
        if (isNew && !await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }
        if (!isNew && !await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_edit.Code) || string.IsNullOrWhiteSpace(_edit.Name))
        {
            CallSnack(Localizer["TransactionTypes_Validate_CodeName"], MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var normalizedCode = _edit.Code.Trim();
            var normalizedName = _edit.Name.Trim();
            var duplicatedName = await db.TransactionTypes.AsNoTracking()
                .AnyAsync(x => x.Name == normalizedName && x.Id != _edit.Id);
            if (duplicatedName)
            {
                CallSnack("Name already exists.", MudBlazor.Severity.Warning);
                return;
            }

            if (isNew)
            {
                _edit.Id = Guid.NewGuid();
                _edit.Code = normalizedCode;
                _edit.Name = normalizedName;
                _edit.Description = string.IsNullOrWhiteSpace(_edit.Description) ? null : _edit.Description.Trim();
                db.TransactionTypes.Add(_edit);
            }
            else
            {
                var entity = await db.TransactionTypes.FirstOrDefaultAsync(x => x.Id == _edit.Id);
                if (entity is null)
                {
                    CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                    return;
                }
                entity.Code = normalizedCode;
                entity.Name = normalizedName;
                entity.Description = string.IsNullOrWhiteSpace(_edit.Description) ? null : _edit.Description.Trim();
                entity.IsActive = _edit.IsActive;
            }
            await db.SaveChangesAsync();
            CallSnack(Localizer["SavedSuccess"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (DbUpdateException ex)
        {
            CallSnack(ex.InnerException?.Message ?? ex.Message, MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenAddTransactionTypeDialogAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<TransactionType_AddEditDialog>(
            "Add TransactionType",
            new DialogParameters { ["Model"] = new M_TransactionTypes { IsActive = true } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_TransactionTypes data)
            return;

        _edit = data;
        await SaveAsync();
    }

