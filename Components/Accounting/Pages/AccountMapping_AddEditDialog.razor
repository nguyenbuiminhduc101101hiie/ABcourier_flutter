@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @LblCompanyHint: <strong>@_companyLabel</strong>
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["AccountMapping.AccountCode"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_selectedDanhMucId"
                                     ValueChanged="OnDanhMucChangedAsync"
                                     SearchFunc="SearchDanhMucAsync"
                                     ToStringFunc="DanhMucToString"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="!IsEdit"
                                     Required="true"
                                     Disabled="IsEdit" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid"
                               @bind-Value="_model.ReportLineId"
                               Label="@LblReportLine"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="@LblReportLineRequired">
                        @foreach (var line in _reportLines)
                        {
                            <MudSelectItem Value="@line.Id">@FormatLine(line)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (_reportLines.Count == 0)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">@LblNoReportLines</MudAlert>
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_model.NormalBalance" Label="@Localizer["AccountMapping.NormalBalance"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem Value="@("Debit")">Debit</MudSelectItem>
                        <MudSelectItem Value="@("Credit")">Credit</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.Sign"
                                     Label="@Localizer["BalanceSheetMapping.Sign"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="-1"
                                     Max="1"
                                     HelperText="1 / -1" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.DisplayOrder" Label="@Localizer["AccountMapping.DisplayOrder"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_model.ContraAccount" Label="@LblContraAccount" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_model.Active" Label="@Localizer["AccountMapping.IsActive"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_noteBinding"
                                  Label="@Localizer["BalanceSheetMapping.Note"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_reportLines.Count == 0">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string LblCompanyHint = "Công ty / Company";
    private const string LblReportLine = "Dòng báo cáo / Report line";
    private const string LblReportLineRequired = "Chọn dòng báo cáo. / Select a report line.";
    private const string LblNoReportLines = "Chưa có dòng báo cáo (FinancialReportLines) cho công ty này. / No report lines for this company.";
    private const string LblContraAccount = "Contra / ContraAccount";

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_FinancialReportAccountMapping Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public string CompanyDisplayName { get; set; } = string.Empty;

    private MudForm? _form;
    private M_FinancialReportAccountMapping _model = new();
    private List<DanhMucTaiKhoan> _danhMucs = new();
    private List<M_FinancialReportLine> _reportLines = new();
    private Guid _selectedDanhMucId;
    private string _noteBinding = string.Empty;
    private string _companyLabel = "—";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _danhMucs = await db.DanhMucTaiKhoan.AsNoTracking()
            .Where(x => !string.IsNullOrWhiteSpace(x.Taikhoan))
            .OrderBy(x => x.Taikhoan)
            .ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _model = new M_FinancialReportAccountMapping
        {
            Id = Model.Id,
            CompanyId = Model.CompanyId,
            AccountCode = Model.AccountCode ?? string.Empty,
            ReportLineId = Model.ReportLineId,
            NormalBalance = Model.NormalBalance,
            Sign = Model.Sign == 0 ? 1 : Model.Sign,
            ContraAccount = Model.ContraAccount,
            DisplayOrder = Model.DisplayOrder,
            Active = Model.Active,
            Note = Model.Note,
            CreatedAt = Model.CreatedAt,
            UpdatedAt = Model.UpdatedAt
        };
        _noteBinding = Model.Note ?? string.Empty;
        _companyLabel = string.IsNullOrWhiteSpace(CompanyDisplayName) ? "—" : CompanyDisplayName.Trim();

        SyncSelectedDanhMucFromModel();

        _reportLines = new List<M_FinancialReportLine>();
        if (Model.CompanyId != Guid.Empty)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _reportLines = await db.FinancialReportLines.AsNoTracking()
                .Where(x => x.CompanyId == Model.CompanyId && x.Active)
                .OrderBy(x => x.ReportType)
                .ThenBy(x => x.DisplayOrder)
                .ThenBy(x => x.LineCode)
                .ToListAsync();
        }

        if (_model.ReportLineId != Guid.Empty && _reportLines.All(x => x.Id != _model.ReportLineId))
            _model.ReportLineId = _reportLines.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private static string FormatLine(M_FinancialReportLine line)
    {
        var rt = line.ReportType ?? string.Empty;
        var code = line.LineCode ?? string.Empty;
        var name = line.LineName ?? string.Empty;
        return string.IsNullOrWhiteSpace(rt) ? $"{code} — {name}" : $"{rt} · {code} — {name}";
    }

    private void SyncSelectedDanhMucFromModel()
    {
        var selected = _danhMucs.FirstOrDefault(x =>
            string.Equals((x.Taikhoan ?? string.Empty).Trim(), _model.AccountCode, StringComparison.OrdinalIgnoreCase));
        _selectedDanhMucId = selected?.Id ?? Guid.Empty;
    }

    private Task OnDanhMucChangedAsync(Guid id)
    {
        _selectedDanhMucId = id;
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return Task.CompletedTask;

        _model.AccountCode = (dm.Taikhoan ?? string.Empty).Trim();
        return Task.CompletedTask;
    }

    private Task<IEnumerable<Guid>> SearchDanhMucAsync(string value)
    {
        IEnumerable<DanhMucTaiKhoan> query = _danhMucs;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var keyword = value.Trim();
            query = query.Where(x =>
                (x.Taikhoan?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Tentaikhoan?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Accountname?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return Task.FromResult(query.Select(x => x.Id).Take(50));
    }

    private string DanhMucToString(Guid id)
    {
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return string.Empty;

        var code = (dm.Taikhoan ?? string.Empty).Trim();
        var name = (!string.IsNullOrWhiteSpace(dm.Accountname) ? dm.Accountname : dm.Tentaikhoan) ?? string.Empty;
        name = name.Trim();
        return string.IsNullOrWhiteSpace(name) ? code : $"{code} — {name}";
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();

        if (string.IsNullOrWhiteSpace(_model.AccountCode) || _model.ReportLineId == Guid.Empty || _model.CompanyId == Guid.Empty)
            return;

        _model.AccountCode = _model.AccountCode.Trim();
        _model.NormalBalance = string.IsNullOrWhiteSpace(_model.NormalBalance) ? null : _model.NormalBalance.Trim();
        _model.Note = string.IsNullOrWhiteSpace(_noteBinding) ? null : _noteBinding.Trim();
        if (_model.Sign != 1 && _model.Sign != -1)
            _model.Sign = 1;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
