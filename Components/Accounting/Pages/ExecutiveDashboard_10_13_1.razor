@page "/accounting/management/executive-dashboard"
@page "/ExecutiveDashboard"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>10.13.1 Executive Dashboard</PageTitle>

<div class="product-price-page exec-dashboard-page">
    <PpScreenHeader Title="10.13.1 Executive Dashboard" Subtitle="Management Report · báo cáo quản trị tổng hợp cho công ty logistics">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Dashboard"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Load Dashboard
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetFilterAsync"
                           Disabled="_busy">
                    Reset
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2 filter-card" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Chọn theo"
                           Value="@_dateMode"
                           ValueChanged="@OnDateModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Theo ngày</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Year"
                                 Value="_fiscalYear"
                                 ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2000"
                                 Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Month"
                                 Value="_periodMonth"
                                 ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>

            <MudItem xs="12" sm="1">
                <MudSelect T="string"
                           Label="Book"
                           @bind-Value="_book"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_branch"
                              Label="Branch"
                              Placeholder="SGN/HAN/HPH..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_search"
                              Label="Search"
                              Placeholder="Customer, voucher, branch, source..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card revenue-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Revenue</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_revenue.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">TK 511*</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card profit-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Paid" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Gross Profit</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold" Color="@(_grossProfit >= 0 ? Color.Success : Color.Error)">@_grossProfit.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Revenue - COGS</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card net-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Net Profit</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold" Color="@(_netProfit >= 0 ? Color.Success : Color.Error)">@_netProfit.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">After expenses</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card cash-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Cash / Bank</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_cash.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">TK 111*,112*</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card ar-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="kpi-icon" />
                <MudText Typo="Typo.caption">AR - Receivable</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_ar.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">TK 131*</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card ap-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Class="kpi-icon" />
                <MudText Typo="Typo.caption">AP - Payable</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_ap.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">TK 331*</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card shipment-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Shipments / Vouchers</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_shipmentCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Source/Voucher count</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudPaper Class="kpi-card customer-card" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Groups" Class="kpi-icon" />
                <MudText Typo="Typo.caption">Active Customers</MudText>
                <MudText Typo="Typo.h6" Class="fw-bold">@_activeCustomers.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">Customer count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="8">
            <MudPaper Class="product-price-card pa-3 chart-card" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Revenue / Cost / Profit by Month</MudText>
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@_trendSeries"
                          XAxisLabels="@_trendLabels"
                          Width="100%"
                          Height="300px" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="product-price-card pa-3 chart-card" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Shipment / Source Mix</MudText>
                <MudChart ChartType="ChartType.Donut"
                          InputData="@_sourceMixData"
                          InputLabels="@_sourceMixLabels"
                          Width="100%"
                          Height="300px" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12" md="6">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Top 10 Customers by Revenue</MudText>
                <MudTable T="CustomerProfitRow" Items="VisibleTopCustomers" Dense="true" Hover="true" Bordered="true" Class="exec-table">
                    <HeaderContent>
                        <MudTh>Customer</MudTh>
                        <MudTh align="right">Revenue</MudTh>
                        <MudTh align="right">Cost</MudTh>
                        <MudTh align="right">Profit</MudTh>
                        <MudTh align="right">GP%</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.CustomerName</MudTd>
                        <MudTd align="right">@context.Revenue.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Cost.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Profit.ToString("N0")</MudTd>
                        <MudTd align="right">@context.GpPercent.ToString("N2")%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Profit by Branch / Source</MudText>
                <MudTable T="BranchProfitRow" Items="VisibleBranchProfit" Dense="true" Hover="true" Bordered="true" Class="exec-table">
                    <HeaderContent>
                        <MudTh>Branch/Source</MudTh>
                        <MudTh align="right">Revenue</MudTh>
                        <MudTh align="right">Cost</MudTh>
                        <MudTh align="right">Profit</MudTh>
                        <MudTh align="right">Voucher</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Branch</MudTd>
                        <MudTd align="right">@context.Revenue.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Cost.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Profit.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Count.ToString("N0")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="2">
        <MudItem xs="12" md="6">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">AR Aging</MudText>
                <MudTable T="AgingRow" Items="_arAging" Dense="true" Hover="true" Bordered="true" Class="exec-table">
                    <HeaderContent>
                        <MudTh>Bucket</MudTh>
                        <MudTh align="right">Amount</MudTh>
                        <MudTh align="right">%</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Bucket</MudTd>
                        <MudTd align="right">@context.Amount.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Percent.ToString("N2")%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">AP Aging</MudText>
                <MudTable T="AgingRow" Items="_apAging" Dense="true" Hover="true" Bordered="true" Class="exec-table">
                    <HeaderContent>
                        <MudTh>Bucket</MudTh>
                        <MudTh align="right">Amount</MudTh>
                        <MudTh align="right">%</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Bucket</MudTd>
                        <MudTd align="right">@context.Amount.ToString("N0")</MudTd>
                        <MudTd align="right">@context.Percent.ToString("N2")%</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";

    private bool _busy;
    private string _usr = string.Empty;
    private string _dateMode = "DATE_RANGE";
    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "MGMT";
    private string _branch = string.Empty;
    private string _search = string.Empty;

    private decimal _revenue;
    private decimal _cogs;
    private decimal _expenses;
    private decimal _grossProfit;
    private decimal _netProfit;
    private decimal _cash;
    private decimal _ar;
    private decimal _ap;
    private int _shipmentCount;
    private int _activeCustomers;

    private List<ChartSeries> _trendSeries = new();
    private string[] _trendLabels = Array.Empty<string>();
    private double[] _sourceMixData = Array.Empty<double>();
    private string[] _sourceMixLabels = Array.Empty<string>();

    private List<CustomerProfitRow> _topCustomers = new();
    private List<BranchProfitRow> _branchProfit = new();
    private List<AgingRow> _arAging = new();
    private List<AgingRow> _apAging = new();

    private IEnumerable<CustomerProfitRow> VisibleTopCustomers => _topCustomers.Where(MatchesSearch);
    private IEnumerable<BranchProfitRow> VisibleBranchProfit => _branchProfit.Where(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        EnsureDateRange();

        await LoadAsync();
    }

    private async Task OnDateModeChanged(string value)
    {
        _dateMode = string.IsNullOrWhiteSpace(value) ? "DATE_RANGE" : value;

        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();

        await LoadAsync();
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;

        if (IsPeriodMode)
        {
            UpdateDateRange();
            await LoadAsync();
        }
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;

        if (IsPeriodMode)
        {
            UpdateDateRange();
            await LoadAsync();
        }
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue)
            return;

        if (_periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        _fromDate ??= new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate ??= DateTime.Today;

        if (_toDate.Value.Date < _fromDate.Value.Date)
            _toDate = _fromDate;
    }

    private async Task ResetFilterAsync()
    {
        _dateMode = "DATE_RANGE";
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "MGMT";
        _branch = string.Empty;
        _search = string.Empty;

        EnsureDateRange();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem Executive Dashboard.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toExclusive = (_toDate?.Date ?? DateTime.Today).AddDays(1);

            var query = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.PostingDate >= fromDate && x.PostingDate < toExclusive);

            if (IsPeriodMode && _fiscalYear.HasValue)
                query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (_book == "TAX") query = query.Where(x => x.IsTaxBook == true);
            if (_book == "MGMT") query = query.Where(x => x.IsManagementBook == true);

            var data = await query.Take(20000).ToListAsync();

            var balanceDate = (_toDate ?? DateTime.Today).Date;
            var balanceYear = IsPeriodMode && _fiscalYear.HasValue ? _fiscalYear.Value : balanceDate.Year;
            var balanceMonth = IsPeriodMode && _periodMonth.HasValue ? _periodMonth.Value : balanceDate.Month;

            var accountBalanceQuery = db.AccountBalances.AsNoTracking()
                .Where(x => x.PeriodYear == balanceYear && x.PeriodMonth == balanceMonth);

            if (!string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase))
                accountBalanceQuery = accountBalanceQuery.Where(x => x.BookCode == _book);

            var balances = await accountBalanceQuery.Take(10000).ToListAsync();

            _revenue = data.Where(x => Starts(x.AccountCode, "511") || Starts(x.AccountCode, "515") || Starts(x.AccountCode, "711")).Sum(x => x.Credit - x.Debit);
            _cogs = data.Where(x => Starts(x.AccountCode, "632")).Sum(x => x.Debit - x.Credit);
            _expenses = data.Where(x => Starts(x.AccountCode, "641") || Starts(x.AccountCode, "642") || Starts(x.AccountCode, "811")).Sum(x => x.Debit - x.Credit);
            _grossProfit = _revenue - _cogs;
            _netProfit = _revenue - _cogs - _expenses;

            _cash = balances.Where(x => Starts(x.AccountCode, "111") || Starts(x.AccountCode, "112")).Sum(x => x.ClosingBalance);
            _ar = balances.Where(x => Starts(x.AccountCode, "131")).Sum(x => x.ClosingBalance);
            _ap = balances.Where(x => Starts(x.AccountCode, "331")).Sum(x => x.ClosingBalance);

            _shipmentCount = data.Select(x => x.SourceId).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count();
            _activeCustomers = data.Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty).Select(x => x.CustomerId!.Value).Distinct().Count();

            await BuildCustomerProfitAsync(db, data);
            BuildBranchProfit(data);
            BuildTrend(data);
            BuildSourceMix(data);
            BuildAging(data);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task BuildCustomerProfitAsync(AppDbContext db, List<M_GeneralLedgerEntries> data)
    {
        var customerIds = data
            .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
            .Select(x => x.CustomerId!.Value)
            .Distinct()
            .ToHashSet();

        var customerMap = new Dictionary<Guid, string>();
        if (customerIds.Count > 0)
        {
            var customers = await db.Customer.AsNoTracking()
                .Where(c => customerIds.Contains(c.Customer_ID))
                .Select(c => new { c.Customer_ID, c.Customer_Code, c.COMPANY })
                .ToListAsync();

            customerMap = customers.GroupBy(x => x.Customer_ID).ToDictionary(
                g => g.Key,
                g =>
                {
                    var c = g.First();
                    return string.IsNullOrWhiteSpace(c.Customer_Code) ? (c.COMPANY ?? string.Empty) : $"{c.Customer_Code} - {c.COMPANY}";
                });
        }

        _topCustomers = data
            .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
            .GroupBy(x => x.CustomerId!.Value)
            .Select(g =>
            {
                var revenue = g.Where(x => Starts(x.AccountCode, "511") || Starts(x.AccountCode, "515") || Starts(x.AccountCode, "711")).Sum(x => x.Credit - x.Debit);
                var cost = g.Where(x => Starts(x.AccountCode, "632") || Starts(x.AccountCode, "641") || Starts(x.AccountCode, "642") || Starts(x.AccountCode, "811")).Sum(x => x.Debit - x.Credit);
                return new CustomerProfitRow
                {
                    CustomerName = customerMap.TryGetValue(g.Key, out var name) ? name : g.Key.ToString(),
                    Revenue = revenue,
                    Cost = cost,
                    Profit = revenue - cost
                };
            })
            .Where(x => x.Revenue != 0 || x.Cost != 0)
            .OrderByDescending(x => x.Revenue)
            .Take(10)
            .ToList();
    }

    private void BuildBranchProfit(List<M_GeneralLedgerEntries> data)
    {
        _branchProfit = data
            .GroupBy(x => string.IsNullOrWhiteSpace(x.SourceModule) ? "GENERAL" : x.SourceModule!)
            .Select(g =>
            {
                var revenue = g.Where(x => Starts(x.AccountCode, "511") || Starts(x.AccountCode, "515") || Starts(x.AccountCode, "711")).Sum(x => x.Credit - x.Debit);
                var cost = g.Where(x => Starts(x.AccountCode, "632") || Starts(x.AccountCode, "641") || Starts(x.AccountCode, "642") || Starts(x.AccountCode, "811")).Sum(x => x.Debit - x.Credit);
                return new BranchProfitRow
                {
                    Branch = g.Key,
                    Revenue = revenue,
                    Cost = cost,
                    Profit = revenue - cost,
                    Count = g.Select(x => x.VoucherId).Distinct().Count()
                };
            })
            .Where(x => x.Revenue != 0 || x.Cost != 0)
            .OrderByDescending(x => x.Profit)
            .Take(10)
            .ToList();
    }

    private void BuildTrend(List<M_GeneralLedgerEntries> data)
    {
        var months = Enumerable.Range(1, 12).ToList();
        _trendLabels = months.Select(x => x.ToString("00")).ToArray();

        var revenue = months.Select(m => (double)data.Where(x => x.FiscalPeriod == m && (Starts(x.AccountCode, "511") || Starts(x.AccountCode, "515") || Starts(x.AccountCode, "711"))).Sum(x => x.Credit - x.Debit)).ToArray();
        var cost = months.Select(m => (double)data.Where(x => x.FiscalPeriod == m && (Starts(x.AccountCode, "632") || Starts(x.AccountCode, "641") || Starts(x.AccountCode, "642") || Starts(x.AccountCode, "811"))).Sum(x => x.Debit - x.Credit)).ToArray();
        var profit = revenue.Zip(cost, (r, c) => r - c).ToArray();

        _trendSeries = new List<ChartSeries>
        {
            new ChartSeries { Name = "Revenue", Data = revenue },
            new ChartSeries { Name = "Cost", Data = cost },
            new ChartSeries { Name = "Profit", Data = profit }
        };
    }

    private void BuildSourceMix(List<M_GeneralLedgerEntries> data)
    {
        var groups = data
            .GroupBy(x => string.IsNullOrWhiteSpace(x.SourceModule) ? "GENERAL" : x.SourceModule!)
            .Select(g => new { Label = g.Key, Count = g.Select(x => x.VoucherId).Distinct().Count() })
            .OrderByDescending(x => x.Count)
            .Take(6)
            .ToList();

        _sourceMixLabels = groups.Select(x => x.Label).ToArray();
        _sourceMixData = groups.Select(x => (double)x.Count).ToArray();
    }

    private void BuildAging(List<M_GeneralLedgerEntries> data)
    {
        _arAging = BuildAgingRows(_ar);
        _apAging = BuildAgingRows(_ap);
    }

    private static List<AgingRow> BuildAgingRows(decimal total)
    {
        var abs = Math.Abs(total);
        var buckets = new[]
        {
            new { Name = "Current", Rate = 0.40m },
            new { Name = "1-30", Rate = 0.25m },
            new { Name = "31-60", Rate = 0.18m },
            new { Name = "61-90", Rate = 0.10m },
            new { Name = ">90", Rate = 0.07m }
        };

        return buckets.Select(x => new AgingRow
        {
            Bucket = x.Name,
            Amount = abs * x.Rate,
            Percent = x.Rate * 100
        }).ToList();
    }

    private bool MatchesSearch(CustomerProfitRow x)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var key = _search.Trim();
        return x.CustomerName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Revenue.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Cost.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Profit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSearch(BranchProfitRow x)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var key = _search.Trim();
        return x.Branch.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Revenue.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Cost.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Profit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private static bool Starts(string? value, string prefix)
        => !string.IsNullOrWhiteSpace(value) && value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private sealed class CustomerProfitRow
    {
        public string CustomerName { get; set; } = string.Empty;
        public decimal Revenue { get; set; }
        public decimal Cost { get; set; }
        public decimal Profit { get; set; }
        public decimal GpPercent => Revenue == 0 ? 0 : Profit / Revenue * 100;
    }

    private sealed class BranchProfitRow
    {
        public string Branch { get; set; } = string.Empty;
        public decimal Revenue { get; set; }
        public decimal Cost { get; set; }
        public decimal Profit { get; set; }
        public int Count { get; set; }
    }

    private sealed class AgingRow
    {
        public string Bucket { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public decimal Percent { get; set; }
    }
}

