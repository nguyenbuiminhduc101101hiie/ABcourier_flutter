@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.VoucherNo" Label="@Localizer["GeneralLedgerEntries.VoucherNo"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker Date="@_postingDate" DateChanged="d => _postingDate = d" Label="@Localizer["GeneralLedgerEntries.PostingDate"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudDatePicker Date="@_voucherDate" DateChanged="d => _voucherDate = d" Label="@Localizer["GeneralLedgerEntries.VoucherDate"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["GeneralLedgerEntries.Company"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_model.CompanyId"
                                     ValueChanged="OnCompanyChanged"
                                     SearchFunc="SearchCompanyAsync"
                                     ToStringFunc="CompanyToString"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["GeneralLedgerEntries.Voucher"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_model.VoucherId"
                                     ValueChanged="OnVoucherChanged"
                                     SearchFunc="SearchVoucherAsync"
                                     ToStringFunc="VoucherToString"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["GeneralLedgerEntries.VoucherLine"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="@(_model.VoucherLineId ?? Guid.Empty)"
                                     ValueChanged="OnVoucherLineChanged"
                                     SearchFunc="SearchVoucherLineAsync"
                                     ToStringFunc="VoucherLineToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="4"><MudNumericField @bind-Value="_model.FiscalYear" Label="@Localizer["GeneralLedgerEntries.FiscalYear"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudNumericField @bind-Value="_model.FiscalPeriod" Label="@Localizer["GeneralLedgerEntries.FiscalPeriod"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.AccountCode" Label="@Localizer["GeneralLedgerEntries.AccountCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" /></MudItem>

                <MudItem xs="12" md="3"><MudNumericField @bind-Value="_model.Debit" Label="@Localizer["GeneralLedgerEntries.Debit"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" HideSpinButtons="true" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField @bind-Value="_model.Credit" Label="@Localizer["GeneralLedgerEntries.Credit"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" HideSpinButtons="true" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField @bind-Value="_model.DebitFC" Label="@Localizer["GeneralLedgerEntries.DebitFC"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" HideSpinButtons="true" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField @bind-Value="_model.CreditFC" Label="@Localizer["GeneralLedgerEntries.CreditFC"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" HideSpinButtons="true" /></MudItem>

                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.CurrencyCode" Label="@Localizer["GeneralLedgerEntries.CurrencyCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudNumericField @bind-Value="_model.ExchangeRate" Label="@Localizer["GeneralLedgerEntries.ExchangeRate"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N6" HideSpinButtons="true" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.BranchCode" Label="@Localizer["GeneralLedgerEntries.BranchCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>

                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["GeneralLedgerEntries.Customer"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="@(_model.CustomerId ?? Guid.Empty)"
                                     ValueChanged="OnCustomerChanged"
                                     SearchFunc="SearchCustomerAsync"
                                     ToStringFunc="CustomerToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="@Localizer["GeneralLedgerEntries.Shipment"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="@(_model.ShipmentId ?? Guid.Empty)"
                                     ValueChanged="OnShipmentChanged"
                                     SearchFunc="SearchShipmentAsync"
                                     ToStringFunc="ShipmentToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="ContractIdText" Label="@Localizer["GeneralLedgerEntries.ContractId"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>

                <MudItem xs="12"><MudTextField @bind-Value="_model.Description" Label="@Localizer["noidung"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SourceModule" Label="@Localizer["GeneralLedgerEntries.SourceModule"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.SourceId" Label="@Localizer["GeneralLedgerEntries.SourceId"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudCheckBox @bind-Value="_model.IsTaxBook" Label="@Localizer["GeneralLedgerEntries.IsTaxBook"]" Dense="true" /></MudItem>
                <MudItem xs="12" md="4"><MudCheckBox @bind-Value="_model.IsManagementBook" Label="@Localizer["GeneralLedgerEntries.IsManagementBook"]" Dense="true" /></MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Value="@(_model.LedgerType ?? string.Empty)"
                               ValueChanged="OnLedgerTypeChanged"
                               Label="@Localizer["GeneralLedgerEntries.LedgerType"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var lt in LedgerTypeOptions)
                        {
                            <MudSelectItem Value="@lt">@lt</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_model.CreatedBy" Label="@Localizer["GeneralLedgerEntries.CreatedBy"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="() => MudDialog.Cancel()">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? EntryId { get; set; }
    private MudForm _form = default!;
    private M_GeneralLedgerEntries _model = new();
    private DateTime? _postingDate;
    private DateTime? _voucherDate;
    private List<M_Customer> _customers = new();
    private List<M_AccountingVouchers> _vouchers = new();
    private List<M_AccountingVoucherLines> _voucherLines = new();
    private List<M_HBL> _shipments = new();

    private static readonly string[] LedgerTypeOptions = { "FINANCIAL", "TAX", "MANAGEMENT" };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _customers = await db.Customer.AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.COMPANY)
            .ThenBy(x => x.BIZName)
            .ToListAsync();
        _vouchers = await db.AccountingVouchers.AsNoTracking()
            .OrderByDescending(x => x.VoucherDate)
            .ThenByDescending(x => x.VoucherNo)
            .Take(500)
            .ToListAsync();
        _shipments = await db.HBL.AsNoTracking()
            .Where(x => x.hblID != Guid.Empty)
            .OrderByDescending(x => x.ETD)
            .Take(500)
            .ToListAsync();

        if (EntryId.HasValue)
        {
            var row = await db.GeneralLedgerEntries.AsNoTracking().FirstOrDefaultAsync(x => x.Id == EntryId.Value);
            if (row is not null)
            {
                _model = row;
                _postingDate = row.PostingDate;
                _voucherDate = row.VoucherDate;
                await LoadVoucherLinesAsync(_model.VoucherId);
                return;
            }
        }
        _model = new M_GeneralLedgerEntries
        {
            Id = Guid.NewGuid(),
            CurrencyCode = "VND",
            ExchangeRate = 1m,
            CreatedAt = DateTime.UtcNow
        };
        _postingDate = DateTime.Today;
        _voucherDate = DateTime.Today;
        await LoadVoucherLinesAsync(_model.VoucherId);
    }

    private string? ContractIdText { get => _model.ContractId?.ToString(); set { _model.ContractId = Guid.TryParse(value, out var g) ? g : null; } }

    private Task OnCompanyChanged(Guid value)
    {
        _model.CompanyId = value;
        return Task.CompletedTask;
    }

    private async Task OnVoucherChanged(Guid value)
    {
        _model.VoucherId = value;
        await LoadVoucherLinesAsync(value);
        if (_model.VoucherLineId.HasValue && _voucherLines.All(x => x.Id != _model.VoucherLineId.Value))
            _model.VoucherLineId = null;
    }

    private Task OnVoucherLineChanged(Guid value)
    {
        _model.VoucherLineId = value == Guid.Empty ? null : value;
        return Task.CompletedTask;
    }

    private Task OnCustomerChanged(Guid value)
    {
        _model.CustomerId = value == Guid.Empty ? null : value;
        return Task.CompletedTask;
    }

    private Task OnShipmentChanged(Guid value)
    {
        _model.ShipmentId = value == Guid.Empty ? null : value;
        return Task.CompletedTask;
    }

    private Task OnLedgerTypeChanged(string value)
    {
        _model.LedgerType = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        return Task.CompletedTask;
    }

    private async Task LoadVoucherLinesAsync(Guid voucherId)
    {
        if (voucherId == Guid.Empty)
        {
            _voucherLines = new List<M_AccountingVoucherLines>();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        _voucherLines = await db.AccountingVoucherLines.AsNoTracking()
            .Where(x => x.VoucherId == voucherId)
            .OrderBy(x => x.SortKey ?? int.MaxValue)
            .ThenBy(x => x.LineNo_)
            .ToListAsync();
    }

    private Task<IEnumerable<Guid>> SearchCompanyAsync(string value)
    {
        IEnumerable<M_Customer> query = _customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.Customer_Code?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.COMPANY?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.TaxCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.Customer_ID).Take(30));
    }

    private string CompanyToString(Guid id)
    {
        var c = _customers.FirstOrDefault(x => x.Customer_ID == id);
        if (c is null) return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company)) return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }

    private Task<IEnumerable<Guid>> SearchVoucherAsync(string value)
    {
        IEnumerable<M_AccountingVouchers> query = _vouchers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.VoucherNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.TransactionTypeCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.Id).Take(30));
    }

    private string VoucherToString(Guid id)
    {
        var v = _vouchers.FirstOrDefault(x => x.Id == id);
        if (v is null) return string.Empty;
        return $"{v.VoucherNo} ({v.VoucherDate:dd/MM/yyyy})";
    }

    private Task<IEnumerable<Guid>> SearchVoucherLineAsync(string value)
    {
        IEnumerable<M_AccountingVoucherLines> query = _voucherLines;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.LineNo_?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.AccountCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LineDescription?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.Id).Take(30));
    }

    private string VoucherLineToString(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var line = _voucherLines.FirstOrDefault(x => x.Id == id);
        if (line is null) return string.Empty;
        var desc = string.IsNullOrWhiteSpace(line.LineDescription) ? string.Empty : $" - {line.LineDescription}";
        return $"{line.LineNo_} - {line.AccountCode}{desc}";
    }

    private Task<IEnumerable<Guid>> SearchCustomerAsync(string value)
    {
        IEnumerable<M_Customer> query = _customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.Customer_Code?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.COMPANY?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.Customer_ID).Take(30));
    }

    private string CustomerToString(Guid id) => id == Guid.Empty ? string.Empty : CompanyToString(id);

    private Task<IEnumerable<Guid>> SearchShipmentAsync(string value)
    {
        IEnumerable<M_HBL> query = _shipments;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.hbl?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.bkno?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.hblID).Take(30));
    }

    private string ShipmentToString(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var s = _shipments.FirstOrDefault(x => x.hblID == id);
        if (s is null) return string.Empty;
        var hbl = s.hbl?.Trim() ?? string.Empty;
        var bk = s.bkno?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(hbl) && !string.IsNullOrWhiteSpace(bk)) return $"{hbl} - {bk}";
        return !string.IsNullOrWhiteSpace(hbl) ? hbl : bk;
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        _model.PostingDate = _postingDate ?? DateTime.Today;
        _model.VoucherDate = _voucherDate ?? DateTime.Today;

        await using var db = await DbFactory.CreateDbContextAsync();
        if (EntryId.HasValue)
            db.GeneralLedgerEntries.Update(_model);
        else
            db.GeneralLedgerEntries.Add(_model);
        await db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }
}

