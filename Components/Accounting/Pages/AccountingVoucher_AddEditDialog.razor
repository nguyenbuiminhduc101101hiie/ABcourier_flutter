@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SharedServices ssv
@inject AccountService asv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="Guid"
                                     Label="Công ty"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     @bind-Value="_model.CompanyId"
                                     SearchFunc="SearchCompanyAsync"
                                     ToStringFunc="CompanyToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Required="true"
                                     RequiredError="Bắt buộc" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.VoucherNo" Label="Số chứng từ" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_voucherDate" DateChanged="OnVoucherDateChanged" Label="Ngày hạch toán" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_postingDate" DateChanged="OnPostingDateChanged" Label="Ngày ghi sổ" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.FiscalYear" Label="Năm TC" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.FiscalPeriod" Label="Kỳ kế toán" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_model.TransactionTypeCode" Label="Loại nghiệp vụ" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        @foreach (var t in _transactionTypes)
                        {
                            <MudSelectItem Value="@t.Code">@t.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="_model.Status" Label="@Localizer["status"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="1">0-Draft</MudSelectItem>
                        <MudSelectItem Value="2">1-Posted</MudSelectItem>
                        <MudSelectItem Value="3">2-Cancelled</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_model.CurrencyCode" Label="@Localizer["Loaitiente"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.ExchangeRate" Label="Tỷ giá" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N6" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.ReferenceNo" Label="Số tham chiếu" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_referenceDate" DateChanged="OnReferenceDateChanged" Label="Ngày tham chiếu" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Value="@(_model.SourceModule ?? string.Empty)"
                               ValueChanged="OnSourceModuleChanged"
                               Label="@Localizer["AccountingVoucher.SourceModule"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var opt in SourceModuleOptions)
                        {
                            <MudSelectItem Value="@opt.Module">@($"{opt.Module} - {opt.Meaning}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.CreatedBy" Label="Created By" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_createdDate" DateChanged="OnCreatedDateChanged" Label="Created Date" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.ModifiedBy" Label="Modified By" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_modifiedDate" DateChanged="OnModifiedDateChanged" Label="Modified Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@(_model.PostedBy ?? string.Empty)"
                                   Label="Posted By"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Value="@FormatPostedDateTime(_model.PostedDate)"
                                   Label="Posted Date"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.CancelledBy" Label="Cancelled By" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="@_cancelledDate" DateChanged="OnCancelledDateChanged" Label="Cancelled Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description" Label="@Localizer["noidung"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle1" Class="fw-700 mb-2">@($"Thông tin bút toán — {_model.VoucherNo}")</MudText>
        @if (!CanEditLines)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-2">
                Vui lòng lưu chứng từ trước, sau đó mở lại để thêm/sửa/xóa dòng bút toán.
            </MudAlert>
        }
        <MudStack Row="true" Spacing="1" Class="mb-2">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineAsync" Disabled="_busy || !CanEditLines">Thêm dòng</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditLineAsync" Disabled="_busy || _selectedLine is null || !CanEditLines">Sửa</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="RemoveLineAsync" Disabled="_busy || _selectedLine is null || !CanEditLines">Xóa</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="RegenerateFromTransactionTypeAsync" Disabled="_busy || !CanEditLines">Tạo dòng từ loại dịch vụ</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReloadLinesAsync" Disabled="_busy || !CanEditLines">Reload</MudButton>
        </MudStack>
        <MudDataGrid T="M_AccountingVoucherLines"
                     Items="_lines"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     RowClick="OnLineRowClick"
                     RowClassFunc="LineRowClass"
                     Height="380px"
                     FixedHeader="true">
            <Columns>
                <PropertyColumn Property="x => x.LineNo_" Title="STT" />
                <TemplateColumn Title="TK">
                    <CellTemplate>@GetTaiKhoan(context.Item.DanhMucTaiKhoanID)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Tên TK">
                    <CellTemplate>@GetTenTaiKhoan(context.Item.DanhMucTaiKhoanID)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.LineDescription" Title="Diễn giải" />
                <TemplateColumn Title="Customer">
                    <CellTemplate>@GetCustomerLabel(context.Item.CustomerId)</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Shipment (HBL)">
                    <CellTemplate>@GetHblLabel(context.Item.ShipmentId)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ContractId" Title="Contract" />
                <PropertyColumn Property="x => x.DebitAmount" Title="Nợ" Format="N2" />
                <PropertyColumn Property="x => x.CreditAmount" Title="Có" Format="N2" />
                <PropertyColumn Property="x => x.InvoiceNo" Title="SoHD" />
                <PropertyColumn Property="x => x.InvoiceDate" Title="Invoice Date" Format="dd/MM/yyyy" />
            </Columns>
        </MudDataGrid>
        <MudPaper Class="pa-2 mt-2" Elevation="0">
            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2">Tổng dòng: @_lines.Count</MudText>
                <MudText Typo="Typo.body2">Tổng Nợ: @_totalDebit.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">Tổng Có: @_totalCredit.ToString("N2")</MudText>
                <MudText Typo="Typo.body2" Color="@(_diff == 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)">Chênh lệch: @_diff.ToString("N2")</MudText>
                <MudText Typo="Typo.body2" Color="MudBlazor.Color.Success">@BalanceLabel</MudText>
            </MudStack>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="PostToGeneralLedgerAsync" Disabled="_saving || _busy">Ghi Sổ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null = create new voucher.</summary>
    [Parameter] public Guid? VoucherId { get; set; }

    private MudForm _form = default!;
    private bool _saving;
    private bool _busy;
    private string _usr = string.Empty;
    private M_AccountingVouchers _model = new();
    private DateTime? _voucherDate;
    private DateTime? _postingDate;
    private DateTime? _referenceDate;
    private DateTime? _createdDate;
    private DateTime? _modifiedDate;
    private DateTime? _cancelledDate;
    private List<M_Customer> _companies = new();
    private List<M_TransactionTypes> _transactionTypes = new();
    private List<M_AccountingVoucherLines> _lines = new();
    private M_AccountingVoucherLines? _selectedLine;
    private Dictionary<Guid, DanhMucTaiKhoan> _danhMucById = new();
    private Dictionary<Guid, M_Customer> _customerById = new();
    private Dictionary<Guid, M_HBL> _hblById = new();
    private decimal _totalDebit;
    private decimal _totalCredit;
    private decimal _diff;
    private string BalanceLabel => _diff == 0 && _lines.Count > 0 ? "Cân bút toán" : (_lines.Count == 0 ? "" : "Chưa cân");
    private bool CanEditLines => VoucherId.HasValue;

    private sealed record SourceModuleOption(string Module, string Meaning);

    private static readonly SourceModuleOption[] SourceModuleOptions =
    {
        new("AR (Account Receivable)", "Công nợ khách hàng"),
        new("AP (Account Payable)", "Công nợ nhà cung cấp"),
        new("GL (General Ledger)", "Nhập tay bút toán"),
        new("INV (Inventory)", "Xuất nhập kho"),
        new("SHIPMENT", "Nghiệp vụ vận chuyển (core của m)"),
        new("BILLING", "Xuất hóa đơn"),
        new("PAYMENT", "Thu / chi tiền"),
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await using var db = await DbFactory.CreateDbContextAsync();
        _companies = await db.Customer.AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.COMPANY)
            .ThenBy(x => x.BIZName)
            .ToListAsync();
        _transactionTypes = await db.TransactionTypes.AsNoTracking()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Code)
            .ToListAsync();
        var dms = await db.DanhMucTaiKhoan.AsNoTracking().Where(x => x.Taikhoan != null).ToListAsync();
        _danhMucById = dms.ToDictionary(x => x.Id, x => x);
        _customerById = _companies.ToDictionary(x => x.Customer_ID, x => x);
        var hbls = await db.HBL.AsNoTracking().Where(x => x.hblID != Guid.Empty).ToListAsync();
        _hblById = hbls.ToDictionary(x => x.hblID, x => x);

        var today = DateTime.Today;
        if (VoucherId is { } id)
        {
            var entity = await db.AccountingVouchers.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
            if (entity is null)
            {
                Snackbar.Add(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                MudDialog.Cancel();
                return;
            }

            _model = new M_AccountingVouchers
            {
                Id = entity.Id,
                CompanyId = entity.CompanyId,
                VoucherNo = entity.VoucherNo,
                VoucherDate = entity.VoucherDate,
                PostingDate = entity.PostingDate,
                FiscalYear = entity.FiscalYear,
                FiscalPeriod = entity.FiscalPeriod,
                TransactionTypeCode = entity.TransactionTypeCode,
                Description = entity.Description,
                CurrencyCode = entity.CurrencyCode,
                ExchangeRate = entity.ExchangeRate,
                Status = entity.Status,
                ReferenceNo = entity.ReferenceNo,
                ReferenceDate = entity.ReferenceDate,
                SourceModule = entity.SourceModule,
                SourceId = entity.SourceId,
                CreatedBy = entity.CreatedBy,
                CreatedDate = entity.CreatedDate,
                ModifiedBy = entity.ModifiedBy,
                ModifiedDate = entity.ModifiedDate,
                PostedBy = entity.PostedBy,
                PostedDate = entity.PostedDate,
                CancelledBy = entity.CancelledBy,
                CancelledDate = entity.CancelledDate
            };
            _voucherDate = entity.VoucherDate.Date;
            _postingDate = entity.PostingDate.Date;
            _referenceDate = entity.ReferenceDate?.Date;
            _createdDate = entity.CreatedDate.Date;
            _modifiedDate = entity.ModifiedDate?.Date;
            _cancelledDate = entity.CancelledDate?.Date;
            _lines = await db.AccountingVoucherLines.AsNoTracking()
                .Where(x => x.VoucherId == entity.Id)
                .OrderBy(x => x.SortKey ?? int.MaxValue)
                .ThenBy(x => x.LineNo_)
                .ToListAsync();
            RecalcTotals();
        }
        else
        {
            var createAuth = await asv.GetAuth();
            var user = createAuth.User.Identity?.Name ?? "system";
            var companyId = _companies.FirstOrDefault()?.Customer_ID ?? Guid.Empty;
            var voucherNo = await GenerateVoucherNoAsync(today);

            _model = new M_AccountingVouchers
            {
                Id = Guid.NewGuid(),
                CompanyId = companyId,
                VoucherNo = voucherNo,
                VoucherDate = today,
                PostingDate = today,
                FiscalYear = today.Year,
                FiscalPeriod = today.Month,
                TransactionTypeCode = _transactionTypes.FirstOrDefault()?.Code ?? string.Empty,
                CurrencyCode = "VND",
                ExchangeRate = 1m,
                Status = 1,
                CreatedBy = user,
                CreatedDate = DateTime.UtcNow
            };
            _voucherDate = today;
            _postingDate = today;
            _referenceDate = null;
            _createdDate = DateTime.UtcNow.Date;
            _modifiedDate = null;
            _cancelledDate = null;
            _lines = new List<M_AccountingVoucherLines>();
            RecalcTotals();
        }
    }

    private Task OnVoucherDateChanged(DateTime? d)
    {
        _voucherDate = d;
        if (d.HasValue)
        {
            _model.VoucherDate = d.Value;
            _model.FiscalYear = d.Value.Year;
            _model.FiscalPeriod = d.Value.Month;
        }
        return Task.CompletedTask;
    }
    private Task OnPostingDateChanged(DateTime? d)
    {
        _postingDate = d;
        if (d.HasValue)
            _model.PostingDate = d.Value;
        return Task.CompletedTask;
    }

    private Task OnReferenceDateChanged(DateTime? d)
    {
        _referenceDate = d;
        _model.ReferenceDate = d;
        return Task.CompletedTask;
    }
    private Task OnCreatedDateChanged(DateTime? d)
    {
        _createdDate = d;
        if (d.HasValue)
            _model.CreatedDate = d.Value;
        return Task.CompletedTask;
    }
    private Task OnModifiedDateChanged(DateTime? d)
    {
        _modifiedDate = d;
        _model.ModifiedDate = d;
        return Task.CompletedTask;
    }
    private static string FormatPostedDateTime(DateTime? d) =>
        d.HasValue ? d.Value.ToString("dd/MM/yyyy HH:mm", CultureInfo.CurrentCulture) : string.Empty;
    private Task OnCancelledDateChanged(DateTime? d)
    {
        _cancelledDate = d;
        _model.CancelledDate = d;
        return Task.CompletedTask;
    }

    private Task OnSourceModuleChanged(string value)
    {
        _model.SourceModule = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        return Task.CompletedTask;
    }

    private async Task<string> GenerateVoucherNoAsync(DateTime value)
    {
        var usr = asv.GetAuth().Result.User.Identity?.Name ?? "system";
        var refno = await supsv.GetRefNoByFunc("Account", value.Month, value.Year, usr);

        var rs = asv.GetUserDetail();


        var sequence = refno ?? 1;
        return $"Acc_{value.Year}{value.Month}{sequence:D4}";
    }

    private Task<IEnumerable<Guid>> SearchCompanyAsync(string value)
    {
        IEnumerable<M_Customer> query = _companies;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.COMPANY?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Customer_Code?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.TaxCode?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => x.Customer_ID).Take(30));
    }

    private string CompanyToString(Guid id)
    {
        var c = _companies.FirstOrDefault(x => x.Customer_ID == id);
        if (c is null)
            return string.Empty;

        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);

        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        if (!string.IsNullOrWhiteSpace(code))
            return code;
        if (!string.IsNullOrWhiteSpace(company))
            return company;
        return c.Customer_ID.ToString();
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnLineRowClick(DataGridRowClickEventArgs<M_AccountingVoucherLines> args)
        => _selectedLine = args.Item;
    private string LineRowClass(M_AccountingVoucherLines row, int _) => _selectedLine?.Id == row.Id ? "selected-row-blue" : string.Empty;
    private void RecalcTotals()
    {
        _totalDebit = _lines.Sum(x => x.DebitAmount);
        _totalCredit = _lines.Sum(x => x.CreditAmount);
        _diff = _totalDebit - _totalCredit;
    }

    private async Task AddLineAsync()
    {
        if (!CanEditLines)
        {
            Snackbar.Add("Phải lưu chứng từ trước rồi mới thao tác dòng bút toán.", MudBlazor.Severity.Warning);
            return;
        }
        if (_model.Id == Guid.Empty)
            _model.Id = Guid.NewGuid();

        var dialog = DialogService.Show<AccountingVoucherLine_AddEditDialog>(
            "Thêm dòng bút toán",
            new DialogParameters
            {
                ["VoucherId"] = _model.Id,
                ["Line"] = null
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (rs.Canceled || rs.Data is not M_AccountingVoucherLines line)
            return;

        _lines.Add(line);
        ReindexLines();
        RecalcTotals();
    }

    private async Task EditLineAsync()
    {
        if (!CanEditLines)
        {
            Snackbar.Add("Phải lưu chứng từ trước rồi mới thao tác dòng bút toán.", MudBlazor.Severity.Warning);
            return;
        }
        if (_selectedLine is null)
            return;

        var editable = CloneLine(_selectedLine);
        var dialog = DialogService.Show<AccountingVoucherLine_AddEditDialog>(
            "Sửa dòng bút toán",
            new DialogParameters
            {
                ["VoucherId"] = _model.Id,
                ["Line"] = editable
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (rs.Canceled || rs.Data is not M_AccountingVoucherLines line)
            return;

        var idx = _lines.FindIndex(x => x.Id == line.Id);
        if (idx >= 0)
            _lines[idx] = line;
        _selectedLine = line;
        ReindexLines();
        RecalcTotals();
    }

    private Task RemoveLineAsync()
    {
        if (!CanEditLines)
        {
            Snackbar.Add("Phải lưu chứng từ trước rồi mới thao tác dòng bút toán.", MudBlazor.Severity.Warning);
            return Task.CompletedTask;
        }
        if (_selectedLine is null)
            return Task.CompletedTask;
        _lines.RemoveAll(x => x.Id == _selectedLine.Id);
        _selectedLine = null;
        ReindexLines();
        RecalcTotals();
        return Task.CompletedTask;
    }

    private static M_AccountingVouchers CloneVoucher(M_AccountingVouchers src) => new()
    {
        Id = src.Id,
        CompanyId = src.CompanyId,
        VoucherNo = src.VoucherNo,
        VoucherDate = src.VoucherDate,
        PostingDate = src.PostingDate,
        FiscalYear = src.FiscalYear,
        FiscalPeriod = src.FiscalPeriod,
        TransactionTypeCode = src.TransactionTypeCode,
        Description = src.Description,
        CurrencyCode = src.CurrencyCode,
        ExchangeRate = src.ExchangeRate,
        Status = src.Status,
        ReferenceNo = src.ReferenceNo,
        ReferenceDate = src.ReferenceDate,
        SourceModule = src.SourceModule,
        SourceId = src.SourceId,
        Ghiso = src.Ghiso,
        Both = src.Both,
        Approve = src.Approve,
        CreatedBy = src.CreatedBy,
        CreatedDate = src.CreatedDate,
        ModifiedBy = src.ModifiedBy,
        ModifiedDate = src.ModifiedDate,
        PostedBy = src.PostedBy,
        PostedDate = src.PostedDate,
        CancelledBy = src.CancelledBy,
        CancelledDate = src.CancelledDate
    };

    private static M_AccountingVoucherLines CloneLine(M_AccountingVoucherLines src) => new()
    {
        Id = src.Id,
        VoucherId = src.VoucherId,
        LineNo_ = src.LineNo_,
        DanhMucTaiKhoanID = src.DanhMucTaiKhoanID,
        AccountCode = src.AccountCode,
        DebitAmount = src.DebitAmount,
        CreditAmount = src.CreditAmount,
        DebitAmountFC = src.DebitAmountFC,
        CreditAmountFC = src.CreditAmountFC,
        LineDescription = src.LineDescription,
        CustomerId = src.CustomerId,
