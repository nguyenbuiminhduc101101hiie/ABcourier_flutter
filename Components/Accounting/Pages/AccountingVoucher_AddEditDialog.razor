    private void ReindexLines()
    {
        for (var i = 0; i < _lines.Count; i++)
        {
            _lines[i].LineNo_ = (i + 1).ToString();
            _lines[i].SortKey = i + 1;
            _lines[i].VoucherId = _model.Id;
            if (_lines[i].Id == Guid.Empty)
                _lines[i].Id = Guid.NewGuid();
        }
    }

    private string GetTenTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Tentaikhoan ?? string.Empty) : string.Empty;
    private string GetTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Taikhoan ?? string.Empty) : string.Empty;
    private string GetCustomerLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty) return string.Empty;
        if (!_customerById.TryGetValue(id.Value, out var c)) return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company)) return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }
    private string GetHblLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty) return string.Empty;
        return _hblById.TryGetValue(id.Value, out var h) ? (h.hbl ?? string.Empty) : string.Empty;
    }

    private Task ReloadLinesAsync()
    {
        if (!CanEditLines)
            return Task.CompletedTask;
        ReindexLines();
        RecalcTotals();
        return Task.CompletedTask;
    }

    private async Task RegenerateFromTransactionTypeAsync()
    {
        if (!CanEditLines)
        {
            Snackbar.Add("Phải lưu chứng từ trước rồi mới thao tác dòng bút toán.", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(_usr, "Edit", "PhieuKeToan"))
        {
            Snackbar.Add("Không có quyền sửa.", MudBlazor.Severity.Warning);
            return;
        }
        var confirm = await DialogService.ShowMessageBox("Xác nhận", "Xóa các dòng hiện tại và tạo lại theo cấu hình loại dịch vụ?", yesText: "Đồng ý", cancelText: "Hủy");
        if (confirm != true)
            return;
        if (string.IsNullOrWhiteSpace(_model.TransactionTypeCode))
        {
            Snackbar.Add("Chưa có loại dịch vụ trên chứng từ.", MudBlazor.Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var tt = await db.TransactionTypes.AsNoTracking().FirstOrDefaultAsync(x => x.Code == _model.TransactionTypeCode);
        if (tt is null)
        {
            Snackbar.Add("Không tìm thấy loại nghiệp vụ.", MudBlazor.Severity.Warning);
            return;
        }
        var mappings = await db.TransactionTypeMappings.AsNoTracking()
            .Where(x => x.TransactionID == tt.Id && (x.IsActive ?? false))
            .OrderBy(x => x.SortOrder)
            .ToListAsync();
        if (mappings.Count == 0)
        {
            Snackbar.Add("Chưa cấu hình chi tiết (TransactionTypeMappings) cho loại này.", MudBlazor.Severity.Warning);
            return;
        }

        var dmIds = mappings
            .Select(m => m.DanhMucTaiKhoanID)
            .Where(id => id.HasValue && id.Value != Guid.Empty)
            .Select(id => id!.Value)
            .Distinct()
            .ToHashSet();
        var dms = (await db.DanhMucTaiKhoan.AsNoTracking().ToListAsync())
            .Where(x => dmIds.Contains(x.Id))
            .ToDictionary(x => x.Id);

        _lines.Clear();
        var n = 1;
        foreach (var m in mappings)
        {
            if (m.DanhMucTaiKhoanID is null || !dms.TryGetValue(m.DanhMucTaiKhoanID.Value, out var dm))
                continue;
            _lines.Add(new M_AccountingVoucherLines
            {
                Id = Guid.NewGuid(),
                VoucherId = _model.Id,
                LineNo_ = n.ToString(),
                DanhMucTaiKhoanID = dm.Id,
                AccountCode = (dm.Taikhoan ?? string.Empty).Trim(),
                LineDescription = string.IsNullOrWhiteSpace(dm.Diengiai) ? (dm.Tentaikhoan ?? string.Empty) : dm.Diengiai!,
                DebitAmount = 0,
                CreditAmount = 0,
                DebitAmountFC = 0,
                CreditAmountFC = 0,
                IsTaxBook = false,
                IsManagementBook = false,
                SortKey = m.SortOrder ?? 0
            });
            n++;
        }
        ReindexLines();
        RecalcTotals();
        Snackbar.Add("Đã tạo dòng theo loại dịch vụ.", MudBlazor.Severity.Success);
    }

    private async Task PostToGeneralLedgerAsync()
    {
        if (!VoucherId.HasValue || _model.Id == Guid.Empty)
        {
            Snackbar.Add("Vui lòng lưu chứng từ trước khi ghi sổ.", MudBlazor.Severity.Warning);
            return;
        }

        if (_lines.Count == 0)
        {
            Snackbar.Add("Chưa có dòng bút toán để ghi sổ.", MudBlazor.Severity.Warning);
            return;
        }

        var totalDebit = _lines.Sum(x => x.DebitAmount);
        var totalCredit = _lines.Sum(x => x.CreditAmount);
        if (totalDebit != totalCredit)
        {
            Snackbar.Add("Tổng Nợ và Có phải bằng nhau trước khi ghi sổ.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var auth = await asv.GetAuth();
            var user = auth.User.Identity?.Name ?? "system";

            var oldEntries = await db.GeneralLedgerEntries
                .Where(x => x.VoucherId == _model.Id)
                .ToListAsync();
            if (oldEntries.Count > 0)
                db.GeneralLedgerEntries.RemoveRange(oldEntries);

            foreach (var line in _lines)
            {
                var gl = new M_GeneralLedgerEntries
                {
                    Id = Guid.NewGuid(),
                    VoucherId = _model.Id,
                    VoucherLineId = line.Id,
                    CompanyId = _model.CompanyId,
                    FiscalYear = _model.FiscalYear,
                    FiscalPeriod = _model.FiscalPeriod,
                    PostingDate = _model.PostingDate,
                    VoucherDate = _model.VoucherDate,
                    VoucherNo = _model.VoucherNo,
                    AccountCode = line.AccountCode,
                    Debit = line.DebitAmount,
                    Credit = line.CreditAmount,
                    CurrencyCode = _model.CurrencyCode,
                    ExchangeRate = _model.ExchangeRate,
                    DebitFC = line.DebitAmountFC,
                    CreditFC = line.CreditAmountFC,
                    CustomerId = line.CustomerId,
                    SupplierId = null,
                    EmployeeId = null,
                    ShipmentId = line.ShipmentId,
                    ContractId = Guid.TryParse(line.ContractId, out var contractGuid) ? contractGuid : null,
                    BranchCode = null,
                    Description = line.LineDescription,
                    SourceModule = _model.SourceModule,
                    SourceId = _model.SourceId?.ToString(),
                    CreatedAt = DateTime.UtcNow,
                    CreatedBy = user,
                    IsTaxBook = line.IsTaxBook,
                    IsManagementBook = line.IsManagementBook,
                    LedgerType=line.LedgerType,
                    SoHD = line.InvoiceNo
                };

                db.GeneralLedgerEntries.Add(gl);
            }

            var voucherEntity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _model.Id);
            if (voucherEntity is not null)
            {
                var postedAt = DateTime.UtcNow;
                voucherEntity.Ghiso = true;
                voucherEntity.Approve = true;
                voucherEntity.Status = 2; // 1-Posted
                voucherEntity.PostedBy = user;
                voucherEntity.PostedDate = postedAt;
                _model.Ghiso = true;
                _model.Approve = true;
                _model.Status = 2;
                _model.PostedBy = user;
                _model.PostedDate = postedAt;
            }

            await db.SaveChangesAsync();
            Snackbar.Add("Đã ghi sổ thành công.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (string.IsNullOrWhiteSpace(_model.TransactionTypeCode))
        {
            Snackbar.Add("Chọn loại nghiệp vụ.", MudBlazor.Severity.Warning);
            return;
        }
        var totalDebit = _lines.Sum(x => x.DebitAmount);
        var totalCredit = _lines.Sum(x => x.CreditAmount);
        if (totalDebit != totalCredit)
        {
            Snackbar.Add("Tổng Nợ và Có phải bằng nhau trước khi lưu.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var auth = await asv.GetAuth();
            var user = auth.User.Identity?.Name ?? "system";

            M_AccountingVouchers? oldVoucher = null;
            List<M_AccountingVoucherLines>? oldLines = null;

            if (VoucherId is null)
            {
                _model.Id = _model.Id == Guid.Empty ? Guid.NewGuid() : _model.Id;
                _model.CreatedBy = user;
                _model.CreatedDate = DateTime.UtcNow;
                if (_voucherDate.HasValue)
                {
                    _model.VoucherDate = _voucherDate.Value;
                }
                if (_postingDate.HasValue)
                    _model.PostingDate = _postingDate.Value;
                if (_createdDate.HasValue)
                    _model.CreatedDate = _createdDate.Value;
                _model.ModifiedDate = _modifiedDate;
                _model.CancelledDate = _cancelledDate;
                db.AccountingVouchers.Add(_model);
            }
            else
            {
                var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _model.Id);
                if (entity is null)
                {
                    Snackbar.Add(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                    return;
                }

                oldVoucher = CloneVoucher(entity);
                oldLines = await db.AccountingVoucherLines.AsNoTracking()
                    .Where(x => x.VoucherId == entity.Id)
                    .ToListAsync();

                entity.CompanyId = _model.CompanyId;
                entity.VoucherNo = _model.VoucherNo;
                if (_voucherDate.HasValue)
                {
                    entity.VoucherDate = _voucherDate.Value;
                }
                if (_postingDate.HasValue)
                    entity.PostingDate = _postingDate.Value;
                entity.FiscalYear = _model.FiscalYear;
                entity.FiscalPeriod = _model.FiscalPeriod;
                entity.TransactionTypeCode = _model.TransactionTypeCode;
                entity.Description = _model.Description;
                entity.CurrencyCode = _model.CurrencyCode;
                entity.ExchangeRate = _model.ExchangeRate;
                entity.Status = _model.Status;
                entity.ReferenceNo = _model.ReferenceNo;
                entity.ReferenceDate = _referenceDate;
                entity.SourceModule = _model.SourceModule;
                entity.SourceId = _model.SourceId;
                entity.CreatedBy = _model.CreatedBy;
                entity.CreatedDate = _createdDate ?? _model.CreatedDate;
                entity.ModifiedBy = string.IsNullOrWhiteSpace(_model.ModifiedBy) ? user : _model.ModifiedBy;
                entity.ModifiedDate = _modifiedDate ?? DateTime.UtcNow;
                entity.PostedBy = _model.PostedBy;
                entity.PostedDate = _model.PostedDate;
                entity.CancelledBy = _model.CancelledBy;
                entity.CancelledDate = _cancelledDate;
            }

            var persistedVoucherId = _model.Id;
            var existingLines = await db.AccountingVoucherLines
                .Where(x => x.VoucherId == persistedVoucherId)
                .ToListAsync();
            var keepIds = _lines.Select(x => x.Id).ToHashSet();
            var removeLines = existingLines.Where(x => !keepIds.Contains(x.Id)).ToList();
            if (removeLines.Count > 0)
                db.AccountingVoucherLines.RemoveRange(removeLines);

            foreach (var line in _lines)
            {
                line.VoucherId = persistedVoucherId;
                line.DebitAmountFC = line.DebitAmountFC == 0 ? line.DebitAmount : line.DebitAmountFC;
                line.CreditAmountFC = line.CreditAmountFC == 0 ? line.CreditAmount : line.CreditAmountFC;
                var entityLine = existingLines.FirstOrDefault(x => x.Id == line.Id);
                if (entityLine is null)
                {
                    db.AccountingVoucherLines.Add(CloneLine(line));
                    continue;
                }

                entityLine.LineNo_ = line.LineNo_;
                entityLine.DanhMucTaiKhoanID = line.DanhMucTaiKhoanID;
                entityLine.AccountCode = line.AccountCode;
                entityLine.DebitAmount = line.DebitAmount;
                entityLine.CreditAmount = line.CreditAmount;
                entityLine.DebitAmountFC = line.DebitAmountFC;
                entityLine.CreditAmountFC = line.CreditAmountFC;
                entityLine.LineDescription = line.LineDescription;
                entityLine.CustomerId = line.CustomerId;
                entityLine.ShipmentId = line.ShipmentId;
                entityLine.ContractId = line.ContractId;
                entityLine.BranchId = line.BranchId;
                entityLine.DepartmentId = line.DepartmentId;
                entityLine.DueDate = line.DueDate;
                entityLine.IsTaxBook = line.IsTaxBook;
                entityLine.IsManagementBook = line.IsManagementBook;
                entityLine.HBLNo = line.HBLNo;
                entityLine.BookingNo = line.BookingNo;
                entityLine.POLName = line.POLName;
                entityLine.PODName = line.PODName;
                entityLine.ContainerNo = line.ContainerNo;
                entityLine.ContainerSizeType = line.ContainerSizeType;
                entityLine.SaleName = line.SaleName;
                entityLine.DELName = line.DELName;
                entityLine.PORName = line.PORName;
                entityLine.TransportMode = line.TransportMode;
                entityLine.LedgerType = line.LedgerType;
                entityLine.TaxCode = line.TaxCode;
                entityLine.VatRate = line.VatRate;
                entityLine.InvoiceNo = line.InvoiceNo;
                entityLine.InvoiceDate = line.InvoiceDate;
                entityLine.SortKey = line.SortKey;
            }

            await db.SaveChangesAsync();

            if (VoucherId is null)
                await HistoryLogService.LogAsync(_usr, "ADD", "PhieuKeToan", _model.Id, _model.VoucherNo, new { Voucher = _model, Lines = _lines });
            else
                await HistoryLogService.LogAsync(_usr, "Update", "PhieuKeToan", _model.Id, _model.VoucherNo,
                    new { OldData = new { Voucher = oldVoucher, Lines = oldLines }, NewData = new { Voucher = _model, Lines = _lines } });

            RecalcTotals();
            Snackbar.Add("Đã lưu.", MudBlazor.Severity.Success);

            // New voucher: keep dialog open so user can continue with voucher lines.
            if (VoucherId is null)
            {
                VoucherId = _model.Id;
                Snackbar.Add("Có thể tiếp tục thao tác dòng bút toán bên dưới.", MudBlazor.Severity.Info);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
