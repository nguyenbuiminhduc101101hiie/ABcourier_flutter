        return voucherNo;
    }

    private async Task OpenLedgerSummary(string accountCode)
    {
        if (!OnTabRequest.HasDelegate)
        {
            Snackbar.Add("Không mở được tab 10.6.1 vì chưa truyền OnTabRequest.", MudBlazor.Severity.Warning);
            return;
        }

        var book = string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase) ? "TAX" : _book;

        RenderFragment content = builder =>
        {
            builder.OpenComponent<Components.Accounting.Pages.GeneralLedgerSummary_10_6_1>(0);
            builder.AddAttribute(1, "InitialAccountCode", accountCode);
            builder.AddAttribute(2, "InitialFiscalYear", _fiscalYear);
            builder.AddAttribute(3, "InitialPeriodMonth", _periodMonth);
            builder.AddAttribute(4, "InitialBook", book);
            builder.CloseComponent();
        };

        await OnTabRequest.InvokeAsync(($"GeneralLedgerSummary_{accountCode}_{_fiscalYear}_{_periodMonth}_{book}",
            $"10.6.1 Sổ cái - TK {accountCode}", content));
    }

