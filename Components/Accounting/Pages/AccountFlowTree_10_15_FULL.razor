    }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void ClearData()
    {
        _ledgerRows.Clear();
        _voucherNodes.Clear();
        _accountTNodes.Clear();
        _voucherCycleStageByVoucherNo.Clear();
    }

    private static string GetRootMessage(Exception ex)
    {
        var root = ex;
        while (root.InnerException is not null)
            root = root.InnerException;
        return root.Message;
    }

    private sealed record FlowStep(int No, string Title, string Text);
    private sealed record LogisticsCycleStage(string Code, int No, string Title, string Description, string AccountImpact);

    private sealed class LedgerFlowRow
    {
        public Guid Id { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime PostingDate { get; set; }
        public DateTime? VoucherDate { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string Book { get; set; } = string.Empty;
        public string SourceModule { get; set; } = string.Empty;
        public Guid? CustomerId { get; set; }
    }

    private sealed class VoucherNode
    {
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime PostingDate { get; set; }
        public List<LedgerFlowRow> Lines { get; set; } = new();
        public List<AccountBranchNode> AccountNodes { get; set; } = new();
        public decimal TotalDebit { get; set; }
        public decimal TotalCredit { get; set; }
        public string Title => $"Voucher {VoucherNo} | Nợ {TotalDebit:N0} / Có {TotalCredit:N0}";
    }

    private sealed class AccountBranchNode
    {
        public string AccountCode { get; set; } = string.Empty;
        public List<LedgerFlowRow> Lines { get; set; } = new();
    }

    private sealed class AccountTNode
    {
        public string AccountCode { get; set; } = string.Empty;
        public List<LedgerFlowRow> DebitLines { get; set; } = new();
        public List<LedgerFlowRow> CreditLines { get; set; } = new();
        public decimal TotalDebit => DebitLines.Sum(x => x.Debit);
        public decimal TotalCredit => CreditLines.Sum(x => x.Credit);
    }
}

