    private LedgerFlowRow NewSim(string voucherNo, string module, string description, string accountCode, decimal debit, decimal credit)
    {
        return new LedgerFlowRow
        {
            Id = Guid.NewGuid(),
            VoucherNo = voucherNo,
            PostingDate = DateTime.Today,
            VoucherDate = DateTime.Today,
            AccountCode = accountCode,
            Description = description,
            Debit = debit,
            Credit = credit,
            Book = "TAX",
            SourceModule = module
        };
    }

    private void BuildVoucherCycleStageMap()
    {
        _voucherCycleStageByVoucherNo = _ledgerRows
            .Where(x => !string.IsNullOrWhiteSpace(x.VoucherNo))
            .GroupBy(x => x.VoucherNo, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    var lines = g.ToList();

                    var hasCashIn = lines.Any(IsCashDebit);
                    var hasReceivableDecrease = lines.Any(IsReceivableCredit);
                    if (hasCashIn && hasReceivableDecrease)
                        return "COLLECT";

                    var hasPayableDecrease = lines.Any(IsPayableDebit);
                    var hasCashOut = lines.Any(IsCashCredit);
                    if (hasPayableDecrease && hasCashOut)
                        return "PAY";

                    var hasReceivableIncrease = lines.Any(IsReceivableDebit);
                    var hasRevenueOrOutputTax = lines.Any(x => Starts(x.AccountCode, "511") || Starts(x.AccountCode, "515") || Starts(x.AccountCode, "711") || Starts(x.AccountCode, "33311"));
                    if (hasReceivableIncrease && hasRevenueOrOutputTax)
                        return "AR";

                    var hasCostOrInputTax = lines.Any(x => Starts(x.AccountCode, "632") || Starts(x.AccountCode, "641") || Starts(x.AccountCode, "642") || Starts(x.AccountCode, "1331"));
                    var hasPayableIncrease = lines.Any(IsPayableCredit);
                    if (hasCostOrInputTax && hasPayableIncrease)
                        return "AP";

                    return "GL";
                },
                StringComparer.OrdinalIgnoreCase);
    }

    private static bool Starts(string? value, string prefix)
        => !string.IsNullOrWhiteSpace(value) && value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private static bool IsCashDebit(LedgerFlowRow row)
        => (Starts(row.AccountCode, "111") || Starts(row.AccountCode, "112")) && row.Debit > 0;

    private static bool IsCashCredit(LedgerFlowRow row)
        => (Starts(row.AccountCode, "111") || Starts(row.AccountCode, "112")) && row.Credit > 0;

    private static bool IsReceivableDebit(LedgerFlowRow row)
        => Starts(row.AccountCode, "131") && row.Debit > 0;

    private static bool IsReceivableCredit(LedgerFlowRow row)
        => Starts(row.AccountCode, "131") && row.Credit > 0;

    private static bool IsPayableDebit(LedgerFlowRow row)
        => Starts(row.AccountCode, "331") && row.Debit > 0;

    private static bool IsPayableCredit(LedgerFlowRow row)
        => Starts(row.AccountCode, "331") && row.Credit > 0;

    private void BuildNodes()
    {
        BuildVoucherCycleStageMap();

        _voucherNodes = _ledgerRows
            .GroupBy(x => x.VoucherNo)
            .Select(g => new VoucherNode
            {
                VoucherNo = g.Key,
                PostingDate = g.Min(x => x.PostingDate),
                Lines = g.OrderBy(x => x.AccountCode).ThenByDescending(x => x.Debit).ToList(),
                TotalDebit = g.Sum(x => x.Debit),
                TotalCredit = g.Sum(x => x.Credit),
                AccountNodes = g.GroupBy(x => x.AccountCode)
                    .OrderBy(a => a.Key)
                    .Select(a => new AccountBranchNode
                    {
                        AccountCode = a.Key,
                        Lines = a.OrderByDescending(x => x.Debit).ThenBy(x => x.Credit).ToList()
                    })
                    .ToList()
            })
            .OrderBy(x => x.PostingDate)
            .ThenBy(x => x.VoucherNo)
            .ToList();

        _accountTNodes = _ledgerRows
            .GroupBy(x => x.AccountCode)
            .OrderBy(g => g.Key)
            .Select(g => new AccountTNode
            {
                AccountCode = g.Key,
                DebitLines = g.Where(x => x.Debit > 0).OrderBy(x => x.PostingDate).ThenBy(x => x.VoucherNo).ToList(),
                CreditLines = g.Where(x => x.Credit > 0).OrderBy(x => x.PostingDate).ThenBy(x => x.VoucherNo).ToList()
            })
            .ToList();
    }

    private bool MatchesSearch(LedgerFlowRow row)
    {
        if (string.IsNullOrWhiteSpace(_voucherFilter))
            return true;

        var key = _voucherFilter.Trim();
        return row.VoucherNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || row.AccountCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || row.Description.Contains(key, StringComparison.OrdinalIgnoreCase)
            || row.SourceModule.Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<LedgerFlowRow> GetCycleStageRows(string stageCode)
    {
        if (string.Equals(stageCode, "REPORT", StringComparison.OrdinalIgnoreCase))
            return _ledgerRows;

        if (string.Equals(stageCode, "GL", StringComparison.OrdinalIgnoreCase))
            return _ledgerRows.Where(x => !string.IsNullOrWhiteSpace(x.VoucherNo));

        return _ledgerRows.Where(x => string.Equals(ClassifyCycleStage(x), stageCode, StringComparison.OrdinalIgnoreCase));
    }

    private decimal GetCycleStageAmount(string stageCode)
    {
        var rows = GetCycleStageRows(stageCode);

        if (string.Equals(stageCode, "REPORT", StringComparison.OrdinalIgnoreCase))
            return _accountTNodes.Sum(x => Math.Abs(x.TotalDebit - x.TotalCredit));

        return rows.Sum(GetStageLineAmount);
    }

    private decimal GetStageLineAmount(LedgerFlowRow row)
    {
        return row.Debit > 0 ? row.Debit : row.Credit;
    }

    private string CycleProgressText
    {
        get
        {
            var active = _logisticsCycle.Count(x => GetCycleStageRows(x.Code).Any());
            return $"{active}/{_logisticsCycle.Count} bước có dữ liệu";
        }
    }

    private string GetCycleStageClass(string stageCode)
    {
        return GetCycleStageRows(stageCode).Any() ? "cycle-stage-active" : "cycle-stage-empty";
    }

    private string GetCycleStageName(LedgerFlowRow row)
    {
        var code = ClassifyCycleStage(row);
        return _logisticsCycle.FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase))?.Title ?? "Voucher / GL";
    }

    private string ClassifyCycleStage(LedgerFlowRow row)
    {
        var source = (row.SourceModule ?? string.Empty).ToUpperInvariant();
        var voucher = (row.VoucherNo ?? string.Empty).ToUpperInvariant();
        var desc = (row.Description ?? string.Empty).ToUpperInvariant();
        var text = source + " " + voucher + " " + desc;
        var acc = row.AccountCode ?? string.Empty;

        if (text.Contains("RFQ") || text.Contains("QUOT"))
            return "RFQ";

        if (text.Contains("SHIPMENT") || text.Contains("BOOKING") || text.Contains("HBL") || text.Contains("MBL"))
            return "SHIPMENT";

        if (text.Contains("RECEIVE") || text.Contains("RECEIPT") || text.Contains("THU TIEN") || text.Contains("THU TIỀN"))
            return "COLLECT";

        if (text.Contains("PAY_SUPPLIER") || text.Contains("PAYMENT") || text.Contains("THANH TOAN") || text.Contains("THANH TOÁN") || text.Contains("TRA VENDOR") || text.Contains("TRẢ VENDOR"))
            return "PAY";

        // Account-based rule: Có 131 là giảm phải thu, thường là thu tiền/cấn trừ khách hàng.
        // Nếu không bắt rule này thì Có 131 bị gom về Debit khách hàng do chỉ nhìn acc.StartsWith("131").
        if (IsReceivableCredit(row))
            return "COLLECT";

        // Nợ 331 là giảm phải trả, thường là trả vendor.
        if (IsPayableDebit(row))
            return "PAY";

        // Với dòng tiền 111/112, xác định theo cặp tài khoản trong cùng voucher.
        if ((Starts(acc, "111") || Starts(acc, "112"))
            && _voucherCycleStageByVoucherNo.TryGetValue(row.VoucherNo, out var voucherStage)
            && (voucherStage == "COLLECT" || voucherStage == "PAY"))
        {
            return voucherStage;
        }

        if (source.Contains("LOG_SALE") || source.Contains("SALE_AR") || IsReceivableDebit(row) || acc.StartsWith("511") || acc.StartsWith("33311"))
            return "AR";

        if (source.Contains("CARRIER") || source.Contains("TRUCKING") || source.Contains("COST_AP") || source.Contains("PURCHASE") || IsPayableCredit(row) || acc.StartsWith("632") || acc.StartsWith("1331"))
            return "AP";

        return "GL";
    }

    private string GetAccountName(string accountCode)
    {
        if (_accountNames.TryGetValue(accountCode, out var name))
            return name;

        return accountCode switch
        {
            "1111" => "Tiền mặt",
            "1121" => "Tiền gửi ngân hàng",
            "131" => "Phải thu khách hàng",
            "1331" => "Thuế GTGT đầu vào",
            "331" => "Phải trả người bán",
            "33311" => "Thuế GTGT đầu ra",
            "511" => "Doanh thu",
            "5113" => "Doanh thu dịch vụ",
            "632" => "Giá vốn / chi phí trực tiếp",
            "642" => "Chi phí quản lý",
            _ => "Tài khoản " + accountCode
        };
    }

    private string GetLineExplanation(LedgerFlowRow row)
    {
        var side = row.Debit > 0 ? "Nợ" : "Có";
        var acc = row.AccountCode;

        return acc switch
        {
            "1111" when row.Debit > 0 => "Nợ 1111: tiền mặt tăng.",
            "1111" => "Có 1111: tiền mặt giảm do chi tiền.",
            "1121" when row.Debit > 0 => "Nợ 1121: tiền ngân hàng tăng.",
            "1121" => "Có 1121: tiền ngân hàng giảm do thanh toán.",
            "131" when row.Debit > 0 => "Nợ 131: tăng công nợ phải thu khách hàng.",
            "131" => "Có 131: giảm công nợ phải thu vì khách đã trả hoặc cấn trừ.",
            "331" when row.Debit > 0 => "Nợ 331: giảm công nợ phải trả vendor/nhà cung cấp.",
            "331" => "Có 331: tăng công nợ phải trả vendor/nhà cung cấp.",
            "1331" when row.Debit > 0 => "Nợ 1331: ghi nhận VAT đầu vào được khấu trừ.",
            "33311" => "Có 33311: ghi nhận VAT đầu ra phải nộp.",
            "511" or "5113" => "Có doanh thu: ghi nhận doanh thu bán hàng/dịch vụ.",
            "632" when row.Debit > 0 => "Nợ 632: ghi nhận giá vốn hoặc chi phí trực tiếp theo shipment/job.",
            "642" when row.Debit > 0 => "Nợ 642: ghi nhận chi phí quản lý doanh nghiệp.",
            _ => $"{side} {acc}: phát sinh theo bản chất tài khoản {GetAccountName(acc)}."
        };
    }

    private string GetReportDestination(string accountCode)
    {
        if (accountCode.StartsWith("131"))
            return "SOA/Aging phải thu 10.14 + Bảng cân đối TT99";
        if (accountCode.StartsWith("331"))
            return "SOA/Aging phải trả 10.14 + Bảng cân đối TT99";
        if (accountCode.StartsWith("1331"))
            return "Báo cáo VAT đầu vào 10.12.1 + Bảng cân đối";
        if (accountCode.StartsWith("33311"))
            return "Báo cáo VAT đầu ra 10.12.2 + Bảng cân đối";
        if (accountCode.StartsWith("111") || accountCode.StartsWith("112"))
            return "Báo cáo quỹ/ngân hàng + Bảng cân đối";
        if (accountCode.StartsWith("511") || accountCode.StartsWith("711"))
            return "Báo cáo kết quả kinh doanh / Profit";
        if (accountCode.StartsWith("632") || accountCode.StartsWith("641") || accountCode.StartsWith("642") || accountCode.StartsWith("635") || accountCode.StartsWith("821"))
            return "Báo cáo kết quả kinh doanh / Profit";
        if (accountCode.StartsWith("1") || accountCode.StartsWith("2") || accountCode.StartsWith("3") || accountCode.StartsWith("4"))
            return "Bảng cân đối kế toán TT99";

        return "Sổ cái tổng hợp và báo cáo liên quan";
    }

    private string GetAccountEndingText(AccountTNode acc)
    {
        var net = acc.TotalDebit - acc.TotalCredit;
        var code = acc.AccountCode;

        if (code.StartsWith("331") || code.StartsWith("333") || code.StartsWith("334") || code.StartsWith("338") || code.StartsWith("341") || code.StartsWith("411") || code.StartsWith("511") || code.StartsWith("711"))
        {
            if (net < 0) return $"Dư Có / tăng bên Có {Math.Abs(net):N0}.";
            if (net > 0) return $"Giảm bên Có hoặc phát sinh Nợ {net:N0}.";
            return "Không còn số dư/tác động ròng = 0.";
        }

        if (net > 0) return $"Dư Nợ / tăng bên Nợ {net:N0}.";
        if (net < 0) return $"Giảm bên Nợ hoặc phát sinh Có {Math.Abs(net):N0}.";
        return "Không còn số dư/tác động ròng = 0.";
    }

    private string ShortVoucher(string voucherNo)
    {
        // Giữ lại hàm này để không lỗi nếu còn chỗ khác gọi,
        // nhưng không còn cắt ngắn Voucher No nữa.
        if (string.IsNullOrWhiteSpace(voucherNo))
