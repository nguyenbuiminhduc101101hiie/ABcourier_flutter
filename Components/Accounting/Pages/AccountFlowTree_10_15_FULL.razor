@page "/accounting/account-flow-tree"
@page "/AccountFlowTree"
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>10.15 Cây T chu trình logistics</PageTitle>

<div class="product-price-page account-flow-page">
    <PpScreenHeader Title="10.15 Cây T chu trình logistics"
                    Subtitle="Theo dõi nối tiếp một job logistics: RFQ → Shipment/HBL → Debit/Credit → Voucher → Sổ cái → SOA/Aging/Profit">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_busy">
                    Load
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayCircle" OnClick="LoadSimulatorAsync" Disabled="_busy">
                    Simulator
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AccountBalance" OnClick="OpenAccountBalanceSnapshot" Disabled="_busy">
                    10.9.1 Balance
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintAsync" Disabled="_busy">
                    Print / PDF
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAsync" Disabled="_busy">
                    Reset
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="flow-filter-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Chọn theo"
                           Value="@_dateMode"
                           ValueChanged="OnDateModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("PERIOD")">Theo kỳ</MudSelectItem>
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">Từ ngày - đến ngày</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Year" Value="_fiscalYear" ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Month" Value="_periodMonth" ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày" @bind-Date="_fromDate"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày" @bind-Date="_toDate"
                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudSelect T="string" Label="Book" @bind-Value="_book"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudTextField @bind-Value="_accountFilter" Label="Account"
                              Placeholder="131, 331..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField @bind-Value="_voucherFilter" Label="Voucher / Search"
                              Placeholder="Số CT, mô tả, module..."
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            @DateModeHelpText
        </MudText>
    </MudPaper>

    <div id="accountFlowPrintArea">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="flow-stat-card voucher-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="flow-stat-icon" />
                    <MudText Typo="Typo.caption">Voucher</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@_voucherNodes.Count.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Số chứng từ đang xem</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="flow-stat-card line-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="flow-stat-icon" />
                    <MudText Typo="Typo.caption">Dòng định khoản</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@_ledgerRows.Count.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng Nợ = Tổng Có theo voucher</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="flow-stat-card debit-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.SouthWest" Class="flow-stat-icon" />
                    <MudText Typo="Typo.caption">Tổng Nợ</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@TotalDebit.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Debit movement</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="flow-stat-card credit-stat" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Filled.NorthEast" Class="flow-stat-icon" />
                    <MudText Typo="Typo.caption">Tổng Có</MudText>
                    <MudText Typo="Typo.h6" Class="fw-bold">@TotalCredit.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption" Color="@(IsBalanced? Color.Success: Color.Error)">
                        @(IsBalanced ? "Đang cân" : $"Lệch {(TotalDebit - TotalCredit):N0}")
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="flow-process-card pa-3 mb-2" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Luồng xử lý từ voucher đến báo cáo cuối cùng</MudText>
            <div class="flow-steps">
                @foreach (var step in _steps)
                {
                    <div class="flow-step">
                        <div class="step-number">@step.No</div>
                        <div class="step-body">
                            <div class="step-title">@step.Title</div>
                            <div class="step-text">@step.Text</div>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>

        <MudPaper Class="logistics-cycle-card pa-3 mb-2" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Chu trình logistics nối tiếp theo Job / HBL</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Mỗi bước bên dưới nhận dữ liệu từ bước trước và đẩy tiếp sang kế toán, công nợ, SOA, Aging và Profit.
                    </MudText>
                </MudStack>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @CycleProgressText
                </MudChip>
            </MudStack>

            <div class="cycle-timeline">
                @foreach (var stage in _logisticsCycle)
                {
                    var rows = GetCycleStageRows(stage.Code).ToList();
                    <div class="cycle-stage @GetCycleStageClass(stage.Code)">
                        <div class="cycle-stage-number">@stage.No</div>
                        <div class="cycle-stage-main">
                            <div class="cycle-stage-title">@stage.Title</div>
                            <div class="cycle-stage-desc">@stage.Description</div>
                            <div class="cycle-stage-meta">
                                <span>@stage.AccountImpact</span>
                                <b>@GetCycleStageAmount(stage.Code).ToString("N0")</b>
                            </div>
                            @if (rows.Count > 0)
                            {
                                <div class="cycle-stage-lines">
                                    @foreach (var row in rows)
                                    {
                                        <div class="cycle-mini-line">
                                            <span class="voucher-no-full" title="@row.VoucherNo">@row.VoucherNo</span>
                                            <span>@row.AccountCode</span>
                                            <b>@GetStageLineAmount(row).ToString("N0")</b>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="cycle-empty">Chưa có bút toán ở bước này trong dữ liệu đang lọc.</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="cycle-note">
                <b>Cách đọc:</b> Job logistics bắt đầu từ báo giá/booking, sau đó phát sinh doanh thu khách hàng và chi phí vendor. Khi tạo voucher, các dòng Nợ/Có đi vào sổ cái. Từ sổ cái hệ thống tính công nợ 131/331, SOA, Aging, balance và lợi nhuận theo HBL/job.
            </div>
        </MudPaper>

        @if (_usingSimulator)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-2" Variant="Variant.Outlined">
                Đang xem dữ liệu Simulator: mô phỏng nghiệp vụ logistics đầy đủ gồm xuất hóa đơn, ghi nhận chi phí hãng tàu, thu tiền khách hàng và trả vendor.
            </MudAlert>
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" lg="5">
                <MudPaper Class="flow-tree-card pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2 flex-wrap">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Cây nghiệp vụ theo Voucher</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@(IsBalanced? Color.Success: Color.Error)" Variant="Variant.Filled">
                            @(IsBalanced ? "Balanced" : "Unbalanced")
                        </MudChip>
                    </MudStack>

                    @if (_voucherNodes.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Chưa có dữ liệu. Bấm Load để lấy từ sổ cái hoặc Simulator để xem mẫu.
                        </MudText>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="flow-expansion">
                            @foreach (var node in _voucherNodes)
                            {
                                <MudExpansionPanel Text="@node.Title" Expanded="@(_voucherNodes.Count <= 3)">
                                    <div class="voucher-node">
                                        <div class="voucher-summary">
                                            <span><b>Ngày:</b> @node.PostingDate.ToString("dd/MM/yyyy")</span>
                                            <span><b>Dòng:</b> @node.Lines.Count</span>
                                            <span><b>Nợ:</b> @node.TotalDebit.ToString("N0")</span>
                                            <span><b>Có:</b> @node.TotalCredit.ToString("N0")</span>
                                        </div>

                                        @foreach (var acc in node.AccountNodes)
                                        {
                                            <div class="account-branch">
                                                <div class="branch-line"></div>
                                                <div class="account-branch-body">
                                                    <div class="account-branch-title">
                                                        TK @acc.AccountCode - @GetAccountName(acc.AccountCode)
                                                    </div>
                                                    <div class="account-branch-desc">
                                                        @GetReportDestination(acc.AccountCode)
                                                    </div>
                                                    @foreach (var line in acc.Lines)
                                                    {
                                                        <div class="line-leaf @(line.Debit > 0 ? "debit-leaf" : "credit-leaf")">
                                                            <span class="leaf-type">@(line.Debit > 0 ? "Nợ" : "Có")</span>
                                                            <span class="leaf-amount">@((line.Debit > 0 ? line.Debit : line.Credit).ToString("N0"))</span>
                                                            <span class="leaf-text">@GetLineExplanation(line)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudPaper Class="flow-t-card pa-3 mb-2" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Sổ cái chữ T theo tài khoản</MudText>
                    @if (_accountTNodes.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có tài khoản để hiển thị.</MudText>
                    }
                    else
                    {
                        <div class="t-account-grid">
                            @foreach (var acc in _accountTNodes)
                            {
                                <div class="t-account-box">
                                    <div class="t-account-title">
                                        <span>TK @acc.AccountCode</span>
                                        <small>@GetAccountName(acc.AccountCode)</small>
                                    </div>
                                    <div class="t-account-body">
                                        <div class="t-side debit-side">
                                            <div class="t-side-title">NỢ</div>
                                            @foreach (var line in acc.DebitLines)
                                            {
                                                <div class="t-row">
                                                    <span class="voucher-no-full" title="@line.VoucherNo">@line.VoucherNo</span>
                                                    <b>@line.Debit.ToString("N0")</b>
                                                </div>
                                            }
                                            <div class="t-total">@acc.TotalDebit.ToString("N0")</div>
                                        </div>
                                        <div class="t-side credit-side">
                                            <div class="t-side-title">CÓ</div>
                                            @foreach (var line in acc.CreditLines)
                                            {
                                                <div class="t-row">
                                                    <span class="voucher-no-full" title="@line.VoucherNo">@line.VoucherNo</span>
                                                    <b>@line.Credit.ToString("N0")</b>
                                                </div>
                                            }
                                            <div class="t-total">@acc.TotalCredit.ToString("N0")</div>
                                        </div>
                                    </div>
                                    <div class="t-ending">
                                        <b>Tác động cuối:</b> @GetAccountEndingText(acc)
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>

                <MudPaper Class="flow-summary-card pa-3" Elevation="0">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Kết quả cuối cùng theo tài khoản</MudText>
                    <MudTable Items="_accountTNodes" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>TK</MudTh>
                            <MudTh>Tên tài khoản</MudTh>
                            <MudTh Class="text-end">Nợ</MudTh>
                            <MudTh Class="text-end">Có</MudTh>
                            <MudTh>Ý nghĩa</MudTh>
                            <MudTh>Báo cáo nhận số liệu</MudTh>
                            <MudTh>Link</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="acc">
                            <MudTd DataLabel="TK">@acc.AccountCode</MudTd>
                            <MudTd DataLabel="Tên tài khoản">@GetAccountName(acc.AccountCode)</MudTd>
                            <MudTd DataLabel="Nợ" Class="text-end">@acc.TotalDebit.ToString("N0")</MudTd>
                            <MudTd DataLabel="Có" Class="text-end">@acc.TotalCredit.ToString("N0")</MudTd>
                            <MudTd DataLabel="Ý nghĩa">@GetAccountEndingText(acc)</MudTd>
                            <MudTd DataLabel="Báo cáo">@GetReportDestination(acc.AccountCode)</MudTd>
                            <MudTd DataLabel="Link">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.MenuBook"
                                           OnClick="@(() => OpenLedgerSummary(acc.AccountCode))">
                                    Sổ cái
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="flow-detail-card pa-3 mt-2" Elevation="0">
            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Chi tiết dòng định khoản từ sổ cái</MudText>
            <MudTable Items="VisibleLedgerRows" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Ngày</MudTh>
                    <MudTh>Voucher</MudTh>
                    <MudTh>TK</MudTh>
                    <MudTh>Tên TK</MudTh>
                    <MudTh Class="text-end">Nợ</MudTh>
                    <MudTh Class="text-end">Có</MudTh>
                    <MudTh>Giải thích dòng</MudTh>
                    <MudTh>Chu trình</MudTh>
                    <MudTh>Kết quả cuối</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="Ngày">@row.PostingDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Voucher" Class="voucher-no-cell"><span class="voucher-no-full" title="@row.VoucherNo">@row.VoucherNo</span></MudTd>
                    <MudTd DataLabel="TK">@row.AccountCode</MudTd>
                    <MudTd DataLabel="Tên TK">@GetAccountName(row.AccountCode)</MudTd>
                    <MudTd DataLabel="Nợ" Class="text-end">@(row.Debit == 0 ? "" : row.Debit.ToString("N0"))</MudTd>
                    <MudTd DataLabel="Có" Class="text-end">@(row.Credit == 0 ? "" : row.Credit.ToString("N0"))</MudTd>
                    <MudTd DataLabel="Giải thích">@GetLineExplanation(row)</MudTd>
                    <MudTd DataLabel="Chu trình">@GetCycleStageName(row)</MudTd>
                    <MudTd DataLabel="Kết quả">@GetReportDestination(row.AccountCode)</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </div>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";

    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private bool _busy;
    private bool _usingSimulator;
    private string _usr = string.Empty;
    private string _dateMode = "PERIOD";
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "TAX";
    private string _accountFilter = string.Empty;
    private string _voucherFilter = string.Empty;

    private List<LedgerFlowRow> _ledgerRows = new();
    private List<VoucherNode> _voucherNodes = new();
    private List<AccountTNode> _accountTNodes = new();
    private Dictionary<string, string> _accountNames = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> _voucherCycleStageByVoucherNo = new(StringComparer.OrdinalIgnoreCase);

    private readonly List<FlowStep> _steps = new()
    {
        new FlowStep(1, "Sales / RFQ", "Nhận yêu cầu báo giá, tạo quotation và xác định khách hàng, route, dịch vụ, giá bán dự kiến."),
        new FlowStep(2, "Shipment / HBL", "Khi job chạy thật, hệ thống gắn HBL/MBL/Booking, POL/POD, customer, vendor, sales, OPS/DOC."),
        new FlowStep(3, "Debit / Credit", "Tạo debit cho khách hàng và credit/chi phí cho vendor. Đây là nguồn tạo phiếu kế toán."),
        new FlowStep(4, "Voucher → GL", "Voucher sinh dòng Nợ/Có và post vào GeneralLedgerEntries. Tổng Nợ phải bằng Tổng Có."),
        new FlowStep(5, "Báo cáo cuối", "Từ sổ cái ra 131/331, SOA, Aging, Account Balance, TT99 và Profit theo HBL/job.")
    };

    private readonly List<LogisticsCycleStage> _logisticsCycle = new()
    {
        new LogisticsCycleStage("RFQ", 1, "RFQ / Quotation", "Khởi tạo nhu cầu, giá bán, customer và route.", "Chưa ghi sổ kế toán"),
        new LogisticsCycleStage("SHIPMENT", 2, "Shipment / HBL / Booking", "Job logistics được mở và gắn HBL, MBL, container, POL/POD.", "Là khóa nối dữ liệu kế toán"),
        new LogisticsCycleStage("AR", 3, "Debit khách hàng", "Ghi nhận doanh thu và công nợ phải thu khách hàng.", "Nợ 131 / Có 511, 33311"),
        new LogisticsCycleStage("AP", 4, "Credit vendor / chi phí", "Ghi nhận chi phí hãng tàu, trucking, kho bãi, customs và công nợ vendor.", "Nợ 632, 1331 / Có 331"),
        new LogisticsCycleStage("GL", 5, "Voucher → Sổ cái", "Tất cả dòng Nợ/Có được post vào GeneralLedgerEntries.", "Nguồn chính của báo cáo"),
        new LogisticsCycleStage("COLLECT", 6, "Thu tiền khách", "Khách hàng thanh toán công nợ.", "Nợ 1121 / Có 131"),
        new LogisticsCycleStage("PAY", 7, "Trả vendor", "Thanh toán nhà cung cấp, hãng tàu, trucking.", "Nợ 331 / Có 1121"),
        new LogisticsCycleStage("REPORT", 8, "SOA / Aging / Profit", "Kết thúc chu trình: công nợ còn lại, lợi nhuận job/HBL và báo cáo TT99.", "Account Balance + báo cáo cuối")
    };

    private IEnumerable<LedgerFlowRow> VisibleLedgerRows => string.IsNullOrWhiteSpace(_voucherFilter)
        ? _ledgerRows
        : _ledgerRows.Where(MatchesSearch);

    private decimal TotalDebit => _ledgerRows.Sum(x => x.Debit);
    private decimal TotalCredit => _ledgerRows.Sum(x => x.Credit);
    private bool IsBalanced => Math.Abs(TotalDebit - TotalCredit) < 1;
    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);
    private string DateModeHelpText => IsPeriodMode
        ? "Đang lọc theo kỳ kế toán: hệ thống dùng FiscalYear/FiscalPeriod và tự lấy từ ngày - đến ngày theo tháng."
        : "Đang lọc theo khoảng ngày: hệ thống dùng PostingDate từ ngày - đến ngày, không ép theo FiscalYear/FiscalPeriod.";

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        UpdateDateRange();
        await LoadAccountNamesAsync();
        await LoadAsync();
    }

    private async Task OnDateModeChanged(string value)
    {
        _dateMode = string.IsNullOrWhiteSpace(value) ? "PERIOD" : value;

        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();

        await LoadAsync();
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue)
            return;

        if (_periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        if (!_fromDate.HasValue)
            _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_toDate.HasValue)
            _toDate = DateTime.Today;

        if (_fromDate.Value.Date > _toDate.Value.Date)
        {
            var temp = _fromDate;
            _fromDate = _toDate;
            _toDate = temp;
        }
    }

    private async Task ResetAsync()
    {
        _usingSimulator = false;
        _dateMode = "PERIOD";
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "TAX";
        _accountFilter = string.Empty;
        _voucherFilter = string.Empty;
        UpdateDateRange();
        await LoadAsync();
    }

    private async Task LoadAccountNamesAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var accounts = await db.DanhMucTaiKhoan.AsNoTracking().ToListAsync();

            _accountNames = accounts
                .Where(x => !string.IsNullOrWhiteSpace(x.Taikhoan))
                .GroupBy(x => x.Taikhoan!.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var item = g.First();
                        return !string.IsNullOrWhiteSpace(item.Accountname)
                            ? item.Accountname!
                            : (!string.IsNullOrWhiteSpace(item.Tentaikhoan) ? item.Tentaikhoan! : g.Key);
                    },
                    StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            _accountNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private async Task LoadAsync()
    {
        _usingSimulator = false;

        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            ClearData();
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toExclusive = (_toDate?.Date ?? DateTime.Today).Date.AddDays(1);

            var query = db.GeneralLedgerEntries.AsNoTracking()
                .Where(x => x.AccountCode != null);

            // Theo kỳ: ưu tiên FiscalYear/FiscalPeriod. Không ép thêm PostingDate,
            // vì chứng từ tháng 4 có thể được post/cập nhật sau nhưng vẫn thuộc FiscalPeriod 4.
            if (IsPeriodMode)
            {
                if (_fiscalYear.HasValue)
                    query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

                if (_periodMonth.HasValue)
                    query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);
            }
            else
            {
                query = query.Where(x => x.PostingDate >= fromDate && x.PostingDate < toExclusive);
            }

            if (string.Equals(_book, "TAX", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsTaxBook == true || x.LedgerType == "TAX");

            if (string.Equals(_book, "MGMT", StringComparison.OrdinalIgnoreCase))
                query = query.Where(x => x.IsManagementBook == true || x.LedgerType == "MGMT");

            if (!string.IsNullOrWhiteSpace(_accountFilter))
            {
                var acc = _accountFilter.Trim();
                query = query.Where(x => x.AccountCode != null && x.AccountCode.StartsWith(acc));
            }

            if (!string.IsNullOrWhiteSpace(_voucherFilter))
            {
                var key = _voucherFilter.Trim();
                query = query.Where(x =>
                    (x.VoucherNo != null && x.VoucherNo.Contains(key)) ||
                    (x.AccountCode != null && x.AccountCode.Contains(key)) ||
                    (x.Description != null && x.Description.Contains(key)) ||
                    (x.SourceModule != null && x.SourceModule.Contains(key)));
            }

            var data = await query
                .OrderBy(x => x.PostingDate)
                .ThenBy(x => x.VoucherNo)
                .ThenBy(x => x.VoucherDate)
                .ThenBy(x => x.Id)
                .ToListAsync();

            _ledgerRows = data.Select(x => new LedgerFlowRow
            {
                Id = x.Id,
                VoucherNo = string.IsNullOrWhiteSpace(x.VoucherNo) ? "NO-VOUCHER" : x.VoucherNo!,
                PostingDate = x.PostingDate,
                VoucherDate = x.VoucherDate,
                AccountCode = x.AccountCode ?? string.Empty,
                Description = x.Description ?? string.Empty,
                Debit = x.Debit,
                Credit = x.Credit,
                Book = (x.IsTaxBook == true && x.IsManagementBook == true) ? "TAX/MGMT" :
                       (x.IsTaxBook == true) ? "TAX" :
                       (x.IsManagementBook == true) ? "MGMT" :
                       (!string.IsNullOrWhiteSpace(x.LedgerType) ? x.LedgerType! : ""),
                SourceModule = x.SourceModule ?? string.Empty,
                CustomerId = x.CustomerId
            }).ToList();

            BuildNodes();
            Snackbar.Add($"Loaded {_ledgerRows.Count:N0} dòng sổ cái.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GetRootMessage(ex), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

