            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent<Components.Accounting.Pages.AccountBalanceSnapshot_10_9_1>(0);
            builder.AddAttribute(1, nameof(Components.Accounting.Pages.AccountBalanceSnapshot_10_9_1.OnTabRequest), OnTabRequest);
            builder.CloseComponent();
        };

