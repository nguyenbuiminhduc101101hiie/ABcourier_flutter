@using ABFreight.Models
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ABFreight.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_reportCode"
                              Label="@Localizer["FinancialReportTypes_ReportCode"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["FinancialReportTypes_ReportCodeRequired"]"
                              MaxLength="64"
                              Disabled="IsEdit" />
                <MudTextField @bind-Value="_reportName"
                              Label="@Localizer["FinancialReportTypes_ReportName"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Required="true"
                              RequiredError="@Localizer["FinancialReportTypes_ReportNameRequired"]"
                              MaxLength="256" />
                <MudTextField @bind-Value="_formNo"
                              Label="@Localizer["FinancialReportTypes_FormNo"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="64" />
                <MudTextField @bind-Value="_description"
                              Label="@Localizer["FinancialReportTypes_Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              MaxLength="2000" />
                <MudNumericField T="int?" @bind-Value="_sortOrder"
                                 Label="@Localizer["FinancialReportTypes_SortOrder"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0" />
                <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@Localizer["FinancialReportTypes_IsActive"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_FinancialReportTypes? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    public sealed class FinancialReportTypesDialogResult
    {
        public Guid Id { get; init; }
        public string ReportCode { get; init; } = string.Empty;
        public string ReportName { get; init; } = string.Empty;
        public string? FormNo { get; init; }
        public string? Description { get; init; }
        public int? SortOrder { get; init; }
        public bool IsActive { get; init; }
        public bool IsEdit { get; init; }
    }

    private MudForm? _form;
    private string _reportCode = string.Empty;
    private string _reportName = string.Empty;
    private string? _formNo;
    private string? _description;
    private int? _sortOrder;
    private bool _isActive = true;

    protected override void OnParametersSet()
    {
        if (Model is null)
        {
            _reportCode = string.Empty;
            _reportName = string.Empty;
            _formNo = null;
            _description = null;
            _sortOrder = null;
            _isActive = true;
            return;
        }

        _reportCode = Model.ReportCode ?? string.Empty;
        _reportName = Model.ReportName ?? string.Empty;
        _formNo = Model.FormNo;
        _description = Model.Description;
        _sortOrder = Model.SortOrder;
        _isActive = Model.IsActive == true;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;

        var reportCode = _reportCode.Trim();
        var reportName = _reportName.Trim();
        if (string.IsNullOrEmpty(reportCode) || string.IsNullOrEmpty(reportName))
            return;

        MudDialog.Close(DialogResult.Ok(new FinancialReportTypesDialogResult
        {
            Id = Model?.id ?? Guid.Empty,
            ReportCode = reportCode,
            ReportName = reportName,
            FormNo = string.IsNullOrWhiteSpace(_formNo) ? null : _formNo.Trim(),
            Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            SortOrder = _sortOrder,
            IsActive = _isActive,
            IsEdit = IsEdit
        }));
    }
}
