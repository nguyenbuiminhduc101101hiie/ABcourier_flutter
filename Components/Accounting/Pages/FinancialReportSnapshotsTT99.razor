            || reportCode == "CASH_FLOW_INTERIM_SUMMARY_INDIRECT_TT99")
        {
            return key switch
            {
                "Assets" => "HĐKD",
                "Liabilities" => "HĐĐT",
                "Equity" => "HĐTC",
