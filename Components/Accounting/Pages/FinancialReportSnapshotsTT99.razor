        }

        RecalculateHeaderFromLines();

        var snapshotId = _snapshot.Id;
        var entity = await Db.FinancialReportSnapshots
            .FirstOrDefaultAsync(x => x.Id == snapshotId);

        if (entity is null)
            return;

        entity.BookCode = NormalizeBookCode(_snapshot.BookCode);
        entity.TotalAssets = _snapshot.TotalAssets;
        entity.TotalLiabilities = _snapshot.TotalLiabilities;
        entity.TotalEquity = _snapshot.TotalEquity;
        entity.TotalSource = _snapshot.TotalSource;
        entity.Difference = _snapshot.Difference;

        await Db.SaveChangesAsync();
        await LoadAsync();
        await BindSnapshotAsync(snapshotId);
    }

