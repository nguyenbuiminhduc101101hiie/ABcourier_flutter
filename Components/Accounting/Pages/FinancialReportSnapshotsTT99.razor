@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using OfficeOpenXml
@using OfficeOpenXml.Style
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@using ABFreight.Services
@attribute [Authorize]
@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS

<PageTitle>Financial Reports TT99</PageTitle>

<div class="product-price-page financial-report-snapshots-page">
    <PpScreenHeader Title="Financial Reports TT99"
                    Subtitle="Thông tư 99/2025/TT-BTC - Báo cáo tài chính">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NewSnapshot" Disabled="_busy">
                    @Localizer["new"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSnapshot" Disabled="_busy || !CanSaveHeader">
                    @Localizer["FinancialReportSnapshot.SaveHeader"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSnapshotAsync"
                           Disabled="_busy || !CanDeleteHeader">
                    @Localizer["FinancialReportSnapshot.DeleteHeader"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">
                    @Localizer["reload"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCurrentSnapshotToExcelAsync"
                           Disabled="_busy || !CanWorkWithLines">
                    Export Excel
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudAlert Severity="MudBlazor.Severity.Success"
              Variant="Variant.Outlined"
              Dense="true"
              Class="mb-2">
        TT99/2025 - Giao diện báo cáo tài chính mới: Báo cáo tình hình tài chính, KQKD, LCTT, Thuyết minh và Công nợ.
    </MudAlert>

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-2">
            @_pageError
        </MudAlert>
    }

    <MudPaper Class="pa-2 mb-2 frs-compact-toggle d-flex flex-wrap align-center gap-3" Elevation="0" Outlined="true">
        <MudText Typo="Typo.caption" Class="fw-bold mr-2">Hiển thị:</MudText>

        <MudButton Variant="Variant.Outlined"
                   Color="@(_showSnapshotList ? Color.Error : Color.Primary)"
                   Size="Size.Small"
                   StartIcon="@(_showSnapshotList ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   OnClick="@(() => _showSnapshotList = !_showSnapshotList)">
            @(_showSnapshotList ? "Ẩn Snapshot" : "Hiện Snapshot")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="@(_showHeaderPanel ? Color.Error : Color.Primary)"
                   Size="Size.Small"
                   StartIcon="@(_showHeaderPanel ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   OnClick="@(() => _showHeaderPanel = !_showHeaderPanel)">
            @(_showHeaderPanel ? "Ẩn Header" : "Hiện Header")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="@(_showLineEditor ? Color.Error : Color.Primary)"
                   Size="Size.Small"
                   StartIcon="@(_showLineEditor ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                   OnClick="@(() => _showLineEditor = !_showLineEditor)">
            @(_showLineEditor ? "Ẩn Editor" : "Hiện Editor")
        </MudButton>
    </MudPaper>

    <MudGrid Spacing="2">
        <MudItem xs="12" lg="4" Class="@(_showSnapshotList ? string.Empty : "frs-hide-snapshot-list")">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Snapshots"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @_snapshots.Count
                    </MudChip>
                </MudStack>

                <MudPaper Class="pa-2 mb-2 frs-filter-panel" Elevation="0" Outlined="true">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="_search"
                                          Label="Keyword"
                                          Placeholder="Search report, book, year, month, status, note..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Clearable="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>

                        <MudItem xs="12" sm="8">
                            <MudSelect T="string"
                                       Label="Report"
                                       @bind-Value="_reportFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Class="report-code-select"
                                       Style="width:100%;">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                @foreach (var rt in _financialReportTypes)
                                {
                                    <MudSelectItem T="string" Value="@NormalizeReportCode(rt.ReportCode)">
                                        @FormatReportOption(rt)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudSelect T="string"
                                       Label="Book"
                                       @bind-Value="_bookFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="6" sm="3">
                            <MudNumericField T="int?"
                                             Label="Year"
                                             @bind-Value="_yearFilter"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="2000"
                                             Max="2100" />
                        </MudItem>

                        <MudItem xs="6" sm="3">
                            <MudNumericField T="int?"
                                             Label="Month"
                                             @bind-Value="_monthFilter"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1"
                                             Max="12" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudSelect T="string"
                                       Label="Status"
                                       @bind-Value="_statusFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("DRAFT")">DRAFT</MudSelectItem>
                                <MudSelectItem T="string" Value="@("FINAL")">FINAL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("LOCKED")">LOCKED</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="3" Class="d-flex align-center justify-space-between ga-2">
                            <MudCheckBox T="bool"
                                         Label="Diff only"
                                         @bind-Value="_onlyDifference"
                                         Dense="true"
                                         Color="Color.Error" />

                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                                       OnClick="ClearSnapshotFilters">
                                Clear
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudDataGrid T="FinancialReportSnapshot"
                             Items="VisibleSnapshots"
                             Dense="true" Hover="true" Striped="true" Bordered="true"
                             Elevation="0" FixedHeader="true"
                             Class="snapshot-list-table"
                             Style="max-height: calc(100vh - 430px); overflow: auto;"
                             RowClassFunc="SnapshotRowClass"
                             RowClick="OnSnapshotClicked"
                             Filterable="true"
                             FilterMode="@DataGridFilterMode.ColumnFilterRow"
                             Loading="_busy">
                    <Columns>
                        @* 
                            FIX UNHANDLED ERROR:
                            MudBlazor PropertyColumn chỉ nên dùng property thật của model.
                            Các expression dạng GetReportDisplayName(x.ReportCode),
                            BookCodeOrDefault(x.BookCode), SnapshotPeriodLabel(x)
                            có thể làm DataGrid throw unhandled render exception.
                            Chuyển sang TemplateColumn để hiển thị giá trị computed.
                        *@
                        <TemplateColumn Title="@Localizer["FinancialReportSnapshot.ColReport"]">
                            <CellTemplate>
                                @GetReportDisplayName(context.Item.ReportCode)
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Book">
                            <CellTemplate>
                                @BookCodeOrDefault(context.Item.BookCode)
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="@Localizer["FinancialReportSnapshot.ColPeriod"]">
                            <CellTemplate>
                                @SnapshotPeriodLabel(context.Item)
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Property="x => x.Status" Title="@Localizer["FinancialReportSnapshot.ColStatus"]" />
                        <PropertyColumn Property="x => x.Difference" Title="@Localizer["FinancialReportSnapshot.ColDifference"]" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                            @Localizer["FinancialReportSnapshot.NoSnapshots"]
                        </MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="@(_showSnapshotList ? 8 : 12)">
            <MudStack Spacing="1">
                @if (_showHeaderPanel)
                {
                    <MudPaper Class="product-price-card pa-2 frs-header-panel" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1 flex-wrap">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Header"]</MudText>
                            @if (_snapshot.Id != Guid.Empty)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Fingerprint">
                                    @(_snapshot.Id.ToString()[..8])…
                                </MudChip>
                            }
                        </MudStack>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@Localizer["FinancialReportSnapshot.PeriodStatus"]</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="12" md="6" lg="7">
                                <MudSelect T="string" Label="@Localizer["FinancialReportSnapshot.ReportCode"]"
                                           Value="_snapshot.ReportCode"
                                           ValueChanged="OnHeaderReportCodeChangedAsync"
                                           ValueExpression="@(() => _snapshot.ReportCode)"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                           Class="report-code-select"
                                           Style="width:100%;">
                                    @foreach (var rt in _financialReportTypes)
                                    {
                                        <MudSelectItem T="string" Value="@rt.ReportCode">@FormatReportOption(rt)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2" lg="2">
                                <MudSelect T="string"
                                           Label="Book"
                                           @bind-Value="_snapshot.BookCode"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            @if (IsCustomerDebtReport(_snapshot.ReportCode))
                            {
                                <MudItem xs="12" sm="6" md="3" lg="3">
                                    <MudSelect T="string"
                                               Label="Khách hàng"
                                               @bind-Value="_selectedCustomerId"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true"
                                               Clearable="true"
                                               Class="report-code-select"
                                               Style="width:100%;">
                                        <MudSelectItem T="string" Value="@(string.Empty)">Tất cả khách hàng</MudSelectItem>
                                        @foreach (var customer in _customers)
                                        {
                                            <MudSelectItem T="string" Value="@customer.CustomerId.ToString()">
                                                @customer.DisplayName
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            }
                            <MudItem xs="6" sm="3" md="2">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Year"]" @bind-Value="_snapshot.FiscalYear"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100" />
                            </MudItem>
                            <MudItem xs="6" sm="3" md="2">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Month"]" @bind-Value="_snapshot.PeriodMonth"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="string" Label="@Localizer["FinancialReportSnapshot.ColStatus"]" @bind-Value="_snapshot.Status"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    <MudSelectItem T="string" Value="@("DRAFT")">DRAFT</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("FINAL")">FINAL</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("LOCKED")">LOCKED</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Label="@Localizer["FinancialReportSnapshot.FromDate"]" @bind-Date="_snapshot.FromDate"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Label="@Localizer["FinancialReportSnapshot.ToDate"]" @bind-Date="_snapshot.ToDate"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.CreatedBy"]" Value="_snapshot.CreatedBy"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.Note"]" @bind-Value="_snapshot.Note" Lines="2"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            @Localizer["FinancialReportSnapshot.Totals"] <span class="mud-text-secondary">@Localizer["FinancialReportSnapshot.TotalsHint"]</span>
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="6" sm="4" md="2">
                                <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                    <MudText Typo="Typo.caption">@GetTotalLabel("Assets")</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalAssets.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4" md="2">
                                <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                    <MudText Typo="Typo.caption">@GetTotalLabel("Liabilities")</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalLiabilities.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4" md="2">
                                <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                    <MudText Typo="Typo.caption">@GetTotalLabel("Equity")</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalEquity.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4" md="2">
                                <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                    <MudText Typo="Typo.caption">@GetTotalLabel("Source")</MudText>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalSource.ToString("N0")</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="4" md="4">
                                <MudPaper Class="pa-2 text-center frs-stat frs-stat-diff" Elevation="0" Outlined="true">
                                    <MudText Typo="Typo.caption">@GetTotalLabel("Difference")</MudText>
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold"
                                             Color="@(_snapshot.Difference == 0 ? Color.Success : Color.Error)">
                                        @_snapshot.Difference.ToString("N0")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                }

                <MudPaper Class="product-price-card pa-2 frs-lines-panel" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1 flex-wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Lines"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @string.Format(Localizer["FinancialReportSnapshot.LinesHint"], _lines.Count)
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudSelect T="string"
                                       Label="Generate book"
                                       @bind-Value="_generateBookCode"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Style="width:130px">
                                <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AutoMode"
                                       OnClick="GenerateLinesFromAccountBalanceAsync"
                                       Disabled="_busy || !CanGenerateLinesFromBalance">
                                @Localizer["FinancialReportSnapshot.GenerateFromAccountBalance"]
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLine"
                                       Disabled="_busy || !CanWorkWithLines">
                                @Localizer["FinancialReportSnapshot.SaveLine"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Dark"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Print"
                                       OnClick="PrintCurrentSnapshotAsync"
                                       Disabled="_busy || !CanWorkWithLines">
                                IN BẢN ĐẸP
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="NewLine" Disabled="_busy || !CanWorkWithLines">
                                @Localizer["FinancialReportSnapshot.NewLine"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteLine"
                                       Disabled="_busy || !CanWorkWithLines">
                                @Localizer["delete"]
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_headerSession == HeaderSessionMode.None)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                            @Localizer["FinancialReportSnapshot.SelectOrNewFirst"]
                        </MudAlert>
                    }
                    else if (!HeaderExistsInDb)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                            @Localizer["FinancialReportSnapshot.SaveHeaderFirst"]
                        </MudAlert>
                    }

                    <MudPaper Class="@($"pa-2 mb-2 frs-line-editor {(_showLineEditor ? string.Empty : "frs-hidden")}")" Elevation="0" Outlined="true">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" sm="3" md="2">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.LineCode"]" @bind-Value="_line.LineCode"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" sm="3" md="2">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.ParentCode"]" @bind-Value="_line.ParentLineCode"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.LineName"]" @bind-Value="_line.LineName"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" sm="2" md="1">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Sort"]" @bind-Value="_line.SortOrder"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" sm="2" md="1">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Level"]" @bind-Value="_line.LevelNo"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="9" />
                            </MudItem>
                            <MudItem xs="4" sm="4" md="2">
                                <MudNumericField T="decimal" Label="@Localizer["FinancialReportSnapshot.Amount"]" @bind-Value="_line.Amount"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                            </MudItem>
                            <MudItem xs="6" sm="4" md="2" Class="d-flex align-center ga-3">
                                <MudCheckBox T="bool" Label="@Localizer["FinancialReportSnapshot.Bold"]" @bind-Value="_line.IsBold" Dense="true" Color="Color.Primary" />
                                <MudCheckBox T="bool" Label="@Localizer["FinancialReportSnapshot.Total"]" @bind-Value="_line.IsTotalLine" Dense="true" Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudPaper Class="pa-1 mb-1 d-flex flex-wrap gap-2 frs-column-toggle" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.caption" Class="mr-2 d-flex align-center fw-bold">Hiển thị cột:</MudText>

                        <MudCheckBox T="bool" @bind-Value="_showCode"
                                     Label="Code"
                                     Dense="true"
                                     Color="Color.Primary" />

                        <MudCheckBox T="bool" @bind-Value="_showParent"
                                     Label="Parent"
                                     Dense="true"
                                     Color="Color.Primary" />

                        <MudCheckBox T="bool" @bind-Value="_showSort"
                                     Label="Sort"
                                     Dense="true"
                                     Color="Color.Primary" />

                        <MudCheckBox T="bool" @bind-Value="_showLevel"
                                     Label="Lvl"
                                     Dense="true"
                                     Color="Color.Primary" />

                        <MudCheckBox T="bool" @bind-Value="_showBold"
                                     Label="Bold"
                                     Dense="true"
                                     Color="Color.Primary" />

                        <MudCheckBox T="bool" @bind-Value="_showTotal"
                                     Label="Total"
                                     Dense="true"
                                     Color="Color.Primary" />
                    </MudPaper>

                    <MudDataGrid T="FinancialReportSnapshotLine"
                                 Items="_lines"
                                 Dense="true" Hover="true" Striped="true" Bordered="true"
                                 Elevation="0" FixedHeader="true"
                                 Class="@GetLinesTableClass()"
