    private bool CanOpenLedgerForLine(FinancialReportSnapshotLine line)
    {
        var accountCode = GetAccountCodeFromLine(line);
        return !string.IsNullOrWhiteSpace(accountCode) && accountCode.All(char.IsDigit);
    }

    private async Task OpenLedgerForLineAsync(FinancialReportSnapshotLine line)
    {
        var accountCode = GetAccountCodeFromLine(line);

        if (string.IsNullOrWhiteSpace(accountCode))
        {
            CallSnack("Không xác định được tài khoản từ dòng báo cáo này.", MudBlazor.Severity.Warning);
            return;
        }

        if (!OnTabRequest.HasDelegate)
        {
            CallSnack("Chưa truyền OnTabRequest từ NavMenu nên không thể mở tab 10.6.1.", MudBlazor.Severity.Warning);
            return;
        }

        var book = NormalizeBookCode(_snapshot.BookCode);

        RenderFragment content = builder =>
        {
            builder.OpenComponent<Components.Accounting.Pages.GeneralLedgerSummary_10_6_1>(0);
            builder.AddAttribute(1, "InitialAccountCode", accountCode);
            builder.AddAttribute(2, "InitialFiscalYear", _snapshot.FiscalYear);
            builder.AddAttribute(3, "InitialPeriodMonth", _snapshot.PeriodMonth);
            builder.AddAttribute(4, "InitialBook", book);
            builder.CloseComponent();
        };

        await OnTabRequest.InvokeAsync((
            $"GeneralLedgerSummary_{accountCode}_{_snapshot.FiscalYear}_{_snapshot.PeriodMonth}_{book}",
            $"10.6.1 Sổ cái tổng hợp - TK {accountCode}",
            content
        ));
    }


