    private void RecalculateHeaderFromLines()
    {
        var reportCode = NormalizeReportCode(_snapshot.ReportCode);

        if (NormalizeReportCode(_snapshot.ReportCode) == "TAX_REPORT_LOGISTICS_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "TAX_012")?.Amount ?? 0;       // VAT output
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "TAX_022")?.Amount ?? 0;  // VAT input deductible
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "TAX_034")?.Amount ?? 0;       // temporary CIT
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "TAX_043")?.Amount ?? 0;       // total tax payable
            _snapshot.Difference = _snapshot.TotalSource;
            return;
        }


        if (reportCode == "FINANCIAL_POSITION_TT99"
            || reportCode == "FINANCIAL_POSITION_INTERIM_FULL_TT99"
            || reportCode == "FINANCIAL_POSITION_INTERIM_SUMMARY_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "100")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "270")?.Amount
                ?? 0;

            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "300")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "400")?.Amount ?? 0;

            _snapshot.TotalSource =
                _lines.FirstOrDefault(x => x.LineCode == "440")?.Amount
                ?? (_snapshot.TotalLiabilities + _snapshot.TotalEquity);

            _snapshot.Difference = _snapshot.TotalAssets - _snapshot.TotalSource;
            return;
        }

        if (reportCode == "FINANCIAL_POSITION_NON_GOING_CONCERN_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "KLT_200")?.Amount ?? 0;
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "KLT_390")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "KLT_490")?.Amount ?? 0;
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "KLT_500")?.Amount ?? 0;
            _snapshot.Difference = _lines.FirstOrDefault(x => x.LineCode == "KLT_999")?.Amount
                ?? (_snapshot.TotalAssets - _snapshot.TotalSource);
            return;
        }

        if (reportCode == "CASH_FLOW_TT99"
            || reportCode == "CASH_FLOW_DIRECT_TT99"
            || reportCode == "CASH_FLOW_INTERIM_FULL_DIRECT_TT99"
            || reportCode == "CASH_FLOW_INTERIM_SUMMARY_DIRECT_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "B03_20")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_20")?.Amount
                ?? 0;

            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "B03_30")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_30")?.Amount
                ?? 0;

            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B03_40")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_40")?.Amount
                ?? 0;

            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "B03_50")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_50")?.Amount
                ?? 0;

            var beginCash = _lines.FirstOrDefault(x => x.LineCode == "B03_60")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_60")?.Amount
                ?? 0;

            var fxEffect = _lines.FirstOrDefault(x => x.LineCode == "B03_61")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_61")?.Amount
                ?? 0;

            var endCash = _lines.FirstOrDefault(x => x.LineCode == "B03_70")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03D_70")?.Amount
                ?? 0;

            _snapshot.Difference = endCash - (beginCash + _snapshot.TotalSource + fxEffect);
            return;
        }

        if (reportCode == "CASH_FLOW_INDIRECT_TT99"
            || reportCode == "CASH_FLOW_INTERIM_FULL_INDIRECT_TT99"
            || reportCode == "CASH_FLOW_INTERIM_SUMMARY_INDIRECT_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "B03_20")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_20")?.Amount
                ?? 0;

            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "B03_30")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_30")?.Amount
                ?? 0;

            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B03_40")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_40")?.Amount
                ?? 0;

            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "B03_50")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_50")?.Amount
                ?? 0;

            var beginCash = _lines.FirstOrDefault(x => x.LineCode == "B03_60")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_60")?.Amount
                ?? 0;

            var fxEffect = _lines.FirstOrDefault(x => x.LineCode == "B03_61")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_61")?.Amount
                ?? 0;

            var endCash = _lines.FirstOrDefault(x => x.LineCode == "B03_70")?.Amount
                ?? _lines.FirstOrDefault(x => x.LineCode == "B03I_70")?.Amount
                ?? 0;

            _snapshot.Difference = endCash - (beginCash + _snapshot.TotalSource + fxEffect);
            return;
        }

        if (reportCode == "NOTES_TO_FINANCIAL_STATEMENTS_TT99"
            || reportCode == "NOTES_INTERIM_SELECTED_TT99")
        {
            var cash = _lines.FirstOrDefault(x => x.LineCode == "B09_111")?.Amount ?? 0;
            var shortTermInvestments = _lines.FirstOrDefault(x => x.LineCode == "B09_121")?.Amount ?? 0;
            var receivables = _lines.FirstOrDefault(x => x.LineCode == "B09_131")?.Amount ?? 0;
            var inventory = _lines.FirstOrDefault(x => x.LineCode == "B09_141")?.Amount ?? 0;
            var prepaid = _lines.FirstOrDefault(x => x.LineCode == "B09_151")?.Amount ?? 0;
            var fixedAssetsNet = _lines.FirstOrDefault(x => x.LineCode == "B09_164")?.Amount ?? 0;

            _snapshot.TotalAssets = cash + shortTermInvestments + receivables + inventory + prepaid + fixedAssetsNet;

            var payables = _lines.FirstOrDefault(x => x.LineCode == "B09_171")?.Amount ?? 0;
            var taxPayable = _lines.FirstOrDefault(x => x.LineCode == "B09_181")?.Amount ?? 0;
            var borrowings = _lines.FirstOrDefault(x => x.LineCode == "B09_191")?.Amount ?? 0;

            _snapshot.TotalLiabilities = payables + taxPayable + borrowings;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B09_201")?.Amount ?? 0;
            _snapshot.TotalSource = _snapshot.TotalLiabilities + _snapshot.TotalEquity;
            _snapshot.Difference = _snapshot.TotalAssets - _snapshot.TotalSource;
            return;
        }

        if (reportCode == "NOTES_NON_GOING_CONCERN_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_200")?.Amount ?? 0;
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_390")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_490")?.Amount ?? 0;
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_500")?.Amount ?? 0;
            _snapshot.Difference = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_999")?.Amount
                ?? (_snapshot.TotalAssets - _snapshot.TotalSource);
            return;
        }

        if (reportCode == "DEBT_REPORT_TT99"
            || reportCode == "DEBT_BY_CUSTOMER_TT99"
            || reportCode == "DEBT_CUSTOMER_DETAIL_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "CN_180")?.Amount ?? 0;
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "CN_280")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "CN_900")?.Amount ?? 0;
            _snapshot.TotalSource =
                (_lines.FirstOrDefault(x => x.LineCode == "CN_180")?.Amount ?? 0)
                + (_lines.FirstOrDefault(x => x.LineCode == "CN_280")?.Amount ?? 0);
            _snapshot.Difference = _snapshot.TotalEquity;
            return;
        }

        _snapshot.TotalAssets = 0;
        _snapshot.TotalLiabilities = 0;
        _snapshot.TotalEquity = 0;
        _snapshot.TotalSource = 0;
        _snapshot.Difference = 0;
    }


