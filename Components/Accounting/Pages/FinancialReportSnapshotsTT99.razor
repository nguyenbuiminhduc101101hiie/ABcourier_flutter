    private static int GetOrdinalOrMinusOne(System.Data.Common.DbDataReader reader, params string[] names)
    {
        foreach (var name in names)
        {
            for (var i = 0; i < reader.FieldCount; i++)
            {
                if (string.Equals(reader.GetName(i), name, StringComparison.OrdinalIgnoreCase))
                    return i;
            }
        }

        return -1;
    }

    private static string? ReadString(System.Data.Common.DbDataReader reader, params string[] names)
    {
        var ordinal = GetOrdinalOrMinusOne(reader, names);
        return ordinal < 0 || reader.IsDBNull(ordinal) ? null : Convert.ToString(reader.GetValue(ordinal));
    }

    private static int ReadInt(System.Data.Common.DbDataReader reader, params string[] names)
    {
        var ordinal = GetOrdinalOrMinusOne(reader, names);
        return ordinal < 0 || reader.IsDBNull(ordinal) ? 0 : Convert.ToInt32(reader.GetValue(ordinal));
    }

    private static bool ReadBool(System.Data.Common.DbDataReader reader, params string[] names)
    {
        var ordinal = GetOrdinalOrMinusOne(reader, names);
        return ordinal >= 0 && !reader.IsDBNull(ordinal) && Convert.ToBoolean(reader.GetValue(ordinal));
    }

    private static decimal ReadDecimal(System.Data.Common.DbDataReader reader, params string[] names)
    {
        var ordinal = GetOrdinalOrMinusOne(reader, names);
        return ordinal < 0 || reader.IsDBNull(ordinal) ? 0 : Convert.ToDecimal(reader.GetValue(ordinal));
    }

    private static void AddCommandParameter(System.Data.Common.DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

    private static async Task<bool> ProcedureParameterExistsAsync(
        System.Data.Common.DbConnection conn,
        string procedureName,
        string parameterName)
    {
        await using var checkCmd = conn.CreateCommand();
        checkCmd.CommandText = @"
SELECT CASE WHEN EXISTS
(
    SELECT 1
    FROM sys.parameters
    WHERE object_id = OBJECT_ID(@procedure_name)
      AND name = @parameter_name
)
THEN 1 ELSE 0 END;";
        checkCmd.CommandType = System.Data.CommandType.Text;

        AddCommandParameter(checkCmd, "@procedure_name", procedureName);
        AddCommandParameter(checkCmd, "@parameter_name", parameterName.StartsWith("@") ? parameterName : "@" + parameterName);

        var result = await checkCmd.ExecuteScalarAsync();
        return Convert.ToInt32(result ?? 0) == 1;
    }

    private static async Task AddProcedureParameterIfExistsAsync(
        System.Data.Common.DbConnection conn,
        System.Data.Common.DbCommand cmd,
        string procedureName,
        string parameterName,
        object? value)
    {
        if (await ProcedureParameterExistsAsync(conn, procedureName, parameterName))
            AddCommandParameter(cmd, parameterName, value ?? DBNull.Value);
    }

    private async Task GenerateLinesFromAccountBalanceAsync()
    {
        if (!CanWorkWithLines)
        {
            CallSnack(Localizer["FinancialReportSnapshot.SaveHeaderFirstMsg"], MudBlazor.Severity.Warning);
            return;
        }

        var reportCode = NormalizeReportCode(_snapshot.ReportCode);
        var bookCode = NormalizeBookCode(_generateBookCode);
        _snapshot.ReportCode = reportCode;
        _snapshot.BookCode = bookCode;

        var procedureName = GetGenerateProcedureName(reportCode);

        if (string.IsNullOrWhiteSpace(procedureName))
        {
            CallSnack($"ReportCode {reportCode} chưa có thủ tục generate.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            Localizer["FinancialReportSnapshot.GenerateLinesConfirmTitle"],
            $"Generate report {reportCode} - {bookCode} cho kỳ {_snapshot.FiscalYear}/{_snapshot.PeriodMonth:00}?",
            yesText: Localizer["FinancialReportSnapshot.GenerateFromAccountBalance"],
            cancelText: Localizer["cancel"]);

        if (confirm != true)
            return;

        var createdBy = string.IsNullOrWhiteSpace(_snapshot.CreatedBy)
            ? _currentUser
            : _snapshot.CreatedBy.Trim();

        try
        {
            _busy = true;

            var generatedLines = new List<FinancialReportSnapshotLine>();
            var conn = Db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = procedureName;
                cmd.CommandType = System.Data.CommandType.StoredProcedure;
                cmd.CommandTimeout = 180;

                /*
                    FIX HANDLE:
                    Các procedure TT99 hiện không dùng cùng một bộ tham số:
                    - Một số dùng @Book
                    - Tax report dùng @BookCode
                    - Debt detail có thêm @CustomerId
                    - Một số procedure có @CreatedBy, @ClearOld, @CompanyId

                    Vì vậy không hard-code theo report type nữa.
                    Màn hình sẽ kiểm tra sys.parameters rồi chỉ add tham số nếu procedure thật sự có.
                    Tránh lỗi:
                    - Procedure or function has too many arguments specified
                    - Procedure expects parameter ... which was not supplied
                */

                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@FiscalYear", _snapshot.FiscalYear);
                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@PeriodMonth", _snapshot.PeriodMonth);

                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@Book", bookCode);
                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@BookCode", bookCode);

                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@CompanyId", DBNull.Value);
                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@CreatedBy", createdBy);
                await AddProcedureParameterIfExistsAsync(conn, cmd, procedureName, "@ClearOld", true);

                await AddProcedureParameterIfExistsAsync(
                    conn,
                    cmd,
                    procedureName,
                    "@CustomerId",
                    SelectedCustomerId.HasValue ? SelectedCustomerId.Value : DBNull.Value);

                await using var reader = await cmd.ExecuteReaderAsync();
                while (await reader.ReadAsync())
                {
                    generatedLines.Add(new FinancialReportSnapshotLine
                    {
                        Id = Guid.NewGuid(),
                        SnapshotId = _snapshot.Id,
                        ReportCode = reportCode,
                        LineCode = ReadString(reader, "LineCode") ?? string.Empty,
                        ParentLineCode = ReadString(reader, "ParentCode", "ParentLineCode"),
                        LineName = ReadString(reader, "LineName") ?? string.Empty,
                        SortOrder = ReadInt(reader, "SortOrder", "DisplayOrder"),
                        LevelNo = ReadInt(reader, "LevelNo", "LineLevel"),
                        IsBold = ReadBool(reader, "IsBold"),
                        IsTotalLine = ReadBool(reader, "IsTotal", "IsTotalLine"),
                        Amount = ReadDecimal(reader, "Amount"),
                        CreatedAt = DateTime.Now
                    });
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            if (generatedLines.Count == 0)
            {
                CallSnack(Localizer["FinancialReportSnapshot.GenerateLinesNoResult"], MudBlazor.Severity.Warning);
                return;
            }

            var oldLines = await Db.FinancialReportSnapshotLines
                .Where(x => x.SnapshotId == _snapshot.Id)
                .ToListAsync();

            if (oldLines.Count > 0)
                Db.FinancialReportSnapshotLines.RemoveRange(oldLines);

            Db.FinancialReportSnapshotLines.AddRange(generatedLines);
            await Db.SaveChangesAsync();

            _lines = generatedLines
                .OrderBy(x => x.SortOrder)
                .ToList();

            await SaveSnapshotTotalsAsync();
            await BindSnapshotAsync(_snapshot.Id);

            CallSnack($"Generate {reportCode} - {bookCode} thành công. Đã tạo {generatedLines.Count} dòng.", MudBlazor.Severity.Success);
        }
        catch (SqlException ex)
        {
            var msg = ex.Message;

            if (ex.Errors.Count > 0)
            {
                msg = string.Join(Environment.NewLine,
                    ex.Errors.Cast<SqlError>().Select(x => $"SQL {x.Number}: {x.Message}"));
            }

            CallSnack(msg, MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            CallSnack(root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

