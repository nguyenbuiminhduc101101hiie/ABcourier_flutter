    private static string NormalizeReportCode(string? reportCode)
    {
        return (reportCode ?? string.Empty).Trim().ToUpperInvariant();
    }

    private static string FormatReportOption(M_FinancialReportTypes rt)
    {
        var code = NormalizeReportCode(rt.ReportCode);
        var name = (rt.ReportName ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(name) || string.Equals(name, code, StringComparison.OrdinalIgnoreCase))
            return code;

        return $"{code} - {name}";
    }

    private string GetReportDisplayName(string? reportCode)
    {
        var code = NormalizeReportCode(reportCode);

        var reportType = _financialReportTypes.FirstOrDefault(x =>
            string.Equals(NormalizeReportCode(x.ReportCode), code, StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(reportType?.ReportName)
            ? code
            : reportType.ReportName;
    }

    private static string SnapshotPeriodLabel(FinancialReportSnapshot x) =>
        $"{x.FiscalYear} / {x.PeriodMonth:00}";

    private static string BookCodeOrDefault(string? bookCode)
    {
        return string.IsNullOrWhiteSpace(bookCode)
            ? "TAX"
            : bookCode.Trim().ToUpperInvariant();
    }

    private static string NormalizeBookCode(string? bookCode)
    {
        var value = BookCodeOrDefault(bookCode);
        return value == "MGMT" ? "MGMT" : "TAX";
    }

    private static Color GetBookColor(string? bookCode)
    {
        return BookCodeOrDefault(bookCode) switch
        {
            "MGMT" => Color.Warning,
            "TAX" => Color.Info,
            _ => Color.Default
        };
    }

    private static string BookLabel(string? bookCode) => BookCodeOrDefault(bookCode);

    private static string? GetGenerateProcedureName(string? reportCode)
    {
        return NormalizeReportCode(reportCode) switch
        {
            "FINANCIAL_POSITION_TT99"
                => "dbo.usp_GenerateFinancialPosition_TT99",

            "INCOME_STATEMENT_TT99"
                => "dbo.usp_GenerateIncomeStatement_TT99",

            "CASH_FLOW_TT99"
                => "dbo.usp_GenerateCashFlow_TT99",

            "CASH_FLOW_DIRECT_TT99"
                => "dbo.usp_GenerateCashFlow_TT99",

            "CASH_FLOW_INDIRECT_TT99"
                => "dbo.usp_GenerateCashFlow_TT99",

            "NOTES_TO_FINANCIAL_STATEMENTS_TT99"
                => "dbo.usp_GenerateNotes_TT99",

            "DEBT_CUSTOMER_DETAIL_TT99"
                => "dbo.usp_GenerateDebtCustomerDetail_TT99",

            "DEBT_BY_CUSTOMER_TT99"
                => "dbo.usp_GenerateDebtByCustomer_TT99",

            "TAX_REPORT_LOGISTICS_TT99"
                => "dbo.usp_GenerateTaxReportLogistics_TT99",

            _ => null
        };
    }

    private static bool IsCustomerDebtReport(string? reportCode)
    {
        var code = NormalizeReportCode(reportCode);
        return code == "DEBT_CUSTOMER_DETAIL_TT99"
            || code == "DEBT_BY_CUSTOMER_TT99";
    }

    private static bool IsTaxReportLogisticsReport(string? reportCode)
    {
        return NormalizeReportCode(reportCode) == "TAX_REPORT_LOGISTICS_TT99";
    }

    private Guid? SelectedCustomerId
    {
        get
        {
            return Guid.TryParse(_selectedCustomerId, out var id)
                ? id
                : null;
        }
    }
    private async Task PrintCurrentSnapshotAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private IEnumerable<FinancialReportSnapshot> VisibleSnapshots
    {
        get
        {
            var query = _snapshots.AsEnumerable();

            if (!string.Equals(_reportFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(NormalizeReportCode(x.ReportCode), _reportFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.Equals(_bookFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(BookCodeOrDefault(x.BookCode), _bookFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_yearFilter.HasValue)
            {
                query = query.Where(x => x.FiscalYear == _yearFilter.Value);
            }

            if (_monthFilter.HasValue)
            {
                query = query.Where(x => x.PeriodMonth == _monthFilter.Value);
            }

            if (!string.Equals(_statusFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(x.Status ?? string.Empty, _statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_onlyDifference)
            {
                query = query.Where(x => x.Difference != 0);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var keyword = _search.Trim();

                query = query.Where(x =>
                    (x.ReportCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    GetReportDisplayName(x.ReportCode).Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (x.BookCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Status?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Note?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    x.FiscalYear.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.PeriodMonth.ToString("00").Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.PeriodMonth.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.Difference.ToString("N0").Contains(keyword, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.CreatedAt)
                .ThenBy(x => GetReportDisplayName(x.ReportCode))
                .ThenBy(x => BookCodeOrDefault(x.BookCode));
        }
    }

    private void ClearSnapshotFilters()
    {
        _search = string.Empty;
        _bookFilter = "ALL";
        _reportFilter = "ALL";
        _statusFilter = "ALL";
        _yearFilter = null;
        _monthFilter = null;
        _onlyDifference = false;
    }


    private async Task OnHeaderReportCodeChangedAsync(string? value)
    {
        var newReportCode = NormalizeReportCode(value);
        var oldReportCode = NormalizeReportCode(_snapshot.ReportCode);

        if (string.IsNullOrWhiteSpace(newReportCode))
            return;

        if (string.Equals(newReportCode, oldReportCode, StringComparison.OrdinalIgnoreCase))
            return;

        _snapshot.ReportCode = newReportCode;

        if (!IsCustomerDebtReport(newReportCode))
            _selectedCustomerId = string.Empty;

        // Khi đổi loại báo cáo trên header, không giữ lại lines của báo cáo cũ
        // để tránh lỗi Header = CASH_FLOW_TT99 nhưng Lines vẫn là INCOME_STATEMENT_TT99.
        _lines.Clear();
        _line = new FinancialReportSnapshotLine
        {
            Id = Guid.NewGuid(),
            SnapshotId = _snapshot.Id,
            ReportCode = _snapshot.ReportCode,
            CreatedAt = DateTime.Now,
            SortOrder = 10
        };

        if (NormalizeReportCode(_snapshot.ReportCode) == "TAX_REPORT_LOGISTICS_TT99")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "TAX_012")?.Amount ?? 0;
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "TAX_022")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "TAX_034")?.Amount ?? 0;
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "TAX_043")?.Amount ?? 0;
            _snapshot.Difference = _snapshot.TotalSource;
            return;
        }

        _snapshot.TotalAssets = 0;
        _snapshot.TotalLiabilities = 0;
        _snapshot.TotalEquity = 0;
        _snapshot.TotalSource = 0;
        _snapshot.Difference = 0;

        if (_headerSession == HeaderSessionMode.EditingExisting && HeaderExistsInDb)
        {
            await SaveSnapshotInternal(false);
        }

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pageError = string.Empty;

            var auth = await asv.GetAuth();
            _usr = auth.User.Identity?.Name ?? string.Empty;
            _currentUser = string.IsNullOrWhiteSpace(_usr) ? "system" : _usr;
            _snapshot.CreatedBy = _currentUser;

            await LoadReportTypesAsync();
            await LoadCustomersAsync();
            await LoadCompanyInfoAsync();
            await LoadAsync();
            ResetToIdleState();
        }
        catch (Exception ex)
        {
            var root = ex;
            while (root.InnerException is not null)
                root = root.InnerException;

            _pageError = root.Message;
            CallSnack(root.Message, MudBlazor.Severity.Error);
        }
    }

    private static void AddDbParameterCompat(System.Data.Common.DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

    private static async Task<bool> SqlObjectExistsAsync(System.Data.Common.DbConnection conn, string objectName)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = "SELECT CASE WHEN OBJECT_ID(@object_name) IS NULL THEN 0 ELSE 1 END;";
        cmd.CommandType = System.Data.CommandType.Text;
        AddDbParameterCompat(cmd, "@object_name", objectName);

        var result = await cmd.ExecuteScalarAsync();
        return Convert.ToInt32(result ?? 0) == 1;
    }

    private static async Task<string?> FindFirstExistingColumnAsync(
        System.Data.Common.DbConnection conn,
        string objectName,
        params string[] candidateColumns)
    {
        /*
            Dùng vòng lặp đơn giản để tránh lỗi compile Razor với string.Join + Select index.
            COL_LENGTH nhận object name và column name dạng parameter được.
        */
        foreach (var col in candidateColumns)
        {
            await using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT CASE WHEN COL_LENGTH(@object_name, @column_name) IS NULL THEN 0 ELSE 1 END;";
            cmd.CommandType = System.Data.CommandType.Text;

            AddDbParameterCompat(cmd, "@object_name", objectName);
            AddDbParameterCompat(cmd, "@column_name", col);

            var result = await cmd.ExecuteScalarAsync();
            if (Convert.ToInt32(result ?? 0) == 1)
                return col;
        }

        return null;
    }

    private async Task LoadCompanyInfoAsync()
    {
        /*
            FIX lỗi:
            Invalid column name 'AccountName'
            Invalid column name 'BankAddress'
            Invalid column name 'BankName'
            Invalid column name 'IBAN_CODE'

            Không load CompanyInfo bằng EF ở màn hình này.
            Chỉ đọc raw SQL đúng các cột đang tồn tại: tên công ty và địa chỉ.
        */
        _companyInfo = null;

        try
        {
            var conn = Db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                string? tableName = null;

                foreach (var candidateTable in new[]
                {
                    "dbo.CompanyInfomation",
                    "dbo.CompanyInfo",
                    "dbo.company_info",
                    "dbo.company_information"
                })
                {
                    if (await SqlObjectExistsAsync(conn, candidateTable))
                    {
                        tableName = candidateTable;
                        break;
                    }
                }

                if (string.IsNullOrWhiteSpace(tableName))
                    return;

                var nameCol = await FindFirstExistingColumnAsync(
                    conn,
                    tableName,
                    "NameTiengViet",
                    "CompanyName",
                    "Name",
                    "company_name",
                    "TenCongTy",
                    "TenCongTyVN");

                var addressCol = await FindFirstExistingColumnAsync(
                    conn,
                    tableName,
                    "Address",
                    "DiaChi",
                    "CompanyAddress",
                    "company_address",
                    "AddressVN");

                var nameExpr = string.IsNullOrWhiteSpace(nameCol)
                    ? "CAST(NULL AS NVARCHAR(500))"
                    : $"CAST([{nameCol.Replace("]", "]]")}] AS NVARCHAR(500))";

                var addressExpr = string.IsNullOrWhiteSpace(addressCol)
                    ? "CAST(NULL AS NVARCHAR(1000))"
                    : $"CAST([{addressCol.Replace("]", "]]")}] AS NVARCHAR(1000))";

                await using var cmd = conn.CreateCommand();
                cmd.CommandText = $@"
SELECT TOP (1)
    NameTiengViet = {nameExpr},
    Address = {addressExpr}
FROM {tableName};";
                cmd.CommandType = System.Data.CommandType.Text;

                await using var reader = await cmd.ExecuteReaderAsync();
                if (await reader.ReadAsync())
                {
                    _companyInfo = new M_CompanyInfo
                    {
                        NameTiengViet = reader.IsDBNull(0) ? string.Empty : Convert.ToString(reader.GetValue(0)) ?? string.Empty,
                        Address = reader.IsDBNull(1) ? string.Empty : Convert.ToString(reader.GetValue(1)) ?? string.Empty
                    };
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }
        }
        catch (Exception ex)
        {
            // Không cho lỗi CompanyInfo làm sập màn hình báo cáo.
            CallSnack($"Không load được Company Info: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    private async Task LoadReportTypesAsync()
    {
        _financialReportTypes = await Db.FinancialReportTypes
            .AsNoTracking()
            .Where(x => x.IsActive == true
                && !string.IsNullOrWhiteSpace(x.ReportCode)
                && x.ReportCode.Contains("TT99"))
            .OrderBy(x => x.SortOrder)
            .ToListAsync();

        if (!_financialReportTypes.Any(x =>
            string.Equals(NormalizeReportCode(x.ReportCode), "TAX_REPORT_LOGISTICS_TT99", StringComparison.OrdinalIgnoreCase)))
        {
            _financialReportTypes.Add(new M_FinancialReportTypes
            {
                ReportCode = "TAX_REPORT_LOGISTICS_TT99",
                ReportName = "Báo cáo thuế công ty logistics TT99",
                SortOrder = 990,
                IsActive = true
            });
        }
    }

    private async Task LoadCustomersAsync()
    {
        _customers.Clear();

        var conn = Db.Database.GetDbConnection();
        var shouldClose = conn.State != System.Data.ConnectionState.Open;

        if (shouldClose)
            await conn.OpenAsync();

        try
        {
            await using var cmd = conn.CreateCommand();
            cmd.CommandText = @"
SELECT
    Customer_ID,
    CustomerCode = COALESCE(NULLIF(Customer_Code, N''), NULLIF(MainCode, N''), CONVERT(NVARCHAR(50), Customer_ID)),
    CustomerName = COALESCE(NULLIF(COMPANY, N''), NULLIF(EnglishName, N''), NULLIF(BIZName, N''), NULLIF(Customer_Code, N''), NULLIF(MainCode, N''), CONVERT(NVARCHAR(200), Customer_ID))
FROM dbo.CUSTOMER
WHERE Customer_ID IS NOT NULL
ORDER BY COALESCE(NULLIF(Customer_Code, N''), NULLIF(MainCode, N''), CONVERT(NVARCHAR(50), Customer_ID));";
            cmd.CommandType = System.Data.CommandType.Text;

            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                _customers.Add(new CustomerOption
                {
                    CustomerId = reader.IsDBNull(0) ? Guid.Empty : reader.GetGuid(0),
                    CustomerCode = reader.IsDBNull(1) ? string.Empty : Convert.ToString(reader.GetValue(1)) ?? string.Empty,
                    CustomerName = reader.IsDBNull(2) ? string.Empty : Convert.ToString(reader.GetValue(2)) ?? string.Empty
                });
            }
        }
        finally
        {
            if (shouldClose)
                await conn.CloseAsync();
        }
    }

