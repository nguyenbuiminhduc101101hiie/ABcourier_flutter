    private static string? GuessAccountCodeFromLine(FinancialReportSnapshotLine line)
    {
        var code = (line.LineCode ?? string.Empty).Trim().ToUpperInvariant();
        var name = (line.LineName ?? string.Empty).Trim().ToUpperInvariant();

        if (code.StartsWith("B09_", StringComparison.OrdinalIgnoreCase))
        {
            var tail = code.Replace("B09_", string.Empty, StringComparison.OrdinalIgnoreCase);
            if (tail.Length >= 3 && tail.Take(3).All(char.IsDigit))
                return tail[..3];
        }

        if (code.Length >= 3 && code.Take(3).All(char.IsDigit))
            return code[..3];

        if (name.Contains("TK 131", StringComparison.OrdinalIgnoreCase))
            return "131";

        if (name.Contains("TK 331", StringComparison.OrdinalIgnoreCase))
            return "331";

        if (name.Contains("TK 131/331", StringComparison.OrdinalIgnoreCase))
            return "131";

        return code switch
        {
            // Income Statement TT99
            "01" => "511",
            "02" => "632",
            "04" => "515",
            "05" => "635",
            "06" => "641",
            "07" => "642",
            "09" => "711",
            "10" => "811",
            "13" => "821",

            // Cash Flow TT99
            "B03_02" => "131",
            "B03_03" => "331",
            "B03_04" => "334",
            "B03_05" => "635",
            "B03_06" => "333",
            "B03_31" => "211",
            "B03_41" => "411",
            "B03_42" => "341",

            // Tax logistics TT99
            "TAX_011" => "511",
            "TAX_012" => "3331",
            "TAX_021" => "1331",
            "TAX_022" => "1331",
            "TAX_031" => "511",
            "TAX_032" => "632",
            "TAX_034" => "3334",
            "TAX_041" => "3331",
            "TAX_042" => "3334",
            "TAX_043" => "333",

            // Debt reports
            "CN_100" => "131",
            "CN_180" => "131",
            "CN_200" => "331",
            "CN_280" => "331",
            _ => null
        };
    }

    private bool IsDebtLikeReport()
    {
        var reportCode = NormalizeReportCode(_snapshot.ReportCode);
        return reportCode == "DEBT_REPORT_TT99"
            || reportCode == "DEBT_BY_CUSTOMER_TT99"
            || reportCode == "DEBT_CUSTOMER_DETAIL_TT99";
    }

    private static bool IsDebtDetailLine(FinancialReportSnapshotLine line)
    {
        return !line.IsTotalLine
            && !string.IsNullOrWhiteSpace(line.LineName)
            && line.LineName.Contains("|")
            && line.LineName.Contains("TK ", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetDebtLineTitle(string? lineName)
    {
        if (string.IsNullOrWhiteSpace(lineName))
            return string.Empty;

        var parts = lineName.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0]} | {parts[1]}" : lineName;
    }

    private static string GetDebtLineDetail(string? lineName)
    {
        if (string.IsNullOrWhiteSpace(lineName))
            return string.Empty;

        var parts = lineName.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 2 ? string.Join(" | ", parts.Skip(2)) : string.Empty;
    }

    private string BuildExportFileName()
    {
        var reportCode = NormalizeReportCode(_snapshot.ReportCode);
        var bookCode = NormalizeBookCode(_snapshot.BookCode);
        return $"{reportCode}_{bookCode}_{_snapshot.FiscalYear}_{_snapshot.PeriodMonth:00}.xlsx";
    }

    private async Task ExportCurrentSnapshotToExcelAsync()
    {
        if (!CanWorkWithLines)
        {
            CallSnack("Chọn snapshot có dữ liệu trước khi export Excel.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            if (_lines.Count == 0)
                await LoadLines(_snapshot.Id);

            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var stream = new MemoryStream();
            using (var package = new ExcelPackage(stream))
            {
                var worksheet = package.Workbook.Worksheets.Add("Report");

                var reportCode = NormalizeReportCode(_snapshot.ReportCode);
                var reportName = GetReportDisplayName(reportCode);
                var bookCode = NormalizeBookCode(_snapshot.BookCode);
                var titleRange = worksheet.Cells["A1:H1"];
                titleRange.Merge = true;
                worksheet.Cells[1, 1].Value = reportName;
                titleRange.Style.Font.Bold = true;
                titleRange.Style.Font.Size = 16;
                titleRange.Style.HorizontalAlignment = ExcelHorizontalAlignment.Center;
                titleRange.Style.Fill.PatternType = ExcelFillStyle.Solid;
                titleRange.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#1f4e79"));
                titleRange.Style.Font.Color.SetColor(System.Drawing.Color.White);

                var infoRange = worksheet.Cells["A2:H2"];
                infoRange.Merge = true;
                worksheet.Cells[2, 1].Value = $"ReportCode: {reportCode} | Book: {bookCode} | Kỳ: {_snapshot.FiscalYear}/{_snapshot.PeriodMonth:00} | From: {_snapshot.FromDate:dd/MM/yyyy} | To: {_snapshot.ToDate:dd/MM/yyyy}";
                infoRange.Style.Font.Italic = true;
                infoRange.Style.HorizontalAlignment = ExcelHorizontalAlignment.Center;

                var noteRange = worksheet.Cells["A3:H3"];
                noteRange.Merge = true;
                worksheet.Cells[3, 1].Value = string.IsNullOrWhiteSpace(_snapshot.Note) ? "" : _snapshot.Note;
                noteRange.Style.Font.Color.SetColor(System.Drawing.Color.DarkGray);
                noteRange.Style.WrapText = true;

                worksheet.Cells[5, 1].Value = GetTotalLabel("Assets");
                worksheet.Cells[5, 2].Value = _snapshot.TotalAssets;
                worksheet.Cells[5, 3].Value = GetTotalLabel("Liabilities");
                worksheet.Cells[5, 4].Value = _snapshot.TotalLiabilities;
                worksheet.Cells[5, 5].Value = GetTotalLabel("Equity");
                worksheet.Cells[5, 6].Value = _snapshot.TotalEquity;
                worksheet.Cells[5, 7].Value = GetTotalLabel("Difference");
                worksheet.Cells[5, 8].Value = _snapshot.Difference;

                worksheet.Cells[6, 1].Value = GetTotalLabel("Source");
                worksheet.Cells[6, 2].Value = _snapshot.TotalSource;
                worksheet.Cells[6, 3].Value = "Status";
                worksheet.Cells[6, 4].Value = _snapshot.Status;
                worksheet.Cells[6, 5].Value = "Created By";
                worksheet.Cells[6, 6].Value = _snapshot.CreatedBy;
                worksheet.Cells[6, 7].Value = "Created At";
                worksheet.Cells[6, 8].Value = _snapshot.CreatedAt;

                var summaryRange = worksheet.Cells[5, 1, 6, 8];
                ApplyThinBorder(summaryRange);
                summaryRange.Style.Fill.PatternType = ExcelFillStyle.Solid;
                summaryRange.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#eaf3f8"));
                summaryRange.Style.Font.Bold = true;
                worksheet.Cells["B5:B6"].Style.Numberformat.Format = "#,##0";
                worksheet.Cells["D5:D6"].Style.Numberformat.Format = "#,##0";
                worksheet.Cells["F5:F6"].Style.Numberformat.Format = "#,##0";
                worksheet.Cells["H5:H6"].Style.Numberformat.Format = "#,##0";
                worksheet.Cells[6, 8].Style.Numberformat.Format = "dd/MM/yyyy HH:mm";

                var startRow = 8;
                if (IsDebtLikeReport())
                    WriteDebtExcelTable(worksheet, startRow);
                else
                    WriteStandardExcelTable(worksheet, startRow);

                worksheet.View.FreezePanes(startRow + 1, 1);
                if (worksheet.Dimension != null)
                    worksheet.Cells[worksheet.Dimension.Address].AutoFitColumns();
                worksheet.Column(3).Width = Math.Min(Math.Max(worksheet.Column(3).Width, 35), 80);
                worksheet.Column(3).Style.WrapText = true;

                package.Save();
            }

            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                BuildExportFileName(),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            CallSnack("Export Excel thành công.", MudBlazor.Severity.Success);
        }
        catch (JSException)
        {
            CallSnack("Thiếu JS function downloadFileFromBase64. Thêm script download vào _Host.cshtml hoặc index.html.", MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void WriteStandardExcelTable(ExcelWorksheet worksheet, int startRow)
    {
        var headers = new[] { "Code", "Parent", "Name", "Sort", "Level", "Bold", "Total", "Amount" };
        for (var i = 0; i < headers.Length; i++)
            worksheet.Cells[startRow, i + 1].Value = headers[i];

        StyleHeaderRow(worksheet.Cells[startRow, 1, startRow, 8]);

        var row = startRow + 1;
        foreach (var line in _lines.OrderBy(x => x.SortOrder))
        {
            worksheet.Cells[row, 1].Value = line.LineCode;
            worksheet.Cells[row, 2].Value = line.ParentLineCode;
            worksheet.Cells[row, 3].Value = line.LineName;
            worksheet.Cells[row, 4].Value = line.SortOrder;
            worksheet.Cells[row, 5].Value = line.LevelNo;
            worksheet.Cells[row, 6].Value = line.IsBold ? "Y" : "";
            worksheet.Cells[row, 7].Value = line.IsTotalLine ? "Y" : "";
            worksheet.Cells[row, 8].Value = line.Amount;
            worksheet.Cells[row, 8].Style.Numberformat.Format = "#,##0";
            worksheet.Cells[row, 3].Style.Indent = Math.Min(Math.Max(line.LevelNo, 0), 8);

            if (line.IsBold || line.IsTotalLine)
                worksheet.Cells[row, 1, row, 8].Style.Font.Bold = true;

            if (line.IsTotalLine)
            {
                var totalRow = worksheet.Cells[row, 1, row, 8];
                totalRow.Style.Fill.PatternType = ExcelFillStyle.Solid;
                totalRow.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#fff2cc"));
            }

            row++;
        }

        StyleTableBody(worksheet.Cells[startRow, 1, Math.Max(startRow, row - 1), 8]);
    }

    private void WriteDebtExcelTable(ExcelWorksheet worksheet, int startRow)
    {
        var headers = new[] { "Code", "Parent", "Đối tượng / Nội dung", "Thông tin phát sinh", "Sort", "Level", "Total", "Amount" };
        for (var i = 0; i < headers.Length; i++)
            worksheet.Cells[startRow, i + 1].Value = headers[i];

        StyleHeaderRow(worksheet.Cells[startRow, 1, startRow, 8]);

        var row = startRow + 1;
        foreach (var line in _lines.OrderBy(x => x.SortOrder))
        {
            var isDebtDetail = IsDebtDetailLine(line);
            worksheet.Cells[row, 1].Value = line.LineCode;
            worksheet.Cells[row, 2].Value = line.ParentLineCode;
            worksheet.Cells[row, 3].Value = isDebtDetail ? GetDebtLineTitle(line.LineName) : line.LineName;
            worksheet.Cells[row, 4].Value = isDebtDetail ? GetDebtLineDetail(line.LineName) : string.Empty;
            worksheet.Cells[row, 5].Value = line.SortOrder;
            worksheet.Cells[row, 6].Value = line.LevelNo;
            worksheet.Cells[row, 7].Value = line.IsTotalLine ? "Y" : "";
            worksheet.Cells[row, 8].Value = line.Amount;
            worksheet.Cells[row, 8].Style.Numberformat.Format = "#,##0";
            worksheet.Cells[row, 3].Style.Indent = Math.Min(Math.Max(line.LevelNo, 0), 8);

            if (line.IsBold || line.IsTotalLine)
                worksheet.Cells[row, 1, row, 8].Style.Font.Bold = true;

            if (line.IsTotalLine)
            {
                var totalRow = worksheet.Cells[row, 1, row, 8];
                totalRow.Style.Fill.PatternType = ExcelFillStyle.Solid;
                totalRow.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#fff2cc"));
            }

            row++;
        }

        StyleTableBody(worksheet.Cells[startRow, 1, Math.Max(startRow, row - 1), 8]);
    }

    private static void StyleHeaderRow(ExcelRange headerRange)
    {
        headerRange.Style.Font.Bold = true;
        headerRange.Style.Fill.PatternType = ExcelFillStyle.Solid;
        headerRange.Style.Fill.BackgroundColor.SetColor(System.Drawing.ColorTranslator.FromHtml("#d9eaf7"));
        headerRange.Style.HorizontalAlignment = ExcelHorizontalAlignment.Center;
        ApplyThinBorder(headerRange);
    }

    private static void StyleTableBody(ExcelRange tableRange)
    {
        ApplyThinBorder(tableRange);
        tableRange.Style.VerticalAlignment = ExcelVerticalAlignment.Center;
    }

    private static void ApplyThinBorder(ExcelRange range)
    {
        range.Style.Border.Top.Style = ExcelBorderStyle.Thin;
        range.Style.Border.Bottom.Style = ExcelBorderStyle.Thin;
        range.Style.Border.Left.Style = ExcelBorderStyle.Thin;
        range.Style.Border.Right.Style = ExcelBorderStyle.Thin;
    }

    private string SnapshotRowClass(FinancialReportSnapshot row, int _) =>
        CanSaveHeader && row.Id == _snapshot.Id ? "selected" : string.Empty;

    private string LineRowClass(FinancialReportSnapshotLine row, int _) =>
        row.Id == _line.Id ? "selected" : string.Empty;

    private static Color GetStatusColor(string? status) => status switch
    {
        "FINAL" => Color.Success,
        "LOCKED" => Color.Warning,
        _ => Color.Default
    };

    private string GetLineStyle(FinancialReportSnapshotLine row)
    {
        var padding = row.LevelNo * 20;
        var fontWeight = row.IsBold ? "font-weight:700;" : "";
        return $"{fontWeight} padding-left:{padding}px;";
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
