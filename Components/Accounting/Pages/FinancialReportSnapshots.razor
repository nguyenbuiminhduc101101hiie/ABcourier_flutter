@page "/accounting/financial-report-snapshots"
@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using OfficeOpenXml
@using OfficeOpenXml.Style
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using ABFreight.Resources
@using ABFreight.Services
@attribute [Authorize]
@inject AppDbContext Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS

<PageTitle>@($"10.11 {Localizer["FinancialReportSnapshot.Title"]}")</PageTitle>

<div class="product-price-page financial-report-snapshots-page">
    <PpScreenHeader Title="@($"10.11 {Localizer["FinancialReportSnapshot.Title"]}")"
                    Subtitle="@Localizer["FinancialReportSnapshot.Subtitle"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="NewSnapshot" Disabled="_busy">
                    @Localizer["new"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSnapshot" Disabled="_busy || !CanSaveHeader">
                    @Localizer["FinancialReportSnapshot.SaveHeader"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSnapshotAsync"
                           Disabled="_busy || !CanDeleteHeader">
                    @Localizer["FinancialReportSnapshot.DeleteHeader"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">
                    @Localizer["reload"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCurrentSnapshotToExcelAsync"
                           Disabled="_busy || !CanWorkWithLines">
                    Export Excel
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudGrid Spacing="2">
        <MudItem xs="12" lg="4">
            <MudPaper Class="product-price-card pa-3" Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Snapshots"]</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @_snapshots.Count
                    </MudChip>
                </MudStack>

                <MudPaper Class="pa-2 mb-2 frs-filter-panel" Elevation="0" Outlined="true">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="_search"
                                          Label="Keyword"
                                          Placeholder="Search report, book, year, month, status, note..."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true"
                                          Clearable="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Label="Report"
                                       @bind-Value="_reportFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                @foreach (var rt in _financialReportTypes)
                                {
                                    <MudSelectItem T="string" Value="@NormalizeReportCode(rt.ReportCode)">
                                        @(rt.ReportName ?? rt.ReportCode)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Label="Book"
                                       @bind-Value="_bookFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="6" sm="3">
                            <MudNumericField T="int?"
                                             Label="Year"
                                             @bind-Value="_yearFilter"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="2000"
                                             Max="2100" />
                        </MudItem>

                        <MudItem xs="6" sm="3">
                            <MudNumericField T="int?"
                                             Label="Month"
                                             @bind-Value="_monthFilter"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1"
                                             Max="12" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudSelect T="string"
                                       Label="Status"
                                       @bind-Value="_statusFilter"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("DRAFT")">DRAFT</MudSelectItem>
                                <MudSelectItem T="string" Value="@("FINAL")">FINAL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("LOCKED")">LOCKED</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="3" Class="d-flex align-center justify-space-between ga-2">
                            <MudCheckBox T="bool"
                                         Label="Diff only"
                                         @bind-Value="_onlyDifference"
                                         Dense="true"
                                         Color="Color.Error" />

                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.FilterAltOff"
                                       OnClick="ClearSnapshotFilters">
                                Clear
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudDataGrid T="FinancialReportSnapshot"
                             Items="VisibleSnapshots"
                             Dense="true" Hover="true" Striped="true" Bordered="true"
                             Elevation="0" FixedHeader="true"
                             Class="snapshot-list-table"
                             Style="max-height: calc(100vh - 430px); overflow: auto;"
                             RowClassFunc="SnapshotRowClass"
                             RowClick="OnSnapshotClicked"
                             Filterable="true"
                             FilterMode="@DataGridFilterMode.ColumnFilterRow"
                             Loading="_busy">
                    <Columns>
                        <PropertyColumn Property="x => GetReportDisplayName(x.ReportCode)" Title="@Localizer["FinancialReportSnapshot.ColReport"]" />
                        <PropertyColumn Property="x => BookCodeOrDefault(x.BookCode)" Title="Book" />
                        <PropertyColumn Property="x => SnapshotPeriodLabel(x)" Title="@Localizer["FinancialReportSnapshot.ColPeriod"]" />
                        <PropertyColumn Property="x => x.Status" Title="@Localizer["FinancialReportSnapshot.ColStatus"]" />
                        <PropertyColumn Property="x => x.Difference" Title="@Localizer["FinancialReportSnapshot.ColDifference"]" Format="N0" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                            @Localizer["FinancialReportSnapshot.NoSnapshots"]
                        </MudText>
                    </NoRecordsContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="8">
            <MudStack Spacing="2">
                <MudPaper Class="product-price-card pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2 flex-wrap">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Header"]</MudText>
                        @if (_snapshot.Id != Guid.Empty)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Fingerprint">
                                @(_snapshot.Id.ToString()[..8])…
                            </MudChip>
                        }
                    </MudStack>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@Localizer["FinancialReportSnapshot.PeriodStatus"]</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="string" Label="@Localizer["FinancialReportSnapshot.ReportCode"]" @bind-Value="_snapshot.ReportCode"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var rt in _financialReportTypes)
                                {
                                    <MudSelectItem T="string" Value="@rt.ReportCode">@(rt.ReportName ?? rt.ReportCode)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="string"
                                       Label="Book"
                                       @bind-Value="_snapshot.BookCode"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Year"]" @bind-Value="_snapshot.FiscalYear"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100" />
                        </MudItem>
                        <MudItem xs="6" sm="3" md="2">
                            <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Month"]" @bind-Value="_snapshot.PeriodMonth"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="string" Label="@Localizer["FinancialReportSnapshot.ColStatus"]" @bind-Value="_snapshot.Status"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                <MudSelectItem T="string" Value="@("DRAFT")">DRAFT</MudSelectItem>
                                <MudSelectItem T="string" Value="@("FINAL")">FINAL</MudSelectItem>
                                <MudSelectItem T="string" Value="@("LOCKED")">LOCKED</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="@Localizer["FinancialReportSnapshot.FromDate"]" @bind-Date="_snapshot.FromDate"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="@Localizer["FinancialReportSnapshot.ToDate"]" @bind-Date="_snapshot.ToDate"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.CreatedBy"]" Value="_snapshot.CreatedBy"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.Note"]" @bind-Value="_snapshot.Note" Lines="2"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                        @Localizer["FinancialReportSnapshot.Totals"] <span class="mud-text-secondary">@Localizer["FinancialReportSnapshot.TotalsHint"]</span>
                    </MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="4" md="2">
                            <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption">@GetTotalLabel("Assets")</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalAssets.ToString("N0")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption">@GetTotalLabel("Liabilities")</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalLiabilities.ToString("N0")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption">@GetTotalLabel("Equity")</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalEquity.ToString("N0")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <MudPaper Class="pa-2 text-center frs-stat" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption">@GetTotalLabel("Source")</MudText>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">@_snapshot.TotalSource.ToString("N0")</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="4" md="4">
                            <MudPaper Class="pa-2 text-center frs-stat frs-stat-diff" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption">@GetTotalLabel("Difference")</MudText>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold"
                                         Color="@(_snapshot.Difference == 0 ? Color.Success : Color.Error)">
                                    @_snapshot.Difference.ToString("N0")
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudPaper Class="product-price-card pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2 flex-wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["FinancialReportSnapshot.Lines"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @string.Format(Localizer["FinancialReportSnapshot.LinesHint"], _lines.Count)
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                            <MudSelect T="string"
                                       Label="Generate book"
                                       @bind-Value="_generateBookCode"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true"
                                       Style="width:130px">
                                <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                                <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                            </MudSelect>
                            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AutoMode"
                                       OnClick="GenerateLinesFromAccountBalanceAsync"
                                       Disabled="_busy || !CanGenerateLinesFromBalance">
                                @Localizer["FinancialReportSnapshot.GenerateFromAccountBalance"]
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLine"
                                       Disabled="_busy || !CanWorkWithLines">
                                @Localizer["FinancialReportSnapshot.SaveLine"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="NewLine" Disabled="_busy || !CanWorkWithLines">
                                @Localizer["FinancialReportSnapshot.NewLine"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteLine"
                                       Disabled="_busy || !CanWorkWithLines">
                                @Localizer["delete"]
                            </MudButton>
                        </MudStack>
                    </MudStack>

                    @if (_headerSession == HeaderSessionMode.None)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                            @Localizer["FinancialReportSnapshot.SelectOrNewFirst"]
                        </MudAlert>
                    }
                    else if (!HeaderExistsInDb)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                            @Localizer["FinancialReportSnapshot.SaveHeaderFirst"]
                        </MudAlert>
                    }

                    <MudPaper Class="pa-2 mb-2 frs-line-editor" Elevation="0" Outlined="true">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" sm="3" md="2">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.LineCode"]" @bind-Value="_line.LineCode"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" sm="3" md="2">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.ParentCode"]" @bind-Value="_line.ParentLineCode"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField T="string" Label="@Localizer["FinancialReportSnapshot.LineName"]" @bind-Value="_line.LineName"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" sm="2" md="1">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Sort"]" @bind-Value="_line.SortOrder"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" sm="2" md="1">
                                <MudNumericField T="int" Label="@Localizer["FinancialReportSnapshot.Level"]" @bind-Value="_line.LevelNo"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="9" />
                            </MudItem>
                            <MudItem xs="4" sm="4" md="2">
                                <MudNumericField T="decimal" Label="@Localizer["FinancialReportSnapshot.Amount"]" @bind-Value="_line.Amount"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                            </MudItem>
                            <MudItem xs="6" sm="4" md="2" Class="d-flex align-center ga-3">
                                <MudCheckBox T="bool" Label="@Localizer["FinancialReportSnapshot.Bold"]" @bind-Value="_line.IsBold" Dense="true" Color="Color.Primary" />
                                <MudCheckBox T="bool" Label="@Localizer["FinancialReportSnapshot.Total"]" @bind-Value="_line.IsTotalLine" Dense="true" Color="Color.Primary" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudDataGrid T="FinancialReportSnapshotLine"
                                 Items="_lines"
                                 Dense="true" Hover="true" Striped="true" Bordered="true"
                                 Elevation="0" FixedHeader="true"
                                 Class="lines-table"
                                 Style="max-height: calc(100vh - 520px); overflow: auto;"
                                 RowClassFunc="LineRowClass"
                                 RowClick="OnLineClicked"
                                 Filterable="true"
                                 FilterMode="@DataGridFilterMode.ColumnFilterRow"
                                 Loading="_busy">
                        <Columns>
                            <PropertyColumn Property="x => x.LineCode" Title="@Localizer["FinancialReportSnapshot.ColCode"]" />
                            <PropertyColumn Property="x => x.ParentLineCode" Title="@Localizer["FinancialReportSnapshot.ColParent"]" />
                            <PropertyColumn Property="x => x.LineName" Title="@Localizer["FinancialReportSnapshot.ColName"]">
                                <CellTemplate>
                                    <div style="@GetLineStyle(context.Item)">
                                        @if (IsDebtLikeReport() && IsDebtDetailLine(context.Item))
                                        {
                                            <MudText Typo="Typo.body2" Class="fw-bold">@GetDebtLineTitle(context.Item.LineName)</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetDebtLineDetail(context.Item.LineName)</MudText>
                                        }
                                        else
                                        {
                                            @context.Item.LineName
                                        }
                                    </div>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.SortOrder" Title="@Localizer["FinancialReportSnapshot.Sort"]" />
                            <PropertyColumn Property="x => x.LevelNo" Title="@Localizer["FinancialReportSnapshot.Level"]" />
                            <PropertyColumn Property="x => x.IsBold" Title="@Localizer["FinancialReportSnapshot.Bold"]" />
                            <PropertyColumn Property="x => x.IsTotalLine" Title="@Localizer["FinancialReportSnapshot.Total"]" />
                            <PropertyColumn Property="x => x.Amount" Title="@Localizer["FinancialReportSnapshot.Amount"]" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        </Columns>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                                @Localizer["FinancialReportSnapshot.NoLines"]
                            </MudText>
                        </NoRecordsContent>
                    </MudDataGrid>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
</div>

<style>
    .financial-report-snapshots-page .frs-stat {
        border-radius: 10px;
        background: #f8fafc;
    }

    .financial-report-snapshots-page .frs-stat-diff {
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
    }

    .financial-report-snapshots-page .frs-line-editor {
        border-radius: 12px;
        background: #fafbfc;
    }

    .financial-report-snapshots-page .frs-filter-panel {
        border-radius: 12px;
        background: #fbfdff;
    }

    .financial-report-snapshots-page .snapshot-list-table thead,
    .financial-report-snapshots-page .lines-table thead {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

@code {
    private const string PermissionMenuName = "FinancialReportSnapshot";

    private enum HeaderSessionMode { None, NewDraft, EditingExisting }

    private bool _busy;
    private HeaderSessionMode _headerSession = HeaderSessionMode.None;
    private string _usr = string.Empty;
    private string _currentUser = string.Empty;
    private string _search = string.Empty;
    private string _bookFilter = "ALL";
    private string _reportFilter = "ALL";
    private string _statusFilter = "ALL";
    private int? _yearFilter;
    private int? _monthFilter;
    private bool _onlyDifference;
    private string _generateBookCode = "TAX";
    private List<FinancialReportSnapshot> _snapshots = new();
    private List<FinancialReportSnapshotLine> _lines = new();
    private List<M_FinancialReportTypes> _financialReportTypes = new();

    private FinancialReportSnapshot _snapshot = new();

    private FinancialReportSnapshotLine _line = new();

    private bool HeaderExistsInDb =>
        _snapshots.Any(x => x.Id == _snapshot.Id);

    private bool CanSaveHeader => _headerSession != HeaderSessionMode.None;

    private bool CanWorkWithLines =>
        _headerSession == HeaderSessionMode.EditingExisting && HeaderExistsInDb;

    private bool CanDeleteHeader =>
        _headerSession == HeaderSessionMode.EditingExisting && HeaderExistsInDb;

    private bool CanGenerateLinesFromBalance =>
        CanWorkWithLines
        && GetGenerateProcedureName(_snapshot.ReportCode) != null;

    private static string NormalizeReportCode(string? reportCode)
    {
        return (reportCode ?? string.Empty).Trim().ToUpperInvariant();
    }

    private static bool IsTt200Report(string? reportCode)
    {
        var code = NormalizeReportCode(reportCode);

        if (string.IsNullOrWhiteSpace(code))
            return false;

        // TT200 page: show legacy TT200 report codes (no suffix) and new *_TT200 codes.
        // Hide all TT99 report codes.
        return !code.Contains("TT99");
    }

    private string GetReportDisplayName(string? reportCode)
    {
        var code = NormalizeReportCode(reportCode);

        var reportType = _financialReportTypes.FirstOrDefault(x =>
            string.Equals(NormalizeReportCode(x.ReportCode), code, StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(reportType?.ReportName)
            ? code
            : reportType.ReportName;
    }

    private static string SnapshotPeriodLabel(FinancialReportSnapshot x) =>
        $"{x.FiscalYear} / {x.PeriodMonth:00}";

    private static string BookCodeOrDefault(string? bookCode)
    {
        return string.IsNullOrWhiteSpace(bookCode)
            ? "TAX"
            : bookCode.Trim().ToUpperInvariant();
    }

    private static string NormalizeBookCode(string? bookCode)
    {
        var value = BookCodeOrDefault(bookCode);
        return value == "MGMT" ? "MGMT" : "TAX";
    }

    private static Color GetBookColor(string? bookCode)
    {
        return BookCodeOrDefault(bookCode) switch
        {
            "MGMT" => Color.Warning,
            "TAX" => Color.Info,
            _ => Color.Default
        };
    }

    private static string BookLabel(string? bookCode) => BookCodeOrDefault(bookCode);

    private static string? GetGenerateProcedureName(string? reportCode)
    {
        var code = NormalizeReportCode(reportCode);

        return code switch
        {
            "BALANCE_SHEET" or "BALANCE_SHEET_TT200"
                => "dbo.usp_GenerateBalanceSheetSnapshot_FromAccountBalance_TT200",

            "BALANCE_SHEET_NON_GOING_CONCERN" or "BALANCE_SHEET_NON_GOING_CONCERN_TT200"
                => "dbo.usp_GenerateBalanceSheetNonGoingConcernSnapshot_TT200",

            "BALANCE_SHEET_INTERIM_FULL" or "BALANCE_SHEET_INTERIM_FULL_TT200"
                => "dbo.usp_GenerateBalanceSheetInterimFull_TT200",

            "BALANCE_SHEET_INTERIM_SUMMARY" or "BALANCE_SHEET_INTERIM_SUMMARY_TT200"
                => "dbo.usp_GenerateBalanceSheetInterimSummary_TT200",

            "INCOME_STATEMENT" or "INCOME_STATEMENT_TT200"
                => "dbo.usp_GenerateIncomeStatementSnapshot_FromGeneralLedger_TT200",

            "INCOME_STATEMENT_INTERIM_FULL" or "INCOME_STATEMENT_INTERIM_FULL_TT200"
                => "dbo.usp_GenerateIncomeStatementInterimFull_TT200",

            "INCOME_STATEMENT_INTERIM_SUMMARY" or "INCOME_STATEMENT_INTERIM_SUMMARY_TT200"
                => "dbo.usp_GenerateIncomeStatementInterimSummary_TT200",

            "CASH_FLOW_DIRECT" or "CASH_FLOW_DIRECT_TT200"
                => "dbo.usp_GenerateCashFlowDirectSnapshot_TT200",

            "CASH_FLOW_INDIRECT" or "CASH_FLOW_INDIRECT_TT200"
                => "dbo.usp_GenerateCashFlowIndirectSnapshot_TT200",

            "CASH_FLOW_INTERIM_FULL_DIRECT" or "CASH_FLOW_INTERIM_FULL_DIRECT_TT200"
                => "dbo.usp_GenerateCashFlowInterimFullDirect_TT200",

            "CASH_FLOW_INTERIM_FULL_INDIRECT" or "CASH_FLOW_INTERIM_FULL_INDIRECT_TT200"
                => "dbo.usp_GenerateCashFlowInterimFullIndirect_TT200",

            "CASH_FLOW_INTERIM_SUMMARY_DIRECT" or "CASH_FLOW_INTERIM_SUMMARY_DIRECT_TT200"
                => "dbo.usp_GenerateCashFlowInterimSummaryDirect_TT200",

            "CASH_FLOW_INTERIM_SUMMARY_INDIRECT" or "CASH_FLOW_INTERIM_SUMMARY_INDIRECT_TT200"
                => "dbo.usp_GenerateCashFlowInterimSummaryIndirect_TT200",

            "NOTES_TO_FINANCIAL_STATEMENTS" or "NOTES_TO_FINANCIAL_STATEMENTS_TT200"
                => "dbo.usp_GenerateNotesToFinancialStatements_TT200",

            "NOTES_TO_FINANCIAL_STATEMENTS_NGC" or "NOTES_TO_FINANCIAL_STATEMENTS_NGC_TT200"
                => "dbo.usp_GenerateNotesNonGoingConcern_TT200",

            "NOTES_INTERIM_SELECTED" or "NOTES_INTERIM_SELECTED_TT200"
                => "dbo.usp_GenerateNotesInterimSelected_TT200",

            "DEBT_REPORT_TT200"
                => "dbo.usp_GenerateDebtReport_TT200",

            "DEBT_BY_CUSTOMER_TT200"
                => "dbo.usp_GenerateDebtByCustomer_TT200",

            _ => null
        };
    }

    private IEnumerable<FinancialReportSnapshot> VisibleSnapshots
    {
        get
        {
            var query = _snapshots.AsEnumerable();

            if (!string.Equals(_reportFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(NormalizeReportCode(x.ReportCode), _reportFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.Equals(_bookFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(BookCodeOrDefault(x.BookCode), _bookFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_yearFilter.HasValue)
            {
                query = query.Where(x => x.FiscalYear == _yearFilter.Value);
            }

            if (_monthFilter.HasValue)
            {
                query = query.Where(x => x.PeriodMonth == _monthFilter.Value);
            }

            if (!string.Equals(_statusFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x =>
                    string.Equals(x.Status ?? string.Empty, _statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_onlyDifference)
            {
                query = query.Where(x => x.Difference != 0);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var keyword = _search.Trim();

                query = query.Where(x =>
                    (x.ReportCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    GetReportDisplayName(x.ReportCode).Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    (x.BookCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Status?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (x.Note?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    x.FiscalYear.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.PeriodMonth.ToString("00").Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.PeriodMonth.ToString().Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                    x.Difference.ToString("N0").Contains(keyword, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.CreatedAt)
                .ThenBy(x => GetReportDisplayName(x.ReportCode))
                .ThenBy(x => BookCodeOrDefault(x.BookCode));
        }
    }

    private void ClearSnapshotFilters()
    {
        _search = string.Empty;
        _bookFilter = "ALL";
        _reportFilter = "ALL";
        _statusFilter = "ALL";
        _yearFilter = null;
        _monthFilter = null;
        _onlyDifference = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        _currentUser = string.IsNullOrWhiteSpace(_usr) ? "system" : _usr;
        _snapshot.CreatedBy = _currentUser;

        await LoadReportTypesAsync();
        await LoadAsync();
        ResetToIdleState();
    }

    private async Task LoadReportTypesAsync()
    {
        var allTypes = await Db.FinancialReportTypes
            .AsNoTracking()
            .Where(x => x.IsActive == true && !string.IsNullOrWhiteSpace(x.ReportCode))
            .OrderBy(x => x.SortOrder)
            .ToListAsync();

        _financialReportTypes = allTypes
            .Where(x => IsTt200Report(x.ReportCode))
            .ToList();
    }

    private FinancialReportSnapshot CreateBlankSnapshot() => new()
    {
        Id = Guid.NewGuid(),
        ReportCode = _financialReportTypes.FirstOrDefault()?.ReportCode ?? string.Empty,
        BookCode = NormalizeBookCode(_generateBookCode),
        FiscalYear = DateTime.Now.Year,
        PeriodMonth = DateTime.Now.Month,
        Status = "DRAFT",
        CreatedAt = DateTime.Now,
        CreatedBy = _currentUser
    };

    private void ResetToIdleState()
    {
        _headerSession = HeaderSessionMode.None;
        _snapshot = CreateBlankSnapshot();
        _snapshot.CreatedBy = _currentUser;
        _generateBookCode = NormalizeBookCode(_snapshot.BookCode);
        _lines.Clear();
        _line = new FinancialReportSnapshotLine();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessView"], MudBlazor.Severity.Warning);
            _snapshots.Clear();
            _lines.Clear();
            return;
        }

        try
        {
            _busy = true;
            var allSnapshots = await Db.FinancialReportSnapshots
                .AsNoTracking()
                .Where(x => !string.IsNullOrWhiteSpace(x.ReportCode))
                .OrderByDescending(x => x.CreatedAt)
                .ThenBy(x => x.BookCode)
                .ToListAsync();

            _snapshots = allSnapshots
                .Where(x => IsTt200Report(x.ReportCode))
                .ToList();

            if (_headerSession == HeaderSessionMode.EditingExisting
                && _snapshots.Any(x => x.Id == _snapshot.Id))
            {
                await LoadLines(_snapshot.Id);
            }
            else
            {
                _lines.Clear();
            }
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadLines(Guid snapshotId)
    {
        _lines = await Db.FinancialReportSnapshotLines
            .AsNoTracking()
            .Where(x => x.SnapshotId == snapshotId)
            .OrderBy(x => x.SortOrder)
            .ToListAsync();
    }

    private async Task GenerateLinesFromAccountBalanceAsync()
    {
        if (!CanWorkWithLines)
        {
            CallSnack(Localizer["FinancialReportSnapshot.SaveHeaderFirstMsg"], MudBlazor.Severity.Warning);
            return;
        }

        var reportCode = NormalizeReportCode(_snapshot.ReportCode);
        var bookCode = NormalizeBookCode(_generateBookCode);
        _snapshot.ReportCode = reportCode;
        _snapshot.BookCode = bookCode;
        var procedureName = GetGenerateProcedureName(reportCode);

        if (string.IsNullOrWhiteSpace(procedureName))
        {
            CallSnack($"ReportCode {reportCode} chưa có thủ tục generate.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            Localizer["FinancialReportSnapshot.GenerateLinesConfirmTitle"],
            $"Generate report {reportCode} - {bookCode} cho kỳ {_snapshot.FiscalYear}/{_snapshot.PeriodMonth:00}?",
            yesText: Localizer["FinancialReportSnapshot.GenerateFromAccountBalance"],
            cancelText: Localizer["cancel"]);

        if (confirm != true)
            return;

        var createdBy = string.IsNullOrWhiteSpace(_snapshot.CreatedBy)
            ? _currentUser
            : _snapshot.CreatedBy.Trim();

        try
        {
            _busy = true;

            var pFiscalYear = new SqlParameter("@FiscalYear", _snapshot.FiscalYear);
            var pPeriodMonth = new SqlParameter("@PeriodMonth", _snapshot.PeriodMonth);
            var pReportCode = new SqlParameter("@ReportCode", reportCode);
            var pCreatedBy = new SqlParameter("@CreatedBy", createdBy);
            var pBookCode = new SqlParameter("@BookCode", bookCode);

            // Hiện page chưa có CompanyId selector nên truyền NULL.
            // Nếu sau này có CompanyId, thay DBNull.Value bằng Guid CompanyId tương ứng.
            var pCompanyId = new SqlParameter("@CompanyId", System.Data.SqlDbType.UniqueIdentifier)
            {
                Value = DBNull.Value
            };

            await Db.Database.ExecuteSqlRawAsync(
                                                    $@"EXEC {procedureName}
                    @FiscalYear = @FiscalYear,
                    @PeriodMonth = @PeriodMonth,
                    @ReportCode = @ReportCode,
                    @CreatedBy = @CreatedBy,
                    @CompanyId = @CompanyId,
                    @BookCode = @BookCode",
                pFiscalYear,
                pPeriodMonth,
                pReportCode,
                pCreatedBy,
                pCompanyId,
                pBookCode);

            var updated = await Db.FinancialReportSnapshots.AsNoTracking()
                .Where(x => x.ReportCode == reportCode
                    && x.FiscalYear == _snapshot.FiscalYear
                    && x.PeriodMonth == _snapshot.PeriodMonth
                    && (x.BookCode ?? "TAX") == bookCode)
                .OrderByDescending(x => x.CreatedAt)
                .FirstOrDefaultAsync();

            if (updated is null)
            {
                CallSnack(Localizer["FinancialReportSnapshot.GenerateLinesNoResult"], MudBlazor.Severity.Warning);
                return;
            }

            _headerSession = HeaderSessionMode.EditingExisting;

            await LoadAsync();
            await BindSnapshotAsync(updated.Id);

            CallSnack($"Generate {reportCode} - {bookCode} thành công.", MudBlazor.Severity.Success);
        }
        catch (SqlException ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task NewSnapshot()
    {
