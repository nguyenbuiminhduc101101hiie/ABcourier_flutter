    private async Task SaveSnapshot()
    {
        if (!CanSaveHeader)
        {
            CallSnack(Localizer["FinancialReportSnapshot.SelectOrNewFirst"], MudBlazor.Severity.Warning);
            return;
        }

        await SaveSnapshotInternal(true);
    }

    private async Task SaveSnapshotInternal(bool showMessage)
    {
        if (_headerSession == HeaderSessionMode.None)
        {
            CallSnack(Localizer["FinancialReportSnapshot.SelectOrNewFirst"], MudBlazor.Severity.Warning);
            return;
        }

        if (_snapshot.Id == Guid.Empty)
            _snapshot.Id = Guid.NewGuid();

        _snapshot.ReportCode = NormalizeReportCode(_snapshot.ReportCode);
        _snapshot.BookCode = NormalizeBookCode(_snapshot.BookCode);
        _generateBookCode = NormalizeBookCode(_snapshot.BookCode);

        var snapshotId = _snapshot.Id;
        var existsInDb = await Db.FinancialReportSnapshots.AsNoTracking()
            .AnyAsync(x => x.Id == snapshotId);

        try
        {
            _busy = true;

            if (existsInDb)
            {
                if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
                {
                    CallSnack(Localizer["FinancialReportSnapshot.NoAccessEdit"], MudBlazor.Severity.Warning);
                    return;
                }

                var entity = await Db.FinancialReportSnapshots
                    .FirstOrDefaultAsync(x => x.Id == snapshotId);

                if (entity is null)
                {
                    CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                    return;
                }

                ApplySnapshotToEntity(entity, preserveCreated: true);
            }
            else
            {
                if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
                {
                    CallSnack(Localizer["FinancialReportSnapshot.NoAccessAdd"], MudBlazor.Severity.Warning);
                    return;
                }

                _snapshot.CreatedAt = DateTime.Now;
                if (string.IsNullOrWhiteSpace(_snapshot.CreatedBy))
                    _snapshot.CreatedBy = _currentUser;

                Db.FinancialReportSnapshots.Add(_snapshot);
            }

            await Db.SaveChangesAsync();
            _headerSession = HeaderSessionMode.EditingExisting;
            await LoadAsync();
            await BindSnapshotAsync(snapshotId);

            if (showMessage)
                CallSnack(Localizer["Common.SavedSuccessfully"], MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSnapshotAsync()
    {
        if (!CanDeleteHeader)
        {
            CallSnack(Localizer["FinancialReportSnapshot.SelectOrNewFirst"], MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            Localizer["warning"],
            Localizer["FinancialReportSnapshot.DeleteHeaderConfirm"],
            yesText: Localizer["delete"],
            cancelText: Localizer["cancel"]);

        if (confirm != true)
            return;

        var snapshotId = _snapshot.Id;

        try
        {
            _busy = true;

            await Db.FinancialReportSnapshotLines
                .Where(x => x.SnapshotId == snapshotId)
                .ExecuteDeleteAsync();

            var entity = await Db.FinancialReportSnapshots
                .FirstOrDefaultAsync(x => x.Id == snapshotId);

            if (entity is null)
            {
                CallSnack(Localizer["Common.RowNotFound"], MudBlazor.Severity.Warning);
                await LoadAsync();
                ResetToIdleState();
                return;
            }

            Db.FinancialReportSnapshots.Remove(entity);
            await Db.SaveChangesAsync();

            CallSnack(Localizer["Common.DeletedSuccessfully"], MudBlazor.Severity.Success);
            await LoadAsync();
            ResetToIdleState();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplySnapshotToEntity(FinancialReportSnapshot entity, bool preserveCreated)
    {
        entity.ReportCode = NormalizeReportCode(_snapshot.ReportCode);
        entity.BookCode = NormalizeBookCode(_snapshot.BookCode);
        entity.FiscalYear = _snapshot.FiscalYear;
        entity.PeriodMonth = _snapshot.PeriodMonth;
        entity.FromDate = _snapshot.FromDate;
        entity.ToDate = _snapshot.ToDate;
        entity.TotalAssets = _snapshot.TotalAssets;
        entity.TotalLiabilities = _snapshot.TotalLiabilities;
        entity.TotalEquity = _snapshot.TotalEquity;
        entity.TotalSource = _snapshot.TotalSource;
        entity.Difference = _snapshot.Difference;
        entity.Status = _snapshot.Status;
        entity.Note = _snapshot.Note;

        if (!preserveCreated)
        {
            entity.CreatedAt = _snapshot.CreatedAt;
            entity.CreatedBy = _snapshot.CreatedBy;
        }
    }

    private async Task BindSnapshotAsync(Guid snapshotId)
    {
        var fresh = await Db.FinancialReportSnapshots.AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == snapshotId);

        if (fresh is null)
            return;

        _snapshot = fresh;
        _snapshot.BookCode = NormalizeBookCode(_snapshot.BookCode);
        _generateBookCode = NormalizeBookCode(_snapshot.BookCode);
        await LoadLines(snapshotId);
        NewLine();
    }

    private async Task SaveSnapshotTotalsAsync()
    {
        if (!CanWorkWithLines)
            return;

        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        RecalculateHeaderFromLines();

        var snapshotId = _snapshot.Id;
        var entity = await Db.FinancialReportSnapshots
            .FirstOrDefaultAsync(x => x.Id == snapshotId);

        if (entity is null)
            return;

        entity.BookCode = NormalizeBookCode(_snapshot.BookCode);
        entity.TotalAssets = _snapshot.TotalAssets;
        entity.TotalLiabilities = _snapshot.TotalLiabilities;
        entity.TotalEquity = _snapshot.TotalEquity;
        entity.TotalSource = _snapshot.TotalSource;
        entity.Difference = _snapshot.Difference;

        await Db.SaveChangesAsync();
        await LoadAsync();
        await BindSnapshotAsync(snapshotId);
    }

