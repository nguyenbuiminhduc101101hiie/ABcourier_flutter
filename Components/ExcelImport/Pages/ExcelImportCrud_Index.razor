@page "/ExcelImportCrud"
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using ABFreight.Models
@using ABFreight.Resources
@using ABFreight.Services
@inject ExcelImportCrudService Service
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Ym_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudText Typo="Typo.h5" Class="mb-3">5.8.9 @Localizer["Ym_Title"]</MudText>

    <MudTabs @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="@Localizer["Ym_Tab_HDS"]">
            @RenderToolbar()
            <MudDataGrid T="M_StockGateOut_HDS_08042026" Items="@_hdsItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnHdsRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SoCont" Title="@Localizer["Ym_Col_SoCont"]" />
                    <PropertyColumn Property="x => x.TenTau" Title="@Localizer["Ym_Col_TenTau"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_NgayCapBen"]"><CellTemplate>@context.Item.NgayCapBen?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.SoBooking" Title="@Localizer["Ym_Col_SoBooking"]" />
                    <PropertyColumn Property="x => x.SoBL" Title="@Localizer["Ym_Col_SoBL"]" />
                    <PropertyColumn Property="x => x.PhuongAn" Title="@Localizer["Ym_Col_PhuongAn"]" />
                    <PropertyColumn Property="x => x.TTHaiQuan" Title="@Localizer["Ym_Col_TTHaiQuan"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_StockGateOut_HDS_08042026" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AG"]">
            @RenderToolbar()
            <MudTabs @bind-ActivePanelIndex="_agSubTab">
                <MudTabPanel Text="Arrived">
                    <MudDataGrid T="M_8_3_Arrived" Items="@_agArrivedItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAgArrivedRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                            <PropertyColumn Property="x => x.SZ" Title="@Localizer["Ym_Col_SZ"]" />
                            <PropertyColumn Property="x => x.TP" Title="@Localizer["Ym_Col_TP"]" />
                            <PropertyColumn Property="x => x.ST" Title="@Localizer["Ym_Col_ST"]" />
                            <PropertyColumn Property="x => x.Location" Title="@Localizer["Ym_Col_Location"]" />
                            <PropertyColumn Property="x => x.Customer" Title="@Localizer["Ym_Col_Customer"]" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_Arrived" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
                <MudTabPanel Text="Exited">
                    <MudDataGrid T="M_8_3_Exited" Items="@_agExitedItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAgExitedRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                            <PropertyColumn Property="x => x.SZ" Title="@Localizer["Ym_Col_SZ"]" />
                            <PropertyColumn Property="x => x.TP" Title="@Localizer["Ym_Col_TP"]" />
                            <PropertyColumn Property="x => x.ST" Title="@Localizer["Ym_Col_ST"]" />
                            <PropertyColumn Property="x => x.Location" Title="@Localizer["Ym_Col_Location"]" />
                            <PropertyColumn Property="x => x.Customer" Title="@Localizer["Ym_Col_Customer"]" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_Exited" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
                <MudTabPanel Text="Unstuffed">
                    <MudDataGrid T="M_8_3_Unstuffed" Items="@_agUnstuffedItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAgUnstuffedRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                            <PropertyColumn Property="x => x.SealNo" Title="SealNo" />
                            <PropertyColumn Property="x => x.CO" Title="CO" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_Unstuffed" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
                <MudTabPanel Text="Stuffed">
                    <MudDataGrid T="M_8_3_Stuffed" Items="@_agStuffedItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAgStuffedRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                            <PropertyColumn Property="x => x.SealNo" Title="SealNo" />
                            <PropertyColumn Property="x => x.CO" Title="CO" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_Stuffed" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_VSS"]">
            @RenderToolbar()
            <MudTabs @bind-ActivePanelIndex="_vssSubTab">
                <MudTabPanel Text="VSS Imp">
                    <MudDataGrid T="M_8_3_VSS_IN_OUT_YARD_Imp" Items="@_vssImpItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnVssImpRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                            <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                            <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                            <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                            <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_VSS_IN_OUT_YARD_Imp" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
                <MudTabPanel Text="VSS Exp">
                    <MudDataGrid T="M_8_3_VSS_IN_OUT_YARD_Exp" Items="@_vssExpItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnVssExpRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                            <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                            <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                            <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                            <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_VSS_IN_OUT_YARD_Exp" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AMS"]">
            @RenderToolbar()
            <MudTabs @bind-ActivePanelIndex="_amsSubTab">
                <MudTabPanel Text="AMS Imp">
                    <MudDataGrid T="M_8_3_IN_OUT_YARD_1" Items="@_amsImpItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAmsImpRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                            <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                            <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                            <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                            <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                            <TemplateColumn Title="DateImport"><CellTemplate>@ToVnTimeText(context.Item.DateImport)</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.UserImport" Title="UserImport" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_8_3_IN_OUT_YARD_1" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
                <MudTabPanel Text="AMS Exp">
                    <MudDataGrid T="M_YardMovement_AMS_26040816_Current_In_Yard2" Items="@_amsExpItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAmsExpRowClick">
                        <Columns>
                            <PropertyColumn Property="x => x.ITEM_NO" Title="ITEM_NO" />
                            <PropertyColumn Property="x => x.ISO" Title="ISO" />
                            <PropertyColumn Property="x => x.FEL" Title="FEL" />
                            <TemplateColumn Title="ARR_TS"><CellTemplate>@context.Item.ARR_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                            <TemplateColumn Title="DEP_TS"><CellTemplate>@context.Item.DEP_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                            <PropertyColumn Property="x => x.ARR_CAR" Title="ARR_CAR" />
                            <TemplateColumn Title="DateImport"><CellTemplate>@ToVnTimeText(context.Item.DateImport)</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.UserImport" Title="UserImport" />
                        </Columns>
                        <PagerContent><MudDataGridPager T="M_YardMovement_AMS_26040816_Current_In_Yard2" /></PagerContent>
                    </MudDataGrid>
                </MudTabPanel>
            </MudTabs>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int _activeTab;
    private bool _loading;
    private const string PermissionMenuName = "YardMovement";
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private bool _canView;
    private bool _canAdd;
    private bool _canEdit;
    private bool _canDelete;

    private List<M_StockGateOut_HDS_08042026> _hdsItems = new();
    private List<M_8_3_Arrived> _agArrivedItems = new();
    private List<M_8_3_Exited> _agExitedItems = new();
    private List<M_8_3_Unstuffed> _agUnstuffedItems = new();
    private List<M_8_3_Stuffed> _agStuffedItems = new();
    private List<M_8_3_VSS_IN_OUT_YARD_Imp> _vssImpItems = new();
    private List<M_8_3_VSS_IN_OUT_YARD_Exp> _vssExpItems = new();
    private List<M_8_3_IN_OUT_YARD_1> _amsImpItems = new();
    private List<M_YardMovement_AMS_26040816_Current_In_Yard2> _amsExpItems = new();
    private int _agSubTab;
    private int _vssSubTab;
    private int _amsSubTab;

    private M_StockGateOut_HDS_08042026? _selectedHds;
    private M_8_3_Arrived? _selectedAgArrived;
    private M_8_3_Exited? _selectedAgExited;
    private M_8_3_Unstuffed? _selectedAgUnstuffed;
    private M_8_3_Stuffed? _selectedAgStuffed;
    private M_8_3_VSS_IN_OUT_YARD_Imp? _selectedVssImp;
    private M_8_3_VSS_IN_OUT_YARD_Exp? _selectedVssExp;
    private M_8_3_IN_OUT_YARD_1? _selectedAmsImp;
    private M_YardMovement_AMS_26040816_Current_In_Yard2? _selectedAmsExp;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionAsync();
        if (!_canView)
        {
            Snackbar.Add(Localizer["Ym_NoAccessView"], MudBlazor.Severity.Warning);
            return;
        }

        await RefreshCurrentTabAsync();
    }

    private RenderFragment RenderToolbar() => @<MudPaper Class="pa-2 mb-2 d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshCurrentTabAsync" Disabled="_loading">@Localizer["reload"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="AddCurrentAsync" Disabled="_loading || !_canAdd">@Localizer["new"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditCurrentAsync" Disabled="_loading || !_canEdit">@Localizer["edit"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteCurrentAsync" Disabled="_loading || !_canDelete">@Localizer["delete"]</MudButton>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_loading || !_canAdd">
            @Localizer["Ym_ImportExcel"]
            <InputFile OnChange="ImportCurrentAsync" accept=".xlsx,.xls" style="display:none" />
        </MudButton>
    </MudPaper>;

    private async Task RefreshCurrentTabAsync()
    {
        _loading = true;
        try
        {
            switch ((ExcelCrudTab)_activeTab)
            {
                case ExcelCrudTab.HDS:
                    _hdsItems = await Service.GetHdsAsync();
                    break;
                case ExcelCrudTab.AG:
                    _agArrivedItems = await Service.GetAgArrivedAsync();
                    _agExitedItems = await Service.GetAgExitedAsync();
                    _agUnstuffedItems = await Service.GetAgUnstuffedAsync();
                    _agStuffedItems = await Service.GetAgStuffedAsync();
                    break;
                case ExcelCrudTab.VSS:
                    _vssImpItems = await Service.GetVssImpAsync();
                    _vssExpItems = await Service.GetVssExpAsync();
                    break;
                case ExcelCrudTab.AMS:
                    _amsImpItems = await Service.GetAmsImpAsync();
                    _amsExpItems = await Service.GetAmsExpAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_LoadError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ImportCurrentAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["Ym_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        _loading = true;
        try
        {
            var authState = await asv.GetAuth();
            var importUser = authState.User?.Identity?.Name;
            await using var stream = e.File.OpenReadStream(50 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var result = await Service.ImportAsync((ExcelCrudTab)_activeTab, ms, importUser);
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                Snackbar.Add(Localizer["Ym_ImportError", result.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add(Localizer["Ym_ImportSuccess", result.Inserted], MudBlazor.Severity.Success);
            await RefreshCurrentTabAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_ImportError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddCurrentAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["Ym_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS:
                await OpenDialogAndSaveAsync(new M_StockGateOut_HDS_08042026 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.AG:
                if (_agSubTab == 0)
                    await OpenDialogAndSaveAsync(new M_8_3_Arrived { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else if (_agSubTab == 1)
                    await OpenDialogAndSaveAsync(new M_8_3_Exited { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else if (_agSubTab == 2)
                    await OpenDialogAndSaveAsync(new M_8_3_Unstuffed { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                else
                    await OpenDialogAndSaveAsync(new M_8_3_Stuffed { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.VSS:
                if (_vssSubTab == 0)
                    await OpenDialogAndSaveAsync(new M_8_3_VSS_IN_OUT_YARD_Imp { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                else
                    await OpenDialogAndSaveAsync(new M_8_3_VSS_IN_OUT_YARD_Exp { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.AMS:
                if (_amsSubTab == 0)
                    await OpenDialogAndSaveAsync(new M_8_3_IN_OUT_YARD_1 { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                else
                    await OpenDialogAndSaveAsync(new M_YardMovement_AMS_26040816_Current_In_Yard2 { Id = Guid.NewGuid(), DateImport = DateTime.UtcNow, CreatedAt = DateTime.UtcNow });
                break;
        }
    }

    private async Task EditCurrentAsync()
    {
        if (!_canEdit)
        {
            Snackbar.Add(Localizer["Ym_NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS when _selectedHds != null:
                await OpenDialogAndSaveAsync(Clone(_selectedHds));
                break;
            case ExcelCrudTab.AG when _agSubTab == 0 && _selectedAgArrived != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAgArrived));
                break;
            case ExcelCrudTab.AG when _agSubTab == 1 && _selectedAgExited != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAgExited));
                break;
            case ExcelCrudTab.AG when _agSubTab == 2 && _selectedAgUnstuffed != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAgUnstuffed));
                break;
            case ExcelCrudTab.AG when _agSubTab == 3 && _selectedAgStuffed != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAgStuffed));
                break;
            case ExcelCrudTab.VSS when _vssSubTab == 0 && _selectedVssImp != null:
                await OpenDialogAndSaveAsync(Clone(_selectedVssImp));
                break;
            case ExcelCrudTab.VSS when _vssSubTab == 1 && _selectedVssExp != null:
                await OpenDialogAndSaveAsync(Clone(_selectedVssExp));
                break;
            case ExcelCrudTab.AMS when _amsSubTab == 0 && _selectedAmsImp != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAmsImp));
                break;
            case ExcelCrudTab.AMS when _amsSubTab == 1 && _selectedAmsExp != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAmsExp));
                break;
            default:
                Snackbar.Add(Localizer["Ym_SelectOneRowToEdit"], MudBlazor.Severity.Warning);
                break;
        }
    }

    private async Task DeleteCurrentAsync()
    {
        if (!_canDelete)
        {
            Snackbar.Add(Localizer["Ym_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["Ym_Warning"], Localizer["Ym_DeleteConfirm"], yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;

        (bool Ok, string? Error) result = (false, Localizer["Ym_NoRowSelected"].Value);

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS when _selectedHds != null:
                result = await Service.DeleteAsync<M_StockGateOut_HDS_08042026>(_selectedHds.Id);
                break;
            case ExcelCrudTab.AG when _agSubTab == 0 && _selectedAgArrived != null:
                result = await Service.DeleteAsync<M_8_3_Arrived>(_selectedAgArrived.Id);
                break;
            case ExcelCrudTab.AG when _agSubTab == 1 && _selectedAgExited != null:
                result = await Service.DeleteAsync<M_8_3_Exited>(_selectedAgExited.Id);
                break;
            case ExcelCrudTab.AG when _agSubTab == 2 && _selectedAgUnstuffed != null:
                result = await Service.DeleteAsync<M_8_3_Unstuffed>(_selectedAgUnstuffed.Id);
                break;
            case ExcelCrudTab.AG when _agSubTab == 3 && _selectedAgStuffed != null:
                result = await Service.DeleteAsync<M_8_3_Stuffed>(_selectedAgStuffed.Id);
                break;
            case ExcelCrudTab.VSS when _vssSubTab == 0 && _selectedVssImp != null:
                result = await Service.DeleteAsync<M_8_3_VSS_IN_OUT_YARD_Imp>(_selectedVssImp.Id);
                break;
            case ExcelCrudTab.VSS when _vssSubTab == 1 && _selectedVssExp != null:
                result = await Service.DeleteAsync<M_8_3_VSS_IN_OUT_YARD_Exp>(_selectedVssExp.Id);
                break;
            case ExcelCrudTab.AMS when _amsSubTab == 0 && _selectedAmsImp != null:
                result = await Service.DeleteAsync<M_8_3_IN_OUT_YARD_1>(_selectedAmsImp.Id);
                break;
            case ExcelCrudTab.AMS when _amsSubTab == 1 && _selectedAmsExp != null:
                result = await Service.DeleteAsync<M_YardMovement_AMS_26040816_Current_In_Yard2>(_selectedAmsExp.Id);
                break;
        }

        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? Localizer["Ym_DeleteFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["Ym_Deleted"], MudBlazor.Severity.Success);
        await RefreshCurrentTabAsync();
    }

    private async Task OpenDialogAndSaveAsync<T>(T model) where T : class, IExcelImportEntity
    {
        var dialog = DialogService.Show<ExcelImport_RowDialog>(Localizer["Ym_EditDialogTitle"], new DialogParameters { ["Model"] = model }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not T data)
            return;

        var saveResult = await Service.UpsertAsync(data);
        if (!saveResult.Ok)
        {
            Snackbar.Add(saveResult.Error ?? Localizer["Ym_SaveFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["Ym_Saved"], MudBlazor.Severity.Success);
        await RefreshCurrentTabAsync();
    }

    private T Clone<T>(T source)
    {
        var json = JsonSerializer.Serialize(source, _jsonOptions);
        return JsonSerializer.Deserialize<T>(json, _jsonOptions)!;
    }

    private static string ToVnTimeText(DateTime? dt)
    {
        if (!dt.HasValue)
            return string.Empty;

        var utc = DateTime.SpecifyKind(dt.Value, DateTimeKind.Utc);
        var vnTimeZone = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
        var vnTime = TimeZoneInfo.ConvertTimeFromUtc(utc, vnTimeZone);
        return vnTime.ToString("dd/MM/yyyy HH:mm");
    }

    private void OnHdsRowClick(DataGridRowClickEventArgs<M_StockGateOut_HDS_08042026> args) => _selectedHds = args.Item;
    private void OnAgArrivedRowClick(DataGridRowClickEventArgs<M_8_3_Arrived> args) => _selectedAgArrived = args.Item;
    private void OnAgExitedRowClick(DataGridRowClickEventArgs<M_8_3_Exited> args) => _selectedAgExited = args.Item;
    private void OnAgUnstuffedRowClick(DataGridRowClickEventArgs<M_8_3_Unstuffed> args) => _selectedAgUnstuffed = args.Item;
    private void OnAgStuffedRowClick(DataGridRowClickEventArgs<M_8_3_Stuffed> args) => _selectedAgStuffed = args.Item;
    private void OnVssImpRowClick(DataGridRowClickEventArgs<M_8_3_VSS_IN_OUT_YARD_Imp> args) => _selectedVssImp = args.Item;
    private void OnVssExpRowClick(DataGridRowClickEventArgs<M_8_3_VSS_IN_OUT_YARD_Exp> args) => _selectedVssExp = args.Item;
    private void OnAmsImpRowClick(DataGridRowClickEventArgs<M_8_3_IN_OUT_YARD_1> args) => _selectedAmsImp = args.Item;
