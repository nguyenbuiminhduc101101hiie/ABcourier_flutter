    private List<(byte[] Content, string FileName)> Attachments = new();
    private List<string> FileNames = new();
    private string FilesDisplay { get; set; } = string.Empty;
    private string EmailContent { get; set; } = string.Empty;
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        Attachments.Clear();
        FileNames.Clear();
        FilesDisplay = "";
        var files = e.GetMultipleFiles();
        const long maxFileSize = 10 * 1024 * 1024; // 10MB

        foreach (var file in files)
        {
            if (file.Size > maxFileSize)
            {
                Console.WriteLine($"File {file.Name} quá lớn, bỏ qua.");
                continue;
            }

            var ms = new MemoryStream();
            using var stream = file.OpenReadStream(maxFileSize);
            await stream.CopyToAsync(ms);

            Attachments.Add((ms.ToArray(), file.Name));
            FileNames.Add(file.Name);
        }

        FilesDisplay = string.Join(", ", FileNames);
    }



    private bool _processingSendNotification;

    private async Task SendNotificationAsync_send()
    {
        if (string.IsNullOrWhiteSpace(_BookingDetail.OperationCode_))
        {
            CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
            return;
        }

        var noidung = EmailContent?.Trim();
        if (string.IsNullOrWhiteSpace(noidung))
        {
            noidung = string.IsNullOrWhiteSpace(_BookingDetail.BookingNo)
                ? "Booking"
                : $"Booking: {_BookingDetail.BookingNo}";
        }

        try
        {
            _processingSendNotification = true;
            await Task.Delay(1);
            StateHasChanged();

            string[] users = _BookingDetail.OperationCode_.Split(',');
            var listid = new List<string>();

            foreach (var user in users)
            {
                var userName = user?.Trim();
                if (string.IsNullOrEmpty(userName))
                    continue;

                Guid? inputid = await gsv.GetIdfromUser(userName);
                if (inputid != null && inputid != Guid.Empty)
                {
                    listid.Add(inputid.ToString()!);
                }
            }

            if (listid.Count == 0)
            {
                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

            await _notificationService.SendNotificationAsync(listid.ToArray(), noidung);
            CallSnackBar(Localizer["SendSuccess"], MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingSendNotification = false;
        }
    }

    private async Task SendEmailAsync_send()
    {
        if (string.IsNullOrWhiteSpace(_BookingDetail.OperationCode_))
        {
            CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
            return;
        }

        string[] users = _BookingDetail.OperationCode_.Split(',');
        List<string> emails = new List<string>();

        foreach (var user in users)
        {
            var userName = user?.Trim();
            if (string.IsNullOrEmpty(userName))
                continue;

            string inputemail = await bksv.GetEmailAsync(userName);
            if (!string.IsNullOrEmpty(inputemail))
            {
                emails.Add(inputemail);
            }
        }

        string[] emailarray = emails.ToArray();
        if (emailarray.Length > 0)
        {
            bool result = await emsv.SendEmailAsync_1(EmailContent, emailarray, Attachments);
            if (result)
            {
                CallSnackBar(Localizer["EmailSentSuccess"], MudBlazor.Severity.Success);
            }
            else
            {
                CallSnackBar(Localizer["EmailSentFailed"], MudBlazor.Severity.Error);
            }
        }
        else
        {
            CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
        }
    }
