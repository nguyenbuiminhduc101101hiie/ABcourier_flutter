    private const string PotSeparator = " | ";

    private sealed class PotEntry
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string? Value { get; set; }
    }

    private List<PotEntry> potEntries = new List<PotEntry> { new PotEntry() };

    private void LoadPotEntries()
    {
        var entries = new List<PotEntry>();

        if (!string.IsNullOrWhiteSpace(_BookingDetail?.hano_POT))
            entries.Add(new PotEntry { Value = _BookingDetail.hano_POT });

        if (!string.IsNullOrWhiteSpace(_BookingDetail?.hano_POT_Ext))
        {
            var extras = _BookingDetail.hano_POT_Ext
                .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(x => new PotEntry { Value = x });
            entries.AddRange(extras);
        }

        if (entries.Count == 0)
            entries.Add(new PotEntry());

        potEntries = entries;
    }

    private void SyncPotToBookingDetail()
    {
        if (_BookingDetail == null)
            return;

        var values = potEntries
            .Select(x => x.Value?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        // Report BookingRequestNVOCC.mrt đọc thẳng cột hano_POT nên cột này chỉ giữ POT đầu tiên.
        _BookingDetail.hano_POT = values.FirstOrDefault();
        _BookingDetail.hano_POT_Ext = values.Count > 1
            ? string.Join(PotSeparator, values.Skip(1))
            : null;
    }

    private void AddPot()
    {
        potEntries.Add(new PotEntry());
    }

    private void RemovePot(PotEntry entry)
    {
        potEntries.Remove(entry);

        if (potEntries.Count == 0)
            potEntries.Add(new PotEntry());

        SyncPotToBookingDetail();
    }


