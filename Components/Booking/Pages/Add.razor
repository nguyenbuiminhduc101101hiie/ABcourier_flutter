@using MudBlazor

@inject ISnackbar Snackbar
@inject AccountService asv
@inject BookingService bksv
@inject QuotationService QuoSV
@inject CustomerService CusSV
@inject EmailService emsv
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject SupportServices supsv
@inject GlobalServices gsv
@inject NotificationService _notificationService
<MudDialog Class="booking-dialog">
    <DialogContent>
        <div class="booking-dialog-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="booking-container px-2 px-sm-4">
            <MudCard Class="booking-card ma-2" Elevation="0">
                <MudForm Model="@_BookingDetail" @ref="@form">
                    <MudCardContent Class="booking-card-inner pa-sm-6 pa-4">
                        <MudTabs Rounded="true"
                                 Elevation="0"
                                 ApplyEffectsToContainer="true"
                                 PanelClass="booking-tab-panel pt-4">
                            <MudTabPanel Text="Information">
                                <MudTabs Rounded="true"
                                         Elevation="0"
                                         ApplyEffectsToContainer="true"
                                         PanelClass="booking-tab-panel pt-2">
                                    <MudTabPanel Text="Base Info (1)">
                                        <MudGrid Spacing="3">
                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Booking information</div>
                                                    <MudGrid Spacing="2" AlignItems="AlignItems.End">
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="cbofrom"
                                                                          Label="@Localizer["from"]"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true"
                                                                          Clearable="true" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="cboto"
                                                                          Label="@Localizer["to"]"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true"
                                                                          Clearable="true" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="1" Class="d-flex justify-content-center justify-content-md-start">
                                                            <MudTooltip Text="@Localizer["BookingNo"]">
                                                                <MudButton Variant="Variant.Filled"
                                                                           Color="Color.Primary"
                                                                           Disabled="@(Status == "edit")"
                                                                           Class="booking-gen-btn"
                                                                           OnClick="@GetInvoice_No">
                                                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                                                </MudButton>
                                                            </MudTooltip>
                                                        </MudItem>
                                                        <MudItem xs="12" md="5">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="_BookingDetail.BookingNo"
                                                                          For="@(() => _BookingDetail.BookingNo)"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true"
                                                                          ReadOnly="true"
                                                                          Label="@Localizer["BookingNo"]" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">General information</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.iol"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Label="@Localizer["bophan"]">
                                                                <MudSelectItem Value="@("Sea")">Sea</MudSelectItem>
                                                                <MudSelectItem Value="@("Air")">Air</MudSelectItem>
                                                                <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                                                                <MudSelectItem Value="@("Trucking")">Trucking</MudSelectItem>
                                                                <MudSelectItem Value="@("Sea,Trucking")">Sea,Trucking</MudSelectItem>
                                                                <MudSelectItem Value="@("Air,Trucking")">Air,Trucking</MudSelectItem>
                                                                <MudSelectItem Value="@("Sea,Customs")">Sea,Customs</MudSelectItem>
                                                                <MudSelectItem Value="@("Air,Customs")">Air,Customs</MudSelectItem>
                                                                <MudSelectItem Value="@("Customs,Trucking")">Customs,Trucking</MudSelectItem>
                                                                <MudSelectItem Value="@("Sea,Trucking,Customs")">Sea,Trucking,Customs</MudSelectItem>
                                                                <MudSelectItem Value="@("Air,Trucking,Customs")">Air,Trucking,Customs</MudSelectItem>
                                                                <MudSelectItem Value="@("Logistics")">Logistics</MudSelectItem>
                                                                <MudSelectItem Value="@("Inbound")">Inbound</MudSelectItem>
                                                                <MudSelectItem Value="@("Outbound")">Outbound</MudSelectItem>
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.FCL_LCL_Air"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Label="@Localizer["Type"]">
                                                                <MudSelectItem Value="@("FCL")">FCL</MudSelectItem>
                                                                <MudSelectItem Value="@("LCL")">LCL</MudSelectItem>
                                                                <MudSelectItem Value="@("Consol")">Consol</MudSelectItem>
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="2">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.Lo"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Label="IM / EX">
                                                                <MudSelectItem Value="@("IM")">IM</MudSelectItem>
                                                                <MudSelectItem Value="@("EX")">EX</MudSelectItem>
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="2">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          T="string?"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="_BookingDetail.Code"
                                                                          For="@(() => _BookingDetail.Code)"
                                                                          Immediate="true"
                                                                          Clearable="true"
                                                                          Label="Code" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="2">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="Guid"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             Label="@Localizer["QuotationNo"]"
                                                                             @bind-Value="_BookingDetail.quotationID"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Required="true"
                                                                             SearchFunc="SearchQuotations"
                                                                             ToStringFunc="GetQuotationLabel" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Customer information</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" md="4">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="Guid?"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             Label="@Localizer["toshipper"]"
                                                                             @bind-Value="_BookingDetail.CONSIGNEEID"
                                                                             Required="true"
                                                                             Clearable="true"
                                                                             ResetValueOnEmptyText="true"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             SearchFunc="Search_customer"
                                                                             ToStringFunc="GetCustomerLabel"
                                                                             OnBlur="OnCustomerSelected" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="Guid?"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             Label="@Localizer["consignee"]"
                                                                             @bind-Value="_BookingDetail.Customer_ID"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             SearchFunc="Search_customer"
                                                                             Clearable="true"
                                                                             ResetValueOnEmptyText="true"
                                                                             ToStringFunc="GetCustomerLabel" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="Guid?"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             Label="@Localizer["Customer"]"
                                                                             @bind-Value="_BookingDetail.MaincusBk_Id_"
                                                                             OnBlur="OnMainCusSelected"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             SearchFunc="Search_customer"
                                                                             Clearable="true"
                                                                             ResetValueOnEmptyText="true"
                                                                             ToStringFunc="GetCustomerLabel" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section booking-section-accent">
                                                    <div class="booking-section-title">Contact &amp; routing</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="_BookingDetail.ATTN"
                                                                          For="@(() => _BookingDetail.ATTN)"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true"
                                                                          Label="@Localizer["ATTN"]" />
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             Label="@Localizer["Agency_Name"]"
                                                                             @bind-Value="_BookingDetail.agencyname_box"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             SearchFunc="Search_Agency" ToStringFunc="CusStrLabel" />
                                                        </MudItem>
                                                        <MudItem xs="12">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.hano_from"
                                                                             Label="@Localizer["from"]"
                                                                             SearchFunc="Search_hano_from"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Ports</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" md="6">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.hano_POR"
                                                                             Label="@Localizer["POR"]"
                                                                                 SearchFunc="Search_Port_codeha"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.hano_POL"
                                                                             Label="@Localizer["POL"]"
                                                                             SearchFunc="Search_Port"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
                                                            <MudStack Spacing="1">
                                                                @for (var i = 0; i < potEntries.Count; i++)
                                                                {
                                                                    var entry = potEntries[i];
                                                                    var isLast = i == potEntries.Count - 1;
                                                                    var potLabel = i == 0 ? $"{Localizer["POT"]}" : $"{Localizer["POT"]} {i + 1}";

                                                                    <div class="d-flex align-center ga-2" @key="entry.Id">
                                                                        <MudAutocomplete Class="booking-field labelCustomColor flex-grow-1"
                                                                                         T="string"
                                                                                         Variant="Variant.Outlined"
                                                                                         Margin="Margin.Dense"
                                                                                         @bind-Value="entry.Value"
                                                                                         @bind-Value:after="SyncPotToBookingDetail"
                                                                                         Label="@potLabel"
                                                                                         SearchFunc="Search_Port"
                                                                                         AdornmentColor="@ColorTextFields"
                                                                                         Immediate="true"
                                                                                         CoerceText="true"
                                                                                         Clearable="true"
                                                                                         MaxItems="100" />
                                                                        @if (potEntries.Count > 1)
                                                                        {
                                                                            <MudTooltip Text="@Localizer["Delete"]">
                                                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                                               Color="Color.Error"
                                                                                               Size="Size.Small"
                                                                                               OnClick="@(() => RemovePot(entry))" />
                                                                            </MudTooltip>
                                                                        }
                                                                        @if (isLast)
                                                                        {
                                                                            <MudTooltip Text="@Localizer["Add"]">
                                                                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                                                               Color="Color.Primary"
                                                                                               Size="Size.Small"
                                                                                               OnClick="AddPot" />
                                                                            </MudTooltip>
                                                                        }
                                                                    </div>
                                                                }
                                                            </MudStack>
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.hano_POD"
                                                                             Label="@Localizer["POD"]"
                                                                             SearchFunc="Search_Port"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.tendest"
                                                                             Label="@Localizer["Dest"]"
                                                                             SearchFunc="Search_Port"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.trangthai"
                                                                       Label="@Localizer["status"]">
                                                                @foreach (var item in trangthais)
                                                                {
                                                                    <MudSelectItem Value="item">@item</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Other</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" md="4">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="_BookingDetail.vat"
                                                                          For="@(() => _BookingDetail.vat)"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true"
                                                                          Label="M.Box:" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string?"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.Freight_Payable"
                                                                       For="@(() => _BookingDetail.Freight_Payable)"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Clearable="true"
                                                                       Label="Freight Payable">
                                                                <MudSelectItem Value="@("Prepaid")">Prepaid</MudSelectItem>
                                                                <MudSelectItem Value="@("Collect")">Collect</MudSelectItem>
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" md="4">
                                                            <MudDatePicker Class="booking-field labelCustomColor"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           @bind-Date="_BookingDetail.hano_date"
                                                                           For="@(() => _BookingDetail.hano_date)"
                                                                           AdornmentColor="@ColorTextFields"
                                                                           Label="@Localizer["NGAY"]"
                                                                           Required="true"
                                                                           ShowToolbar="false" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>

                                    @* //-----------------Info 2--------------------------- *@
                                    <MudTabPanel Text="Base Info (2)">
                                        <MudGrid Spacing="3">
                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Vessel &amp; voyage</div>
                                                    <MudGrid Spacing="2" AlignItems="AlignItems.End">
                                                        <MudItem xs="12" sm="6" md="4">
                                                            <MudComboBox T="string"
                                                                         Class="booking-field labelCustomColor"
                                                                         Dense="Dense.Standard"
                                                                         Margin="Margin.Dense"
                                                                         @bind-Text="@save_text_vessel"
                                                                         Label="@Localizer["Vessel/Fly"]"
                                                                         Editable="true"
                                                                         Clearable="true">
                                                                @foreach (var state in ListVessel)
                                                                {
                                                                    <MudComboBoxItem Value="@state">@state</MudComboBoxItem>
                                                                }
                                                            </MudComboBox>
                                                        </MudItem>
                                                        <MudItem xs="12" md="1" Class="d-flex justify-content-center justify-content-md-start">
                                                            <MudTooltip Text="@Localizer["Vessel/Fly"]">
                                                                <MudButton Variant="Variant.Filled"
                                                                           Color="Color.Primary"
                                                                           Class="booking-gen-btn"
                                                                           OnClick="@LinkVessel">
                                                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                                                </MudButton>
                                                            </MudTooltip>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          T="string"
                                                                          Label="@Localizer["Vessel/Fly"]"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          @bind-Value="_BookingDetail.Vessel" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudTextField Class="booking-field labelCustomColor"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          @bind-Value="_BookingDetail.VoyNo"
                                                                          Label="@Localizer["voyage_no"]"
                                                                          AdornmentColor="@ColorTextFields"
                                                                          Immediate="true" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section booking-section-accent">
                                                    <div class="booking-section-title">Schedule (ETD / ETA / ATA)</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudDatePicker Class="booking-field labelCustomColor"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           @bind-Date="_BookingDetail.ETD"
                                                                           For="@(() => _BookingDetail.ETD)"
                                                                           AdornmentColor="@ColorTextFields"
                                                                           Label="ETD:"
                                                                           Required="true"
                                                                           ShowToolbar="false" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.etdtime"
                                                                       Immediate="true"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Label="ETD Time:">
                                                                @foreach (var item in timeSiList)
                                                                {
                                                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudDatePicker Class="booking-field labelCustomColor"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           @bind-Date="_BookingDetail.ETA"
                                                                           For="@(() => _BookingDetail.ETA)"
                                                                           AdornmentColor="@ColorTextFields"
                                                                           Label="ETA:"
                                                                           Clearable="true"
                                                                           ShowToolbar="false" />
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudSelect Class="booking-field labelCustomColor"
                                                                       T="string"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       @bind-Value="_BookingDetail.etatime"
                                                                       AdornmentColor="@ColorTextFields"
                                                                       Immediate="true"
                                                                       Clearable="true"
                                                                       Label="ETA Time:">
                                                                @foreach (var item in timeSiList)
                                                                {
                                                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                        <MudItem xs="12" sm="6" md="3">
                                                            <MudDatePicker Class="booking-field labelCustomColor"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           Date="selectedDate_ATA"
                                                                           DateChanged="@(e => OnDateChanged_ATA(e))"
                                                                           AdornmentColor="@ColorTextFields"
                                                                           Label="ATA:"
                                                                           ShowToolbar="false" />
                                                        </MudItem>
                                                    </MudGrid>
                                                </div>
                                            </MudItem>

                                            <MudItem xs="12">
                                                <div class="booking-section">
                                                    <div class="booking-section-title">Carrier &amp; coload</div>
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="12" md="6">
                                                            <MudAutocomplete Class="booking-field labelCustomColor"
                                                                             T="string"
                                                                             Variant="Variant.Outlined"
                                                                             Margin="Margin.Dense"
                                                                             @bind-Value="_BookingDetail.Carrier"
                                                                             Label="@Localizer["Carrier"]"
                                                                             SearchFunc="Search_Carrier" ToStringFunc="CusStrLabel"
                                                                             AdornmentColor="@ColorTextFields"
                                                                             Immediate="true"
                                                                             CoerceText="true"
                                                                             Clearable="true"
                                                                             MaxItems="100" />
                                                        </MudItem>
                                                        <MudItem xs="12" md="6">
