    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Booking-Request") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Booking-Request")))
        {

            SyncPotToBookingDetail();

            await form.Validate();

            if (form.IsValid)
            {
                if (Status == "duplicate")
                {
                    _BookingDetail.ContainerOutBoundNotifyId = Guid.Empty;
                    _BookingDetail.BookingNo = BookingNumber;
                }
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _BookingDetail.UpdateTime = DateTime.Now;
                _BookingDetail.UserID = UserName;
