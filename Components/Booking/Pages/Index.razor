        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        min-height: calc(100vh - 64px);
    }

    .booking-toolbar,
    .booking-grid-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .booking-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .booking-subtitle {
        color: #64748b;
        margin-top: 2px;
    }

    .booking-toolbar-content {
        gap: 16px;
        flex-wrap: wrap;
    }

    .booking-actions {
        gap: 8px;
        flex-wrap: wrap;
    }

    .booking-search {
        width: 260px;
        min-width: 220px;
    }

    .action-btn {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
        min-height: 34px;
        box-shadow: none !important;
    }

    .booking-grid-card {
        overflow: hidden;
    }

    .booking-grid {
        font-size: 12.5px;
    }

        .booking-grid .mud-table-container,
        .booking-grid .mud-data-grid {
            border-radius: 18px;
        }

        .booking-grid th,
        .booking-grid .mud-table-head .mud-table-cell {
            background: #0f172a !important;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .01em;
            height: 42px;
            padding: 6px 10px !important;
            border-bottom: 0 !important;
            white-space: nowrap;
        }

        .booking-grid td,
        .booking-grid .mud-table-body .mud-table-cell {
            height: 38px;
            padding: 5px 10px !important;
            border-bottom: 1px solid #edf2f7 !important;
            vertical-align: middle;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .booking-grid .mud-table-row:hover td {
            background: #eef6ff !important;
        }

        .booking-grid .selected td,
        .booking-grid tr.selected td {
            background: #dbeafe !important;
            box-shadow: inset 4px 0 0 #2563eb;
            font-weight: 700;
        }

        .booking-grid .mud-table-foot .mud-table-cell {
            background: #f8fafc !important;
            color: #475569;
            font-size: 11.5px;
            font-weight: 700;
            padding: 6px 10px !important;
            border-top: 1px solid #e5e7eb !important;
            white-space: nowrap;
        }

        .booking-grid .mud-input-root,
        .booking-grid .mud-input-slot,
        .booking-grid input {
            font-size: 12px !important;
        }

        .booking-grid .mud-checkbox {
            margin: 0 auto;
            display: flex;
            justify-content: center;
        }

        .custom-colorfillter,
        .booking-grid .mud-table-head .mud-table-row:nth-child(2) .mud-table-cell {
            background: #f1f5f9 !important;
            color: #0f172a !important;
            padding: 4px 8px !important;
        }

    .no-wrap {
        white-space: nowrap;
    }



    .booking-grid .booking-row-selected td,
    .booking-grid tr.booking-row-selected td,
    .booking-grid .selected td,
    .booking-grid tr.selected td {
        background: #bfdbfe !important;
        color: #0f172a !important;
        box-shadow: inset 4px 0 0 #0284c7;
        font-weight: 800;
    }

    .booking-grid .mud-table-row.booking-row-selected:hover td,
    .booking-grid tr.booking-row-selected:hover td {
        background: #93c5fd !important;
    }

    .booking-grid .mud-table-cell {
        max-width: 170px;
    }

        .booking-grid .mud-table-cell:nth-child(2),
        .booking-grid .mud-table-cell:nth-child(3),
        .booking-grid .mud-table-cell:nth-child(4) {
            max-width: 210px;
        }

    .booking-detail-panel {
        margin: 8px 12px 12px 52px;
        border-radius: 16px;
        border: 1px solid #bae6fd;
        background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    }

    .booking-detail-title-wrap {
        gap: 8px;
        color: #0369a1;
    }

    .booking-detail-title {
        font-weight: 800;
        color: #075985;
    }

    .detail-item {
