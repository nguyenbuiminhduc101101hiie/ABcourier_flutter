@page "/Booking_Request"
@using System.Net
@using System.Diagnostics

@inject ShipmentService shipsv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NotificationService _notificationService
@inject GlobalServices gsv

@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Reflection;
@using System.Text;
@using System.Text.Json;

@attribute [Authorize]

<PageTitle>@Localizer["Request_to_get_booking"]</PageTitle>


<div class="product-price-page">
<MudContainer MaxWidth="MaxWidth.False" Class="booking-page px-3 py-3">
    <PpScreenHeader Title="@Localizer["Request_to_get_booking"]" Subtitle="@Localizer["BookingRequest_Subtitle"]">
        <Toolbar>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="booking-actions flex-wrap">
                <MudTextField @bind-Value="search_BookingNo"
                              Placeholder="Search booking no..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="booking-search" />

                <MudButton OnClick="HandleRefresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenCreateDialog(new Models.Booking()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenEditDialog(Booking_Detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton OnClick="Delete"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @Localizer["delete"]
                </MudButton>

                <MudButton @onclick="@(() => OpenDialogDuplicate(Booking_Detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>

                <MudButton @onclick="@(() => ExportBill())"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer["Export_Bill"]
                </MudButton>

                <MudTooltip Text="Tạo Job từ booking đang chọn">
                    <MudButton OnClick="CreateJobFromBooking"
                               Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                               Class="action-btn"
                               StartIcon="@Icons.Material.Filled.PostAdd">
                        Tạo Job
                    </MudButton>
                </MudTooltip>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="booking-grid-card product-price-card" Elevation="0">
        <MudDataGrid T="Models.Booking" Items="@listImport.ToList()"
                     Class="booking-grid"
                     Filterable="true" QuickFilter="@FilterFunc1"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     RowClick="@RowClicked" Bordered="false" Hover="true" Striped="true"
                     FixedHeader="true" FixedFooter="true" Height="calc(100vh - 235px)"
                     HeaderClass="no-wrap booking-grid-header" FooterClass="no-wrap booking-grid-footer"
                     EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" CommittedItemChanges="@((t)=>CommittedItemChanges(t))"
                     RowClassFunc="@SelectedRowClassFunc"
                     ColumnResizeMode="ResizeMode.Column" @ref="mudTable"
                     Hideable="true">

            <Columns>

                <HierarchyColumn T="Models.Booking" Title="" />

                <PropertyColumn Property="x => x.ContainerOutBoundNotifyId" Title="@(Localizer["ID"])" Hidden="true">
                    <FooterTemplate>ID</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BookingNo" Title="@(Localizer["BookingNo"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["BookingNo"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => CustomerName(x.MaincusBk_Id_)" Title="@(Localizer["Customer"])" CellStyleFunc="_cellStyleFunc">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.MaincusBk_Id_" Label="@(Localizer["Customer"])">
                            @foreach (var item in CustomerList)
                            {
                                <MudSelectItem Value="@item.Customer_ID">@item.CodeName()</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                    <FooterTemplate>@Localizer["Customer"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.trangthai" Title="@(Localizer["status"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["status"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.bkcarrier" Title="@(Localizer["bkcarrier"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["bkcarrier"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.FCL_LCL_Air" Title="@(Localizer["FCL/LCL/Air"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["FCL_LCL_Air"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.hano_POL" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POL"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.hano_POD" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POD"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ETA" Title="@(Localizer["ETA"])" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETA"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ETD" Title="@(Localizer["ETD"])" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETD"]</FooterTemplate>
                </PropertyColumn>

                <TemplateColumn Title="@Localizer["Approve"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))" />
                    </CellTemplate>
                    <FooterTemplate>@Localizer["Approve"]</FooterTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.UserID" Title="@(Localizer["UserUpdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["UserUpdate"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.UpdateTime" Title="@(Localizer["Dateupdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["Dateupdate"]</FooterTemplate>
                </PropertyColumn>

            </Columns>

            <ChildRowContent>
                <MudPaper Class="booking-detail-panel pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 booking-detail-title-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Class="booking-detail-title">Chi tiết booking: @context.Item.BookingNo</MudText>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["vat"]</span><b>@context.Item.vat</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Agency_Name"]</span><b>@context.Item.agencyname_box</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Master_Bill/Air"]</span><b>@context.Item.hanoAir_Freightrateterm</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["House_Bill"]</span><b>@context.Item.hanoAIr_MAWBHAWBNo</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["VIA_(Coload)"]</span><b>@context.Item.hanoLCL_BookingPIC</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["PackageQuantity"]</span><b>@context.Item.thoigian4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["KGS"]</span><b>@context.Item.hano_WeightCBMPKG</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["CBM"]</span><b>@context.Item.congviecthuchien4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Vessel/Fly"]</span><b>@context.Item.Vessel</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Pickup"]</span><b>@context.Item.EmpContReDate</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Dest"]</span><b>@context.Item.codedest</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["bophan"]</span><b>@context.Item.iol</b></div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="Models.Booking" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
            </PagerContent>

        </MudDataGrid>

    </MudPaper>
</MudContainer>
</div>



<style>
