</style>

@code {
    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private string search_BookingNo;

    Guid? BookingId;
    string usr;
    Models.Booking Booking_Detail;
    private List<Models.Booking> listImport = new List<Models.Booking>();
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<Models.TrangThai> Trangthais = new List<Models.TrangThai>();
    async Task RowClicked(DataGridRowClickEventArgs<Models.Booking> args)
    {
        Booking_Detail = args.Item;
        BookingId = args.Item.ContainerOutBoundNotifyId;
        StateHasChanged();
    }

    string CustomerName(Guid? customerID)
    {
        var rs = CustomerList?.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs.CodeName();
    }

    /// <summary>Mở từ màn khác (vd 2.4.2): lọc sẵn và chọn đúng số Booking.</summary>
    [Parameter] public string? InitialBookingNo { get; set; }
    private Task? _initTask;
    private bool _initialHandled;

    protected override Task OnInitializedAsync() => _initTask = InitializePageAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialHandled || string.IsNullOrWhiteSpace(InitialBookingNo))
            return;
        _initialHandled = true;
        if (_initTask != null)
            await _initTask;
        search_BookingNo = InitialBookingNo.Trim();
        await HandleRefresh();
        var hit = listImport.FirstOrDefault(x => string.Equals(x.BookingNo?.Trim(), search_BookingNo, StringComparison.OrdinalIgnoreCase));
        if (hit != null)
        {
            Booking_Detail = hit;
            BookingId = hit.ContainerOutBoundNotifyId;
        }
        else
        {
            CallSnackBar(Localizer["DataNotFound"], MudBlazor.Severity.Warning);
        }
        StateHasChanged();
    }

    private async Task InitializePageAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Trangthais = await supsv.GetListTrangThai();
        // await HandleRefresh();
        CustomerList = await Cussv.GetListAll();
    }

    async Task CommittedItemChanges(Models.Booking item)
    {
        var rs = await bksv.UpdateAnBookingRequest(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

    }
    private string GetCustomerName(Guid id)
    {
        return "";
    }
    private int selectedRowNumber = -1;
    private MudDataGrid<Models.Booking> mudTable;
    private string SelectedRowClassFunc(Models.Booking item, int rowNumber)
    {
        if (BookingId.HasValue && item.ContainerOutBoundNotifyId == BookingId)
        {
            return "booking-row-selected selected";
        }

        return string.Empty;
    }

    async Task HandleRefresh()
    {
        try
        {

            Booking_Detail = null;
            BookingId = null;

            listImport.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Booking-Request"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await bksv.GetListSBooking();
            StateHasChanged();
        }
        finally
        {


        }
    }
    // string =""
    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            Booking_Detail = null;
            BookingId = null;

            listImport.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Booking-Request"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await bksv.GetListBooking_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }
    private async Task OpenCreateDialog(Models.Booking tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Booking-Request"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x._BookingDetail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.ContainerOutBoundNotifyId == Guid.Empty ? Localizer["BookingRequest_Create"] : Localizer["BookingRequest_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (Booking)result.Data;
                var rs = await bksv.UpdateOrCreateBBookingRequest(data);

                await HistoryLogService.LogAsync(usr, "ADD Booking-Request", "Booking-Request", data.ContainerOutBoundNotifyId, data.BookingNo, data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                // Guid id_create = Guid.Parse(data.TerminalDeparture_ID);

                await HandleRefresh_create(data.ContainerOutBoundNotifyId);
                // selectedRowNumber = 0;
                // StateHasChanged();
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenEditDialog(Models.Booking tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Booking-Request"))
        {
            var OldData = JsonSerializer.Deserialize<Booking>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x._BookingDetail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.ContainerOutBoundNotifyId == Guid.Empty ? Localizer["BookingRequest_Edit"] : Localizer["BookingRequest_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (Booking)result.Data;
                var rs = await bksv.UpdateOrCreateBBookingRequest(data);
                await HistoryLogService.LogAsync(usr, "Update Booking-Request", "Booking-Request", data.ContainerOutBoundNotifyId, data.BookingNo, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                {
                    severity = MudBlazor.Severity.Success;
                    await SendBookingUpdateNotificationAsync(OldData, data);
                }
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Delete()
    {
        try
        {
            if (Booking_Detail.Approve == true)
            {
                CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
                return;
            }
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Delete", "Booking-Request"))
            {
                CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
                return;
            }
            if (BookingId == null)
            {
                CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
                return;
            }
            var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

            if (resultMess.HasValue)
            {

                var bkdetail = await bksv.GetDetailBookingFromID(BookingId);
                var result = await bksv.DeleteBooking(Booking_Detail);
                await HistoryLogService.LogAsync(usr, "Delete Booking-Request", "Booking-Request", Booking_Detail.ContainerOutBoundNotifyId, Booking_Detail.BookingNo, new { OldData = Booking_Detail });
                if (result.Flag)
                    CallSnackBar(result.Message, MudBlazor.Severity.Success);
                else
                {
                    CallSnackBar(result.Message, MudBlazor.Severity.Error);
                    return;
                }

                await HandleRefresh();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["DeleteError"], ex.Message), MudBlazor.Severity.Error);

        }

    }

