@page "/Booking_Request"
@using System.Net
@using System.Diagnostics

@inject ShipmentService shipsv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

@attribute [Authorize]

<PageTitle>@Localizer["Request_to_get_booking"]</PageTitle>


<div class="product-price-page">
<MudContainer MaxWidth="MaxWidth.False" Class="booking-page px-3 py-3">
    <PpScreenHeader Title="@Localizer["Request_to_get_booking"]" Subtitle="Manage booking requests, status and shipment information">
        <Toolbar>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="booking-actions flex-wrap">
                <MudTextField @bind-Value="search_BookingNo"
                              Placeholder="Search booking no..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="booking-search" />

                <MudButton OnClick="HandleRefresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenCreateDialog(new Models.Booking()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenEditDialog(Booking_Detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton OnClick="Delete"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @Localizer["delete"]
                </MudButton>

                <MudButton @onclick="@(() => OpenDialogDuplicate(Booking_Detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>

                <MudButton @onclick="@(() => ExportBill())"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer["Export_Bill"]
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="booking-grid-card product-price-card" Elevation="0">
        <MudDataGrid T="Models.Booking" Items="@listImport.ToList()"
                     Class="booking-grid"
                     Filterable="true" QuickFilter="@FilterFunc1"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     RowClick="@RowClicked" Bordered="false" Hover="true" Striped="true"
                     FixedHeader="true" FixedFooter="true" Height="calc(100vh - 235px)"
                     HeaderClass="no-wrap booking-grid-header" FooterClass="no-wrap booking-grid-footer"
                     EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" CommittedItemChanges="@((t)=>CommittedItemChanges(t))"
                     RowClassFunc="@SelectedRowClassFunc"
                     ColumnResizeMode="ResizeMode.Column" @ref="mudTable"
                     Hideable="true">

            <Columns>

                <HierarchyColumn T="Models.Booking" Title="" />

                <PropertyColumn Property="x => x.ContainerOutBoundNotifyId" Title="@(Localizer["ID"])" Hidden="true">
                    <FooterTemplate>ID</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BookingNo" Title="@(Localizer["BookingNo"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["BookingNo"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => CustomerName(x.MaincusBk_Id_)" Title="@(Localizer["Customer"])" CellStyleFunc="_cellStyleFunc">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.MaincusBk_Id_" Label="@(Localizer["Customer"])">
                            @foreach (var item in CustomerList)
                            {
                                <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                    <FooterTemplate>@Localizer["Customer"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.trangthai" Title="@(Localizer["status"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["status"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.bkcarrier" Title="@(Localizer["bkcarrier"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["bkcarrier"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.FCL_LCL_Air" Title="@(Localizer["FCL/LCL/Air"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["FCL_LCL_Air"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.hano_POL" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POL"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.hano_POD" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POD"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ETA" Title="@(Localizer["ETA"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETA"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ETD" Title="@(Localizer["ETD"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETD"]</FooterTemplate>
                </PropertyColumn>

                <TemplateColumn Title="@Localizer["Approve"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))" />
                    </CellTemplate>
                    <FooterTemplate>@Localizer["Approve"]</FooterTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.UserID" Title="@(Localizer["UserUpdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["UserUpdate"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.UpdateTime" Title="@(Localizer["Dateupdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["Dateupdate"]</FooterTemplate>
                </PropertyColumn>

            </Columns>

            <ChildRowContent>
                <MudPaper Class="booking-detail-panel pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 booking-detail-title-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Class="booking-detail-title">Chi tiết booking: @context.Item.BookingNo</MudText>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["vat"]</span><b>@context.Item.vat</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Agency_Name"]</span><b>@context.Item.agencyname_box</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Master_Bill/Air"]</span><b>@context.Item.hanoAir_Freightrateterm</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["House_Bill"]</span><b>@context.Item.hanoAIr_MAWBHAWBNo</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["VIA_(Coload)"]</span><b>@context.Item.hanoLCL_BookingPIC</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["PackageQuantity"]</span><b>@context.Item.thoigian4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["KGS"]</span><b>@context.Item.hano_WeightCBMPKG</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["CBM"]</span><b>@context.Item.congviecthuchien4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Vessel/Fly"]</span><b>@context.Item.Vessel</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Pickup"]</span><b>@context.Item.EmpContReDate</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Dest"]</span><b>@context.Item.codedest</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["bophan"]</span><b>@context.Item.iol</b></div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="Models.Booking" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
            </PagerContent>

        </MudDataGrid>

    </MudPaper>
</MudContainer>
</div>



<style>
    .booking-page {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        min-height: calc(100vh - 64px);
    }

    .booking-toolbar,
    .booking-grid-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .booking-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .booking-subtitle {
        color: #64748b;
        margin-top: 2px;
    }

    .booking-toolbar-content {
        gap: 16px;
        flex-wrap: wrap;
    }

    .booking-actions {
        gap: 8px;
        flex-wrap: wrap;
    }

    .booking-search {
        width: 260px;
        min-width: 220px;
    }

    .action-btn {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
        min-height: 34px;
        box-shadow: none !important;
    }

    .booking-grid-card {
        overflow: hidden;
    }

    .booking-grid {
        font-size: 12.5px;
    }

        .booking-grid .mud-table-container,
        .booking-grid .mud-data-grid {
            border-radius: 18px;
        }

        .booking-grid th,
        .booking-grid .mud-table-head .mud-table-cell {
            background: #0f172a !important;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .01em;
            height: 42px;
            padding: 6px 10px !important;
            border-bottom: 0 !important;
            white-space: nowrap;
        }

        .booking-grid td,
        .booking-grid .mud-table-body .mud-table-cell {
            height: 38px;
            padding: 5px 10px !important;
            border-bottom: 1px solid #edf2f7 !important;
            vertical-align: middle;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .booking-grid .mud-table-row:hover td {
            background: #eef6ff !important;
        }

        .booking-grid .selected td,
        .booking-grid tr.selected td {
            background: #dbeafe !important;
            box-shadow: inset 4px 0 0 #2563eb;
            font-weight: 700;
        }

        .booking-grid .mud-table-foot .mud-table-cell {
            background: #f8fafc !important;
            color: #475569;
            font-size: 11.5px;
            font-weight: 700;
            padding: 6px 10px !important;
            border-top: 1px solid #e5e7eb !important;
            white-space: nowrap;
        }

        .booking-grid .mud-input-root,
        .booking-grid .mud-input-slot,
        .booking-grid input {
            font-size: 12px !important;
        }

        .booking-grid .mud-checkbox {
            margin: 0 auto;
            display: flex;
            justify-content: center;
        }

        .custom-colorfillter,
        .booking-grid .mud-table-head .mud-table-row:nth-child(2) .mud-table-cell {
            background: #f1f5f9 !important;
            color: #0f172a !important;
            padding: 4px 8px !important;
        }

    .no-wrap {
        white-space: nowrap;
    }



    .booking-grid .booking-row-selected td,
    .booking-grid tr.booking-row-selected td,
    .booking-grid .selected td,
    .booking-grid tr.selected td {
        background: #bfdbfe !important;
        color: #0f172a !important;
        box-shadow: inset 4px 0 0 #0284c7;
        font-weight: 800;
    }

    .booking-grid .mud-table-row.booking-row-selected:hover td,
    .booking-grid tr.booking-row-selected:hover td {
        background: #93c5fd !important;
    }

    .booking-grid .mud-table-cell {
        max-width: 170px;
    }

        .booking-grid .mud-table-cell:nth-child(2),
        .booking-grid .mud-table-cell:nth-child(3),
        .booking-grid .mud-table-cell:nth-child(4) {
            max-width: 210px;
        }

    .booking-detail-panel {
        margin: 8px 12px 12px 52px;
        border-radius: 16px;
        border: 1px solid #bae6fd;
        background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
    }

    .booking-detail-title-wrap {
        gap: 8px;
        color: #0369a1;
    }

    .booking-detail-title {
        font-weight: 800;
        color: #075985;
    }

    .detail-item {
        min-height: 58px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        padding: 9px 12px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
    }

        .detail-item span {
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .02em;
        }

        .detail-item b {
            color: #0f172a;
            font-size: 13px;
            font-weight: 800;
            white-space: normal;
            word-break: break-word;
        }

    @@media (max-width: 960px) {
        .booking-toolbar-content {
            align-items: stretch !important;
        }

        .booking-search {
            width: 100%;
        }

        .booking-actions {
            width: 100%;
            justify-content: flex-start !important;
        }
    }
</style>

@code {
    private string search_BookingNo;

    Guid? BookingId;
    string usr;
    Models.Booking Booking_Detail;
    private List<Models.Booking> listImport = new List<Models.Booking>();
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<Models.TrangThai> Trangthais = new List<Models.TrangThai>();
    async Task RowClicked(DataGridRowClickEventArgs<Models.Booking> args)
    {
        Booking_Detail = args.Item;
        BookingId = args.Item.ContainerOutBoundNotifyId;
        StateHasChanged();
    }

    string CustomerName(Guid? customerID)
    {
        var rs = CustomerList.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    protected override async Task OnInitializedAsync()

    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Trangthais = await supsv.GetListTrangThai();
        // await HandleRefresh();
        CustomerList = await Cussv.GetList();
    }

    async Task CommittedItemChanges(Models.Booking item)
    {
        var rs = await bksv.UpdateAnBookingRequest(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

    }
    private string GetCustomerName(Guid id)
    {
        return "";
    }
    private int selectedRowNumber = -1;
    private MudDataGrid<Models.Booking> mudTable;
    private string SelectedRowClassFunc(Models.Booking item, int rowNumber)
    {
        if (BookingId.HasValue && item.ContainerOutBoundNotifyId == BookingId)
        {
            return "booking-row-selected selected";
        }

        return string.Empty;
    }

    async Task HandleRefresh()
    {
        try
        {

            Booking_Detail = null;
            BookingId = null;

            listImport.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Booking-Request"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            listImport = await bksv.GetListSBooking();
            StateHasChanged();
        }
        finally
        {


        }
    }
    // string =""
    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            Booking_Detail = null;
            BookingId = null;

            listImport.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Booking-Request"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            listImport = await bksv.GetListBooking_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }
    private async Task OpenCreateDialog(Models.Booking tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Booking-Request"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x._BookingDetail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.ContainerOutBoundNotifyId == Guid.Empty ? "Booking Request Create" : "Booking Request Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (Booking)result.Data;
                var rs = await bksv.UpdateOrCreateBBookingRequest(data);

                await HistoryLogService.LogAsync(usr, "ADD Booking-Request", "Booking-Request", data.ContainerOutBoundNotifyId, data.BookingNo, data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                // Guid id_create = Guid.Parse(data.TerminalDeparture_ID);

                await HandleRefresh_create(data.ContainerOutBoundNotifyId);
                // selectedRowNumber = 0;
                // StateHasChanged();
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenEditDialog(Models.Booking tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Booking-Request"))
        {
            var OldData = JsonSerializer.Deserialize<Booking>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x._BookingDetail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.ContainerOutBoundNotifyId == Guid.Empty ? "Booking Request Edit" : "Booking Request Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (Booking)result.Data;
                var rs = await bksv.UpdateOrCreateBBookingRequest(data);
                await HistoryLogService.LogAsync(usr, "Update Booking-Request", "Booking-Request", data.ContainerOutBoundNotifyId, data.BookingNo, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Delete()
    {
        try
        {
            if (Booking_Detail.Approve == true)
            {
                CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
                return;
            }
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Delete", "Booking-Request"))
            {
                CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
                return;
            }
            if (BookingId == null)
            {
                CallSnackBar("Please select Data!", MudBlazor.Severity.Warning);
                return;
            }
            var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

            if (resultMess.HasValue)
            {

                var bkdetail = await bksv.GetDetailBookingFromID(BookingId);
                var result = await bksv.DeleteBooking(Booking_Detail);
                await HistoryLogService.LogAsync(usr, "Delete Booking-Request", "Booking-Request", Booking_Detail.ContainerOutBoundNotifyId, Booking_Detail.BookingNo, new { OldData = Booking_Detail });
                if (result.Flag)
                    CallSnackBar(result.Message, MudBlazor.Severity.Success);
                else
                {
                    CallSnackBar(result.Message, MudBlazor.Severity.Error);
                    return;
                }

                await HandleRefresh();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot delete with eror code: " + ex.Message, MudBlazor.Severity.Error);

        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private bool FilterFunc1(Models.Booking bt) => FilterFunc(bt, search_BookingNo);

    private bool FilterFunc(Models.Booking bt, string search_InvNo)
    {
        if (string.IsNullOrWhiteSpace(search_InvNo))
            return true;
        if (bt.BookingNo!.Contains(search_InvNo, StringComparison.OrdinalIgnoreCase))
            return true;

        if ($"{bt.BookingNo} ".Contains(search_InvNo))
            return true;
        return false;
    }

    async Task ExportBill()
    {
        if (Booking_Detail == null)
        {
            CallSnackBar("you must select 1 Booking.", MudBlazor.Severity.Warning);
            return;
        }

        var formDialogOptions = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };
        var formDialogParams = new DialogParameters { ["FormKind"] = ABFreight.Models.BillLayoutFormKind.Booking };
        var formDialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogLayoutFormExportOption>(
            "Export Booking - Chọn mẫu form", formDialogParams, formDialogOptions);
        var formResult = await formDialogRef.Result;
        if (formResult.Canceled) return;
        var formOpts = (Shipment.Pages.DialogLayoutFormExportOption.LayoutFormExportOptions)formResult.Data!;

        var rs = await shipsv.ExportBooking(Booking_Detail.ContainerOutBoundNotifyId!, formOpts.LayoutFormId);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }



    private async Task OpenDialogDuplicate(Models.Booking tr)
    {
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Booking-Request"))
        {
            var OldData = JsonSerializer.Deserialize<Booking>(JsonSerializer.Serialize(tr));
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };
            if (Booking_Detail == null)
            {
                CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
                return;
            }

            var dialog1 = DialogService.Show<Duplicate>("Get BookingNo");
            var result1 = await dialog1.Result;
            if (!result1.Canceled && result1.Data is string BookingNumber)
            {
                DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
                var parameters = new DialogParameters<Add> { { x => x._BookingDetail, tr }, { x => x.Status, "duplicate" }, { x => x.BookingNumber, BookingNumber } };

                var dialog = await DialogService.ShowAsync<Add>(tr.ContainerOutBoundNotifyId == Guid.Empty ? "Booking Request Create" : "Booking Request Edit", parameters, optionsdialog);
                var result = await dialog.Result;
                if (!result.Canceled)
                {
                    var data = (Booking)result.Data;
                    var rs = await bksv.UpdateOrCreateBBookingRequest(data);
                    await HistoryLogService.LogAsync(usr, "Duplicate Booking-Request", "Booking-Request", data.ContainerOutBoundNotifyId, data.BookingNo, new { OldData = OldData, NewData = data });
                    MudBlazor.Severity severity;
                    if (rs[1] == "1")
                        severity = MudBlazor.Severity.Success;
                    else
                        severity = MudBlazor.Severity.Error;

                    CallSnackBar(rs[0], severity);
                    // Guid id_create = Guid.Parse(data.TerminalDeparture_ID);

                    await HandleRefresh_create(data.ContainerOutBoundNotifyId);
                    // selectedRowNumber = 0;
                    // StateHasChanged();
                }

                return;
            }
        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }
    private Func<Booking, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (string.IsNullOrEmpty(x.trangthai))
            return "color: #000000";

        var rs = Trangthais
            .Where(t => (t.Noidung).Contains(x.trangthai, StringComparison.InvariantCultureIgnoreCase)
                && t.Tieude.Equals("BOOKING", StringComparison.InvariantCultureIgnoreCase))
            .Select(t => t.Mamau)
            .FirstOrDefault();
        return "color: " + rs;


    };

