    private bool _processingVoucher = false;
    private const string AccountingVoucherUrl = "/AccountingVoucher";
    private Guid? _lastCreatedVoucherId;

    private async Task CreateVoucherFromSelectedReceiptAsync()
    {
        if (detail == null || detail.PhieuthuID == Guid.Empty)
        {
            CallSnackBar("Vui lòng chọn 1 phiếu thu trước khi tạo voucher.", MudBlazor.Severity.Warning);
            return;
        }

        if (detail.Approve != true)
        {
            CallSnackBar("Phiếu thu chưa Approve, không thể tạo voucher.", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(detail.TKNo) || string.IsNullOrWhiteSpace(detail.TKCo))
        {
            CallSnackBar("Phiếu thu thiếu TK Nợ hoặc TK Có.", MudBlazor.Severity.Warning);
            return;
        }

        if ((detail.Sotien ?? 0) == 0)
        {
            CallSnackBar("Số tiền phiếu thu bằng 0.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(usr, "Add", "Phieuthu"))
        {
            CallSnackBar("Bạn không có quyền tạo voucher kế toán.", MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Tạo voucher",
            $"Tạo Accounting Voucher từ phiếu thu {detail.SoPhieuthu}?",
            yesText: "Tạo Voucher",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        try
        {
            _processingVoucher = true;
            StateHasChanged();

            var companyId = await Db.CompanyInfomation
                .AsNoTracking()
                .Select(x => x.CompanyID)
                .FirstOrDefaultAsync();

            if (companyId == Guid.Empty)
            {
                CallSnackBar("Không tìm thấy CompanyId trong CompanyInfomation.", MudBlazor.Severity.Error);
                return;
            }

            var conn = Db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = "dbo.usp_CreateAccountingVoucher_FromPhieuThu";
                cmd.CommandType = System.Data.CommandType.StoredProcedure;
                cmd.CommandTimeout = 180;

                AddSqlParameter(cmd, "@PhieuthuID", detail.PhieuthuID);
                AddSqlParameter(cmd, "@CompanyId", companyId);
                AddSqlParameter(cmd, "@CreatedBy", string.IsNullOrWhiteSpace(usr) ? "system" : usr);
                AddSqlParameter(cmd, "@AutoPost", 1);
                AddSqlParameter(cmd, "@ClearOld", 1);

                await using var reader = await cmd.ExecuteReaderAsync();
                if (await reader.ReadAsync())
                {
                    var voucherIdOrdinal = GetOrdinalOrMinusOne(reader, "VoucherId");
                    if (voucherIdOrdinal >= 0 && !reader.IsDBNull(voucherIdOrdinal))
                        _lastCreatedVoucherId = reader.GetGuid(voucherIdOrdinal);
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            await HistoryLogService.LogAsync(usr, "Create Voucher From Phieu Thu", "Phieuthu", detail.PhieuthuID, detail.SoPhieuthu, detail);
            CallSnackBar("Tạo voucher từ phiếu thu thành công.", MudBlazor.Severity.Success);

            await Refresh();

            var openVoucher = await DialogService.ShowMessageBox(
                "Mở Accounting Voucher",
                "Voucher đã được tạo. Anh có muốn mở màn hình Accounting Voucher để xem ngay không?",
                yesText: "Mở Voucher",
                cancelText: "Ở lại");

            if (openVoucher == true)
            {
                var url = _lastCreatedVoucherId.HasValue
                    ? $"{AccountingVoucherUrl}?voucherId={_lastCreatedVoucherId.Value}"
                    : AccountingVoucherUrl;

                NavManager.NavigateTo(url);
            }
        }
        catch (SqlException ex)
        {
            CallSnackBar("SQL Error: " + ex.Message, MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Error: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingVoucher = false;
            StateHasChanged();
        }
    }


    private static int GetOrdinalOrMinusOne(System.Data.Common.DbDataReader reader, params string[] names)
    {
        foreach (var name in names)
        {
            for (var i = 0; i < reader.FieldCount; i++)
            {
                if (string.Equals(reader.GetName(i), name, StringComparison.OrdinalIgnoreCase))
                    return i;
            }
        }

        return -1;
    }

    private static void AddSqlParameter(System.Data.Common.DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

