@using ABFreight.Models
@using MudBlazor

<MudDialog>
    <DialogContent>
        @if (Document != null)
        {
            <MudPaper Class="pa-3 mb-3" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2" Class="mb-1">
                    <strong>ID:</strong> @Document.Id.ToString().Substring(0, 8)...
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-1">
                    <strong>Mô tả:</strong> @(string.IsNullOrEmpty(Document.Description) ? "Không có mô tả" : Document.Description)
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-1">
                    <strong>Kích thước:</strong> @FormatFileSize(GetFileSize(Document.FilePath))
                </MudText>
                <MudText Typo="Typo.body2">
                    <strong>Ngày upload:</strong> @Document.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                </MudText>
            </MudPaper>
            
            <MudText Typo="Typo.h6" Class="mb-2">Nội dung tài liệu:</MudText>
            <MudPaper Class="pa-4" Style="max-height: 400px; overflow-y: auto; background-color: #f5f5f5;">
                <div style="white-space: pre-wrap; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6;">
                    @Document.Content
                </div>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Primary">Đóng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public WordDocument? Document { get; set; }
    [Parameter] public Func<long, string> FormatFileSize { get; set; } = default!;
    [Parameter] public Func<string, long> GetFileSize { get; set; } = default!;

    void Cancel() => MudDialog.Cancel();
}
