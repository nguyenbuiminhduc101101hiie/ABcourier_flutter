    private bool _expandedPricing { get => IsPrimaryGroupExpanded("pricing"); set => SetPrimaryGroupExpanded("pricing", value); }
    private bool _expandedStatistical { get => IsPrimaryGroupExpanded("statistical"); set => SetPrimaryGroupExpanded("statistical", value); }
    private bool _expandedEQ { get => IsPrimaryGroupExpanded("equipment"); set => SetPrimaryGroupExpanded("equipment", value); }
    private bool _expandedCashFlow { get => IsPrimaryGroupExpanded("cash-flow"); set => SetPrimaryGroupExpanded("cash-flow", value); }
    private bool _canSeeSiMenu;
    private bool _expanded83Stock = false;
    private bool _expandedCourier { get => IsPrimaryGroupExpanded("courier"); set => SetPrimaryGroupExpanded("courier", value); }

    private HashSet<string> _viewPermissions = new(StringComparer.OrdinalIgnoreCase);
    private string? _permissionUsername;
    private bool _permissionsLoaded;
    private bool _permissionsLoading;
    private string navMenuBackgroundColor = ThemeDefaults.NavMenuBackgroundColor;
    private string navMenuTextColor = ThemeDefaults.NavMenuTextColor;

    private bool CanView(string? menuName) =>
        string.IsNullOrWhiteSpace(menuName) || _viewPermissions.Contains(menuName.Trim());

    private bool CanViewAny(params string?[] menuNames) =>
        menuNames.Where(m => !string.IsNullOrWhiteSpace(m)).Any(m => _viewPermissions.Contains(m!.Trim()));

    private string? NavHidden(string? menuName) =>
        CanView(menuName) ? null : "display:none;";

    private async Task<bool> LoadViewPermissionsAsync()
    {
        if (_permissionsLoaded || _permissionsLoading)
            return _permissionsLoaded;

        _permissionsLoading = true;
        try
        {
            var authState = await singsv.GetAuth();
            if (authState.User.Identity?.IsAuthenticated != true)
                return false;

            _permissionUsername = authState.User.Identity?.Name;
            _viewPermissions = await ssv.GetUserViewPermissionsForUser(authState.User);
            _permissionsLoaded = true;

            Console.WriteLine($"[NavMenu] permUser={_permissionUsername}; listCharge={CanView("ListCharge")}; viewMenus=[{string.Join(",", _viewPermissions)}]");
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] Unable to load permissions: {ex.Message}");
            return false;
        }
        finally
        {
            _permissionsLoading = false;
        }
    }

    public async Task ReloadPermissionsAsync()
    {
        _permissionsLoaded = false;
        await LoadViewPermissionsAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await singsv.GetAuth();
        var user = authState.User.Identity?.Name;

        try
        {
            var roleClaims = authState.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();
            Console.WriteLine($"[NavMenu] user={user}; roles=[{string.Join(",", roleClaims)}]");

            _canSeeSiMenu = roleClaims.Any(r =>
                !string.IsNullOrWhiteSpace(r) &&
                string.Equals(r.Trim(), "SI GET", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            // ignore debug failure
        }

        await LoadViewPermissionsAsync();
        await LoadThemePreference();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _permissionsLoaded || _permissionsLoading)
            return;

        // Authentication/permission services can still be warming up during the
        // first interactive render. Retry briefly instead of leaving a partial
        // menu or letting a transient failure terminate the Blazor circuit.
        for (var attempt = 0; attempt < 5 && !_permissionsLoaded; attempt++)
        {
            if (attempt > 0)
                await Task.Delay(250 * attempt);

            await LoadViewPermissionsAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    public async Task ReloadThemeAsync()
    {
        await LoadThemePreference();
    }

    private async Task LoadThemePreference()
    {
        try
        {
            var url = Navigation.ToAbsoluteUri("api/theme/get");
            var request = new HttpRequestMessage(HttpMethod.Get, url);

            // Add cookies from HttpContext to request
            if (HttpContextAccessor.HttpContext != null)
            {
                var cookies = HttpContextAccessor.HttpContext.Request.Cookies;
                var cookieHeader = string.Join("; ", cookies.Select(c => $"{c.Key}={c.Value}"));
                if (!string.IsNullOrEmpty(cookieHeader))
                {
                    request.Headers.Add("Cookie", cookieHeader);
                }
            }

            var httpResponse = await Http.SendAsync(request);

            if (!httpResponse.IsSuccessStatusCode)
            {
                var errorContent = await httpResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"NavMenu API Error: {httpResponse.StatusCode} - {errorContent.Substring(0, Math.Min(200, errorContent.Length))}");
                return;
            }

            var response = await httpResponse.Content.ReadFromJsonAsync<ThemeResponse>();
            if (response != null)
            {
                if (!string.IsNullOrEmpty(response.NavMenuBackgroundColor))
                    navMenuBackgroundColor = response.NavMenuBackgroundColor;
                if (!string.IsNullOrEmpty(response.NavMenuTextColor))
                    navMenuTextColor = response.NavMenuTextColor;
                Console.WriteLine($"Loaded NavMenu colors: bg={navMenuBackgroundColor}, text={navMenuTextColor}");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NavMenu theme: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
        }
    }

    private class ThemeResponse
    {
        public string? NavMenuBackgroundColor { get; set; }
        public string? NavMenuTextColor { get; set; }
        public string? MainLayoutBackgroundColor { get; set; }
    }
