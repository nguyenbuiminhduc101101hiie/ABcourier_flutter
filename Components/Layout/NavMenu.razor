    private string? _expandedPrimaryGroup;

    private bool IsPrimaryGroupExpanded(string group) =>
        string.Equals(_expandedPrimaryGroup, group, StringComparison.Ordinal);

    private void SetPrimaryGroupExpanded(string group, bool expanded)
    {
        if (expanded)
            _expandedPrimaryGroup = group;
        else if (IsPrimaryGroupExpanded(group))
            _expandedPrimaryGroup = null;
    }

    private bool _expandedSystem { get => IsPrimaryGroupExpanded("system"); set => SetPrimaryGroupExpanded("system", value); }
    private bool _expandedBusiness { get => IsPrimaryGroupExpanded("business"); set => SetPrimaryGroupExpanded("business", value); }
    private bool _expandedTask { get => IsPrimaryGroupExpanded("task"); set => SetPrimaryGroupExpanded("task", value); }
