                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_checkedInToday" OnClick="CheckIn" Style="margin-right:20px; min-width:140px">
                                @(_checkedInToday ? Localizer["Đã chấm"] : Localizer["Chấm công"])
