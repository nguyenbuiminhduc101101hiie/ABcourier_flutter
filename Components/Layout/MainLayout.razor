@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> Localizer
@inject AccountService asv
@inject FontService FontSizeService
@inject ThemeService ThemeService
@inject IJSRuntime JS
@inject CustomAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject NotificationService _notificationService
@inject AttendanceService AttendanceService
@inject SharedServices SharedService
@using Microsoft.AspNetCore.SignalR.Client
@inject SingletonSerivce singsv
@inject HttpClient Http
@inject IDialogService DialogService
@inject IHttpContextAccessor HttpContextAccessor

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<style>
    .mud-appbar {
    z-index: 1300 !important;
    }
    
</style>

<style>
    .appbar-custom {
    }
    .mud-drawer-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }
    .mud-drawer-content .nav-menu-full-height {
        height: 100%;
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .drawer-with-resize {
        height: 100%;
        min-height: 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .drawer-resize-handle {
        position: absolute;
        top: 0;
        right: 0;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        z-index: 10;
        background: transparent;
        touch-action: none;
        user-select: none;
    }
    .drawer-resize-handle:hover,
    .drawer-resizing .drawer-resize-handle {
        background: rgba(25, 118, 210, 0.35);
    }
    .drawer-resize-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        cursor: col-resize;
        user-select: none;
        touch-action: none;
    }
</style>
<style>
    :root {
        --shell-bg: #f5f7fa;
        --shell-surface: #ffffff;
        --shell-border: #e5eaf0;
        --shell-text: #111827;
        --shell-muted: #64748b;
        --shell-sidebar: #072a35;
        --shell-sidebar-deep: #061f29;
        --shell-sidebar-text: #d7e4e8;
        --shell-sidebar-muted: #86a2aa;
        --shell-radius: 12px;
        --workspace-accent: #0f766e;
        --workspace-accent-strong: #075e58;
        --workspace-accent-soft: #ecf8f6;
        --workspace-blue: #2563eb;
        --workspace-heading: #0f172a;
        --workspace-border: #dfe6ec;
        --workspace-subtle: #f8fafc;
        --workspace-shadow: 0 8px 24px rgba(15, 23, 42, .055);
    }

    html,
    body {
        background: var(--shell-bg);
    }

    .app-shell .mud-layout {
        background: var(--shell-bg);
    }

    .app-shell .appbar-custom {
        min-height: 64px;
        background: rgba(255, 255, 255, .97) !important;
        color: var(--shell-text) !important;
        border-bottom: 1px solid var(--shell-border);
        box-shadow: 0 2px 10px rgba(15, 23, 42, .045) !important;
        backdrop-filter: blur(12px);
    }

    .app-shell .appbar-custom .mud-toolbar {
        min-height: 64px;
        padding: 0 18px;
    }

    .shell-menu-button {
        color: #0f766e !important;
        border: 1px solid #dce7e8 !important;
        border-radius: 9px !important;
    }

    .topbar-context {
        min-width: 0;
        margin-left: 12px;
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .topbar-context strong {
        color: var(--shell-text);
        font-size: 14px;
        font-weight: 750;
    }

    .topbar-context span {
        margin-top: 3px;
        color: var(--shell-muted);
        font-size: 11px;
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        min-width: 0;
    }

    .topbar-actions .mud-icon-button {
        width: 36px;
        height: 36px;
        padding: 7px !important;
        color: #475569 !important;
        border-radius: 9px;
    }

    .topbar-actions .mud-icon-button:hover {
        color: #0f766e !important;
        background: #edf8f6 !important;
    }

    .topbar-notification {
        margin: 0 6px 0 0 !important;
    }

    .topbar-checkin {
        min-width: 118px !important;
        min-height: 36px !important;
        margin: 0 8px !important;
        border-radius: 9px !important;
        background: #0f766e !important;
        box-shadow: none !important;
        font-size: 12px !important;
        font-weight: 750 !important;
        letter-spacing: .01em !important;
    }

    .topbar-user-chip {
        height: 36px !important;
        margin: 0 4px !important;
        color: #0f172a !important;
        background: #f1f5f9 !important;
        border: 1px solid #e2e8f0;
        font-size: 12px !important;
        font-weight: 650 !important;
    }

    .topbar-logout {
        margin: 0 4px !important;
        padding: 0 8px !important;
        border-radius: 9px !important;
    }

    .topbar-logout .mud-nav-link-text {
        font-size: 12px;
        font-weight: 650;
    }

    .app-shell-drawer {
        border-right: 0 !important;
        background: linear-gradient(180deg, var(--shell-sidebar) 0%, var(--shell-sidebar-deep) 100%) !important;
        box-shadow: 8px 0 24px rgba(2, 23, 31, .12) !important;
    }

    .app-shell-drawer .mud-drawer-content {
        background: transparent !important;
    }

    .sidebar-brand {
        min-height: 64px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .sidebar-brand-mark {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex: 0 0 36px;
        border-radius: 10px;
        color: #ffffff;
        background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
        box-shadow: 0 6px 14px rgba(15, 118, 110, .24);
    }

    .sidebar-brand-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .sidebar-brand-copy strong {
        color: #f8fafc;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .01em;
    }

    .sidebar-brand-copy span {
        margin-top: 2px;
        color: var(--shell-sidebar-muted);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

    .app-main-content {
        min-height: 100vh;
        background: var(--shell-bg);
    }

    .workspace-content {
        min-height: calc(100vh - 94px);
    }

    .custom-tab > .mud-tabs-toolbar {
        min-height: 48px !important;
        padding: 7px 10px 0 !important;
        background: #f4f7f9 !important;
        border-bottom: 1px solid var(--shell-border) !important;
        box-shadow: none !important;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tabs-toolbar-inner,
    .custom-tab > .mud-tabs-toolbar .mud-tabs-toolbar-wrapper,
    .custom-tab > .mud-tabs-toolbar .mud-tabs-toolbar-content {
        min-width: 0;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab {
        width: auto !important;
        min-width: 124px !important;
        max-width: 232px !important;
        height: 40px !important;
        min-height: 40px !important;
        margin: 0 2px 0 0 !important;
        padding: 0 9px 0 14px !important;
        justify-content: space-between !important;
        gap: 8px;
        color: #526277 !important;
        background: #edf2f5 !important;
        border: 1px solid #dce4e9 !important;
        border-bottom-color: var(--shell-border) !important;
        border-radius: 8px 8px 0 0 !important;
        font-family: "Roboto", "Segoe UI", Arial, sans-serif !important;
        font-size: 12.5px !important;
        font-weight: 700 !important;
        line-height: 1 !important;
        text-transform: none !important;
        box-shadow: none !important;
        transition: color .15s ease, background .15s ease, border-color .15s ease !important;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab:hover {
        color: #0c6862 !important;
        background: #f8fbfb !important;
        border-color: #c9d9dc !importan
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab.mud-tab-active {
        position: relative;
        z-index: 1;
        color: #075e58 !important;
        background: #ffffff !important;
        border-color: #cfdadd !important;
        border-top: 3px solid #0f8b80 !important;
        border-bottom-color: #ffffff !important;
        padding-top: 1px !important;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab > span:not(.mud-icon-root),
    .custom-tab > .mud-tabs-toolbar .mud-tab .mud-typography,
    .custom-tab > .mud-tabs-toolbar .mud-tab .mud-tabs-panel-header {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab .mud-tabs-panel-header {
        display: block !important;
        flex: 1 1 auto !important;
        max-width: 188px;
        line-height: 40px !important;
        text-align: left;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tab .mud-tabs-panel-header,
    .custom-tab > .mud-tabs-toolbar .mud-tab .mud-tabs-panel-header * {
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    .custom-tab > .mud-tabs-toolbar .close-tab-icon {
        width: 22px !important;
        height: 22px !important;
        margin-left: 2px !important;
        padding: 2px !important;
        flex: 0 0 22px;
        color: #91a0b3 !important;
        border-radius: 5px !important;
    }

    .custom-tab > .mud-tabs-toolbar .close-tab-icon:hover {
        color: #dc2626 !important;
        background: #fee2e2 !important;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tabs-scroll-button {
        width: 32px !important;
        min-width: 32px !important;
        height: 32px !important;
        margin: 4px 3px !important;
        color: #526174 !important;
        background: transparent !important;
        border: 0 !important;
        border-radius: 6px !important;
    }

    .custom-tab > .mud-tabs-toolbar .workspace-add-tab-hidden {
        display: none !important;
    }

    .custom-tab > .mud-tabs-toolbar .mud-tabs-tabbar .mud-tab-slider {
        display: none !important;
    }

    .custom-tab > .mud-tabs-panels {
        background: var(--shell-bg) !important;
    }

    /* Shared visual baseline for every page opened in DynamicTabs. */
    .workspace-page {
        min-width: 0;
        color: var(--shell-text);
        font-family: "Roboto", "Segoe UI", Arial, sans-serif;
    }

    .workspace-standard-page {
        min-height: calc(100vh - 142px);
        background: var(--shell-bg);
    }

    .workspace-standard-page,
    .workspace-standard-page .mud-typography,
    .workspace-standard-page button,
    .workspace-standard-page input,
    .workspace-standard-page textarea,
    .workspace-standard-page select {
        font-family: "Roboto", "Segoe UI", Arial, sans-serif;
    }

    .workspace-standard-page > .mud-container {
        padding-top: 18px;
        padding-bottom: 18px;
    }

    .workspace-standard-page > .mud-container + .mud-container {
        padding-top: 0;
    }

    .workspace-standard-page :where(h1, h2, h3, .mud-typography-h4, .mud-typography-h5, .mud-typography-h6) {
        color: var(--workspace-heading);
        font-weight: 750;
        letter-spacing: -.015em;
    }

    .workspace-standard-page :where(.mud-typography-body2, .mud-typography-caption) {
        color: var(--shell-muted);
    }

    .workspace-standard-page [style*="font-size:xx-large"] {
        color: var(--workspace-heading) !important;
        font-size: 22px !important;
        font-weight: 800 !important;
        letter-spacing: -.02em;
    }

    .workspace-standard-page :where(.mud-button-root) {
        border-radius: 8px;
        font-weight: 650;
        letter-spacing: 0;
        text-transform: none;
        box-shadow: none;
    }

    .workspace-standard-page :where(.mud-icon-button) {
        border-radius: 8px;
    }

    .workspace-standard-page :where(.mud-button-root, .mud-icon-button):focus-visible {
        outline: 3px solid rgba(37, 99, 235, .18);
        outline-offset: 2px;
    }

    .workspace-standard-page :where(.mud-input-label) {
        color: #566579;
        font-weight: 550;
    }

    .workspace-standard-page :where(.mud-input-outlined-border) {
        border-color: #d6dfe7;
    }

    .workspace-standard-page :where(.mud-input-control:hover .mud-input-outlined-border) {
        border-color: #9fb7bd;
    }

    .workspace-standard-page :where(.mud-card) {
        border: 1px solid var(--workspace-border);
        border-radius: 12px;
        box-shadow: var(--workspace-shadow);
    }

    .workspace-standard-page :where(.mud-table-root) {
        border: 1px solid var(--workspace-border);
        border-radius: 12px;
        background: var(--shell-surface);
        box-shadow: 0 4px 16px rgba(15, 23, 42, .035);
        overflow: hidden;
    }

    .workspace-standard-page :where(.mud-table-head .mud-table-cell) {
        color: #334155;
        background: var(--workspace-subtle);
        border-bottom: 1px solid #dfe7ee;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: .01em;
    }

    .workspace-standard-page :where(.mud-table-body .mud-table-cell) {
        color: #273548;
        border-bottom-color: #edf1f5;
    }

    .workspace-standard-page :where(.mud-table-body .mud-table-row:hover .mud-table-cell) {
        background: #f3f9f8;
    }

    .workspace-standard-page :where(.mud-table-pagination) {
        color: #536277;
        background: #fbfcfd;
        border-top: 1px solid #edf1f5;
    }

    /* MudBlazor renders operator and clear-filter actions together.
       Keep clear available on demand without repeating two filter icons in every column. */
    .workspace-standard-page .filter-header-cell > .d-flex.flex-row {
        align-items: center;
        gap: 2px;
    }

    .workspace-standard-page .filter-header-cell > .d-flex.flex-row > .mud-icon-button:last-child {
        width: 0;
        min-width: 0;
        max-width: 0;
        margin: 0;
        padding: 0 !important;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transform: scale(.86);
        transition: width .14s ease, min-width .14s ease, max-width .14s ease, opacity .14s ease, transform .14s ease;
    }

    .workspace-standard-page .filter-header-cell:hover > .d-flex.flex-row > .mud-icon-button:last-child,
    .workspace-standard-page .filter-header-cell:focus-within > .d-flex.flex-row > .mud-icon-button:last-child {
        width: 28px;
        min-width: 28px;
        max-width: 28px;
        padding: 4px !important;
        color: #64748b;
        opacity: .82;
        pointer-events: auto;
        transform: scale(1);
    }

    .workspace-standard-page .filter-header-cell > .d-flex.flex-row > .mud-icon-button:last-child:hover {
        color: #dc2626;
        background: #fee2e2;
    }

    .workspace-standard-page :where(.mud-chip) {
        border-radius: 7px;
        font-weight: 650;
    }

    .workspace-standard-page :where(.mud-alert) {
        border-radius: 10px;
    }

    /* Nested tabs belong to a screen; they must not inherit the document-tab shape above. */
    .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar {
        min-height: 42px;
        padding: 0 4px;
        background: transparent;
        border-bottom: 1px solid var(--workspace-border);
        box-shadow: none;
    }

    .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar .mud-tab {
        width: auto;
        min-width: 96px;
        min-height: 42px;
        padding: 0 14px;
        color: #64748b;
        background: transparent;
        border: 0;
        border-radius: 8px 8px 0 0;
        font-size: 12.5px;
        font-weight: 650;
        line-height: 1.2;
        text-transform: none;
    }

    .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar .mud-tab:hover {
        color: var(--workspace-accent-strong);
        background: var(--workspace-accent-soft);
    }

    .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar .mud-tab.mud-tab-active {
        color: var(--workspace-accent-strong);
        background: #ffffff;
    }

    .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar .mud-tab-slider {
        height: 2px;
        background: var(--workspace-accent);
    }

    @@media (max-width: 720px) {
        .workspace-standard-page > .mud-container {
            padding-top: 12px;
            padding-right: 12px;
            padding-bottom: 14px;
            padding-left: 12px;
        }

        .workspace-standard-page .mud-tabs:not(.custom-tab) > .mud-tabs-toolbar .mud-tab {
            min-width: 84px;
            padding-right: 10px;
            padding-left: 10px;
        }
    }

    .app-footer {
        min-height: 30px;
        padding: 6px 18px;
        display: flex;
        align-items: center;
        color: #94a3b8;
        background: var(--shell-bg);
        border-top: 1px solid #edf1f5;
    }

    .app-footer .mud-typography {
        font-size: 11px !important;
    }

    @@media (max-width: 1100px) {
        .topbar-context,
        .topbar-user-chip .mud-chip-content,
        .topbar-logout .mud-nav-link-text {
            display: none !important;
        }

        .topbar-checkin {
            min-width: 96px !important;
        }
    }

    @@media (max-width: 720px) {
        .app-shell .appbar-custom .mud-toolbar {
            padding: 0 10px;
        }

        .topbar-actions .mud-icon-button:nth-last-of-type(-n+3),
        .topbar-user-chip,
        .topbar-logout {
            display: none !important;
        }

        .topbar-checkin {
            min-width: 88px !important;
            margin-right: 0 !important;
        }
    }
</style>
<CascadingValue Value="this">

    <div class="app-shell">
    <MudLayout>
        <MudAppBar Elevation="0" Class="appbar-custom" Style="@($"--shell-accent: {mainLayoutBackgroundColor};")">

            <MudIconButton Icon=@Icons.Material.Filled.Menu Color=Color.Inherit Edge=Edge.Start OnClick=DrawerToggle Class="shell-menu-button" />
            <div class="topbar-context">
                <strong>Operations workspace</strong>
                <span>Quản lý vận hành và dữ liệu tập trung</span>
            </div>
            <MudSpacer />

            <div class="topbar-actions">
                <AuthorizeView Context="auth">
                    <NotAuthorized>
                        <MudNavLink Href="/Account/Login" Icon=@Icons.Material.Filled.Login IconColor=Color.Success>@Localizer["Login"]</MudNavLink>
                    </NotAuthorized>
                    <Authorized>
                        @*  <Message_index OnTabRequest="@((t) => OpenTab(t.Key,t.Title,t.Content))" /> *@

                        <MudBadge Content="@_unreadEmailCount"
                        Color="Color.Error"
                        Visible="_unreadEmailCount > 0"
                        Class="topbar-notification">
                            <MudIconButton Icon="@Icons.Material.Filled.Email"
                            Color="Color.Inherit"
                            @onclick="TogglePopover" Style="padding:0.5px" />

                            <MudPopover Open="@_open"
                            AnchorOrigin="Origin.BottomCenter"
                            TransformOrigin="Origin.TopCenter"
                            RelativeWidth="true"
                            Elevation="4"
                            Class="pa-2"
                            Style="min-width: 300px; max-height: 500px; overflow-y: auto; z-index: 1300;">
                                <MudText Typo="Typo.h6" Class="mb-2">Notifications</MudText>
                                @if (listitem?.Any() == true)
                                {
                                    <MudListItem Class="mt-2" Style="cursor: pointer;" @onclick="ViewAllMessages">
                                        <MudText Color="Color.Primary" Typo="Typo.body2" Class="text-center w-100">View all messages</MudText>
                                    </MudListItem>

                                    <MudListItem Class="mt-2" Style="cursor: pointer;" @onclick="MarkAllAsRead">
                                        <MudText Color="Color.Secondary" Typo="Typo.body2" Class="text-center w-100">Read All</MudText>
                                    </MudListItem>

                                    @foreach (var note in listitem)
                                    {
                                        <MudListItem @onclick="@(() => UpdateNotification(note))"
                                                     Style="@(note.IsRead == false ? "background-color: #e0f7fa;" : null)">
                                            <MudText Typo="Typo.subtitle2">@note.Message</MudText>
                                            <MudText Typo="Typo.caption">@note.CreatedAt.ToString("MM/dd/yyyy")</MudText>
                                        </MudListItem>
                                        <MudDivider />

                                    }


                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">No notifications available.</MudText>
                                    <MudListItem Class="mt-2" Style="cursor: pointer;" @onclick="ViewAllMessages">
                                        <MudText Color="Color.Primary" Typo="Typo.body2" Class="text-center w-100">View all messages</MudText>
                                    </MudListItem>
                                }
                            </MudPopover>
                        </MudBadge>

                        @* OutRequest Popup trigger (non-admin) *@
                        @if (!IsAdmin)
                        {
                            @* <MudIconButton Icon="@Icons.Material.Filled.AirportShuttle" Color="Color.Inherit" @onclick="OpenOutRequestTab" Style="margin-right:20px" /> *@
                            @if (_canViewLeaveRequests)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.EventNote" Color="Color.Inherit" @onclick="OpenLeaveRequestTab" Style="margin-right:20px" />
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_checkedInToday" OnClick="CheckIn" Class="topbar-checkin">
                                @(_checkedInToday ? Localizer["Đã chấm"] : Localizer["Chấm công"])
                            </MudButton>
                        }
                        else
                        {
                            @* <MudIconButton Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Inherit" @onclick="OpenAdminOutRequest" Style="margin-right:20px" /> *@
                            @if (_canApproveLeaveRequests)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.AssignmentLate" Color="Color.Inherit" @onclick="OpenAdminLeaveRequest" Style="margin-right:20px" />
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_checkedInToday" OnClick="CheckIn" Class="topbar-checkin">
                                @(_checkedInToday ? Localizer["Đã chấm"] : Localizer["Chấm công"])
                            </MudButton>
                        }


                        <MudChip Icon=@Icons.Material.Filled.Person Color=Color.Secondary IconColor=Color.Inherit Class="topbar-user-chip">
                            @(auth.User.Identity?.Name) - @(user.Department)
                        </MudChip>
                        <MudNavLink Href="/Account/Logout" Icon=@Icons.Material.Filled.Logout IconColor=Color.Success Class="topbar-logout">
                            @Localizer["Logout"]
                        </MudNavLink>

                        <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" @onclick="OpenThemeSelector" 
                                      Title="@Localizer["ThemeSettings"]" Style="margin-right: 10px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.TableChart" Color="Color.Inherit" @onclick="OpenShipmentGridColorSelector"
                                      Title="Shipment grid colors" Style="margin-right: 10px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" @onclick="OpenLocalizationEditor" 
                                      Title="@Localizer["EditLanguage"]" Style="margin-right: 10px;" />
                        <CultureSelector />
                    </Authorized>
                </AuthorizeView>
            </div>
        </MudAppBar>
        <MudDrawer Open=_drawerOpen ClipMode=DrawerClipMode.Always Elevation=2
        Variant="DrawerVariant.Responsive"
        Breakpoint="Breakpoint.Md" DisableOverlay
        Width="@($"{_drawerWidth}px")"
        Class="@($"app-shell-drawer {(_isResizingDrawer ? "drawer-resizing" : string.Empty)}")">
            <div class="drawer-with-resize">
                <div class="sidebar-brand">
                    <div class="sidebar-brand-mark">
                        <MudIcon Icon="@Icons.Material.Rounded.LocalShipping" Size="Size.Medium" />
                    </div>
                    <div class="sidebar-brand-copy">
                        <strong>LMS · NVOCC</strong>
                        <span>Operations platform</span>
                    </div>
                </div>
                <NavMenu OnTabRequest="@((t) => OpenTab(t.Key,t.Title,t.Content))" @ref="_navMenuRef" />
                @if (_drawerOpen)
                {
                    <div class="drawer-resize-handle"
                         title="Kéo để đổi độ rộng menu"
                         @onpointerdown="OnDrawerResizeStart"
                         @onpointerup="OnDrawerResizeEnd"
                         @onpointercancel="OnDrawerResizeEnd"></div>
                }
            </div>
        </MudDrawer>
        @if (_isResizingDrawer)
        {
            <div class="drawer-resize-overlay"
                 @onpointermove="OnDrawerResizeMove"
                 @onpointerup="OnDrawerResizeEnd"
                 @onpointercancel="OnDrawerResizeEnd"></div>
        }
        <MudMainContent Class="app-main-content">
            @* @Body *@
            <div class="workspace-content">
                <DynamicTabs @ref="_tabs" />
            </div>
            <footer class="app-footer">
                <MudText Typo="Typo.caption">Copyright © @DateTime.Now.Year LMS · NVOCC</MudText>
            </footer>
        </MudMainContent>
    </MudLayout>
    </div>

    @* AI Assistant - only visible when authenticated *@
    <AuthorizeView>
        <Authorized>
            <ABFreight.Components.ChatGPT.Pages.ChatGPTPanel />
        </Authorized>
    </AuthorizeView>
</CascadingValue>

<div id="blazor-error-ui" style="background-color:black; color:white; text-align: right;">
    An unhandled error has occurred,
    <a href="" class="reload"> Reload please!</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    bool _drawerOpen = true;
    private double _drawerWidth = 240;
    private const double DrawerMinWidth = 180;
    private const double DrawerMaxWidth = 480;
    private const string DrawerWidthStorageKey = "nvocc.drawerWidth";
    private bool _isResizingDrawer;
    AuthUser user = new AuthUser();
    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void OnDrawerResizeStart(PointerEventArgs e)
    {
        if (!_drawerOpen || e.Button != 0)
            return;
        _isResizingDrawer = true;
    }

    private void OnDrawerResizeMove(PointerEventArgs e)
    {
        if (!_isResizingDrawer)
            return;

        var next = Math.Clamp(e.ClientX, DrawerMinWidth, DrawerMaxWidth);
        if (Math.Abs(next - _drawerWidth) < 0.5)
            return;

        _drawerWidth = next;
    }

    private async Task OnDrawerResizeEnd(PointerEventArgs e)
    {
        if (!_isResizingDrawer)
            return;

        _isResizingDrawer = false;
        await SaveDrawerWidthAsync();
    }

    private async Task LoadDrawerWidthAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", DrawerWidthStorageKey);
            if (double.TryParse(stored, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var width))
                _drawerWidth = Math.Clamp(width, DrawerMinWidth, DrawerMaxWidth);
        }
        catch
        {
            // ignore JS / storage errors
        }
    }

    private async Task SaveDrawerWidthAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DrawerWidthStorageKey, _drawerWidth.ToString("0", System.Globalization.CultureInfo.InvariantCulture));
        }
        catch
        {
            // ignore JS / storage errors
        }
    }
    private int _unreadEmailCount = 0;
    private bool _checkedInToday = false;
    // Removed popup approach; using tab instead
    //private bool _openOutRequest = false;
    // Xác định admin dựa trên Department
    private bool IsAdmin => string.Equals(user?.Department, "ADMIN", StringComparison.OrdinalIgnoreCase);
    private Timer? _checkInTimer;

    // Permission variables
    private bool _canViewLeaveRequests = false;
    private bool _canApproveLeaveRequests = false;

    // private ISnackbar? _checkInReminder;
    private MudBlazor.Snackbar? _checkInReminder;
    private bool _disposed;
    private string mainLayoutBackgroundColor = ThemeDefaults.MainLayoutBackgroundColor;
    private string _fontHeaderH6 = ThemeDefaults.FontHeaderH6;
    private string _fontTieuDe = ThemeDefaults.FontTieuDe;
    private string _fontNoiDung = ThemeDefaults.FontNoiDung;
    private string _fontNoiDungLuoi = ThemeDefaults.FontNoiDungLuoi;
    private string _fontNavMenu = ThemeDefaults.FontNavMenu;

    protected override async Task OnInitializedAsync()
    {
        user = asv.GetUserDetail() ?? new();
        if (user != null && user.UsrId != Guid.Empty)
        {
            try
            {
                _unreadEmailCount = await _notificationService.GetUnreadEmailCountAsync(user.UsrId);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Unable to load notification count: {ex.Message}");
            }
            
            // Check permissions
            if (!string.IsNullOrEmpty(user.Usr))
            {
                try
                {
                    _canViewLeaveRequests = await SharedService.CheckPermission(user.Usr, "view", "LeaveRequests");
                    _canApproveLeaveRequests = await SharedService.CheckPermission(user.Usr, "approve", "LeaveRequests");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Unable to load layout permissions: {ex.Message}");
                }
            }
        }

        await LoadThemePreference();
        await LoadFontPreferenceFromDb();
        try
        {
            await StartHub();
        }
        catch (Exception ex)
        {
            // Notifications are optional. A transient hub failure must not
            // terminate the complete layout or leave the menu half-rendered.
            Console.WriteLine($"Unable to start notification hub: {ex.Message}");
        }
        // await LoadCheckInStatus();
        ScheduleNextCheck();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await LoadDrawerWidthAsync();
            await ApplyStoredFontPreference();
            // Apply saved Shipment grid colors globally (CSS variables + localStorage).
            await JS.InvokeVoidAsync("nvoccLoadShipmentColorSettings");
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // ignore JS errors
        }
    }

    private async Task LoadThemePreference()
    {
        try
        {
            var url = Navigation.ToAbsoluteUri("api/theme/get");
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            
            // Add cookies from HttpContext to request
            if (HttpContextAccessor.HttpContext != null)
            {
                var cookies = HttpContextAccessor.HttpContext.Request.Cookies;
                var cookieHeader = string.Join("; ", cookies.Select(c => $"{c.Key}={c.Value}"));
                if (!string.IsNullOrEmpty(cookieHeader))
                {
                    request.Headers.Add("Cookie", cookieHeader);
                }
            }
            
            var httpResponse = await Http.SendAsync(request);
            
            if (!httpResponse.IsSuccessStatusCode)
            {
                var errorContent = await httpResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"API Error: {httpResponse.StatusCode} - {errorContent.Substring(0, Math.Min(200, errorContent.Length))}");
                return;
            }

            var response = await httpResponse.Content.ReadFromJsonAsync<ThemeResponse>();
            if (response != null)
            {
                if (!string.IsNullOrEmpty(response.MainLayoutBackgroundColor))
                {
                    mainLayoutBackgroundColor = response.MainLayoutBackgroundColor;
                    Console.WriteLine($"Loaded MainLayout color: {mainLayoutBackgroundColor}");
                }

                // Reload NavMenu theme as well
                if (_navMenuRef != null)
                {
                    await _navMenuRef.ReloadThemeAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading theme: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
        }
    }

    private async Task LoadFontPreferenceFromDb()
    {
        try
        {
            if (user == null || user.UsrId == Guid.Empty)
                return;

            var preference = await ThemeService.GetUserThemePreferenceAsync(user.UsrId);
            _fontHeaderH6 = string.IsNullOrWhiteSpace(preference.FontHeaderH6) ? ThemeDefaults.FontHeaderH6 : preference.FontHeaderH6;
            _fontTieuDe = string.IsNullOrWhiteSpace(preference.FontTieuDe) ? ThemeDefaults.FontTieuDe : preference.FontTieuDe;
            _fontNoiDung = string.IsNullOrWhiteSpace(preference.FontNoiDung) ? ThemeDefaults.FontNoiDung : preference.FontNoiDung;
            _fontNoiDungLuoi = string.IsNullOrWhiteSpace(preference.FontNoiDungLuoi) ? ThemeDefaults.FontNoiDungLuoi : preference.FontNoiDungLuoi;
            _fontNavMenu = string.IsNullOrWhiteSpace(preference.FontNavMenu) ? ThemeDefaults.FontNavMenu : preference.FontNavMenu;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading font preference: {ex.Message}");
        }
    }

    private async Task OpenThemeSelector()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ThemeSelector.Pages.ThemeSelector>(Localizer["ThemeSettings"], parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            // Reload theme after changes - this will reload both MainLayout and NavMenu
            await LoadThemePreference();
        }
    }

    private async Task OpenShipmentGridColorSelector()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ThemeSelector.Pages.ShipmentGridColorSelector>("Shipment grid colors", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            // Ensure the saved settings are applied immediately across the app.
            try
            {
                await JS.InvokeVoidAsync("nvoccLoadShipmentColorSettings");
            }
            catch { }
        }
    }

    private async Task OpenLocalizationEditor()
    {
        if (!IsAdmin)
        {
            Snackbar.Add(Localizer["AdminAccessRequired"], MudBlazor.Severity.Warning);
            return;
        }

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<LocalizationEditor.Pages.LocalizationEditor>(Localizer["EditLanguage"], options);
    }

    private async Task ApplyStoredFontPreference()
    {
        try
        {
            await FontSizeService.SetFontSize(_fontHeaderH6, _fontNoiDung, _fontTieuDe, _fontNoiDungLuoi);
            await FontSizeService.SetNavMenuFontSize(_fontNavMenu);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error applying font preference: {ex.Message}");
        }
    }

    private class ThemeResponse
    {
        public string? NavMenuBackgroundColor { get; set; }
        public string? MainLayoutBackgroundColor { get; set; }
    }
    private void ScheduleNextCheck()
    {
        if (_disposed) return;

        var now = DateTime.Now;
        var next = now.Hour < 8 ? now.Date.AddHours(8)
                  : now.Hour < 13 ? now.Date.AddHours(13)
                  : now.Date.AddDays(1).AddHours(8);

        var delay = next - now;

        _checkInTimer = new Timer(async _ =>
        {
            if (_disposed) return;

            await InvokeAsync(async () =>
            {
                await LoadCheckInStatus();
                StateHasChanged();
                ScheduleNextCheck();
            });
        }, null, delay, Timeout.InfiniteTimeSpan);
    }



    private DynamicTabs? _tabs;
    private NavMenu? _navMenuRef;

    public async Task OpenTab(string key, string title, RenderFragment content)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? false)
        {
            Navigation.NavigateTo("/account/login", forceLoad: true);
            return;
        }
        _tabs?.OpenTab(key, title, content);
    }

    private HubConnection? _hubConnection;
    public async Task StartHub()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usr = authState.User;

        if (usr.Identity != null && usr.Identity.IsAuthenticated)
        {

            _hubConnection = new HubConnectionBuilder()
                    .WithUrl(Navigation.ToAbsoluteUri($"/notificationhub?userid={user.UsrId}"))
                    .WithAutomaticReconnect()
                    .Build();

            _hubConnection.On<string>("ReceiveNotification", (message) =>
            {
                Snackbar.Add($"🔔 {message}", MudBlazor.Severity.Info, options =>
                {
                    // Admin: giữ nguyên đến khi tự đóng
                    options.RequireInteraction = IsAdmin;
                    options.Action = IsAdmin ? Localizer["Đóng"].Value : "";
                    options.Onclick = snackbar =>
                    {
                        return OpenTab("INBOX", Localizer["Inbox"], RenderComponent(typeof(Components.Noti_Message.Pages.Index)));
                    };
                });
                // Tăng số lượng chưa đọc ngay lập tức
                _unreadEmailCount++;
                InvokeAsync(StateHasChanged);
            });


            _hubConnection.On<int>("UpdateUnreadEmailCount", (newCount) =>
            {
                _unreadEmailCount = newCount;
                InvokeAsync(StateHasChanged); 
            });

            await InvokeAsync(StateHasChanged);
            await _hubConnection.StartAsync();
        }

    }
    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    RenderFragment RenderComponent(Type componentType) => builder =>
      {
          builder.OpenComponent(0, componentType);
          builder.CloseComponent();
      };

    private bool _open;
    private MudPopover? _popoverRef;
    private List<Notification> listitem = new List<Notification>();
    private MudIconButton? _emailButtonRef;
    private Task OpenOutRequestTab(){
        _tabs?.OpenTab("outreq_submit", Localizer["Out Request"], RenderComponent(typeof(Components.OutRequests.OutRequestSubmit)));
        return Task.CompletedTask; }
    private Task OpenAdminOutRequest(){
        _tabs?.OpenTab("outreq_approve", Localizer["Approve Out Requests"], RenderComponent(typeof(Components.OutRequests.OutRequestApprove))); 
        return Task.CompletedTask; }
    private Task OpenLeaveRequestTab(){
        _tabs?.OpenTab("leave_submit", "Đăng ký nghỉ phép", RenderComponent(typeof(Components.LeaveRequests.LeaveRequestSubmit)));
        return Task.CompletedTask; }
    private Task OpenAdminLeaveRequest(){
        _tabs?.OpenTab("leave_approve", "Duyệt nghỉ phép", RenderComponent(typeof(Components.LeaveRequests.LeaveRequestApprove))); 
        return Task.CompletedTask; }
    private async Task TogglePopover()
    {
        _open = !_open;

        listitem = await _notificationService.GetList_noti();
        // Re-sync unread count from server list
        _unreadEmailCount = listitem.Count(x => !x.IsRead);
        await InvokeAsync(StateHasChanged);

    }

    private Task ViewAllMessages()
    {
        _open = false; // đóng popover
        // if (OnTabRequest.HasDelegate)
        //     await OnTabRequest.InvokeAsync(("message", Localizer["message"], RenderComponent(typeof(Components.Noti_Message.Pages.Index))));

        _tabs?.OpenTab("message", Localizer["message"], RenderComponent(typeof(Components.Noti_Message.Pages.Index)));
        return Task.CompletedTask;
    }

    private async Task MarkAllAsRead()
    {
        if (listitem.Count > 0)
        {
            foreach (var item in listitem)
            {
                item.IsRead = true;
                var rs = await _notificationService.UpdateSentNoti(item);
            }
        }
        listitem = await _notificationService.GetList_noti();
        _unreadEmailCount = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateNotification(Notification note)
    {
        note.IsRead = true;
        await _notificationService.UpdateSentNoti(note);
        if (_unreadEmailCount > 0)
            _unreadEmailCount--;

        _open = false;
        await InvokeAsync(StateHasChanged);

        if (PhieuApproveService.TryParsePhieuApproveNotification(note.Message, out _, out var token))
        {
            var parameters = new DialogParameters<Components.PhieuThuChi.Pages.PhieuApproveDialog>
            {
                { x => x.Token, token }
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            };
            await DialogService.ShowAsync<Components.PhieuThuChi.Pages.PhieuApproveDialog>(
                "Duyệt phiếu thu/chi", parameters, options);
        }
    }

    private Task OpenTab_all(string key, string title, RenderFragment content)
    {
        _tabs?.OpenTab(key, title, content);
        return Task.CompletedTask;
    }

    private async Task LoadCheckInStatus()
    {
        var now = DateTime.Now;
        var today = DateTime.Today;

        var morningStart = today.AddHours(8);
        var morningEnd = today.AddHours(9);
        var afternoonStart = today.AddHours(13);
        var afternoonEnd = today.AddHours(14);

        string session = "";
        if (now >= morningStart && now <= morningEnd)
            session = "morning";
        else if (now >= afternoonStart && now <= afternoonEnd)
            session = "afternoon";

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usr = authState.User;
        var uidClaim = usr.Claims.FirstOrDefault(c => c.Type.EndsWith("/nameidentifier") || c.Type == "sub" || c.Type == "UsrId");

        if (uidClaim != null && Guid.TryParse(uidClaim.Value, out Guid uid))
        {
            _checkedInToday = await AttendanceService.HasCheckedInTodayAsync(uid, session);

            if (!string.IsNullOrEmpty(session) && !_checkedInToday)
            {
                if (_checkInReminder == null)
                {
                    _checkInReminder = Snackbar.Add(
                        "Bạn đang trong giờ chấm công, vui lòng chấm ngay!",
                        MudBlazor.Severity.Error,
                        cfg =>
                        {
                            cfg.RequireInteraction = true;
                            cfg.VisibleStateDuration = 0;
                            cfg.ShowCloseIcon = false;
                        });
                }
            }
            else
            {
                if (_checkInReminder != null)
                {
                    Snackbar.Remove(_checkInReminder);
                    _checkInReminder = null;
                }
            }
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _checkInTimer?.Dispose();
    }

    private async Task CheckIn()
    {
        if (_checkedInToday) return;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usr = authState.User;
        var uidClaim = usr.Claims.FirstOrDefault(c => c.Type.EndsWith("/nameidentifier") || c.Type == "sub" || c.Type == "UsrId");
        if (uidClaim == null || !Guid.TryParse(uidClaim.Value, out var uid))
        {
            Snackbar.Add(Localizer["Không xác định user"], MudBlazor.Severity.Error); return;
        }
        var rs = await AttendanceService.CheckInAsync(uid);
        Snackbar.Add(rs.Message, rs.Success ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (rs.Success) _checkedInToday = true;

        await LoadCheckInStatus();
    }

}
