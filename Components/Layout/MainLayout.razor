<MudDialogProvider />
<MudSnackbarProvider />
<style>
    .mud-appbar {
    z-index: 1300 !important;
    }
    
</style>

<style>
    .appbar-custom {
    }
    .mud-drawer-content {
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }
    .mud-drawer-content .nav-menu-full-height {
        height: 100%;
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .drawer-with-resize {
        height: 100%;
        min-height: 0;
        flex: 1;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .drawer-resize-handle {
        position: absolute;
        top: 0;
        right: 0;
        width: 6px;
        height: 100%;
        cursor: col-resize;
        z-index: 10;
        background: transparent;
        touch-action: none;
        user-select: none;
    }
    .drawer-resize-handle:hover,
    .drawer-resizing .drawer-resize-handle {
        background: rgba(25, 118, 210, 0.35);
    }
    .drawer-resize-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        cursor: col-resize;
        user-select: none;
        touch-action: none;
    }
</style>
<CascadingValue Value="this">

    <MudLayout>
        <MudAppBar Elevation="1" Class="appbar-custom" Style="@($"background-color: {mainLayoutBackgroundColor} !important;")">

            <MudIconButton Icon=@Icons.Material.Filled.Menu Color=Color.Inherit Edge=Edge.Start OnClick=DrawerToggle />
            @* <MudImage Src="Logo.png" Alt="LMS" Height="50" ObjectFit="ObjectFit.ScaleDown" Class="rounded-lg" /> *@
            <MudText Typo=Typo.h5 Class="ml-3">LMS - NVOCC</MudText>
            <MudSpacer />

            <div class="mud-toolbar mud-toolbar-dense">
                <div class="flex-grow-1"></div>
                <AuthorizeView Context="auth">
                    <NotAuthorized>
                        <MudNavLink Href="/Account/Login" Icon=@Icons.Material.Filled.Login IconColor=Color.Success>@Localizer["Login"]</MudNavLink>
                    </NotAuthorized>
                    <Authorized>
                        @*  <Message_index OnTabRequest="@((t) => OpenTab(t.Key,t.Title,t.Content))" /> *@

