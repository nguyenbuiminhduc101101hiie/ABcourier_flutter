
<MudDynamicTabs @ref="_mudTabs" Class="custom-tab"
                @bind-ActivePanelIndex="_activeIndex"
                KeepPanelsAlive="true"
                Rounded="false"
                Centered="false" CloseIconClass="close-tab-icon" CloseIconToolTip="Close tab"
                AddIconClass="workspace-add-tab-hidden"
                Border="false" CloseTab="@CloseTabCallback"
                @bind-ActivePanelIndex:after="OnTabChanged">

    @foreach (var tab in Tabs)
    {
        <MudTabPanel @key="tab.Key"
                     ShowCloseIcon="@(!IsPinnedTab(tab.Key))"
                     Text="@tab.Title"
                     ID="tab.Key"
                     Class="workspace-tab-panel">
            <div class="workspace-page @(IsPinnedTab(tab.Key) ? "workspace-dashboard-page" : "workspace-standard-page")">
                @tab.Content
            </div>
        </MudTabPanel>
    }
</MudDynamicTabs>
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@code {
    RenderFragment RenderComponent(Type componentType) => builder =>
       {
           builder.OpenComponent(0, componentType);
           builder.CloseComponent();
       };
    protected override Task OnInitializedAsync()
    {
        OpenTab("Dashboard", $"1. {Localizer["Dashboard"]}", RenderComponent(typeof(Components.Pages.Home)));
        return base.OnInitializedAsync();
    }
    private MudDynamicTabs _mudTabs;
    private int _activeIndex;

    public class TabItem
    {
        public string Key { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public RenderFragment Content { get; set; } = default!;
    }

    private List<TabItem> Tabs { get; set; } = new();

    public void OpenTab(string key, string title, RenderFragment content)
    {
        var existingIndex = Tabs.FindIndex(t => t.Key == key);
        if (existingIndex >= 0)
        {
            _activeIndex = existingIndex;
        }
        else
        {
            Tabs.Add(new TabItem
                {
                    Key = key,
                    Title = title,
                    Content = content
                });

            _activeIndex = Tabs.Count - 1;
        }

        StateHasChanged(); // rất quan trọng
    }

    private void CloseTab(string key)
    {
        if (IsPinnedTab(key))
            return;

        var index = Tabs.FindIndex(t => t.Key == key);
        if (index < 0) return;

        bool isActiveTab = index == _activeIndex;

        Tabs.RemoveAt(index);

        if (Tabs.Count == 0)
        {
            _activeIndex = -1; // Không còn tab
        }
        else if (isActiveTab)
        {
            // Nếu tab bị đóng là tab đang xem
            _activeIndex = index == 0 ? 0 : index - 1;
        }
        else if (index < _activeIndex)
        {
            // Nếu tab bị đóng nằm trước tab đang xem, giảm _activeIndex
            _activeIndex--;
        }

        StateHasChanged();
    }

    void CloseTabCallback(MudTabPanel panel) => CloseTab(panel.ID.ToString()!);

    private static bool IsPinnedTab(string? key) =>
        string.Equals(key, "Dashboard", StringComparison.OrdinalIgnoreCase);

    private async Task OnTabChanged()
    {
        if (_activeIndex >= 0 && _activeIndex < Tabs.Count)
        {
            var title = Tabs[_activeIndex].Title;
            await JSRuntime.InvokeVoidAsync("setPageTitle", title);
        }
    }
}
