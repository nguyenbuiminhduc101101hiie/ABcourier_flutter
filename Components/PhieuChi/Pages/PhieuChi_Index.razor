@page "/Phieuchi"
@using System.Globalization
@using Microsoft.Data.SqlClient
@using Microsoft.EntityFrameworkCore
@using ABFreight.Data
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject PhieuThu_Chi_Services thuchiSv
@inject PhieuApproveService phieuApproveSv
@inject CustomerService Cussv
@inject HistoryLogService HistoryLogService
@inject AppDbContext Db
@inject NavigationManager NavManager
@using System.Text.Json;


<style>
    .payment-page {
        background: #f3f6fb;
        min-height: calc(100vh - 64px);
        padding: 12px;
    }

    .payment-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #e5eaf2;
        box-shadow: 0 6px 20px rgba(15, 23, 42, .06);
        overflow: hidden;
    }

    .payment-toolbar {
        background: linear-gradient(90deg, #7c2d12, #f97316);
        padding: 10px 14px !important;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

        .payment-toolbar .mud-button-root {
            height: 32px !important;
            min-height: 32px !important;
            border-radius: 8px !important;
            text-transform: none !important;
            font-weight: 600 !important;
            box-shadow: none !important;
        }

    .payment-search {
        width: 340px;
        margin-left: auto !important;
        background: white;
        border-radius: 8px;
    }

    .payment-grid {
        border-radius: 0;
        background: white;
    }

        .payment-grid .mud-table-head {
            background: #fff7ed !important;
        }

            .payment-grid .mud-table-head .mud-table-cell {
                background: #fff7ed !important;
                color: #0f172a !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                border-bottom: 1px solid #fed7aa !important;
                white-space: nowrap;
            }

        .payment-grid .mud-table-cell {
            font-size: 13px !important;
            padding: 6px 8px !important;
            border-bottom: 1px solid #edf2f7 !important;
            white-space: nowrap;
            color: #1f2937;
        }

        .payment-grid .mud-table-row:hover {
            background: #fff7ed !important;
        }

    .selected {
        background: #ffedd5 !important;
        border-left: 4px solid #f97316 !important;
    }

        .selected > td {
            color: #0f172a !important;
            font-weight: 600;
        }

            .selected > td .mud-input {
                color: #0f172a !important;
            }

    .amount-cell {
        text-align: right !important;
        font-weight: 800 !important;
        color: #c2410c !important;
    }

    .payment-detail-card {
        background: #fffaf5;
        border: 1px solid #fed7aa;
        border-radius: 12px;
    }

    .payment-detail-label {
        font-size: 11px;
        color: #9a3412;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .payment-detail-value {
        font-size: 13px;
        color: #0f172a;
        font-weight: 500;
        min-height: 20px;
    }

    .payment-total-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 14px;
        background: #f8fafc;
        border-top: 1px solid #e5eaf2;
        flex-wrap: wrap;
        width: 100%;
    }

    .total-box {
        background: white;
        border: 1px solid #dbe4ef;
        border-radius: 10px;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
    }

        .total-box span {
            color: #c2410c;
            font-size: 15px;
            margin-left: 6px;
        }

    .no-wrap {
        white-space: nowrap;
    }

    .mud-menu {
        display: none;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }
</style>

<PageTitle>@Localizer["Phieuchi"] </PageTitle>
<div class="payment-page">
    <PpScreenHeader Title="@Localizer["Phieuchi"]" Subtitle="Phiếu chi · quản lý thanh toán · tạo voucher kế toán">
        <Toolbar>
            <MudStack Row Justify="Justify.FlexStart" Class="payment-toolbar">

                <MudButton HtmlTag="label"
                           OnClick="Refresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenCreateDialog(new Models.M_PhieuChi()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenEditDialog(detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenDuplicateDialog(detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>

                <MudButton Disabled="_processingUpload"
                           OnClick="ExportBill"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Download">
                    @if (_processingUpload)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Processing</MudText>
                    }
                    else
                    {
                        <MudText>@Localizer["Export_Bill"]</MudText>
                    }
                </MudButton>

                <MudButton Disabled="_processingApprove"
                           OnClick="SendApproveRequestAsync"
                           Size="Size.Small"
                           Color="Color.Warning"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Send">
                    @if (_processingApprove)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Sending</MudText>
                    }
                    else
                    {
                        <MudText>Gửi Yêu cầu Duyệt</MudText>
                    }
                </MudButton>
                <MudButton Disabled="_processingUnapprove"
                           OnClick="UnapproveAsync"
                           Size="Size.Small"
                           Color="Color.Error"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Undo">
                    @if (_processingUnapprove)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Processing</MudText>
                    }
                    else
                    {
                        <MudText>Bỏ Approve</MudText>
                    }
                </MudButton>
                <MudButton Disabled="_processingVoucher"
                           OnClick="CreateVoucherFromSelectedPaymentAsync"
                           Size="Size.Small"
                           Color="Color.Success"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.ReceiptLong">
                    @if (_processingVoucher)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Posting</MudText>
                    }
                    else
                    {
                        <MudText>Tạo Voucher</MudText>
                    }
                </MudButton>
                <MudTextField @bind-Value="_searchString"
                              Placeholder="@Localizer["Search"]"
                              Adornment="Adornment.Start"
                              Immediate="true"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Class="payment-search"
                              Margin="Margin.Dense"
                              TextChanged="OnSearchTextChanged" />


            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="payment-card" Elevation="0">
        <MudDataGrid T="M_PhieuChi"
                     Items="@filteredItems"
                     Filterable="true"
                     @ref="mudTable"
                     Class="payment-grid"
                     Bordered="false"
                     Striped="true"
                     Hover="true"
                     Dense="true"
                     Virtualize="true"
                     QuickFilter="@FilterFunc1"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     FixedHeader="true"
                     FixedFooter="true"
                     Height="calc(100vh - 190px)"
                     HeaderClass="no-wrap"
                     FooterClass="no-wrap"
                     ReadOnly="false"
                     CommittedItemChanges="@CommittedItem"
                     RowClassFunc="@SelectedRowClassFunc"
                     RowClick="@RowClicked"
                     EditDialogOptions="@options"
                     ColumnResizeMode="ResizeMode.Container"
                     Loading="_loading">

            <Columns>
                <HierarchyColumn T="M_PhieuChi" Filterable="false" />

                <TemplateColumn Title="" CellClass="d-flex justify-center" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@Localizer["Approve"]" Filterable="false" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Approve == true)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">Approved</MudChip>
                            @if (!string.IsNullOrWhiteSpace(context.Item.ApproveBy))
                            {
                                <MudText Typo="Typo.caption">@context.Item.ApproveBy</MudText>
                            }
                        }
                        else if (context.Item.Approve == false && !string.IsNullOrWhiteSpace(context.Item.ApproveBy))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Denied</MudChip>
                            <MudText Typo="Typo.caption">@context.Item.ApproveBy</MudText>
                        }
                        else if (!string.IsNullOrWhiteSpace(context.Item.ApproveToken))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Chờ duyệt</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Chưa gửi</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Sophieuchi"
                                Title="@Localizer["Sophieuchi"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.Ngay"
                                Title="@Localizer["NGAY"]"
                                Format="dd/MM/yyyy"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => CustomerName(x.Customer_ID)"
                                Title="@Localizer["Customer"]"
                                CellStyleFunc="_cellStyleFunc">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.Customer_ID" Label="@Localizer["Customer"]">
                            @foreach (var item in List_Cus)
                            {
                                <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Sotien"
                                Title="@Localizer["sotien"]"
                                Format="#,##0.##"
                                Culture="_en"
                                CellStyleFunc="_cellStyleFunc"
                                CellClass="amount-cell" />

                <PropertyColumn Property="x => x.Currency"
                                Title="@Localizer["Loaitiente"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.PTTT"
                                Title="@Localizer["PTTT"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.TKnophieuchi"
                                Title="@Localizer["TKnophieuchi"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.TKCophieuchi"
                                Title="@Localizer["TKCophieuchi"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.Noidung"
                                Title="@Localizer["noidung"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.Bank"
                                Title="@Localizer["Bank"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.Useupdate"
                                Title="@Localizer["UserUpdate"]"
                                CellStyleFunc="_cellStyleFunc" />

                <PropertyColumn Property="x => x.DateUpdate"
                                Title="@Localizer["Dateupdate"]"
                                CellStyleFunc="_cellStyleFunc" />

            </Columns>

            <ChildRowContent>
                <MudCard Class="payment-detail-card ma-2 pa-3" Elevation="0">
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Chungtukemtheo"]</div>
                            <div class="payment-detail-value">@context.Item.Chungtu</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Nguoinoptien"]</div>
                            <div class="payment-detail-value">@context.Item.Nguoinoptien</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["HBL"]</div>
                            <div class="payment-detail-value">@context.Item.Hbl</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["sohoadon"]</div>
                            <div class="payment-detail-value">@context.Item.SoHoaDon</div>
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Vesselvoy"]</div>
                            <div class="payment-detail-value">@context.Item.Vesselvoy</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["ref"]</div>
                            <div class="payment-detail-value">@context.Item.Ref</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Branch"]</div>
                            <div class="payment-detail-value">@context.Item.Branch</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Loaiphieu"]</div>
                            <div class="payment-detail-value">@context.Item.Loaiphieu</div>
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Quyenso"]</div>
                            <div class="payment-detail-value">@context.Item.Quyenso</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["status"]</div>
                            <div class="payment-detail-value">@context.Item.Trangthai</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["MBL"]</div>
                            <div class="payment-detail-value">@context.Item.Mbl</div>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <div class="payment-detail-label">@Localizer["Continued"]</div>
                            <div class="payment-detail-value">@context.Item.Continued</div>
                        </MudItem>
                    </MudGrid>
                </MudCard>
            </ChildRowContent>

            <PagerContent>
                <div class="payment-total-bar">
                    <div class="total-box">
                        Total VND:
                        <span style="color: #c2410c">
                            @(FilteredTotalAmount_VND?.ToString("#,##0.##") ?? "0")
                        </span>
                    </div>

                    <div class="total-box">
                        Total USD:
                        <span style="color: #c2410c">
                            @(FilteredTotalAmount_USD?.ToString("#,##0.##") ?? "0")
                        </span>
                    </div>

                    <MudDataGridPager T="M_PhieuChi" PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" />
                </div>
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    List<M_PhieuChi> Listdata = new List<M_PhieuChi>();
    private List<M_PhieuChi> filteredItems = new List<M_PhieuChi>();
    MudDataGrid<M_PhieuChi> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();

    private bool _resizeColumn;
    M_PhieuChi detail;
    private string _searchString;
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<M_Customer> List_Cus = new List<M_Customer>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    public decimal? FilteredTotalAmount_VND;
    public decimal? FilteredTotalAmount_USD;

    protected async override Task OnInitializedAsync()
    {
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuchi").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        List_Cus = await Cussv.GetList();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }

    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Phieuchi"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await thuchiSv.GetList_PhieuChi();
            filteredItems = Listdata;
            RecalculateTotals();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }
    private void OnSearchTextChanged(string newValue)
    {
        _searchString = newValue;

        if (string.IsNullOrWhiteSpace(newValue))
        {
            filteredItems = Listdata;
        }
        else
        {
            var keyword = newValue.Trim();

            var matchingCustomerIds = List_Cus
                .Where(cus => !string.IsNullOrEmpty(cus.COMPANY)
                           && cus.COMPANY.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                .Select(cus => cus.Customer_ID)
                .ToList();

            filteredItems = Listdata.Where(item =>
                matchingCustomerIds.Contains(item.Customer_ID.GetValueOrDefault()) ||
                (!string.IsNullOrEmpty(item.Sophieuchi) && item.Sophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.TKnophieuchi) && item.TKnophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.TKCophieuchi) && item.TKCophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Noidung) && item.Noidung.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Bank) && item.Bank.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Hbl) && item.Hbl.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Mbl) && item.Mbl.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Ref) && item.Ref.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.SoHoaDon) && item.SoHoaDon.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        RecalculateTotals();
        StateHasChanged();
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }


    private void RecalculateTotals()
    {
        filteredItems ??= new List<M_PhieuChi>();

        FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => string.Equals(item.Currency, "VND", StringComparison.OrdinalIgnoreCase))
            .Sum(item => item.Sotien ?? 0));

        FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
            .Where(item => string.Equals(item.Currency, "USD", StringComparison.OrdinalIgnoreCase))
            .Sum(item => item.Sotien ?? 0));
    }
    void RowClicked(DataGridRowClickEventArgs<M_PhieuChi> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_PhieuChi m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_PhieuChi item)
    {
        item.Useupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.PhieuchiID != Guid.Empty ? await thuchiSv.UpdatePhieuChi_Detail(item) : await thuchiSv.CreatePhieuChi_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_PhieuChi item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Phieuchi"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await thuchiSv.DeletePhieuChi_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete Phieu Chi", "Phieuchi", item.PhieuchiID, item.Sophieuchi, item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }
    }

    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;
    private bool FilterFunc1(M_PhieuChi item) => FilterFunc(item, _searchString);

    private bool FilterFunc(M_PhieuChi item, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var keyword = searchString.Trim();

        return (!string.IsNullOrEmpty(item.Sophieuchi) && item.Sophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.TKnophieuchi) && item.TKnophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.TKCophieuchi) && item.TKCophieuchi.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Noidung) && item.Noidung.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Bank) && item.Bank.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Hbl) && item.Hbl.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Mbl) && item.Mbl.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Ref) && item.Ref.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.SoHoaDon) && item.SoHoaDon.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || CustomerName(item.Customer_ID).Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

