@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_SI? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    Color ColorTextFields = Color.Primary;

    public sealed class SiDialogResult
    {
        public M_SI Model { get; init; } = default!;
        public bool IsEdit { get; init; }
    }

    private M_SI _m = new();
    private List<string> _attachmentNames = new();
    private List<string> _historyLines = new();

    protected override void OnParametersSet()
    {
        _m = Clone(Model);
        _attachmentNames = (_m.AttachmentRefs ?? new List<M_SI_AttachmentRef>()).Select(r => r.FileName).ToList();
        _historyLines = BuildAttachmentHistoryLines(_m.AttachmentHistoryJson);
    }

    private static List<string> BuildAttachmentHistoryLines(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new List<string>();
        try
        {
            var entries = JsonSerializer.Deserialize<List<SiAttachmentHistoryEntry>>(json) ?? new List<SiAttachmentHistoryEntry>();
            var lines = new List<string>(entries.Count);
            for (var i = entries.Count - 1; i >= 0; i--)
            {
                var e = entries[i];
                var names = e.FileNames is { Count: > 0 } ? string.Join(", ", e.FileNames) : "—";
                var actionLabel = e.Action switch
                {
                    "attach" => "Attach",
                    "remove_one" => "Remove",
                    "remove_all" => "Remove all",
                    _ => e.Action ?? "—"
                };
                if (!DateTime.TryParse(e.At, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var utc))
                    utc = DateTime.UtcNow;
                var local = utc.ToLocalTime();
                var when = local.ToString("yyyy-MM-dd HH:mm", CultureInfo.CurrentCulture);
                lines.Add($"{when} · {e.User ?? "—"} — {actionLabel}: {names}");
            }
            return lines;
        }
        catch
        {
            return new List<string>();
        }
    }

    private static M_SI Clone(M_SI? src)
    {
        if (src is null)
            return new M_SI { SIID = Guid.Empty };

        return new M_SI
        {
            SIID = src.SIID,
            mbl = src.mbl,
            shipper = src.shipper,
            consignee = src.consignee,
            notify1 = src.notify1,
            vessel = src.vessel,
            voy = src.voy,
            porname = src.porname,
            porcode = src.porcode,
            polname = src.polname,
            polcode = src.polcode,
            podname = src.podname,
            podcode = src.podcode,
            delName = src.delName,
            delcode = src.delcode,
            bkno = src.bkno,
            hbl = src.hbl,
            markAndNumbers = src.markAndNumbers,
            NoOfPackages = src.NoOfPackages,
            description = src.description,
            gross = src.gross,
            cbm = src.cbm,
            shipOnboard = src.shipOnboard,
            say = src.say,
            freightPayableAt = src.freightPayableAt,
            numberOfOriginal = src.numberOfOriginal,
            placeAndDate = src.placeAndDate,
            collectat = src.collectat,
            dateLaden = src.dateLaden,
            freightAmount = src.freightAmount,
            forDelivery = src.forDelivery,
            Air_type = src.Air_type,
            Usercreate = src.Usercreate,
            AttachmentRefs = src.AttachmentRefs?.Select(r => new M_SI_AttachmentRef { AttachmentId = r.AttachmentId, FileName = r.FileName }).ToList() ?? new List<M_SI_AttachmentRef>(),
            AttachmentHistoryJson = src.AttachmentHistoryJson
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(new SiDialogResult
        {
            Model = Clone(_m),
            IsEdit = IsEdit
        }));
    }
}
