    private enum DemDetKind { Dem, Det }

    private static DemDetKind? ClassifyDemDetCharge(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return null;
        var head = code.Trim();
        if (head.Length < 3)
            return null;
        head = head[..3];
        if (string.Equals(head, "DEM", StringComparison.OrdinalIgnoreCase))
            return DemDetKind.Dem;
        if (string.Equals(head, "DET", StringComparison.OrdinalIgnoreCase))
            return DemDetKind.Det;
        return null;
    }

    private static async Task<string?> GetJobLoaiByHblAsync(AppDbContext db, Guid hblId)
    {
        return await (
            from h in db.HBL.AsNoTracking()
            join m in db.MBL.AsNoTracking() on h.mblid equals m.MblID
            join j in db.Job.AsNoTracking() on m.Jobid equals j.JobID
            where h.hblID == hblId
            select j.Loai).FirstOrDefaultAsync();
    }

    /// <summary>
    /// SI: DEM = FullDelivery − FullDischarge − free; DET = EmptyReturn − FullDelivery − free.
    /// SE: DET = FullDischarge − EmptyPickup − free.
    /// </summary>
    private bool TryComputeBillableDaysByJobLoai(string? jobLoai, DemDetKind kind, out int billableDays, out string? error)
    {
        billableDays = 0;
        error = null;

        var loai = jobLoai?.Trim();
        if (string.IsNullOrEmpty(loai))
        {
            error = "Không lấy được Job.Loai từ HBL → MBL → Job.";
            return false;
        }

        DateTime? start;
        DateTime? end;
        string needMsg;

        if (string.Equals(loai, "SI", StringComparison.OrdinalIgnoreCase))
        {
            if (kind == DemDetKind.Dem)
            {
                start = _fullDischargeDate;
                end = _fullDeliveryDate;
                needMsg = "SI/DEM: nhập Full Discharge và Full Delivery (FullDelivery − FullDischarge − free).";
            }
            else
            {
                start = _fullDeliveryDate;
                end = _emptyReturnDate;
                needMsg = "SI/DET: nhập Full Delivery và Empty Return (EmptyReturn − FullDelivery − free).";
            }
        }
        else if (string.Equals(loai, "SE", StringComparison.OrdinalIgnoreCase))
        {
            if (kind != DemDetKind.Det)
            {
                error = "Job.Loai = SE chỉ hỗ trợ tự tính Billable days cho DET (FullDischarge − EmptyPickup − free).";
                return false;
            }

            start = _emptyPickupDate;
            end = _fullDischargeDate;
            needMsg = "SE/DET: nhập Empty Pickup và Full Discharge (FullDischarge − EmptyPickup − free).";
        }
        else
        {
            error = $"Job.Loai = '{loai}' chưa hỗ trợ tự tính Billable days (chỉ SI/SE). Vui lòng nhập Billable days thủ công.";
            return false;
        }

        if (!start.HasValue || !end.HasValue)
        {
            error = needMsg;
            return false;
        }

        var spanDays = (end.Value.Date - start.Value.Date).Days;
        if (spanDays < 0)
        {
            error = "Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.";
            return false;
        }

        var raw = spanDays - _freeDays;
        billableDays = raw < 0 ? 0 : raw;
        return true;
    }

    private async Task<decimal?> TinhTienAsync(Guid tariffHeaderId, int billableDays)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tier = await db.TariffTier
            .AsNoTracking()
            .Where(x => x.TariffHeaderId == tariffHeaderId
                        && x.FromDay <= billableDays
                        && (!x.ToDay.HasValue || x.ToDay.Value >= billableDays))
            .OrderBy(x => x.FromDay)
            .ThenBy(x => x.SequenceNo)
            .FirstOrDefaultAsync();

        if (tier is null)
            return null;

        return tier.Rate;
    }

    private async Task SaveAsync()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_hblItem is null || _hblItem.Id == Guid.Empty
            || _containerItem is null || _containerItem.Id == Guid.Empty)
        {
            Snackbar.Add(Localizer["Scc_Msg_SelectLinks"], MudBlazor.Severity.Warning);
            return;
        }

        if (_tariffHeaderItem is null || _tariffHeaderItem.Id == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn TariffCode.", MudBlazor.Severity.Warning);
            return;
        }

        if (_customerId == Guid.Empty)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == _hblItem.Id);
            _customerId = hbl?.CustomerID ?? Guid.Empty;
        }

        if (_customerId == Guid.Empty)
        {
            Snackbar.Add("HBL chưa có Customer.", MudBlazor.Severity.Warning);
            return;
        }

        var entity = Model ?? new M_ShipmentChargeContext { Id = Guid.Empty };
        entity.ShipmentId = _hblItem.Id;
        entity.ContainerId = _containerItem.Id;
        entity.CustomerId = _customerId;
        entity.CurrencyCode = string.IsNullOrWhiteSpace(_currencyCode) ? null : _currencyCode.Trim();
        entity.FreeDays = _freeDays;
        entity.BillableDays = _billableDays;
        entity.EmptyPickupDate = _emptyPickupDate;
        entity.FullDischargeDate = _fullDischargeDate;
        entity.FullDeliveryDate = _fullDeliveryDate;
        entity.EmptyReturnDate = _emptyReturnDate;
        entity.StorageInDate = _storageInDate;
        entity.StorageOutDate = _storageOutDate;
        entity.Remarks = string.IsNullOrWhiteSpace(_remarks) ? null : _remarks.Trim();
        entity.Amount = _amount;
        entity.tariffcode_id = _tariffHeaderItem is not null && _tariffHeaderItem.Id != Guid.Empty
            ? _tariffHeaderItem.Id
            : null;

        MudDialog.Close(DialogResult.Ok(new ShipmentChargeContextDialogResult { IsEdit = IsEdit, Entity = entity }));
    }

    private async Task<IEnumerable<LookupItem>> SearchHblAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.HBL.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.hbl != null && x.hbl.Contains(v)) ||
                (x.bkno != null && x.bkno.Contains(v)));
        }

        var list = await q.OrderBy(x => x.hbl).ThenBy(x => x.bkno).Take(ComboResultLimit).ToListAsync();
        var result = list.Select(x => new LookupItem { Id = x.hblID, Display = HblDisplay(x) }).ToList();
        if (_hblItem is not null && _hblItem.Id != Guid.Empty && !result.Exists(x => x.Id == _hblItem.Id))
            result.Insert(0, _hblItem);
        return result;
    }

    private async Task<IEnumerable<LookupItem>> SearchContextCustomersAsync(string value)
    {
        if (_contextCustomerItem is not null)
            return new[] { _contextCustomerItem };

        if (_customerId == Guid.Empty)
            return Array.Empty<LookupItem>();

        await using var db = await DbFactory.CreateDbContextAsync();
        await SetContextCustomerAsync(db, _customerId);
        return _contextCustomerItem is null
            ? Array.Empty<LookupItem>()
            : new[] { _contextCustomerItem };
    }

    private async Task<IEnumerable<LookupItem>> SearchContainersAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var v = string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        var baseQuery =
            from c in db.Container.AsNoTracking()
            join h in db.HBL.AsNoTracking() on c.hblid equals h.hblID into hg
            from h in hg.DefaultIfEmpty()
            where c.hblid != null && c.hblid != Guid.Empty
            select new { c, h };

        var showHblInList = _hblItem is null || _hblItem.Id == Guid.Empty;

        if (_hblItem is not null && _hblItem.Id != Guid.Empty)
        {
            var hblId = _hblItem.Id;
            baseQuery = baseQuery.Where(x => x.c.hblid == hblId);
            if (v is not null)
                baseQuery = baseQuery.Where(x => x.c.CONTAINER_NO != null && x.c.CONTAINER_NO.Contains(v));
        }
        else if (v is not null)
        {
            baseQuery = baseQuery.Where(x =>
                (x.c.CONTAINER_NO != null && x.c.CONTAINER_NO.Contains(v)) ||
                (x.h != null && x.h.hbl != null && x.h.hbl.Contains(v)) ||
                (x.h != null && x.h.bkno != null && x.h.bkno.Contains(v)));
        }

        var rows = await baseQuery.OrderBy(x => x.c.CONTAINER_NO).Take(ComboResultLimit).ToListAsync();
        var result = rows
            .Select(x => new LookupItem
            {
                Id = x.c.CTN_ID,
                Display = ContainerLookupDisplay(x.c, x.h, showHblInList)
            })
            .ToList();

        if (_containerItem is not null && _containerItem.Id != Guid.Empty && !result.Exists(x => x.Id == _containerItem.Id))
        {
            var keep = await (
                from c in db.Container.AsNoTracking()
                join h in db.HBL.AsNoTracking() on c.hblid equals h.hblID into hg
                from h in hg.DefaultIfEmpty()
                where c.CTN_ID == _containerItem.Id
                select new { c, h }).FirstOrDefaultAsync();

            if (keep is not null
                && (_hblItem is null || _hblItem.Id == Guid.Empty || keep.c.hblid == _hblItem.Id))
            {
                result.Insert(0, new LookupItem
                {
                    Id = keep.c.CTN_ID,
                    Display = ContainerLookupDisplay(keep.c, keep.h, showHblInList)
                });
            }
        }

        return result;
    }

    private async Task<IEnumerable<LookupItem>> SearchTariffHeadersAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.TariffHeader.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x => x.TariffCode != null && x.TariffCode.Contains(v));
        }

        var list = await q.OrderBy(x => x.TariffCode).Take(ComboResultLimit).ToListAsync();
        var result = list.Select(x => new LookupItem { Id = x.Id, Display = TariffHeaderDisplay(x) }).ToList();
        if (_tariffHeaderItem is not null && _tariffHeaderItem.Id != Guid.Empty &&
            !result.Exists(x => x.Id == _tariffHeaderItem.Id))
        {
            var keep = await db.TariffHeader.AsNoTracking().FirstOrDefaultAsync(x => x.Id == _tariffHeaderItem.Id);
            if (keep != null)
                result.Insert(0, new LookupItem { Id = keep.Id, Display = TariffHeaderDisplay(keep) });
        }

        return result;
    }
