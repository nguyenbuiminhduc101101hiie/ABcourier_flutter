    {
        return value.ToString("N2", CultureInfo.InvariantCulture);
    }

    private static string FormatBool(bool? value)
    {
        return value == true ? "Yes" : string.Empty;
    }

    private static Color GetRowColor(string rowType)
    {
        return rowType == "DEBIT" ? Color.Success : Color.Warning;
    }

