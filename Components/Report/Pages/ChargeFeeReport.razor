@page "/reports/charge-fee-report"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using OfficeOpenXml
@using System.Net
@using System.Text
@using System.Globalization

@inject IJSRuntime JS
@inject AppDbContext _context

<MudPaper Class="pa-4" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Báo cáo chi tiết theo tên phí</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Chọn tên phí hoặc mã phí để tìm toàn bộ Debit/Credit theo HBL.
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudTooltip Text="Bật/tắt bộ lọc trên đầu mỗi cột">
                <MudToggleIconButton @bind-Toggled="ShowFilters"
                                     Icon="@Icons.Material.Filled.FilterAlt"
                                     ToggledIcon="@Icons.Material.Filled.FilterAltOff"
                                     Color="Color.Default"
                                     ToggledColor="Color.Primary" />
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.FilterListOff"
                       Disabled="@(!HasActiveFilters)" OnClick="ClearAllFilters">
                Xóa filter
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(!FilteredRows.Any())" OnClick="PrintReport">
                In
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(!FilteredRows.Any())" OnClick="ExportExcel">
                Xuất Excel
            </MudButton>
        </MudStack>
    </MudStack>

    <MudGrid Class="mb-3">
        <MudItem xs="12" md="6" lg="5">
            <MudAutocomplete T="Guid"
                             @bind-Value="SelectedChargeId"
                             Label="Tên phí / mã phí"
                             Placeholder="VD: THC, LOCAL CHARGE, DOC FEE..."
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             SearchFunc="SearchCharge"
                             ToStringFunc="Charidtocharge"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             MaxItems="50"
                             Dense="true" />
        </MudItem>
        <MudItem xs="12" md="6" lg="7">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                           Disabled="@Loading" OnClick="SearchAsync">
                    Tìm
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@Loading" OnClick="ClearAsync">
                    Xóa lọc
                </MudButton>
                <MudCheckBox T="bool" @bind-Value="IsAgentOnly"
                             Color="Color.Primary" Dense="true"
                             Label="Đại Lý/Agent" />
                @if (Loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
                }
            </MudStack>
        </MudItem>
    </MudGrid>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <MudAlert Severity="@MessageSeverity" Dense="true" Class="mb-3">@Message</MudAlert>
    }

    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Số dòng @(HasActiveFilters ? $"(lọc / tổng {Rows.Count:N0})" : string.Empty)
                </MudText>
                <MudText Typo="Typo.h6">@FilteredRows.Count.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng Debit (sau thuế)</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalDebit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng Credit (sau thuế)</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalCredit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" lg="3">
            <MudPaper Class="pa-3" Outlined="true" Style="border-left: 3px solid #4caf50;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng VND — Debit</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalVndDebit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" lg="3">
            <MudPaper Class="pa-3" Outlined="true" Style="border-left: 3px solid #ff9800;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng VND — Credit</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalVndCredit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" lg="3">
            <MudPaper Class="pa-3" Outlined="true" Style="border-left: 3px solid #2196f3;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng USD — Debit</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalUsdDebit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" lg="3">
            <MudPaper Class="pa-3" Outlined="true" Style="border-left: 3px solid #9c27b0;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng USD — Credit</MudText>
                <MudText Typo="Typo.h6">@FormatNumber(TotalUsdCredit)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div id="charge-fee-report-print-area">
        <div class="print-header">
            <h2>BÁO CÁO CHI TIẾT THEO TÊN PHÍ</h2>
            <div><b>Từ khóa:</b> @(SelectedChargeId == Guid.Empty ? "Tất cả" : Charidtocharge(SelectedChargeId))</div>
            <div><b>Ngày in:</b> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
            <div>
                <b>Số dòng:</b> @FilteredRows.Count.ToString("N0")
                | <b>VND Debit:</b> @FormatNumber(TotalVndDebit)
                | <b>VND Credit:</b> @FormatNumber(TotalVndCredit)
                | <b>USD Debit:</b> @FormatNumber(TotalUsdDebit)
                | <b>USD Credit:</b> @FormatNumber(TotalUsdCredit)
            </div>
        </div>

        <MudTable Items="FilteredRows" Dense="true" Hover="true" Bordered="true" Striped="true" FixedHeader="true"
                  Height="calc(100vh - 395px)" Class="charge-report-table">
            <HeaderContent>
                @RenderHeader("Loại", nameof(ChargeReportRow.RowType))
                @RenderHeader("Mã phí", nameof(ChargeReportRow.ChargeCode))
                @RenderHeader("Tên phí", nameof(ChargeReportRow.ChargeName))
                @RenderHeader("HBL", nameof(ChargeReportRow.HblNo))
                @RenderHeader("BK No", nameof(ChargeReportRow.BkNo))
                @RenderHeader("Shipper", nameof(ChargeReportRow.Shipper))
                @RenderHeader("Consignee", nameof(ChargeReportRow.Consignee))
                @RenderHeader("POL", nameof(ChargeReportRow.Pol))
                @RenderHeader("POD", nameof(ChargeReportRow.Pod))
                @RenderHeader("DEL", nameof(ChargeReportRow.Del))
                @RenderHeader("Đơn giá", nameof(ChargeReportRow.UnitPrice), Align.Right)
                @RenderHeader("SL", nameof(ChargeReportRow.Quantity), Align.Right)
                @RenderHeader("Tiền tệ", nameof(ChargeReportRow.Currency))
                @RenderHeader("Thành tiền", nameof(ChargeReportRow.Amount), Align.Right)
                @RenderHeader("Thuế", nameof(ChargeReportRow.Tax), Align.Right)
                @RenderHeader("Sau thuế", nameof(ChargeReportRow.AmountAfterTax), Align.Right)
                @RenderHeader("Total VND", "TotalVnd", Align.Right)
                @RenderHeader("Total USD", "TotalUsd", Align.Right)
                @RenderHeader("Thu/Chi hộ", nameof(ChargeReportRow.ThuChiHo))
                @RenderHeader("Debit/DNTT", nameof(ChargeReportRow.DocumentNo))
                @RenderHeader("Invoice", nameof(ChargeReportRow.InvoiceNo))
                @RenderHeader("Ghi chú", nameof(ChargeReportRow.Note))
                @RenderHeader("User update", nameof(ChargeReportRow.UserUpdate))
                @RenderHeader("Date update", nameof(ChargeReportRow.DateUpdate))
                @RenderHeader("Vessel", nameof(ChargeReportRow.Vessel))
                @RenderHeader("Voy", nameof(ChargeReportRow.Voy))
                @RenderHeader("DVT", nameof(ChargeReportRow.Dvt))
                @RenderHeader("Type", nameof(ChargeReportRow.Type))
                @RenderHeader("Nhóm", nameof(ChargeReportRow.Group))
                @RenderHeader("Tỷ giá", nameof(ChargeReportRow.ExchangeRate), Align.Right)
                @RenderHeader("Tỷ giá HĐ", nameof(ChargeReportRow.InvoiceRate), Align.Right)
                @RenderHeader("TK bán", nameof(ChargeReportRow.AccountSelling))
                @RenderHeader("TK mua", nameof(ChargeReportRow.AccountBuying))
                @RenderHeader("Approve", nameof(ChargeReportRow.Approve))
                @RenderHeader("Continued", nameof(ChargeReportRow.Continued))
                @RenderHeader("Editable", nameof(ChargeReportRow.Editable))
                @RenderHeader("Khóa", nameof(ChargeReportRow.Locked))
                @RenderHeader("Đã in", nameof(ChargeReportRow.Printed))
                @RenderHeader("Đã xuất HĐ", nameof(ChargeReportRow.IssuedInvoice))
                @RenderHeader("DNTT", nameof(ChargeReportRow.DNTT))
                @RenderHeader("DNTU", nameof(ChargeReportRow.DNTU))
                @RenderHeader("SourceId", nameof(ChargeReportRow.SourceId))
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Loại">
                    <MudChip T="string" Size="Size.Small" Color="@GetRowColor(context.RowType)" Variant="Variant.Filled">
                        @context.RowType
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Mã phí">@context.ChargeCode</MudTd>
                <MudTd DataLabel="Tên phí">@context.ChargeName</MudTd>
                <MudTd DataLabel="HBL">@context.HblNo</MudTd>
                <MudTd DataLabel="BK No">@context.BkNo</MudTd>
                <MudTd DataLabel="Shipper">@context.Shipper</MudTd>
                <MudTd DataLabel="Consignee">@context.Consignee</MudTd>
                <MudTd DataLabel="POL">@context.Pol</MudTd>
                <MudTd DataLabel="POD">@context.Pod</MudTd>
                <MudTd DataLabel="DEL">@context.Del</MudTd>
                <MudTd DataLabel="Đơn giá" Align="Align.Right">@FormatNumber(context.UnitPrice)</MudTd>
                <MudTd DataLabel="SL" Align="Align.Right">@FormatNumber(context.Quantity)</MudTd>
                <MudTd DataLabel="Tiền tệ">@context.Currency</MudTd>
                <MudTd DataLabel="Thành tiền" Align="Align.Right">@FormatNumber(context.Amount)</MudTd>
                <MudTd DataLabel="Thuế" Align="Align.Right">@FormatNumber(context.Tax)</MudTd>
                <MudTd DataLabel="Sau thuế" Align="Align.Right">@FormatNumber(context.AmountAfterTax)</MudTd>
                <MudTd DataLabel="Total VND" Align="Align.Right" Class="col-total-vnd">@FormatNumber(ComputeTotalVnd(context))</MudTd>
                <MudTd DataLabel="Total USD" Align="Align.Right" Class="col-total-usd">@FormatNumber(ComputeTotalUsd(context))</MudTd>
                <MudTd DataLabel="Thu/Chi hộ">@context.ThuChiHo</MudTd>
                <MudTd DataLabel="Debit/DNTT">@context.DocumentNo</MudTd>
                <MudTd DataLabel="Invoice">@context.InvoiceNo</MudTd>
                <MudTd DataLabel="Ghi chú">@context.Note</MudTd>
                <MudTd DataLabel="User update">@context.UserUpdate</MudTd>
                <MudTd DataLabel="Date update">@context.DateUpdate</MudTd>
                <MudTd DataLabel="Vessel">@context.Vessel</MudTd>
                <MudTd DataLabel="Voy">@context.Voy</MudTd>
                <MudTd DataLabel="DVT">@context.Dvt</MudTd>
                <MudTd DataLabel="Type">@context.Type</MudTd>
                <MudTd DataLabel="Nhóm">@context.Group</MudTd>
                <MudTd DataLabel="Tỷ giá" Align="Align.Right">@FormatNumber(context.ExchangeRate)</MudTd>
                <MudTd DataLabel="Tỷ giá HĐ" Align="Align.Right">@FormatNumber(context.InvoiceRate)</MudTd>
                <MudTd DataLabel="TK bán">@context.AccountSelling</MudTd>
                <MudTd DataLabel="TK mua">@context.AccountBuying</MudTd>
                <MudTd DataLabel="Approve">@FormatBool(context.Approve)</MudTd>
                <MudTd DataLabel="Continued">@FormatBool(context.Continued)</MudTd>
                <MudTd DataLabel="Editable">@FormatBool(context.Editable)</MudTd>
                <MudTd DataLabel="Khóa">@FormatBool(context.Locked)</MudTd>
                <MudTd DataLabel="Đã in">@FormatBool(context.Printed)</MudTd>
                <MudTd DataLabel="Đã xuất HĐ">@FormatBool(context.IssuedInvoice)</MudTd>
                <MudTd DataLabel="DNTT">@FormatBool(context.DNTT)</MudTd>
                <MudTd DataLabel="DNTU">@FormatBool(context.DNTU)</MudTd>
                <MudTd DataLabel="SourceId">@context.SourceId</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">
                    @(Rows.Any() ? "Không có dòng nào khớp bộ lọc." : "Chưa có dữ liệu. Nhập tên phí rồi bấm Tìm.")
                </MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@_pageSizeOptions" />
            </PagerContent>
        </MudTable>

        <table class="full-export-table">
            <thead>
                <tr>
                    <th>Loại</th><th>Mã phí</th><th>Tên phí</th><th>HBL</th><th>BK No</th>
                    <th>Shipper</th><th>Consignee</th><th>Vessel</th><th>Voy</th>
                    <th>POL</th><th>POD</th><th>DEL</th><th>DVT</th>
                    <th>Đơn giá</th><th>SL</th><th>Tiền tệ</th><th>Thành tiền</th><th>Thuế</th><th>Sau thuế</th>
                    <th>Total VND</th><th>Total USD</th>
                    <th>Tỷ giá</th><th>Tỷ giá HĐ</th><th>Thu/Chi hộ</th><th>Debit/DNTT</th><th>Invoice</th>
                    <th>Type</th><th>Nhóm</th><th>Ghi chú</th><th>User update</th><th>Date update</th>
                    <th>TK bán</th><th>TK mua</th><th>Approve</th><th>Continued</th><th>Editable</th>
                    <th>Khóa</th><th>Đã in</th><th>Đã xuất HĐ</th><th>DNTT</th><th>DNTU</th>
                    <th>SourceId</th><th>HblId</th><th>MblId</th><th>CustomerId</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in FilteredRows)
                {
                    <tr>
                        <td>@row.RowType</td><td>@row.ChargeCode</td><td>@row.ChargeName</td><td>@row.HblNo</td><td>@row.BkNo</td>
                        <td>@row.Shipper</td><td>@row.Consignee</td><td>@row.Vessel</td><td>@row.Voy</td>
                        <td>@row.Pol</td><td>@row.Pod</td><td>@row.Del</td><td>@row.Dvt</td>
                        <td class="num">@FormatNumber(row.UnitPrice)</td><td class="num">@FormatNumber(row.Quantity)</td><td>@row.Currency</td>
                        <td class="num">@FormatNumber(row.Amount)</td><td class="num">@FormatNumber(row.Tax)</td><td class="num">@FormatNumber(row.AmountAfterTax)</td>
                        <td class="num">@FormatNumber(ComputeTotalVnd(row))</td><td class="num">@FormatNumber(ComputeTotalUsd(row))</td>
                        <td class="num">@FormatNumber(row.ExchangeRate)</td><td class="num">@FormatNumber(row.InvoiceRate)</td>
                        <td>@row.ThuChiHo</td><td>@row.DocumentNo</td><td>@row.InvoiceNo</td>
                        <td>@row.Type</td><td>@row.Group</td><td>@row.Note</td><td>@row.UserUpdate</td><td>@row.DateUpdate</td>
                        <td>@row.AccountSelling</td><td>@row.AccountBuying</td><td>@FormatBool(row.Approve)</td><td>@FormatBool(row.Continued)</td><td>@FormatBool(row.Editable)</td>
                        <td>@FormatBool(row.Locked)</td><td>@FormatBool(row.Printed)</td><td>@FormatBool(row.IssuedInvoice)</td><td>@FormatBool(row.DNTT)</td><td>@FormatBool(row.DNTU)</td>
                        <td>@row.SourceId</td><td>@row.HblId</td><td>@row.MblId</td><td>@row.CustomerId</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</MudPaper>

<style>
    .print-header {
        display: none;
    }

    .charge-report-table td,
    .charge-report-table th {
        white-space: nowrap;
        vertical-align: top;
    }

    .charge-report-table .th-label {
        font-weight: 600;
        display: block;
    }

    .charge-report-table .th-filter {
        margin-top: 4px;
    }

    .charge-report-table .th-filter .mud-input-slot,
    .charge-report-table .th-filter .mud-input {
        font-size: 11px;
    }

    .charge-report-table .th-filter .mud-input-control {
        min-width: 80px;
    }

    .charge-report-table .col-total-vnd {
        background-color: rgba(76, 175, 80, 0.06);
        font-weight: 600;
    }

    .charge-report-table .col-total-usd {
        background-color: rgba(33, 150, 243, 0.06);
        font-weight: 600;
    }

    .full-export-table {
        display: none;
        border-collapse: collapse;
        width: 100%;
        font-size: 10px;
    }

    .full-export-table th,
    .full-export-table td {
        border: 1px solid #999;
        padding: 4px 6px;
        white-space: nowrap;
    }

    .full-export-table th {
        background: #eee;
    }

    .full-export-table .num {
        text-align: right;
    }

    @@media print {
        body * {
            visibility: hidden;
        }

        #charge-fee-report-print-area,
        #charge-fee-report-print-area * {
            visibility: visible;
        }

        #charge-fee-report-print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .print-header {
            display: block;
            margin-bottom: 12px;
        }

        .mud-table-pagination,
        .mud-table-toolbar,
        .charge-report-table {
            display: none !important;
        }

        .full-export-table {
            display: table !important;
        }
    }
</style>

@code {
    private readonly int[] _pageSizeOptions = { 25, 50, 100, 300, 500 };

    private Guid SelectedChargeId { get; set; }
    private List<ChargeModel> Charges { get; set; } = new();
    private bool Loading { get; set; }
    private string? Message { get; set; }
    private MudBlazor.Severity MessageSeverity { get; set; } = MudBlazor.Severity.Info;

    private bool ShowFilters { get; set; }
    private bool IsAgentOnly { get; set; }

    private readonly Dictionary<string, string?> ColumnFilters = new();

    private List<ChargeReportRow> Rows { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Charges = await _context.Set<ChargeModel>()
            .AsNoTracking()
            .OrderBy(c => c.CHARGE_CODE)
            .ThenBy(c => c.CHARGE)
            .ToListAsync();
    }

    private Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        IEnumerable<Guid> result;
        if (string.IsNullOrWhiteSpace(text))
        {
            result = Charges.Select(x => x.CHARGE_ID).Take(50);
        }
        else
        {
            result = Charges
                .Where(x =>
                    (x.CHARGE_CODE ?? string.Empty).Contains(text, StringComparison.OrdinalIgnoreCase)
                    || (x.CHARGE ?? string.Empty).Contains(text, StringComparison.OrdinalIgnoreCase)
                    || $"{x.CHARGE_CODE}_{x.CHARGE}".Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.CHARGE_ID)
                .Take(50);
        }

        return Task.FromResult(result);
    }

    private string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;

        var rs = Charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}";
    }

    private List<ChargeReportRow> FilteredRows => Rows.Where(PassesAllFilters).ToList();

    private bool HasActiveFilters => ColumnFilters.Values.Any(v => !string.IsNullOrWhiteSpace(v));

    private double TotalDebit => FilteredRows.Where(x => x.RowType == "DEBIT").Sum(x => x.AmountAfterTax ?? x.Amount ?? 0);
    private double TotalCredit => FilteredRows.Where(x => x.RowType == "CREDIT").Sum(x => x.AmountAfterTax ?? x.Amount ?? 0);

    private double TotalVndDebit => FilteredRows.Where(x => x.RowType == "DEBIT").Sum(ComputeTotalVnd);
    private double TotalVndCredit => FilteredRows.Where(x => x.RowType == "CREDIT").Sum(ComputeTotalVnd);
    private double TotalUsdDebit => FilteredRows.Where(x => x.RowType == "DEBIT").Sum(ComputeTotalUsd);
    private double TotalUsdCredit => FilteredRows.Where(x => x.RowType == "CREDIT").Sum(ComputeTotalUsd);

    private RenderFragment RenderHeader(string label, string key, Align align = Align.Left) => builder =>
    {
        builder.OpenComponent<MudTh>(0);
        if (align == Align.Right)
        {
            // MudTh has no built-in Align property, so we style via CSS
        }
        builder.AddAttribute(1, "ChildContent", (RenderFragment)(inner =>
        {
            inner.OpenElement(0, "div");
            inner.AddAttribute(1, "class", align == Align.Right ? "th-label text-right" : "th-label");
            inner.AddAttribute(2, "style", align == Align.Right ? "text-align:right;" : null);
            inner.AddContent(3, label);
            inner.CloseElement();

            if (ShowFilters)
            {
                inner.OpenComponent<MudTextField<string>>(10);
                inner.AddAttribute(11, "Value", GetFilter(key));
                inner.AddAttribute(12, "ValueChanged",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create<string>(this, v => SetFilter(key, v)));
                inner.AddAttribute(13, "Placeholder", "Lọc...");
                inner.AddAttribute(14, "Margin", Margin.Dense);
                inner.AddAttribute(15, "Variant", Variant.Outlined);
                inner.AddAttribute(16, "Immediate", true);
                inner.AddAttribute(17, "DebounceInterval", 250.0);
                inner.AddAttribute(18, "Clearable", true);
                inner.AddAttribute(19, "Class", "th-filter");
                inner.CloseComponent();
            }
        }));
        builder.CloseComponent();
    };

    private string? GetFilter(string key)
    {
        return ColumnFilters.TryGetValue(key, out var v) ? v : null;
    }

    private void SetFilter(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            ColumnFilters.Remove(key);
        else
            ColumnFilters[key] = value.Trim();
    }

    private void ClearAllFilters()
    {
        ColumnFilters.Clear();
    }

    private bool PassesAllFilters(ChargeReportRow row)
    {
        foreach (var kv in ColumnFilters)
        {
            var filter = kv.Value;
            if (string.IsNullOrWhiteSpace(filter))
                continue;

            var cell = GetCellText(row, kv.Key);
            if (cell == null || cell.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0)
                return false;
        }
        return true;
    }

    private string GetCellText(ChargeReportRow r, string key)
    {
        return key switch
        {
            nameof(ChargeReportRow.RowType) => r.RowType ?? string.Empty,
            nameof(ChargeReportRow.ChargeCode) => r.ChargeCode ?? string.Empty,
            nameof(ChargeReportRow.ChargeName) => r.ChargeName ?? string.Empty,
            nameof(ChargeReportRow.HblNo) => r.HblNo ?? string.Empty,
            nameof(ChargeReportRow.BkNo) => r.BkNo ?? string.Empty,
            nameof(ChargeReportRow.Shipper) => r.Shipper ?? string.Empty,
            nameof(ChargeReportRow.Consignee) => r.Consignee ?? string.Empty,
            nameof(ChargeReportRow.Pol) => r.Pol ?? string.Empty,
            nameof(ChargeReportRow.Pod) => r.Pod ?? string.Empty,
            nameof(ChargeReportRow.Del) => r.Del ?? string.Empty,
            nameof(ChargeReportRow.UnitPrice) => FormatNumber(r.UnitPrice),
            nameof(ChargeReportRow.Quantity) => FormatNumber(r.Quantity),
            nameof(ChargeReportRow.Currency) => r.Currency ?? string.Empty,
            nameof(ChargeReportRow.Amount) => FormatNumber(r.Amount),
            nameof(ChargeReportRow.Tax) => FormatNumber(r.Tax),
            nameof(ChargeReportRow.AmountAfterTax) => FormatNumber(r.AmountAfterTax),
            "TotalVnd" => FormatNumber(ComputeTotalVnd(r)),
            "TotalUsd" => FormatNumber(ComputeTotalUsd(r)),
            nameof(ChargeReportRow.ThuChiHo) => r.ThuChiHo ?? string.Empty,
            nameof(ChargeReportRow.DocumentNo) => r.DocumentNo ?? string.Empty,
            nameof(ChargeReportRow.InvoiceNo) => r.InvoiceNo ?? string.Empty,
            nameof(ChargeReportRow.Note) => r.Note ?? string.Empty,
            nameof(ChargeReportRow.UserUpdate) => r.UserUpdate ?? string.Empty,
            nameof(ChargeReportRow.DateUpdate) => r.DateUpdate ?? string.Empty,
            nameof(ChargeReportRow.Vessel) => r.Vessel ?? string.Empty,
            nameof(ChargeReportRow.Voy) => r.Voy ?? string.Empty,
            nameof(ChargeReportRow.Dvt) => r.Dvt ?? string.Empty,
            nameof(ChargeReportRow.Type) => r.Type ?? string.Empty,
            nameof(ChargeReportRow.Group) => r.Group ?? string.Empty,
            nameof(ChargeReportRow.ExchangeRate) => FormatNumber(r.ExchangeRate),
            nameof(ChargeReportRow.InvoiceRate) => FormatNumber(r.InvoiceRate),
            nameof(ChargeReportRow.AccountSelling) => r.AccountSelling ?? string.Empty,
            nameof(ChargeReportRow.AccountBuying) => r.AccountBuying ?? string.Empty,
            nameof(ChargeReportRow.Approve) => FormatBool(r.Approve),
            nameof(ChargeReportRow.Continued) => FormatBool(r.Continued),
            nameof(ChargeReportRow.Editable) => FormatBool(r.Editable),
            nameof(ChargeReportRow.Locked) => FormatBool(r.Locked),
            nameof(ChargeReportRow.Printed) => FormatBool(r.Printed),
            nameof(ChargeReportRow.IssuedInvoice) => FormatBool(r.IssuedInvoice),
            nameof(ChargeReportRow.DNTT) => FormatBool(r.DNTT),
