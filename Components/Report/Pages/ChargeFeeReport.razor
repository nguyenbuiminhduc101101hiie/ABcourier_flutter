            nameof(ChargeReportRow.SourceId) => r.SourceId.ToString(),
            _ => string.Empty
        };
    }

    private double ComputeTotalVnd(ChargeReportRow r)
    {
        var amount = r.AmountAfterTax ?? r.Amount ?? 0;
        if (amount == 0) return 0;

        var currency = (r.Currency ?? "VND").Trim().ToUpperInvariant();
        var rate = r.ExchangeRate ?? 0;

        if (currency == "VND")
            return amount;

        // Với các loại tiền khác (USD, ...) dùng tỷ giá của chính dòng đó (tigiadebit/tigiacredit)
        return rate > 0 ? amount * rate : 0;
    }

    private double ComputeTotalUsd(ChargeReportRow r)
    {
        var amount = r.AmountAfterTax ?? r.Amount ?? 0;
        if (amount == 0) return 0;

        var currency = (r.Currency ?? "VND").Trim().ToUpperInvariant();
        var rate = r.ExchangeRate ?? 0;

        if (currency == "USD")
            return amount;

        // Nếu dòng ở loại tiền khác (VND, ...) quy đổi qua USD dựa trên tỷ giá của dòng đó.
        if (rate <= 0)
            return 0;

        if (currency == "VND")
            return amount / rate;

        // Loại tiền khác USD/VND: không đủ thông tin để quy đổi ra USD từ tỷ giá của dòng.
        return 0;
    }

    private async Task ClearAsync()
    {
        SelectedChargeId = Guid.Empty;
        Rows.Clear();
        ColumnFilters.Clear();
        Message = null;
        await Task.CompletedTask;
    }

    private async Task SearchAsync()
    {
        Loading = true;
        Message = null;

        try
        {
            if (SelectedChargeId == Guid.Empty)
            {
                Rows = new();
                MessageSeverity = MudBlazor.Severity.Warning;
                Message = "Chọn tên phí hoặc mã phí trước khi tìm.";
                return;
            }

            var chargeQuery = BuildMatchingChargeQuery(SelectedChargeId);

            var charges = await chargeQuery
                .Select(c => new ChargeInfo
                {
                    ChargeId = c.CHARGE_ID,
                    ChargeCode = c.CHARGE_CODE,
                    ChargeName = c.CHARGE,
                    Dvt = c.DVT,
                    Unit = c.unit,
                    AccountSelling = c.accselling,
                    AccountBuying = c.accbuying
                })
                .ToListAsync();

            if (!charges.Any())
            {
                Rows = new();
                MessageSeverity = MudBlazor.Severity.Warning;
                Message = "Không tìm thấy mã phí/tên phí trong ChargeModel.";
                return;
            }

            var chargeMap = charges.ToDictionary(x => x.ChargeId, x => x);
            var chargeIdQuery = chargeQuery.Select(c => c.CHARGE_ID);

            IQueryable<Guid>? agentCustomerIds = null;
            if (IsAgentOnly)
            {
                agentCustomerIds = _context.Set<M_Customer>()
                    .AsNoTracking()
                    .Where(x => x.MainCode != null && x.MainCode.Contains("Agent-Network"))
                    .Select(x => x.Customer_ID);
            }

            var debitRows = await LoadDebitRows(chargeIdQuery, agentCustomerIds);
            var creditRows = await LoadCreditRows(chargeIdQuery, agentCustomerIds);

            var allRows = debitRows.Concat(creditRows).ToList();
            foreach (var row in allRows)
            {
                if (chargeMap.TryGetValue(row.ChargeId, out var charge))
                {
                    row.ChargeCode = charge.ChargeCode;
                    row.ChargeName = charge.ChargeName;
                    row.Dvt = charge.Dvt ?? charge.Unit;
                    row.AccountSelling = charge.AccountSelling;
                    row.AccountBuying = charge.AccountBuying;
                }
            }

            Rows = allRows
                .OrderBy(x => x.ChargeName)
                .ThenBy(x => x.HblNo)
                .ThenBy(x => x.RowType)
                .ToList();

            MessageSeverity = Rows.Any() ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning;
            Message = Rows.Any()
                ? $"Tìm thấy {Rows.Count:N0} dòng chi tiết theo phí."
                : "Có mã phí trong ChargeModel nhưng chưa phát sinh Debit/Credit.";
        }
        catch (Exception ex)
        {
            Rows = new();
            MessageSeverity = MudBlazor.Severity.Error;
            Message = $"Lỗi load dữ liệu: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private IQueryable<ChargeModel> BuildMatchingChargeQuery(Guid chargeId)
    {
        return _context.Set<ChargeModel>()
            .AsNoTracking()
            .Where(c => c.CHARGE_ID == chargeId);
    }

    private async Task<List<ChargeReportRow>> LoadDebitRows(IQueryable<Guid> chargeIdQuery, IQueryable<Guid>? agentCustomerIds)
    {
        return await (
            from d in _context.Set<M_Debit>().AsNoTracking()
            join h in _context.Set<M_HBL>().AsNoTracking()
                on d.hblid equals h.hblID into hj
            from h in hj.DefaultIfEmpty()
            where chargeIdQuery.Contains(d.itemid)
                && (agentCustomerIds == null || agentCustomerIds.Contains(d.customerid))
            select new ChargeReportRow
            {
                RowType = "DEBIT",
                SourceId = d.debitId,
                ChargeId = d.itemid,
                HblId = d.hblid,
                MblId = d.mblid,
                CustomerId = d.customerid,
                DocumentNo = d.debitno,
                HblNo = h == null ? null : h.hbl,
                BkNo = h == null ? null : h.bkno,
                Shipper = h == null ? null : h.shipper,
                Consignee = h == null ? null : h.consignee,
                Vessel = h == null ? null : h.vessel,
                Voy = h == null ? null : h.voy,
                Pol = d.pol ?? (h == null ? null : (h.polname ?? h.polcode)),
                Pod = d.pod ?? (h == null ? null : (h.podname ?? h.podcode)),
                Del = d.del ?? (h == null ? null : (h.delName ?? h.delcode)),
                UnitPrice = d.dongia,
                Quantity = d.soluong,
                Amount = d.thanhtien,
                Currency = d.tiente,
                Tax = d.thue,
                AmountAfterTax = d.thanhtiensauthue,
                ExchangeRate = d.tigiadebit,
                InvoiceRate = d.tigiahoandondaura,
                ThuChiHo = d.thuho == true ? "Thu hộ" : string.Empty,
                InvoiceNo = d.sohoadondaura,
                Type = d.type,
                Group = d.nhom,
                Note = d.ghichu_debit ?? d.ghichu,
                UserUpdate = d.userupdate,
                DateUpdate = d.dateupdate,
                Approve = d.approve,
                Continued = d.continued,
                Editable = d.editable,
                Locked = d.khoa,
                Printed = d.daIndebit,
                IssuedInvoice = d.daXuatHoadon
            })
            .ToListAsync();
    }

    private async Task<List<ChargeReportRow>> LoadCreditRows(IQueryable<Guid> chargeIdQuery, IQueryable<Guid>? agentCustomerIds)
    {
        return await (
            from c in _context.Set<M_Credit>().AsNoTracking()
            join h in _context.Set<M_HBL>().AsNoTracking()
                on c.hblid equals h.hblID into hj
            from h in hj.DefaultIfEmpty()
            where chargeIdQuery.Contains(c.itemid)
                && (agentCustomerIds == null || agentCustomerIds.Contains(c.customerid))
            select new ChargeReportRow
            {
                RowType = "CREDIT",
                SourceId = c.creditid,
                ChargeId = c.itemid,
                HblId = c.hblid,
                MblId = c.mblid,
                CustomerId = c.customerid,
                DocumentNo = c.sodntt,
                HblNo = h == null ? null : h.hbl,
                BkNo = h == null ? null : h.bkno,
                Shipper = h == null ? null : h.shipper,
                Consignee = h == null ? null : h.consignee,
                Vessel = h == null ? null : h.vessel,
                Voy = h == null ? null : h.voy,
                Pol = h == null ? null : (h.polname ?? h.polcode),
                Pod = h == null ? null : (h.podname ?? h.podcode),
                Del = h == null ? null : (h.delName ?? h.delcode),
                UnitPrice = c.dongia,
                Quantity = c.soluong,
                Amount = c.thanhtien,
                Currency = c.tiente,
                Tax = c.thue,
                AmountAfterTax = c.thanhtiensauthue,
                ExchangeRate = c.tigiacredit,
                InvoiceRate = c.tigiahoadondauvao,
                ThuChiHo = c.chiho == true ? "Chi hộ" : string.Empty,
