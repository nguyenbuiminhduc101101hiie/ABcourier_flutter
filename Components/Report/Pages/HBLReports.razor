@page "/Report/HBLReports"
@page "/HBLReports"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using ABFreight.Data
@using ABFreight.Models
@using System.Linq
@inject IDbContextFactory<ABFreight.Data.AppDbContext> DbFactory
@inject ABFreight.Services.SupportServices supsv
@inject ISnackbar Snackbar
@inject SharedServices ssv
@inject AccountService asv
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>HBL Reports</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="HBL Reports" Subtitle="7.2 · Charge and net/debit/credit matrix" />
<MudContainer MaxWidth=MaxWidth.False>
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudDateRangePicker @bind-DateRange="frmtoDate" Label="From - To Date" Dense="true" Color="Color.Primary" />
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Medium" OnClick="()=>Refresh(frmtoDate)" Disabled="_loading" />
            <MudDivider Vertical="true" Class="mx-2" />
            <MudSelect T="DisplayMode" Value="@mode" ValueChanged="@(val => { mode = val; RecalcRows(); })" Label="View" Dense="true" Style="min-width:160px">
                <MudSelectItem Value="DisplayMode.Net">Net (Debit - Credit)</MudSelectItem>
                <MudSelectItem Value="DisplayMode.Debit">Debit</MudSelectItem>
                <MudSelectItem Value="DisplayMode.Credit">Credit</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Label="Branch" Dense="true" Value="@selectedBranch" ValueChanged="@(val => selectedBranch = val)" Style="min-width:140px">
                @foreach (var b in branchOptions)
                {
                    <MudSelectItem Value="@b">@b</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Department" Dense="true" MultiSelection="true" @ref="loaiSelect" Style="min-width:260px">
                @foreach (var l in loaiOptions)
                {
                    <MudSelectItem Value="@l">@l</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudTextField @bind-Value="_quickFilter" Placeholder="Filter HBL..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Dense="true" Clearable />
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-2 mt-3" Elevation="1">
        <MudTable Items="@filteredRows" Dense="true" Hover="true" Bordered="true" FixedHeader="true"
                  Class="no-wrap-cell" Loading="_loading" Style="max-height: calc(100vh - 32vh); overflow:auto;">
            <HeaderContent>
                <MudTh style="position:sticky; left:0; z-index:2; background:var(--mud-palette-surface);">#</MudTh>
                <MudTh style="position:sticky; left:50px; z-index:2; background:var(--mud-palette-surface);">HBL</MudTh>
                @foreach (var c in visibleCharges)
                {
                    <MudTh Class="text-end">@c.CHARGE</MudTh>
                }
                <MudTh Class="text-end" Style="min-width:120px">Total</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd style="position:sticky; left:0; z-index:1; background:var(--mud-palette-surface);">@(@context.Index)</MudTd>
                <MudTd style="position:sticky; left:50px; z-index:1; background:var(--mud-palette-surface);">
                    <MudText Typo="Typo.body2" Color="Color.Primary">@context.HblNo</MudText>
                </MudTd>
                @foreach (var c in visibleCharges)
                {
                    var val = context.Values.TryGetValue(c.CHARGE_ID, out var v) ? v : 0d;
                    <MudTd Class="text-end">@FormatNumber(val)</MudTd>
                }
                <MudTd Class="text-end"><b>@FormatNumber(context.Total)</b></MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColSpan="2"><b>Total</b></MudTd>
                @foreach (var c in visibleCharges)
                {
                    var sum = rows.Sum(r => r.Values.TryGetValue(c.CHARGE_ID, out var v) ? (v ?? 0d) : 0d);
                    <MudTd Class="text-end"><b>@FormatNumber(sum)</b></MudTd>
                }
                <MudTd Class="text-end"><b>@FormatNumber(rows.Sum(r => r.Total ?? 0d))</b></MudTd>
            </FooterContent>
        </MudTable>
    </MudPaper>
</MudContainer>
</div>

@code {
    enum DisplayMode { Net, Debit, Credit }

    MudBlazor.DateRange frmtoDate = new(DateTime.Today.AddDays(-7), DateTime.Today);
    bool _loading = false;
    string _quickFilter = string.Empty;
    DisplayMode mode = DisplayMode.Net;
    string selectedBranch = "All";
    MudSelect<string>? loaiSelect;
    readonly List<string> branchOptions = new() { "All", "SGN", "HAN", "DAD", "HPH" };
    readonly List<string> loaiOptions = new() { "AI", "AE", "SI", "SE", "Truck", "Customs" };

    List<ChargeModel> allCharges = new();
    List<ChargeModel> visibleCharges = new();

    List<RowVm> rows = new();
    // aggregated maps for recalculation
    Dictionary<string, double> aggDebit = new();
    Dictionary<string, double> aggCredit = new();
    IEnumerable<RowVm> filteredRows => string.IsNullOrWhiteSpace(_quickFilter)
        ? rows
        : rows.Where(r => (r.HblNo ?? string.Empty).Contains(_quickFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            allCharges = await supsv.GetListCharge();
        }
        finally { _loading = false; }
    }
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    async Task Refresh(MudBlazor.DateRange range)
    {
        try
        {
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "HBL_Reports"))
            {
                CallSnackBar(@Localizer["You have not access to view"], MudBlazor.Severity.Warning);
                return;
            }

            _loading = true;
            rows.Clear();
            visibleCharges.Clear();

            await using var db = await DbFactory.CreateDbContextAsync();

            var start = range.Start?.Date;
            var end = range.End?.Date;
            if (start == null || end == null)
            {
                Snackbar.Add("Please select from/to date", MudBlazor.Severity.Info);
                return;
            }

            // 1) Load HBLs then filter in-memory to avoid SQL translation issues
            var allHbls = await db.HBL
                .Select(h => new { h.hblID, h.hbl, h.datereport, h.mblid, h.Jobid })
                .ToListAsync();
            var filteredByDate = allHbls
                .Where(h => h.datereport.HasValue)
                .Where(h => h.datereport!.Value.Date >= start && h.datereport!.Value.Date <= end)
                .ToList();

            // Join to MBL -> Job for Branch/Loai filtering
            var mblIds = filteredByDate.Where(x => x.mblid != Guid.Empty).Select(x => x.mblid).Distinct().ToList();
            var allMbls = await db.MBL
                .Select(m => new { m.MblID, m.Jobid })
                .ToListAsync();
            var mblIdSet = mblIds.ToHashSet();
            var mblLinks = allMbls.Where(m => mblIdSet.Contains(m.MblID)).ToList();
            var jobIdsFromHbl = filteredByDate.Where(x => x.Jobid.HasValue).Select(x => x.Jobid!.Value).ToList();
            var jobIdsFromMblNullable = mblLinks.Select(x => (Guid?)x.Jobid).ToList();
            var jobIds = jobIdsFromHbl
                .Concat(jobIdsFromMblNullable.Where(j => j.HasValue).Select(j => j!.Value))
                .Distinct()
                .ToList();
            var allJobs = await db.Job
                .Select(j => new { j.JobID, j.Branch, j.Loai })
                .ToListAsync();
            var jobIdSet = jobIds.ToHashSet();
            var jobs = allJobs.Where(j => jobIdSet.Contains(j.JobID)).ToList();
            var mblToJob = mblLinks.ToDictionary(x => x.MblID, x => x.Jobid);
            var jobMap = jobs.ToDictionary(x => x.JobID, x => new { x.Branch, x.Loai });

            bool BranchOk(Guid? jobid)
            {
                if (selectedBranch == "All") return true;
                if (!jobid.HasValue) return false;
                return jobMap.TryGetValue(jobid.Value, out var j) && string.Equals(j.Branch, selectedBranch, StringComparison.OrdinalIgnoreCase);
            }
            bool LoaiOk(Guid? jobid)
            {
                var sels = loaiSelect?.SelectedValues;
                if (sels == null || !sels.Any()) return true;
                if (!jobid.HasValue) return false;
                return jobMap.TryGetValue(jobid.Value, out var j) && j.Loai != null && sels!.Contains(j.Loai);
            }

            var hbls = filteredByDate
                .Select(h => new
                {
                    h.hblID,
                    h.hbl,
                    jobid = h.Jobid.HasValue ? h.Jobid : (mblToJob.TryGetValue(h.mblid, out var jid) ? jid : (Guid?)null)
                })
                .Where(x => BranchOk(x.jobid) && LoaiOk(x.jobid))
                .Select(x => new { x.hblID, x.hbl })
                .ToList();
            var hblIds = hbls.Select(x => x.hblID).ToList();
            if (hblIds.Count == 0)
            {
                Snackbar.Add("No HBL found in range", MudBlazor.Severity.Info);
                return;
            }

            // 2) Load Debit & Credit (minimal fields), then filter in-memory to avoid SQL translation issues
            var allDebits = await db.Debit
                .Select(d => new { d.hblid, d.itemid, d.thanhtien, d.tiente, d.tigiadebit })
                .ToListAsync();
            var allCredits = await db.Credit
                .Select(c => new { c.hblid, c.itemid, c.thanhtien, c.tiente, c.tigiacredit })
                .ToListAsync();
            var hblIdSet = hblIds.ToHashSet();
            var debits = allDebits.Where(d => hblIdSet.Contains(d.hblid)).ToList();
            var credits = allCredits.Where(c => hblIdSet.Contains(c.hblid)).ToList();

            // 3) Determine visible charges (appeared in period)
            var chargeIds = debits.Select(x => x.itemid).Concat(credits.Select(x => x.itemid)).Distinct().ToHashSet();
            visibleCharges = allCharges.Where(c => chargeIds.Contains(c.CHARGE_ID)).OrderBy(c => c.CHARGE).ToList();

            // 4) Build rows
            var chargeIdSet = visibleCharges.Select(c => c.CHARGE_ID).ToHashSet();
            var grpDebit = debits
                .Where(x => chargeIdSet.Contains(x.itemid))
                .GroupBy(x => new { x.hblid, x.itemid })
                .ToDictionary(g => g.Key, g => g.Sum(v => ConvertToVND(v.thanhtien, v.tiente, v.tigiadebit)));
            var grpCredit = credits
                .Where(x => chargeIdSet.Contains(x.itemid))
                .GroupBy(x => new { x.hblid, x.itemid })
                .ToDictionary(g => g.Key, g => g.Sum(v => ConvertToVND(v.thanhtien, v.tiente, v.tigiacredit)));

            // Save to flat dictionaries for recalc
            aggDebit.Clear();
            aggCredit.Clear();
            foreach (var kv in grpDebit)
                aggDebit[$"{kv.Key.hblid}|{kv.Key.itemid}"] = kv.Value;
            foreach (var kv in grpCredit)
                aggCredit[$"{kv.Key.hblid}|{kv.Key.itemid}"] = kv.Value;

            int idx = 1;
            foreach (var h in hbls)
            {
                var row = new RowVm { Index = idx++, HblId = h.hblID, HblNo = h.hbl, Values = new() };
                double total = 0d;
                foreach (var c in visibleCharges)
                {
                    var key = $"{h.hblID}|{c.CHARGE_ID}";
                    aggDebit.TryGetValue(key, out var dval);
                    aggCredit.TryGetValue(key, out var cval);
                    double val = mode switch
                    {
                        DisplayMode.Debit => dval,
                        DisplayMode.Credit => cval,
                        _ => dval - cval
                    };
                    row.Values[c.CHARGE_ID] = val;
                    total += val;
                }
                row.Total = total;
                rows.Add(row);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    void RecalcRows()
    {
        foreach (var row in rows)
        {
            double total = 0d;
            foreach (var c in visibleCharges)
            {
                var key = $"{row.HblId}|{c.CHARGE_ID}";
                aggDebit.TryGetValue(key, out var dval);
                aggCredit.TryGetValue(key, out var cval);
                var val = mode switch
                {
                    DisplayMode.Debit => dval,
                    DisplayMode.Credit => cval,
                    _ => dval - cval
                };
                row.Values[c.CHARGE_ID] = val;
                total += val;
            }
            row.Total = total;
        }
        StateHasChanged();
    }

    double ConvertToVND(double? amount, string? currency, double? rate)
    {
        var a = amount ?? 0d;
        if (string.Equals(currency, "USD", StringComparison.OrdinalIgnoreCase))
            return a * (rate ?? 0d);
        return a;
    }

    string FormatNumber(double? v) => v.HasValue ? string.Format(System.Globalization.CultureInfo.GetCultureInfo("en-US"), "{0:##,##0.##}", v.Value) : "";

    class RowVm
    {
        public int Index { get; set; }
        public Guid HblId { get; set; }
        public string? HblNo { get; set; }
        public Dictionary<Guid, double?> Values { get; set; } = new();
        public double? Total { get; set; }
    }
}
