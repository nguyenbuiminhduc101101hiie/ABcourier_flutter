                await InvokeDashboardJsAsync("resizeDashboardCharts");
            }

            var dataprofitNow = HBLs
          .Where(x => x.datereport.HasValue && x.datereport >= startOfYear && x.datereport.Value.Month == today.Month)
          .Sum(x => TProfit_(x.hblID, "") ?? 0);
            profitNow = dataprofitNow.ToString("##,##0.##", new CultureInfo("en-US"));
            // if (user.Department =="Admin")
            // {
            //     var dataprofitNow = HBLs
            //    .Where(x => x.datereport.HasValue && x.datereport >= startOfYear && x.datereport.Value.Month == today.Month)
            //    .Sum(x => TProfit_(x.hblID, "") ?? 0);
            //     profitNow = dataprofitNow.ToString("##,##0.##", new CultureInfo("en-US"));
