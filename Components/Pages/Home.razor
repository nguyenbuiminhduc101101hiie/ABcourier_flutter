    string profitNow = "0";

    bool HasProfitChartData => dataProfitChart.Any(series =>
        series.Data?.Any(value => double.IsFinite(value) && value != 0d) == true);

    void BuildProfitChartData(DateTime startOfYear, IReadOnlyCollection<int> allMonths)
    {
        var profitPerMonth = HBLs
            .Where(x => x.datereport.HasValue && x.datereport >= startOfYear)
            .GroupBy(x => x.datereport!.Value.Month)
            .ToDictionary(
                group => group.Key,
                group => SanitizeChartValue(group.Sum(x => SafeRoundedProfitUsd(x.hblID))));

        dataProfitChart = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = "Profit USD",
                Data = allMonths
                    .Select(month => profitPerMonth.GetValueOrDefault(month))
                    .ToArray()
            }
        };
    }

    double SafeRoundedProfitUsd(Guid hblId)
    {
        var value = TProfit_USD(hblId, "") ?? 0d;
        return double.IsFinite(value) ? Math.Round(value) : 0d;
    }

    static double SanitizeChartValue(double value) => double.IsFinite(value) ? value : 0d;

    double? TProfit_(Guid id, string type)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = x.thanhtien;
            return x.tiente == "VND"
                ? tien * 1
                : tien * x.tigiadebit;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = x.thanhtien;
            return x.tiente == "VND"
                ? tien * 1
                : tien * x.tigiacredit;
        });
        return totaldebit - totalcredit;
    }
    double? TProfit_USD(Guid id, string type)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = x.thanhtiensauthue;
            return x.tiente == "USD"
                ? tien * 1
                : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit);

        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = x.thanhtiensauthue;
            return x.tiente == "USD"
                ? tien * 1
                : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit);
        });
        return totaldebit - totalcredit;
    }

