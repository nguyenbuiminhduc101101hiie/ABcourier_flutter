                        width: 100%;
                        flex-wrap: wrap;
                    }

                    .map-search-box {
                        width: 100%;
                    }

                    .dashboard-map-box {
                        height: 360px;
                    }
                }

                </style>
                <PageTitle>Dashboard</PageTitle>
                <div class="dashboard-page">
                    <MudPaper Elevation="0" Class="dashboard-toolbar">
                        <div class="dashboard-toolbar-content">
                            <div class="dashboard-heading">
                                <div class="dashboard-eyebrow">Tổng quan vận hành</div>
                                <MudText Typo="Typo.h5" Class="dashboard-title">Dashboard</MudText>
                                <MudText Typo="Typo.caption" Class="dashboard-subtitle">
                                    Lợi nhuận, báo giá, công nợ và tình trạng lô hàng trong một không gian làm việc
                                </MudText>
                            </div>

                            <div class="dashboard-toolbar-actions">
                                <div class="dashboard-period">Tháng @DateTime.Now.Month · @DateTime.Now.Year</div>
                                <MudIconButton OnClick="refreshData"
                                               Disabled="_loading"
                                               Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Icon="@Icons.Material.Filled.Refresh"
                                               Title="Tải lại dữ liệu Dashboard"
                                               Class="dashboard-refresh-btn" />
                                <a href="HDSDhtml/HDSD_Dashboard_Report_Final.html" target="_blank" style="text-decoration:none;">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Info"
                                               Class="dashboard-help-btn">
                                        Trợ giúp
                                    </MudButton>
                                </a>
                            </div>
                        </div>
                    </MudPaper>

                    <MudContainer Class="dashboard-shell" MaxWidth="MaxWidth.False">
                        <section class="dashboard-section isolate-style" aria-labelledby="dashboard-overview-title">
                            <div class="dashboard-section-header dashboard-overview-header">
                                <div>
                                    <h2 id="dashboard-overview-title" class="dashboard-section-title">Tổng quan nhanh</h2>
                                    <p class="dashboard-section-caption">Các chỉ số cần chú ý trong kỳ hiện tại</p>
                                </div>
                            </div>

                            <MudGrid Class="dashboard-grid">
                                <MudItem xs="12" sm="12" md="4">
                                    <MudCard Elevation="0" Class="dashboard-kpi-card kpi-profit">
                                        <div class="kpi-header">
                                            <div>
                                                <MudText Typo="Typo.subtitle2" Class="kpi-label">Profit tháng @DateTime.Now.Month</MudText>
                                                <MudText Typo="Typo.caption" Class="kpi-caption">Tổng lợi nhuận hiện tại</MudText>
                                            </div>
                                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="kpi-icon" />
                                        </div>
                                        <div class="kpi-content">
                                            <div class="kpi-metric">
                                                <MudText Typo="Typo.h3" Class="kpi-value">@profitNow</MudText>
                                                <span class="kpi-unit">VND</span>
                                            </div>
                                        </div>
                                    </MudCard>
                                </MudItem>

                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard Elevation="0" Class="dashboard-kpi-card kpi-quote">
                                        <div class="kpi-header">
