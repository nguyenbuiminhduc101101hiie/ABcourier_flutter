@page "/"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@inject AccountService asv
@using BlazorBootstrap;
@inject tigiaVCBservices vcbsv
@inject SingletonSerivce singsv
<style>
    .isolate-style :is( .image-container, .full-image, .panel-content img, .mud-nav-group, .footer-container, .custom-button, .selected, .selected > td, .selected > td .mud-input, .labelCustomColor label, .mud-table thead, .mud-table th, .mud-table1, .button-align, .mud-table-customtext, .class-dialog-custom, .table-shipment-bg, .mud-table-foot tr, .footer-cell, .filter-header-cell, .no-wrap, .text-right input, .text-right textarea, .custom-right-align, .custom-label .mud-input-label, .label-right label, .no-wrap-cell, .nondisplay, .custom-credit thead tr, .custom-credit th, .table-hbl-bg, .custom-tab .mud-tabs-toolbar, .custom-tab .mud-tab, .close-tab-icon, .button-no-grow, .datagrid-responsive, .custom-disable, .custom-disable:hover ) {
        all: unset !important;
    }

        @@keyframes blink
    {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.2;
            }

            100% {
                opacity: 1;
            }
        }

        .blinking-icon {
            animation: blink 1s infinite;
        }

        @@keyframes pulse
        {
                0% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.1);
                }

                100% {
                    transform: scale(1);
                }
            }

            /* ===== Dashboard modern UI ===== */
            .dashboard-page {
                min-height: 100%;
                padding: 22px 24px 30px;
                background: #f5f7fa;
            }

            .dashboard-shell {
                width: 100%;
                margin-top: 16px;
                padding: 0 !important;
                background: transparent;
            }

            .dashboard-toolbar {
                margin: 0;
                padding: 2px 2px 18px;
                border-radius: 0;
                background: transparent;
                color: #111827;
                box-shadow: none;
            }

            .dashboard-toolbar-content,
            .dashboard-toolbar-actions,
            .dashboard-period {
                display: flex;
                align-items: center;
            }

            .dashboard-toolbar-content {
                justify-content: space-between;
                gap: 20px;
            }

            .dashboard-heading {
                position: relative;
                padding-left: 14px;
            }

            .dashboard-heading::before {
                content: "";
                position: absolute;
                top: 3px;
                bottom: 3px;
                left: 0;
                width: 3px;
                border-radius: 999px;
                background: linear-gradient(180deg, #0f8b80 0%, #2563eb 100%);
            }

            .dashboard-toolbar-actions {
                gap: 8px;
                flex: 0 0 auto;
            }

            .dashboard-eyebrow {
                margin-bottom: 5px;
                color: #0b6b64;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: .16em;
                text-transform: uppercase;
            }

            .dashboard-period {
                min-height: 34px;
                padding: 0 12px;
                border: 1px solid #dbe5e7;
                border-radius: 9px;
                background: #ffffff;
                color: #475569;
                font-size: 12px;
                font-weight: 650;
                white-space: nowrap;
            }

            .dashboard-title {
                color: #0b1220;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif !important;
                font-weight: 700 !important;
                letter-spacing: -.45px;
            }

            .dashboard-subtitle {
                max-width: 720px;
                color: #526174;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif !important;
                font-weight: 400;
            }


            /* ===== Font chữ dashboard gọn, dễ đọc ===== */
