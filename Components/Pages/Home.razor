            .dashboard-toolbar,
            .dashboard-shell .mud-typography,
            .dashboard-shell .mud-button,
            .dashboard-shell .mud-button-label,
            .dashboard-shell .mud-input,
            .dashboard-shell .mud-input-label,
            .dashboard-shell .mud-select,
            .dashboard-shell .mud-chip,
            .map-info-panel {
                font-family: "Roboto", "Segoe UI", Arial, sans-serif !important;
            }

            .dashboard-title {
                font-size: 28px !important;
                line-height: 1.15 !important;
            }

            .dashboard-subtitle {
                font-size: 13.5px !important;
                line-height: 1.5 !important;
            }

            .kpi-label,
            .chart-title {
                font-size: 15.5px !important;
                line-height: 1.25 !important;
            }

            .kpi-caption,
            .chart-caption {
                font-size: 12px !important;
                line-height: 1.35 !important;
            }

            .kpi-value {
                font-size: clamp(28px, 2vw, 38px) !important;
                line-height: 1.1 !important;
            }

            .dashboard-shell .mud-button {
                text-transform: none !important;
                font-size: 12px !important;
                font-weight: 650 !important;
                letter-spacing: .1px !important;
                border-radius: 10px !important;
                min-height: 34px !important;
            }

            .dashboard-shell .mud-icon-root {
                font-size: 20px;
            }

            .map-title-row .mud-typography {
                font-size: 14px !important;
                font-weight: 700 !important;
            }

            .map-controls-row .mud-input,
            .map-controls-row .mud-input-label,
