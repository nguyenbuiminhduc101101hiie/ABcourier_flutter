            //    .Where(x => x.datereport.HasValue && x.datereport >= startOfYear && x.datereport.Value.Month == today.Month && x.SaleName == user.Name)
            //    .Sum(x => TProfit_(x.hblID, "") ?? 0);
            //     profitNow = dataprofitNow.ToString("##,##0.##", new CultureInfo("en-US"));
