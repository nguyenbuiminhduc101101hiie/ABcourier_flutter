            }

            .dashboard-refresh-btn {
                color: #0f766e !important;
                background: #edf8f6 !important;
                border-radius: 9px !important;
                border: 1px solid #cde8e3 !important;
            }

            .dashboard-grid {
                margin-top: 0;
            }

            .dashboard-section + .dashboard-section {
                margin-top: 20px;
            }

            .dashboard-section-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 16px;
                margin: 0 2px 10px;
            }

            .dashboard-section-title {
                margin: 0;
                color: #0b1220;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif;
                font-size: 18px;
                font-weight: 700;
                letter-spacing: -.2px;
                line-height: 1.3;
            }

            .dashboard-section-caption {
                margin: 3px 0 0;
                color: #526174;
                font-size: 12.5px;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif;
                font-weight: 400;
                line-height: 1.4;
            }

            .dashboard-overview-header {
                margin-bottom: 12px;
            }

            .sr-only {
                position: absolute !important;
                width: 1px !important;
                height: 1px !important;
                padding: 0 !important;
                margin: -1px !important;
                overflow: hidden !important;
                clip: rect(0, 0, 0, 0) !important;
                white-space: nowrap !important;
                border: 0 !important;
            }

            .dashboard-card,
            .dashboard-kpi-card,
            .dashboard-chart-card,
            .dashboard-map-card {
                width: 100%;
                height: 100%;
                border-radius: 12px !important;
                border: 1px solid #e1e7ec;
                background: #ffffff;
                box-shadow: 0 2px 8px rgba(15, 23, 42, .035) !important;
                overflow: hidden;
            }

            .dashboard-kpi-card {
                min-height: 142px;
                padding: 18px;
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .dashboard-kpi-card::after {
                content: "";
                position: absolute;
                right: 0;
                bottom: 0;
                left: 0;
                height: 3px;
                opacity: .85;
            }

            .kpi-profit {
                background: #ffffff;
            }

            .kpi-profit::after {
                background: linear-gradient(90deg, #0f766e, #2dd4bf);
            }

            .kpi-quote {
                background: #ffffff;
            }

            .kpi-quote::after {
                background: linear-gradient(90deg, #2563eb, #60a5fa);
            }

            .kpi-debt {
                background: #ffffff;
            }

            .kpi-debt::after {
                background: linear-gradient(90deg, #d97706, #fbbf24);
            }

            .kpi-header,
            .chart-header {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 10px;
            }

            .kpi-content {
                min-height: 66px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 14px;
            }

            .kpi-metric {
                min-width: 0;
                flex: 1 1 auto;
            }

            .kpi-unit {
                display: block;
                margin-top: 5px;
                color: #64748b;
                font-size: 11px;
                font-weight: 650;
            }

            .kpi-label,
            .chart-title {
                font-weight: 700;
                color: #0b1220;
            }

            .kpi-caption,
            .chart-caption {
                color: #526174;
                font-weight: 500;
                font-size: .82rem;
            }

            .kpi-value {
                color: #070d19;
                font-family: "Roboto", "Segoe UI", Arial, sans-serif !important;
                font-weight: 700;
                line-height: 1.1;
                word-break: break-word;
            }

            .kpi-icon {
                padding: 8px;
                border-radius: 12px;
                background: rgba(37, 99, 235, .10);
                color: #2563eb;
                font-size: 28px !important;
            }

            .kpi-chart-wrapper {
                width: 126px;
                height: 100px;
                min-width: 126px;
                min-height: 100px;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
            }

            /* Chart card: ép card vừa nội dung, không kéo cao theo row của MudGrid */
            .dashboard-chart-card {
                height: auto !important;
                min-height: 360px !important;
                max-height: 400px !important;
                padding: 18px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .dashboard-chart-item {
                align-self: flex-start;
                min-width: 0;
                height: auto !important;
            }

                .dashboard-chart-item > .mud-card {
                    height: auto !important;
                }

            .chart-header {
                flex: 0 0 auto;
            }

            /* Chart nằm gọn trong chiều cao cố định, không bị tạo khoảng trắng lớn */
            .profit-chart-wrapper,
            .shipment-chart-wrapper {
                width: 100%;
                height: clamp(250px, 18vw, 290px) !important;
                min-height: 250px !important;
                max-height: 290px !important;
                flex: 0 0 clamp(250px, 18vw, 290px);
                position: relative;
                overflow: hidden;
            }

            .chart-empty-state {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                color: #64748b;
                font-size: 13px;
                text-align: center;
                border: 1px dashed #cbd5e1;
                border-radius: 14px;
                background: #f8fafc;
            }

                .profit-chart-wrapper svg,
                .profit-chart-wrapper svg,
                .profit-chart-wrapper canvas,
                .shipment-chart-wrapper svg,
                .shipment-chart-wrapper canvas {
                    width: 100% !important;
                    height: 100% !important;
                    max-height: 250px !important;
                    display: block !important;
                }

            /* Bản đồ dùng toàn bộ chiều rộng để không tạo khoảng trống bên phải. */
            .map-half-item {
                flex: 0 0 100% !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            .dashboard-map-card {
                width: 100%;
                height: auto;
                min-height: unset;
                padding: 18px !important;
                overflow: hidden;
            }

            .map-toolbar,
            .map-controls-row,
            .map-search-actions {
                gap: 8px;
                flex-wrap: wrap;
            }

            .map-title-row {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
            }

            .map-panel-wrapper {
                margin-top: 12px;
                width: 100%;
                max-width: 100%;
                min-width: 0;
                position: relative;
                display: block;
            }

            .map-canvas-holder {
                width: 100%;
                min-width: 0;
                display: block;
            }

            /* Bản đồ dạng landscape phù hợp với vùng nội dung dashboard. */
            .dashboard-map-box {
                width: 100% !important;
                aspect-ratio: auto;
                height: clamp(360px, 48vw, 560px);
                min-height: 360px !important;
                max-height: 560px !important;
                display: block !important;
                position: relative !important;
                border-radius: 12px;
                box-shadow: inset 0 0 0 1px rgba(15,23,42,.08), 0 8px 22px rgba(15,23,42,.08);
                overflow: hidden;
                background: #eef2ff;
            }

            .map-search-box {
                width: 260px;
                max-width: 100%;
            }

            @@media (max-width: 960px) {
                    .dashboard-toolbar {
                        padding: 16px;
                    }

                    .dashboard-toolbar-content {
                        align-items: flex-start;
                        flex-direction: column;
                    }

                    .dashboard-toolbar-actions {
                        width: 100%;
                        flex-wrap: wrap;
                    }

                    .profit-chart-wrapper,
                    .shipment-chart-wrapper {
                        height: 220px !important;
                        min-height: 220px !important;
                        max-height: 220px !important;
                        flex-basis: 220px !important;
                    }

                    .map-half-item {
                        flex: 0 0 100% !important;
                        max-width: 100% !important;
                        width: 100% !important;
                    }

                    .map-panel-wrapper {
                        max-width: 100%;
                        min-width: 0;
                    }

                    .map-canvas-holder {
                        min-width: 0;
                    }

                    .dashboard-map-box {
                        width: 100% !important;
                        aspect-ratio: auto;
                        height: 420px;
                        min-height: 320px !important;
                        max-height: none !important;
                    }
                }


                /* ===== Modern style cho lưới HBLRelease phía trên Dashboard ===== */
                .release-grid-modern {
                    margin: 0;
                    padding: 10px 12px 8px;
                    border-radius: 14px;
                    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
                    border: 1px solid rgba(15, 23, 42, .08);
                    box-shadow: 0 2px 8px rgba(15, 23, 42, .035);
                    overflow-x: auto;
                    overflow-y: hidden;
                }

                    .release-grid-modern .mud-paper,
                    .release-grid-modern .mud-table-container,
                    .release-grid-modern .mud-table,
                    .release-grid-modern .mud-data-grid {
                        border-radius: 14px !important;
                        background: #ffffff !important;
                        box-shadow: none !important;
                        overflow: hidden !important;
                    }

                    .release-grid-modern .mud-table-toolbar,
                    .release-grid-modern .mud-toolbar {
                        min-height: 46px !important;
                        padding: 8px 10px !important;
