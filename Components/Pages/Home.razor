            ListDebit = await shipsv.GetListDebitHBLs(HBLs);
            ListCredit = await shipsv.GetListCreditHBLs(HBLs);

            var startOfYear = new DateTime(DateTime.Now.Year, 1, 1);

            // Nhóm theo tháng và trạng thái
            var rawData = HBLs
                .Where(x => x.datereport.HasValue && x.datereport >= startOfYear)
                .GroupBy(x => new { Thang = x.datereport!.Value.Month, x.statusHBL })
                .Select(g => new
                {
                    g.Key.Thang,
                    g.Key.statusHBL,
                    SoLuong = g.Count()
                })
                .ToList();

            // Lấy tất cả các tháng (1–12), và trạng thái duy nhất
            var allMonths = Enumerable.Range(1, 12).ToList();
            var allStatuses = rawData.Select(x => x.statusHBL).Distinct().ToList();

            // Dùng để hiển thị label trục X (tháng)
            labelsShipment = allMonths
                .Select(m => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m))
                .ToArray();

            // Dựng lại chart series cho từng status
            dataShipment = allStatuses
                .Select(status =>
                    new ChartSeries
                    {
                        Name = status,
                        Data = allMonths.Select(month =>
                    rawData.FirstOrDefault(d => d.Thang == month && d.statusHBL == status)?.SoLuong ?? 0
                                ).Select(x => (double)x).ToArray()
                    }
                ).ToList();

            var dataQuoRaw = Quos
                .Where(x => x.validDate >= new DateTime(DateTime.Now.Year, 1, 1))
                .GroupBy(x => x.status)
                .Select(g => new { TrangThai = g.Key, SoLuong = g.Count() })
                .ToList();

            labelsQuo = dataQuoRaw.Select(x => x.TrangThai).ToArray();
            dataQuo = dataQuoRaw.Select(x => (double)x.SoLuong).ToArray();

            var today = DateTime.Now;
            var dataDebtRaw = Debts
                .Where(d => d.ngayphathanhhoadonDientu != null)
                .Select(d =>
                {
                    var hbl = HBLs.FirstOrDefault(h => h.hblID == d.hblid);
                    if (hbl == null || hbl.datereport == null) return null;

                    var customer = Customers.FirstOrDefault(c => c.Customer_ID == hbl.CustomerID);
                    if (customer == null) return null;

                    // Nếu hancongno null thì mặc định là không quá hạn
                    var hanCongNo = int.TryParse(customer.hancongno, out int hancongno) ? hancongno : 0;
                    var soNgayQuaHan = (today - hbl.datereport.Value).Days;

                    var quaHan = soNgayQuaHan > hanCongNo;

                    return new
                    {
                        QuaHan = quaHan
                    };
                })
                .Where(x => x != null)
                .GroupBy(x => x.QuaHan ? "Quá hạn" : "Chưa đến hạn")
                .Select(g => new
                {
                    TrangThai = g.Key,
                    SoLuong = g.Count()
                })
