            dataDebt = dataDebtRaw.Select(x => (double)x.SoLuong).ToArray();

            labelsProfit = allMonths
               .Select(m => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m))
               .ToArray();

            BuildProfitChartData(startOfYear, allMonths);

            if (_rendered)
            {
