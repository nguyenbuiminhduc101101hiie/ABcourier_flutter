                @@media (max-width: 600px) {
                    .dashboard-page {
                        padding: 10px 10px 22px;
                    }

                    .dashboard-toolbar-actions {
                        align-items: stretch;
                    }

                    .dashboard-period {
                        width: 100%;
                        justify-content: center;
                    }

                    .dashboard-kpi-card {
                        min-height: 150px;
                    }

