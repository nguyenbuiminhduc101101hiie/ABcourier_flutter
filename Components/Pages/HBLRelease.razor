
@* @page "/exportHBL" *@
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer

<MudStack Row="true" Justify="Justify.FlexStart" Class="pa-4">
    <MudButton OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["Reload"]
    </MudButton>
</MudStack>
<MudDataGrid T="M_HBL" Items="@Listdata" Filterable="true" @ref="mudTable"
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                ReadOnly="false" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
                ColumnResizeMode="ResizeMode.Column" Loading="_loading">
    <Columns>
        <PropertyColumn Property="x => Listdata.IndexOf(x)+1" Title="@Localizer["No."]" Required="false" Filterable="false" />
        <PropertyColumn Property="x => x.hbl" Title="@Localizer["HBL"]" Required="false" />
        <PropertyColumn Property="x => x.release" Title="@Localizer["Release"]" Required="false" Filterable="false">
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.release" Label="@Localizer["Release"]" />
            </EditTemplate>
            <CellTemplate>
                <MudCheckBox Value="context.Item.release.HasValue ? context.Item.release.Value : false" ReadOnly />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.releaseNote" Title="@Localizer["Release Note"]" Required="false" Filterable="false" />
        <PropertyColumn Property="x => Getjobno(x.mblid)" Title="@Localizer["Job No."]" Required="false" />
        <PropertyColumn Property="x => CusidtoCusCode(x.CustomerID)" Title="@Localizer["Main Customer"]" Required="false" />
        <PropertyColumn Property="x => x.statusHBL" Title="@Localizer["Status"]" Required="false" />
        <PropertyColumn Property="x => x.polname" Title="@Localizer["Port of Loading"]" Required="false"/>
        <PropertyColumn Property="x => x.delName" Title="@Localizer["Place of Delivery"]" Required="false" />
        <PropertyColumn Property="x => x.podname" Title="@Localizer["Port of Discharge"]" Required="false" />
        <PropertyColumn Property="x => x.porname" Title="@Localizer["Place Of Receipt"]" Required="false" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="M_HBL" PageSizeOptions="[5,10,15,25]" />
    </PagerContent>
</MudDataGrid>
@code {

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    List<string> trangthais = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<(M_Job job, Guid mblid)> Jobs = new List<(M_Job job, Guid mblid)>();
    protected async override Task OnInitializedAsync()
    {
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "HBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        var userdetail = asv.GetUserDetail();
        Customers = await csv.GetList(userdetail);
        Jobs = await shipsv.GetListJobNoAndMBLID();
        //await Refresh();
    }

    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    M_HBL hbldetail = new M_HBL();
    async Task Refresh()
    {
        try
        {
            hbldetail = null!;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Shipment"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }

            Listdata = await shipsv.GetListHBLALL();
            Listdata = Listdata.Where(x => x.release == true).ToList(); // lấy release
        }
        finally
        {
            _loading = false;
        }

    }
