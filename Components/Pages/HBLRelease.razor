    void RowClicked(DataGridRowClickEventArgs<M_HBL> args)
    {
        hbldetail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_HBL> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }
    private bool _processingUpload = false;
    private async Task ExportBill()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            if (hbldetail == null)
            {
                CallSnackBar("you must select 1 HBL.", MudBlazor.Severity.Warning);
                return;
            }
            var type = await shipsv.GetTypeByMBLID(hbldetail.mblid); // Air Sea Truck HQ
            if (type.Contains("S")) // sea
            {
                var billDialogParams = new DialogParameters { ["FormKind"] = ABFreight.Models.BillLayoutFormKind.Sea };
                var dialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogBillExportOption>("Export Bill - Chọn mẫu Bill", billDialogParams, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
                var result = await dialogRef.Result;
                if (result.Canceled) return;
                var opts = (Shipment.Pages.DialogBillExportOption.BillExportOptions)result.Data!;
                var rs = await shipsv.ExportBillSea(hbldetail.hblID!, opts.ShowPreCarriage, opts.Attach, opts.IsOriginal, opts.LayoutFormId);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            else if (type.Contains("A")) // air
            {
                var billDialogParams = new DialogParameters { ["FormKind"] = ABFreight.Models.BillLayoutFormKind.Air };
                var dialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogBillExportOption>("Export Bill - Chọn mẫu Bill", billDialogParams, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true });
                var result = await dialogRef.Result;
                if (result.Canceled) return;
                var opts = (Shipment.Pages.DialogBillExportOption.BillExportOptions)result.Data!;
                var rs = await shipsv.ExportBilAir(hbldetail.hblID!, opts.IsOriginal, opts.LayoutFormId);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            else
                CallSnackBar($"Chưa có mẫu bill cho loại '{type}' ", MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
    string CusidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : rs.shortname + "_" + rs.COMPANY!;
    }

    string Getjobno(Guid? mblid)
    {
        if (mblid == Guid.Empty) return string.Empty;
        var rs = Jobs.FirstOrDefault(x=> x.mblid != Guid.Empty && x.mblid == mblid);
        return string.IsNullOrEmpty(rs.job.JobNo) ? string.Empty : rs.job.JobNo;
    }
