</div>

@code {
    private bool _loading;
    private List<M_Container> _containers = new();
    private List<string> DistinctSizeTypes { get; set; } = new List<string>();

    // Status counts
    private int InDepotCount { get; set; }
    private int WaitingPortArrivalCount { get; set; }
    private int ArrivedAtPortCount { get; set; }
    private int InTransitCount { get; set; }
    private int GateOutCount { get; set; }

    // Grouped rows
    private List<InventoryGroupRow> inDepotRows = new();
    private List<InventoryGroupRow> inPortRows = new();
    private List<InventoryGroupRow> gateOutRows = new();
    AuthUser userdetail;
    // Search terms
    private string? searchInDepot;
    private string? searchInPort;
    private string? searchGateOut;

    private IEnumerable<InventoryGroupRow> FilteredInDepotRows => FilterRows(inDepotRows, searchInDepot);
    private IEnumerable<InventoryGroupRow> FilteredInPortRows => FilterRows(inPortRows, searchInPort);
    private IEnumerable<InventoryGroupRow> FilteredGateOutRows => FilterRows(gateOutRows, searchGateOut);

    private static IEnumerable<InventoryGroupRow> FilterRows(IEnumerable<InventoryGroupRow> rows, string? search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return rows;

        return rows.Where(r =>
            (!string.IsNullOrWhiteSpace(r.Location) && r.Location!.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(r.StatusContText) && r.StatusContText.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
            (r.OwnerNames?.Any(o => !string.IsNullOrWhiteSpace(o) && o.Contains(search, StringComparison.OrdinalIgnoreCase)) == true));
    }

    protected override void OnInitialized()
    {
        userdetail = asv.GetUserDetail();

        _ = LoadData();
    }

    private async Task Refresh()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            if (!await ssv.CheckPermission(userdetail.Usr, "View", "Inventory"))
            {
                CallSnackBar("You have not access to View", MudBlazor.Severity.Warning);
                return;
            }
            _loading = true;
            StateHasChanged();
            _containers = shipsv.GetListContainerAll() ?? new List<M_Container>();
            BuildDashboard();
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot load container inventory: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    private void BuildDashboard()
    {
        InDepotCount = _containers.Count(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "In Depot", StringComparison.OrdinalIgnoreCase));
        WaitingPortArrivalCount = _containers.Count(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "Waiting Port Arrival", StringComparison.OrdinalIgnoreCase));
        ArrivedAtPortCount = _containers.Count(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "Arrived at Port", StringComparison.OrdinalIgnoreCase));
        InTransitCount = _containers.Count(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "In Transit", StringComparison.OrdinalIgnoreCase));
        GateOutCount = _containers.Count(IsGateOutContainer);

        var containersForTables = _containers.Where(c =>
            string.Equals(c.NVOCC_Status, "In Depot", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(c.NVOCC_Status, "Arrived at Port", StringComparison.OrdinalIgnoreCase) ||
            IsGateOutContainer(c));

        DistinctSizeTypes = containersForTables
            .Select(c => c.CTN_SIZE_TYPE?.Trim())
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .GroupBy(s => s!, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(GetLeadingNumber)
            .ThenBy(GetSuffix, StringComparer.OrdinalIgnoreCase)
            .ToList();

        inDepotRows = BuildGroupedRows(
            _containers.Where(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "In Depot", StringComparison.OrdinalIgnoreCase)),
            c => c.In_Depot,
            DistinctSizeTypes);

        inPortRows = BuildGroupedRows(
            _containers.Where(c => !IsGateOutContainer(c) && string.Equals(c.NVOCC_Status, "Arrived at Port", StringComparison.OrdinalIgnoreCase)),
            c => c.In_Port,
            DistinctSizeTypes);

        gateOutRows = BuildGroupedRows(
            _containers.Where(IsGateOutContainer),
            GetGateOutLocation,
            DistinctSizeTypes);
    }

    private static bool IsGateOutContainer(M_Container c)
    {
        // Container form nhập ở màn hình M_Container:
        // - NVOCC_Status: In Depot / Arrived at Port / In Transit / ...
        // - Status Cont: thường dùng để đánh dấu cont đã xuất / gate out.
        // Dùng reflection để không lỗi compile nếu model đang đặt tên field khác nhau.
        var nvoccStatus = c.NVOCC_Status?.Trim();
        var statusCont = GetStatusCont(c);
        var combined = $"{nvoccStatus} {statusCont}".Trim();

        if (string.IsNullOrWhiteSpace(combined))
            return false;

        return IsGateOutText(nvoccStatus)
            || IsGateOutText(statusCont)
            || IsGateOutText(combined);
    }

    private static bool IsGateOutText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        var s = value.Trim();

        return string.Equals(s, "Gate Out", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "OUT", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "Out", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "Đã xuất", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "Da xuat", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "Xuất", StringComparison.OrdinalIgnoreCase)
            || string.Equals(s, "Xuat", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Gate Out", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Out Yard", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Out Depot", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Port Out", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Exported", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Delivered", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Released", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Đã xuất", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Da xuat", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Xuất", StringComparison.OrdinalIgnoreCase)
            || s.Contains("Xuat", StringComparison.OrdinalIgnoreCase);
    }

    private static string? GetStatusCont(M_Container c)
    {
        return FirstNonEmpty(
            GetStringProperty(c, "StatusCont"),
            GetStringProperty(c, "Status_Cont"),
            GetStringProperty(c, "StatusContName"),
            GetStringProperty(c, "Status_ContName"),
            GetStringProperty(c, "STATUS_CONT"),
            GetStringProperty(c, "CONT_STATUS"),
            GetStringProperty(c, "ContainerStatus"),
            GetStringProperty(c, "StatusContainer"),
            GetStringProperty(c, "Status_Container"),
            GetStringProperty(c, "Status"));
    }

    private static string? GetGateOutLocation(M_Container c)
    {
        return FirstNonEmpty(c.In_Port, c.In_Depot, GetStatusCont(c), c.NVOCC_Status, "N/A");
    }

    private static string? FirstNonEmpty(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
                return value.Trim();
        }

        return null;
    }

    private static string? GetStringProperty(M_Container c, string propertyName)
    {
        var prop = c.GetType().GetProperty(
            propertyName,
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);

        var value = prop?.GetValue(c);
        return value?.ToString()?.Trim();
    }

    private static decimal GetDecimalProperty(M_Container c, params string[] propertyNames)
    {
        foreach (var propertyName in propertyNames)
        {
            var prop = c.GetType().GetProperty(
                propertyName,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);

            if (prop is null)
                continue;

            var value = prop.GetValue(c);

            if (value is null)
                continue;

            if (value is decimal d)
                return d;

            if (value is double db)
                return Convert.ToDecimal(db);

            if (value is float f)
                return Convert.ToDecimal(f);

            if (value is int i)
                return i;

            if (value is long l)
                return l;

            var text = value.ToString();

            if (decimal.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var result))
                return result;

            if (decimal.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out result))
                return result;
        }

        return 0m;
    }

    private static int GetLeadingNumber(string? sizeType)
    {
        if (string.IsNullOrWhiteSpace(sizeType))
            return int.MaxValue;

        var s = sizeType.Trim();
        var i = 0;
        while (i < s.Length && char.IsDigit(s[i]))
            i++;

        if (i == 0)
            return int.MaxValue;

        return int.TryParse(s.Substring(0, i), out var n) ? n : int.MaxValue;
    }

    private static string GetSuffix(string? sizeType)
    {
        if (string.IsNullOrWhiteSpace(sizeType))
            return string.Empty;

        var s = sizeType.Trim();
        var i = 0;
        while (i < s.Length && char.IsDigit(s[i]))
            i++;
        return i < s.Length ? s.Substring(i) : string.Empty;
    }

    private static List<InventoryGroupRow> BuildGroupedRows(
        IEnumerable<M_Container> source,
        Func<M_Container, string?> keySelector,
        IReadOnlyList<string> sizeTypes)
    {
        return source
            .GroupBy(keySelector)
            .Select(g => new InventoryGroupRow
            {
                Location = string.IsNullOrWhiteSpace(g.Key) ? "N/A" : g.Key,
                ContainerCount = g.Count(),
                SizeCounts = sizeTypes.ToDictionary(
                    st => st,
                    st => g.Count(x => string.Equals(x.CTN_SIZE_TYPE?.Trim(), st, StringComparison.OrdinalIgnoreCase)),
                    StringComparer.OrdinalIgnoreCase),
                DecommissionCount = g.Count(x => x.Decommision == true),
                TotalPkgs = g.Sum(x => GetDecimalProperty(x, "PKGS", "Pkgs", "Package", "Packages", "NoOfPackages")),
                TotalCbm = g.Sum(x => GetDecimalProperty(x, "CBM", "Cbm")),
                TotalNetWt = g.Sum(x => GetDecimalProperty(x, "NetWT", "NetWt", "Net_WT", "NET_WT", "NetWeight", "NW", "NW_KGS")),
                TotalGrossWt = g.Sum(x => GetDecimalProperty(x, "GrossWT", "GrossWt", "Gross_WT", "GROSS_WT", "GrossWeight", "GW", "GW_KGS")),
                StatusContText = string.Join(", ", g.Select(GetStatusCont).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase)),
                OwnerNames = g.Select(c => c.OwnerName).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToList()
            })
            .OrderBy(r => r.Location)
            .ToList();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private static List<InventoryExportRow> ToExportRows(IEnumerable<InventoryGroupRow> rows)
    {
        return rows.Select(r => new InventoryExportRow
        {
            Location = r.Location,
            ContainerCount = r.ContainerCount,
            SizeCounts = r.SizeCounts,
            DecommissionCount = r.DecommissionCount
        }).ToList();
    }

    private async Task ExportExcelDepot()
    {
        try
        {
            var depot = ToExportRows(FilteredInDepotRows);
            var bytes = exportService.ExportSingleTableToExcel(
                depot,
                DistinctSizeTypes,
                "IN DEPOT Containers",
                Localizer["IN DEPOT"]?.ToString() ?? "IN DEPOT",
