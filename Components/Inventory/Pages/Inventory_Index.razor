@using ABFreight.Models
@using MudBlazor
@attribute [Authorize]
@inject ShipmentService shipsv
@inject InventoryExportService exportService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject AccountService asv

<PageTitle>@Localizer["Container Inventory"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["Container Inventory"]" Subtitle="Depot · port arrival · utilization">
        <Toolbar>
            <MudTooltip Text="@Localizer["Reload"]">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="Refresh"
                           Disabled="_loading">
                    @Localizer["Refresh"]
                </MudButton>
            </MudTooltip>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card" Elevation="0">
        <MudContainer Class="mt-2 px-4 pb-4" MaxWidth="MaxWidth.False">
            <!-- Status summary cards -->
            <MudGrid Class="mb-6">
                <MudItem xs="12" sm="6" md="2">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack>
                                <MudText Typo="Typo.subtitle2">@Localizer["In Depot"]</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["Container"]</MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@InDepotCount</MudText>
                            </MudStack>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                            </MudAvatar>
                        </MudStack>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack>
                                <MudText Typo="Typo.subtitle2">@Localizer["Waiting Port Arrival"]</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["Container"]</MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@WaitingPortArrivalCount</MudText>
                            </MudStack>
                            <MudAvatar Color="Color.Info" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.AlarmOn" />
                            </MudAvatar>
                        </MudStack>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack>
                                <MudText Typo="Typo.subtitle2">@Localizer["Arrived at Port"]</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["Container"]</MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@ArrivedAtPortCount</MudText>
                            </MudStack>
                            <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                            </MudAvatar>
                        </MudStack>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack>
                                <MudText Typo="Typo.subtitle2">@Localizer["In Transit"]</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["Container"]</MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@InTransitCount</MudText>
                            </MudStack>
                            <MudAvatar Color="Color.Warning" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoatFilled" />
                            </MudAvatar>
                        </MudStack>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="2">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack>
                                <MudText Typo="Typo.subtitle2">@Localizer["Gate Out"]</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@Localizer["Container"]</MudText>
                                <MudText Typo="Typo.h5" Class="mt-2">@GateOutCount</MudText>
                            </MudStack>
                            <MudAvatar Color="Color.Error" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.ExitToApp" />
                            </MudAvatar>
                        </MudStack>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Detail tables -->
            <MudGrid>
                <!-- In Depot table -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="ExportExcelDepot" Disabled="_loading">Excel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">CSV</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="ExportPdfDepot" Disabled="_loading">PDF</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@Localizer["Print"]</MudButton>
                            </MudStack>
                            <MudTextField @bind-Value="searchInDepot"
                                          Placeholder="@Localizer["Search"]"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          Class="ml-2" />
                        </MudStack>

                        <MudTable T="InventoryGroupRow" Items="FilteredInDepotRows" Dense="true" Hover="true" Bordered="true" Striped="true">
                            <HeaderContent>
                                <MudTh>@Localizer["IN DEPOT"]</MudTh>
                                <MudTh>@Localizer["OwnerName"]</MudTh>
                                <MudTh>@Localizer["Status Cont"]</MudTh>
                                <MudTh>@Localizer["CONTAINER COUNT"]</MudTh>

                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTh>@sizeType</MudTh>
                                }
                                <MudTh Class="text-end">@Localizer["PKGs"]</MudTh>
                                <MudTh Class="text-end">@Localizer["CBM"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Net WT"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Gross WT"]</MudTh>
                                <MudTh>@Localizer["Decommision"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Localizer["IN DEPOT"]">@context.Location</MudTd>
                                <MudTd DataLabel="@Localizer["OwnerName"]">@(context.OwnerNames != null && context.OwnerNames.Count > 0 ? string.Join(", ", context.OwnerNames) : "")</MudTd>
                                <MudTd DataLabel="@Localizer["Status Cont"]">@context.StatusContText</MudTd>
                                <MudTd DataLabel="@Localizer["CONTAINER COUNT"]">@context.ContainerCount</MudTd>
                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTd DataLabel="@sizeType">@context.GetSizeCount(sizeType)</MudTd>
                                }
                                <MudTd DataLabel="@Localizer["PKGs"]" Class="text-end">@context.TotalPkgs.ToString("N0")</MudTd>
                                <MudTd DataLabel="@Localizer["CBM"]" Class="text-end">@context.TotalCbm.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Net WT"]" Class="text-end">@context.TotalNetWt.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Gross WT"]" Class="text-end">@context.TotalGrossWt.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Decommision"]">@context.DecommissionCount</MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                            </PagerContent>
                        </MudTable>
                    </MudCard>
                </MudItem>

                <!-- Arrived at Port table -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="ExportExcelPort" Disabled="_loading">Excel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">CSV</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="ExportPdfPort" Disabled="_loading">PDF</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@Localizer["Print"]</MudButton>
                            </MudStack>
                            <MudTextField @bind-Value="searchInPort"
                                          Placeholder="@Localizer["Search"]"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          Class="ml-2" />
                        </MudStack>

                        <MudTable T="InventoryGroupRow" Items="FilteredInPortRows" Dense="true" Hover="true" Bordered="true" Striped="true">
                            <HeaderContent>
                                <MudTh>@Localizer["IN PORT"]</MudTh>
                                <MudTh>@Localizer["CONTAINER COUNT"]</MudTh>
                                <MudTh>@Localizer["OwnerName"]</MudTh>
                                <MudTh>@Localizer["Status Cont"]</MudTh>
                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTh>@sizeType</MudTh>
                                }
                                <MudTh Class="text-end">@Localizer["PKGs"]</MudTh>
                                <MudTh Class="text-end">@Localizer["CBM"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Net WT"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Gross WT"]</MudTh>
                                <MudTh>@Localizer["Decommision"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Localizer["IN PORT"]">@context.Location</MudTd>
                                <MudTd DataLabel="@Localizer["CONTAINER COUNT"]">@context.ContainerCount</MudTd>
                                <MudTd DataLabel="@Localizer["OwnerName"]">@(context.OwnerNames != null && context.OwnerNames.Count > 0 ? string.Join(", ", context.OwnerNames) : "")</MudTd>
                                <MudTd DataLabel="@Localizer["Status Cont"]">@context.StatusContText</MudTd>
                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTd DataLabel="@sizeType">@context.GetSizeCount(sizeType)</MudTd>
                                }
                                <MudTd DataLabel="@Localizer["PKGs"]" Class="text-end">@context.TotalPkgs.ToString("N0")</MudTd>
                                <MudTd DataLabel="@Localizer["CBM"]" Class="text-end">@context.TotalCbm.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Net WT"]" Class="text-end">@context.TotalNetWt.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Gross WT"]" Class="text-end">@context.TotalGrossWt.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Decommision"]">@context.DecommissionCount</MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                            </PagerContent>
                        </MudTable>
                    </MudCard>
                </MudItem>

                <!-- Gate Out table -->
                <MudItem xs="12" md="12" Class="mt-4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="ExportExcelGateOut" Disabled="_loading">Excel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">CSV</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="ExportPdfGateOut" Disabled="_loading">PDF</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">@Localizer["Print"]</MudButton>
                            </MudStack>
                            <MudTextField @bind-Value="searchGateOut"
                                          Placeholder="@Localizer["Search"]"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          Class="ml-2" />
                        </MudStack>

                        <MudTable T="InventoryGroupRow" Items="FilteredGateOutRows" Dense="true" Hover="true" Bordered="true" Striped="true">
                            <HeaderContent>
                                <MudTh>@Localizer["GATE OUT"]</MudTh>
                                <MudTh>@Localizer["CONTAINER COUNT"]</MudTh>
                                <MudTh>@Localizer["OwnerName"]</MudTh>
                                <MudTh>@Localizer["Status Cont"]</MudTh>
                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTh>@sizeType</MudTh>
                                }
                                <MudTh Class="text-end">@Localizer["PKGs"]</MudTh>
                                <MudTh Class="text-end">@Localizer["CBM"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Net WT"]</MudTh>
                                <MudTh Class="text-end">@Localizer["Gross WT"]</MudTh>
                                <MudTh>@Localizer["Decommision"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Localizer["GATE OUT"]">@context.Location</MudTd>
                                <MudTd DataLabel="@Localizer["CONTAINER COUNT"]">@context.ContainerCount</MudTd>
                                <MudTd DataLabel="@Localizer["OwnerName"]">@(context.OwnerNames != null && context.OwnerNames.Count > 0 ? string.Join(", ", context.OwnerNames) : "")</MudTd>
                                <MudTd DataLabel="@Localizer["Status Cont"]">@context.StatusContText</MudTd>
                                @foreach (var sizeType in DistinctSizeTypes)
                                {
                                    <MudTd DataLabel="@sizeType">@context.GetSizeCount(sizeType)</MudTd>
                                }
                                <MudTd DataLabel="@Localizer["PKGs"]" Class="text-end">@context.TotalPkgs.ToString("N0")</MudTd>
                                <MudTd DataLabel="@Localizer["CBM"]" Class="text-end">@context.TotalCbm.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Net WT"]" Class="text-end">@context.TotalNetWt.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["Gross WT"]" Class="text-end">@context.TotalGrossWt.ToString("N2")</MudTd>
